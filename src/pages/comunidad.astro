---
export const prerender = false;

import RutaProductLayout from "../layouts/RutaProductLayout.astro";

const intereses = [
  { valor: "discovery", titulo: "Discovery y entrevistas", detalle: "Pasar de lo que dicen los usuarios a una decisión con evidencia." },
  { valor: "priorizacion", titulo: "Priorización y roadmap", detalle: "Decidir qué entra y qué no, y poder explicarlo." },
  { valor: "metricas", titulo: "Métricas y decisiones", detalle: "Leer datos de producto sin perderte entre dashboards." },
  { valor: "documentar", titulo: "Documentar y comunicar", detalle: "Notion y Jira al día sin que sea un segundo trabajo." },
];
---

<RutaProductLayout
  title="Comunidad de producto con IA"
  description="Un espacio para PMs que quieren aplicar IA a su trabajo con casos reales. Todavía no abre. Entra a la lista de espera."
>
  <div class="space-y-12 pb-16">
    <section class="space-y-5 pt-6">
      <span class="inline-block text-xs font-mono font-bold text-teal-800 bg-teal-50 px-2.5 py-1 rounded-md border border-teal-200 uppercase">
        Lista de espera
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
        Una comunidad para PMs que usan IA en el trabajo de verdad
      </h1>
      <p class="text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">
        Todavía no abre. Estoy armando el primer grupo con PMs que ya están probando IA en su día a día y quieren compararlo con otros.
      </p>
    </section>

    <section class="grid sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-2xl border border-slate-200 p-5 space-y-2 shadow-sm">
        <h2 class="text-sm font-bold text-slate-900">Un caso resuelto por semana</h2>
        <p class="text-sm text-slate-600 leading-relaxed">Un problema real de producto, cómo se trabajó con IA y qué no funcionó.</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5 space-y-2 shadow-sm">
        <h2 class="text-sm font-bold text-slate-900">La Ruta y sus recursos</h2>
        <p class="text-sm text-slate-600 leading-relaxed">Los pasos de la Ruta Product Management con IA, con sus ejemplos y prompts.</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5 space-y-2 shadow-sm">
        <h2 class="text-sm font-bold text-slate-900">Preguntas entre PMs</h2>
        <p class="text-sm text-slate-600 leading-relaxed">Un lugar para preguntar y comparar, sin obligación de estar pendiente todos los días.</p>
      </div>
    </section>

    <section id="lista" class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200 shadow-md max-w-2xl mx-auto space-y-6">
      <div class="space-y-2">
        <h2 class="text-2xl font-black text-slate-900 tracking-tight leading-tight">Entra a la lista</h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Te escribo cuando abra el primer grupo. Tu respuesta de abajo me ayuda a decidir qué armar primero.
        </p>
      </div>

      <form id="comunidad-form" class="space-y-5">
        <fieldset class="space-y-2">
          <legend class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 font-mono">
            ¿Qué te gustaría resolver primero?
          </legend>
          {intereses.map((i, idx) => (
            <label class="flex items-start gap-3 p-3 border border-slate-200 rounded-xl cursor-pointer hover:border-teal-400 transition has-[:checked]:border-teal-600 has-[:checked]:bg-teal-50/50">
              <input type="radio" name="interes" value={i.valor} required={idx === 0} class="mt-1 accent-[#00685F]" />
              <span class="space-y-0.5">
                <span class="block text-sm font-semibold text-slate-900">{i.titulo}</span>
                <span class="block text-xs text-slate-500">{i.detalle}</span>
              </span>
            </label>
          ))}
        </fieldset>

        <div>
          <label for="comunidad-email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-mono">
            Tu correo
          </label>
          <input
            id="comunidad-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="tu@empresa.com"
            class="w-full text-sm p-3 border border-slate-300 rounded-xl bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent transition"
          />
        </div>

        <button
          type="submit"
          id="comunidad-btn"
          class="w-full inline-flex items-center justify-center font-semibold bg-[#00685F] hover:bg-[#005049] text-white rounded-xl py-3 px-5 text-sm transition shadow-sm cursor-pointer"
        >
          Quiero entrar a la lista
        </button>
        <p id="comunidad-msg" class="hidden text-sm font-semibold"></p>
        <p class="text-xs text-slate-500">Solo uso tu correo para avisarte de la comunidad. Puedes salirte cuando quieras.</p>
      </form>
    </section>
  </div>
</RutaProductLayout>

<script is:inline>
  (function () {
    if (window.posthog) {
      window.posthog.capture('comunidad_pagina_vista');
    }
    var form = document.getElementById('comunidad-form');
    if (!form) return;
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var btn = document.getElementById('comunidad-btn');
      var msg = document.getElementById('comunidad-msg');
      var email = (form.querySelector('input[name="email"]').value || '').trim();
      var checked = form.querySelector('input[name="interes"]:checked');
      var interes = checked ? checked.value : '';
      if (btn) btn.disabled = true;
      try {
        var res = await fetch('/api/aviso-paso', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, paso: 'comunidad', interes: interes })
        });
        var data = await res.json().catch(function () { return {}; });
        if (res.ok && data.ok) {
          msg.textContent = 'Listo, quedaste en la lista. Te escribo cuando abra el primer grupo.';
          msg.className = 'text-sm font-semibold text-emerald-600';
          if (window.posthog) {
            window.posthog.capture('comunidad_lista_registrada', { interes: interes });
          }
          form.reset();
        } else {
          msg.textContent = data.error || 'No pudimos registrar tu correo. Intenta de nuevo.';
          msg.className = 'text-sm font-semibold text-red-600';
        }
      } catch (err) {
        msg.textContent = 'No pudimos registrar tu correo. Intenta de nuevo.';
        msg.className = 'text-sm font-semibold text-red-600';
      }
      if (btn) btn.disabled = false;
    });
  })();
</script>
