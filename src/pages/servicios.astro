---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Soluciones y Mentorías | LuciRMe AI">

  <!-- HEADER -->
  <header class="py-20 px-4 border-b border-gray-100 bg-[#F8FAFC]">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-deep leading-tight mb-6">
        Elige tu punto de partida.
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
        Sistemas, hábitos y herramientas de IA adaptadas a tu realidad, no al revés.
      </p>
    </div>
  </header>

  <!-- GRID DE SOLUCIONES (Ajustado a 2 perfiles) -->
  <main class="py-24 px-4 min-h-screen">
    <div class="max-w-5xl mx-auto">
      
      <div class="grid md:grid-cols-2 gap-8">
        
        <!-- 1. PROFESIONALES -->
        <a href="/soluciones/profesionales" class="group flex flex-col bg-white border border-gray-200 rounded-2xl p-10 hover:border-teal transition-all shadow-sm hover:shadow-xl">
          <div class="w-14 h-14 bg-gray-50 rounded-xl flex items-center justify-center text-3xl mb-6 group-hover:bg-teal/10 transition-colors">👤</div>
          <h2 class="text-2xl font-bold text-deep mb-4 group-hover:text-teal transition-colors">Para Profesionales</h2>
          <p class="text-sm text-gray-600 mb-8 flex-grow leading-relaxed">
            Recupera hasta 10 horas semanales. Automatizamos tu operativa personal para que dejes de apagar fuegos y te enfoques en lo que realmente factura.
          </p>
          <div class="pt-6 border-t border-gray-100">
            <span class="text-teal font-bold text-sm flex items-center gap-2 group-hover:gap-3 transition-all">
              Ver programas y precios <span>→</span>
            </span>
          </div>
        </a>

        <!-- 2. EMPRESAS / STARTUPS -->
        <a href="/soluciones/empresas" class="group flex flex-col bg-white border border-gray-200 rounded-2xl p-10 hover:border-teal transition-all shadow-sm hover:shadow-xl">
          <div class="w-14 h-14 bg-gray-50 rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-teal/10 transition-colors">🏢</div>
          <h2 class="text-2xl font-bold text-deep mb-4 group-hover:text-teal transition-colors">Para Startups y Empresas</h2>
          <p class="text-sm text-gray-600 mb-8 flex-grow leading-relaxed">
            Estandarizamos tus flujos operativos con IA. Integramos soluciones sin migraciones ni fricción para que tu equipo escale con precisión.
          </p>
          <div class="pt-6 border-t border-gray-100">
            <span class="text-teal font-bold text-sm flex items-center gap-2 group-hover:gap-3 transition-all">
              Ver soluciones y equipos <span>→</span>
            </span>
          </div>
        </a>

      </div>
    </div>
  </main>

  <!-- CTA INFERIOR -->
  <section class="py-24 px-4 bg-deep text-white text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold mb-6">¿No sabes por dónde empezar?</h2>
      <p class="text-gray-400 mb-10 text-lg">
        Usa nuestro <strong>Selector</strong>. En 60 segundos mapeamos tu mayor fuga de tiempo y te damos un plan de acción concreto.
      </p>
      <button 
        onclick="document.getElementById('selector-overlay').classList.remove('hidden')"
        class="inline-flex items-center gap-2 bg-orange text-white px-10 py-4 rounded-lg font-bold hover:bg-orange/90 transition shadow-lg text-lg"
      >
        ⚡ Enciende tu Foco
      </button>
    </div>
  </section>

</Layout>