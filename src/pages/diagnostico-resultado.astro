---
// Resultado del diagnóstico con el diseño de Web v2 (tablero DiagnosticoResultado).
// Los datos salen de sessionStorage ("diagnosticResult"), como antes. Un solo botón de color: WhatsApp.
import LayoutV2 from "../layouts/LayoutV2.astro";
import SigueEnRedes from "../components/v2/SigueEnRedes.astro";
import { LINKS } from "../lib/constants.js";
const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
---

<LayoutV2 title="Resultados de tu diagnóstico | LuciRMe AI" description="Resultado de tu diagnóstico operativo." noindex>
  <div class="w-full bg-v2-fondo">
    <div id="loading" class="mx-auto w-full max-w-[1200px] px-5 py-16 sm:px-8" role="status">
      <h1 class="text-2xl font-bold text-v2-texto">Cargando tu diagnóstico</h1>
    </div>

    <div id="results" data-whatsapp={whatsappBase} class="mx-auto hidden w-full max-w-[1200px] flex-col gap-6 px-5 pb-12 pt-6 sm:px-8">
      <section class="flex flex-col gap-3 pt-4">
        <span class="self-start rounded-full border-[0.8px] border-v2-marca-borde bg-v2-fondo px-3.5 py-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-v2-accion">Tu diagnóstico</span>
        <h1 id="res-titulo" class="max-w-[760px] text-[32px] font-extrabold leading-[1.14] text-v2-texto sm:text-[44px]"></h1>
        <p id="res-resumen" class="max-w-[640px] text-lg leading-7 text-v2-cuerpo"></p>
      </section>

      <section class="flex flex-wrap items-start gap-6">
        <div class="flex flex-1 basis-[560px] flex-col gap-4 rounded-3xl border-[0.8px] border-v2-borde bg-v2-fondo p-6">
          <h2 class="text-[22px] font-bold text-v2-texto">Lo que encontramos</h2>
          <ul id="res-hallazgos" class="flex flex-col"></ul>
        </div>
        <aside aria-label="Siguiente paso" class="flex max-w-[400px] grow shrink basis-[320px] flex-col gap-3 rounded-3xl border-[0.8px] border-v2-marca-borde bg-v2-marca-tinte p-6">
          <b class="text-xl text-v2-texto">Tu siguiente paso</b>
          <span id="res-siguiente" class="text-sm leading-5 text-v2-cuerpo"></span>
          <a id="res-whatsapp" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-v2-accion px-7 text-base font-bold text-v2-accion-texto hover:bg-v2-accion-hover">Hablar con Pablo por WhatsApp</a>
          <button id="download-pdf" type="button" class="inline-flex min-h-11 cursor-pointer items-center justify-center text-sm font-bold text-v2-accion underline">Descargar el informe en PDF</button>
          <a href="/empresas" class="inline-flex min-h-11 items-center text-sm font-bold text-v2-accion">Volver a Empresas ›</a>
        </aside>
      </section>

      <SigueEnRedes posicion="diagnostico-resultado" />
    </div>
  </div>

  <script>
    const resultData = JSON.parse(sessionStorage.getItem("diagnosticResult") || "{}");

    if (!resultData.success) {
      window.location.href = "/empresas";
    } else {
      document.getElementById("loading")!.classList.add("hidden");
      const res = document.getElementById("results")!;
      res.classList.remove("hidden");
      res.classList.add("flex");

      const diagnosis = resultData.diagnosis || {};
      const raw = resultData.aiReport;
      const report = raw && typeof raw === "object" ? raw : ({} as any);
      const proceso = Array.isArray(diagnosis.proceso) ? diagnosis.proceso.join(", ") : diagnosis.proceso || "tu proceso";

      const titulo = document.getElementById("res-titulo")!;
      titulo.textContent = diagnosis.prioridad
        ? `Mejorar ${proceso} es una prioridad ${String(diagnosis.prioridad).toLowerCase()} para tu equipo.`
        : `Este es el diagnóstico de ${proceso}.`;
      document.getElementById("res-resumen")!.textContent = report.resumenEjecutivo || "Revisamos tus respuestas y esto es lo que vemos.";

      const lista = document.getElementById("res-hallazgos")!;
      const hallazgos: any[] = Array.isArray(report.hallazgos) ? report.hallazgos : [];
      if (hallazgos.length === 0) {
        const li = document.createElement("li");
        li.className = "border-t-[0.8px] border-v2-borde py-3 text-sm text-v2-cuerpo";
        li.textContent = "Aún no hay hallazgos suficientes. Hablemos y lo revisamos juntos.";
        lista.appendChild(li);
      }
      hallazgos.forEach((h, i) => {
        const li = document.createElement("li");
        li.className = "flex items-start gap-3 border-t-[0.8px] border-v2-borde py-3";
        const num = document.createElement("span");
        num.className = "flex h-8 w-8 flex-none items-center justify-center rounded-full border-[0.8px] border-v2-marca-borde bg-v2-marca-tinte text-sm font-bold text-v2-accion";
        num.textContent = String(i + 1);
        const cuerpo = document.createElement("span");
        cuerpo.className = "flex flex-1 flex-col gap-0.5";
        const t = document.createElement("b");
        t.className = "text-base text-v2-texto";
        t.textContent = h.hallazgo || "";
        const d = document.createElement("span");
        d.className = "text-sm leading-5 text-v2-cuerpo";
        d.textContent = h.relevancia || "";
        cuerpo.append(t, d);
        li.append(num, cuerpo);
        if (h.tipoEvidencia) {
          const nivel = document.createElement("span");
          nivel.className = "inline-flex items-center rounded-full border-[0.8px] border-[#cad5e2] bg-v2-fondo px-3 py-1 text-xs font-bold text-v2-cuerpo";
          nivel.textContent = h.tipoEvidencia;
          li.append(nivel);
        }
        lista.appendChild(li);
      });

      const primera = Array.isArray(report.queHariaPrimero) ? report.queHariaPrimero[0] : null;
      document.getElementById("res-siguiente")!.textContent = primera?.accion
        ? `Lo primero que haría es esto: ${primera.accion}. Hablemos para definir cómo hacerlo.`
        : "Revisemos juntos tu diagnóstico y decidimos qué conviene hacer primero.";
      const wa = document.getElementById("res-whatsapp") as HTMLAnchorElement;
      const texto = `Hola Pablo, revisé mi diagnóstico operativo para ${proceso} y me gustaría conversar sobre los resultados.`;
      wa.href = `${res.dataset.whatsapp}?text=${encodeURIComponent(texto)}`;
      wa.addEventListener("click", () => {
        (window as any).posthog?.capture("bottleneck_diagnosis_whatsapp_click", { origen: "resultado" });
      });

      (window as any).posthog?.capture("diagnostico_report_viewed", {
        empresa: diagnosis.empresa,
        proceso: diagnosis.proceso,
      });

      document.getElementById('download-pdf')!.addEventListener('click', async () => {
        const { jsPDF } = await import("jspdf");
        const { default: autoTable } = await import("jspdf-autotable");
        
        const doc = new jsPDF();
        const pageWidth = doc.internal.pageSize.width;

        // Header
        doc.setFontSize(20);
        doc.text("Diagnóstico operativo", 10, 20);
        doc.setFontSize(12);
        doc.text(`${diagnosis.empresa} • ${diagnosis.proceso}`, 10, 30);
        doc.text(`Fecha: ${new Date().toLocaleDateString()}`, 10, 37);

        // Resumen Ejecutivo
        doc.setFontSize(16);
        doc.text("Resumen ejecutivo", 10, 50);
        doc.setFontSize(11);
        const resumenLines = doc.splitTextToSize(report.resumenEjecutivo || '', pageWidth - 20);
        doc.text(resumenLines, 10, 60);

        // Hallazgos
        let currentY = 60 + (resumenLines.length * 7);
        doc.setFontSize(16);
        doc.text("Hallazgos principales", 10, currentY);
        
        const hallazgosData = (report.hallazgos || []).map((item: any) => [
          item.hallazgo,
          item.tipoEvidencia,
          item.relevancia
        ]);

        autoTable(doc, {
          startY: currentY + 5,
          head: [['Hallazgo', 'Tipo', 'Relevancia']],
          body: hallazgosData,
          theme: 'striped',
          styles: { fontSize: 10 },
        });

        // Oportunidades
        currentY = (doc as any).lastAutoTable.finalY + 15;
        doc.setFontSize(16);
        doc.text("Oportunidades", 10, currentY);

        const opData = (report.oportunidadesPriorizadas || []).slice(0, 3).map((op: any) => [
          op.oportunidad,
          op.problema,
          op.beneficio
        ]);

        autoTable(doc, {
          startY: currentY + 5,
          head: [['Oportunidad', 'Problema', 'Beneficio']],
          body: opData,
          theme: 'grid',
          styles: { fontSize: 10 },
        });

        doc.save("diagnostico-operativo.pdf");
        
        // PostHog: Report Downloaded
        if (window.posthog) {
            window.posthog.capture('diagnostico_report_downloaded');
        }
      });

    }
  </script>
</LayoutV2>
