---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Resultados de tu Diagnóstico Operativo | LuciRMe AI">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <div id="loading" class="text-center">
      <h1 class="text-2xl font-bold">Cargando tu diagnóstico...</h1>
    </div>
    
    <div id="results" class="hidden space-y-8">
      <h1 class="text-3xl font-bold">Tu Informe de Diagnóstico Operativo</h1>
      
      <div id="report-content" class="prose prose-slate max-w-none">
        <!-- AI Report will be injected here -->
      </div>

      <div class="flex gap-4">
        <button id="download-pdf" class="bg-teal-700 text-white px-4 py-2 rounded-lg cursor-pointer">Descargar PDF</button>
        <button id="email-pdf" class="bg-slate-200 text-slate-800 px-4 py-2 rounded-lg cursor-pointer">Recibir por correo</button>
      </div>
    </div>
  </div>

  <script>
    import { jsPDF } from "jspdf";
    
    const resultData = JSON.parse(sessionStorage.getItem('diagnosticResult') || '{}');
    
    if (!resultData.success) {
      window.location.href = '/empresas';
    } else {
      document.getElementById('loading')!.classList.add('hidden');
      document.getElementById('results')!.classList.remove('hidden');
      
      const content = document.getElementById('report-content')!;
      content.innerHTML = resultData.aiReport || 'Contenido del informe...';
      
      // PostHog: Report Viewed
      if (window.posthog) {
        window.posthog.capture('diagnostico_report_viewed', { 
          empresa: resultData.diagnosis?.empresa,
          proceso: resultData.diagnosis?.proceso 
        });
      }
      
      document.getElementById('download-pdf')!.addEventListener('click', () => {
        const doc = new jsPDF();
        doc.text(content.innerText, 10, 10);
        doc.save("diagnostico.pdf");
        
        // PostHog: Report Downloaded
        if (window.posthog) {
            window.posthog.capture('diagnostico_report_downloaded');
        }
      });
    }
  </script>
</Layout>
