---
// Atajos de IA, guía de pago con la plantilla de guía de pago (Web v2).
// El pago va a Hotmart, enlace en src/lib/constants.js. El precio sale de src/data/precios.ts.
// La página anterior quedó archivada en _atajos-ia-anterior.astro. /recursos/atajos-ia sigue mostrando esta misma página.
import LayoutV2 from "../layouts/LayoutV2.astro";
import PlantillaGuiaPago from "../components/v2/PlantillaGuiaPago.astro";
import { LINKS } from "../lib/constants.js";
---

<LayoutV2
  title="Atajos de IA, 18 prompts para trabajar y crear mejor | LuciRMe AI"
  description="Dieciocho prompts prácticos, listos para copiar, pegar y adaptar. Menos tiempo buscando qué escribir y más tiempo haciendo."
>
  <PlantillaGuiaPago
    slug="atajos-ia"
    titulo="Atajos de IA, 18 prompts para trabajar y crear mejor"
    descripcion="Deja de empezar cada conversación con ChatGPT desde cero. Dieciocho prompts listos para copiar, pegar y adaptar a tu trabajo."
    tema="Prompts"
    precioClave="atajos-ia"
    hrefPago={LINKS.atajos_ia}
    incluye={[
      "Prompts para pensar mejor, ordenar ideas y convertir un problema confuso en pasos concretos.",
      "Prompts para trabajar más rápido en tareas repetitivas, documentos, planes y proyectos.",
      "Prompts para crear y mejorar contenido sin quedarte frente a una pantalla en blanco.",
      "Prompts que le dan a la IA el contexto exacto para que responda algo útil.",
    ]}
    vistaPrevia="Cada prompt sigue cuatro pasos. Pones el contexto, dices qué necesitas, adaptas el resultado y lo usas. Sin teoría de más y sin prompts kilométricos."
    relacionados={[
      { titulo: "Prompts para copiar", tipo: "Prompts", url: "/recursos/prompts" },
      { titulo: "Prompteador", tipo: "Herramienta", url: "/recursos/prompteador" },
      { titulo: "Guía de NotebookLM", tipo: "Guía", url: "/recursos/guia-notebooklm" },
    ]}
  />
</LayoutV2>
