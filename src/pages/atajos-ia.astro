          </div>
        </div>

        <!-- CTA PRIMARIO -->
        <div class="pt-3 space-y-2">
          <a
            href={hotmartLink}
            target="_blank"
            rel="noopener noreferrer"
            onclick="if (window.posthog) { window.posthog.capture('atajos_ia_hero_buy_click', { producto: 'atajos_ia', precio: '17 USD' }); }"
            class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-tealHover text-white font-black text-sm sm:text-base px-6 py-3.5 rounded-xl transition shadow-lg shadow-teal/30 cursor-pointer transform hover:-translate-y-0.5 w-full sm:w-auto"
          >
            <span>QUIERO MIS 18 PROMPTS →</span>
          </a>

          <p class="text-xs text-slate-400 font-medium flex items-center justify-center gap-2">
            <span>🔒 Acceso inmediato tras la compra</span>
            <span>•</span>
            <span>Garantía de satisfacción Hotmart</span>
          </p>
        </div>

        <!-- MOCKUP PROMPT WORKFLOW -->
        <div class="pt-6 max-w-xl mx-auto">
          <div class="bg-slate-900 border border-slate-700/80 rounded-2xl p-4 sm:p-6 text-left text-xs sm:text-sm font-mono space-y-3 shadow-2xl">
