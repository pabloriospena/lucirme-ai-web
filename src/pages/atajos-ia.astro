      <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 space-y-6 shadow-xs">
        <div class="text-center space-y-1.5">
          <span class="text-teal font-extrabold text-[11px] uppercase tracking-widest bg-teal/10 px-3 py-0.5 rounded-full border border-teal/20">
