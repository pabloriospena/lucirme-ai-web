---
import Layout from "../layouts/Layout.astro";
import RedesSociales from "../components/RedesSociales.astro";
import { LINKS } from "../lib/constants.js";

const hotmartLink = LINKS.atajos_ia || "https://pay.hotmart.com/X107628052G";
---

<Layout 
  title="Atajos de IA: 18 Prompts Prácticos para Trabajar y Crear Mejor | LuciRMe AI"
  description="Deja de empezar cada conversación con ChatGPT desde cero. 18 prompts prácticos, listos para copiar, pegar y adaptar. Menos tiempo buscando qué escribir, más tiempo haciendo."
>

  <!-- BARRA DE NAVEGACIÓN Y ALERTA STICKY -->
  <div class="bg-teal text-white font-black text-xs py-2 px-4 text-center border-b border-teal/20 shadow-xs">
    ⚡ <span class="uppercase tracking-wider">RECURSO PRÁCTICO:</span> 18 Prompts para trabajar y crear mejor con IA · Acceso inmediato
  </div>

  <nav class="bg-white/95 backdrop-blur-md border-b border-slate-200 px-6 py-3 sticky top-0 z-40 text-slate-900 shadow-xs">
    <div class="max-w-5xl mx-auto flex justify-between items-center text-xs sm:text-sm">
      <a href="/recursos" class="font-bold text-slate-600 hover:text-teal transition flex items-center gap-1">
        ← Volver a Recursos
      </a>
      <div class="flex items-center gap-3">
        <span class="font-bold text-slate-700 hidden md:inline text-xs">Acceso Inmediato • Hotmart</span>
        <a
          href={hotmartLink}
          target="_blank"
          rel="noopener noreferrer"
          onclick="if (window.posthog) { window.posthog.capture('atajos_ia_nav_buy_click', { producto: 'atajos_ia', precio: '17 USD' }); }"
          class="inline-flex items-center gap-1.5 bg-teal hover:bg-tealHover text-white font-black px-4 py-2 rounded-xl transition text-xs shadow-sm cursor-pointer transform hover:scale-105"
        >
          <span>Quiero mis 18 Prompts</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </nav>

  <div class="bg-[#F8FAFC] text-slate-800 font-sans selection:bg-teal selection:text-white min-h-screen">

    <!-- 1. HERO SECTION -->
    <header class="relative bg-gradient-to-b from-[#0F172A] via-[#1E293B] to-[#0F172A] text-white pt-16 pb-20 px-6 overflow-hidden border-b border-slate-800">
      <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#0D9488_1px,transparent_1px)] [background-size:20px_20px] pointer-events-none"></div>
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-teal/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-4xl mx-auto text-center relative z-10 space-y-6">
        
        <!-- BADGE -->
        <div class="inline-flex items-center gap-2 bg-teal/15 text-teal text-xs sm:text-sm font-extrabold uppercase tracking-widest px-4 py-1.5 rounded-full border border-teal/30 shadow-xs">
          <span>🚀</span>
          <span>Atajos de IA · Colección Práctica</span>
        </div>

        <!-- H1 -->
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-white leading-tight tracking-tight max-w-3xl mx-auto uppercase">
          ATAJOS DE IA <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal via-teal-300 to-amber-300">
            18 prompts para trabajar y crear mejor
          </span> <br class="hidden sm:block" />
          con inteligencia artificial
        </h1>

        <!-- GANCHO PRINCIPAL -->
        <p class="text-lg sm:text-xl font-black text-amber-300 max-w-2xl mx-auto leading-snug">
          Deja de empezar cada conversación con ChatGPT desde cero.
        </p>

        <p class="text-sm sm:text-base text-slate-300 font-medium max-w-2xl mx-auto leading-relaxed">
          <strong class="text-white font-bold">18 prompts prácticos, listos para copiar, pegar y adaptar</strong>, diseñados para ayudarte a trabajar, pensar y crear con IA sin complicarte la vida.
