---
import LayoutV2 from "../layouts/LayoutV2.astro";

const whatsappNumber = "573053046180";

const rawText1 = `¡Hola! Te paso el contacto de Pablo Ríos de LucirMe AI. La verdad me ayudó mucho a automatizar reportes y presentaciones; me ahorró como 10 horas a la semana. Cero teoría, puro copiar y ajustar a tu trabajo real.

Si quieres agendar un Café de Estrategia de 30 min con él, escríbele directo a su WhatsApp: https://lucirme.com/whatsapp

Dile que vas de mi parte para que te aplique un descuento de bienvenida y a mí me regalen una sesión de enfoque.`;

const rawText2 = `Grupo, les comparto esto porque sé que a varios nos toca armar reportes, OKRs o presentaciones eternas. Es un recurso de LucirMe AI para estructurar información y resumir reuniones sin perder el fin de semana. Cero carreta, va al grano.

Si agendan un Café de Estrategia de 30 min mencionando mi nombre, les dan un descuento de bienvenida en la primera sesión.
https://lucirme.com/whatsapp`;

const rawText3 = `Hola! Te recomiendo a Pablo Ríos de LucirMe AI. Implementamos unos flujos con él para estandarizar procesos que antes nos consumían horas. Su enfoque es sumamente práctico y seguro con los datos de la empresa.

Te sugiero agendar un Café de Estrategia de 30 min para evaluar tu caso. Escríbele a su enlace directo: https://lucirme.com/whatsapp

Si mencionas que vas recomendado por mí, te aplican un descuento de bienvenida en el diagnóstico.`;

const linkOption1 = `https://api.whatsapp.com/send?text=${encodeURIComponent(rawText1)}`;
const linkOption2 = `https://api.whatsapp.com/send?text=${encodeURIComponent(rawText2)}`;
const linkOption3 = `https://api.whatsapp.com/send?text=${encodeURIComponent(rawText3)}`;
const opciones = [
  { etiqueta: "Opción 1", sub: "1 a 1", titulo: "Para un colega o amigo", desc: "Ideal para enviarlo a alguien que sabes que está ahogado en trabajo o reportes semanales.", texto: rawText1, enlace: linkOption1, boton: "Compartir por WhatsApp a un colega" },
  { etiqueta: "Opción 2", sub: "Grupos y comunidad", titulo: "Para un grupo de WhatsApp o red de trabajo", desc: "Pensado para compartir valor en un grupo sin sonar a venta agresiva.", texto: rawText2, enlace: linkOption2, boton: "Compartir en un grupo de WhatsApp" },
  { etiqueta: "Opción 3", sub: "B2B y ejecutivo", titulo: "Para un perfil senior, jefe o fundador (B2B)", desc: "Tono más formal, enfocado en ROI, estandarización de procesos y seguridad.", texto: rawText3, enlace: linkOption3, boton: "Compartir a un perfil senior o B2B" },
];
---

<LayoutV2 title="Recomienda LuciRMe AI | Pásale el atajo">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-6 px-4 pb-16 pt-2 sm:px-6">
    <header class="relative overflow-hidden rounded-[32px] border-[0.8px] border-v2-marca-borde bg-v2-marca-tinte">
      <div class="relative flex max-w-[720px] flex-col gap-3 px-6 py-8 sm:px-12 sm:pb-8 sm:pt-9">
        <span class="self-start rounded-full border-[0.8px] border-v2-marca-borde bg-v2-fondo px-3.5 py-1.5 font-mono text-xs font-semibold uppercase tracking-[0.6px] text-v2-accion">Programa de recomendación</span>
        <h1 class="text-[34px] font-extrabold leading-[1.14] tracking-[-0.9px] text-v2-texto sm:text-[44px] sm:tracking-[-1.1px]">¿Conoces a alguien que siga perdiendo horas en tareas manuales?</h1>
        <p class="max-w-[560px] text-base leading-6 text-v2-cuerpo sm:text-lg sm:leading-7">Si LuciRMe te devolvió tiempo y claridad, pásale el atajo. Elige el mensaje que mejor se adapte a tu contacto, toca el botón y se te abrirá WhatsApp listo para enviar.</p>
        <p class="max-w-[560px] rounded-2xl border-[0.8px] border-v2-marca-borde bg-v2-fondo p-4 text-sm leading-5 text-v2-cuerpo"><b class="text-v2-texto">Ganamos todos.</b> Tu contacto recibe un descuento de bienvenida en su primera sesión y a ti te acreditamos una Sesión de Enfoque adicional sin costo.</p>
      </div>
    </header>

    <main class="flex flex-col gap-6">
      {opciones.map((o) => (
        <section class="flex flex-col gap-5 rounded-3xl border-[0.8px] border-v2-borde bg-v2-fondo p-6 sm:p-8">
          <div class="flex flex-col gap-1.5">
            <div class="flex items-center gap-2">
              <span class="rounded-full border-[0.8px] border-v2-marca-borde bg-v2-marca-tinte px-3 py-1 font-mono text-xs font-semibold uppercase tracking-[0.6px] text-v2-marca-texto">{o.etiqueta}</span>
              <span class="text-xs font-semibold text-v2-suave">{o.sub}</span>
            </div>
            <h2 class="text-xl font-bold tracking-[-0.3px] text-v2-texto sm:text-2xl">{o.titulo}</h2>
            <p class="text-sm leading-5 text-v2-cuerpo">{o.desc}</p>
          </div>
          <div class="flex flex-col gap-3 rounded-2xl border-[0.8px] border-v2-borde bg-v2-superficie p-4 sm:p-5">
            <div class="flex items-center justify-between text-xs text-v2-suave"><span>Vista previa del mensaje</span><span>WhatsApp</span></div>
            <p class="whitespace-pre-line rounded-xl border-[0.8px] border-v2-borde bg-v2-fondo p-3.5 text-sm leading-6 text-v2-cuerpo">{o.texto}</p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a href={o.enlace} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[52px] flex-1 items-center justify-center rounded-full bg-v2-accion px-7 text-base font-bold text-v2-accion-texto hover:bg-v2-accion-hover">{o.boton}</a>
            <button type="button" data-copy={o.texto} class="copy-btn inline-flex min-h-[52px] cursor-pointer items-center justify-center rounded-full border-[0.8px] border-v2-control bg-v2-secundario px-6 text-sm font-bold text-v2-texto hover:border-v2-accion">
              <span class="btn-text">Copiar texto</span>
            </button>
          </div>
        </section>
      ))}

      <div class="flex flex-col items-center gap-2 pt-2 text-center">
        <p class="text-sm text-v2-cuerpo">¿Tienes alguna duda sobre el programa de recomendación?</p>
        <a href="https://lucirme.com/whatsapp" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-v2-accion underline underline-offset-2">Habla directamente con Pablo por WhatsApp</a>
      </div>
    </main>
  </div>
</LayoutV2>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((button) => {
    button.addEventListener("click", () => {
      const textToCopy = button.getAttribute("data-copy");
      if (!textToCopy) return;
      navigator.clipboard.writeText(textToCopy).then(() => {
        const textSpan = button.querySelector(".btn-text");
        if (!textSpan) return;
        const originalText = textSpan.textContent;
        textSpan.textContent = "¡Copiado!";
        setTimeout(() => {
          textSpan.textContent = originalText;
        }, 2000);
      });
    });
  });
</script>
