---
import LayoutV2 from "../layouts/LayoutV2.astro";
import PaginaGracias from "../components/v2/PaginaGracias.astro";
---

<LayoutV2 title="¡Listo! Nos vemos en la sesión | LuciRMe AI">
  <PaginaGracias
    titulo="¡Recibido!"
    resumen="Tus respuestas están guardadas. Ya tengo claridad sobre tu mayor dolor de cabeza."
    pasos={[
      { t: "Revisa tu correo", d: "Te envié un email con los próximos pasos y el recordatorio de nuestra sesión." },
      { t: "Prepara tu dolor", d: "Ten listo el archivo o proceso real (Excel, contratos, correos) para trabajar en vivo." },
      { t: "Abre tus cuentas de IA", d: "Claude, ChatGPT o Gemini listos para usar durante la sesión." },
    ]}
    listas={[
      {
        titulo: "Checklist para el día de la sesión",
        items: [
          "Estar frente al computador con buena conexión.",
          "Cuentas de IA abiertas (Claude, ChatGPT o Gemini).",
          "El dolor a la mano, listo para copiar y pegar.",
        ],
      },
    ]}
    pregunta="¿Tienes alguna duda urgente antes de la sesión?"
  />
</LayoutV2>
