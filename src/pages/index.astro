---
// src/pages/index-text-chat.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="LuciRMe AI">
  <main
    class="max-w-4xl mx-auto py-12 px-6 min-h-[90vh] flex flex-col justify-center space-y-12"
  >
    <!-- HEADER -->
    <header class="text-center md:text-left">
      <h1 class="text-4xl font-black text-deep mb-2 tracking-tight">
        Tu talento merece brillar
      </h1>
      <p class="text-sm text-gray-500">
        Menos operatividad manual. Aplica IA con criterio para recuperar tu
        tiempo
      </p>
    </header>

    <!-- MINI HEADER DIAGNÓSTICO -->
    <div class="bg-gradient-to-r from-teal/10 via-slate-100 to-orange/10 border border-teal/20 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-deep shadow-2xs">
      <div class="flex items-center gap-2.5 text-xs sm:text-sm font-bold">
        <span class="p-1.5 bg-teal text-white rounded-xl text-base shrink-0">🌡️</span>
        <div>
          <span class="text-deep font-bold block sm:inline">¿Ya tienes tu diagnóstico?</span>
          <span class="text-gray-500 font-normal text-xs block sm:inline">Mide tus fugas de tiempo en 2 minutos.</span>
        </div>
      </div>
      <button
        onclick="document.getElementById('selector-overlay').classList.remove('hidden'); safeTrack('mini_header_termometro_clicked');"
        class="bg-teal hover:bg-tealHover text-white text-xs font-bold px-4 py-2 rounded-xl transition shrink-0 shadow-sm cursor-pointer"
      >
        Realizar diagnóstico
      </button>
    </div>

    <!-- ============================================ -->
    <!-- SECCIÓN 1 Y 2: EL CHAT SIMULADO CLARO        -->
    <!-- ============================================ -->
    <div
      id="lucirme-chat"
      class="bg-[#F8FAFC] rounded-3xl p-6 md:p-8 shadow-sm border border-gray-200 relative overflow-hidden min-h-[350px] flex flex-col justify-between text-deep"
    >
      <div class="absolute top-0 left-0 w-full h-1 bg-teal"></div>

      <!-- Área de Conversación -->
      <div
        id="chat-messages"
        class="flex-grow space-y-6 overflow-y-auto max-h-[250px] pr-2"
      >
        <!-- Burbuja Inicial de la IA -->
        <div class="space-y-2 initial-bot-message">
          <span
            class="text-teal font-bold text-xs uppercase tracking-widest block"
            >LuciRMe AI:</span
          >
          <div
            class="inline-block bg-white border border-gray-200 p-4 rounded-2xl rounded-tl-sm text-sm text-gray-700 max-w-lg shadow-sm"
          >
            Hola. Soy el asistente de LuciRMe. No te voy a hacer perder el
            tiempo con teoría. Elige tu camino:
          </div>
        </div>

        <!-- Indicador "Escribiendo..." -->
        <div id="chat-loading" class="hidden space-y-2">
          <span
            class="text-teal font-bold text-xs uppercase tracking-widest block"
            >LuciRMe AI:</span
          >
          <div
            class="inline-flex items-center gap-1 bg-white border border-gray-200 px-4 py-3 rounded-2xl rounded-tl-sm text-sm text-gray-400"
          >
            <span
              class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce"
              style="animation-delay: 0s"></span>
            <span
              class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce"
              style="animation-delay: 0.15s"></span>
            <span
              class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce"
              style="animation-delay: 0.3s"></span>
          </div>
        </div>
      </div>

      <!-- SECCIÓN 2: LOS ATAJOS ROUNDED -->
      <div
        id="chat-options"
        class="flex flex-wrap gap-2 pt-6 border-t border-gray-100 mt-6 justify-center md:justify-start"
      >
        <button
          onclick="responderChat(1, '👤 Quiero asesoría personalizada, aprender y recuperar tiempo')"
          class="px-4 py-2.5 bg-white border border-gray-200 hover:border-teal rounded-full text-xs font-semibold text-gray-700 transition shadow-sm cursor-pointer"
        >
          👤 Quiero asesoría personalizada, aprender y recuperar tiempo
        </button>
        <button
          onclick="responderChat(2, '🏢 Necesito proponer IA en mi empresa')"
          class="px-4 py-2.5 bg-white border border-gray-200 hover:border-teal rounded-full text-xs font-semibold text-gray-700 transition shadow-sm cursor-pointer"
        >
          🏢 Necesito proponer IA en mi empresa
        </button>
        <button
          onclick="responderChat(3, '📚 Ver recursos gratis')"
          class="px-4 py-2.5 bg-white border border-gray-200 hover:border-teal rounded-full text-xs font-semibold text-gray-700 transition shadow-sm cursor-pointer"
        >
          📚 Ver recursos gratis
        </button>
        <button
          onclick="responderChat(4, '🌡️ Termómetro LuciRMe Ai: ¿Qué tanto puedes optimizar tu día a día?')"
          class="px-4 py-2.5 bg-teal/10 hover:bg-teal text-teal hover:text-white border-2 border-teal rounded-full text-xs font-bold transition shadow-sm flex items-center gap-1.5 cursor-pointer ring-2 ring-teal/20"
        >
          <span>🌡️</span>
          <span>Termómetro LuciRMe Ai: ¿Qué tanto puedes optimizar tu día a día?</span>
        </button>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- SECCIÓN 3: SEGUIMIENTOS / NAV               -->
    <!-- ============================================ -->
    <section
      class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden"
      id="seguimientos-box"
    >
      <div
        class="px-6 py-4 bg-gray-50/50 border-b border-gray-100 flex items-center justify-between"
      >
        <span class="text-xs font-bold text-gray-400 uppercase tracking-widest"
          >¿QUÉ QUIERES SABER DE LUCIRME?</span
        >
        <span class="text-xs text-gray-400 flex items-center gap-1.5"
          ><span class="w-1.5 h-1.5 bg-teal rounded-full animate-pulse"></span> Elige
          tu punto de partida</span
        >
      </div>

      <div class="divide-y divide-gray-100">
        <!-- Enlace 1: Metodología -->
        <a
          href="/content/como_funciona"
          onclick="trackNavClick('/content/como_funciona', 'Metodologia')"
          class="w-full px-6 py-4 flex items-start gap-4 hover:bg-gray-50 transition text-left group"
        >
          <span
            class="text-teal font-bold text-lg mt-0.5 group-hover:translate-x-1 transition-transform"
            >↳</span
          >
          <div class="flex-grow">
            <p
              class="text-sm font-semibold text-deep group-hover:text-teal transition"
            >
              ¿Cómo funciona el enfoque de LucirMe?
            </p>
            <p class="text-xs text-gray-400 mt-1">
              Sistemas personalizados diseñados para que la tecnología trabaje
              en silencio y tú recuperes tu vida.
            </p>
          </div>
          <span
            class="hidden sm:inline-block text-[10px] font-bold text-gray-400 bg-gray-100 px-2.5 py-1 rounded-full uppercase tracking-wider whitespace-nowrap self-center"
            >Ver Método</span
          >
        </a>

        <!-- Enlace 2: Sobre Pablo -->
        <a
          href="/content/sobremi"
          onclick="trackNavClick('/content/sobremi', 'Sobre Pablo')"
          class="w-full px-6 py-4 flex items-start gap-4 hover:bg-gray-50 transition text-left group"
        >
          <span
            class="text-teal font-bold text-lg mt-0.5 group-hover:translate-x-1 transition-transform"
            >↳</span
          >
          <div class="flex-grow">
            <p
              class="text-sm font-semibold text-deep group-hover:text-teal transition"
            >
              Me gustaría conocer quién es Pablo Ríos
            </p>
            <p class="text-xs text-gray-400 mt-1">
              Ingeniero de sistemas con +10 años liderando productos digitales
              en Latam.
            </p>
          </div>
          <span
            class="hidden sm:inline-block text-[10px] font-bold text-gray-400 bg-gray-100 px-2.5 py-1 rounded-full uppercase tracking-wider whitespace-nowrap self-center"
            >Sobre Mí</span
          >
        </a>

        <!-- Enlace 3: Precios -->
        <a
          href="/content/precios"
          onclick="trackNavClick('/content/precios', 'Precios')"
          class="w-full px-6 py-4 flex items-start gap-4 hover:bg-gray-50 transition text-left group"
        >
          <span
            class="text-teal font-bold text-lg mt-0.5 group-hover:translate-x-1 transition-transform"
            >↳</span
          >
          <div class="flex-grow">
            <p
              class="text-sm font-semibold text-deep group-hover:text-teal transition"
            >
              Servicios
            </p>
            <p class="text-xs text-gray-400 mt-1">
              Consultorías uno a uno y talleres grupales.
            </p>
          </div>
          <span
            class="hidden sm:inline-block text-[10px] font-bold text-gray-400 bg-gray-100 px-2.5 py-1 rounded-full uppercase tracking-wider whitespace-nowrap self-center"
            >Inversión</span
          >
        </a>

        <!-- Enlace 4: Casos de éxito -->
        <a
          href="/content/casosreales"
          onclick="trackNavClick('/content/casosreales', 'Casos de Exito')"
          class="w-full px-6 py-4 flex items-start gap-4 hover:bg-gray-50 transition text-left group"
        >
          <span
            class="text-teal font-bold text-lg mt-0.5 group-hover:translate-x-1 transition-transform"
            >↳</span
          >
          <div class="flex-grow">
            <p
              class="text-sm font-semibold text-deep group-hover:text-teal transition"
            >
              Ver casos de éxito e impacto real
            </p>
            <p class="text-xs text-gray-400 mt-1">
              Profesionales y startups que ya han optimizado su tiempo y
              estandarizado flujos.
            </p>
          </div>
          <span
            class="hidden sm:inline-block text-[10px] font-bold text-gray-400 bg-gray-100 px-2.5 py-1 rounded-full uppercase tracking-wider whitespace-nowrap self-center"
            >Casos</span
          >
        </a>

        <!-- Enlace 5: Termómetro LuciRMe Ai -->
        <button
          onclick="document.getElementById('selector-overlay').classList.remove('hidden'); trackNavClick('#test-modal', 'Abrir Termometro');"
          class="w-full px-6 py-4 flex items-start gap-4 hover:bg-gray-50 transition text-left group bg-teal/5 border-t border-teal/10"
        >
          <span
            class="text-teal font-bold text-lg mt-0.5 group-hover:translate-x-1 transition-transform"
            >↳</span
          >
          <div class="flex-grow">
            <p
              class="text-sm font-bold text-deep group-hover:text-teal transition flex items-center gap-2"
            >
              <span>🌡️ Termómetro LuciRMe Ai: ¿Qué tanto puedes optimizar tu día a día?</span>
            </p>
            <p class="text-xs text-gray-500 mt-1">
              Responde en 2 minutos. Descubre cuántas horas pierdes en tareas repetitivas y recibe tu plan personalizado.
            </p>
          </div>
          <span
            class="hidden sm:inline-block text-[10px] font-bold text-white bg-teal px-3 py-1 rounded-full uppercase tracking-wider whitespace-nowrap self-center shadow-2xs"
            >Diagnóstico 2 min</span
          >
        </button>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  // Helper de rastreo seguro con PostHog
  function safeTrack(eventName, properties = {}) {
    if (typeof window !== "undefined" && window.posthog) {
      window.posthog.capture(eventName, properties);
    }
  }

  // Rastreo de enlaces de la sección de abajo
  function trackNavClick(destination, sectionLabel) {
    safeTrack("home_navigation_clicked", {
      destination_url: destination,
      section_label: sectionLabel,
    });
  }

  // LÓGICA DE SIMULADOR DE CHAT EN VIVO (Client Side)
  async function responderChat(opcion, textoBoton) {
    const messagesContainer = document.getElementById("chat-messages");
    const optionsDiv = document.getElementById("chat-options");
    const loadingDiv = document.getElementById("chat-loading");

    // RASTREO POSTHOG: Opción de chat elegida
    safeTrack("chat_option_clicked", {
      option_id: opcion,
      option_text: textoBoton,
    });

    // 1. Ocultar opciones para enfocar la conversación
    optionsDiv.style.display = "none";

    // 2. Pintar la burbuja del usuario
    const userBubble = document.createElement("div");
    userBubble.className =
      "space-y-2 text-right animate-fade-in chat-bubble-temp";
    userBubble.innerHTML = `
      <span class="text-orange font-bold text-xs uppercase tracking-widest block">Tú:</span>
      <div class="inline-block bg-teal text-white p-4 rounded-2xl rounded-tr-sm text-sm text-left max-w-lg shadow-md font-semibold">
        ${textoBoton}
      </div>
    `;
    messagesContainer.appendChild(userBubble);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;

    // 3. Mostrar indicador de carga
    messagesContainer.appendChild(loadingDiv);
    loadingDiv.classList.remove("hidden");
    messagesContainer.scrollTop = messagesContainer.scrollHeight;

    // 4. Retraso simulado de la IA
    await new Promise((resolve) => setTimeout(resolve, 1200));

    // Ocultamos el cargando
    loadingDiv.classList.add("hidden");

    // 5. Determinar la respuesta de la IA y configurar el botón con rastreo
    let text = "";
    let link = "";

    if (opcion === 1) {
      text =
        "El software debería trabajar para ti, no al revés. Puedes recuperar hasta 10 horas de tu semana automatizando flujos de forma limpia. Miremos tu caso en un Café Estratégico de 30 minutos sin costo, o revisa mis servicios individuales.";
      link = `
        <a 
          href='/soluciones/profesionales' 
          onclick="safeTrack('chat_cta_clicked', { destination: '/soluciones/profesionales', option_id: 1 })" 
          class='inline-block text-teal font-bold hover:underline mt-2'
        >
          Ver servicios de consultoría 1-1 →
        </a>`;
    } else if (opcion === 2) {
      text =
        "El caos manual frena el crecimiento y quema a los equipos. Estandarizo tus procesos con arquitecturas de IA para que tu roadmap avance sin fricción técnica. Hablemos en un espacio estratégico gratis para diagnosticar a tu equipo.";
      link = `
        <a 
          href='/soluciones/empresas' 
          onclick="safeTrack('chat_cta_clicked', { destination: '/soluciones/empresas', option_id: 2 })" 
          class='inline-block text-teal font-bold hover:underline mt-2'
        >
          Ver opciones para empresas y talleres →
        </a>`;
    } else if (opcion === 3) {
      text =
        "Valor inmediato y directo al grano. Tienes a tu disposición mis guías de optimización, funcionalidades listas y, si eres Product Manager, el acceso a mi Ebook 'PM Sin Bullshit'.";
      link = `
        <a 
          href='/recursos' 
          onclick="safeTrack('chat_cta_clicked', { destination: '/recursos', option_id: 3 })" 
          class='inline-block text-teal font-bold hover:underline mt-2'
        >
          Acceder a la librería de recursos →
        </a>`;
    } else if (opcion === 4) {
      text =
        "El primer paso para recuperar tu tiempo es medir exactamente dónde está la fuga. Responde nuestro Termómetro de 2 minutos para obtener un diagnóstico personalizado e inmediato.";
      link = `
        <button 
          onclick="document.getElementById('selector-overlay').classList.remove('hidden'); safeTrack('chat_cta_clicked', { destination: '#termometro', option_id: 4 })" 
          class='bg-orange hover:bg-orange/90 text-white font-bold px-5 py-2.5 rounded-xl text-xs transition inline-flex items-center gap-1.5 shadow-sm mt-2 cursor-pointer'
        >
          <span>🌡️ Abrir Termómetro LuciRMe AI</span> <span>→</span>
        </button>`;

      setTimeout(() => {
        const overlay = document.getElementById('selector-overlay');
        if (overlay) overlay.classList.remove('hidden');
      }, 500);
    }

    // 6. Pintar la respuesta de la IA y botón para reiniciar chat
    const botBubble = document.createElement("div");
    botBubble.className = "space-y-2 animate-fade-in chat-bubble-temp";
    botBubble.innerHTML = `
      <span class="text-teal font-bold text-xs uppercase tracking-widest block">LuciRMe AI:</span>
      <div class="inline-block bg-white border border-gray-200 p-4 rounded-2xl rounded-tl-sm text-sm text-gray-700 max-w-lg shadow-sm">
        <p>${text}</p>
        <div class="pt-4">${link}</div>
        <button onclick="reiniciarChat()" class="text-xs text-gray-400 hover:text-teal underline mt-4 block">← Probar otra opción</button>
      </div>
    `;
    messagesContainer.appendChild(botBubble);

    // Auto-scroll al final del chat
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  function reiniciarChat() {
    // RASTREO POSTHOG: Volver a empezar en el chat
    safeTrack("chat_reset_clicked");

    const messagesContainer = document.getElementById("chat-messages");
    const optionsDiv = document.getElementById("chat-options");

    // Eliminar las burbujas temporales creadas
    const tempBubbles = messagesContainer.querySelectorAll(".chat-bubble-temp");
    tempBubbles.forEach((bubble) => bubble.remove());

    // Mostrar de nuevo las opciones del chat
    optionsDiv.style.display = "flex";
  }
</script>

<style>
  .animate-fade-in {
    animation: fadeIn 0.4s ease-out forwards;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
