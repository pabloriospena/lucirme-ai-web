---
import Layout from "../layouts/Layout.astro";
import SobreMi from "../components/SobreMi.astro";
import { LINKS } from "../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
---

<Layout
  title="LuciRMe AI | Inteligencia Artificial & Operaciones con Pablo Ríos"
  description="Acompañamiento real en Inteligencia Artificial y Operaciones. Soluciones prácticas, mentoría 1-1, capacitación y páginas web comerciales sin humo."
  hideHeader={true}
  hideFooter={true}
>
  <!-- HEADER CON LOGO Y BARRAS DE NAVEGACIÓN -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-xl border-b border-slate-200/80 shadow-xs">
    
    <!-- Main Navigation Bar -->
    <div class="h-16 px-4 lg:px-8">
      <div class="max-w-7xl mx-auto h-16 flex items-center justify-between gap-4">
        
        <!-- Logo & Main Nav Links -->
        <div class="flex items-center gap-8">
          <a class="flex items-center gap-2.5 group" href="/">
            <img
              src="/logo-lucirme-ai.png"
              alt="LuciRMe AI"
              class="h-8 w-auto object-contain group-hover:scale-105 transition-transform"
            />
            <span class="font-bold text-lg text-slate-900 tracking-tight group-hover:text-teal-800 transition-colors">
              LuciRMe<span class="text-teal-700 ml-0.5">AI</span>
            </span>
          </a>

          <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-600">
            <a class="hover:text-slate-900 transition-colors" href="/educacion">Rutas</a>
            <a class="hover:text-slate-900 transition-colors" href="/empresas">Soluciones</a>
            <a class="hover:text-slate-900 transition-colors" href="/recursos">Recursos</a>
            <a class="hover:text-slate-900 transition-colors" href="/sobre-pablo">Sobre Pablo</a>
          </nav>
        </div>

        <!-- Right Side Actions -->
        <div class="flex items-center gap-3">
          <a
            class="hidden md:inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 hover:text-teal-800 transition-colors px-3 py-1.5 rounded-lg border border-slate-200/80 bg-slate-50/80"
            href="/empresas#diagnostico"
          >
            <span class="material-symbols-outlined text-[18px] text-amber-600">speed</span>
            <span>Termómetro IA</span>
          </a>

          <a
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold transition-all shadow-2xs"
            href={`${whatsappBase}?text=${encodeURIComponent("Hola Pablo, leí tu página de inicio y quiero hacerte una consulta directa.")}`}
            rel="noopener noreferrer"
            target="_blank"
            onclick="if (window.posthog) { window.posthog.capture('home_whatsapp_click', { origen: 'header' }); }"
          >
            <span class="material-symbols-outlined text-[18px]">chat_bubble</span>
            <span>Consultar vía WhatsApp</span>
          </a>

          <div class="w-8 h-8 rounded-full overflow-hidden border border-slate-200 shrink-0">
            <img src="/pablo-rios.jpeg" alt="Pablo Ríos" class="w-full h-full object-cover" />
          </div>
        </div>

      </div>
    </div>
  </header>

  <main class="w-full pt-20 bg-[#F8FAFC]">
    <div class="flex flex-col w-full">

      <!-- SECTION 1: HERO CONVERSACIONAL -->
      <section class="w-full max-w-7xl mx-auto px-4 lg:px-8 pt-8 pb-6">
        <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
          
          <!-- Eyebrow Badge -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-200/60 text-slate-700 text-xs font-mono font-medium uppercase tracking-wider mb-4 border border-slate-300/60">
            <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"></span>
            <span>Acompañamiento real en Inteligencia Artificial &amp; Operaciones</span>
          </div>

          <!-- Main Headline -->
          <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight max-w-3xl mb-3 leading-tight">
            ¿Qué quieres conseguir con IA?
          </h1>

          <!-- Subtitle -->
          <p class="text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed mb-8 font-normal">
            No necesitas otra teoría abstracta ni comprar un software de moda. Dime qué estás intentando resolver y te muestro el camino más corto.
          </p>

          <!-- Pablo Personal Assistant Note -->
          <div class="w-full max-w-2xl bg-white rounded-2xl border border-slate-200/80 shadow-xs p-4 md:p-5 text-left flex items-start gap-4 mb-4">
            <div class="relative shrink-0">
              <img
                src="/pablo-rios.jpeg"
                alt="Pablo Ríos"
                class="w-12 h-12 rounded-full object-cover ring-2 ring-emerald-500/80"
              />
              <div class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-emerald-500 rounded-full ring-2 ring-white"></div>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <span class="font-bold text-sm text-slate-900">Pablo Ríos</span>
                <span class="text-[11px] font-mono text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-semibold">En línea</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                “Hola, soy Pablo. Antes de mostrarte cursos o servicios, elijamos qué tiene sentido para ti hoy.”
              </p>
            </div>
          </div>

        </div>
      </section>

      <!-- SECTION 2: SELECTOR INTERACTIVO DE INTENCIÓN CON LINKS DIRECTOS -->
      <section class="w-full max-w-7xl mx-auto px-4 lg:px-8 pb-12">
        <div class="max-w-4xl mx-auto bg-white rounded-2xl border border-slate-200 shadow-sm p-6 lg:p-8">
          
          <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-6">
            <span class="font-mono text-xs font-semibold text-slate-900 uppercase tracking-wider flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[18px] text-teal-700">tune</span>
              Elige tu objetivo principal
            </span>
            <span class="font-mono text-xs text-slate-400">4 rutas disponibles</span>
          </div>

          <!-- Button Grid Selector con Links Directos -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6" id="intentionSelector">
            
            <!-- RUTA 01: APRENDER -->
            <div
              class="intention-btn text-left p-4 rounded-xl transition-all flex flex-col justify-between bg-teal-800 text-white shadow-xs cursor-pointer border border-teal-900 group"
              id="btn-aprender"
              onclick="window.selectIntention('aprender')"
            >
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="material-symbols-outlined text-[22px]">school</span>
                  <span class="font-mono text-xs opacity-80">Ruta 01</span>
                </div>
                <span class="font-bold text-sm leading-snug block">Quiero aprender a usar IA en mi trabajo diario</span>
                <span class="text-xs opacity-90 mt-1 block">Educación práctica, prompts y flujos individuales</span>
              </div>
              <div class="pt-3 flex items-center justify-between border-t border-white/20 mt-3">
                <a
                  href="/educacion"
                  class="inline-flex items-center gap-1 text-xs font-bold text-emerald-300 hover:text-white transition-colors underline cursor-pointer"
                  onclick="event.stopPropagation(); if (window.posthog) window.posthog.capture('home_card_direct_link', { ruta: 'aprender' });"
                >
                  <span>Explorar Educación</span>
                  <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                </a>
              </div>
            </div>

            <!-- RUTA 02: MENTORÍA 1-1 -->
            <div
              class="intention-btn text-left p-4 rounded-xl transition-all flex flex-col justify-between bg-slate-50 hover:bg-slate-100/80 text-slate-900 border border-slate-200 cursor-pointer group"
              id="btn-sesion"
              onclick="window.selectIntention('sesion')"
            >
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="material-symbols-outlined text-[22px] text-amber-700 icon-symbol">person_search</span>
                  <span class="font-mono text-xs text-slate-500 badge-tag">Ruta 02</span>
                </div>
                <span class="font-bold text-sm leading-snug block">Necesito resolver un cuello de botella con ayuda 1 a 1</span>
                <span class="text-xs text-slate-600 mt-1 block sub-text">Diagnóstico sobre tu pantalla y archivos reales</span>
              </div>
              <div class="pt-3 flex items-center justify-between border-t border-slate-200 mt-3 divider-line">
                <a
                  href="/profesionales"
                  class="inline-flex items-center gap-1 text-xs font-bold text-teal-700 hover:text-teal-900 transition-colors underline cursor-pointer card-link"
                  onclick="event.stopPropagation(); if (window.posthog) window.posthog.capture('home_card_direct_link', { ruta: 'sesion' });"
                >
                  <span>Ver Mentoría 1 a 1</span>
                  <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                </a>
              </div>
            </div>

            <!-- RUTA 03: EMPRESAS -->
            <div
              class="intention-btn text-left p-4 rounded-xl transition-all flex flex-col justify-between bg-slate-50 hover:bg-slate-100/80 text-slate-900 border border-slate-200 cursor-pointer group"
              id="btn-empresa"
              onclick="window.selectIntention('empresa')"
            >
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="material-symbols-outlined text-[22px] text-teal-700 icon-symbol">hub</span>
                  <span class="font-mono text-xs text-slate-500 badge-tag">Ruta 03</span>
                </div>
                <span class="font-bold text-sm leading-snug block">Quiero implementar IA o automatizar procesos en mi empresa</span>
                <span class="text-xs text-slate-600 mt-1 block sub-text">Make, Zapier, LLMs y reducción de fricción operativa</span>
              </div>
              <div class="pt-3 flex items-center justify-between border-t border-slate-200 mt-3 divider-line">
                <a
                  href="/empresas"
                  class="inline-flex items-center gap-1 text-xs font-bold text-teal-700 hover:text-teal-900 transition-colors underline cursor-pointer card-link"
                  onclick="event.stopPropagation(); if (window.posthog) window.posthog.capture('home_card_direct_link', { ruta: 'empresa' });"
                >
                  <span>Ver Soluciones Empresas</span>
                  <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                </a>
              </div>
            </div>

            <!-- RUTA 04: PÁGINAS WEB -->
            <div
              class="intention-btn text-left p-4 rounded-xl transition-all flex flex-col justify-between bg-slate-50 hover:bg-slate-100/80 text-slate-900 border border-slate-200 cursor-pointer group"
              id="btn-web"
              onclick="window.selectIntention('web')"
            >
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="material-symbols-outlined text-[22px] text-amber-600 icon-symbol">web</span>
                  <span class="font-mono text-xs text-slate-500 badge-tag">Ruta 04</span>
                </div>
                <span class="font-bold text-sm leading-snug block">Necesito una página web clara para mi negocio o clínica</span>
                <span class="text-xs text-slate-600 mt-1 block sub-text">Presencia digital directa, veloz y sin complejidades</span>
              </div>
              <div class="pt-3 flex items-center justify-between border-t border-slate-200 mt-3 divider-line">
                <a
                  href="/pagina-comercial"
                  class="inline-flex items-center gap-1 text-xs font-bold text-teal-700 hover:text-teal-900 transition-colors underline cursor-pointer card-link"
                  onclick="event.stopPropagation(); if (window.posthog) window.posthog.capture('home_card_direct_link', { ruta: 'web' });"
                >
                  <span>Ver Páginas Web</span>
                  <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                </a>
              </div>
            </div>

          </div>

          <!-- Dynamic Diagnosis Panel -->
          <div class="bg-slate-50 rounded-xl p-5 md:p-6 border border-slate-200/80" id="dynamicCard">
            <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
              <div class="space-y-3 flex-1">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                  <span class="font-mono text-xs font-semibold uppercase tracking-wider text-teal-800" id="routeBadge">
                    Diagnóstico en vivo · Educación aplicada
                  </span>
                </div>
                <h3 class="text-lg font-bold text-slate-900" id="routeTitle">
                  Construye tu propio criterio técnico sin perderte en novedades
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed" id="routeDiagnosis">
                  El problema habitual no es la falta de herramientas, sino no saber cuál encaja en tu flujo habitual. En lugar de aprender teoría de redes neuronales, nos concentramos en cómo redactar informes en 10 minutos, analizar documentación pesada con NotebookLM y sistematizar tu criterio.
                </p>
                <div class="bg-white p-3 rounded-lg border border-slate-200/80 flex items-center gap-2.5 text-xs">
                  <span class="material-symbols-outlined text-teal-700 text-[18px] shrink-0">flag</span>
                  <span class="text-slate-800" id="routeNextStep">
                    <strong>Siguiente paso sugerido:</strong> Revisa el catálogo estructurado de las Rutas de Aprendizaje LuciRMe.
                  </span>
                </div>
              </div>

              <!-- Direct CTA Block with Direct Link + WhatsApp Button -->
              <div class="md:w-64 shrink-0 flex flex-col gap-2 pt-2 md:pt-0">
                <a
                  class="w-full py-3 px-4 rounded-xl bg-teal-800 hover:bg-teal-900 text-white font-semibold text-xs text-center flex items-center justify-center gap-1.5 transition-colors shadow-2xs"
                  href="/educacion"
                  id="routePageBtn"
                  onclick="if (window.posthog) { window.posthog.capture('home_selector_page_click', { ruta: 'aprender' }); }"
                >
                  <span id="routePageLabel">Ver Rutas de Educación</span>
                  <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>

                <a
                  class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs text-center flex items-center justify-center gap-1.5 transition-colors shadow-2xs"
                  href={`${whatsappBase}?text=${encodeURIComponent("Hola Pablo, estoy interesado en aprender a usar IA en mi trabajo diario.")}`}
                  id="routeWhatsApp"
                  rel="noopener noreferrer"
                  target="_blank"
                  onclick="if (window.posthog) { window.posthog.capture('home_selector_cta_click', { ruta: 'aprender' }); }"
                >
                  <span class="material-symbols-outlined text-[16px]">chat</span>
                  <span>Hablar por WhatsApp</span>
                </a>
                
                <p class="font-mono text-[11px] text-slate-500 text-center mt-1">
                  Cuéntame tu caso y te digo qué haría yo, sin compromiso.
                </p>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- SECTION 3: QUIÉN SOY (PABLO RÍOS) -->
      <SobreMi id="pablo" />

      <!-- SECTION 4: LAS 4 RUTAS Y SOLUCIONES -->
      <section class="w-full max-w-7xl mx-auto px-4 lg:px-8 py-16 border-t border-slate-200">
        <div class="mb-10 max-w-2xl">
          <span class="font-mono text-xs text-teal-800 uppercase font-semibold tracking-wider block mb-1">
            Ecosistema LuciRMe
          </span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 tracking-tight">
            4 formas concretas de trabajar juntos
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-1">
            Cada opción está diseñada para resolver una etapa específica sin compras forzadas ni módulos de relleno.
          </p>
        </div>

        <!-- 4 Solutions Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Solución 1: Rutas de Aprendizaje -->
          <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs p-6 flex flex-col justify-between hover:border-slate-300 transition-all">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-teal-700">
                  <span class="material-symbols-outlined text-[22px]">auto_stories</span>
                </div>
                <span class="font-mono text-[11px] font-semibold px-2.5 py-1 rounded bg-slate-100 text-slate-700">Autodidacta / Guiado</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">
                Educación &amp; Rutas de Aprendizaje
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">
                Rutas directas al grano: Comunicación ejecutiva, Product Management asistido, NotebookLM para análisis documental, empleabilidad con IA y creación visual controlada.
              </p>
              <ul class="space-y-1.5 mb-6 text-xs text-slate-600 font-medium">
                <li class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                  Plantillas y prompts testeados en producción
                </li>
                <li class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                  Sin suscripciones sorpresa ni relleno teórico
                </li>
              </ul>
            </div>
            <a
              class="inline-flex items-center justify-between w-full py-2.5 px-4 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-900 text-xs font-semibold transition-colors border border-slate-200"
              href="/educacion"
            >
              <span>Ver rutas de aprendizaje</span>
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
          </div>

          <!-- Solución 2: Mentoría 1-1 -->
          <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs p-6 flex flex-col justify-between hover:border-slate-300 transition-all">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-700">
                  <span class="material-symbols-outlined text-[22px]">co_present</span>
                </div>
                <span class="font-mono text-[11px] font-semibold px-2.5 py-1 rounded bg-amber-100 text-amber-900">Alta intensidad</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">
                Mentoría &amp; Sesión 1-1 Estratégica
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">
                Diagnóstico quirúrgico de 60 a 90 minutos con pantalla compartida. Abrimos tus archivos, tus tareas repetitivas y configuramos las herramientas en vivo para tu día a día.
              </p>
              <ul class="space-y-1.5 mb-6 text-xs text-slate-600 font-medium">
                <li class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                  Resolución de tu caso particular en la misma sesión
                </li>
                <li class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                  Grabación completa y documentación resumen en Notion
                </li>
              </ul>
            </div>
            <a
              class="inline-flex items-center justify-between w-full py-2.5 px-4 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-900 text-xs font-semibold transition-colors border border-slate-200"
              href="/profesionales"
            >
              <span>Agendar sesión 1-1</span>
              <span class="material-symbols-outlined text-[18px]">calendar_today</span>
            </a>
          </div>

          <!-- Solución 3: Empresas -->
          <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs p-6 flex flex-col justify-between hover:border-slate-300 transition-all">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-teal-700">
                  <span class="material-symbols-outlined text-[22px]">settings_suggest</span>
                </div>
                <span class="font-mono text-[11px] font-semibold px-2.5 py-1 rounded bg-teal-50 text-teal-800 border border-teal-200">B2B &amp; Equipos</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">
                Soluciones para Empresas &amp; Cuellos de Botella
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">
                Diagnóstico forense de operaciones. Conectamos tus sistemas con Make/Zapier y LLMs para eliminar tareas repetitivas sin sobredimensionar la factura de software mensual.
              </p>
              <ul class="space-y-1.5 mb-6 text-xs text-slate-600 font-medium">
                <li class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                  Mapeo de fugas de horas por equipo de trabajo
                </li>
                <li class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                  Arquitectura pragmática: sólo la IA estrictamente necesaria
                </li>
              </ul>
            </div>
            <a
              class="inline-flex items-center justify-between w-full py-2.5 px-4 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-900 text-xs font-semibold transition-colors border border-slate-200"
              href="/empresas"
            >
              <span>Ver soluciones corporativas</span>
              <span class="material-symbols-outlined text-[18px]">business_center</span>
            </a>
          </div>

          <!-- Solución 4: Páginas Web Claras -->
          <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs p-6 flex flex-col justify-between hover:border-slate-300 transition-all">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600">
                  <span class="material-symbols-outlined text-[22px]">language</span>
                </div>
                <span class="font-mono text-[11px] font-semibold px-2.5 py-1 rounded bg-slate-100 text-slate-800">Negocios &amp; Clínicas</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">
                Presencia &amp; Páginas Web Claras
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">
                Diseñamos y montamos sitios web que tus clientes entienden a la primera. Especialmente pensadas para clínicas, servicios profesionales y firmas que quieren convertir visitas en contactos directos.
              </p>
              <ul class="space-y-1.5 mb-6 text-xs text-slate-600 font-medium">
                <li class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                  Estructura legible, rápida y conectada a WhatsApp
                </li>
                <li class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                  Entrega llave en mano que tú mismo puedes mantener
                </li>
              </ul>
            </div>
            <a
