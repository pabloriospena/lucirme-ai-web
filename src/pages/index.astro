  <!-- SCRIPT INTERACTIVO DEL SELECTOR DE INTENCIÓN CON LINKS Y WHATSAPP -->
  <script>
    const routesData: Record<string, any> = {
      aprender: {
        badge: "Diagnóstico en vivo · Educación aplicada",
        title: "Construye tu propio criterio técnico sin perderte en novedades",
        diagnosis: "El problema habitual no es la falta de herramientas, sino no saber cuál encaja en tu flujo habitual. En lugar de aprender teoría de redes neuronales, nos concentramos en cómo redactar informes en 10 minutos, analizar documentación pesada con NotebookLM y systematizar tu criterio.",
        nextStep: "Revisa el catálogo estructurado de las Rutas de Aprendizaje LuciRMe.",
        pageUrl: "/educacion",
        pageLabel: "Ver Rutas de Educación",
        waMessage: "Hola Pablo, estoy interesado en aprender a usar IA en mi trabajo diario."
      },
      sesion: {
        badge: "Diagnóstico en vivo · Mentoría 1 a 1",
        title: "Desbloquea tu cuello de botella en una sola sesión de trabajo",
        diagnosis: "Ideal si ya sabes lo que te quita tiempo (un informe manual, un desorden en Notion, o una tarea repetitiva) pero no das con el prompt o la integración adecuada. En 60-90 minutos compartimos pantalla, abrimos tus archivos reales y salimos con el flujo resuelto.",
        nextStep: "Revisa la propuesta de acompañamiento individual o agenda por WhatsApp.",
        pageUrl: "/profesionales",
        pageLabel: "Ver Mentoría 1 a 1",
        waMessage: "Hola Pablo, necesito resolver un cuello de botella con ayuda 1 a 1."
      },
      empresa: {
        badge: "Diagnóstico en vivo · Empresas y Equipos",
        title: "Automatiza procesos sin inflar tu costo fijo de software",
        diagnosis: "Muchas empresas compran licencias de IA costosas que nadie utiliza. Primero hacemos un diagnóstico forense de dónde se pierden horas en tu equipo, luego armamos automatizaciones con Make/Zapier y LLMs sobre herramientas que ya dominan.",
        nextStep: "Revisa los casos B2B y líneas de intervención para empresas.",
        pageUrl: "/empresas",
        pageLabel: "Ver Soluciones Empresas",
        waMessage: "Hola Pablo, quiero implementar IA o automatizar procesos en mi empresa."
      },
      web: {
        badge: "Diagnóstico en vivo · Presencia Digital",
        title: "Una página web clara que tus clientes entiendan sin enredos",
        diagnosis: "Tu clínica o negocio necesita que un visitante comprenda en 5 segundos qué resuelves, vea tus credenciales y haga clic en un botón de WhatsApp. Cero desarrollos interminables ni CMS imposibles de mantener.",
        nextStep: "Calcula el costo y cotización de tu Página Comercial en 2 minutos.",
        pageUrl: "/pagina-comercial",
        pageLabel: "Ver Páginas Web Comerciales",
        waMessage: "Hola Pablo, necesito una página web clara para mi negocio o clínica."
      }
    };

    function selectIntention(key: string) {
      const data = routesData[key];
      if (!data) return;

      const badgeEl = document.getElementById("routeBadge");
      const titleEl = document.getElementById("routeTitle");
      const diagEl = document.getElementById("routeDiagnosis");
      const nextEl = document.getElementById("routeNextStep");
      const pageBtn = document.getElementById("routePageBtn") as HTMLAnchorElement | null;
      const pageLabel = document.getElementById("routePageLabel");
      const waBtn = document.getElementById("routeWhatsApp") as HTMLAnchorElement | null;

      if (badgeEl) badgeEl.innerText = data.badge;
      if (titleEl) titleEl.innerText = data.title;
      if (diagEl) diagEl.innerText = data.diagnosis;
      if (nextEl) nextEl.innerHTML = "<strong>Siguiente paso sugerido:</strong> " + data.nextStep;
      if (pageBtn) pageBtn.href = data.pageUrl;
      if (pageLabel) pageLabel.innerText = data.pageLabel;
      if (waBtn) {
        waBtn.href = "https://wa.me/573053046180?text=" + encodeURIComponent(data.waMessage);
      }

      // Reset button styles
      const buttons = document.querySelectorAll(".intention-btn");
      buttons.forEach(btn => {
        btn.className = "intention-btn text-left p-4 rounded-xl transition-all flex flex-col justify-between bg-slate-50 hover:bg-slate-100/80 text-slate-900 border border-slate-200 cursor-pointer group";
        
        // Reset link inside card
        const link = btn.querySelector(".card-link");
        if (link) {
          link.className = "inline-flex items-center gap-1 text-xs font-bold text-teal-700 hover:text-teal-900 transition-colors underline cursor-pointer card-link";
        }

        // Reset divider
        const div = btn.querySelector(".divider-line");
        if (div) {
          div.className = "pt-3 flex items-center justify-between border-t border-slate-200 mt-3 divider-line";
        }

        // Reset badge tag
        const tag = btn.querySelector(".badge-tag");
        if (tag) {
          tag.className = "font-mono text-xs text-slate-500 badge-tag";
        }

        // Reset sub text
        const sub = btn.querySelector(".sub-text");
        if (sub) {
          sub.className = "text-xs text-slate-600 mt-1 block sub-text";
        }
      });

      // Highlight active button
      const activeBtn = document.getElementById("btn-" + key);
      if (activeBtn) {
        activeBtn.className = "intention-btn text-left p-4 rounded-xl transition-all flex flex-col justify-between bg-teal-800 text-white shadow-xs cursor-pointer border border-teal-900 group";
        
        const link = activeBtn.querySelector(".card-link");
        if (link) {
          link.className = "inline-flex items-center gap-1 text-xs font-bold text-emerald-300 hover:text-white transition-colors underline cursor-pointer card-link";
        }

        const div = activeBtn.querySelector(".divider-line");
        if (div) {
          div.className = "pt-3 flex items-center justify-between border-t border-white/20 mt-3 divider-line";
        }

        const tag = activeBtn.querySelector(".badge-tag");
        if (tag) {
          tag.className = "font-mono text-xs text-teal-200 badge-tag";
        }

        const sub = activeBtn.querySelector(".sub-text");
        if (sub) {
          sub.className = "text-xs text-teal-100 mt-1 block sub-text";
        }
      }

      if ((window as any).posthog) {
        (window as any).posthog.capture('home_selector_click', { ruta: key });
      }
    }

    (window as any).selectIntention = selectIntention;

    document.addEventListener("DOMContentLoaded", function () {
      if ((window as any).posthog) {
        (window as any).posthog.capture("home_page_view", {
          pagina: "home"
        });
      }
    });
  </script>
