---
// Inicio de la web nueva (Web LuciRMe v2). Un solo trabajo: llevar a Empieza gratis.
// La portada anterior quedó guardada en src/pages/_inicio-anterior.astro (Astro no la publica).
import LayoutV2 from "../layouts/LayoutV2.astro";
import SigueEnRedes from "../components/v2/SigueEnRedes.astro";
import { BANDAS, conteoBanda } from "../data/recursos.ts";
import { ARTICULOS, publicados } from "../data/biblioteca.js";

const articulos = import.meta.env.DEV ? ARTICULOS : publicados();
const filas = BANDAS.map((b) => ({
  ...b,
  n: b.id === "biblioteca" ? articulos.length : conteoBanda(b.id),
})).filter((b) => b.n > 0);
---

<LayoutV2
  title="LuciRMe AI | Aprende a usar IA en tu trabajo"
  description="Guías, rutas y prompts para aplicar la inteligencia artificial a lo que haces cada día, con Pablo Ríos."
>
  <section class="bg-v2-fondo px-4 pb-6 pt-8 sm:px-6 sm:pt-16">
    <div class="mx-auto max-w-4xl">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.05em] text-v2-accion">IA aplicada a procesos reales</p>
      <h1 class="mt-3 text-4xl font-extrabold leading-[1.12] tracking-[-0.9px] text-v2-texto sm:text-5xl">
        Aprende a usar IA en tu trabajo, paso a paso.
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-6 text-v2-cuerpo sm:text-lg sm:leading-7">
        Guías, rutas y prompts para aplicar IA a lo que haces cada día.
      </p>
      <a
        href="/empezar"
        class="mt-6 flex min-h-[52px] items-center justify-center rounded-xl bg-v2-accion px-6 text-base font-bold text-v2-accion-texto hover:bg-v2-accion-hover sm:inline-flex"
        onclick="if (window.posthog) { window.posthog.capture('cta_click', { boton: 'empieza-gratis', pagina: 'inicio' }); }"
      >
        Empieza gratis
      </a>
    </div>
  </section>

  <section class="border-t-[0.8px] border-v2-borde bg-v2-superficie px-4 py-8 sm:px-6 sm:py-12" aria-labelledby="que-encuentras">
    <div class="mx-auto max-w-4xl">
      <h2 id="que-encuentras" class="text-xl font-bold text-v2-texto sm:text-2xl">Qué encuentras</h2>
      <ul class="mt-1">
        {
          filas.map((b) => (
            <li class="border-t-[0.8px] border-v2-borde">
              <a href={`/recursos#banda-${b.id}`} class="flex min-h-16 items-center justify-between gap-3 py-3">
                <span>
                  <span class="block text-base font-bold text-v2-texto">{b.nombre}</span>
                  <span class="block text-sm leading-5 text-v2-cuerpo">{b.descripcion}</span>
                </span>
                <span class="flex shrink-0 items-center gap-2">
                  <span class="text-xs font-bold text-v2-suave">{b.n} {b.n === 1 ? "recurso" : "recursos"}</span>
                  <span aria-hidden="true" class="text-xl text-v2-suave">›</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t-[0.8px] border-v2-borde px-4 py-8 sm:px-6 sm:py-12">
    <div class="mx-auto max-w-4xl"><SigueEnRedes /></div>
  </section>
</LayoutV2>
