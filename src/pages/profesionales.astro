  <!-- SCRIPT DIAGNÓSTICO PROFESIONAL Y EVENTOS POSTHOG -->
  <script>
    let proStep = 1;
    const totalProSteps = 5;

    const proState: Record<string, any> = {
      area: '',
      frecuencia: '',
      tiempo: '',
      herramientas: [],
      objetivo: '',
      nombre: '',
      email: '',
      whatsapp: '',
    };

    // Restore from sessionStorage
    try {
      const saved = sessionStorage.getItem('pro_diag_state');
      if (saved) {
        Object.assign(proState, JSON.parse(saved));
      }
    } catch (e) {}

    function saveProState() {
      try {
        sessionStorage.setItem('pro_diag_state', JSON.stringify(proState));
      } catch (e) {}
    }

    function updateProWizardProgress() {
      const counter = document.getElementById('pro-step-counter');
      const bar = document.getElementById('pro-progress-bar');
      const tag = document.getElementById('pro-status-tag');
      const prevBtn = document.getElementById('pro-btn-prev') as HTMLButtonElement | null;

      if (!counter || !bar) return;

      if (proStep <= totalProSteps) {
        const pct = (proStep / totalProSteps) * 100;
        counter.innerText = `Paso ${proStep} de ${totalProSteps}`;
        bar.style.width = `${pct}%`;
        if (tag) tag.innerText = `Paso ${proStep}`;
        if (prevBtn) prevBtn.disabled = proStep === 1;
      } else {
        counter.innerText = 'Diagnóstico Completado';
        bar.style.width = '100%';
        if (tag) tag.innerText = 'Completado';
        if (prevBtn) prevBtn.disabled = false;
      }
    }

    function proGoToStep(step: number) {
      document.querySelectorAll('.pro-step').forEach(el => el.classList.add('hidden'));

      proStep = step;
      if (step <= totalProSteps) {
        const target = document.getElementById(`pro-step-${step}`);
        if (target) target.classList.remove('hidden');
      } else if (step === 6) {
        const target = document.getElementById('pro-step-6');
        if (target) target.classList.remove('hidden');
      } else {
        const res = document.getElementById('pro-step-result');
        if (res) res.classList.remove('hidden');
      }

      updateProWizardProgress();
    }

    function proPrevStep() {
      if (proStep > 1 && proStep <= totalProSteps) {
        proGoToStep(proStep - 1);
      } else if (proStep > totalProSteps) {
        proGoToStep(totalProSteps);
      }
    }

    function proNextStep(step: number) {
      if (step === 4) {
        proGoToStep(5);
      }
    }

    function proSelectArea(val: string, btn: HTMLElement) {
      proState.area = val;
      saveProState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('professional_diagnostic_question_answered', {
          question: 'area_friccion',
          answer: val,
        });
      }

      setTimeout(() => proGoToStep(2), 250);
    }

    function proSelectFrecuencia(val: string, btn: HTMLElement) {
      proState.frecuencia = val;
      saveProState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('professional_diagnostic_question_answered', {
          question: 'frecuencia',
          answer: val,
        });
      }

      setTimeout(() => proGoToStep(3), 250);
    }

    function proSelectTiempo(val: string, btn: HTMLElement) {
      proState.tiempo = val;
      saveProState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('professional_diagnostic_question_answered', {
          question: 'tiempo_estimado',
          answer: val,
        });
      }

      setTimeout(() => proGoToStep(4), 250);
    }

    function proToggleHerramienta(val: string, btn: HTMLElement) {
      const list: string[] = proState.herramientas || [];
      const idx = list.indexOf(val);

      if (idx >= 0) {
        list.splice(idx, 1);
        btn.classList.remove('border-teal-700', 'bg-teal-50', 'text-teal-900', 'font-bold');
        btn.classList.add('border-slate-200', 'text-slate-700');
      } else {
        list.push(val);
        btn.classList.remove('border-slate-200', 'text-slate-700');
        btn.classList.add('border-teal-700', 'bg-teal-50', 'text-teal-900', 'font-bold');
      }

      proState.herramientas = list;
      saveProState();
    }

    function proSelectObjetivo(val: string, btn: HTMLElement) {
      proState.objetivo = val;
      saveProState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('professional_diagnostic_question_answered', {
          question: 'objetivo',
          answer: val,
        });
      }

      setTimeout(() => proGoToStep(6), 300);
    }

    async function proSubmitLead() {
      const nomInput = document.getElementById('pro-input-nombre') as HTMLInputElement | null;
      const emInput = document.getElementById('pro-input-email') as HTMLInputElement | null;
      const waInput = document.getElementById('pro-input-whatsapp') as HTMLInputElement | null;
      const submitBtn = document.getElementById('pro-btn-submit') as HTMLButtonElement | null;

      const nom = nomInput?.value.trim() || '';
      const em = emInput?.value.trim() || '';
      const wa = waInput?.value.trim() || '';

      if (!nom) {
        alert('Por favor ingresa tu nombre.');
        return;
      }

      if (!em || !em.includes('@')) {
        alert('Por favor ingresa un correo electrónico válido.');
        return;
      }

      if (!wa) {
        alert('Por favor ingresa tu número de WhatsApp.');
        return;
      }

      proState.nombre = nom;
      proState.email = em;
      proState.whatsapp = wa;
      saveProState();

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Enviando y calculando...';
      }

      try {
        const res = await fetch('/api/professional-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: proState.nombre,
            email: proState.email,
            whatsapp: proState.whatsapp,
            problema_principal: proState.area || 'General',
            frecuencia: proState.frecuencia || 'Diaria',
            tiempo_estimado: proState.tiempo || '3–5 horas',
            herramientas_actuales: proState.herramientas,
            objetivo: proState.objetivo || 'Ahorrar tiempo',
            recomendacion: 'Sesión 1-1 enfocada',
          }),
        });

        const result = await res.json();
        if (!res.ok && result.error) {
          alert(result.error);
        }
      } catch (err) {
        console.error('Error enviando lead profesional:', err);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Ver diagnóstico y recomendación →';
        }
      }

      // Dynamic Result Text
      const summaryText = document.getElementById('pro-result-summary');
      if (summaryText) {
        const toolsStr = Array.isArray(proState.herramientas) && proState.herramientas.length > 0
          ? proState.herramientas.join(', ')
          : 'herramientas de IA básicas';

        summaryText.innerHTML = `
          Por lo que me cuentas, tienes una tarea en el área de <strong>${proState.area || 'tu trabajo diario'}</strong> que realizas <strong>${proState.frecuencia || 'frecuentemente'}</strong> y que te consume aproximadamente <strong>${proState.tiempo || 'varias horas'}</strong> a la semana. Ya utilizas algunas herramientas (<em>${toolsStr}</em>), pero todavía no tienes un flujo claro. En tu caso tendría sentido empezar por ese problema concreto y construir contigo una forma más simple de resolverlo.
        `;
      }

      if ((window as any).posthog) {
        (window as any).posthog.capture('professional_diagnostic_completed', {
          problem_area: proState.area,
          frequency: proState.frecuencia,
          time_estimate: proState.tiempo,
          goal: proState.objetivo,
        });
        (window as any).posthog.capture('professional_lead_submitted', {
          problem_area: proState.area,
          frequency: proState.frecuencia,
          goal: proState.objetivo,
        });
      }

      proGoToStep(7);
    }

    // Window assignments
    (window as any).proGoToStep = proGoToStep;
    (window as any).proPrevStep = proPrevStep;
    (window as any).proNextStep = proNextStep;
    (window as any).proSelectArea = proSelectArea;
    (window as any).proSelectFrecuencia = proSelectFrecuencia;
    (window as any).proSelectTiempo = proSelectTiempo;
    (window as any).proToggleHerramienta = proToggleHerramienta;
    (window as any).proSelectObjetivo = proSelectObjetivo;
    (window as any).proSubmitLead = proSubmitLead;

    document.addEventListener('DOMContentLoaded', () => {
      updateProWizardProgress();

      if ((window as any).posthog) {
        (window as any).posthog.capture('professional_session_view', {
          url: window.location.href,
        });
      }
    });
  </script>
</Layout>
