---
import Layout from "../layouts/Layout.astro";
import SocialProof from "../components/SocialProof.astro";
import { LINKS } from "../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const whatsapp1a1 = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, leí tu página de profesionales y quiero revisar mi caso para una sesión 1-1.")}`;
---

<Layout
  title="Sesiones 1-1 de IA Aplicada | LuciRMe AI"
  description="Sesiones 1-1 para profesionales que quieren aplicar IA a problemas reales de su trabajo, ahorrar tiempo y construir flujos de trabajo más simples."
  hideHeader={true}
  hideFooter={true}
>
  <!-- HEADER DEDICADO PROFESIONALES -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="h-16 max-w-7xl mx-auto px-6 flex items-center justify-between gap-4">
      <a class="flex flex-col group" href="#">
        <span class="text-base font-bold tracking-tight text-slate-900 group-hover:text-teal-700 transition-colors">LuciRMe AI · Sesiones 1-1</span>
        <span class="text-[11px] font-mono text-slate-500">Trabajamos sobre problemas reales de tu trabajo.</span>
      </a>

      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600">
        <a class="hover:text-slate-900 transition-colors" href="/servicios/producto#diagnostico-interactivo">Diagnóstico</a>
        <a class="hover:text-slate-900 transition-colors" href="#como-trabajamos">Cómo trabajamos</a>
        <a class="hover:text-slate-900 transition-colors" href="#lo-que-trabajamos">Lo que trabajamos</a>
        <a class="hover:text-slate-900 transition-colors" href="#formatos">Formatos</a>
        <a class="hover:text-slate-900 transition-colors" href="#pablo">Pablo</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-teal-700 text-white text-xs font-semibold hover:bg-teal-800 transition-colors shadow-2xs cursor-pointer"
          href="/servicios/producto#diagnostico-interactivo"
        >
          <span class="material-symbols-outlined text-[17px]">psychology</span>
          <span>Quiero revisar mi caso</span>
        </a>
      </div>
    </div>
  </header>

  <main class="w-full bg-[#F8FAFC]">

    <!-- HERO SECTION -->
    <section class="w-full max-w-7xl mx-auto px-6 pt-12 pb-12 md:py-20 border-b border-slate-200/60">
      <div class="max-w-3xl mx-auto flex flex-col items-center text-center gap-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-teal-50 border border-teal-200/80 rounded-full font-mono text-xs text-teal-800 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"></span>
          Acompañamiento individual en Inteligencia Artificial Aplicada
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
          ¿Sientes que podrías estar trabajando mucho mejor con IA?
        </h1>

        <p class="text-base md:text-lg text-slate-600 font-normal leading-relaxed">
          No necesitas aprender IA por aprender IA. Podemos mirar cómo trabajas hoy, encontrar dónde estás perdiendo tiempo y construir contigo una forma más simple de hacerlo.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2 w-full sm:w-auto">
          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer"
            href="/servicios/producto#diagnostico-interactivo"
            onclick="if(window.posthog) window.posthog.capture('professional_diagnostic_started');"
          >
            <span>Quiero revisar mi caso →</span>
          </a>

          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white border border-slate-200 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition-colors shadow-2xs"
            href={whatsapp1a1}
            rel="noopener noreferrer"
            target="_blank"
            onclick="if(window.posthog) window.posthog.capture('professional_session_whatsapp_click', { origen: 'hero' });"
          >
            <span class="material-symbols-outlined text-[18px]">chat</span>
            <span>Hablar con Pablo</span>
          </a>
        </div>

      </div>
    </section>

    <!-- TRANSICIÓN A LAS SESIONES Y CÓMO TRABAJAMOS (5 PASOS) -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16 border-t border-slate-200" id="como-trabajamos">
      <div class="max-w-3xl mb-12 flex flex-col gap-3">
        <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Sin rodeos ni teoría abstracta</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">
          Podemos trabajar sobre eso.
        </h2>
        <p class="text-sm md:text-base text-slate-600 leading-relaxed">
          En una sesión 1-1 no vamos a sentarnos a hablar de IA durante una hora. Vamos a trabajar sobre algo que realmente haces en tu día a día y buscar una forma mejor de hacerlo.
        </p>
        <p class="text-xs text-slate-500 leading-relaxed italic">
          Revisamos cómo lo haces hoy, identificamos dónde está el cuello de botella y construimos contigo una solución que puedas utilizar en tu trabajo real.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        
        <!-- Paso 01 -->
        <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-3">
          <div class="w-9 h-9 rounded-xl bg-teal-50 border border-teal-200 text-teal-800 font-mono text-xs font-bold flex items-center justify-center">
            01
          </div>
          <h3 class="text-sm font-bold text-slate-900">Entendemos</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Miramos en detalle cómo haces hoy el trabajo y qué insumos utilizas.</p>
        </div>

        <!-- Paso 02 -->
        <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 font-mono text-xs font-bold flex items-center justify-center">
            02
          </div>
          <h3 class="text-sm font-bold text-slate-900">Encontramos</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Identificamos el cuello de botella donde pierdes más tiempo o esfuerzo.</p>
        </div>

        <!-- Paso 03 -->
        <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-3">
          <div class="w-9 h-9 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 font-mono text-xs font-bold flex items-center justify-center">
            03
          </div>
          <h3 class="text-sm font-bold text-slate-900">Construimos</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Creamos contigo la solución, prompts o integración aplicada a tu caso.</p>
        </div>

        <!-- Paso 04 -->
        <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-3">
          <div class="w-9 h-9 rounded-xl bg-teal-50 border border-teal-200 text-teal-800 font-mono text-xs font-bold flex items-center justify-center">
            04
          </div>
          <h3 class="text-sm font-bold text-slate-900">Practicas</h3>
          <p class="text-xs text-slate-600 leading-relaxed">La pruebas en vivo con tus archivos y tareas reales para afinar detalles.</p>
        </div>

        <!-- Paso 05 -->
        <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 font-mono text-xs font-bold flex items-center justify-center">
            05
          </div>
          <h3 class="text-sm font-bold text-slate-900">Te independizas</h3>
          <p class="text-xs text-slate-600 leading-relaxed">La meta es que puedas seguir utilizándola de forma autónoma sin depender de mí.</p>
        </div>

      </div>

      <div class="p-4 bg-teal-50/80 border border-teal-200 rounded-2xl mt-8 max-w-3xl text-center mx-auto text-xs text-teal-900 font-medium">
        "No quiero que aprendas algo que después no uses. Quiero que salgas con algo que puedas aplicar de inmediato."
      </div>
    </section>

    <!-- QUÉ PODEMOS TRABAJAR -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16 border-t border-slate-200" id="lo-que-trabajamos">
      <div class="max-w-3xl mb-12 flex flex-col gap-2">
        <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Casos reales</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">
          Lo que podemos trabajar en tu sesión
        </h2>
        <p class="text-sm text-slate-600">
          Partimos de tu problema, no de una herramienta. Estos son ejemplos de áreas donde logramos mayor impacto:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center text-xl mb-1">✍️</div>
          <h3 class="text-base font-bold text-slate-900">Trabajo diario</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Correos complejos, documentación de proyectos, actas de reuniones, investigación rápida y tareas administrativas repetitivas.</p>
        </div>

        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl mb-1">⚡</div>
          <h3 class="text-base font-bold text-slate-900">Productividad personal</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Diseño de flujos de trabajo eficientes que hoy requieren demasiado tipeo o traspaso manual de datos.</p>
        </div>

        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center text-xl mb-1">🤖</div>
          <h3 class="text-base font-bold text-slate-900">IA aplicada a tu sector</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Cómo incorporar IA de forma ética, segura y útil en los procesos o entregables que ya tienes estandarizados.</p>
        </div>

        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center text-xl mb-1">🛠️</div>
          <h3 class="text-base font-bold text-slate-900">Sácale provecho a tus herramientas</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Aprende a dominar ChatGPT, Claude, Gemini, NotebookLM o Notion AI aplicados exactamente a tus archivos.</p>
        </div>

        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl mb-1">🔄</div>
          <h3 class="text-base font-bold text-slate-900">Automatización pragmática</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Identificar y conectar tareas manuales entre aplicaciones sin requerir conocimientos avanzados de programación.</p>
        </div>

        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center text-xl mb-1">📦</div>
          <h3 class="text-base font-bold text-slate-900">Product Management &amp; Tech</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Investigación de usuarios, PRDs, benchmarking, síntesis de feedback, priorización y tareas del día a día de producto.</p>
        </div>

      </div>
    </section>

    <!-- FORMATOS DE TRABAJO -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16 border-t border-slate-200" id="formatos">
      <div class="max-w-3xl mb-12 flex flex-col gap-2">
        <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Modalidades</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">
          Formas de trabajar juntos
        </h2>
        <p class="text-sm text-slate-600">
          Elige la intensidad según el nivel de transformación que quieras lograr en tu flujo de trabajo.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Sesión 1-1 -->
        <div class="p-8 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-teal-50 border border-teal-200 text-teal-800 flex items-center justify-center font-bold mb-4">
              1-1
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Sesión 1-1 Individual</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-6">
              Para resolver un problema concreto, revisar un proceso específico o encontrar por dónde empezar a usar IA en tu trabajo.
            </p>
            <ul class="space-y-2 text-xs text-slate-700 font-medium">
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Diagnóstico sobre pantalla compartida (60-90 min)</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Construcción de solución en vivo con tus datos real</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Grabación completa y documentación resumen en Notion</li>
            </ul>
          </div>
          <a
            class="mt-8 inline-flex items-center justify-center gap-2 w-full py-3.5 px-4 rounded-xl bg-teal-800 text-white font-semibold text-xs hover:bg-teal-900 transition-colors shadow-2xs text-center cursor-pointer"
            href="/servicios/producto#diagnostico-interactivo"
          >
            <span>Revisar mi caso para 1-1 →</span>
          </a>
        </div>

        <!-- Acompañamiento -->
        <div class="p-8 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 flex items-center justify-center font-bold mb-4">
              360
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Acompañamiento Continuo</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-6">
              Para trabajar varias situaciones consecutivas, implementar cambios profundos y acompañarte hasta que puedas incorporarlos de forma natural.
            </p>
            <ul class="space-y-2 text-xs text-slate-700 font-medium">
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Múltiples sesiones de trabajo sincrónico</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Soporte asincrónico por canal privado para dudas entre sesiones</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Seguimiento hasta lograr tu total autonomía operativa</li>
            </ul>
          </div>
          <a
            class="mt-8 inline-flex items-center justify-center gap-2 w-full py-3.5 px-4 rounded-xl bg-slate-900 text-white font-semibold text-xs hover:bg-slate-800 transition-colors shadow-2xs text-center cursor-pointer"
            href={whatsapp1a1}
            target="_blank"
          >
            <span>Consultar acompañamiento por WhatsApp →</span>
          </a>
        </div>

      </div>
    </section>

    <!-- TESTIMONIOS Y RESULTADOS MENTORÍAS 1-1 -->
    <SocialProof tipo="mentorias" id="casos" />

    <!-- SECCIÓN HUMANA & PRUEBA SOCIAL -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16 border-t border-slate-200" id="pablo">
      <div class="max-w-4xl mx-auto bg-white rounded-2xl border border-slate-200 shadow-2xs p-8 md:p-12 flex flex-col md:flex-row gap-8 items-start">
        
        <div class="w-16 h-16 rounded-full bg-teal-50 border border-teal-200 text-teal-800 flex items-center justify-center shrink-0 font-bold text-xl">
          PR
        </div>

        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1">
            <span class="font-mono text-xs text-teal-800 uppercase font-semibold">Detrás de esto estoy yo</span>
            <h2 class="text-2xl font-bold text-slate-900">Pablo Ríos</h2>
            <p class="text-xs font-semibold text-slate-600">Consultor de Producto, Operaciones e IA</p>
          </div>

          <div class="text-xs text-slate-600 flex flex-col gap-3 leading-relaxed">
            <p class="text-sm font-semibold text-slate-800">
              "He trabajado con profesionales y equipos para convertir problemas concretos en soluciones que realmente puedan utilizar."
            </p>
            <p>
              Mi enfoque no es venderte cursos extensos con teoría que no aplicas. En cada sesión abrimos tu pantalla, miramos tus archivos y salimos con el problema resuelto.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-4 pt-2 border-t border-slate-100">
            <div>
              <div class="font-bold text-base text-slate-900">+50 profesionales</div>
              <div class="text-[11px] text-slate-500">Acompañados 1-1 en adopción práctica</div>
            </div>
            <div>
              <div class="font-bold text-base text-slate-900">+30 empresas</div>
              <div class="text-[11px] text-slate-500">Intervenidas en automatización de procesos</div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16 border-t border-slate-200" id="cta-final">
      <div class="p-8 md:p-12 bg-white rounded-2xl border border-slate-200 text-center flex flex-col items-center gap-5 shadow-2xs max-w-3xl mx-auto">
        <span class="font-mono text-xs font-semibold text-teal-800 uppercase font-mono">Paso Siguiente</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">
          ¿Lo trabajamos juntos?
        </h2>
        <p class="text-xs md:text-sm text-slate-600 max-w-xl leading-relaxed">
          Cuéntame qué estás intentando resolver y vemos si tiene sentido trabajarlo en una sesión 1-1.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer"
            href="/servicios/producto#diagnostico-interactivo"
          >
            <span>Quiero revisar mi caso →</span>
          </a>

          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white border border-slate-200 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition-colors shadow-2xs"
            href={whatsapp1a1}
            rel="noopener noreferrer"
            target="_blank"
            onclick="if(window.posthog) window.posthog.capture('professional_session_whatsapp_click', { origen: 'cta_final' });"
          >
            <span class="material-symbols-outlined text-[18px]">chat</span>
            <span>Hablar con Pablo</span>
          </a>
        </div>

        <p class="text-xs font-mono text-slate-500">Sin compromisos ni ventas agresivas.</p>
      </div>
    </section>

  </main>

  <!-- FOOTER DEDICADO PROFESIONALES -->
  <footer class="w-full bg-white border-t border-slate-200 py-12">
    <div class="max-w-7xl mx-auto px-6 flex flex-col gap-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex flex-col gap-1">
          <span class="text-base font-bold text-slate-900">LuciRMe AI · Sesiones 1-1</span>
          <p class="text-xs font-mono text-slate-500">Trabajamos sobre problemas reales de tu trabajo.</p>
        </div>
        <div class="flex items-center gap-4 text-xs text-slate-600 font-medium">
          <a class="hover:text-slate-900 transition-colors" href={whatsapp1a1} target="_blank">WhatsApp Directo</a>
          <a class="hover:text-slate-900 transition-colors" href="/educacion">Educación</a>
          <a class="hover:text-slate-900 transition-colors" href="/empresas">Empresas</a>
        </div>
      </div>
      <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-500">
        <span>© 2026 LuciRMe AI · Todos los derechos reservados.</span>
        <span>lucirme.com/profesionales</span>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if ((window as any).posthog) {
        (window as any).posthog.capture('professional_session_view', {
          url: window.location.href,
        });
      }
    });
  </script>
</Layout>
