---
import LayoutV2 from "../layouts/LayoutV2.astro";
import SocialProof from "../components/SocialProof.astro";
import { LINKS } from "../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const whatsapp1a1 = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, leí tu página de profesionales y quiero revisar mi caso para una sesión 1-1.")}`;

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Sesiones 1-1 de IA aplicada para profesionales",
  url: "https://lucirme.com/profesionales",
  description: "Sesiones 1-1 para profesionales que quieren aplicar IA a problemas reales de su trabajo, ahorrar tiempo y construir flujos de trabajo más simples.",
  provider: { "@id": "https://lucirme.com/#organization" },
  areaServed: "Latinoamérica",
  availableLanguage: "es",
  audience: { "@type": "Audience", audienceType: "Profesionales y emprendedores" },
};

---

<LayoutV2
  title="Sesiones 1-1 de IA Aplicada | LuciRMe AI"
  description="Sesiones 1-1 para profesionales que quieren aplicar IA a problemas reales de su trabajo, ahorrar tiempo y construir flujos de trabajo más simples."
  jsonLd={serviceJsonLd}
>

  <div class="w-full bg-v2-superficie">

    <!-- HERO SECTION -->
    <section class="w-full max-w-7xl mx-auto px-6 pt-12 pb-12 md:py-20 border-b border-v2-borde">
      <div class="max-w-3xl mx-auto flex flex-col items-center text-center gap-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-v2-marca-tinte border border-v2-marca-borde rounded-full font-mono text-xs text-v2-marca-texto shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-v2-accion animate-pulse"></span>
          Acompañamiento individual en Inteligencia Artificial Aplicada
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-v2-texto leading-[1.15]">
          ¿Sientes que podrías estar trabajando mucho mejor con IA?
        </h1>

        <p class="text-base md:text-lg text-v2-cuerpo font-normal leading-relaxed">
          No necesitas aprender IA por aprender IA. Podemos mirar cómo trabajas hoy, encontrar dónde estás perdiendo tiempo y construir contigo una forma más simple de hacerlo.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2 w-full sm:w-auto">
          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-v2-accion text-v2-accion-texto font-semibold text-sm hover:bg-v2-accion-hover transition-colors shadow-2xs cursor-pointer"
            href="/empresas#diagnostico"
            onclick="if(window.posthog) window.posthog.capture('professional_diagnostic_started');"
          >
            <span>Quiero revisar mi caso →</span>
          </a>

          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-v2-fondo border border-v2-borde text-v2-cuerpo font-semibold text-sm hover:bg-v2-superficie transition-colors shadow-2xs"
            href={whatsapp1a1}
            rel="noopener noreferrer"
            target="_blank"
            onclick="if(window.posthog) window.posthog.capture('professional_session_whatsapp_click', { origen: 'hero' });"
          >
            <span class="material-symbols-outlined text-[18px]">chat</span>
            <span>Hablar con Pablo</span>
          </a>
        </div>

      </div>
    </section>

    <!-- TRANSICIÓN A LAS SESIONES Y CÓMO TRABAJAMOS (5 PASOS) -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16 border-t border-v2-borde" id="como-trabajamos">
      <div class="max-w-3xl mb-12 flex flex-col gap-3">
        <span class="font-mono text-xs font-semibold text-v2-marca-texto uppercase">Sin rodeos ni teoría abstracta</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-v2-texto">
          Podemos trabajar sobre eso.
        </h2>
        <p class="text-sm md:text-base text-v2-cuerpo leading-relaxed">
          En una sesión 1-1 no vamos a sentarnos a hablar de IA durante una hora. Vamos a trabajar sobre algo que realmente haces en tu día a día y buscar una forma mejor de hacerlo.
        </p>
        <p class="text-xs text-v2-suave leading-relaxed italic">
          Revisamos cómo lo haces hoy, identificamos dónde está el cuello de botella y construimos contigo una solución que puedas utilizar en tu trabajo real.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        
        <!-- Paso 01 -->
        <div class="p-5 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col gap-3">
          <div class="w-9 h-9 rounded-xl bg-v2-marca-tinte border border-v2-marca-borde text-v2-marca-texto font-mono text-xs font-bold flex items-center justify-center">
            01
          </div>
          <h3 class="text-sm font-bold text-v2-texto">Entendemos</h3>
          <p class="text-xs text-v2-cuerpo leading-relaxed">Miramos en detalle cómo haces hoy el trabajo y qué insumos utilizas.</p>
        </div>

        <!-- Paso 02 -->
        <div class="p-5 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col gap-3">
          <div class="w-9 h-9 rounded-xl bg-v2-exito-fondo border border-v2-exito-borde text-v2-exito font-mono text-xs font-bold flex items-center justify-center">
            02
          </div>
          <h3 class="text-sm font-bold text-v2-texto">Encontramos</h3>
          <p class="text-xs text-v2-cuerpo leading-relaxed">Identificamos el cuello de botella donde pierdes más tiempo o esfuerzo.</p>
        </div>

        <!-- Paso 03 -->
        <div class="p-5 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col gap-3">
          <div class="w-9 h-9 rounded-xl bg-v2-pago-fondo border border-v2-pago-borde text-v2-pago-texto font-mono text-xs font-bold flex items-center justify-center">
            03
          </div>
          <h3 class="text-sm font-bold text-v2-texto">Construimos</h3>
          <p class="text-xs text-v2-cuerpo leading-relaxed">Creamos contigo la solución, prompts o integración aplicada a tu caso.</p>
        </div>

        <!-- Paso 04 -->
        <div class="p-5 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col gap-3">
          <div class="w-9 h-9 rounded-xl bg-v2-marca-tinte border border-v2-marca-borde text-v2-marca-texto font-mono text-xs font-bold flex items-center justify-center">
            04
          </div>
          <h3 class="text-sm font-bold text-v2-texto">Practicas</h3>
          <p class="text-xs text-v2-cuerpo leading-relaxed">La pruebas en vivo con tus archivos y tareas reales para afinar detalles.</p>
        </div>

        <!-- Paso 05 -->
        <div class="p-5 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col gap-3">
          <div class="w-9 h-9 rounded-xl bg-v2-exito-fondo border border-v2-exito-borde text-v2-exito font-mono text-xs font-bold flex items-center justify-center">
            05
          </div>
          <h3 class="text-sm font-bold text-v2-texto">Te independizas</h3>
          <p class="text-xs text-v2-cuerpo leading-relaxed">La meta es que puedas seguir utilizándola de forma autónoma sin depender de mí.</p>
        </div>

      </div>

      <div class="p-4 bg-v2-marca-tinte border border-v2-marca-borde rounded-2xl mt-8 max-w-3xl text-center mx-auto text-xs text-v2-marca-texto font-medium">
        "No quiero que aprendas algo que después no uses. Quiero que salgas con algo que puedas aplicar de inmediato."
      </div>
    </section>

    <!-- QUÉ PODEMOS TRABAJAR -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16 border-t border-v2-borde" id="lo-que-trabajamos">
      <div class="max-w-3xl mb-12 flex flex-col gap-2">
        <span class="font-mono text-xs font-semibold text-v2-marca-texto uppercase">Casos reales</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-v2-texto">
          Lo que podemos trabajar en tu sesión
        </h2>
        <p class="text-sm text-v2-cuerpo">
          Partimos de tu problema, no de una herramienta. Estos son ejemplos de áreas donde logramos mayor impacto:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <div class="p-6 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-v2-marca-tinte text-v2-accion flex items-center justify-center text-xl mb-1">✍️</div>
          <h3 class="text-base font-bold text-v2-texto">Trabajo diario</h3>
          <p class="text-xs text-v2-cuerpo leading-relaxed">Correos complejos, documentación de proyectos, actas de reuniones, investigación rápida y tareas administrativas repetitivas.</p>
        </div>

        <div class="p-6 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-v2-exito-fondo text-v2-exito flex items-center justify-center text-xl mb-1">⚡</div>
          <h3 class="text-base font-bold text-v2-texto">Productividad personal</h3>
          <p class="text-xs text-v2-cuerpo leading-relaxed">Diseño de flujos de trabajo eficientes que hoy requieren demasiado tipeo o traspaso manual de datos.</p>
        </div>

        <div class="p-6 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-v2-pago-fondo text-v2-pago-texto flex items-center justify-center text-xl mb-1">🤖</div>
          <h3 class="text-base font-bold text-v2-texto">IA aplicada a tu sector</h3>
          <p class="text-xs text-v2-cuerpo leading-relaxed">Cómo incorporar IA de forma ética, segura y útil en los procesos o entregables que ya tienes estandarizados.</p>
        </div>

        <div class="p-6 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-v2-marca-tinte text-v2-accion flex items-center justify-center text-xl mb-1">🛠️</div>
          <h3 class="text-base font-bold text-v2-texto">Sácale provecho a tus herramientas</h3>
          <p class="text-xs text-v2-cuerpo leading-relaxed">Aprende a dominar ChatGPT, Claude, Gemini, NotebookLM o Notion AI aplicados exactamente a tus archivos.</p>
        </div>

        <div class="p-6 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-v2-exito-fondo text-v2-exito flex items-center justify-center text-xl mb-1">🔄</div>
          <h3 class="text-base font-bold text-v2-texto">Automatización pragmática</h3>
          <p class="text-xs text-v2-cuerpo leading-relaxed">Identificar y conectar tareas manuales entre aplicaciones sin requerir conocimientos avanzados de programación.</p>
        </div>

        <div class="p-6 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-v2-pago-fondo text-v2-pago-texto flex items-center justify-center text-xl mb-1">📦</div>
          <h3 class="text-base font-bold text-v2-texto">Product Management &amp; Tech</h3>
          <p class="text-xs text-v2-cuerpo leading-relaxed">Investigación de usuarios, PRDs, benchmarking, síntesis de feedback, priorización y tareas del día a día de producto.</p>
        </div>

      </div>
    </section>

    <!-- FORMATOS DE TRABAJO -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16 border-t border-v2-borde" id="formatos">
      <div class="max-w-3xl mb-12 flex flex-col gap-2">
        <span class="font-mono text-xs font-semibold text-v2-marca-texto uppercase">Modalidades</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-v2-texto">
          Formas de trabajar juntos
        </h2>
        <p class="text-sm text-v2-cuerpo">
          Elige la intensidad según el nivel de transformación que quieras lograr en tu flujo de trabajo.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Sesión 1-1 -->
        <div class="p-8 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-v2-marca-tinte border border-v2-marca-borde text-v2-marca-texto flex items-center justify-center font-bold mb-4">
              1-1
            </div>
            <h3 class="text-xl font-bold text-v2-texto mb-2">Sesión 1-1 Individual</h3>
            <p class="text-xs text-v2-cuerpo leading-relaxed mb-6">
              Para resolver un problema concreto, revisar un proceso específico o encontrar por dónde empezar a usar IA en tu trabajo.
            </p>
            <ul class="space-y-2 text-xs text-v2-cuerpo font-medium">
              <li class="flex items-center gap-2"><span class="text-v2-exito font-bold">✓</span> Diagnóstico sobre pantalla compartida (60-90 min)</li>
              <li class="flex items-center gap-2"><span class="text-v2-exito font-bold">✓</span> Construcción de solución en vivo con tus datos real</li>
              <li class="flex items-center gap-2"><span class="text-v2-exito font-bold">✓</span> Grabación completa y documentación resumen en Notion</li>
            </ul>
          </div>
          <a
            class="mt-8 inline-flex items-center justify-center gap-2 w-full py-3.5 px-4 rounded-xl bg-v2-accion text-v2-accion-texto font-semibold text-xs hover:bg-v2-accion-hover transition-colors shadow-2xs text-center cursor-pointer"
            href="/empresas#diagnostico"
          >
            <span>Revisar mi caso para 1-1 →</span>
          </a>
        </div>

        <!-- Acompañamiento -->
        <div class="p-8 bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-v2-pago-fondo border border-v2-pago-borde text-v2-pago-texto flex items-center justify-center font-bold mb-4">
              360
            </div>
            <h3 class="text-xl font-bold text-v2-texto mb-2">Acompañamiento Continuo</h3>
            <p class="text-xs text-v2-cuerpo leading-relaxed mb-6">
              Para trabajar varias situaciones consecutivas, implementar cambios profundos y acompañarte hasta que puedas incorporarlos de forma natural.
            </p>
            <ul class="space-y-2 text-xs text-v2-cuerpo font-medium">
              <li class="flex items-center gap-2"><span class="text-v2-exito font-bold">✓</span> Múltiples sesiones de trabajo sincrónico</li>
              <li class="flex items-center gap-2"><span class="text-v2-exito font-bold">✓</span> Soporte asincrónico por canal privado para dudas entre sesiones</li>
              <li class="flex items-center gap-2"><span class="text-v2-exito font-bold">✓</span> Seguimiento hasta lograr tu total autonomía operativa</li>
            </ul>
          </div>
          <a
            class="mt-8 inline-flex items-center justify-center gap-2 w-full py-3.5 px-4 rounded-xl bg-v2-texto text-v2-fondo font-semibold text-xs hover:bg-v2-cuerpo transition-colors shadow-2xs text-center cursor-pointer"
            href={whatsapp1a1}
            target="_blank"
          >
            <span>Consultar acompañamiento por WhatsApp →</span>
          </a>
        </div>

      </div>
    </section>

    <!-- TESTIMONIOS Y RESULTADOS MENTORÍAS 1-1 -->
    <SocialProof tipo="mentorias" id="casos" />

    <!-- SECCIÓN HUMANA & PRUEBA SOCIAL -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16 border-t border-v2-borde" id="pablo">
      <div class="max-w-4xl mx-auto bg-v2-fondo rounded-2xl border border-v2-borde shadow-2xs p-8 md:p-12 flex flex-col md:flex-row gap-8 items-start">
        
        <div class="w-16 h-16 rounded-full bg-v2-marca-tinte border border-v2-marca-borde text-v2-marca-texto flex items-center justify-center shrink-0 font-bold text-xl">
          PR
        </div>

        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1">
            <span class="font-mono text-xs text-v2-marca-texto uppercase font-semibold">Detrás de esto estoy yo</span>
            <h2 class="text-2xl font-bold text-v2-texto">Pablo Ríos</h2>
            <p class="text-xs font-semibold text-v2-cuerpo">Consultor de Producto, Operaciones e IA</p>
          </div>

          <div class="text-xs text-v2-cuerpo flex flex-col gap-3 leading-relaxed">
            <p class="text-sm font-semibold text-v2-texto">
              "He trabajado con profesionales y equipos para convertir problemas concretos en soluciones que realmente puedan utilizar."
            </p>
            <p>
              Mi enfoque no es venderte cursos extensos con teoría que no aplicas. En cada sesión abrimos tu pantalla, miramos tus archivos y salimos con el problema resuelto.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-4 pt-2 border-t border-v2-borde">
            <div>
              <div class="font-bold text-base text-v2-texto">+50 profesionales</div>
              <div class="text-[11px] text-v2-suave">Acompañados 1-1 en adopción práctica</div>
            </div>
            <div>
              <div class="font-bold text-base text-v2-texto">+30 empresas</div>
              <div class="text-[11px] text-v2-suave">Intervenidas en automatización de procesos</div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16 border-t border-v2-borde" id="cta-final">
      <div class="p-8 md:p-12 bg-v2-fondo rounded-2xl border border-v2-borde text-center flex flex-col items-center gap-5 shadow-2xs max-w-3xl mx-auto">
        <span class="font-mono text-xs font-semibold text-v2-marca-texto uppercase font-mono">Paso Siguiente</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-v2-texto">
          ¿Lo trabajamos juntos?
        </h2>
        <p class="text-xs md:text-sm text-v2-cuerpo max-w-xl leading-relaxed">
          Cuéntame qué estás intentando resolver y vemos si tiene sentido trabajarlo en una sesión 1-1.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-v2-accion text-v2-accion-texto font-semibold text-sm hover:bg-v2-accion-hover transition-colors shadow-2xs cursor-pointer"
            href="/empresas#diagnostico"
          >
            <span>Quiero revisar mi caso →</span>
          </a>

          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-v2-fondo border border-v2-borde text-v2-cuerpo font-semibold text-sm hover:bg-v2-superficie transition-colors shadow-2xs"
            href={whatsapp1a1}
            rel="noopener noreferrer"
            target="_blank"
            onclick="if(window.posthog) window.posthog.capture('professional_session_whatsapp_click', { origen: 'cta_final' });"
          >
            <span class="material-symbols-outlined text-[18px]">chat</span>
            <span>Hablar con Pablo</span>
          </a>
        </div>

        <p class="text-xs font-mono text-v2-suave">Sin compromisos ni ventas agresivas.</p>
      </div>
    </section>

  </div>

  <!-- FOOTER DEDICADO PROFESIONALES -->

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if ((window as any).posthog) {
        (window as any).posthog.capture('professional_session_view', {
          url: window.location.href,
        });
      }
    });
  </script>
</LayoutV2>
