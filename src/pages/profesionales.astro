---
import Layout from "../layouts/Layout.astro";
import SocialProof from "../components/SocialProof.astro";
import { LINKS } from "../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const whatsapp1a1 = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, leí tu página de profesionales y quiero revisar mi caso para una sesión 1-1.")}`;
---

<Layout
  title="Sesiones 1-1 de IA Aplicada | LuciRMe AI"
  description="Sesiones 1-1 para profesionales que quieren aplicar IA a problemas reales de su trabajo, ahorrar tiempo y construir flujos de trabajo más simples."
  hideHeader={true}
  hideFooter={true}
>
  <!-- HEADER DEDICADO PROFESIONALES -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="h-16 max-w-7xl mx-auto px-6 flex items-center justify-between gap-4">
      <a class="flex flex-col group" href="#">
        <span class="text-base font-bold tracking-tight text-slate-900 group-hover:text-teal-700 transition-colors">LuciRMe AI · Sesiones 1-1</span>
        <span class="text-[11px] font-mono text-slate-500">Trabajamos sobre problemas reales de tu trabajo.</span>
      </a>

      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600">
        <a class="hover:text-slate-900 transition-colors" href="#diagnostico-profesional">Diagnóstico</a>
        <a class="hover:text-slate-900 transition-colors" href="#como-trabajamos">Cómo trabajamos</a>
        <a class="hover:text-slate-900 transition-colors" href="#lo-que-trabajamos">Lo que trabajamos</a>
        <a class="hover:text-slate-900 transition-colors" href="#formatos">Formatos</a>
        <a class="hover:text-slate-900 transition-colors" href="#pablo">Pablo</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-teal-700 text-white text-xs font-semibold hover:bg-teal-800 transition-colors shadow-2xs cursor-pointer"
          href="#diagnostico-profesional"
        >
          <span class="material-symbols-outlined text-[17px]">psychology</span>
          <span>Quiero revisar mi caso</span>
        </a>
      </div>
    </div>
  </header>

  <main class="w-full bg-[#F8FAFC]">

    <!-- HERO SECTION -->
    <section class="w-full max-w-7xl mx-auto px-6 pt-12 pb-12 md:py-20 border-b border-slate-200/60">
      <div class="max-w-3xl mx-auto flex flex-col items-center text-center gap-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-teal-50 border border-teal-200/80 rounded-full font-mono text-xs text-teal-800 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"></span>
          Acompañamiento individual en Inteligencia Artificial Aplicada
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
          ¿Sientes que podrías estar trabajando mucho mejor con IA?
        </h1>

        <p class="text-base md:text-lg text-slate-600 font-normal leading-relaxed">
          No necesitas aprender IA por aprender IA. Podemos mirar cómo trabajas hoy, encontrar dónde estás perdiendo tiempo y construir contigo una forma más simple de hacerlo.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2 w-full sm:w-auto">
          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer"
            href="#diagnostico-profesional"
            onclick="if(window.posthog) window.posthog.capture('professional_diagnostic_started');"
          >
            <span>Quiero revisar mi caso →</span>
          </a>

          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white border border-slate-200 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition-colors shadow-2xs"
            href={whatsapp1a1}
            rel="noopener noreferrer"
            target="_blank"
            onclick="if(window.posthog) window.posthog.capture('professional_session_whatsapp_click', { origen: 'hero' });"
          >
            <span class="material-symbols-outlined text-[18px]">chat</span>
            <span>Hablar con Pablo</span>
          </a>
        </div>

      </div>
    </section>

    <!-- COMPONENTE DIAGNÓSTICO PROFESIONAL -->
    <section class="w-full max-w-7xl mx-auto px-6 py-12 scroll-mt-20" id="diagnostico-profesional">
      <div class="max-w-2xl mx-auto flex flex-col gap-6">

        <div class="bg-white rounded-2xl border border-slate-200 shadow-md p-6 md:p-8 relative min-h-[400px] flex flex-col justify-between" id="pro-wizard-card">
          
          <!-- Wizard Header -->
          <div class="flex flex-col gap-2 pb-4 border-b border-slate-100" id="pro-wizard-header">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="font-mono text-xs font-semibold text-slate-900 uppercase" id="pro-step-counter">Paso 1 de 5</span>
              </div>
              <span class="text-xs font-mono text-slate-400" id="pro-step-time">~2 min</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
              <div class="bg-emerald-600 h-1.5 rounded-full transition-all duration-300 ease-out" id="pro-progress-bar" style="width: 20%;"></div>
            </div>
          </div>

          <!-- PASO 1: ÁREA DE FRICCIÓN -->
          <div class="pro-step flex flex-col gap-4 py-4" id="pro-step-1">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 1 · Fricción en tu trabajo</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿En qué parte de tu trabajo sientes que estás perdiendo más tiempo?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-pro-area">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectArea('Correos y mensajes', this)" type="button">✉️ Correos y mensajes</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectArea('Documentos y textos', this)" type="button">📄 Documentos y textos</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectArea('Reuniones', this)" type="button">👥 Reuniones</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectArea('Investigación', this)" type="button">🔍 Investigación</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectArea('Presentaciones', this)" type="button">📊 Presentaciones</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectArea('Análisis', this)" type="button">📈 Análisis de datos</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectArea('Tareas repetitivas', this)" type="button">🔄 Tareas repetitivas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectArea('No estoy seguro todavía', this)" type="button">❓ No estoy seguro todavía</button>
            </div>
          </div>

          <!-- PASO 2: FRECUENCIA -->
          <div class="pro-step hidden flex flex-col gap-4 py-4" id="pro-step-2">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 2 · Frecuencia</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Con qué frecuencia haces ese trabajo?</h3>
            </div>
            <div class="flex flex-col gap-2 pt-2" id="group-pro-frecuencia">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectFrecuencia('Varias veces al día', this)" type="button">⚡ Varias veces al día</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectFrecuencia('Todos los días', this)" type="button">📅 Todos los días</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectFrecuencia('Varias veces por semana', this)" type="button">🗓️ Varias veces por semana</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectFrecuencia('Una vez por semana', this)" type="button">📌 Una vez por semana</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectFrecuencia('De vez en cuando', this)" type="button">⏳ De vez en cuando</button>
            </div>
          </div>

          <!-- PASO 3: TIEMPO ESTIMADO -->
          <div class="pro-step hidden flex flex-col gap-4 py-4" id="pro-step-3">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 3 · Tiempo</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Cuánto tiempo crees que te consume a la semana?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-pro-tiempo">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectTiempo('Menos de 1 hora a la semana', this)" type="button">⏱️ Menos de 1 hora a la semana</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectTiempo('1–3 horas', this)" type="button">⏳ 1–3 horas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectTiempo('3–5 horas', this)" type="button">📊 3–5 horas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectTiempo('5–10 horas', this)" type="button">🔥 5–10 horas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectTiempo('Más de 10 horas', this)" type="button">🚨 Más de 10 horas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectTiempo('No tengo idea', this)" type="button">❓ No tengo idea</button>
            </div>
          </div>

          <!-- PASO 4: HERRAMIENTAS -->
          <div class="pro-step hidden flex flex-col gap-4 py-4" id="pro-step-4">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 4 · Herramientas actuales</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Qué estás usando hoy para intentar resolverlo?</h3>
              <p class="text-xs text-slate-500">Puedes seleccionar varias opciones.</p>
            </div>
            <div class="grid grid-cols-2 gap-2 pt-2" id="group-pro-herramientas">
              <button class="multi-option p-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proToggleHerramienta('ChatGPT', this)" type="button">🤖 ChatGPT</button>
              <button class="multi-option p-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proToggleHerramienta('Claude', this)" type="button">🧠 Claude</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proToggleHerramienta('Gemini', this)" type="button">✨ Gemini</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proToggleHerramienta('NotebookLM', this)" type="button">📚 NotebookLM</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proToggleHerramienta('Copilot', this)" type="button">💻 Copilot</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proToggleHerramienta('Automatizaciones', this)" type="button">⚡ Make / Zapier</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proToggleHerramienta('Excel / Sheets', this)" type="button">📊 Excel / Sheets</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proToggleHerramienta('Nada todavía', this)" type="button">⏳ Nada todavía</button>
            </div>
            <button
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-teal-700 text-white font-semibold text-sm hover:bg-teal-800 transition-colors cursor-pointer self-start mt-2"
              onclick="window.proNextStep(4)"
              type="button"
            >
              <span>Continuar →</span>
            </button>
          </div>

          <!-- PASO 5: OBJETIVO DESEADO -->
          <div class="pro-step hidden flex flex-col gap-4 py-4" id="pro-step-5">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 5 · Objetivo</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Qué te gustaría conseguir trabajando juntos?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-pro-objetivo">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectObjetivo('Ahorrar tiempo', this)" type="button">⏳ Ahorrar tiempo en mi día a día</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectObjetivo('Resolver una tarea concreta con IA', this)" type="button">🎯 Resolver una tarea concreta con IA</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectObjetivo('Automatizar algo repetitivo', this)" type="button">🔄 Automatizar algo repetitivo</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectObjetivo('Conectar mejor las herramientas que ya uso', this)" type="button">🔗 Conectar mejor mis herramientas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectObjetivo('Crear un flujo de trabajo', this)" type="button">🛠️ Crear un flujo de trabajo claro</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectObjetivo('Aprender a utilizar IA aplicada', this)" type="button">🎓 Aprender IA aplicada a mi trabajo</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.proSelectObjetivo('Tener claridad sobre por dónde empezar', this)" type="button">💡 Tener claridad sobre por dónde empezar</button>
            </div>
          </div>

          <!-- PASO 6: DATOS DE CONTACTO -->
          <div class="pro-step hidden flex flex-col gap-4 py-4" id="pro-step-6">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 6 · Enviar Diagnóstico</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">Ya tenemos una idea mucho más clara.</h3>
              <p class="text-sm text-slate-600">¿A dónde te envío el diagnóstico y la recomendación personalizada?</p>
            </div>
            <form class="flex flex-col gap-3 pt-2" onsubmit="event.preventDefault(); window.proSubmitLead();">
              <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-slate-700" for="pro-input-nombre">Tu Nombre *</label>
                <input class="w-full text-sm px-4 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white" id="pro-input-nombre" placeholder="Ej. Camila Silva" required type="text" />
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="flex flex-col gap-1">
                  <label class="text-xs font-semibold text-slate-700" for="pro-input-email">Correo Electrónico *</label>
                  <input class="w-full text-sm px-4 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white" id="pro-input-email" placeholder="camila@empresa.com" required type="email" />
                </div>
                <div class="flex flex-col gap-1">
                  <label class="text-xs font-semibold text-slate-700" for="pro-input-whatsapp">Número de WhatsApp *</label>
                  <input class="w-full text-sm px-4 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white" id="pro-input-whatsapp" placeholder="+57 300 000 0000" required type="tel" />
                </div>
              </div>

              <div class="pt-2">
                <button id="pro-btn-submit" class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer" type="submit">
                  <span>Ver diagnóstico y recomendación →</span>
                </button>
              </div>
            </form>
          </div>

          <!-- RESULTADO PERSONALIZADO -->
          <div class="pro-step hidden flex flex-col gap-5 py-4" id="pro-step-result">
            <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex flex-col gap-2">
              <div class="flex items-center gap-2 text-emerald-800 font-bold text-sm">
                <span class="material-symbols-outlined text-emerald-600 text-xl">verified</span>
                <span>Diagnóstico Inicial Completado</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900">Esto es lo que veo en tu caso:</h3>
              <p class="text-xs text-slate-700 leading-relaxed" id="pro-result-summary">
                Por lo que me cuentas, tienes una tarea que haces con alta frecuencia y que te consume bastante tiempo semanal. En tu caso tendría sentido empezar por ese problema concreto, entender cómo lo haces hoy y construir una forma más simple de resolverlo.
              </p>
            </div>

            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 flex flex-col gap-2.5 text-xs text-slate-800">
              <span class="font-mono text-[10px] uppercase font-bold text-slate-500">Plan de trabajo sugerido:</span>
              <ul class="flex flex-col gap-2 text-slate-700 font-medium" id="pro-result-bullets">
                <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Mapear el flujo manual que usas hoy para esa tarea.</li>
                <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Identificar el prompt o la integración adecuada que elimine el trabajo repetitivo.</li>
                <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Construir en vivo contigo el nuevo flujo durante la sesión.</li>
                <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Asegurar que salgas con total autonomía para seguir usándolo solo.</li>
              </ul>
            </div>

            <a
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-teal-700 text-white font-semibold text-sm hover:bg-teal-800 transition-colors shadow-2xs text-center cursor-pointer"
              href="#como-trabajamos"
            >
              <span>Ver cómo trabajamos en las sesiones 1-1 ↓</span>
            </a>
          </div>

          <!-- Wizard Footer Navigation -->
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between mt-2" id="pro-wizard-navigation">
            <button
              class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
              disabled
              id="pro-btn-prev"
              onclick="window.proPrevStep()"
              type="button"
            >
              <span class="material-symbols-outlined text-[15px]">arrow_back</span>
              <span>Anterior</span>
            </button>
            <span class="text-xs font-mono text-slate-400" id="pro-status-tag">Paso 1</span>
          </div>

        </div>

      </div>
    </section>

    <!-- TRANSICIÓN A LAS SESIONES Y CÓMO TRABAJAMOS (5 PASOS) -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16 border-t border-slate-200" id="como-trabajamos">
