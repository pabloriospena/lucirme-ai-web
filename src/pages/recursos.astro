---
// Índice de contenido (Web LuciRMe v2). Se arma desde src/data/recursos.ts y src/data/biblioteca.js.
// Las bandas vacías no se muestran. Sin precios ni fechas.
import LayoutV2 from "../layouts/LayoutV2.astro";
import { RECURSOS, recursosDeBanda } from "../data/recursos.ts";
import TarjetaGuia from "../components/v2/TarjetaGuia.astro";
import TarjetaRuta from "../components/v2/TarjetaRuta.astro";
import SigueEnRedes from "../components/v2/SigueEnRedes.astro";
import { RUTA_CLAUDE_DATA } from "../data/ruta-claude.ts";
import { RUTA_EVIDENCIA_DATA } from "../data/ruta-evidencia.ts";

// Tres primeros pasos de cada ruta, leídos de sus datos. Sin el prefijo Paso N.
const pasosDe = (datos: { titulo: string }[]) => datos.slice(0, 3).map((p) => p.titulo.replace(/^Paso \d+\.\s*/, ""));
const PASOS: Record<string, string[]> = {
  "ruta-claude": pasosDe(RUTA_CLAUDE_DATA),
  "ruta-evidencia": pasosDe(RUTA_EVIDENCIA_DATA),
};
const rutas = recursosDeBanda("paso-a-paso").filter((r) => !r.secundaria && PASOS[r.slug]);
const guias = recursosDeBanda("guias-herramientas").filter((r) => !r.secundaria);
const chips = [
  { nombre: "Paso a paso", href: "#banda-paso-a-paso" },
  { nombre: "Guías y herramientas", href: "#banda-guias-herramientas" },
  { nombre: "Clases en vivo", href: "/clases" },
  { nombre: "Biblioteca", href: "/biblioteca" },
  { nombre: "Prompts", href: "/recursos/prompts" },
];
const accesoFiltros = [
  { valor: "todos", nombre: "Todos" },
  { valor: "gratis", nombre: "Gratis" },
  { valor: "pago", nombre: "De pago" },
];
const chip = "inline-flex min-h-11 items-center rounded-full border-[0.8px] px-4 text-sm font-semibold";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Contenido para aplicar IA a tu trabajo",
  url: "https://lucirme.com/recursos",
  inLanguage: "es",
  hasPart: RECURSOS.filter((r) => !r.secundaria).map((r) => ({
    "@type": "WebPage",
    name: r.titulo,
    url: `https://lucirme.com${r.url}`,
  })),
};
---

<LayoutV2
  title="Contenido para aplicar IA a tu trabajo | LuciRMe AI"
  description="Rutas, guías, herramientas y prompts para aplicar la inteligencia artificial a tu trabajo real."
  jsonLd={jsonLd}
>
  <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-6 px-4 pb-4 pt-2 sm:px-6">
    <section class="flex flex-col gap-2 pt-2">
      <span class="text-sm font-semibold text-v2-accion">Contenido</span>
      <h1 class="text-[32px] font-extrabold leading-[1.14] tracking-[-0.8px] text-v2-texto sm:text-[40px] sm:tracking-[-1px]">Encuentra qué aprender</h1>
      <p class="max-w-2xl text-base leading-6 text-v2-cuerpo sm:text-lg sm:leading-7">
        Elige una banda o filtra por tema. Todo sirve para aplicar IA hoy.
      </p>
    </section>

    <nav aria-label="Bandas" class="flex flex-wrap gap-2">
      {
        chips.map((c, i) => (
          <a
            href={c.href}
            data-chip-banda
            aria-current={i === 0 ? "location" : undefined}
            class:list={[chip, "data-[activo=true]:border-v2-accion data-[activo=true]:bg-v2-accion data-[activo=true]:text-v2-accion-texto", "border-v2-control bg-v2-fondo text-v2-texto"]}
            data-activo={i === 0 ? "true" : "false"}
            onclick={`if (window.posthog) { window.posthog.capture('recursos_chip_banda', { banda: '${c.nombre}' }); }`}
          >
            {c.nombre}
          </a>
        ))
      }
    </nav>

    {
      rutas.length > 0 && (
        <section id="banda-paso-a-paso" class="flex scroll-mt-4 flex-col gap-3" aria-labelledby="titulo-paso-a-paso">
          <div>
            <h2 id="titulo-paso-a-paso" class="text-2xl font-bold tracking-[-0.5px] text-v2-texto sm:text-[28px]">Paso a paso</h2>
            <p class="mt-1 text-base text-v2-cuerpo">Empieza con el recurso gratis y sigue el camino.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {rutas.map((r, i) => (
              <TarjetaRuta numero={i + 1} slug={r.slug} url={r.url} titulo={r.titulo} pasos={PASOS[r.slug]} />
            ))}
          </div>
        </section>
      )
    }

    <section id="banda-guias-herramientas" class="flex scroll-mt-4 flex-col gap-3" aria-labelledby="titulo-guias">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="titulo-guias" class="text-2xl font-bold tracking-[-0.5px] text-v2-texto sm:text-[28px]">Guías y herramientas</h2>
          <p class="mt-1 text-base text-v2-cuerpo">Para leer, aplicar o usar ya.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filtrar por acceso">
          {
            accesoFiltros.map((f, i) => (
              <button
                type="button"
                data-filtro-acceso={f.valor}
                aria-pressed={i === 0 ? "true" : "false"}
                class:list={[chip, "cursor-pointer border-v2-control bg-v2-fondo text-v2-texto aria-pressed:border-v2-accion aria-pressed:bg-v2-accion aria-pressed:text-v2-accion-texto"]}
              >
                {f.nombre}
              </button>
            ))
          }
        </div>
      </div>
      <p role="status" id="conteo-guias" class="text-xs font-bold text-v2-suave">
        {guias.length} {guias.length === 1 ? "recurso" : "recursos"}
      </p>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          guias.map((r) => (
            <li data-item data-acceso={r.acceso === "de-pago" || r.acceso === "o-con-invitaciones" ? "pago" : "gratis"}>
              <TarjetaGuia recurso={r} banda="guias-herramientas" />
            </li>
          ))
        }
      </ul>
      <p id="sin-resultados" class="hidden py-6 text-base text-v2-cuerpo">Todavía no hay recursos de pago aquí.</p>
    </section>

    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label="Más formas de aprender">
      <a
        href="/clases"
        class="flex flex-col gap-2 rounded-[20px] border-[0.8px] border-dashed border-v2-control bg-v2-superficie p-5"
        onclick="if (window.posthog) { window.posthog.capture('recursos_acceso_click', { destino: 'clases' }); }"
      >
        <span class="flex items-center justify-between gap-2">
          <span class="text-xl font-bold text-v2-texto">Clases en vivo</span>
          <span class="inline-flex items-center rounded-full border-[0.8px] border-[#cad5e2] bg-v2-fondo px-3 py-1 text-xs font-bold text-v2-cuerpo">Próximamente</span>
        </span>
        <span class="text-sm leading-5 text-v2-cuerpo">Clases con Pablo que quedan grabadas. Deja tu correo y te avisamos.</span>
        <span class="inline-flex min-h-11 items-center text-sm font-bold text-v2-accion">Ir a la lista de espera ›</span>
      </a>
      <a
        href="/recursos/prompts"
        class="flex flex-col gap-2 rounded-[20px] border-[0.8px] border-v2-borde bg-v2-fondo p-5"
        onclick="if (window.posthog) { window.posthog.capture('recursos_acceso_click', { destino: 'prompts' }); }"
      >
        <span class="text-xl font-bold text-v2-texto">Prompts</span>
        <span class="text-sm leading-5 text-v2-cuerpo">Muchos prompts listos para copiar, filtrados por tema.</span>
        <span class="inline-flex min-h-11 items-center text-sm font-bold text-v2-accion">Ver los prompts ›</span>
      </a>
      <a
        href="/biblioteca"
        class="flex flex-col gap-2 rounded-[20px] border-[0.8px] border-v2-borde bg-v2-fondo p-5"
        onclick="if (window.posthog) { window.posthog.capture('recursos_acceso_click', { destino: 'biblioteca' }); }"
      >
        <span class="text-xl font-bold text-v2-texto">Biblioteca</span>
        <span class="text-sm leading-5 text-v2-cuerpo">Todo el contenido en una lista, con filtro por tema, herramienta y dificultad.</span>
        <span class="inline-flex min-h-11 items-center text-sm font-bold text-v2-accion">Ver la biblioteca ›</span>
      </a>
    </section>

    <SigueEnRedes posicion="recursos" />
  </div>

  <script is:inline>
    (function () {
      var botones = document.querySelectorAll("button[data-filtro-acceso]");
      var items = document.querySelectorAll("li[data-item]");
      var conteo = document.getElementById("conteo-guias");
      var vacio = document.getElementById("sin-resultados");
      botones.forEach(function (b) {
        b.addEventListener("click", function () {
          var v = b.getAttribute("data-filtro-acceso");
          botones.forEach(function (o) { o.setAttribute("aria-pressed", o === b ? "true" : "false"); });
          var n = 0;
          items.forEach(function (li) {
            var ver = v === "todos" || li.getAttribute("data-acceso") === v;
            li.classList.toggle("hidden", !ver);
            if (ver) n++;
          });
          conteo.textContent = n + (n === 1 ? " recurso" : " recursos");
          vacio.classList.toggle("hidden", n > 0);
          if (window.posthog) window.posthog.capture("recursos_filtro", { filtro: "acceso", valor: v });
        });
      });
      var chips = document.querySelectorAll("a[data-chip-banda]");
      chips.forEach(function (c) {
        c.addEventListener("click", function () {
          if (c.getAttribute("href").charAt(0) !== "#") return;
          chips.forEach(function (o) { o.setAttribute("data-activo", o === c ? "true" : "false"); o.removeAttribute("aria-current"); });
          c.setAttribute("aria-current", "location");
        });
      });
    })();
  </script>
</LayoutV2>
