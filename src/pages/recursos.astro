---
// Índice de contenido (Web LuciRMe v2). Se arma desde src/data/recursos.ts y src/data/biblioteca.js.
// Las bandas vacías no se muestran. Sin precios ni fechas.
import LayoutV2 from "../layouts/LayoutV2.astro";
import { BANDAS, RECURSOS, recursosDeBanda, temasEnUso } from "../data/recursos.ts";
import { ARTICULOS, TEMAS, publicados } from "../data/biblioteca.js";

// Igual que /biblioteca: en producción solo los artículos publicados.
const articulos = import.meta.env.DEV ? ARTICULOS : publicados();

const bandas = BANDAS.map((b) => {
  if (b.id === "biblioteca") {
    return {
      ...b,
      tarjetas: articulos.map((a: any) => ({
        slug: a.slug,
        url: `/biblioteca/${a.slug}`,
        titulo: a.titulo,
        descripcion: a.descripcion,
        formato: "Artículo",
        tema: (TEMAS as Record<string, string>)[a.tema] || "",
      })),
      enlaces: [],
    };
  }
  const todos = recursosDeBanda(b.id);
  return {
    ...b,
    tarjetas: todos.filter((r) => !r.secundaria),
    enlaces: todos.filter((r) => r.secundaria),
  };
}).filter((b) => b.tarjetas.length > 0);

const temas = temasEnUso();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Contenido para aplicar IA a tu trabajo",
  url: "https://lucirme.com/recursos",
  inLanguage: "es",
  hasPart: RECURSOS.filter((r) => !r.secundaria).map((r) => ({
    "@type": "WebPage",
    name: r.titulo,
    url: `https://lucirme.com${r.url}`,
  })),
};
---

<LayoutV2
  title="Contenido para aplicar IA a tu trabajo | LuciRMe AI"
  description="Rutas, guías, herramientas y prompts para aplicar la inteligencia artificial a tu trabajo real."
  jsonLd={jsonLd}
>
  <section class="bg-white px-4 sm:px-6 pt-12 pb-8">
    <div class="max-w-4xl mx-auto">
      <span
        class="inline-flex items-center rounded-full border border-slate-300 bg-slate-200/60 px-3.5 py-1.5 font-mono text-xs font-medium uppercase tracking-[0.05em] text-slate-700"
      >
        Contenido
      </span>
      <h1 class="mt-5 text-4xl sm:text-5xl font-extrabold tracking-[-0.025em] text-slate-900 leading-[1.15]">
        Contenido para aplicar IA a tu trabajo.
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-7 max-w-2xl">
        Elige un tema y empieza por lo que necesitas hoy.
      </p>

      <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filtrar por tema" id="filtros">
        <button
          type="button"
          data-filtro="todos"
          aria-pressed="true"
          class="chip rounded-full border px-4 py-2 text-sm font-medium transition-colors duration-150"
        >
          Todos
        </button>
        {
          temas.map((t) => (
            <button
              type="button"
              data-filtro={t}
              aria-pressed="false"
              class="chip rounded-full border px-4 py-2 text-sm font-medium transition-colors duration-150"
            >
              {t}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  {
    bandas.map((b, i) => (
      <section
        class:list={["px-4 sm:px-6 py-16 border-t border-slate-200", i % 2 === 0 ? "bg-[#F8FAFC]" : "bg-white"]}
        data-banda={b.id}
        aria-labelledby={`banda-${b.id}`}
      >
        <div class="max-w-7xl mx-auto">
          <h2 id={`banda-${b.id}`} class="text-3xl font-black tracking-[-0.025em] text-slate-900">
            {b.nombre}
          </h2>
          <p class="mt-2 text-base text-slate-600 max-w-2xl">{b.descripcion}</p>

          <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {b.tarjetas.map((r: any) => (
              <li data-tema={r.tema}>
                <a
                  href={r.url}
                  class="group flex h-full flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-colors duration-150 hover:border-slate-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0F766E]"
                  onclick={`if (window.posthog) { window.posthog.capture('recursos_card_click', { recurso: '${r.slug}', banda: '${b.id}' }); }`}
                >
                  <span class="flex items-center justify-between gap-3">
                    <span class="rounded border border-teal-200 bg-[#F0FDFA] px-1.5 font-mono text-[10px] font-medium uppercase leading-4 text-[#0F766E]">
                      {r.formato}
                    </span>
                    {r.tema && (
                      <span class="font-mono text-xs font-medium uppercase tracking-[0.05em] text-slate-500">
                        {r.tema}
                      </span>
                    )}
                  </span>
                  <span class="text-lg font-bold leading-7 text-slate-900">{r.titulo}</span>
                  <span class="text-base leading-6 text-slate-600">{r.descripcion}</span>
                  <span class="mt-auto flex items-center gap-1 pt-2 text-sm font-semibold text-[#0F766E]">
                    Abrir
                    <span class="material-symbols-outlined text-base" aria-hidden="true">
                      arrow_forward
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>

          {b.enlaces.length > 0 && (
            <p class="mt-6 text-sm text-slate-600">
              También puedes ver
              {b.enlaces.map((e: any, k: number) => (
                <>
                  {k > 0 ? " y " : " "}
                  <a href={e.url} class="font-medium text-[#0F766E] underline underline-offset-2">
                    {e.titulo}
                  </a>
                </>
              ))}
              .
            </p>
          )}
        </div>
      </section>
    ))
  }

  <p id="sin-resultados" class="hidden px-4 sm:px-6 py-16 text-center text-base text-slate-600">
    No hay contenido para este tema todavía.
  </p>

  <style>
    .chip {
      border-color: #cbd5e1;
      background: #f1f5f9;
      color: #334155;
    }
    .chip[aria-pressed="true"] {
      border-color: #0f766e;
      background: #0f766e;
      color: #ffffff;
    }
    .chip:focus-visible {
      outline: 2px solid #0f766e;
      outline-offset: 2px;
    }
  </style>

  <script is:inline>
    (function () {
      var botones = document.querySelectorAll("#filtros [data-filtro]");
      var items = document.querySelectorAll("li[data-tema]");
      var secciones = document.querySelectorAll("section[data-banda]");
      var vacio = document.getElementById("sin-resultados");

      function filtrar(tema) {
        var visibles = 0;
        items.forEach(function (li) {
          var ver = tema === "todos" || li.getAttribute("data-tema") === tema;
          li.classList.toggle("hidden", !ver);
        });
        secciones.forEach(function (s) {
          var hay = s.querySelectorAll("li[data-tema]:not(.hidden)").length > 0;
          s.classList.toggle("hidden", !hay);
          if (hay) visibles++;
        });
        vacio.classList.toggle("hidden", visibles > 0);
      }

      botones.forEach(function (b) {
        b.addEventListener("click", function () {
          var tema = b.getAttribute("data-filtro");
          botones.forEach(function (o) {
            o.setAttribute("aria-pressed", o === b ? "true" : "false");
          });
          filtrar(tema);
          if (window.posthog) {
            window.posthog.capture("recursos_filtro", { tema: tema });
          }
        });
      });
    })();
  </script>
</LayoutV2>
