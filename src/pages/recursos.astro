---
// Índice de contenido (Web LuciRMe v2). Se arma desde src/data/recursos.ts y src/data/biblioteca.js.
// Las bandas vacías no se muestran. Sin precios ni fechas.
import LayoutV2 from "../layouts/LayoutV2.astro";
import { BANDAS, RECURSOS, recursosDeBanda, valoresFiltro } from "../data/recursos.ts";
import TarjetaRecurso from "../components/v2/TarjetaRecurso.astro";
import { ARTICULOS, TEMAS, publicados } from "../data/biblioteca.js";

// Igual que /biblioteca: en producción solo los artículos publicados.
const articulos = import.meta.env.DEV ? ARTICULOS : publicados();

const bandas = BANDAS.map((b) => {
  if (b.id === "biblioteca") {
    return {
      ...b,
      tarjetas: articulos.map((a: any) => ({
        slug: a.slug,
        url: `/biblioteca/${a.slug}`,
        titulo: a.titulo,
        descripcion: a.descripcion,
        formato: "Artículo",
        tema: (TEMAS as Record<string, string>)[a.tema] || "",
      })),
      enlaces: [],
    };
  }
  const todos = recursosDeBanda(b.id);
  return {
    ...b,
    tarjetas: todos.filter((r) => !r.secundaria),
    enlaces: todos.filter((r) => r.secundaria),
  };
}).filter((b) => b.tarjetas.length > 0);

const filtros = [
  { campo: "tema", etiqueta: "Tema", valores: valoresFiltro("tema") },
  { campo: "herramienta", etiqueta: "Herramienta", valores: valoresFiltro("herramienta") },
  { campo: "dificultad", etiqueta: "Dificultad", valores: valoresFiltro("dificultad") },
  { campo: "area", etiqueta: "Área", valores: valoresFiltro("area") },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Contenido para aplicar IA a tu trabajo",
  url: "https://lucirme.com/recursos",
  inLanguage: "es",
  hasPart: RECURSOS.filter((r) => !r.secundaria).map((r) => ({
    "@type": "WebPage",
    name: r.titulo,
    url: `https://lucirme.com${r.url}`,
  })),
};
---

<LayoutV2
  title="Contenido para aplicar IA a tu trabajo | LuciRMe AI"
  description="Rutas, guías, herramientas y prompts para aplicar la inteligencia artificial a tu trabajo real."
  jsonLd={jsonLd}
>
  <section class="bg-v2-fondo px-4 pb-4 pt-8 sm:px-6 sm:pt-12">
    <div class="mx-auto max-w-4xl">
      <h1 class="text-[32px] font-extrabold leading-[1.15] tracking-[-0.9px] text-v2-texto sm:text-5xl">Contenido</h1>
      <p class="mt-3 max-w-2xl text-base leading-6 text-v2-cuerpo sm:text-lg sm:leading-7">
        Elige por tema, herramienta, dificultad o área.
      </p>

      <form id="filtros" class="mt-5 flex flex-wrap items-center gap-2" aria-label="Filtrar contenido" onsubmit="return false">
        {
          filtros.map((f) => (
            <label class="relative inline-flex">
              <span class="sr-only">{f.etiqueta}</span>
              <select
                data-filtro={f.campo}
                class="filtro min-h-11 cursor-pointer appearance-none rounded-full border-[0.8px] border-v2-control bg-v2-chip py-0 pl-3.5 pr-9 text-sm font-semibold text-v2-cuerpo"
              >
                <option value="">{f.etiqueta}</option>
                {f.valores.map((v) => <option value={v}>{v}</option>)}
              </select>
              <span aria-hidden="true" class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-sm text-v2-cuerpo">⌄</span>
            </label>
          ))
        }
        <button type="button" id="quitar-filtros" class="hidden min-h-11 items-center px-2 text-sm font-semibold text-v2-accion">
          Quitar filtros
        </button>
      </form>
    </div>
  </section>

  {
    bandas.map((b) => (
      <section class="border-t-[0.8px] border-v2-borde px-4 py-10 sm:px-6 sm:py-14" data-banda={b.id} aria-labelledby={`banda-${b.id}`}>
        <div class="mx-auto max-w-7xl">
          <div class="flex items-baseline justify-between gap-3">
            <h2 id={`banda-${b.id}`} class="text-[22px] font-bold text-v2-texto sm:text-3xl">{b.nombre}</h2>
            <span class="text-xs font-bold text-v2-suave" data-conteo-banda>
              {b.tarjetas.length} {b.tarjetas.length === 1 ? "recurso" : "recursos"}
            </span>
          </div>
          <p class="mt-1 max-w-2xl text-sm leading-6 text-v2-cuerpo">{b.descripcion}</p>

          <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {b.tarjetas.map((r: any) => (
              <li data-item data-tema={r.tema} data-herramienta={r.herramienta} data-dificultad={r.dificultad} data-area={r.area}>
                <TarjetaRecurso recurso={r} banda={b.id} />
              </li>
            ))}
          </ul>

          {b.enlaces.length > 0 && (
            <p class="mt-5 text-sm text-v2-cuerpo">
              También puedes ver
              {b.enlaces.map((e: any, k: number) => (
                <>
                  {k > 0 ? " y " : " "}
                  <a href={e.url} class="inline-flex min-h-11 items-center font-semibold text-v2-accion underline underline-offset-2">
                    {e.titulo}
                  </a>
                </>
              ))}
              .
            </p>
          )}
        </div>
      </section>
    ))
  }

  <p id="sin-resultados" class="hidden px-4 py-16 text-center text-base text-v2-cuerpo sm:px-6">
    No hay contenido con esos filtros todavía.
  </p>

  <style>
    .filtro[data-activo="true"] {
      border-width: 1.5px;
      border-color: var(--color-v2-accion);
      background: var(--color-v2-marca-tinte);
      color: var(--color-v2-accion);
      font-weight: 700;
    }
  </style>

  <script is:inline>
    (function () {
      var selects = document.querySelectorAll("#filtros select[data-filtro]");
      var items = document.querySelectorAll("li[data-item]");
      var secciones = document.querySelectorAll("section[data-banda]");
      var vacio = document.getElementById("sin-resultados");
      var quitar = document.getElementById("quitar-filtros");

      function filtrar(origen) {
        var activos = {};
        var hayActivos = false;
        selects.forEach(function (s) {
          var v = s.value;
          s.setAttribute("data-activo", v ? "true" : "false");
          if (v) { activos[s.getAttribute("data-filtro")] = v; hayActivos = true; }
        });
        items.forEach(function (li) {
          var ver = Object.keys(activos).every(function (k) { return li.getAttribute("data-" + k) === activos[k]; });
          li.classList.toggle("hidden", !ver);
        });
        var visibles = 0;
        secciones.forEach(function (s) {
          var n = s.querySelectorAll("li[data-item]:not(.hidden)").length;
          s.classList.toggle("hidden", n === 0);
          var c = s.querySelector("[data-conteo-banda]");
          if (c) c.textContent = n + (n === 1 ? " recurso" : " recursos");
          if (n > 0) visibles++;
        });
        vacio.classList.toggle("hidden", visibles > 0);
        quitar.classList.toggle("hidden", !hayActivos);
        quitar.classList.toggle("inline-flex", hayActivos);
        if (origen && window.posthog) {
          window.posthog.capture("recursos_filtro", { filtro: origen.getAttribute("data-filtro"), valor: origen.value || "ninguno" });
        }
      }

      selects.forEach(function (s) { s.addEventListener("change", function () { filtrar(s); }); });
      quitar.addEventListener("click", function () {
        selects.forEach(function (s) { s.value = ""; });
        filtrar(null);
      });
    })();
  </script>
</LayoutV2>
