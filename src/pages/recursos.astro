---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import RedesSociales from "../components/RedesSociales.astro";

// 1. Cargamos todos los archivos .astro automáticamente
const archivos = import.meta.glob("./recursos/*.astro", { eager: true });

// 2. Mapeamos los archivos
const recursos = Object.keys(archivos).map((key) => {
  const file = archivos[key] as any;
  const slug = key.split("/").pop()?.replace(".astro", "") || "";
  return {
    slug,
    url: `/recursos/${slug}`,
    titulo: file.frontmatter?.title || slug.replace("-", " ").toUpperCase(),
  };
});

// 3. Diccionario maestro de contenidos
const metaData = {
  "ideador-producto": {
    etiqueta: "Guía Abierta",
    desc: "Mapea, valida, pule y genera el prompt de Lovable para el prototipo visual de tu app en 4 fases de producto.",
    precio: null,
    esPago: false,
    categoria: "pm",
  },
  "ebook-pm": {
    etiqueta: "Ebook Oficial Vol. 1",
    desc: "El manual de Product Management sin rodeos teóricos para aprender a aplicar IA con criterio real.",
    precio: "$53.000 COP",
    esPago: true,
    categoria: "destacado",
  },
  "preventa-vol2": {
    etiqueta: "Preventa Activa Vol. 2",
    desc: "Asegura tu acceso exclusivo al volumen 2 de 'PM Sin Bullshit' a mitad de precio y llévate un checklist de regalo.",
    precio: "Acceso Preventa",
    esPago: false,
    categoria: "destacado",
  },
  "checklistpm-vol1": {
    etiqueta: "Guía Premium",
    desc: "Aprende la fórmula R+C+T+E y accede a 4 prompts maestros para escribir User Stories, refinar roadmaps y priorizar sin bullshit.",
    precio: null,
    esPago: false,
    categoria: "pm",
  },
  "guia-deepresearch": {
    titulo: "Guía Completa de Deep Research",
    etiqueta: "Guía Premium",
    desc: "El superpoder de la investigación avanzada con IA: de 3 semanas de trabajo a 4 horas estratégicas con Gemini y ChatGPT.",
    precio: null,
    esPago: false,
    categoria: "ia",
  },
  prompteador: {
    etiqueta: "Herramienta Pro",
    desc: "Optimiza tus prompts con la fórmula R+C+T+E para obtener respuestas de ingeniería de élite.",
    precio: null,
    esPago: false,
    categoria: "ia",
  },
  "guia-20prompts-notebooklm": {
    etiqueta: "Guía de Prompts",
    desc: "20 prompts listos para copiar y pegar en NotebookLM. Organizados por análisis, estudio activo, investigación y acción.",
    precio: null,
    esPago: false,
    categoria: "ia",
  },
  "guia-notebooklm": {
    etiqueta: "Guía Premium",
    desc: "Aprende a estructurar tus notas, PDFs y audios para generar reportes ejecutivos en minutos.",
    precio: null,
    esPago: false,
    categoria: "ia",
  },
  "guia-estudio-notebooklm": {
    etiqueta: "Guía Premium",
    desc: "Descubre la fórmula validada para aprender rápido y aplicar nuevo conocimiento en proyectos reales desde la primera semana.",
    precio: null,
    esPago: false,
    categoria: "ia",
  },
  "cv-con-ia": {
    etiqueta: "Asistente IA",
    desc: "Pega tu texto antiguo y deja que nuestra IA Llama 3.3 redacte tu CV optimizado para filtros ATS.",
    precio: null,
    esPago: false,
    categoria: "ia",
  },
  "career-path-notebooklm": {
    etiqueta: "Guía Premium",
    desc: "Mapea tu ruta de carrera y habilidades de 8 semanas usando NotebookLM de forma estructurada.",
    precio: null,
    esPago: false,
    categoria: "ia",
  },
  "job-prompt-ai": {
    etiqueta: "Herramienta Pro",
    desc: "Genera super-prompts de búsqueda avanzada para vacantes activas y pégalo en Perplexity.",
    precio: null,
    esPago: false,
    categoria: "ia",
  },
  "backlog-detox": {
    etiqueta: "Herramienta Pro",
    desc: "Pega tu backlog y clasifica al instante qué hacer ya, qué validar primero y qué archivar.",
    precio: null,
    esPago: false,
    categoria: "pm",
  },
  "shapeup-builder": {
    etiqueta: "Herramienta Pro",
    desc: "Crea tu Pitch de producto bajo la metodología ShapeUp y mitiga riesgos antes de desarrollar.",
    precio: null,
    esPago: false,
    categoria: "pm",
  },
  "roadmap-builder": {
    etiqueta: "Herramienta Pro",
    desc: "Genera tu Gantt interactivo estilo ClickUp a partir de tus épicas exportadas de Azure DevOps.",
    precio: null,
    esPago: false,
    categoria: "pm",
  },
  "ai-solver": {
    etiqueta: "Herramienta Pro",
    desc: "Resolutor de problemas de producto basado en lógica de priorización asertiva.",
    precio: null,
    esPago: false,
    categoria: "pm",
  },
};

// Separamos por categorías
const ebookDestacado = recursos.find((r) => r.slug === "ebook-pm");
const preventaDestacada = recursos.find((r) => r.slug === "preventa-vol2");

const recursosIA = recursos.filter((r) => {
  const meta = metaData[r.slug as keyof typeof metaData];
  return meta?.categoria === "ia";
});
const recursosPM = recursos.filter((r) => {
  const meta = metaData[r.slug as keyof typeof metaData];
  return meta?.categoria === "pm" && r.slug !== "preventa-vol2"; // Evitamos duplicar la preventa
});
---

<Layout title="Librería de Recursos | LuciRMe AI">
  <main class="max-w-6xl mx-auto py-16 px-6 space-y-16">
    <header class="text-center mb-16">
      <h1 class="text-4xl font-bold text-deep mb-4">Librería de Recursos</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Herramientas, plantillas y guías de producto listas para implementar.
        Acceso abierto y directo.
      </p>
    </header>

    <!-- 1. SECCIÓN DESTACADA (BENTO DOUBLE GRID: VOL 1 & VOL 2) -->
    <div class="grid md:grid-cols-2 gap-8">
      <!-- Ebook Vol 1 -->
      {
        ebookDestacado &&
          (() => {
            const meta = metaData["ebook-pm"];
            return (
              <div class="bg-gradient-to-br from-[#0F172A] to-[#1E293B] rounded-3xl p-8 text-white shadow-2xl flex flex-col justify-between border border-white/10 min-h-[380px] relative overflow-hidden group">
                <div class="absolute -right-10 -top-10 w-32 h-32 bg-teal/10 rounded-full blur-2xl group-hover:bg-teal/20 transition-all" />
                <div>
                  <span class="inline-block bg-teal/10 text-teal text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-md mb-4 border border-teal/20">
                    {meta.etiqueta}
                  </span>
                  <h2 class="text-2xl font-bold mb-3">
                    {ebookDestacado.titulo}
                  </h2>
                  <p class="text-gray-400 text-sm leading-relaxed mb-6">
                    {meta.desc}
                  </p>
                </div>
                <div class="flex items-center justify-between pt-6 border-t border-white/5">
                  <span class="text-sm font-bold text-teal">{meta.precio}</span>
                  <a
                    href={ebookDestacado.url}
                    class="bg-teal text-white px-5 py-2.5 rounded-lg font-bold text-xs hover:bg-tealHover transition"
                  >
                    Comprar →
                  </a>
                </div>
              </div>
            );
          })()
      }

      <!-- Preventa Vol 2 -->
      {
        preventaDestacada &&
          (() => {
            const meta = metaData["preventa-vol2"];
            return (
              <div class="bg-gradient-to-br from-[#0F172A] to-[#1E293B] rounded-3xl p-8 text-white shadow-2xl flex flex-col justify-between border border-white/10 min-h-[380px] relative overflow-hidden group">
                <div class="absolute -right-10 -top-10 w-32 h-32 bg-orange/10 rounded-full blur-2xl group-hover:bg-orange/20 transition-all" />
                <div>
                  <span class="inline-block bg-orange/10 text-orange text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-md mb-4 border border-orange/20">
                    {meta.etiqueta}
                  </span>
                  <h2 class="text-2xl font-bold mb-3">
                    {preventaDestacada.titulo}
                  </h2>
                  <p class="text-gray-400 text-sm leading-relaxed mb-6">
                    {meta.desc}
                  </p>
                </div>
                <div class="flex items-center justify-between pt-6 border-t border-white/5">
                  <span class="text-sm font-bold text-orange">
                    {meta.precio}
                  </span>
                  <a
                    href={preventaDestacada.url}
                    class="bg-orange text-white px-5 py-2.5 rounded-lg font-bold text-xs hover:bg-orange/90 transition"
                  >
                    Asegurar →
                  </a>
                </div>
              </div>
            );
          })()
      }
    </div>

    <!-- 2. SOLUCIONES CON IA -->
    <div class="pt-8">
      <h2 class="text-2xl font-bold text-deep mb-6 flex items-center gap-3">
        ⚡ Soluciones con IA
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          recursosIA.map((rec) => {
            const meta = metaData[rec.slug as keyof typeof metaData] || {
              etiqueta: "Herramienta",
              desc: "",
              precio: null,
              esPago: false,
            };
            return (
              <a
                href={rec.url}
                class="group bg-white p-6 rounded-2xl border border-gray-200 hover:border-teal transition-all shadow-sm flex flex-col h-full"
              >
                <span class="text-[10px] font-bold text-teal bg-teal/10 px-3 py-1 rounded-md uppercase tracking-widest w-fit mb-4">
                  {meta.etiqueta}
                </span>
                <h3 class="text-lg font-bold text-deep mb-2 group-hover:text-teal transition-colors">
                  {(meta as any).titulo || rec.titulo}
                </h3>
                <p class="text-xs text-gray-500 mb-6 leading-relaxed flex-grow">
                  {meta.desc}
                </p>
                <div class="mt-auto pt-4 border-t border-gray-100 flex justify-between items-center text-xs">
                  <span class="text-gray-400">Acceso abierto</span>
                  <span class="text-teal font-bold group-hover:translate-x-1 transition-transform">
                    Entrar →
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>

    <!-- 3. IA PARA PRODUCT MANAGERS -->
    <div class="pt-12 border-t border-gray-100">
      <h2 class="text-2xl font-bold text-deep mb-6 flex items-center gap-3">
        🛠️ IA para Product Managers
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          recursosPM.map((rec) => {
            const meta = metaData[rec.slug as keyof typeof metaData] || {
              etiqueta: "Herramienta",
              desc: "",
              precio: null,
              esPago: false,
            };
            return (
              <a
                href={rec.url}
                class="group bg-white p-6 rounded-2xl border border-gray-200 hover:border-teal transition-all shadow-sm flex flex-col h-full"
              >
                <span class="text-[10px] font-bold text-teal bg-teal/10 px-3 py-1 rounded-md uppercase tracking-widest w-fit mb-4">
                  {meta.etiqueta}
                </span>
                <h3 class="text-lg font-bold text-deep mb-2 group-hover:text-teal transition-colors">
                  {(meta as any).titulo || rec.titulo}
                </h3>
                <p class="text-xs text-gray-500 mb-6 leading-relaxed flex-grow">
                  {meta.desc}
                </p>
                <div class="mt-auto pt-4 border-t border-gray-100 flex justify-between items-center text-xs">
                  <span class="text-gray-400">Acceso abierto</span>
                  <span class="text-teal font-bold group-hover:translate-x-1 transition-transform">
                    Entrar →
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </main>

  <RedesSociales />
</Layout>
