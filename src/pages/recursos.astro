---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

// 1. Cargamos todos los archivos .astro de la subcarpeta 'recursos' automáticamente
const archivos = import.meta.glob('./recursos/*.astro', { eager: true });

// 2. Mapeamos los archivos y agregamos sus metadatos específicos
const recursos = Object.keys(archivos).map((key) => {
  const file = archivos[key] as any;
  const slug = key.split('/').pop()?.replace('.astro', '') || '';
  
  return {
    slug,
    url: `/recursos/${slug}`,
    titulo: file.frontmatter?.title || slug.replace('-', ' ').toUpperCase()
  };
});

// 3. Diccionario maestro de contenidos, descripciones y categorías de negocio
const metaData = {
  "ebook-pm": { 
    etiqueta: "Ebook Oficial", 
    desc: "El manual de Product Management sin rodeos teóricos para aprender a aplicar IA con criterio real y recuperar 10h semanales.",
    precio: "$53.000 COP", 
    esPago: true, 
    categoria: "destacado" 
  },
  "prompteador": { 
    etiqueta: "Herramienta Pro", 
    desc: "Optimiza tus prompts con la fórmula R+C+T+E para obtener respuestas de ingeniería de élite.",
    precio: null, 
    esPago: false, 
    categoria: "ia" 
  },
  "guia-notebooklm": { 
    etiqueta: "Guía Premium", 
    desc: "Aprende a estructurar tus notas, PDFs y audios para generar reportes ejecutivos en minutos.",
    precio: null, 
    esPago: false, 
    categoria: "ia" 
  },
  "cv-con-ia": { 
    etiqueta: "Asistente IA", 
    desc: "Pega tu texto antiguo y deja que nuestra IA Llama 3.3 redacte tu CV optimizado para filtros ATS.",
    precio: null, 
    esPago: false, 
    categoria: "ia" 
  },
  "career-path-notebooklm": { 
    etiqueta: "Guía Premium", 
    desc: "Mapea tu ruta de carrera y habilidades de 8 semanas usando NotebookLM de forma estructurada.",
    precio: null, 
    esPago: false, 
    categoria: "ia" 
  },
  "job-prompt-ai": { 
    etiqueta: "Herramienta Pro", 
    desc: "Genera super-prompts de búsqueda avanzada para vacantes activas y pégalo en Perplexity.",
    precio: null, 
    esPago: false, 
    categoria: "ia" 
  },
  "backlog-detox": { 
    etiqueta: "Herramienta Pro", 
    desc: "Pega tu backlog y clasifica al instante qué hacer ya, qué validar primero y qué archivar.",
    precio: null, 
    esPago: false, 
    categoria: "pm" 
  },
  "shapeup-builder": { 
    etiqueta: "Herramienta Pro", 
    desc: "Crea tu Pitch de producto bajo la metodología ShapeUp y mitiga riesgos antes de desarrollar.",
    precio: null, 
    esPago: false, 
    categoria: "pm" 
  },
  "roadmap-builder": { 
    etiqueta: "Herramienta Pro", 
    desc: "Genera tu Gantt interactivo estilo ClickUp a partir de tus épicas exportadas de Azure DevOps.",
    precio: null, 
    esPago: false, 
    categoria: "pm" 
  },
  "ai-solver": { 
    etiqueta: "Herramienta Pro", 
    desc: "Resolutor de problemas de producto basado en lógica de priorización asertiva.",
    precio: null, 
    esPago: false, 
    categoria: "pm" 
  }
};

// Separamos los recursos por categoría para presentarlos ordenados
const ebookDestacado = recursos.find(r => r.slug === 'ebook-pm');
const recursosIA = recursos.filter(r => {
  const meta = metaData[r.slug as keyof typeof metaData];
  return meta?.categoria === 'ia';
});
const recursosPM = recursos.filter(r => {
  const meta = metaData[r.slug as keyof typeof metaData];
  return meta?.categoria === 'pm';
});
---

<Layout title="Librería de Recursos | LuciRMe AI">
  <main class="max-w-6xl mx-auto py-16 px-6 space-y-16">
    
    <header class="text-center mb-16">
      <h1 class="text-4xl font-bold text-deep mb-4">Librería de Recursos</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">Herramientas, plantillas y guías de producto listas para implementar. Acceso abierto y directo.</p>
    </header>

    <!-- 1. PRODUCTO DESTACADO (EBOOK) -->
    {ebookDestacado && (() => {
      const meta = metaData["ebook-pm"];
      return (
        <div class="bg-gradient-to-r from-[#0F172A] to-[#1E293B] rounded-3xl p-8 md:p-12 text-white shadow-2xl flex flex-col md:flex-row items-center gap-8 border border-white/10">
          <div class="w-24 h-32 bg-white rounded-r-lg rounded-l-sm shadow-md flex-shrink-0 flex items-center justify-center border-l-4 border-gray-300">
            <span class="text-[9px] font-bold text-deep text-center px-1">PM Sin Bullshit</span>
          </div>
          <div class="flex-grow">
            <span class="inline-block bg-orange/20 text-orange text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-md mb-4">{meta.etiqueta}</span>
            <h2 class="text-2xl md:text-3xl font-bold mb-3 text-white">{ebookDestacado.titulo}</h2>
            <p class="text-gray-300 text-sm mb-6 max-w-xl leading-relaxed">{meta.desc}</p>
            <div class="flex flex-wrap gap-4 items-center">
              <a href={ebookDestacado.url} class="bg-teal text-white px-6 py-3 rounded-lg font-bold text-sm hover:bg-tealHover transition shadow-lg">
                Comprar por {meta.precio}
              </a>
              <span class="text-xs text-orange font-bold uppercase tracking-widest">50% OFF para clientes</span>
            </div>
          </div>
        </div>
      )
    })()}

    <!-- 2. SOLUCIONES CON IA -->
    <div>
      <h2 class="text-2xl font-bold text-deep mb-6 flex items-center gap-3">⚡ Soluciones con IA</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recursosIA.map((rec) => {
          const meta = metaData[rec.slug as keyof typeof metaData] || { etiqueta: "Herramienta", desc: "", precio: null, esPago: false };
          return (
            <a href={rec.url} data-resource-title={rec.titulo} data-resource-paid="false" class="group bg-white p-6 rounded-2xl border border-gray-200 hover:border-teal transition-all shadow-sm flex flex-col h-full track-resource-click">
              <span class="text-[10px] font-bold text-teal bg-teal/10 px-3 py-1 rounded-md uppercase tracking-widest w-fit mb-4">{meta.etiqueta}</span>
              <h3 class="text-lg font-bold text-deep mb-2 group-hover:text-teal transition-colors">{rec.titulo}</h3>
              <p class="text-xs text-gray-500 mb-6 leading-relaxed flex-grow">{meta.desc}</p>
              <div class="mt-auto pt-4 border-t border-gray-100 flex justify-between items-center text-xs">
                <span class="text-gray-400">Acceso abierto</span>
                <span class="text-teal font-bold group-hover:translate-x-1 transition-transform">Entrar →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <!-- 3. IA PARA PRODUCT MANAGERS -->
    <div class="pt-8 border-t border-gray-100">
      <h2 class="text-2xl font-bold text-deep mb-6 flex items-center gap-3">🛠️ IA para Product Managers</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recursosPM.map((rec) => {
          const meta = metaData[rec.slug as keyof typeof metaData] || { etiqueta: "Herramienta", desc: "", precio: null, esPago: false };
          return (
            <a href={rec.url} data-resource-title={rec.titulo} data-resource-paid="false" class="group bg-white p-6 rounded-2xl border border-gray-200 hover:border-teal transition-all shadow-sm flex flex-col h-full track-resource-click">
              <span class="text-[10px] font-bold text-teal bg-teal/10 px-3 py-1 rounded-md uppercase tracking-widest w-fit mb-4">{meta.etiqueta}</span>
              <h3 class="text-lg font-bold text-deep mb-2 group-hover:text-teal transition-colors">{rec.titulo}</h3>
              <p class="text-xs text-gray-500 mb-6 leading-relaxed flex-grow">{meta.desc}</p>
              <div class="mt-auto pt-4 border-t border-gray-100 flex justify-between items-center text-xs">
                <span class="text-gray-400">Acceso abierto</span>
                <span class="text-teal font-bold group-hover:translate-x-1 transition-transform">Entrar →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>

  </main>
  <Footer />

  <script is:inline>
    // Captura clics para PostHog
    document.querySelectorAll('.track-resource-click').forEach(el => {
      el.addEventListener('click', () => {
        const title = el.getAttribute('data-resource-title');
        const isPaid = el.getAttribute('data-resource-paid');
        if (window.posthog) {
          window.posthog.capture('recurso_click', {
            titulo_recurso: title,
            es_de_pago: isPaid === 'true',
            origen: 'catalogo_recursos'
          });
        }
      });
    });
  </script>
</Layout>