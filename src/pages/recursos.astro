---
import Layout from '../layouts/Layout.astro';

// La lista maestra de recursos (Escalable)
const recursos = [
    {
    id: "ebook-pm",
    titulo: "📖 Ebook: PM Sin Bullshit",
    descripcion: "Cómo construir productos que importan. 50% OFF exclusivo para usuarios del laboratorio.",
    etiqueta: "Libro Digital",
    url: "/recursos/ebook-pm",
    color: "orange"
  },
  {
    id: "guia-notebooklm",
    titulo: "📘 Guía NotebookLM",
    descripcion: "De notas sueltas a reportes listos. Estructura y prompts exactos.",
    etiqueta: "Guía Premium",
    url: "/recursos/guia-notebooklm",
    color: "teal"
  },
  {
    id: "backlog-detox",
    titulo: "🧹 Backlog Detox",
    descripcion: "Limpia tu backlog en 2 minutos. Descubre qué archivar y qué validar.",
    etiqueta: "Herramienta Pro",
    url: "/recursos/backlog-detox",
    color: "orange"
  },
  {
    id: "shapeup-builder",
    titulo: "🎯 ShapeUp Builder",
    descripcion: "Generador de Pitches. Define límites y genera tu prompt estratégico.",
    etiqueta: "Herramienta Pro",
    url: "/recursos/shapeup-builder",
    color: "deep"
  }
];

// Opcional: Saber si está logueado para cambiar el CTA de las tarjetas
const auth = (Astro.locals as any).auth;
const userId = typeof auth === 'function' ? auth().userId : auth?.userId;
---

<Layout title="Librería de Recursos | LuciRMe AI">
  
  <header class="py-16 px-4 border-b border-gray-100 bg-[#F8FAFC]">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-deep mb-4">Librería de Recursos</h1>
      <p class="text-lg text-gray-600">Herramientas, plantillas y guías listas para implementar. Acceso gratuito para usuarios del Laboratorio.</p>
    </div>
  </header>

  <main class="py-16 px-4 min-h-[50vh]">
    <div class="max-w-5xl mx-auto">
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recursos.map((rec) => (
          <a href={rec.url} class="group bg-white p-6 rounded-2xl border border-gray-200 hover:border-teal transition-all shadow-sm hover:shadow-md flex flex-col h-full relative overflow-hidden">
            
            <!-- Etiqueta superior -->
            <div class="mb-4">
              <span class={`inline-block px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest ${
                rec.color === 'teal' ? 'bg-teal/10 text-teal' : 
                rec.color === 'orange' ? 'bg-orange/10 text-orange' : 
                'bg-deep/10 text-deep'
              }`}>
                {rec.etiqueta}
              </span>
            </div>

            <!-- Contenido -->
            <h2 class="text-xl font-bold text-deep mb-3 group-hover:text-teal transition-colors">{rec.titulo}</h2>
            <p class="text-sm text-gray-600 mb-8 flex-grow leading-relaxed">{rec.descripcion}</p>
            
            <!-- CTA -->
            <div class="pt-4 border-t border-gray-50 flex items-center justify-between mt-auto">
              <span class="text-xs font-bold text-gray-400 group-hover:text-teal transition-colors uppercase tracking-widest">
                {userId ? 'Abrir recurso →' : 'Iniciar sesión para acceder 🔒'}
              </span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </main>
</Layout>