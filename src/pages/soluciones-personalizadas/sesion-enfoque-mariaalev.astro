---
import Layout from "../../layouts/Layout.astro";
import ActionHub from "../../components/ActionHub.astro";
import RedesSociales from "../../components/RedesSociales.astro";
import { LINKS } from "../../lib/constants.js";

const cafeEstrategiaUrl = "/soluciones-personalizadas/cafe-mariaalejandrav";
const calendlyUrl = LINKS.calendly_empresa || LINKS.calendly_taller || LINKS.calendly;
---

<Layout title="Resumen de Mentoría: Producto e IA — María Alejandra Vera | tusdatos.co | LuciRMe AI">

  <!-- BARRA DE NAVEGACIÓN SUPERIOR -->
  <nav class="bg-white/90 backdrop-blur-md border-b border-gray-200 px-6 py-4 sticky top-0 z-50">
    <div class="max-w-5xl mx-auto flex justify-between items-center gap-4">
      <a href="/" class="text-xs md:text-sm font-bold text-gray-500 hover:text-teal transition flex items-center gap-1">
        ← Volver a LuciRMe AI
      </a>
      <div class="flex items-center gap-2">
        <a href={cafeEstrategiaUrl} class="inline-flex items-center justify-center font-bold bg-teal text-white rounded-xl py-2 px-3.5 hover:bg-tealHover transition shadow-xs text-xs text-center cursor-pointer">
          📋 Propuesta de Ciclo
        </a>
        <a href={calendlyUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center font-bold bg-orange text-white rounded-xl py-2 px-3.5 hover:bg-orange/90 transition shadow-xs text-xs text-center cursor-pointer">
          Agendar Sesión
        </a>
      </div>
    </div>
  </nav>

  <!-- HEADER / HERO SECTION -->
  <header class="bg-deep text-white py-16 md:py-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <!-- EYEBROW -->
      <div class="inline-flex items-center gap-2 bg-teal/15 text-teal text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 border border-teal/30">
        <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span>
        Resumen de Sesión Individual · Product Management & IA
      </div>

      <!-- H1 -->
      <h1 class="text-3xl md:text-5xl font-black mb-4 leading-tight tracking-tight text-white">
        Mentoría de Producto e <span class="text-teal">Inteligencia Artificial</span>
      </h1>

      <!-- SUBTÍTULO -->
      <p class="text-base md:text-xl text-gray-300 font-medium max-w-2xl mx-auto mb-6 leading-relaxed">
        Síntesis metodológica, diagnóstico y ruta de optimización para <strong class="text-white">María Alejandra Vera</strong>
      </p>

      <!-- LINK DIRECTO A PROPUESTA O CAFE -->
      <div class="mb-8">
        <a href={cafeEstrategiaUrl} class="inline-flex items-center gap-2 bg-gradient-to-r from-teal/20 via-white/10 to-orange/20 border border-teal/40 hover:border-teal/70 text-white font-extrabold text-xs md:text-sm px-5 py-2.5 rounded-2xl transition shadow-lg backdrop-blur-xs">
          <span>☕</span>
          <span>Ver Plan Inicial de Acompañamiento para María Alejandra →</span>
        </a>
      </div>

      <!-- META BADGES -->
      <div class="inline-flex flex-wrap justify-center items-center gap-3 md:gap-4 bg-white/5 border border-white/10 rounded-2xl px-5 py-3 text-xs md:text-sm text-gray-300 max-w-3xl">
        <span class="flex items-center gap-1.5">
          👤 <strong>Menteada:</strong> María Alejandra Vera (tusdatos.co)
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          👔 <strong>Rol:</strong> Product Owner (PO)
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          👨‍🏫 <strong>Mentor:</strong> Pablo Ríos (LuciRMe AI)
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          📅 <strong>Fecha:</strong> 1 de septiembre de 2026
        </span>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-12 space-y-16">

    <!-- RESUMEN EJECUTIVO / BANNER DE INTRODUCCIÓN -->
    <section class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4">
      <div class="flex items-center gap-3 border-b border-gray-100 pb-4">
        <div class="w-10 h-10 rounded-full bg-teal/15 text-teal flex items-center justify-center font-bold text-lg">
          📌
        </div>
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-deep">Resumen de la Sesión</h2>
          <p class="text-xs text-gray-500">Sesión individual de diagnóstico y práctica metodológica</p>
        </div>
      </div>
      <p class="text-base text-gray-700 leading-relaxed">
        Esta guía resume los puntos clave, aprendizajes técnicos y acuerdos alcanzados en la primera sesión de mentoría con <strong>María Alejandra Vera</strong>, enfocada en optimizar su rutina como Product Owner en <strong>tusdatos.co</strong> mediante Inteligencia Artificial y metodologías estructuradas de producto.
      </p>
    </section>

    <!-- SECCIÓN 1: DIAGNÓSTICO INICIAL Y DESAFÍOS -->
    <section class="space-y-6">
      <div class="border-b border-gray-200 pb-4">
        <span class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full">
          Sección 01
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          1. Diagnóstico Inicial y Desafíos Identificados
        </h2>
      </div>

      <p class="text-base text-gray-700 leading-relaxed">
        Durante este espacio de diagnóstico y práctica, identificamos los principales cuellos de botella en tu rutina actual como PO y las oportunidades clave de optimización:
      </p>

      <div class="grid md:grid-cols-3 gap-6">

        <div class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-3 hover:border-teal/40 transition">
          <div class="w-10 h-10 rounded-xl bg-orange/15 text-orange flex items-center justify-center text-xl font-bold">
            ⏳
          </div>
          <h3 class="font-bold text-deep text-base">Procesos manuales y repetitivos</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Inversión excesiva de tiempo copiando contenido desde modelos de IA hacia plantillas de Google Docs (sección por sección para mantener la línea gráfica corporativa), refinamiento directo de historias de usuario en GitHub y diseño manual de ajustes menores.
          </p>
        </div>

        <div class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-3 hover:border-teal/40 transition">
          <div class="w-10 h-10 rounded-xl bg-teal/15 text-teal flex items-center justify-center text-xl font-bold">
            🧩
          </div>
          <h3 class="font-bold text-deep text-base">Falta de estructura metodológica</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Flujo de desarrollo informal ("hágale rápido") y desalineación estratégica al conectar la etapa de Discovery con PRDs, OKRs y la ejecución operativa en Jira/GitHub.
          </p>
        </div>

        <div class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-3 hover:border-teal/40 transition">
          <div class="w-10 h-10 rounded-xl bg-deep/10 text-deep flex items-center justify-center text-xl font-bold">
            ⚡
          </div>
          <h3 class="font-bold text-deep text-base">Brecha de productividad</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Necesidad urgente de actualización en metodologías de producto y automatización con IA para alinearte al nivel técnico del equipo de desarrollo y liderazgo.
          </p>
        </div>

      </div>

      <!-- ACUERDO DE TRABAJO BANNER -->
      <div class="bg-slate-900 text-white p-6 rounded-2xl border border-slate-800 space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-orange animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-orange">Acuerdo sobre el Plan de Trabajo</span>
        </div>
        <p class="text-xs md:text-sm text-gray-300 leading-relaxed">
          Se acordó la liquidación de esta sesión individual inicial. El ciclo formal de 4 sesiones queda en pausa temporal hasta que consolides la información de tu inductivo y tengas un proyecto concreto sobre el cual aplicar mockups y flujos avanzados.
        </p>
      </div>
    </section>

    <!-- SECCIÓN 2: PLAN DE ACCIÓN INMEDIATO -->
    <section class="space-y-6">
      <div class="border-b border-gray-200 pb-4">
        <span class="text-xs font-bold text-orange uppercase tracking-widest bg-orange/10 px-3 py-1 rounded-full">
          Sección 02
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          2. Plan de Acción Inmediato: ¿Por dónde empezar?
        </h2>
        <p class="text-sm text-gray-600 mt-1">
          Para lograr un impacto directo en tu día a día, definimos las siguientes acciones priorizadas:
        </p>
      </div>

      <div class="space-y-4">

        <div class="bg-white border border-gray-200 rounded-2xl p-5 md:p-6 shadow-xs flex items-start gap-4">
          <span class="w-8 h-8 rounded-lg bg-teal text-white flex items-center justify-center font-black text-xs shrink-0 mt-0.5">
            01
          </span>
          <div class="space-y-1">
            <h3 class="font-bold text-deep text-base">Centralización y limpieza de la información</h3>
            <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
              Ordenar y estructurar notas de negocio, reglas y bases de datos dispersas dentro de carpetas organizadas en Google Drive como insumo previo imprescindible para cualquier automatización.
            </p>
          </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-5 md:p-6 shadow-xs flex items-start gap-4">
          <span class="w-8 h-8 rounded-lg bg-teal text-white flex items-center justify-center font-black text-xs shrink-0 mt-0.5">
            02
          </span>
          <div class="space-y-1">
            <h3 class="font-bold text-deep text-base">Estandarización de bases documentales</h3>
            <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
              Definir la plantilla oficial de PRD de <strong>tusdatos.co</strong> (estilos, secciones y estructura) para alimentar el contexto persistente en la IA.
            </p>
          </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-5 md:p-6 shadow-xs flex items-start gap-4">
          <span class="w-8 h-8 rounded-lg bg-teal text-white flex items-center justify-center font-black text-xs shrink-0 mt-0.5">
            03
          </span>
          <div class="space-y-1">
            <h3 class="font-bold text-deep text-base">Mapeo de consensos con IA</h3>
            <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
              Utilizar la IA para cruzar y conciliar información contradictoria de distintas partes interesadas (ej. criterio del líder técnico vs. solicitud de negocio) y llegar a las reuniones con decisiones de producto fundamentadas.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- SECCIÓN 3: CONTENIDO PRÁCTICO DESARROLLADO EN LA SESIÓN -->
    <section class="space-y-8">
      <div class="border-b border-gray-200 pb-4">
        <span class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full">
          Sección 03
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          3. Contenido Práctico Desarrollado en la Sesión
        </h2>
        <p class="text-sm text-gray-600 mt-1">
          Síntesis metodológica y casos de uso reales de IA aplicados a la gestión de producto trabajados durante la sesión:
        </p>
      </div>

      <div class="space-y-6">

        <!-- A. LA FÓRMULA ESTRUCTURAL DE PROMPTS -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4">
          <div class="flex items-center gap-3 border-b border-gray-100 pb-3">
            <span class="text-2xl">🧪</span>
            <h3 class="text-xl font-bold text-deep">A. La Fórmula Estructural de Prompts</h3>
          </div>

          <p class="text-sm text-gray-700 leading-relaxed">
            Para pasar de consultas simples tipo buscador a resultados profesionales inmediatos, aplicamos la estructura:
          </p>

          <!-- FÓRMULA DESTACADA -->
          <div class="bg-gradient-to-r from-slate-900 via-deep to-slate-900 text-white p-5 rounded-2xl text-center shadow-md border border-slate-700 space-y-2">
            <span class="text-[10px] uppercase font-bold text-teal tracking-widest block">Estructura Universal</span>
            <div class="text-base sm:text-xl font-mono font-bold text-teal-300 tracking-tight">
              Rol + Objetivo + Contexto + Formato de salida
            </div>
          </div>

          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Esta fórmula te permite obtener directamente tablas, Markdown estructurado o especificaciones funcionales sin rodeos.
          </p>

          <!-- ACCESO DIRECTO AL PROMPTEADOR -->
          <div class="mt-4 pt-4 border-t border-gray-100 bg-gradient-to-r from-teal/10 via-teal/5 to-transparent p-4 rounded-xl border border-teal/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="inline-block w-2 h-2 rounded-full bg-teal animate-pulse"></span>
                <span class="text-xs font-bold text-teal uppercase tracking-wider">Herramienta Interactiva</span>
              </div>
              <p class="text-xs md:text-sm font-bold text-deep">
                Construye y practica tus prompts estructurados en tiempo real
              </p>
              <p class="text-xs text-gray-600">
                Aplica la fórmula universal directamente en nuestra plantilla guiada.
              </p>
            </div>
            <a
              href="/recursos/prompteador"
              class="shrink-0 inline-flex items-center gap-2 bg-teal hover:bg-tealHover text-white px-5 py-2.5 rounded-xl font-bold text-xs md:text-sm transition shadow-sm hover:shadow-md cursor-pointer"
            >
              <span>⚡ Ir al Prompteador</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- B. PROTOTIPADO RÁPIDO DE INTERFACES (MOCKUPS EN HTML) -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4">
          <div class="flex items-center gap-3 border-b border-gray-100 pb-3">
            <span class="text-2xl">💻</span>
            <h3 class="text-xl font-bold text-deep">B. Prototipado Rápido de Interfaces (Mockups en HTML)</h3>
          </div>

          <div class="bg-slate-50 border border-gray-200 p-4 rounded-xl text-xs md:text-sm font-mono text-gray-800">
            <strong>Flujo:</strong> Captura de pantalla de la plataforma ➔ Subida a Gemini o Claude ➔ Generación de código HTML con estilos integrados.
          </div>

          <p class="text-xs md:text-sm text-gray-700 leading-relaxed">
            <strong>Resultado:</strong> Descargas un archivo <code>.html</code> interactivo y le pides ajustes a la IA en lenguaje natural (ej. <em>"agrega una columna al reporte PDF"</em> o <em>"cambia el color de este botón"</em>). Te permite entregar un prototipo funcional directo al equipo de desarrollo sin depender del área de diseño para cambios menores.
          </p>
        </div>

        <!-- C. PROTOTIPADO INTERACTIVO AVANZADO -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-3">
          <div class="flex items-center gap-3 border-b border-gray-100 pb-3">
            <span class="text-2xl">🚀</span>
            <h3 class="text-xl font-bold text-deep">C. Prototipado Interactivo Avanzado</h3>
          </div>
          <p class="text-xs md:text-sm text-gray-700 leading-relaxed">
            Generación de instrucciones técnicas y prompts estructurados para iterar y refinar prototipos en plataformas de desarrollo no-code.
          </p>
        </div>

        <!-- D. CONFIGURACIÓN DE PROYECTOS EN CLAUDE -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4">
          <div class="flex items-center gap-3 border-b border-gray-100 pb-3">
            <span class="text-2xl">⚙️</span>
            <h3 class="text-xl font-bold text-deep">D. Configuración de "Proyectos" con Contexto Persistente (Claude)</h3>
          </div>
          <p class="text-xs md:text-sm text-gray-700 leading-relaxed">
            Creación de un <strong>Project en Claude</strong> con instrucciones personalizadas, plantilla de PRD, tono de marca y user personas. Genera un sesgo permanente para que la IA redacte nuevos requerimientos manteniendo automáticamente el estándar de la empresa.
          </p>
        </div>

        <!-- E. INTEGRACIÓN DE IA CON GOOGLE DRIVE -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4">
          <div class="flex items-center gap-3 border-b border-gray-100 pb-3">
            <span class="text-2xl">📁</span>
            <h3 class="text-xl font-bold text-deep">E. Integración de IA con Google Drive</h3>
          </div>
          <p class="text-xs md:text-sm text-gray-700 leading-relaxed">
            Activación del conector de <strong>Google Drive en Claude</strong> para permitirle leer carpetas específicas de research, analizar hallazgos y redactar PRDs respaldados en datos reales del proyecto.
          </p>
        </div>

        <!-- F. DEEP RESEARCH PARA DISCOVERY TÉCNICO -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4">
          <div class="flex items-center gap-3 border-b border-gray-100 pb-3">
            <span class="text-2xl">🔍</span>
            <h3 class="text-xl font-bold text-deep">F. Deep Research para Discovery Técnico (Análisis de APIs)</h3>
          </div>
          <p class="text-xs md:text-sm text-gray-700 leading-relaxed">
            Uso de investigación profunda para analizar documentaciones técnicas de competidores (ej. <em>OpenSanctions</em>). Identificación en minutos de endpoints clave (GET/POST), esquemas de autenticación y cobertura de datos, consolidados en tablas comparativas estructuradas.
          </p>
        </div>

      </div>
    </section>

    <!-- SECCIÓN 4: ECOSISTEMA DE HERRAMIENTAS -->
    <section class="space-y-6">
      <div class="border-b border-gray-200 pb-4">
        <span class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full">
          Sección 04
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          4. Ecosistema de Herramientas de IA Evaluadas
        </h2>
      </div>

      <div class="overflow-x-auto bg-white border border-gray-200 rounded-2xl shadow-xs">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-gray-200 text-xs uppercase tracking-wider text-gray-500">
              <th class="p-4 font-bold">Herramienta</th>
              <th class="p-4 font-bold">Enlace Oficial</th>
              <th class="p-4 font-bold">Caso de Uso Principal en Producto</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-xs md:text-sm">

            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-bold text-deep shrink-0">
                Claude (Anthropic)
              </td>
              <td class="p-4">
                <a href="https://claude.ai" target="_blank" rel="noopener noreferrer" class="text-teal font-bold hover:underline">
                  claude.ai ↗
                </a>
              </td>
              <td class="p-4 text-gray-600 leading-relaxed">
                Redacción de PRDs, TRDs e historias de usuario; proyectos con contexto persistente e integración con Google Drive.
              </td>
            </tr>

            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-bold text-deep shrink-0">
                Gemini (Google)
              </td>
              <td class="p-4">
                <a href="https://gemini.google.com" target="_blank" rel="noopener noreferrer" class="text-teal font-bold hover:underline">
                  gemini.google.com ↗
                </a>
              </td>
              <td class="p-4 text-gray-600 leading-relaxed">
                Extracción de HTML desde imágenes y Deep Research (Gemini Flash) para investigación web profunda de mercado y APIs.
              </td>
            </tr>

            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-bold text-deep shrink-0">
                Perplexity AI
              </td>
              <td class="p-4">
                <a href="https://perplexity.ai" target="_blank" rel="noopener noreferrer" class="text-teal font-bold hover:underline">
                  perplexity.ai ↗
                </a>
              </td>
              <td class="p-4 text-gray-600 leading-relaxed">
                Búsqueda y validación de fuentes técnicas en tiempo real.
              </td>
            </tr>

            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-bold text-deep shrink-0">
                NotebookLM
              </td>
              <td class="p-4">
                <a href="https://notebooklm.google.com" target="_blank" rel="noopener noreferrer" class="text-teal font-bold hover:underline">
                  notebooklm.google.com ↗
                </a>
              </td>
              <td class="p-4 text-gray-600 leading-relaxed">
                Repositorio seguro para base de conocimiento de producto, estructuración de skills y documentación sin alucinaciones.
              </td>
            </tr>

            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-bold text-deep shrink-0">
                Lovable.dev
              </td>
              <td class="p-4">
                <a href="https://lovable.dev" target="_blank" rel="noopener noreferrer" class="text-teal font-bold hover:underline">
                  lovable.dev ↗
                </a>
              </td>
              <td class="p-4 text-gray-600 leading-relaxed">
                Generación de prototipos interactivos y páginas funcionales a partir de prompts técnicos.
              </td>
            </tr>

            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-bold text-deep shrink-0">
                Grok (xAI)
              </td>
              <td class="p-4">
                <a href="https://grok.com" target="_blank" rel="noopener noreferrer" class="text-teal font-bold hover:underline">
                  grok.com ↗
                </a>
              </td>
              <td class="p-4 text-gray-600 leading-relaxed">
                Análisis de tendencias y rápida evolución de agentes de IA.
              </td>
            </tr>

            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-bold text-deep shrink-0">
                ChatGPT (OpenAI)
              </td>
              <td class="p-4">
                <a href="https://chatgpt.com" target="_blank" rel="noopener noreferrer" class="text-teal font-bold hover:underline">
                  chatgpt.com ↗
                </a>
              </td>
              <td class="p-4 text-gray-600 leading-relaxed">
                Apoyo generalista en tareas de redacción y análisis lógico.
              </td>
            </tr>

          </tbody>
