---
import Layout from "../../layouts/Layout.astro";
import { LINKS } from "../../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const whatsappBlancar = `${whatsappBase}?text=${encodeURIComponent("Consulta Guia LuciRMe AI Blanca Rodríguez - Sesión 5")}`;
---

<Layout
  title="Guía Práctica de Integración: Sesión 5 | Blanca Rodríguez"
  description="Estrategia personalizada para Blanca Rodríguez · Product Manager (Bord & Consultoría en Empresa Médica)"
  hideHeader={true}
  hideFooter={false}
>
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="h-16 max-w-7xl mx-auto px-6 flex items-center justify-between gap-4">
      <a class="flex flex-col group" href="#">
        <span class="text-base font-bold tracking-tight text-slate-900 group-hover:text-teal-700 transition-colors">LuciRMe AI · Sesiones 1-1</span>
        <span class="text-[11px] font-mono text-slate-500">Trabajamos sobre problemas reales de tu trabajo.</span>
      </a>

      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600">
        <a class="hover:text-slate-900 transition-colors" href="#resumen">Resumen</a>
        <a class="hover:text-slate-900 transition-colors" href="#frentes">Frentes de Trabajo</a>
        <a class="hover:text-slate-900 transition-colors" href="#diagnostico">Diagnóstico y Fricciones</a>
        <a class="hover:text-slate-900 transition-colors" href="#paso-a-paso">Plan Paso a Paso</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-teal-700 text-white text-xs font-semibold hover:bg-teal-800 transition-colors shadow-2xs cursor-pointer"
          href={whatsappBlancar}
          rel="noopener noreferrer"
          target="_blank"
        >
          <span class="material-symbols-outlined text-[17px]">chat</span>
          <span>Quiero revisar mi caso</span>
        </a>
      </div>
    </div>
  </header>

  <main class="w-full pt-16 bg-[#f8f9ff] min-h-[calc(100vh-16rem)]">
    <div class="flex flex-col w-full text-slate-900 antialiased pb-24">
      
      <!-- 1. HEADER Y METADATOS -->
      <section class="w-full bg-[#FBFBFA] border-b border-slate-200" id="resumen">
        <div class="max-w-6xl mx-auto px-6 lg:px-8 pt-8 pb-10">
          
          <div class="pt-8 pb-8">
            <h1 class="text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight max-w-5xl leading-tight">
              Guía Práctica de Integración: Sesión 5 para Blanca Rodríguez (Product Manager)
            </h1>
            <p class="text-lg text-slate-600 mt-3 max-w-4xl">
              Estrategia personalizada para Bord (B2B SaaS) y Consultoría en Empresa Médica
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
            <div class="bg-white p-4 rounded border border-slate-200 shadow-2xs">
              <span class="text-[11px] text-slate-400 block uppercase tracking-wider mb-1 font-mono font-semibold">
                CLIENTE DIRECTO
              </span>
              <span class="text-base font-semibold text-slate-900 block">
                Blanca Rodríguez
              </span>
            </div>
            <div class="bg-white p-4 rounded border border-slate-200 shadow-2xs">
              <span class="text-[11px] text-slate-400 block uppercase tracking-wider mb-1 font-mono font-semibold">
                ROL / CONTEXTO
              </span>
              <span class="text-base font-semibold text-slate-900 block">
                Product Manager B2B
              </span>
              <span class="text-xs text-slate-600 block mt-0.5">
                Bord & Consultoría Empresa Médica
              </span>
            </div>
            <div class="bg-white p-4 rounded border border-slate-200 shadow-2xs">
              <span class="text-[11px] text-slate-400 block uppercase tracking-wider mb-1 font-mono font-semibold">
                ENFOQUE DUAL
              </span>
              <span class="text-xs text-slate-900 block font-medium">
                Cierre KRs Q3/Q4 + Adopción Inventario & Consultoría Técnica + Carrera
              </span>
            </div>
          </div>

          <div class="mt-4 bg-white p-6 rounded border border-slate-200 space-y-4 shadow-2xs">
            <div>
              <span class="text-xs text-teal-700 uppercase font-mono block mb-1 font-semibold">
                OBJETIVO PRINCIPAL
              </span>
              <p class="text-sm text-slate-700 leading-relaxed">
                Configurar un proyecto en Claude conectado a Amplitude y Notion para automatizar la medición de KRs y la adopción de eventos, estructurar la visión de IT Asset Management mediante prototipos rápidos en Stitch o Claude Design para validar con los CAMs (Customer Account Managers) y definir el módulo de gestión de usuarios y roles en las siguientes 3 semanas.
              </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 border-t border-slate-100">
              <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200">
                <span class="text-xs text-teal-700 font-mono block mb-1 font-semibold">FRENTE 1 · BORD (B2B SAAS)</span>
                <span class="text-sm font-semibold text-slate-900 block">Medición de KRs, Módulo de Inventario y Modelo SaaS</span>
                <p class="text-xs text-slate-600 mt-1">
                  Cierre Q3, planeación Q4 sin CPO, KRs conectados a Amplitude/Notion y visión de IT Asset Management.
                </p>
              </div>
              <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200">
                <span class="text-xs text-emerald-600 font-mono block mb-1 font-semibold">FRENTE 2 · EMPRESA MÉDICA & CARRERA</span>
                <span class="text-sm font-semibold text-slate-900 block">Consultoría Técnica y Búsqueda Profesional</span>
                <p class="text-xs text-slate-600 mt-1">
                  Uso de Granola, Claude y ChatGPT para arquitectura técnica y postulación a vacantes en dólares.
                </p>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- CONTENT CONTAINER -->
      <div class="max-w-6xl mx-auto px-6 lg:px-8 w-full pt-12 space-y-16" id="frentes">
        
        <!-- SECCIÓN 01: MAPA ESTRATÉGICO -->
        <section class="space-y-8">
          <div class="border-b border-slate-200 pb-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-teal-700 font-bold tracking-widest uppercase font-mono">
                SECCIÓN 01
              </span>
              <span class="text-slate-300">|</span>
              <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">
                MAPA ESTRATÉGICO
              </span>
            </div>
            <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 tracking-tight">
              Frentes de Trabajo: Bord y Consultoría Médica
            </h2>
          </div>

          <div class="bg-[#F1F1EF] p-5 rounded border-l-2 border-teal-700 text-slate-700 text-base leading-relaxed font-medium">
            "Las hipótesis de producto no se respaldan con suposiciones ni proyecciones arbitrarias; se comprueban en días mediante prototipos ante los CAMs y se miden registrando eventos reales de uso."
          </div>

          <!-- Bloques -->
          <div class="space-y-6">
            
            <!-- Frente 1 -->
            <div class="bg-white p-6 rounded border border-slate-200 space-y-4 shadow-2xs">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3">
                <h3 class="text-lg font-bold text-slate-900">
                  Frente 1: Medición de KRs, Módulo de Inventario y Modelo SaaS (Bord)
                </h3>
                <span class="text-xs text-teal-700 font-mono bg-[#F1F1EF] px-2 py-0.5 rounded font-semibold">
                  B2B SAAS ITAM
                </span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200 space-y-2">
                  <span class="text-[11px] text-slate-500 uppercase font-mono block font-semibold">CIERRE Q3 / Q4</span>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Automatización del reporte de KRs mediante un proyecto en Claude que consulta eventos en Amplitude y actualiza bases de datos en Notion ante la ausencia de la CPO.
                  </p>
                </div>
                <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200 space-y-2">
                  <span class="text-[11px] text-teal-700 uppercase font-mono block font-semibold">MÓDULO DE INVENTARIO</span>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Establecimiento de metas de adopción para el nuevo módulo (agrupaciones, vistas guardadas, filtros y descargas CSV) analizadas en dimensión de companies y users.
                  </p>
                </div>
                <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200 space-y-2">
                  <span class="text-[11px] text-slate-900 uppercase font-mono block font-semibold">VISIÓN SAAS</span>
                  <p class="text-xs text-slate-800 leading-relaxed">
                    Formulación de la visión de IT Asset Management planteada como un upsell o capa de entrada de gestión sin requerir logística física.
                  </p>
                </div>
              </div>
            </div>

            <!-- Frente 2 -->
            <div class="bg-white p-6 rounded border border-slate-200 space-y-4 shadow-2xs">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3">
                <h3 class="text-lg font-bold text-slate-900">
                  Frente 2: Gestión de Consultoría Técnica y Búsqueda Profesional
                </h3>
                <span class="text-xs text-emerald-600 font-mono bg-[#F1F1EF] px-2 py-0.5 rounded font-semibold">
                  EMPRESA MÉDICA & CARRERA
                </span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200 space-y-2">
                  <span class="text-[11px] text-slate-500 uppercase font-mono block font-semibold">CONSULTORÍA TÉCNICA</span>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Interpretación de requerimientos de arquitectura (compute, servicios) apoyándose en Granola, Claude y ChatGPT durante reuniones en vivo.
                  </p>
                </div>
                <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200 space-y-2">
                  <span class="text-[11px] text-teal-700 uppercase font-mono block font-semibold">SEGUNDO CEREBRO</span>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Uso de Notion como base de conocimiento centralizada para procesar requerimientos de consultoría sin exponer accesos directos.
                  </p>
                </div>
                <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200 space-y-2">
                  <span class="text-[11px] text-slate-900 uppercase font-mono block font-semibold">BÚSQUEDA PROFESIONAL</span>
                  <p class="text-xs text-slate-800 leading-relaxed">
                    Continuación de la postulación a vacantes remuneradas en dólares con paciencia tras haber avanzado a rondas finales en un proceso previo.
                  </p>
                </div>
              </div>
            </div>

          </div>

          <!-- DIAGRAMA ARCHIVO -->
          <div class="space-y-3 pt-2">
            <span class="text-xs text-slate-500 uppercase font-mono block font-semibold">
              ARQUITECTURA DE FLUJO DE INFORMACIÓN
            </span>
            <div class="bg-[#0b1c30] text-slate-100 rounded p-6 font-mono text-xs overflow-x-auto border border-slate-200 shadow-sm">
              <div class="text-slate-400 text-[11px] uppercase tracking-wider mb-3 pb-2 border-b border-slate-700 flex items-center justify-between">
                <span>DIAGRAMA DE INTEGRACIÓN SISTÉMICA</span>
                <span class="text-teal-400">BORD + EMPRESA MÉDICA</span>
              </div>
              <pre class="font-mono leading-relaxed select-all">[Amplitude / Granola / Perplexity / Claude Code] 
        <--> [Claude / ChatGPT / Proyectos] 
        <--> [Notion (KRs & Bases de Datos) / Stitch (Prototipos Visuales)]</pre>
            </div>
          </div>
        </section>

        <!-- SECCIÓN 02: DIAGNÓSTICO DE FRICCIONES & SOLUCIONES -->
        <section class="space-y-8 pt-4" id="diagnostico">
          <div class="border-b border-slate-200 pb-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-teal-700 font-bold tracking-widest uppercase font-mono">
                SECCIÓN 02
              </span>
              <span class="text-slate-300">|</span>
              <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">
                DIAGNÓSTICO & SOLUCIONES
              </span>
            </div>
            <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 tracking-tight">
              Diagnóstico de Fricciones & Soluciones por Bloque
            </h2>
          </div>

          <div class="space-y-6">
            
            <!-- Bloque 1 -->
            <div class="bg-white p-6 rounded border border-slate-200 space-y-4 shadow-2xs">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs text-teal-700 font-mono bg-[#F1F1EF] px-2 py-0.5 rounded font-semibold">[ BLOQUE 01 ]</span>
                  <h3 class="text-base font-bold text-slate-900">Cierre de KRs de Q3 / Q4 y Medición de Eventos (Bord)</h3>
                </div>
                <span class="text-xs text-slate-400 font-mono uppercase">AMPLITUDE + NOTION</span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-600">
                <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200 space-y-2">
                  <span class="text-xs text-slate-900 font-semibold font-mono block">EL PROBLEMA HABITUAL</span>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Falta de una visión clara del negocio por parte de los líderes/founders y la carga de trabajo manual al consolidar métricas al final de cada trimestre.
                  </p>
                </div>
                <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200 space-y-2">
                  <span class="text-xs text-teal-700 font-semibold font-mono block">CÓMO LO RESUELVE LA IA / OPERACIÓN</span>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Crear un proyecto en Claude conectado a la API de Amplitude para extraer eventos e integrarlos automáticamente en tablas de registros en Notion. Configurar eventos clave (filtros, vistas, descargas CSV), definir KRs objetivo y guardar actualizaciones sin repetir consultas históricas pesadas.
                  </p>
                </div>
              </div>
            </div>

            <!-- Bloque 2 -->
            <div class="bg-white p-6 rounded border border-slate-200 space-y-4 shadow-2xs">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs text-teal-700 font-mono bg-[#F1F1EF] px-2 py-0.5 rounded font-semibold">[ BLOQUE 02 ]</span>
                  <h3 class="text-base font-bold text-slate-900">Validación de Hipótesis y Modelo SaaS (Bord)</h3>
                </div>
                <span class="text-xs text-slate-400 font-mono uppercase">STITCH & CLAUDE DESIGN</span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-600">
                <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200 space-y-2">
                  <span class="text-xs text-slate-900 font-semibold font-mono block">EL PROBLEMA HABITUAL</span>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Inseguridad por la falla de un proyecto pasado en un marketplace automotriz en México, donde invirtieron 3 meses construyendo un SaaS básico basado en proyecciones arbitrarias que no tuvo adopción.
                  </p>
                </div>
                <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200 space-y-2">
                  <span class="text-xs text-teal-700 font-semibold font-mono block">CÓMO LO RESUELVE LA IA / OPERACIÓN</span>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Realizar benchmarking en Perplexity, formular hipótesis de valor y generar prototipos interactivos en minutos utilizando Stitch o Claude Design. Construir 3 o 4 propuestas de prototipos en 2 días, validarlos con CAMs y clientes clave antes de entregar specs a los 3 desarrolladores (quienes programan con Claude Code).
                  </p>
                </div>
              </div>
            </div>

            <!-- Bloque 3 -->
            <div class="bg-white p-6 rounded border border-slate-200 space-y-4 shadow-2xs">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs text-teal-700 font-mono bg-[#F1F1EF] px-2 py-0.5 rounded font-semibold">[ BLOQUE 03 ]</span>
                  <h3 class="text-base font-bold text-slate-900">Consultoría de Arquitectura Técnica (Empresa Médica)</h3>
                </div>
                <span class="text-xs text-slate-400 font-mono uppercase">GRANOLA + CHATGPT</span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-600">
                <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200 space-y-2">
                  <span class="text-xs text-slate-900 font-semibold font-mono block">EL PROBLEMA HABITUAL</span>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Preguntas sobre infraestructura técnica (compute, servicios) en reuniones en vivo que resulta complejo responder de inmediato.
                  </p>
                </div>
                <div class="bg-[#FBFBFA] p-4 rounded border border-slate-200 space-y-2">
                  <span class="text-xs text-teal-700 font-semibold font-mono block">CÓMO LO RESUELVE LA IA / OPERACIÓN</span>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Capturar la minuta con Granola y consultar en tiempo real en Claude o ChatGPT el significado de los términos técnicos. Copiar las notas a Notion para procesar prompts de soporte en ChatGPT/Claude de manera organizada sin exponer accesos directos de la empresa.
                  </p>
                </div>
              </div>
            </div>

          </div>
        </section>

        <!-- SECCIÓN 03: PLAN DE IMPLEMENTACIÓN PASO A PASO -->
        <section class="space-y-8 pt-4" id="paso-a-paso">
          <div class="border-b border-slate-200 pb-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-emerald-600 font-bold tracking-widest uppercase font-mono">
                SECCIÓN 03
              </span>
              <span class="text-slate-300">|</span>
              <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">
                PLAN DE ACCIÓN
              </span>
            </div>
            <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 tracking-tight">
              Plan de Implementación Paso a Paso (Action Plan)
            </h2>
          </div>

          <div class="space-y-6">
            
            <!-- Frente 1 Steps -->
            <div class="bg-white p-6 rounded border border-slate-200 space-y-4 shadow-2xs">
              <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-2">
                Frente 1: Medición, Inventario y Roles B2B (Bord)
              </h3>
              <ul class="space-y-3 text-sm text-slate-600 list-none">
                <li class="flex items-start gap-2.5">
                  <span class="font-mono text-teal-700 font-semibold shrink-0">PASO 01:</span>
                  <span><strong>Configuración de Proyecto en Claude para KRs:</strong> Construir durante esta semana un proyecto en Claude que consulte eventos de Amplitude y actualice la base de datos de KRs en Notion.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="font-mono text-teal-700 font-semibold shrink-0">PASO 02:</span>
                  <span><strong>Definición de Metas para el Módulo de Inventario:</strong> Fijar la meta inicial de 20 organizaciones activas en la primera semana (sobre una base activa de ~130 empresas al mes en inventario y ~320 organizaciones totales) que utilicen las funciones de agrupaciones, vistas guardadas o descargas CSV.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="font-mono text-teal-700 font-semibold shrink-0">PASO 03:</span>
                  <span><strong>Análisis en Doble Dimensión:</strong> Evaluar métricas a nivel de Users (para medir adopción y usabilidad) y a nivel de Companies (para analizar la viabilidad del negocio y el modelo SaaS).</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="font-mono text-teal-700 font-semibold shrink-0">PASO 04:</span>
                  <span><strong>Prototipado de Roles y Gestión de Usuarios:</strong> Aprovechar las próximas 3 semanas para investigar en Perplexity, diseñar prototipos en Stitch/Claude Design y validarlos con los CAMs antes de pasar a desarrollo.</span>
                </li>
              </ul>
            </div>

            <!-- Frente 2 Steps -->
            <div class="bg-white p-6 rounded border border-slate-200 space-y-4 shadow-2xs">
              <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-2">
                Frente 2: Consultoría y Desarrollo Profesional (Empresa Médica & Carrera)
              </h3>
              <ul class="space-y-3 text-sm text-slate-600 list-none">
                <li class="flex items-start gap-2.5">
                  <span class="font-mono text-emerald-600 font-semibold shrink-0">PASO 01:</span>
                  <span><strong>Centralización en Notion:</strong> Guardar minutas de Granola y requerimientos de la empresa médica en Notion para usarlas de fuente en ChatGPT/Claude.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="font-mono text-emerald-600 font-semibold shrink-0">PASO 02:</span>
                  <span><strong>Búsqueda Laboral:</strong> Mantener la postulación activa a vacantes remuneradas en dólares con paciencia.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="font-mono text-emerald-600 font-semibold shrink-0">PASO 03:</span>
                  <span><strong>Sincronización de Mentoría:</strong> Compartir avances o audios con Pablo durante la semana para revisar el proyecto de Claude en la sesión agendada para el martes a las 2:00 PM.</span>
                </li>
              </ul>
            </div>

          </div>
        </section>

        <!-- CIERRE Y SOPORTE DIRECTO -->
        <section class="pt-8 border-t border-slate-200">
          <div class="bg-[#F7F7F5] p-8 rounded border border-slate-200 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="space-y-2 max-w-3xl">
              <span class="text-xs text-teal-700 uppercase font-mono tracking-widest block font-semibold">
                PRINCIPIO DE CRITERIO INSTITUCIONAL · LUCIRME AI
              </span>
              <p class="text-lg font-bold text-slate-900 italic font-medium leading-snug">
