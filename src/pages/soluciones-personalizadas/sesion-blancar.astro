---
import Layout from "../../layouts/Layout.astro";
import ActionHub from "../../components/ActionHub.astro";
import RedesSociales from "../../components/RedesSociales.astro";
import { LINKS } from "../../lib/constants.js";

const cafeEstrategiaUrl = LINKS.calendly_sesion_pago || LINKS.calendly;
const calendlyUrl = LINKS.calendly_empresa || LINKS.calendly_taller || LINKS.calendly;
---

<Layout title="Sesión de Diagnóstico: Blanca Rodríguez | LuciRMe AI">

  <!-- BARRA DE NAVEGACIÓN SUPERIOR -->
  <nav class="bg-white/90 backdrop-blur-md border-b border-gray-200 px-6 py-4 sticky top-0 z-50">
    <div class="max-w-5xl mx-auto flex justify-between items-center gap-4">
      <a href="/" class="text-xs md:text-sm font-bold text-gray-500 hover:text-teal transition flex items-center gap-1">
        ← Volver a LuciRMe AI
      </a>
      <div class="flex items-center gap-2">
        <a href="/soluciones-personalizadas/guia-sesion-blanca" class="inline-flex items-center justify-center font-bold bg-teal/15 text-teal border border-teal/30 hover:bg-teal hover:text-white rounded-xl py-2 px-3 transition text-xs text-center cursor-pointer">
          📖 Sesión 1
        </a>
        <a href="/soluciones-personalizadas/sesion2-blancar" class="inline-flex items-center justify-center font-bold bg-teal text-white rounded-xl py-2 px-3 hover:bg-tealHover transition text-xs text-center cursor-pointer">
          🚀 Sesión 2
        </a>
        <a href={cafeEstrategiaUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center font-bold bg-orange text-white rounded-xl py-2 px-3 hover:bg-orange/90 transition text-xs text-center cursor-pointer">
          ☕ Café de Estrategia
        </a>
      </div>
    </div>
  </nav>

  <!-- HEADER / HERO SECTION -->
  <header class="bg-deep text-white py-16 md:py-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <!-- EYEBROW -->
      <div class="inline-flex items-center gap-2 bg-teal/15 text-teal text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 border border-teal/30">
        <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span>
        Diagnóstico Personalizado · Plan de Acompañamiento
      </div>

      <!-- H1 -->
      <h1 class="text-3xl md:text-5xl font-black mb-4 leading-tight tracking-tight text-white">
        Sesión de Diagnóstico: <span class="text-teal">Blanca Rodríguez</span>
      </h1>

      <!-- SUBTÍTULO -->
      <p class="text-lg md:text-xl text-gray-300 font-medium max-w-2xl mx-auto mb-6">
        Product Manager · B2B SaaS + AI · Agosto 2026
      </p>

      <!-- BANNERS ACCESO A GUÍAS DE SESIÓN -->
      <div class="flex flex-wrap justify-center items-center gap-3 mb-8">
        <a href="/soluciones-personalizadas/guia-sesion-blanca" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-extrabold text-xs md:text-sm px-4 py-2.5 rounded-2xl transition shadow-lg">
          <span>📖</span>
          <span>Guía Sesión 1: Product Management con IA →</span>
        </a>
        <a href="/soluciones-personalizadas/sesion2-blancar" class="inline-flex items-center gap-2 bg-gradient-to-r from-teal/30 to-orange/30 border border-teal/50 hover:border-teal/80 text-white font-extrabold text-xs md:text-sm px-4 py-2.5 rounded-2xl transition shadow-lg">
          <span>🔥</span>
          <span>¡Nueva! Guía Sesión 2: Entrevista Senior PM & AI-First →</span>
        </a>
      </div>

      <!-- META BADGES -->
      <div class="inline-flex flex-wrap justify-center items-center gap-4 bg-white/5 border border-white/10 rounded-xl px-5 py-2.5 text-xs md:text-sm text-gray-300">
        <span class="flex items-center gap-1.5">
          👤 <strong>Cliente:</strong> Blanca Rodríguez
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          💼 <strong>Rol principal:</strong> PM en B2B SaaS (Bord)
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          🤖 <strong>Rol adicional:</strong> PM / Consultora AI Médica
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          🚀 <strong>Acompañamiento:</strong> 1 Ciclo Individual (4 Sesiones)
        </span>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-12 space-y-16">

    <!-- SECCIÓN 1: RESUMEN EJECUTIVO Y DIAGNÓSTICO -->
    <section class="space-y-6">
      <div class="border-b border-gray-200 pb-4">
        <span class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full">
          Resumen Ejecutivo
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          Contexto y Diagnóstico Inicial
        </h2>
      </div>

      <div class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4 leading-relaxed text-gray-700 text-base">
        <p>
          Blanca es Product Manager desde hace aproximadamente 5 años. Su recorrido comenzó en UX/UI y posteriormente pasó a Product Management, después de haber trabajado anteriormente en manufactura como ingeniera industrial.
        </p>

        <div class="grid md:grid-cols-2 gap-4 my-2">
          <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-1">
            <span class="text-xs font-bold text-teal uppercase tracking-wider block">💼 Rol Principal — Bord</span>
            <p class="text-xs text-gray-600 leading-relaxed">
              Product Manager en Bord, plataforma orientada a la gestión de activos tecnológicos de empresas y empleados. Enfocada en evolucionar la plataforma hacia un sistema de Asset Management con potencial para convertirse en un SaaS independiente.
            </p>
          </div>
          <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-1">
            <span class="text-xs font-bold text-teal uppercase tracking-wider block">🤖 Rol Adicional — Salud / AI</span>
            <p class="text-xs text-gray-600 leading-relaxed">
              Product Manager / consultora de productos de AI para una compañía médica. Trabaja con chatbots, gestión y clasificación de documentos, consulta RAG de información y herramientas internas de AI.
            </p>
          </div>
        </div>

        <p>
          Blanca ya utiliza herramientas como <strong class="text-deep">Claude, Claude Code, ChatGPT y Granola</strong>. El problema no es que no utilice IA. El problema es que todavía la utiliza principalmente como una herramienta de conversación y generación puntual.
        </p>

        <!-- EL PROBLEMA CONCRETO -->
        <div class="p-5 bg-slate-50 border-l-4 border-orange rounded-r-xl my-4 space-y-3">
          <h3 class="font-bold text-deep text-sm uppercase tracking-wide flex items-center gap-2">
            <span>⚠️</span> <span>El problema concreto</span>
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Blanca tiene información distribuida entre diferentes fuentes (notas, documentación, entrevistas, datos, feedback, métricas, roadmap, PRDs y backlog). Pero todavía existe un paso manual entre cada parte del proceso.
          </p>
          <div class="bg-white p-3 rounded-lg border border-slate-200 font-mono text-xs text-deep text-center font-bold">
            Información → Análisis → Documentación → Roadmap → Backlog → Ejecución
          </div>
          <p class="text-xs text-gray-500 italic">
            Y Blanca sigue siendo el elemento que conecta manualmente cada etapa.
          </p>

          <div class="pt-2 space-y-2">
            <span class="text-xs font-bold text-deep uppercase tracking-wider block">Tres dolores principales identificados:</span>
            <ul class="space-y-1.5 text-xs text-gray-700">
              <li class="flex items-start gap-2">
                <span class="text-orange font-bold">1.</span>
                <span><strong>Mantener los PRDs actualizados:</strong> La información cambia constantemente y mantener la documentación alineada con las decisiones requiere trabajo manual.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-orange font-bold">2.</span>
                <span><strong>Mantener el roadmap actualizado:</strong> Los cambios en proyectos, prioridades y decisiones deberían reflejarse en el roadmap, pero actualizar una parte termina dejando desactualizado el resto.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-orange font-bold">3.</span>
                <span><strong>Mantener y crear el backlog para Tech:</strong> Las decisiones y cambios deben convertirse nuevamente en historias/tareas para desarrollo.</span>
              </li>
            </ul>
          </div>
        </div>

        <p class="text-sm text-gray-600">
          <strong>El problema no es solamente ahorrar tiempo:</strong> Es evitar perder el hilo entre las decisiones de producto y su ejecución debido a interrupciones y tareas repetitivas.
        </p>
      </div>

      <!-- DIAGNÓSTICO CLAVE CALLOUT -->
      <div class="bg-gradient-to-r from-teal/10 via-slate-50 to-orange/10 border border-teal/20 rounded-2xl p-6 md:p-8 space-y-3">
        <h3 class="font-extrabold text-deep text-base uppercase tracking-wider flex items-center gap-2">
          <span>🧠</span> <span>Diagnóstico Clave</span>
        </h3>
        <p class="text-gray-700 text-sm md:text-base leading-relaxed">
          Blanca ya está en un nivel donde aprender "más herramientas de IA" no es el principal cuello de botella. Su oportunidad está en <strong>conectar las herramientas y convertir procesos repetitivos en flujos asistidos por IA.</strong>
        </p>
        <div class="grid sm:grid-cols-2 gap-3 pt-2">
          <div class="bg-white/80 p-3.5 rounded-xl border border-red-200/60 text-xs">
            <span class="font-bold text-red-600 block mb-1">🔴 Estado Actual (Manual):</span>
            <code class="text-gray-600">Blanca → herramienta → output → Blanca → otra herramienta → output → Blanca</code>
          </div>
          <div class="bg-white/80 p-3.5 rounded-xl border border-teal/30 text-xs">
            <span class="font-bold text-teal block mb-1">🟢 Estado Deseado (Flujo Asistido):</span>
            <code class="text-deep font-semibold">Información → IA → procesamiento → decisión → actualización → ejecución</code>
          </div>
        </div>
        <p class="text-xs text-gray-500 pt-1">
          La prioridad será identificar qué partes de su flujo realmente necesitan intervención humana y cuáles pueden ser procesadas, estructuradas o preparadas automáticamente sin convertir todo en una automatización compleja.
        </p>
      </div>
    </section>

    <!-- SECCIÓN 2: OBJETIVOS DEL ACOMPAÑAMIENTO -->
    <section class="space-y-6">
      <div class="border-b border-gray-200 pb-4">
        <span class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full">
          Objetivos del Acompañamiento
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          ¿Qué vamos a resolver?
        </h2>
      </div>

      <!-- TABLA DE OBJETIVOS -->
      <div class="overflow-x-auto bg-white border border-gray-200 rounded-2xl shadow-xs">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-gray-200 text-xs uppercase tracking-wider text-gray-500">
              <th class="p-4 font-bold">Objetivo</th>
              <th class="p-4 font-bold">Resultado esperado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-semibold text-deep">Mapear el flujo real de trabajo</td>
              <td class="p-4 text-gray-600">Identificar dónde se pierde tiempo y contexto</td>
            </tr>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-semibold text-deep">Analizar el uso actual de IA</td>
              <td class="p-4 text-gray-600">Detectar qué herramientas ya funcionan y cuáles están subutilizadas</td>
            </tr>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-semibold text-deep">Optimizar documentación</td>
              <td class="p-4 text-gray-600">Reducir el trabajo manual de mantener PRDs y conocimiento actualizado</td>
            </tr>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-semibold text-deep">Mejorar roadmap + backlog</td>
              <td class="p-4 text-gray-600">Crear una conexión más fluida entre decisiones y ejecución</td>
            </tr>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-semibold text-deep">Mejorar priorización</td>
              <td class="p-4 text-gray-600">Incorporar información de usuarios, métricas y negocio de forma más sistemática</td>
            </tr>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-semibold text-deep">Explorar automatización</td>
              <td class="p-4 text-gray-600">Identificar qué partes pueden pasar de reactivas a proactivas</td>
            </tr>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-semibold text-deep">Aprender la lógica</td>
              <td class="p-4 text-gray-600">Que Blanca pueda mantener y evolucionar los flujos por su cuenta</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- SECCIÓN 3: PLAN DE TRABAJO (FASES) -->
    <section class="space-y-8">
      <div class="border-b border-gray-200 pb-4">
        <span class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full">
          Plan de Trabajo
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          1 Ciclo Individual · 4 Sesiones
        </h2>
        <p class="text-sm text-gray-600 mt-1">
          No vamos a intentar automatizar todo desde el primer día. Vamos a empezar por los procesos que más tiempo y fricción generan.
        </p>
      </div>

      <div class="space-y-6">

        <!-- FASE 1 -->
        <div class="bg-white border-l-4 border-teal border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-gray-100 pb-3">
            <div>
              <span class="text-xs font-bold text-teal uppercase tracking-widest">Fase 1</span>
              <h3 class="text-xl font-extrabold text-deep">Mapear el flujo real de Producto</h3>
            </div>
            <span class="inline-block bg-teal/10 text-teal font-bold px-3 py-1 rounded-full text-xs self-start sm:self-auto">
              Sesión 1
            </span>
          </div>

          <p class="text-sm text-gray-700 leading-relaxed">
            Vamos a reconstruir cómo trabaja Blanca actualmente:
          </p>

          <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs font-mono text-center text-deep font-semibold">
            Información → Decisiones → PRD → Roadmap → Backlog → Tech
          </div>

          <div class="grid sm:grid-cols-2 gap-3 text-xs text-gray-700 pt-1">
            <div class="space-y-1">
              <p>• De dónde llega la información y dónde se almacena.</p>
              <p>• Qué tareas se repiten y qué información se copia manualmente.</p>
              <p>• Dónde se pierde contexto durante el proceso.</p>
            </div>
            <div class="space-y-1">
              <p>• Qué decisiones requieren criterio humano insustituible.</p>
              <p>• Qué partes pueden ser asistidas por IA.</p>
              <p>• Qué partes podrían automatizarse.</p>
            </div>
          </div>

          <!-- PREPARACIÓN PARA SESIÓN 1 -->
          <div class="p-4 bg-teal/5 border border-teal/20 rounded-xl space-y-3">
            <h4 class="font-bold text-deep text-xs uppercase tracking-wider flex items-center gap-2">
              <span>📋</span> <span>Preparación para la Sesión 1</span>
            </h4>
            <p class="text-xs text-gray-600 leading-relaxed">
              Para resolver un problema real desde el primer día, Blanca deberá llegar con sus herramientas y fuentes abiertas:
            </p>
            <div class="grid sm:grid-cols-2 gap-3 text-xs">
              <div class="bg-white p-3 rounded-lg border border-slate-200 space-y-1">
                <span class="font-bold text-deep block">🧰 Herramientas abiertas:</span>
                <p class="text-gray-600">Claude, Claude Code, ChatGPT, Granola, Metabase (si aplica para datos/métricas).</p>
              </div>
              <div class="bg-white p-3 rounded-lg border border-slate-200 space-y-1">
                <span class="font-bold text-deep block">📄 Documentación de Bord:</span>
                <p class="text-gray-600">PRD reciente, roadmap actual, backlog Tech, historias recientes, notas de reunión y un ejemplo real de decisión reciente.</p>
              </div>
            </div>
            <p class="text-xs text-gray-500 italic">
              *No necesitamos preparar documentación nueva. Queremos trabajar sobre información real y procesos actuales.
            </p>
            <p class="text-xs font-bold text-teal pt-1">
              🎯 Meta de la Sesión 1: Dejar de hablar de "IA" en abstracto y encontrar el primer punto concreto donde construir una solución.
            </p>
          </div>
        </div>

        <!-- FASE 2 -->
        <div class="bg-white border-l-4 border-orange border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-gray-100 pb-3">
            <div>
              <span class="text-xs font-bold text-orange uppercase tracking-widest">Fase 2</span>
              <h3 class="text-xl font-extrabold text-deep">El flujo PRD → Roadmap → Backlog</h3>
            </div>
            <span class="inline-block bg-orange/10 text-orange font-bold px-3 py-1 rounded-full text-xs self-start sm:self-auto">
              Sesiones 2 y 3
            </span>
          </div>

          <blockquote class="text-sm font-semibold text-deep italic border-l-2 border-orange pl-3 py-1 bg-slate-50 rounded-r-lg">
            "¿Cómo hacemos para que una actualización no implique volver a actualizar manualmente todo lo demás?"
          </blockquote>

          <p class="text-sm text-gray-700">
            Trabajaremos sobre la relación clave entre:
          </p>
          <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs font-mono text-center text-deep font-semibold">
            PRD → Decisiones → Roadmap → Historias / Tareas → Backlog
          </div>

          <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Exploraremos cómo utilizar IA para:</p>
          <ul class="grid sm:grid-cols-2 gap-2 text-xs text-gray-700">
            <li class="flex items-center gap-2 bg-slate-50 p-2.5 rounded-lg border border-slate-100">
              <span class="text-orange font-bold">✓</span>
              <span>Mantener información consistente.</span>
            </li>
            <li class="flex items-center gap-2 bg-slate-50 p-2.5 rounded-lg border border-slate-100">
              <span class="text-orange font-bold">✓</span>
              <span>Detectar cambios automáticamente.</span>
            </li>
            <li class="flex items-center gap-2 bg-slate-50 p-2.5 rounded-lg border border-slate-100">
              <span class="text-orange font-bold">✓</span>
              <span>Convertir decisiones en outputs estructurados.</span>
            </li>
            <li class="flex items-center gap-2 bg-slate-50 p-2.5 rounded-lg border border-slate-100">
              <span class="text-orange font-bold">✓</span>
              <span>Preparar historias de usuario sin reescrituras manuales.</span>
            </li>
            <li class="flex items-center gap-2 bg-slate-50 p-2.5 rounded-lg border border-slate-100">
              <span class="text-orange font-bold">✓</span>
              <span>Identificar información faltante o inconsistencias.</span>
            </li>
            <li class="flex items-center gap-2 bg-slate-50 p-2.5 rounded-lg border border-slate-100">
              <span class="text-orange font-bold">✓</span>
              <span>Mantener el contexto entre diferentes etapas.</span>
            </li>
          </ul>

          <p class="text-xs font-bold text-orange pt-2">
            🎯 Meta: Reducir el trabajo de "pegar información de un lugar a otro" y construir un flujo mucho más coherente.
          </p>
        </div>

        <!-- FASE 3 -->
        <div class="bg-white border-l-4 border-blue-500 border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-gray-100 pb-3">
            <div>
              <span class="text-xs font-bold text-blue-600 uppercase tracking-widest">Fase 3</span>
              <h3 class="text-xl font-extrabold text-deep">De Producto Reactivo a Producto Proactivo</h3>
            </div>
            <span class="inline-block bg-blue-50 text-blue-600 font-bold px-3 py-1 rounded-full text-xs self-start sm:self-auto">
              Sesión 4
            </span>
          </div>

          <p class="text-sm text-gray-700 leading-relaxed">
            Blanca identificó una segunda gran oportunidad: <strong class="text-deep">usar mejor la información que ya existe para tomar decisiones de producto.</strong>
          </p>

          <p class="text-xs text-gray-600">
            Actualmente cuenta con información proveniente de: Usuarios, Soporte, Feedback, Métricas, Amplitude, Data Lake / Metabase, PRDs, Roadmap y Backlog. En esta sesión exploraremos cómo convertir esa masa dispersa en un sistema proactivo:
          </p>

          <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs font-mono text-center text-blue-700 font-bold">
            Datos + Feedback + Contexto → Análisis → Insights → Recomendación → Acción
          </div>

          <p class="text-xs font-bold text-blue-600 pt-1">
            🎯 Meta: Que la IA no solamente ayude a producir documentos, sino también a procesar información y apoyar decisiones estratégicas de producto.
          </p>
        </div>

      </div>
    </section>

    <!-- SECCIÓN 4: EL PRINCIPIO Y LO QUE CONSTRUIMOS -->
    <section class="space-y-8">
      <div class="border-b border-gray-200 pb-4">
        <span class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full">
          Metodología
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          El Principio del Acompañamiento
        </h2>
      </div>

      <blockquote class="bg-deep text-white rounded-2xl p-6 md:p-8 space-y-4 shadow-lg border border-teal/30">
        <h3 class="text-lg md:text-xl font-bold text-teal-300">
          No se trata de aprender 50 herramientas nuevas.
        </h3>
        <p class="text-sm md:text-base text-gray-200 leading-relaxed">
          Blanca ya tiene herramientas. Lo que vamos a construir es <strong>criterio para decidir qué usar, cuándo usarlo y cómo conectarlo.</strong>
        </p>
        <p class="text-sm text-gray-300 leading-relaxed">
          Mi rol no es construir algo a escondidas y entregárselo terminado. Es compartir pantalla, trabajar sobre sus procesos reales y enseñarle la lógica detrás de cada solución.
        </p>
