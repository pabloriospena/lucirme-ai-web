---
// src/pages/soluciones-personalizadas/sesion7-blancar.astro
import Layout from "../../layouts/Layout.astro";
import BlancaSessionsNav from "../../components/BlancaSessionsNav.astro";
import { LINKS } from "../../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const whatsappBlancar = `${whatsappBase}?text=${encodeURIComponent("Consulta Guia LuciRMe AI Blanca Rodríguez - Sesión 7 (Notificaciones, Comunicaciones y Roles - Bord)")}`;
---

<Layout
  title="Guía Práctica y Recordatorio de la Sesión 7 | Blanca Rodríguez"
  description="Estrategia de notificaciones, consolidado diario, modelo de comunicaciones y roles para la plataforma Dash de Bord."
  hideHeader={true}
  hideFooter={false}
>
  <BlancaSessionsNav current="7" />
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="h-16 max-w-7xl mx-auto px-6 flex items-center justify-between gap-4">
      <a class="flex flex-col group" href="#">
        <span class="text-base font-bold tracking-tight text-slate-900 group-hover:text-teal-700 transition-colors">LuciRMe AI · Sesiones 1-1</span>
        <span class="text-[11px] font-mono text-slate-500">Trabajamos sobre problemas reales de tu trabajo.</span>
      </a>

      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600">
        <a class="hover:text-slate-900 transition-colors" href="#objetivos">Objetivos</a>
        <a class="hover:text-slate-900 transition-colors" href="#paso-a-paso">Paso a Paso</a>
        <a class="hover:text-slate-900 transition-colors" href="#todos">Próximos Pasos (TODO)</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-teal-700 text-white text-xs font-semibold hover:bg-teal-800 transition-colors shadow-2xs cursor-pointer"
          href={whatsappBlancar}
          rel="noopener noreferrer"
          target="_blank"
        >
          <span class="material-symbols-outlined text-[17px]">chat</span>
          <span>Quiero revisar mi caso</span>
        </a>
      </div>
    </div>
  </header>

  <main class="w-full pt-16 bg-[#f8f9ff] min-h-[calc(100vh-16rem)]">
    <div class="flex flex-col w-full text-slate-900 antialiased pb-24">
      
      <!-- 1. HEADER Y METADATOS -->
      <section class="w-full bg-[#FBFBFA] border-b border-slate-200" id="resumen">
        <div class="max-w-6xl mx-auto px-6 lg:px-8 pt-8 pb-10">
          
          <div class="pt-8 pb-8">
            <h1 class="text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight max-w-5xl leading-tight">
              Guía Práctica y Recordatorio de la Sesión del 20 de Octubre (Sesión 7)
            </h1>
            <p class="text-lg text-slate-600 mt-3 max-w-4xl">
              Estrategia de notificaciones, comunicaciones y roles en la plataforma Dash de Bord
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
            <div class="bg-white p-4 rounded border border-slate-200 shadow-2xs">
              <span class="text-[11px] text-slate-400 block uppercase tracking-wider mb-1 font-mono font-semibold">
                CLIENTE DIRECTO
              </span>
              <span class="text-base font-semibold text-slate-900 block">
                Blanca Rodríguez
              </span>
            </div>
            <div class="bg-white p-4 rounded border border-slate-200 shadow-2xs">
              <span class="text-[11px] text-slate-400 block uppercase tracking-wider mb-1 font-mono font-semibold">
                ROL / CONTEXTO
              </span>
              <span class="text-base font-semibold text-slate-900 block">
                Product Manager · Life Cycle Squad
              </span>
              <span class="text-xs text-slate-600 block mt-0.5">
                Plataforma Dash de Bord
              </span>
            </div>
            <div class="bg-white p-4 rounded border border-slate-200 shadow-2xs">
              <span class="text-[11px] text-slate-400 block uppercase tracking-wider mb-1 font-mono font-semibold">
                ENFOQUE DE LA SESIÓN
              </span>
              <span class="text-xs text-slate-900 block font-medium">
                Notificaciones, Comunicaciones, Propuesta Visual y Roles B2B
              </span>
            </div>
          </div>

          <div class="mt-4 bg-white p-6 rounded border border-slate-200 space-y-4 shadow-2xs">
            <div>
              <span class="text-xs text-teal-700 uppercase font-mono block mb-1 font-semibold">
                PROPÓSITO CENTRAL
              </span>
              <p class="text-sm text-slate-700 leading-relaxed">
                Destrabar y preparar la propuesta visual de notificaciones, comunicaciones y roles para la reunión decisiva de Bord con los líderes de Comercial y CX, superando la saturación de correos y definiendo un modelo consolidado eficiente.
              </p>
            </div>
          </div>

        </div>
      </section>

      <!-- CONTENT CONTAINER -->
      <div class="max-w-6xl mx-auto px-6 lg:px-8 w-full pt-12 space-y-16" id="objetivos">
        
        <!-- SECCIÓN 01: FICHA Y OBJETIVOS -->
        <section class="space-y-8">
          <div class="border-b border-slate-200 pb-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-teal-700 font-bold tracking-widest uppercase font-mono">
                SECCIÓN 01
              </span>
              <span class="text-slate-300">|</span>
              <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">
                ESTADO Y METAS
              </span>
            </div>
            <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 tracking-tight">
              1. Ficha y Objetivos de la Sesión
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-mono font-bold text-sm">A</div>
              <h3 class="font-bold text-slate-900 text-base">Estado de la Mentoriada</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Blanca llega sobrecargada con síntomas de burnout y un dolor de cabeza fuerte (tomó acetaminofén), abrumada por la doble carga de sus dos empleos. En la empresa médica tiene 9 requests detenidos por burocracia/desarrolladores, lo que le da margen; mientras que en Bord tiene la urgencia más inmediata.
              </p>
            </div>

            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-mono font-bold text-sm">B</div>
              <h3 class="font-bold text-slate-900 text-base">Feedback del Reporte Anterior</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                La CPO quedó muy tranquila con el formato del reporte presentado y sugirió evaluar si los demás squads pueden replicar esa misma estructura.
              </p>
            </div>

            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-mono font-bold text-sm">C</div>
              <h3 class="font-bold text-slate-900 text-base">Objetivo Urgente de la Sesión</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Destrabar y preparar la propuesta visual de notificaciones, comunicaciones y roles para una reunión decisiva de Bord al día siguiente con los líderes de Comercial y CX.
              </p>
            </div>

            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-mono font-bold text-sm">D</div>
              <h3 class="font-bold text-slate-900 text-base">Desenfoque y Criterio</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Superar el bloqueo operativo ("pensar en automático") y definir una solución simple y de rápido desarrollo para evitar que los clientes sigan saturados de correos.
              </p>
            </div>
          </div>
        </section>

        <!-- SECCIÓN 02: PASO A PASO -->
        <section class="space-y-8" id="paso-a-paso">
          <div class="border-b border-slate-200 pb-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-teal-700 font-bold tracking-widest uppercase font-mono">
                SECCIÓN 02
              </span>
              <span class="text-slate-300">|</span>
              <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">
                EJECUCIÓN Y ANÁLISIS
              </span>
            </div>
            <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 tracking-tight">
              2. Lo que Hicimos Paso a Paso (Hands-On y Análisis)
            </h2>
          </div>

          <div class="space-y-6">
            
            <!-- Paso 1 -->
            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-1 rounded bg-teal-100 text-teal-800 font-mono text-xs font-bold">Paso 1</span>
                <h3 class="font-bold text-slate-900 text-base">Diagnóstico de la Comunicación en Bord</h3>
              </div>
              <ul class="list-disc list-inside space-y-2 text-xs sm:text-sm text-slate-700">
                <li><strong class="text-slate-900">Saturación por volumen de e-mails:</strong> Cuando una empresa realiza múltiples pedidos en un día, recibe un correo individual por cada cambio de estado (5 correos de cajón por servicio logístico, más facturación, incidencias y configuraciones IT).</li>
                <li>
                  <strong class="text-slate-900">Impacto en Soporte y Operaciones:</strong>
                  <ul class="list-circle list-inside pl-5 mt-1 space-y-1 text-slate-600">
                    <li>Comercial identificó 14 empresas con quejas explícitas documentadas por exceso de correos (~10-15% de las empresas activas).</li>
                    <li>El 47% de los tickets en CX son usuarios preguntando únicamente por el estatus de sus órdenes.</li>
                    <li>Se pierden las incidencias críticas (retrasos de proveedores, direcciones erróneas, falta de respuesta del empleado) al quedar enterradas entre la marea de correos pasivos.</li>
                  </ul>
                </li>
                <li><strong class="text-slate-900">Mal destinatario:</strong> Los correos se le envían por defecto a quien crea la orden (compras/HR) y no al operador o al empleado final que recibe el paquete.</li>
              </ul>
            </div>

            <!-- Paso 2 -->
            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-1 rounded bg-teal-100 text-teal-800 font-mono text-xs font-bold">Paso 2</span>
                <h3 class="font-bold text-slate-900 text-base">Definición del Modelo de Notificaciones (Fase 1)</h3>
              </div>
              <ul class="list-disc list-inside space-y-2 text-xs sm:text-sm text-slate-700">
                <li><strong class="text-slate-900">Desvincular Roles B2B de la Fase 1:</strong> Se acordó no condicionar las notificaciones a la creación de una arquitectura compleja de roles B2B, ya que retrasaría la entrega. En su lugar, se habilitarán preferencias a nivel de usuario personal de Dash.</li>
                <li><strong class="text-slate-900">Estrategia del Correo Diario Consolidado:</strong> Consolidado diario a las 8:00 AM (agrupar toda la actividad informativa de las órdenes, servicios y quotes activas del día anterior en un solo e-mail, más un resumen semanal los lunes).</li>
                <li>
                  <strong class="text-slate-900">Manejo de Incidencias e Inmediatez:</strong>
                  <ul class="list-circle list-inside pl-5 mt-1 space-y-1 text-slate-600">
                    <li><em>Alertas inmediatas:</em> Mantener correos individuales inmediatos únicamente para incidencias bloqueantes, cancelaciones o datos incorrectos.</li>
                    <li><em>Identificador visual urgente:</em> Incluir emojis/signos de alerta (sirenas 🚨) en el asunto del correo urgente para que el cliente lo reconozca al instante sin abrir la bandeja.</li>
                    <li><em>Clasificación:</em> Las incidencias informativas se suman al correo diario; las bloqueantes o críticas se envían de forma individual.</li>
                  </ul>
                </li>
                <li>
                  <strong class="text-slate-900">WhatsApp para Empleados en Latam:</strong>
                  <ul class="list-circle list-inside pl-5 mt-1 space-y-1 text-slate-600">
                    <li>Para los empleados finales (destinatarios de activos en Latam), notificar el tracking de entrega o recolección por WhatsApp mediante plantillas aprobadas vía API con Freshdesk.</li>
                    <li>Para los clientes corporativos (usuarios de Dash), mantener la comunicación por correo o Slack.</li>
                  </ul>
                </li>
              </ul>
            </div>

            <!-- Paso 3 -->
            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-1 rounded bg-teal-100 text-teal-800 font-mono text-xs font-bold">Paso 3</span>
                <h3 class="font-bold text-slate-900 text-base">Estrategia contra el Pushback Interno</h3>
              </div>
              <ul class="list-disc list-inside space-y-2 text-xs sm:text-sm text-slate-700">
                <li><strong class="text-slate-900">Manejo de la objeción Comercial/CX ("Que el usuario elija"):</strong> Rechazar la idea de dar la opción de mantener correos 1 a 1. Lanzar el cambio de forma estandarizada como una mejora directa al servicio para reducir el spam.</li>
                <li><strong class="text-slate-900">Educación al Cliente:</strong> Acompañar el despliegue con un comunicado que enseñe a los usuarios cómo consultar el estado en tiempo real en la plataforma Dash mediante los enlaces directos del correo consolidado.</li>
              </ul>
            </div>

            <!-- Paso 4 -->
            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-1 rounded bg-teal-100 text-teal-800 font-mono text-xs font-bold">Paso 4</span>
                <h3 class="font-bold text-slate-900 text-base">Generación del Prototipo/Artefacto Visual en Claude</h3>
              </div>
              <ul class="list-disc list-inside space-y-2 text-xs sm:text-sm text-slate-700">
                <li>
                  <strong class="text-slate-900">Construcción del Flujo Gráfico ("Antes vs. Después"):</strong> Se formuló un prompt en Claude (Sonnet 3.5) para generar un artefacto visual interactivo que muestre:
                  <ul class="list-circle list-inside pl-5 mt-1 space-y-1 text-slate-600">
                    <li><em>Antes:</em> Bandeja de entrada saturada con múltiples correos individuales por cambio de estado.</li>
                    <li><em>Después:</em> Un correo consolidado a las 8:00 AM con resumen por categorías.</li>
                    <li><em>Alertas Críticas:</em> Correo destacado con signos de alerta 🚨 para casos urgentes.</li>
                    <li><em>Preferencias de Usuario:</em> Interfaz con controles (switches) para que cada usuario apague o encienda las categorías de notificación en su perfil de Dash.</li>
                  </ul>
                </li>
              </ul>
            </div>

          </div>
        </section>

        <!-- SECCIÓN 03: PENDIENTES Y PRÓXIMOS PASOS (TODO) -->
        <section class="space-y-8" id="todos">
          <div class="border-b border-slate-200 pb-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-teal-700 font-bold tracking-widest uppercase font-mono">
                SECCIÓN 03
              </span>
              <span class="text-slate-300">|</span>
              <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">
                PLAN DE ACCIÓN
              </span>
            </div>
            <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 tracking-tight">
              3. Pendientes y Próximos Pasos (TODO)
            </h2>
          </div>

          <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-4">
            <div class="space-y-3">
              
              <div class="flex items-start gap-3 p-3 rounded bg-slate-50 border border-slate-100">
                <span class="font-mono text-teal-700 font-bold shrink-0">[ ]</span>
                <p class="text-xs sm:text-sm text-slate-800">
                  <strong class="text-slate-900">Alinear el Prototipo de Claude con el Sistema de Diseño:</strong> Aplicar los componentes y estilos visuales de Bord sobre el artefacto generado en Claude para afinar la presentación.
                </p>
              </div>

              <div class="flex items-start gap-3 p-3 rounded bg-slate-50 border border-slate-100">
                <span class="font-mono text-teal-700 font-bold shrink-0">[ ]</span>
                <p class="text-xs sm:text-sm text-slate-800">
                  <strong class="text-slate-900">Validar Scope Técnico con Backend/Tech:</strong> Consultar con el equipo de tecnología si los correos actuales en la base de datos ya tienen asignada una categoría o si deben agregar ese campo para la agrupación.
                </p>
              </div>

              <div class="flex items-start gap-3 p-3 rounded bg-slate-50 border border-slate-100">
                <span class="font-mono text-teal-700 font-bold shrink-0">[ ]</span>
                <p class="text-xs sm:text-sm text-slate-800">
                  <strong class="text-slate-900">Extraer Métricas Cuantitativas en Metabase / Amplitude:</strong> Consultar el volumen promedio de correos enviados por cliente para llevar datos concretos a la junta.
                </p>
              </div>

              <div class="flex items-start gap-3 p-3 rounded bg-slate-50 border border-slate-100">
                <span class="font-mono text-teal-700 font-bold shrink-0">[ ]</span>
                <p class="text-xs sm:text-sm text-slate-800">
                  <strong class="text-slate-900">Presentación en la Junta de Bord:</strong> Exponer la propuesta basada en el prototipo visual ("Antes vs. Después") ante los líderes de Comercial y CX.
                </p>
              </div>

              <div class="flex items-start gap-3 p-3 rounded bg-teal-50 border border-teal-200">
                <span class="font-mono text-teal-700 font-bold shrink-0">📅</span>
                <p class="text-xs sm:text-sm text-slate-800 font-medium">
                  <strong class="text-teal-900">Próxima Mentoría Agendada:</strong> Sesión de 2 horas agendada con Pablo para el martes de 2:00 PM a 4:00 PM (para trabajar sin el afán del tiempo).
                </p>
              </div>

            </div>
          </div>
        </section>

      </div>
    </div>
  </main>
</Layout>
