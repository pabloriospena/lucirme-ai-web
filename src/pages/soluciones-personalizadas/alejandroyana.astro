---
import Layout from "../../layouts/Layout.astro";
import { LINKS } from "../../lib/constants.js";
import RedesSociales from "../../components/RedesSociales.astro";

const calendlyUrl =
    LINKS.calendly_empresa || LINKS.calendly_taller || LINKS.calendly;
---

<Layout
    title="Diagnóstico & Plan de Acción Legal | Alejandro y Ana - LuciRMe AI"
>
    <!-- BARRA DE NAVEGACIÓN SUPERIOR -->
    <nav
        class="bg-white/90 backdrop-blur-md border-b border-gray-200 px-6 py-4 sticky top-0 z-50"
    >
        <div class="max-w-5xl mx-auto flex justify-between items-center">
            <a
                href="/"
                class="text-xs md:text-sm font-bold text-gray-500 hover:text-teal transition flex items-center gap-1"
            >
                ← Volver a LuciRMe AI
            </a>
            <a
                href="#proximos-pasos"
                class="inline-flex items-center justify-center font-bold bg-orange text-white rounded-xl py-2 px-4 hover:bg-orange/90 transition shadow-xs text-xs text-center cursor-pointer"
            >
                Próximos pasos
            </a>
        </div>
    </nav>

    <!-- HEADER / HERO SECTION -->
    <header
        class="bg-deep text-white py-16 md:py-20 px-6 relative overflow-hidden"
    >
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <!-- EYEBROW -->
            <div
                class="inline-flex items-center gap-2 bg-teal/15 text-teal text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 border border-teal/30"
            >
                <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span>
                Resumen de Sesión de Diagnóstico · Equipo Legal y de Marcas
            </div>

            <!-- SUBTÍTULO -->
            <p
                class="text-lg md:text-xl text-gray-300 mb-8 font-medium leading-relaxed max-w-3xl mx-auto"
            >
                <strong class="text-white">Alejandro y Ana:</strong> Este es el mapa
                de todo lo que detectamos en su sesión de diagnóstico, y el plan para
                construir la solución juntos, sin depender de IT ni de software corporativo
                costoso.
            </p>

            <!-- META INFO -->
            <div
                class="inline-flex flex-wrap justify-center items-center gap-4 bg-white/5 border border-white/10 rounded-xl px-5 py-2.5 text-xs md:text-sm text-gray-300"
            >
                <span class="flex items-center gap-1.5">
                    📅 <strong>Fecha:</strong> 29 de Julio 2026
                </span>
                <span class="text-gray-500 hidden sm:inline">•</span>
                <span class="flex items-center gap-1.5">
                    👤 <strong>Facilitador:</strong> Pablo Ríos (LuciRMe AI)
                </span>
            </div>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-12 space-y-16">
        <!-- SECCIÓN 1: DIAGNÓSTICO Y REALIDAD -->
        <section class="space-y-8">
            <div class="border-b border-gray-200 pb-4">
                <span
                    class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full"
                >
                    Sección 1 · Diagnóstico de Uso
                </span>
                <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
                    La Realidad: Lo que está funcionando y lo que les está
                    robando horas.
                </h2>
            </div>

            <div
                class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs leading-relaxed text-gray-700 text-base"
            >
                <p>
                    Revisamos en detalle cómo están utilizando la IA (Claude) en
                    su día a día para mantener a flote el portafolio de marcas,
                    el seguimiento y la creación del brief quincenal. Tienen un
                    uso excelente de la IA para análisis y auditoría, pero la
                    operatividad sigue dependiendo de memoria humana, archivos
                    sueltos y correos dispersos.
                </p>
            </div>

            <!-- BLOQUE: SUS VICTORIAS ACTUALES (EL MOTOR) -->
            <div
                class="bg-teal/5 border border-teal/20 rounded-2xl p-6 md:p-8 space-y-6"
            >
                <div class="flex items-center gap-3">
                    <span class="text-2xl">✅</span>
                    <h3 class="text-xl font-bold text-deep">
                        Sus Victorias Actuales <span
                            class="text-teal font-normal">(El Motor)</span
                        >
                    </h3>
                </div>

                <div class="grid md:grid-cols-3 gap-4">
                    <div
                        class="bg-white border border-teal/15 rounded-xl p-5 shadow-2xs"
                    >
                        <div
                            class="text-xs font-bold text-teal uppercase tracking-wider mb-2"
                        >
                            01. Brief Presidencial
                        </div>
                        <h4 class="font-bold text-deep mb-2 text-base">
                            Brief Presidencial (JPG)
                        </h4>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Lograron que Claude resuma la quincena en una imagen
                            lista para pegar en el correo de la presidencia.
                        </p>
                        <div
                            class="mt-3 pt-3 border-t border-gray-100 text-xs font-semibold text-teal"
                        >
                            ⚡ Impacto: ~3 horas ahorradas cada 15 días.
                        </div>
                    </div>

                    <div
                        class="bg-white border border-teal/15 rounded-xl p-5 shadow-2xs"
                    >
                        <div
                            class="text-xs font-bold text-teal uppercase tracking-wider mb-2"
                        >
                            02. Marcas
                        </div>
                        <h4 class="font-bold text-deep mb-2 text-base">
                            Matriz de Marcas
                        </h4>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Auditoría y organización del portafolio (pilas y
                            música) con fórmulas condicionales que alimentan la
                            toma de decisiones estratégicas.
                        </p>
                    </div>

                    <div
                        class="bg-white border border-teal/15 rounded-xl p-5 shadow-2xs"
                    >
                        <div
                            class="text-xs font-bold text-teal uppercase tracking-wider mb-2"
                        >
                            03. Litigios
                        </div>
                        <h4 class="font-bold text-deep mb-2 text-base">
                            Matriz de Litigios
                        </h4>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Cuadro de provisiones y cuotas mensuales que ya se
                            convirtió en la fuente de la verdad para el equipo
                            contable.
                        </p>
                    </div>
                </div>
            </div>

            <!-- BLOQUE: LAS FUGAS DE TIEMPO (EL FRENO DE MANO) -->
            <div
                class="bg-orange/5 border border-orange/20 rounded-2xl p-6 md:p-8 space-y-6"
            >
                <div class="flex items-center gap-3">
                    <span class="text-2xl">🚨</span>
                    <h3 class="text-xl font-bold text-deep">
                        Las Fugas de Tiempo <span
                            class="text-orange font-normal"
                            >(El Freno de Mano)</span
                        >
                    </h3>
                </div>

                <div class="grid md:grid-cols-2 gap-5">
                    <div
                        class="bg-white border border-orange/15 rounded-xl p-5 shadow-2xs"
                    >
                        <div class="flex items-center gap-2 mb-2">
                            <span
                                class="bg-orange/10 text-orange font-bold text-xs px-2.5 py-0.5 rounded-full"
                                >Fuga #1</span
                            >
                            <h4 class="font-bold text-deep text-base">
                                Excel como Gestor de Tareas
                            </h4>
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Están descargando, versionando y subiendo Excels
                            constantemente. El Excel es una tabla de datos, no
                            un gestor de procesos. Esto les quita agilidad,
                            trazabilidad y los obliga a trabajar sobre archivos
                            estáticos.
                        </p>
                    </div>

                    <div
                        class="bg-white border border-orange/15 rounded-xl p-5 shadow-2xs"
                    >
                        <div class="flex items-center gap-2 mb-2">
                            <span
                                class="bg-orange/10 text-orange font-bold text-xs px-2.5 py-0.5 rounded-full"
                                >Fuga #2</span
                            >
                            <h4 class="font-bold text-deep text-base">
                                La "Memoria Frágil" con la IA
                            </h4>
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Cada 15 días, para el brief presidencial, tienen que
                            volver a explicarle a Claude el contexto, los temas
                            y los avances. Eso es trabajo manual disfrazado de
                            automatización.
                        </p>
                    </div>

                    <div
                        class="bg-white border border-orange/15 rounded-xl p-5 shadow-2xs"
                    >
                        <div class="flex items-center gap-2 mb-2">
                            <span
                                class="bg-orange/10 text-orange font-bold text-xs px-2.5 py-0.5 rounded-full"
                                >Fuga #3</span
                            >
                            <h4 class="font-bold text-deep text-base">
                                El Agujero Negro de Contratos
                            </h4>
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Su equipo (3 abogados) recibe decenas de contratos
                            por correo sin mesa de servicios, sin SLAs claros y
                            sin repositorio central. Si un abogado no guarda el
                            correo en su carpeta local, el contrato desaparece.
                            No hay forma de saber quién tiene qué, ni cuánto
                            falta para entregar.
                        </p>
                    </div>

                    <div
                        class="bg-white border border-orange/15 rounded-xl p-5 shadow-2xs"
                    >
                        <div class="flex items-center gap-2 mb-2">
                            <span
                                class="bg-orange/10 text-orange font-bold text-xs px-2.5 py-0.5 rounded-full"
                                >Fuga #4</span
                            >
                            <h4 class="font-bold text-deep text-base">
                                El Bloqueo de IT
                            </h4>
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Las políticas de seguridad de la compañía (no
                            conectar IA a OneDrive/Microsoft) los tiene
                            limitados. La solución no es pelear con IT, es
                            construir su propio entorno de trabajo seguro,
                            centralizado y por fuera de los sistemas
                            corporativos bloqueados.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 2: RECOMENDACIONES (EL BLUEPRINT) -->
        <section class="space-y-8">
            <div class="border-b border-gray-200 pb-4">
                <span
                    class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full"
                >
                    Sección 2
                </span>
                <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
                    Vamos a construirlo juntos.
                </h2>
                <p class="text-gray-600 text-sm md:text-base mt-2">
                    Mi objetivo no es entregarles una automatización mágica que
                    solo yo sepa arreglar. Vamos a diseñar y construir los
                    flujos en sesiones de co-creación para que ustedes y su
                    equipo legal sean 100% autónomos, entiendan la lógica y
                    puedan mantener el sistema en el tiempo.
                </p>
            </div>

            <div class="space-y-6">
                <!-- BLUEPRINT ITEM 1 -->
                <div
                    class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs hover:border-teal transition-colors"
                >
                    <div class="flex items-start gap-4 mb-4">
                        <span
                            class="text-3xl shrink-0 p-2 bg-slate-100 rounded-xl"
                            >🛠️</span
                        >
                        <div>
                            <span
                                class="text-xs font-bold text-teal uppercase tracking-wider"
                                >Pilar 01</span
                            >
                            <h3 class="text-xl font-bold text-deep">
                                1. El Cerebro Operativo <span
                                    class="text-gray-500 font-normal"
                                    >(Adiós al Excel Operativo)</span
                                >
                            </h3>
                            <p class="text-sm font-semibold text-teal mt-1">
                                Vamos a migrar el seguimiento de tareas, estados
                                y vencimientos a Notion.
                            </p>
                        </div>
                    </div>

                    <div
                        class="bg-slate-50 border-l-4 border-teal p-4 rounded-r-xl text-sm text-gray-700"
                    >
                        <strong class="text-deep font-bold"
                            >Lo que haremos juntos:</strong
                        > Diseñaremos la base de datos central donde la IA podrá leer
                        y escribir en tiempo real. Ustedes actualizan el estado de
                        un litigio o una marca, y el sistema hace el resto, sin descargar
                        ni subir archivos.
                    </div>
                </div>

                <!-- BLUEPRINT ITEM 2 -->
                <div
                    class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs hover:border-teal transition-colors"
                >
                    <div class="flex items-start gap-4 mb-4">
                        <span
                            class="text-3xl shrink-0 p-2 bg-slate-100 rounded-xl"
                            >🛠️</span
                        >
                        <div>
                            <span
                                class="text-xs font-bold text-teal uppercase tracking-wider"
                                >Pilar 02</span
                            >
                            <h3 class="text-xl font-bold text-deep">
                                2. El Brief Presidencial <span
                                    class="text-gray-500 font-normal"
                                    >(Cero Repetición)</span
                                >
                            </h3>
                            <p class="text-sm font-semibold text-teal mt-1">
                                No van a volver a perder tiempo recordándole a
                                la IA qué hacer cada quincena.
                            </p>
                        </div>
                    </div>

                    <div
                        class="bg-slate-50 border-l-4 border-teal p-4 rounded-r-xl text-sm text-gray-700"
                    >
                        <strong class="text-deep font-bold"
                            >Lo que haremos juntos:</strong
                        > Conectaremos su tablero de tareas con un disparador automático.
                        Cuando ustedes marquen los avances en Notion, la IA los leerá,
                        generará el JPG con su prompt maestro inmutable y se los entregará
                        listo para el correo. Lo armaremos en vivo para que vean cómo
                        se conecta.
                    </div>
                </div>

                <!-- BLUEPRINT ITEM 3 -->
                <div
                    class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs hover:border-teal transition-colors"
                >
                    <div class="flex items-start gap-4 mb-4">
                        <span
                            class="text-3xl shrink-0 p-2 bg-slate-100 rounded-xl"
                            >🛠️</span
                        >
                        <div>
                            <span
                                class="text-xs font-bold text-teal uppercase tracking-wider"
                                >Pilar 03</span
                            >
                            <h3 class="text-xl font-bold text-deep">
                                3. Mesa de Servicios de Contratos <span
                                    class="text-gray-500 font-normal"
                                    >(El Gran Reto)</span
                                >
                            </h3>
                            <p class="text-sm font-semibold text-teal mt-1">
                                La compañía no necesita gastar millones en un
                                software corporativo de Contract Lifecycle
                                Management. Vamos a construir su propia Mesa de
                                Servicios con IA, paso a paso.
                            </p>
                        </div>
                    </div>

                    <div
                        class="bg-slate-50 border-l-4 border-teal p-4 rounded-r-xl space-y-2 text-sm text-gray-700"
                    >
                        <p class="font-bold text-deep">
                            Lo que haremos juntos:
                        </p>
                        <ul
                            class="list-disc list-inside space-y-1.5 text-gray-600 pl-1"
                        >
                            <li>
                                Definiremos el formulario de entrada para
                                centralizar las solicitudes que hoy llegan por
                                correos dispersos.
                            </li>
                            <li>
                                Armaremos la lógica de asignación a los 3
                                abogados y el cálculo automático de SLAs
                                (tiempos de entrega).
                            </li>
                            <li>
                                Estandarizaremos el repositorio y el dashboard
                                para que puedan decirle a la gerencia
                                exactamente cuántos contratos hay en revisión,
                                quién es el responsable y dónde está el cuello
                                de botella.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 3: PRÓXIMOS PASOS -->
        <section id="proximos-pasos" class="space-y-8">
            <div class="border-b border-gray-200 pb-4">
                <span
                    class="text-xs font-bold text-orange uppercase tracking-widest bg-orange/10 px-3 py-1 rounded-full"
                >
                    Sección 3 · Hoja de Ruta
                </span>
                <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
                    Cómo arrancamos la construcción.
                </h2>
                <p class="text-gray-600 text-sm md:text-base mt-2">
                    Para que esto no se quede en un diagnóstico, estos son los
                    pasos tangibles para las próximas semanas.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-6">
                <!-- PASO 1 -->
                <div
                    class="bg-white border border-gray-200 rounded-2xl p-6 shadow-xs relative flex flex-col justify-between"
                >
                    <div>
                        <div
                            class="w-10 h-10 rounded-xl bg-orange/10 text-orange font-black flex items-center justify-center text-lg mb-4"
                        >
                            1
                        </div>
                        <h3 class="font-bold text-deep text-base mb-1">
                            Mapeo de Campos
                        </h3>
                        <p class="text-xs font-bold text-orange mb-3">
                            Tarea para Alejandro y Ana
                        </p>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Definan la lista exacta de datos que necesitan
                            trackear de cada contrato (Ej: Tipo de contrato,
                            contraparte, SLA, abogado asignado, estado de
                            firma). Tráiganlo a nuestra próxima sesión.
                        </p>
                    </div>
                </div>

                <!-- PASO 2 -->
                <div
                    class="bg-white border-2 border-teal/40 rounded-2xl p-6 shadow-xs relative flex flex-col justify-between"
                >
                    <div
                        class="absolute -top-3 right-4 bg-teal text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full"
                    >
                        Siguiente Sesión
                    </div>
                    <div>
                        <div
                            class="w-10 h-10 rounded-xl bg-teal/10 text-teal font-black flex items-center justify-center text-lg mb-4"
                        >
                            2
                        </div>
                        <h3 class="font-bold text-deep text-base mb-1">
                            Taller de Diseño y Construcción
                        </h3>
                        <p class="text-xs font-bold text-teal mb-3">
                            Sesión en vivo
                        </p>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Nos reunimos para armar en vivo la estructura de la
                            Mesa de Servicios en Notion y configurar el prompt
                            maestro del Brief Presidencial. No es una charla
                            teórica, es una sesión de trabajo con las
                            herramientas abiertas.
                        </p>
                    </div>
                </div>

                <!-- PASO 3 -->
                <div
                    class="bg-white border border-gray-200 rounded-2xl p-6 shadow-xs relative flex flex-col justify-between"
                >
                    <div>
                        <div
                            class="w-10 h-10 rounded-xl bg-slate-100 text-deep font-black flex items-center justify-center text-lg mb-4"
                        >
                            3
                        </div>
                        <h3 class="font-bold text-deep text-base mb-1">
                            Ciclo de Autonomía
                        </h3>
                        <p class="text-xs font-bold text-gray-500 mb-3">
                            Implementación guiada
                        </p>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Conectamos los disparadores y hacemos las pruebas.
                            Yo los guío para que sean ustedes quienes configuren
                            las últimas millas, asegurando que su equipo legal
                            quede dueño del sistema y pueda ajustarlo sin
                            depender de mí.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- FOOTER / CTA FINAL -->
        <section
            class="bg-deep text-white rounded-3xl p-8 md:p-12 text-center relative overflow-hidden shadow-xl"
        >
            <div class="max-w-2xl mx-auto space-y-6 relative z-10">
                <h3 class="text-2xl md:text-3xl font-bold leading-snug">
                    La IA debe trabajar en silencio para que ustedes se enfoquen
                    en la estrategia legal.
                </h3>
                <p class="text-gray-300 text-sm md:text-base leading-relaxed">
                    Si el sistema no les devuelve tiempo y claridad, no sirve.
                    Vamos a construirlo para que su equipo escale sin fricción y
                    sin depender de IT.
                </p>

                <!-- FIRMA -->
            </div>
        </section>
    </main>
    <RedesSociales />
</Layout>
