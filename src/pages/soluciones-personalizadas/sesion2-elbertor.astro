---
import Layout from "../../layouts/Layout.astro";
import ActionHub from "../../components/ActionHub.astro";
import RedesSociales from "../../components/RedesSociales.astro";
import { LINKS } from "../../lib/constants.js";

const sesion1Url = "/soluciones-personalizadas/sesion1ciclo-elbertor";
const calendlyUrl =
  LINKS.calendly_empresa || LINKS.calendly_taller || LINKS.calendly;
---

<Layout
  title="Resumen de Mentoría Sesión 2: Optimización de IA, Creación Web y Gestión de Conocimiento | Elberto Rodríguez | LuciRMe AI"
>
  <!-- BARRA DE NAVEGACIÓN SUPERIOR -->
  <nav
    class="bg-white/90 backdrop-blur-md border-b border-gray-200 px-6 py-4 sticky top-0 z-50"
  >
    <div class="max-w-5xl mx-auto flex justify-between items-center gap-4">
      <a
        href={sesion1Url}
        class="text-xs md:text-sm font-bold text-gray-500 hover:text-teal transition flex items-center gap-1"
      >
        ← Volver a Sesión 1 de Elberto
      </a>
      <div class="flex items-center gap-2">
        <a
          href={sesion1Url}
          class="inline-flex items-center justify-center font-bold bg-teal text-white rounded-xl py-2 px-3.5 hover:bg-tealHover transition shadow-xs text-xs text-center cursor-pointer"
        >
          📖 Sesión 1
        </a>
        <a
          href={calendlyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center font-bold bg-orange text-white rounded-xl py-2 px-3.5 hover:bg-orange/90 transition shadow-xs text-xs text-center cursor-pointer"
        >
          Agendar Sesión
        </a>
      </div>
    </div>
  </nav>

  <!-- HEADER / HERO SECTION -->
  <header
    class="bg-deep text-white py-16 md:py-20 px-6 relative overflow-hidden"
  >
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <!-- EYEBROW -->
      <div
        class="inline-flex items-center gap-2 bg-teal/15 text-teal text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 border border-teal/30"
      >
        <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span>
        Mentoría Personalizada · Sesión 2 de 4
      </div>

      <!-- H1 -->
      <h1
        class="text-3xl md:text-5xl font-black mb-4 leading-tight tracking-tight text-white"
      >
        Optimización de IA, Creación Web y <span class="text-teal"
          >Gestión de Conocimiento</span
        >
      </h1>

      <!-- SUBTÍTULO -->
      <p
        class="text-base md:text-xl text-gray-300 font-medium max-w-2xl mx-auto mb-6 leading-relaxed"
      >
        Resumen de la segunda sesión de mentoría para <strong class="text-white"
          >Elberto Rodríguez</strong
        >
      </p>

      <!-- BOTÓN SESIÓN 1 -->
      <div class="mb-8">
        <a
          href={sesion1Url}
          class="inline-flex items-center gap-2 bg-gradient-to-r from-teal/20 via-white/10 to-orange/20 border border-teal/40 hover:border-teal/70 text-white font-extrabold text-xs md:text-sm px-5 py-2.5 rounded-2xl transition shadow-lg backdrop-blur-xs"
        >
          <span>👈</span>
          <span>Ver Resumen de la Sesión 1: IA Generativa & Prompts →</span>
        </a>
      </div>

      <!-- META BADGES -->
      <div
        class="inline-flex flex-wrap justify-center items-center gap-3 md:gap-4 bg-white/5 border border-white/10 rounded-2xl px-5 py-3 text-xs md:text-sm text-gray-300 max-w-3xl"
      >
        <span class="flex items-center gap-1.5">
          👤 <strong>Menteado:</strong> Elberto Rodríguez
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          🚀 <strong>Progreso:</strong> Sesión 2 de 4
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          👨‍🏫 <strong>Mentor:</strong> Pablo Ríos (LuciRMe AI)
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          📅 <strong>Fecha:</strong> 2 de septiembre de 2026
        </span>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-12 space-y-16">
    <!-- RESUMEN EJECUTIVO -->
    <section
      class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4"
    >
      <div class="flex items-center gap-3 border-b border-gray-100 pb-4">
        <div
          class="w-10 h-10 rounded-full bg-teal/15 text-teal flex items-center justify-center font-bold text-lg"
        >
          📌
        </div>
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-deep">
            Resumen Ejecutivo de la Sesión
          </h2>
          <p class="text-xs text-gray-500">
            Optimización de recursos, prototipado y gestión de conocimiento
          </p>
        </div>
      </div>
      <p class="text-base text-gray-700 leading-relaxed">
        En nuestro segundo encuentro, nos enfocamos en estrategias para
        maximizar el uso de las herramientas de inteligencia artificial,
        proteger la información de valor y estructurar aplicaciones web e
        investigaciones avanzadas sin incurrir en costos adicionales.
      </p>
    </section>

    <!-- SECCIÓN 1: AVANCES CLAVE Y RESULTADOS DE LA SESIÓN -->
    <section class="space-y-6">
      <div class="border-b border-gray-200 pb-4">
        <span
          class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full"
        >
          Sección 01
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          1. Avances Clave y Resultados de la Sesión
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- VALIDACIÓN DE PROMPTS -->
        <div
          class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-3 hover:border-teal/40 transition"
        >
          <div class="flex items-center gap-3">
            <span
              class="w-10 h-10 rounded-xl bg-teal/15 text-teal flex items-center justify-center text-xl font-bold shrink-0"
            >
              ✅
            </span>
            <h3 class="font-bold text-deep text-base">
              Validación de Prompts Estructurados
            </h3>
          </div>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Comprobamos la efectividad de la fórmula aprendida (<code
              >Rol + Objetivo + Contexto + Formato</code
            >). Presentaste a tu abogado y contador un documento complejo
            redactado con IA bajo esta estructura, obteniendo la validación y
            aprobación inmediata de ambos profesionales.
          </p>
        </div>

        <!-- OPTIMIZACIÓN DE CRÉDITOS -->
        <div
          class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-3 hover:border-teal/40 transition"
        >
          <div class="flex items-center gap-3">
            <span
              class="w-10 h-10 rounded-xl bg-orange/15 text-orange flex items-center justify-center text-xl font-bold shrink-0"
            >
              💡
            </span>
            <h3 class="font-bold text-deep text-base">
              Estrategia para Optimización de Créditos
            </h3>
          </div>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Analizamos cómo administrar los límites de las versiones gratuitas.
            Aprendiste a alternar entre modelos rápidos (como Gemini Flash) para
            consultas operativas y reservar los modelos avanzados para tareas de
            alta complejidad, además de desactivar funciones de razonamiento
            extendido cuando no son estrictamente necesarias.
          </p>
        </div>

        <!-- PROTOTIPADO WEB EN MINUTOS -->
        <div
          class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-3 hover:border-teal/40 transition"
        >
          <div class="flex items-center gap-3">
            <span
              class="w-10 h-10 rounded-xl bg-teal/15 text-teal flex items-center justify-center text-xl font-bold shrink-0"
            >
              🌐
            </span>
            <h3 class="font-bold text-deep text-base">
              Prototipado Web en Minutos
            </h3>
          </div>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Desarrollamos en vivo un prototipo funcional para un sitio de viajes
            llamado <strong>"Viajando por el mundo"</strong>, demostrando cómo
            transformar una idea en una aplicación web interactiva sin necesidad
            de escribir código.
          </p>
        </div>

        <!-- SEGUNDO CEREBRO -->
        <div
          class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-3 hover:border-teal/40 transition"
        >
          <div class="flex items-center gap-3">
            <span
              class="w-10 h-10 rounded-xl bg-deep/10 text-deep flex items-center justify-center text-xl font-bold shrink-0"
            >
              🧠
            </span>
            <h3 class="font-bold text-deep text-base">
              Construcción de un "Segundo Cerebro"
            </h3>
          </div>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Diseñamos un flujo de trabajo para centralizar las mejores
            respuestas de tus chats en un repositorio organizado dentro de
            Gemini Notebook (NotebookLM), evitando la pérdida de información
            técnica o legal útil.
          </p>
        </div>

        <!-- TÉCNICA DE RAMIFICACIÓN -->
        <div
          class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-3 hover:border-teal/40 transition"
        >
          <div class="flex items-center gap-3">
            <span
              class="w-10 h-10 rounded-xl bg-teal/15 text-teal flex items-center justify-center text-xl font-bold shrink-0"
            >
              🌿
            </span>
            <h3 class="font-bold text-deep text-base">
              Técnica de Ramificación de Chats
            </h3>
          </div>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Evaluamos cómo corregir desviaciones en las conversaciones con la
            IA. En lugar de contaminar el hilo o gastar créditos innecesarios,
            aprendiste a extraer una "rama" desde un punto limpio del historial
            para abrir un chat enfocado.
          </p>
        </div>

        <!-- DETRÁS DE CÁMARA -->
        <div
          class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-3 hover:border-teal/40 transition"
        >
          <div class="flex items-center gap-3">
            <span
              class="w-10 h-10 rounded-xl bg-orange/15 text-orange flex items-center justify-center text-xl font-bold shrink-0"
            >
              🎬
            </span>
            <h3 class="font-bold text-deep text-base">
              Detrás de Cámara del Proceso de Mentoría
            </h3>
          </div>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Te mostré mi flujo de preparación de materiales: grabo el audio de
            nuestras sesiones, genero la transcripción mediante herramientas de
            procesamiento de voz (CapCut), la cargo en un cuaderno de Notebook y
            solicito la estructuración de las guías y resúmenes que
            posteriormente te comparto.
          </p>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 2: PLAN DE ACCIÓN INMEDIATO -->
    <section class="space-y-6">
      <div class="border-b border-gray-200 pb-4">
        <span
          class="text-xs font-bold text-orange uppercase tracking-widest bg-orange/10 px-3 py-1 rounded-full"
        >
          Sección 02
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          2. Plan de Acción Inmediato: ¿Por dónde empezar?
        </h2>
        <p class="text-sm text-gray-600 mt-1">
          Para consolidar lo aprendido antes de nuestra tercera sesión, te
          recomiendo priorizar estos cuatro pasos:
        </p>
      </div>

      <div class="space-y-4">
        <div
          class="bg-white border border-gray-200 rounded-2xl p-5 md:p-6 shadow-xs flex items-start gap-4"
        >
          <span
            class="w-8 h-8 rounded-lg bg-teal text-white flex items-center justify-center font-black text-xs shrink-0 mt-0.5"
          >
            01
          </span>
          <div class="space-y-1">
            <h3 class="font-bold text-deep text-base">
              Combina ChatGPT y Gemini
            </h3>
            <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
              Utiliza ambas herramientas de forma complementaria en sus
              versiones gratuitas para resolver tus requerimientos diarios sin
              requerir suscripciones de pago por el momento.
            </p>
          </div>
        </div>

        <div
          class="bg-white border border-gray-200 rounded-2xl p-5 md:p-6 shadow-xs flex items-start gap-4"
        >
          <span
            class="w-8 h-8 rounded-lg bg-teal text-white flex items-center justify-center font-black text-xs shrink-0 mt-0.5"
          >
            02
          </span>
          <div class="space-y-1">
            <h3 class="font-bold text-deep text-base">
              Gestiona la potencia de los chats
            </h3>
            <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
              En ChatGPT, mantén desactivada la función de pensamiento profundo
              ("Think") para consultas simples. En Gemini, verifica mantener
              seleccionado el modelo Flash para tareas cotidianas y cambia al
              modelo Pro únicamente para análisis complejos.
            </p>
          </div>
        </div>

        <div
          class="bg-white border border-gray-200 rounded-2xl p-5 md:p-6 shadow-xs flex items-start gap-4"
        >
          <span
            class="w-8 h-8 rounded-lg bg-teal text-white flex items-center justify-center font-black text-xs shrink-0 mt-0.5"
          >
            03
          </span>
          <div class="space-y-1">
            <h3 class="font-bold text-deep text-base">
              Resguarda tus mejores respuestas
            </h3>
            <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
              Cada vez que obtengas una respuesta valiosa o un documento
              validado, pásalo a un archivo de texto y súbelo a tu cuaderno de
              Notebook para consolidar tu base de conocimiento interactiva.
            </p>
          </div>
        </div>

        <div
          class="bg-white border border-gray-200 rounded-2xl p-5 md:p-6 shadow-xs flex items-start gap-4"
        >
          <span
            class="w-8 h-8 rounded-lg bg-teal text-white flex items-center justify-center font-black text-xs shrink-0 mt-0.5"
          >
            04
          </span>
          <div class="space-y-1">
            <h3 class="font-bold text-deep text-base">
              Construye tu primer prototipo web independiente
            </h3>
            <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
              Aprovecha los créditos gratuitos diarios de la herramienta de
              generación web (Lovable.dev) para crear un sitio sencillo desde
              cero y ganar destreza en la redacción de instrucciones.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 3: GUÍA PASO A PASO DE LAS METODOLOGÍAS VISTAS -->
    <section class="space-y-8">
      <div class="border-b border-gray-200 pb-4">
        <span
          class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full"
        >
          Sección 03
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          3. Guía Paso a Paso de las Metodologías Vistas
        </h2>
      </div>

      <div class="space-y-6">
        <!-- A. CREACIÓN DE PÁGINAS Y APLICACIONES WEB (LOVABLE.DEV) -->
        <div
          class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-5"
        >
          <div class="flex items-center gap-3 border-b border-gray-100 pb-3">
            <span class="text-2xl">💻</span>
            <div>
              <span
                class="text-xs font-bold text-teal uppercase tracking-wider block"
                >Metodología A</span
              >
              <h3 class="text-xl font-bold text-deep">
                Creación de Páginas y Aplicaciones Web (Lovable.dev)
              </h3>
            </div>
          </div>

          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Para aprovechar al máximo los 5 créditos diarios gratuitos sin
            desperdiciar intentos, aplica este flujo:
          </p>

          <div class="space-y-3">
            <div
              class="bg-slate-50 border border-gray-200 p-4 rounded-xl space-y-1"
            >
              <span class="text-xs font-bold text-teal"
                >1. Diseño previo en chat</span
              >
              <p class="text-xs text-gray-700 leading-relaxed">
                Abre ChatGPT o Gemini y plantea tu idea (ej. un portal de
                gestión agrícola, portafolio o sitio de viajes).
              </p>
            </div>

            <div
              class="bg-slate-50 border border-gray-200 p-4 rounded-xl space-y-2"
            >
              <span class="text-xs font-bold text-teal"
                >2. Entrevista de estructuración</span
              >
              <p class="text-xs text-gray-700 leading-relaxed">
                Solicita a la IA:
              </p>
              <div
                class="bg-slate-900 text-teal-300 p-3 rounded-lg text-xs font-mono"
              >
                "¿Qué información necesitas para construir un prompt óptimo para
                Lovable.dev sobre este proyecto? Hazme las preguntas
                necesarias."
              </div>
            </div>

            <div
              class="bg-slate-50 border border-gray-200 p-4 rounded-xl space-y-1"
            >
              <span class="text-xs font-bold text-teal"
                >3. Responde los requerimientos clave</span
              >
              <p class="text-xs text-gray-700 leading-relaxed">
                Define roles (administrador vs. visitante), elementos visuales
                (mapas, botones, paneles), filtros necesarios y preferencia de
                estilos (minimalista, oscuro, corporativo).
              </p>
            </div>

            <div
              class="bg-slate-50 border border-gray-200 p-4 rounded-xl space-y-1"
            >
              <span class="text-xs font-bold text-teal"
                >4. Generación del prompt maestro</span
              >
              <p class="text-xs text-gray-700 leading-relaxed">
                Pide a la IA que consolide todas tus respuestas en un único
                prompt técnico estructurado.
              </p>
            </div>

            <div
              class="bg-slate-50 border border-gray-200 p-4 rounded-xl space-y-1"
            >
              <span class="text-xs font-bold text-teal"
                >5. Ejecución en Lovable.dev</span
              >
              <p class="text-xs text-gray-700 leading-relaxed">
                Ingresa a la plataforma, selecciona la opción de creación, pega
                el prompt maestro y procesa la solicitud (el renderizado toma
                entre 3 y 5 minutos).
              </p>
            </div>

            <div
              class="bg-slate-50 border border-gray-200 p-4 rounded-xl space-y-1"
            >
              <span class="text-xs font-bold text-teal"
                >6. Publicación y despliegue</span
              >
              <p class="text-xs text-gray-700 leading-relaxed">
                Haz clic en "Publish" para obtener tu enlace web público (ej. <code
                  >viajando-por-el-mundo.lovable.app</code
                >).
              </p>
            </div>

            <div
              class="bg-slate-50 border border-gray-200 p-4 rounded-xl space-y-1"
            >
              <span class="text-xs font-bold text-teal"
                >7. Iteración diaria</span
              >
              <p class="text-xs text-gray-700 leading-relaxed">
                Si agotas los 5 créditos del día, espera a su renovación en 24
                horas para continuar agregando secciones o funcionalidades al
                mismo proyecto.
              </p>
            </div>
          </div>
        </div>

        <!-- B. EJECUCIÓN DE BÚSQUEDAS PROFUNDAS (DEEP RESEARCH) -->
        <div
          class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4"
        >
          <div class="flex items-center gap-3 border-b border-gray-100 pb-3">
            <span class="text-2xl">🔍</span>
            <div>
              <span
                class="text-xs font-bold text-teal uppercase tracking-wider block"
                >Metodología B</span
              >
              <h3 class="text-xl font-bold text-deep">
                Ejecución de Búsquedas Profundas (Deep Research)
              </h3>
            </div>
          </div>

          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Para generar reportes e investigaciones técnicas exhaustivas basadas
            en datos reales de la web:
          </p>

          <ol
            class="space-y-3 text-xs md:text-sm text-gray-700 pl-5 list-decimal font-medium"
          >
            <li>
              <strong>Contextualización:</strong> Inicia una conversación previa sobre
              el tema técnico a investigar.
            </li>
            <li>
              <strong>Solicitud de prompt de investigación:</strong> Pide a la IA:
              <div
                class="bg-slate-900 text-teal-300 p-3 rounded-lg text-xs font-mono my-2"
              >
                "Escríbeme un prompt para ejecutar una investigación profunda
                (Deep Research) sobre el tema que estamos tratando."
              </div>
            </li>
            <li>
              <strong>Lanzamiento:</strong> Abre una nueva ventana, activa la opción
              de Deep Research e ingresa el prompt generado.
            </li>
            <li>
              <strong>Procesamiento y almacenamiento:</strong> La IA navegará de manera
              autónoma en internet y entregará un reporte estructurado en pocos minutos.
              Copia este informe y agrégalo como fuente en tu cuaderno de Notebook.
            </li>
          </ol>
        </div>

        <!-- C. RAMIFICACIÓN DE CONVERSACIONES (CHAT BRANCHING) -->
        <div
          class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4"
        >
          <div class="flex items-center gap-3 border-b border-gray-100 pb-3">
            <span class="text-2xl">🌿</span>
            <div>
              <span
                class="text-xs font-bold text-teal uppercase tracking-wider block"
                >Metodología C</span
              >
              <h3 class="text-xl font-bold text-deep">
                Ramificación de Conversaciones (Chat Branching)
              </h3>
            </div>
          </div>

          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Cuando un chat amplio comience a desviarse o a mezclar temas
            distintos:
          </p>

          <ul class="space-y-2 text-xs md:text-sm text-gray-700 pl-5 list-disc">
            <li>
              Ubica en el historial de la conversación el último mensaje que
              mantenía el hilo correcto.
            </li>
            <li>
              Haz clic en las opciones del mensaje (tres puntos) y selecciona <strong
                >"Crear rama"</strong
              > o <strong>"Editar y crear nuevo chat"</strong>.
            </li>
            <li>
              Se generará una conversación independiente que conserva todo el
              contexto previo limpio, eliminando distracciones para el modelo.
            </li>
          </ul>
        </div>
      </div>
    </section>

