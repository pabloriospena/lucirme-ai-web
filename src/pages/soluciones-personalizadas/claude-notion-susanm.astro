---
import Layout from "../../layouts/Layout.astro";
import ActionHub from "../../components/ActionHub.astro";
import RedesSociales from "../../components/RedesSociales.astro";
import { LINKS } from "../../lib/constants.js";

const calendlyUrl =
  LINKS.calendly_empresa || LINKS.calendly_taller || LINKS.calendly;
---

<Layout title="Cómo Conectar Notion con Claude | LuciRMe AI">
  <!-- BARRA DE NAVEGACIÓN SUPERIOR -->
  <nav
    class="bg-white/90 backdrop-blur-md border-b border-gray-200 px-6 py-4 sticky top-0 z-50"
  >
    <div class="max-w-5xl mx-auto flex justify-between items-center">
      <a
        href="/soluciones-personalizadas/sesion-susanm"
        class="text-xs md:text-sm font-bold text-gray-500 hover:text-teal transition flex items-center gap-1"
      >
        ← Volver a Diagnóstico Susan Sarmiento
      </a>
      <a
        href={calendlyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center font-bold bg-orange text-white rounded-xl py-2 px-4 hover:bg-orange/90 transition shadow-xs text-xs text-center cursor-pointer"
      >
        Agendar Sesión
      </a>
    </div>
  </nav>

  <!-- HEADER / HERO SECTION -->
  <header
    class="bg-deep text-white py-14 md:py-18 px-6 relative overflow-hidden"
  >
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <!-- EYEBROW -->
      <div
        class="inline-flex items-center gap-2 bg-teal/15 text-teal text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-5 border border-teal/30"
      >
        <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span>
        Guía Paso a Paso · Integración MCP
      </div>

      <!-- H1 -->
      <h1
        class="text-3xl md:text-5xl font-black mb-4 leading-tight tracking-tight text-white"
      >
        Cómo Conectar Notion con Claude
      </h1>

      <!-- SUBTÍTULO -->
      <p
        class="text-lg md:text-xl text-gray-300 font-medium max-w-2xl mx-auto mb-6"
      >
        Aprende a enlazar tus bases de datos de Notion con Claude sin programar
        una sola línea de código.
      </p>

      <!-- META BADGES -->
      <div
        class="inline-flex flex-wrap justify-center items-center gap-4 bg-white/5 border border-white/10 rounded-xl px-5 py-2.5 text-xs md:text-sm text-gray-300"
      >
        <span class="flex items-center gap-1.5">
          👤 <strong>Para:</strong> Susan Sarmiento
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          🛠️ <strong>Protocolo:</strong> MCP de Claude a Notion
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          ⚡ <strong>Tiempo:</strong> 20 minutos
        </span>
      </div>
    </div>
  </header>

  <!-- NAVEGACIÓN DE PARTES -->
  <div class="bg-slate-100 border-b border-gray-200 px-6 py-4">
    <div
      class="max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3"
    >
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-gray-500"
          >Estructura de la Guía:</span
        >
      </div>
      <div class="flex items-center gap-2 text-xs md:text-sm">
        <a
          href="#parte-1"
          class="font-bold bg-teal text-white px-3.5 py-1.5 rounded-lg shadow-2xs flex items-center gap-1.5"
        >
          <span>Part 1:</span> Conexión Básica
        </a>
        <a
          href="#parte-2"
          class="font-semibold bg-white text-gray-600 hover:text-teal border border-gray-300 px-3.5 py-1.5 rounded-lg transition flex items-center gap-1.5"
        >
          <span>Part 2:</span> Prompts y pruebas
        </a>
      </div>
    </div>
  </div>

  <main class="max-w-4xl mx-auto px-6 py-12 space-y-16">
    <!-- INTRODUCCIÓN -->
    <section
      class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4"
    >
      <p class="text-base md:text-lg text-gray-700 leading-relaxed">
        <strong>Protocolo de Contexto de Modelo (MCP)</strong> mediante un "servidor
        puente" externo o la función de conector personalizado.
      </p>
      <div
        class="p-4 bg-teal/10 border-l-4 border-teal rounded-r-xl text-teal-900 text-sm font-medium"
      >
        💡 <strong>Objetivo:</strong> A continuación se detalla el método más estable
        y seguro para lograr la sincronización bidireccional entre Notion y Claude
        sin programar una sola línea de código.
      </div>
    </section>

    <!-- ════════════════════ PARTE 1 ════════════════════ -->
    <section id="parte-1" class="space-y-10 scroll-mt-24">
      <!-- PARTE 1 HEADER -->
      <div
        class="border-b border-gray-200 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2"
      >
        <div>
          <span
            class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full"
          >
            PARTE 1 DE 2
          </span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-2">
            Conexión Básica mediante MCP
          </h2>
        </div>
        <span
          class="text-xs font-semibold text-gray-400 bg-slate-100 px-3 py-1 rounded-lg self-start sm:self-center"
        >
          Pasos 1 al 5
        </span>
      </div>

      <!-- REQUISITOS PREVIOS -->
      <div
        class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4"
      >
        <h3 class="text-xl font-bold text-deep flex items-center gap-2">
          <span>📋</span>
          <span>Requisitos Previos</span>
        </h3>
        <p class="text-sm text-gray-600">
          Asegúrate de contar con lo siguiente antes de empezar:
        </p>
        <div class="grid sm:grid-cols-3 gap-4 pt-2">
          <div
            class="bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-1"
          >
            <div class="font-bold text-deep text-sm flex items-center gap-1.5">
              <span class="text-teal font-black">1.</span> Notion
            </div>
            <p class="text-xs text-gray-600">
              Una cuenta de Notion con las bases de datos o páginas que deseas
              usar ya creadas.
            </p>
          </div>

          <div
            class="bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-1"
          >
            <div class="font-bold text-deep text-sm flex items-center gap-1.5">
              <span class="text-teal font-black">2.</span> Claude.ai
            </div>
            <p class="text-xs text-gray-600">Una cuenta activa en Claude.ai.</p>
          </div>

          <div
            class="bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-1"
          >
            <div class="font-bold text-deep text-sm flex items-center gap-1.5">
              <span class="text-teal font-black">3.</span> Conectar Notion y Claude
            </div>
            <p class="text-xs text-gray-600">
              En Claude, configuración, conexiones, explorar conexiones, buscar
              Notion
            </p>
          </div>
        </div>
      </div>

      <!-- PASO A PASO -->
      <div class="space-y-8">
        <!-- PASO 1 -->
        <article
          class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4"
        >
          <div
            class="flex items-center justify-between border-b border-gray-100 pb-3"
          >
            <h3
              class="text-lg md:text-xl font-bold text-deep flex items-center gap-2.5"
            >
              <span
                class="bg-teal text-white font-black text-sm w-7 h-7 rounded-lg flex items-center justify-center shrink-0"
                >1</span
              >
              <span>Vincular el conector en Claude.ai</span>
            </h3>
            <span
              class="text-xs font-bold text-teal bg-teal/10 px-2.5 py-1 rounded-full"
              >Interfaz Claude</span
            >
          </div>

          <p class="text-sm text-gray-700 leading-relaxed">
            Ahora introduciremos ese puente dentro de la interfaz de Claude.
          </p>

          <ol class="space-y-2.5 text-sm text-gray-700 pl-5 list-decimal">
            <li>
              Entra a tu cuenta en <a
                href="https://claude.ai"
                target="_blank"
                rel="noopener noreferrer"
                class="text-teal font-bold hover:underline">Claude.ai</a
              >.
            </li>
            <li>
              Haz clic en tu perfil (esquina inferior izquierda o superior
              derecha) y selecciona <strong>Ajustes</strong> (Settings) o <strong
                >Personalizar</strong
              > (Customize).
            </li>
            <li>Busca la pestaña <strong>Connectors</strong> (Conectores).</li>
            <li>
              Haz clic en el botón <strong>Add custom connector</strong> (Añadir conector
              personalizado).
            </li>
            <li>Haz clic en <strong>Guardar</strong> (Save).</li>
          </ol>
        </article>

        <!-- PASO 2 -->
        <article
          class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4"
        >
          <div
            class="flex items-center justify-between border-b border-gray-100 pb-3"
          >
            <h3
              class="text-lg md:text-xl font-bold text-deep flex items-center gap-2.5"
            >
              <span
                class="bg-teal text-white font-black text-sm w-7 h-7 rounded-lg flex items-center justify-center shrink-0"
                >5</span
              >
              <span>Confirmar que funciona</span>
            </h3>
            <span
              class="text-xs font-bold text-emerald-700 bg-emerald-100 px-2.5 py-1 rounded-full"
              >Prueba de Validación</span
            >
          </div>

          <p class="text-sm text-gray-700 leading-relaxed">
            Para validar que la comunicación es correcta:
          </p>

          <ol class="space-y-3 text-sm text-gray-700 pl-5 list-decimal">
            <li>Abre un <strong>chat totalmente nuevo</strong> en Claude.</li>
            <li>
              Asegúrate de que el icono de la herramienta (junto a la barra de
              escritura) esté en <strong>Auto</strong> o <strong
                >Siempre disponible</strong
              >.
            </li>
            <li>Escribe el siguiente mensaje de prueba:</li>
          </ol>

          <!-- PROMPT BOX -->
          <div
            class="bg-slate-50 border border-slate-200 rounded-xl overflow-hidden my-3"
          >
            <div
              class="flex justify-between items-center px-4 py-2.5 bg-slate-100 border-b border-slate-200"
            >
              <span
                class="text-[11px] font-bold text-slate-600 uppercase tracking-wider"
                >Prompt de prueba</span
              >
              <button
                onclick="copyText('prompt-prueba', this)"
                class="bg-teal hover:bg-tealHover text-white font-bold text-xs px-3 py-1 rounded-lg transition-all cursor-pointer"
              >
                Copiar Prompt
              </button>
            </div>
            <pre
              id="prompt-prueba"
              class="p-4 text-xs font-mono text-slate-800 leading-relaxed whitespace-pre-wrap select-all">¿Puedes listar el nombre de las bases de datos de Notion a las que tienes acceso actualmente?</pre>
          </div>

          <ol
            start="4"
            class="space-y-2.5 text-sm text-gray-700 pl-5 list-decimal"
          >
            <li>
              Si aparece una ventana flotante pidiendo permiso de ejecución (<em
                >Allow tool access</em
              >), haz clic en <strong>Permitir siempre</strong> (Always Allow).
            </li>
          </ol>

          <div
            class="p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-900 text-sm font-medium flex items-start gap-2 mt-4"
          >
            <span class="text-lg shrink-0">🎉</span>
            <div>
              <strong>¡Configuración exitosa!</strong> Si Claude te devuelve la lista
              exacta de tus páginas compartidas, la configuración ha sido un éxito.
              Ya puedes comenzar a enviarle prompts estructurados para leer, procesar
              y escribir datos en tiempo real.
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- ════════════════════ PARTE 2 PLACEHOLDER ════════════════════ -->
    <!-- ════════════════════ PARTE 2 ════════════════════ -->
    <section
      id="parte-2"
      class="space-y-10 scroll-mt-24 pt-8 border-t border-gray-200"
    >
      <!-- PARTE 2 HEADER -->
      <div
        class="border-b border-gray-200 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2"
      >
        <div>
          <span
            class="text-xs font-bold text-orange uppercase tracking-widest bg-orange/10 px-3 py-1 rounded-full"
          >
            PARTE 2 DE 2
          </span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-2">
            Cómo Ejecutar Tareas de Notion desde Claude
          </h2>
        </div>
        <span
          class="text-xs font-semibold text-gray-500 bg-slate-100 px-3 py-1 rounded-lg self-start sm:self-center"
        >
          Generación Automática de PRDs
        </span>
      </div>

      <div
        class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4"
      >
        <p class="text-base md:text-lg text-gray-700 leading-relaxed">
          Esta segunda parte te enseñará cómo pedirle a Claude que lea cualquier
          base de datos en tu Notion, procese la información y cree un <strong
            >Documento de Requisitos de Producto (PRD)</strong
          > o cualquier otra página de manera automática.
        </p>
      </div>

      <!-- PROMPT MAESTRO GENERAL -->
      <div
        class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4"
      >
        <div
          class="flex items-center justify-between border-b border-gray-100 pb-3"
        >
          <h3 class="text-xl font-bold text-deep flex items-center gap-2">
            <span>⚡</span>
            <span>El Prompt Maestro General (Plantilla)</span>
          </h3>
          <span
            class="text-xs font-bold text-orange bg-orange/10 px-2.5 py-1 rounded-full"
            >Plantilla Copiable</span
          >
        </div>

        <p class="text-sm text-gray-700 leading-relaxed">
          Copia el siguiente texto, <strong
            >reemplaza las variables entre corchetes <code>[ ]</code></strong
          > con los nombres reales de tus tablas o propiedades, y envíalo en un chat
          nuevo de Claude:
        </p>

        <!-- PROMPT BOX MAESTRO -->
        <div
          class="bg-slate-50 border border-slate-200 rounded-xl overflow-hidden my-4"
        >
          <div
            class="flex justify-between items-center px-4 py-2.5 bg-slate-100 border-b border-slate-200"
          >
            <span
              class="text-[11px] font-bold text-slate-600 uppercase tracking-wider"
              >Prompt Maestro: Lectura, PRD y Escritura en Notion</span
            >
            <button
              onclick="copyText('prompt-maestro', this)"
              class="bg-orange hover:bg-orange/90 text-white font-bold text-xs px-3 py-1 rounded-lg transition-all cursor-pointer"
            >
              Copiar Plantilla
            </button>
          </div>
          <pre
            id="prompt-maestro"
            class="p-4 text-xs font-mono text-slate-800 leading-relaxed whitespace-pre-wrap select-all max-h-96 overflow-y-auto">Por favor, realiza la siguiente tarea encadenando acciones en mi Notion:

1. ACCIÓN DE LECTURA:
Accede a mi base de datos llamada "[AÑADIR NOMBRE BASE DE DATOS DE ORIGEN]". Busca los elementos o la fila que coincida con la propiedad [AÑADIR NOMBRE DE PROPIEDAD] = "[AÑADIR VALOR O ESTADO A BUSCAR]" y extrae toda la información, descripción y notas que contenga.

2. ACCIÓN DE PROCESAMIENTO (TU ROL):
Actúa como un experto en Product Management y documentación de PRDs. Utilizando la información que acabas de leer en el paso anterior, genera un contenido del tipo PRD (Documento de Requisitos de Producto) completo y bien estructurado.

3. ACCIÓN DE ESCRITURA:
Ve a mi otra base de datos llamada "[AÑADIR NOMBRE BASE DE DATOS DE DESTINO]" y realiza la acción de Crear una nueva página con las siguientes especificaciones:
- Título de la página: "[AÑADIR TÍTULO DE LA PÁGINA]"
- Contenido del cuerpo: Inserta aquí todo el texto del PRD generado en el paso 2.
- Propiedad "[AÑADIR NOMBRE DE PROPIEDAD DE FECHA]": Asigna la fecha de hoy.
- Propiedad "[AÑADIR NOMBRE DE OTRA PROPIEDAD]": Cambiar o añadir el valor "[AÑADIR TEXTO O ESTADO NUEVO]".

Por favor, confirma en el chat cuando hayas completado el proceso y muéstrame la confirmación de la nueva página creada.</pre>
        </div>

        <div
          class="p-4 bg-slate-50 border-l-4 border-orange rounded-r-xl text-xs sm:text-sm text-gray-600 space-y-1"
        >
          <span class="font-bold text-deep uppercase tracking-wider text-xs"
            >💡 Recuerda personalizar:</span
          >
          <p>
            Reemplaza campos como <code
              >[AÑADIR NOMBRE BASE DE DATOS DE ORIGEN]</code
            > con el nombre exacto de tu tabla en Notion (ej. <em
              >Discovery Hub</em
            >) para que Claude ejecute la acción sin errores.
          </p>
        </div>
      </div>

      <!-- PRIMERA PRUEBA EN 3 PASOS -->
      <div class="space-y-6">
        <div class="border-b border-gray-200 pb-3">
          <h3 class="text-xl font-bold text-deep flex items-center gap-2">
            <span>🚀</span>
            <span>Cómo hacer tu primera prueba en 3 pasos</span>
          </h3>
          <p class="text-sm text-gray-600 mt-1">
            Si es la primera vez que usas el conector, sigue estos pasos para
            asegurarte de que todo funciona bien antes de lanzar prompts
            complejos:
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
          <!-- PASO 1 -->
          <div
            class="bg-white border border-gray-200 rounded-2xl p-6 shadow-xs space-y-3 flex flex-col justify-between"
          >
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <span
                  class="bg-teal text-white font-extrabold text-xs px-2.5 py-1 rounded-md"
                  >Paso 1</span
                >
                <h4 class="font-bold text-deep text-base">
                  Activar herramientas
                </h4>
              </div>
              <p class="text-xs text-gray-600 leading-relaxed">
                Abre un chat nuevo en Claude. En la esquina inferior (junto a la
                barra donde escribes), asegúrate de que el icono de herramientas
                esté configurado en <strong>Auto</strong> o <strong
                  >Siempre disponible</strong
                >.
              </p>
            </div>
            <div
              class="text-[11px] text-teal font-semibold bg-teal/5 p-2 rounded-lg border border-teal/10"
            >
              ⚙️ Conector activo
            </div>
          </div>

          <!-- PASO 2 -->
          <div
            class="bg-white border border-gray-200 rounded-2xl p-6 shadow-xs space-y-3 flex flex-col justify-between"
          >
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <span
                  class="bg-teal text-white font-extrabold text-xs px-2.5 py-1 rounded-md"
                  >Paso 2</span
                >
                <h4 class="font-bold text-deep text-base">Verificación</h4>
              </div>
              <p class="text-xs text-gray-600 leading-relaxed">
                Escribe este mensaje corto para verificar que Claude realmente
                "ve" tus tablas:
              </p>
              <div
                class="p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-slate-800"
              >
                "¿Puedes listar las bases de datos de Notion que tienes
                conectadas actualmente?"
              </div>
            </div>
            <div class="text-[11px] text-gray-500 italic">
              *Si pide permiso (Allow tool access), haz clic en "Permitir
              siempre".
            </div>
          </div>

          <!-- PASO 3 -->
          <div
            class="bg-white border border-gray-200 rounded-2xl p-6 shadow-xs space-y-3 flex flex-col justify-between"
          >
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <span
                  class="bg-orange text-white font-extrabold text-xs px-2.5 py-1 rounded-md"
                  >Paso 3</span
                >
                <h4 class="font-bold text-deep text-base">Ejecutar Prompt</h4>
              </div>
              <p class="text-xs text-gray-600 leading-relaxed">
                Pega la plantilla con tus variables rellenadas. Claude leerá,
                redactará el PRD y lo guardará directamente en tu Notion.
              </p>
            </div>
            <div
              class="text-[11px] text-emerald-700 font-bold bg-emerald-50 p-2 rounded-lg border border-emerald-200 text-center"
            >
              ✨ PRD generado en Notion
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ACTION HUB -->
    <div class="pt-8">
      <ActionHub />
    </div>
  </main>

  <!-- REDES SOCIALES -->
  <RedesSociales />

  <script is:inline>
    function copyText(elementId, btnElement) {
      const el = document.getElementById(elementId);
      if (!el) return;
      const text = el.innerText || el.textContent;
      navigator.clipboard
        .writeText(text)
        .then(() => {
          const originalText = btnElement.innerText;
          btnElement.innerText = "¡Copiado!";
          btnElement.classList.add("bg-emerald-600");
          setTimeout(() => {
            btnElement.innerText = originalText;
            btnElement.classList.remove("bg-emerald-600");
          }, 2000);
        })
        .catch((err) => {
          console.error("Error al copiar texto: ", err);
        });
    }
  </script>
</Layout>
