---
// src/pages/soluciones-personalizadas/sesion6-blancar.astro
import Layout from "../../layouts/Layout.astro";
import { LINKS } from "../../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const whatsappBlancar = `${whatsappBase}?text=${encodeURIComponent("Consulta Guia LuciRMe AI Blanca Rodríguez - Sesión 6 (Hands-On MCP & Reporte CPO)")}`;
---

<Layout
  title="Guía Práctica y Recordatorio del Hands-On: Sesión 6 | Blanca Rodríguez"
  description="Reporte ejecutivo CPO, conectores MCP Claude con Jira/Amplitude/Notion y métricas de uso SaaS para Blanca Rodríguez (Bord)."
  hideHeader={true}
  hideFooter={false}
>
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="h-16 max-w-7xl mx-auto px-6 flex items-center justify-between gap-4">
      <a class="flex flex-col group" href="#">
        <span class="text-base font-bold tracking-tight text-slate-900 group-hover:text-teal-700 transition-colors">LuciRMe AI · Sesiones 1-1</span>
        <span class="text-[11px] font-mono text-slate-500">Trabajamos sobre problemas reales de tu trabajo.</span>
      </a>

      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600">
        <a class="hover:text-slate-900 transition-colors" href="#objetivos">Objetivos</a>
        <a class="hover:text-slate-900 transition-colors" href="#paso-a-paso">Paso a Paso</a>
        <a class="hover:text-slate-900 transition-colors" href="#todos">Próximos Pasos (TODO)</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-teal-700 text-white text-xs font-semibold hover:bg-teal-800 transition-colors shadow-2xs cursor-pointer"
          href={whatsappBlancar}
          rel="noopener noreferrer"
          target="_blank"
        >
          <span class="material-symbols-outlined text-[17px]">chat</span>
          <span>Quiero revisar mi caso</span>
        </a>
      </div>
    </div>
  </header>

  <main class="w-full pt-16 bg-[#f8f9ff] min-h-[calc(100vh-16rem)]">
    <div class="flex flex-col w-full text-slate-900 antialiased pb-24">
      
      <!-- 1. HEADER Y METADATOS -->
      <section class="w-full bg-[#FBFBFA] border-b border-slate-200" id="resumen">
        <div class="max-w-6xl mx-auto px-6 lg:px-8 pt-8 pb-10">
          
          <div class="pt-8 pb-8">
            <h1 class="text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight max-w-5xl leading-tight">
              Guía Práctica y Recordatorio del Hands-On
            </h1>
            <p class="text-lg text-slate-600 mt-3 max-w-4xl">
              Sesión del 14 de Octubre de 2026 · Blanca Rodríguez (Product Manager · Life Cycle Squad en Bord)
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
            <div class="bg-white p-4 rounded border border-slate-200 shadow-2xs">
              <span class="text-[11px] text-slate-400 block uppercase tracking-wider mb-1 font-mono font-semibold">
                CLIENTE DIRECTO
              </span>
              <span class="text-base font-semibold text-slate-900 block">
                Blanca Rodríguez
              </span>
            </div>
            <div class="bg-white p-4 rounded border border-slate-200 shadow-2xs">
              <span class="text-[11px] text-slate-400 block uppercase tracking-wider mb-1 font-mono font-semibold">
                ROL / CONTEXTO
              </span>
              <span class="text-base font-semibold text-slate-900 block">
                Product Manager · Life Cycle Squad
              </span>
              <span class="text-xs text-slate-600 block mt-0.5">
                Plataforma Dash de Bord
              </span>
            </div>
            <div class="bg-white p-4 rounded border border-slate-200 shadow-2xs">
              <span class="text-[11px] text-slate-400 block uppercase tracking-wider mb-1 font-mono font-semibold">
                ENFOQUE DE LA SESIÓN
              </span>
              <span class="text-xs text-slate-900 block font-medium">
                Conectores MCP Claude + Reporte CPO + Métricas SaaS (Amplitude & Jira)
              </span>
            </div>
          </div>

          <div class="mt-4 bg-white p-6 rounded border border-slate-200 space-y-4 shadow-2xs">
            <div>
              <span class="text-xs text-teal-700 uppercase font-mono block mb-1 font-semibold">
                PROPÓSITO CENTRAL
              </span>
              <p class="text-sm text-slate-700 leading-relaxed">
                Estandarizar el reporte ejecutivo para la CPO, configurar flujos automatizados en tiempo real mediante conectores MCP de Claude, definir métricas de uso activo (Active Users/Companies) y generar un artefacto reutilizable en Notion con su respectivo Skill.
              </p>
            </div>
          </div>

        </div>
      </section>

      <!-- CONTENT CONTAINER -->
      <div class="max-w-6xl mx-auto px-6 lg:px-8 w-full pt-12 space-y-16" id="objetivos">
        
        <!-- SECCIÓN 01: OBJETIVOS -->
        <section class="space-y-8">
          <div class="border-b border-slate-200 pb-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-teal-700 font-bold tracking-widest uppercase font-mono">
                SECCIÓN 01
              </span>
              <span class="text-slate-300">|</span>
              <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">
                METAS Y ALCANCE
              </span>
            </div>
            <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 tracking-tight">
              1. Objetivos de la Sesión
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-mono font-bold text-sm">A</div>
              <h3 class="font-bold text-slate-900 text-base">Estandarizar el Reporte Ejecutivo para la CPO</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Elaborar urgentemente un reporte mensual/trimestral (Q3 2026) para la CPO y el C-Level sobre el estado del squad Life Cycle en la plataforma Dash de Bord.
              </p>
            </div>

            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-mono font-bold text-sm">B</div>
              <h3 class="font-bold text-slate-900 text-base">Construir un flujo automatizado en tiempo real</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Configurar y probar los conectores MCP de Claude con Jira, Notion, Amplitude y Metabase en una sesión de trabajo práctico con pantalla compartida.
              </p>
            </div>

            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-mono font-bold text-sm">C</div>
              <h3 class="font-bold text-slate-900 text-base">Definir Métricas de Uso Activo</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Mapear la frecuencia de uso (semanal, mensual y trimestral) y la adopción de las funcionalidades desplegadas en Q3 para evaluar la viabilidad de transformar el producto en un modelo SaaS B2B.
              </p>
            </div>

            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-mono font-bold text-sm">D</div>
              <h3 class="font-bold text-slate-900 text-base">Crear un Artefacto y Skill Reutilizable</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Generar un formato One Pager / Dashboard publicado en Notion y dejar guardada la instrucción (Skill) en Claude para automatizar este informe en meses posteriores.
              </p>
            </div>
          </div>
        </section>

        <!-- SECCIÓN 02: PASO A PASO -->
        <section class="space-y-8" id="paso-a-paso">
          <div class="border-b border-slate-200 pb-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-teal-700 font-bold tracking-widest uppercase font-mono">
                SECCIÓN 02
              </span>
              <span class="text-slate-300">|</span>
              <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">
                EJECUCIÓN PRÁCTICA
              </span>
            </div>
            <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 tracking-tight">
              2. Lo que Hicimos Paso a Paso (Hands-On)
            </h2>
          </div>

          <div class="space-y-6">
            
            <!-- Paso 1 -->
            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-1 rounded bg-teal-100 text-teal-800 font-mono text-xs font-bold">Paso 1</span>
                <h3 class="font-bold text-slate-900 text-base">Configuración del Stack y Limpieza de Datos</h3>
              </div>
              <ul class="list-disc list-inside space-y-2 text-xs sm:text-sm text-slate-700">
                <li><strong class="text-slate-900">Verificación de conectores MCP:</strong> Se validaron los accesos de lectura y escritura de Claude hacia Notion, Jira, Amplitude y Metabase.</li>
                <li><strong class="text-slate-900">Exclusión de entornos de prueba:</strong> Se instruyó a Claude para omitir en Metabase y Amplitude todas las organizaciones marcadas con el campo de prueba <code class="bg-slate-100 px-1 py-0.5 rounded text-teal-800">is_testing</code>.</li>
                <li><strong class="text-slate-900">Auditoría de eventos en Notion:</strong> Se utilizó la base de datos de eventos documentada en Notion como fuente de verdad para verificar que los eventos enviados desde la plataforma estuvieran llegando correctamente a Amplitude sin discrepancias.</li>
              </ul>
            </div>

            <!-- Paso 2 -->
            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-1 rounded bg-teal-100 text-teal-800 font-mono text-xs font-bold">Paso 2</span>
                <h3 class="font-bold text-slate-900 text-base">Reporte de Ejecución y Estado del Equipo en Jira (Life Cycle Squad)</h3>
              </div>
              <ul class="list-disc list-inside space-y-2 text-xs sm:text-sm text-slate-700">
                <li><strong class="text-slate-900">Delimitación del Squad:</strong> Se acotó la consulta exclusivamente a los miembros del equipo Life Cycle (<span class="text-slate-900 font-medium">Blanca Rodríguez, Sofía —PM Junior—, Juan Carlos —Tech Lead—, Juan González, Juan Arenas y Lourdes</span>), excluyendo tareas de otros equipos o desarrolladores externos como Daniel Mora o Juan Camilo.</li>
                <li><strong class="text-slate-900">Filtrado de Jerarquía y "Ruido":</strong> Se definió que la unidad de valor para el negocio es la Feature / Epic (que agrupa las historias/tareas), configurando el filtro para ignorar subtasks desvinculadas o tareas antiguas previas a 2025.</li>
                <li><strong class="text-slate-900">Cálculo de Progreso:</strong> Se extrajeron las features y epics entregadas a producción o completadas (Done) durante el Q3 2026 (julio-septiembre) y las primeras dos semanas de octubre, calculando el % de avance de las features en curso según la cantidad de tareas cerradas vs. abiertas.</li>
                <li><strong class="text-slate-900">Métricas de Mantenimiento y Soporte (Bugs / KTLO):</strong> Se extrajeron los issues de tipo bug y las épicas etiquetadas con KTLO (Keep The Lights On), clasificándolos por categoría: deuda técnica, errores y seguridad.</li>
              </ul>
            </div>

            <!-- Paso 3 -->
            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-1 rounded bg-teal-100 text-teal-800 font-mono text-xs font-bold">Paso 3</span>
                <h3 class="font-bold text-slate-900 text-base">Mapeo de Actividad y Adopción en Amplitude (Modelo SaaS vs. Transaccional)</h3>
              </div>
              <ul class="list-disc list-inside space-y-2 text-xs sm:text-sm text-slate-700">
                <li>
                  <strong class="text-slate-900">Definición de Bloques Transaccionales:</strong> Se dividió el uso de Dash en dos grandes flujos:
                  <ul class="list-circle list-inside pl-5 mt-1 space-y-1 text-slate-600">
                    <li><strong class="text-slate-800">Equipar:</strong> Compras, cotizaciones, entregas y onboarding.</li>
                    <li><strong class="text-slate-800">Gestionar:</strong> Recolecciones (offboarding), almacenamiento, reubicación (relocation) y servicios de IT (wiping/reset).</li>
                  </ul>
                </li>
                <li><strong class="text-slate-900">Medición de Frecuencia por Empresa (Company ID):</strong> Se consultó cuántas organizaciones registradas realizaron al menos 1 evento de éxito (Success View) a la semana (WAU), al mes (MAU) y al trimestre (Q3), permitiendo identificar a los clientes Champions (aquellos con más de 50 o 200 equipos) para futuros ejercicios de user research.</li>
                <li>
                  <strong class="text-slate-900">Auditoría de Adopción de Funcionalidades Desplegadas en Q3:</strong>
                  <ul class="list-circle list-inside pl-5 mt-1 space-y-1 text-slate-600">
                    <li><em>Historial de la herramienta (log de activos):</em> Medición de interacciones (total count) de usuarios y empresas al desplegar el historial de asignación de un equipo.</li>
                    <li><em>Etiquetas (Tags):</em> Medición de etiquetas creadas para filtrar empleados e inventario, y evaluación del incremento en el uso del módulo de inventario tras este lanzamiento.</li>
                    <li><em>Cargue masivo de herramientas externas:</em> Evaluación del uso de este módulo previo, identificado como una funcionalidad crítica para la migración e importación de datos en un modelo SaaS.</li>
                    <li><em>Notificaciones In-App:</em> Análisis de clics e identificación de las propiedades (properties) y categorías de notificación más utilizadas.</li>
                  </ul>
                </li>
              </ul>
            </div>

            <!-- Paso 4 -->
            <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-3">
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-1 rounded bg-teal-100 text-teal-800 font-mono text-xs font-bold">Paso 4</span>
                <h3 class="font-bold text-slate-900 text-base">Generación e Importación del Reporte One Pager en Notion</h3>
              </div>
              <ul class="list-disc list-inside space-y-2 text-xs sm:text-sm text-slate-700">
                <li><strong class="text-slate-900">Formato One Pager:</strong> Se le solicitó a Claude organizar la respuesta en tres secciones sintéticas: 1) Estado y Progreso de Features, 2) Asignaciones por Integrante, y 3) Métricas de Bugs y Soporte (KTLO).</li>
                <li><strong class="text-slate-900">Publicación Directa:</strong> Mediante el conector de Notion, Claude creó automáticamente una página bajo la sección "Reportes Q3 2026" del Life Cycle Squad, formateando las tablas como bases de datos limpias sin exceso de emojis.</li>
                <li><strong class="text-slate-900">Creación del Skill en Claude:</strong> Se guardó la lógica de la consulta como un Skill / Prompt estructurado, permitiendo que Blanca vuelva a generar este mismo reporte mensual ejecutando un comando o palabra clave.</li>
              </ul>
            </div>

          </div>
        </section>

        <!-- SECCIÓN 03: PENDIENTES Y PRÓXIMOS PASOS (TODO) -->
        <section class="space-y-8" id="todos">
          <div class="border-b border-slate-200 pb-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-teal-700 font-bold tracking-widest uppercase font-mono">
                SECCIÓN 03
              </span>
              <span class="text-slate-300">|</span>
              <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">
                PLAN DE ACCIÓN
              </span>
            </div>
            <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 tracking-tight">
              3. Pendientes y Próximos Pasos (TODO)
            </h2>
          </div>

          <div class="bg-white p-6 rounded border border-slate-200 shadow-2xs space-y-4">
            <div class="space-y-3">
              
              <div class="flex items-start gap-3 p-3 rounded bg-slate-50 border border-slate-100">
                <span class="font-mono text-teal-700 font-bold shrink-0">[ ]</span>
                <p class="text-xs sm:text-sm text-slate-800">
                  <strong class="text-slate-900">Revisión y envío del One Pager a la CPO:</strong> Validar el formato final publicado en Notion (o el reporte generado en Claude) y enviarlo a la CPO para la presentación del reporte mensual.
                </p>
              </div>

              <div class="flex items-start gap-3 p-3 rounded bg-slate-50 border border-slate-100">
                <span class="font-mono text-teal-700 font-bold shrink-0">[ ]</span>
                <p class="text-xs sm:text-sm text-slate-800">
                  <strong class="text-slate-900">Limpieza de Backlog en Jira:</strong> Reorganizar las tareas abiertas de Sofía (PM Junior) y reasignar los tickets que figuraban a nombre de exintegrantes del equipo (como Lourdes).
                </p>
              </div>

              <div class="flex items-start gap-3 p-3 rounded bg-slate-50 border border-slate-100">
                <span class="font-mono text-teal-700 font-bold shrink-0">[ ]</span>
                <p class="text-xs sm:text-sm text-slate-800">
                  <strong class="text-slate-900">Atar Tickets de Soporte a Features:</strong> Implementar la práctica en el equipo de vincular cada bug o ticket de triaje a su correspondiente Feature / Epic en Jira para poder medir automáticamente la calidad del desarrollo por módulo a futuro.
                </p>
              </div>

              <div class="flex items-start gap-3 p-3 rounded bg-slate-50 border border-slate-100">
                <span class="font-mono text-teal-700 font-bold shrink-0">[ ]</span>
                <p class="text-xs sm:text-sm text-slate-800">
                  <strong class="text-slate-900">Entrevistas con Clientes Champions:</strong> Programar sesiones de user research con las empresas identificadas en Amplitude que tienen alta frecuencia de gestión de activos (>50 o 200 equipos) para validar el módulo de roles y permisos B2B.
                </p>
              </div>

              <div class="flex items-start gap-3 p-3 rounded bg-teal-50 border border-teal-200">
                <span class="font-mono text-teal-700 font-bold shrink-0">📅</span>
                <p class="text-xs sm:text-sm text-slate-800 font-medium">
                  <strong class="text-teal-900">Próxima Sesión de Mentoría:</strong> Agendada con Pablo para el martes a las 3:00 PM (hora Colombia).
                </p>
              </div>

            </div>
          </div>
        </section>

      </div>
    </div>
  </main>
</Layout>
