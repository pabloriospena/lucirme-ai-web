---
import Layout from "../../layouts/Layout.astro";
import ActionHub from "../../components/ActionHub.astro";
import RedesSociales from "../../components/RedesSociales.astro";
import { LINKS } from "../../lib/constants.js";

const calendlyUrl =
  LINKS.calendly_empresa || LINKS.calendly_taller || LINKS.calendly;
---

<Layout title="Sesión de Diagnóstico: Melody Abele | LuciRMe AI">
  <!-- BARRA DE NAVEGACIÓN SUPERIOR -->
  <nav
    class="bg-white/90 backdrop-blur-md border-b border-gray-200 px-6 py-4 sticky top-0 z-50"
  >
    <div class="max-w-5xl mx-auto flex justify-between items-center">
      <a
        href="/"
        class="text-xs md:text-sm font-bold text-gray-500 hover:text-teal transition flex items-center gap-1"
      >
        ← Volver a LuciRMe AI
      </a>
      <a
        href={calendlyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center font-bold bg-orange text-white rounded-xl py-2 px-4 hover:bg-orange/90 transition shadow-xs text-xs text-center cursor-pointer"
      >
        Agendar Sesión
      </a>
    </div>
  </nav>

  <!-- HEADER / HERO SECTION -->
  <header
    class="bg-deep text-white py-16 md:py-20 px-6 relative overflow-hidden"
  >
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <!-- EYEBROW -->
      <div
        class="inline-flex items-center gap-2 bg-teal/15 text-teal text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 border border-teal/30"
      >
        <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span>
        Diagnóstico Personalizado · Productización de Servicios
      </div>

      <!-- H1 -->
      <h1
        class="text-3xl md:text-5xl font-black mb-4 leading-tight tracking-tight text-white"
      >
        Sesión de Diagnóstico: <span class="text-teal">Melody Abele</span>
      </h1>

      <!-- SUBTÍTULO -->
      <p
        class="text-lg md:text-xl text-gray-300 font-medium max-w-2xl mx-auto mb-8"
      >
        Fundadora de Melfa · Consultoría en Atención al Cliente · Agosto 2026
      </p>

      <!-- META BADGES -->
      <div
        class="inline-flex flex-wrap justify-center items-center gap-4 bg-white/5 border border-white/10 rounded-xl px-5 py-2.5 text-xs md:text-sm text-gray-300"
      >
        <span class="flex items-center gap-1.5">
          👤 <strong>Cliente:</strong> Melody Abele
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          🐾 <strong>Proyecto:</strong> Melfa (Atención al Cliente)
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          💡 <strong>Solución:</strong> MVP de Diagnósticos Asistidos por IA
        </span>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-12 space-y-16">
    <!-- SECCIÓN 1: RESUMEN EJECUTIVO -->
    <section class="space-y-6">
      <div class="border-b border-gray-200 pb-4">
        <span
          class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full"
        >
          Resumen Ejecutivo
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          Contexto y Diagnóstico Inicial
        </h2>
      </div>

      <div
        class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4 leading-relaxed text-gray-700 text-base"
      >
        <p>
          Melody viene del mundo de la atención pura: tuvo una guardería canina
          donde el seguimiento diario, la empatía y la tranquilidad de los
          dueños eran su mayor valor (fotos diarias, comunicación constante,
          trabajo de lunes a lunes, feliz). Pero por temas personales cerró la
          guardería y está en transición hacia <strong>Melfa</strong>, su nuevo
          proyecto de consultoría enfocado en analizar y mejorar la atención al
          cliente de empresas.
        </p>

        <div
          class="p-5 bg-slate-50 border-l-4 border-orange rounded-r-xl my-4 space-y-2"
        >
          <h3
            class="font-bold text-deep text-sm uppercase tracking-wide flex items-center gap-2"
          >
            <span>⚠️</span>
            <span>El problema concreto:</span>
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Melody tiene la sensibilidad de UX, el ojo analítico y el
            conocimiento operativo real de lo que significa un canal de soporte
            saturado (200+ WhatsApp sin contestar, NPS bajos, agentes
            desbordados, tiempos de respuesta que se miden pero no se actúan).
            Sin embargo, hoy se siente abrumada, estresada y sin un producto
            claro que pueda cobrar. Ha consumido cursos de IA, le gustaron los
            tips, pero siente que está en un "revient": sabe que puede hacer
            más, pero no tiene el puente entre lo que sabe y algo monetizable.
          </p>
        </div>

        <p>
          <strong class="text-deep">Lo que identificamos:</strong> Melody no necesita
          aprender a programar, ni montar un SaaS, ni tener una web perfecta. Necesita
          <strong class="text-teal">productizar su conocimiento</strong> usando IA
          como su analista de datos. Identificamos que puede ofrecer <strong
            >Diagnósticos de Salud de Soporte</strong
          > a empresas: recibir datos desordenados de quejas y soporte, procesarlos
          con NotebookLM, y entregar un reporte ejecutivo en HTML en menos de 15 minutos
          por cliente.
        </p>
      </div>
    </section>

    <!-- SECCIÓN 2: OBJETIVOS DE LA SESIÓN -->
    <section class="space-y-6">
      <div class="border-b border-gray-200 pb-4">
        <span
          class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full"
        >
          Objetivos de la Sesión
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          Hallazgos y Estado de los Objetivos
        </h2>
      </div>

      <!-- TABLA DE OBJETIVOS -->
      <div
        class="overflow-x-auto bg-white border border-gray-200 rounded-2xl shadow-xs"
      >
        <table class="w-full text-left border-collapse">
          <thead>
            <tr
              class="bg-slate-50 border-b border-gray-200 text-xs uppercase tracking-wider text-gray-500"
            >
              <th class="p-4 font-bold w-12 text-center">#</th>
              <th class="p-4 font-bold">Objetivo</th>
              <th class="p-4 font-bold text-right">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-bold text-gray-400 text-center">1</td>
              <td class="p-4 font-semibold text-deep"
                >Entender el origen de Melfa y el bloqueo emocional/operativo
                actual</td
              >
              <td class="p-4 text-right"
                ><span
                  class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 font-bold px-2.5 py-1 rounded-full text-xs border border-emerald-200"
                  >✅ Cumplido</span
                ></td
              >
            </tr>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-bold text-gray-400 text-center">2</td>
              <td class="p-4 font-semibold text-deep"
                >Identificar sus habilidades reales (UX, análisis, empatía,
                seguimiento)</td
              >
              <td class="p-4 text-right"
                ><span
                  class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 font-bold px-2.5 py-1 rounded-full text-xs border border-emerald-200"
                  >✅ Cumplido</span
                ></td
              >
            </tr>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-bold text-gray-400 text-center">3</td>
              <td class="p-4 font-semibold text-deep"
                >Descartar la trampa de "necesito un equipo y mucha visibilidad
                para empezar"</td
              >
              <td class="p-4 text-right"
                ><span
                  class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 font-bold px-2.5 py-1 rounded-full text-xs border border-emerald-200"
                  >✅ Cumplido</span
                ></td
              >
            </tr>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-bold text-gray-400 text-center">4</td>
              <td class="p-4 font-semibold text-deep"
                >Diseñar un MVP de servicio productizado usando NotebookLM +
                HTML</td
              >
              <td class="p-4 text-right"
                ><span
                  class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 font-bold px-2.5 py-1 rounded-full text-xs border border-emerald-200"
                  >✅ Cumplido</span
                ></td
              >
            </tr>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-bold text-gray-400 text-center">5</td>
              <td class="p-4 font-semibold text-deep"
                >Definir la escalera de monetización inmediata</td
              >
              <td class="p-4 text-right"
                ><span
                  class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 font-bold px-2.5 py-1 rounded-full text-xs border border-emerald-200"
                  >✅ Cumplido</span
                ></td
              >
            </tr>
          </tbody>
        </table>
      </div>

      <!-- DIAGNÓSTICO CLAVE CALLOUT -->
      <div
        class="bg-gradient-to-r from-teal/10 via-slate-50 to-orange/10 border border-teal/20 rounded-2xl p-6 md:p-8 space-y-3"
      >
        <h3
          class="font-extrabold text-deep text-base uppercase tracking-wider flex items-center gap-2"
        >
          <span>🧠</span>
          <span>Diagnóstico Clave</span>
        </h3>
        <p class="text-gray-700 text-sm md:text-base leading-relaxed">
          Melody tiene oro en las manos: sabe leer el dolor de un cliente,
          entiende la operatividad de un canal de soporte y tiene la empatía
          para entregar una buena experiencia. Su cuello de botella es creer que
          necesita programar, tener equipo o mucha visibilidad antes de cobrar.
          Lo que necesita es un <strong
            >flujo simple de análisis asistido</strong
          > donde la IA ordene datos desordenados y ella ponga la mirada estratégica
          para entregar el diagnóstico.
        </p>
      </div>
    </section>

    <!-- SECCIÓN 3: COMPROMISOS Y PASOS SIGUIENTES -->
    <section class="space-y-8">
      <div class="border-b border-gray-200 pb-4">
        <span
          class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full"
        >
          Plan de Trabajo
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          Compromisos y Flujo Diseñado
        </h2>
      </div>

      <!-- LO QUE MELODY TRAE -->
      <div
        class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4"
      >
        <h3 class="text-lg font-bold text-deep flex items-center gap-2">
          <span>🧰</span>
          <span>Lo que Melody trae a la mesa:</span>
        </h3>
        <ul class="grid sm:grid-cols-2 gap-3 text-sm text-gray-700">
          <li
            class="flex items-start gap-2.5 p-3 bg-slate-50 rounded-xl border border-slate-100"
          >
            <span class="text-teal font-bold shrink-0">✓</span>
            <span
              ><strong>Experiencia real en atención al cliente</strong> (sabe qué
              duele cuando hay 200 WhatsApp sin contestar desde hace 3 días).</span
            >
          </li>
          <li
            class="flex items-start gap-2.5 p-3 bg-slate-50 rounded-xl border border-slate-100"
          >
            <span class="text-teal font-bold shrink-0">✓</span>
            <span
              ><strong>Conocimiento de métricas operativas:</strong> tiempos de respuesta,
              NPS, motivos de consulta, CRM.</span
            >
          </li>
          <li
            class="flex items-start gap-2.5 p-3 bg-slate-50 rounded-xl border border-slate-100"
          >
            <span class="text-teal font-bold shrink-0">✓</span>
            <span
              ><strong>Datos de prueba</strong> (o capacidad para generar datos "dummy")
              de quejas y soporte.</span
            >
          </li>
          <li
            class="flex items-start gap-2.5 p-3 bg-slate-50 rounded-xl border border-slate-100"
          >
            <span class="text-teal font-bold shrink-0">✓</span>
            <span
              ><strong>Cuenta de NotebookLM</strong> y disposición para construir.</span
            >
          </li>
          <li
            class="flex items-start gap-2.5 p-3 bg-slate-50 rounded-xl border border-slate-100 sm:col-span-2"
          >
            <span class="text-teal font-bold shrink-0">✓</span>
            <span
              ><strong>Programación: cero.</strong> Y está bien, no la necesita.</span
            >
          </li>
        </ul>
      </div>

      <!-- EL FLUJO QUE DISEÑAMOS JUNTOS -->
      <div class="space-y-4">
        <h3 class="text-xl font-extrabold text-deep flex items-center gap-2">
          <span>⚙️</span>
          <span>El flujo que diseñamos juntos:</span>
        </h3>

        <!-- PASO 1 -->
        <div
          class="bg-white border-l-4 border-teal border border-gray-200 rounded-2xl p-6 shadow-xs space-y-2"
        >
          <div class="flex items-center justify-between">
            <h4
              class="font-extrabold text-teal text-base uppercase tracking-wider"
            >
              Paso 1 — El Gancho (Reunión de 30 min con prospecto)
            </h4>
            <span
              class="text-xs bg-teal/10 text-teal font-bold px-2.5 py-1 rounded-full"
              >Fase 1</span
            >
          </div>
          <ul class="text-sm text-gray-700 space-y-1 pl-4 list-disc">
            <li>Melody se reúne con un gerente o líder de soporte.</li>
            <li>
              Pregunta: ¿Qué canales tienen? ¿Cuánto se demoran respondiendo?
              ¿Qué miden? ¿Qué les duele?
            </li>
            <li>
              Les pide 2-3 tablas de datos (quejas, soporte, encuestas).
              Desordenadas, reales.
            </li>
          </ul>
        </div>

        <!-- PASO 2 -->
        <div
          class="bg-white border-l-4 border-orange border border-gray-200 rounded-2xl p-6 shadow-xs space-y-2"
        >
          <div class="flex items-center justify-between">
            <h4
              class="font-extrabold text-orange text-base uppercase tracking-wider"
            >
              Paso 2 — El Motor de Análisis (NotebookLM)
            </h4>
            <span
              class="text-xs bg-orange/10 text-orange font-bold px-2.5 py-1 rounded-full"
              >Fase 2</span
            >
          </div>
          <ul class="text-sm text-gray-700 space-y-1 pl-4 list-disc">
            <li>Melody sube las tablas a NotebookLM como fuentes.</li>
            <li>
              Usa un prompt maestro de análisis que siempre devuelve la misma
              estructura: Resumen Ejecutivo, Indicadores Clave, Gráficos,
              Insights y Próximos Pasos.
            </li>
            <li>
              La IA hace el trabajo pesado de ordenar. Melody pone el criterio.
            </li>
          </ul>
        </div>

        <!-- PASO 3 -->
        <div
          class="bg-white border-l-4 border-blue-500 border border-gray-200 rounded-2xl p-6 shadow-xs space-y-2"
        >
          <div class="flex items-center justify-between">
            <h4
              class="font-extrabold text-blue-600 text-base uppercase tracking-wider"
            >
              Paso 3 — La Entrega Premium (HTML en ~10 minutos)
            </h4>
            <span
              class="text-xs bg-blue-50 text-blue-600 font-bold px-2.5 py-1 rounded-full"
              >Fase 3</span
            >
          </div>
          <ul class="text-sm text-gray-700 space-y-1 pl-4 list-disc">
            <li>
              Con el análisis listo, Melody le pide a la IA que genere un HTML
              con el diagnóstico.
            </li>
            <li>
              Lo descarga, lo abre en el navegador, y tiene un reporte visual
              profesional.
            </li>
            <li>
              Sin programar una sola línea. Sin pedir ayuda a un desarrollador.
            </li>
          </ul>
        </div>
      </div>

      <!-- LA ESCALERA DE MONETIZACIÓN -->
      <div
        class="bg-gradient-to-br from-slate-900 via-deep to-slate-800 text-white rounded-2xl p-6 md:p-8 space-y-6 shadow-lg border border-teal/30"
      >
        <div class="border-b border-white/10 pb-3">
          <span class="text-xs font-bold text-teal uppercase tracking-widest"
            >Modelo de Negocio</span
          >
          <h3 class="text-xl md:text-2xl font-extrabold text-white mt-1">
            La Escalera de Monetización Acordada
          </h3>
        </div>

        <div class="grid md:grid-cols-3 gap-4">
          <div
            class="bg-white/5 border border-white/10 rounded-xl p-5 space-y-2 relative"
          >
            <span
              class="text-xs font-extrabold text-teal uppercase tracking-wider"
              >Nivel 1</span
            >
            <h4 class="text-base font-bold text-white">El Gancho</h4>
            <p class="text-xs text-gray-300">
              Reunión de 30 min + diagnóstico visual básico.
            </p>
            <div class="pt-2 text-lg font-black text-emerald-400">Gratis</div>
          </div>

          <div
            class="bg-white/10 border border-teal/40 rounded-xl p-5 space-y-2 relative shadow-sm"
          >
            <span
              class="text-xs font-extrabold text-orange uppercase tracking-wider"
              >Nivel 2</span
            >
            <h4 class="text-base font-bold text-white">
              El Producto de Entrada
            </h4>
            <p class="text-xs text-gray-300">
              Informe avanzado con cruces de datos, tendencias y
              recomendaciones.
            </p>
            <div class="pt-2 text-lg font-black text-orange">$10 USD</div>
          </div>

          <div
            class="bg-white/5 border border-white/10 rounded-xl p-5 space-y-2 relative"
          >
            <span
              class="text-xs font-extrabold text-teal uppercase tracking-wider"
              >Nivel 3</span
            >
            <h4 class="text-base font-bold text-white">El Servicio Premium</h4>
            <p class="text-xs text-gray-300">
              Asesoría personalizada, sesiones de trabajo conjunto.
            </p>
            <div class="pt-2 text-lg font-black text-teal-300">
              $400 USD <span class="text-xs font-normal text-gray-400"
                >(por 3 sesiones)</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 4: LO QUE NO VAMOS A HACER -->
    <section class="space-y-6">
      <div class="border-b border-gray-200 pb-4">
        <span
          class="text-xs font-bold text-orange uppercase tracking-widest bg-orange/10 px-3 py-1 rounded-full"
        >
          Límites Claros
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          Lo que NO vamos a hacer
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div
          class="bg-white border border-gray-200 rounded-2xl p-5 shadow-xs space-y-2"
        >
          <div class="flex items-center gap-2 text-red-500 font-bold text-base">
            <span>🚫</span>
            <span>No vamos a construir un SaaS ni una app</span>
          </div>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
            Primero validamos que alguien paga por el diagnóstico.
          </p>
        </div>

        <div
          class="bg-white border border-gray-200 rounded-2xl p-5 shadow-xs space-y-2"
        >
          <div class="flex items-center gap-2 text-red-500 font-bold text-base">
            <span>🚫</span>
            <span>No vamos a esperar la web perfecta</span>
          </div>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
            Melfa empieza con un formulario, un correo y un HTML. La web se hace
            después, cuando haya clientes reales.
          </p>
        </div>

        <div
          class="bg-white border border-gray-200 rounded-2xl p-5 shadow-xs space-y-2"
        >
          <div class="flex items-center gap-2 text-red-500 font-bold text-base">
            <span>🚫</span>
            <span>No vamos a esperar "visibilidad" ni equipo</span>
          </div>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
            El primer cliente puede ser esta semana.
          </p>
        </div>

        <div
          class="bg-white border border-gray-200 rounded-2xl p-5 shadow-xs space-y-2"
        >
          <div class="flex items-center gap-2 text-red-500 font-bold text-base">
            <span>🚫</span>
            <span>No vamos a programar</span>
          </div>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
            Cero código. NotebookLM + prompt + HTML generado por IA. Punto.
          </p>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 5: PRÓXIMOS PASOS INMEDIATOS -->
    <section class="space-y-6">
      <div class="border-b border-gray-200 pb-4">
        <span
          class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full"
        >
          Hoja de Ruta
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          Próximos Pasos Inmediatos
        </h2>
      </div>

      <div
        class="overflow-x-auto bg-white border border-gray-200 rounded-2xl shadow-xs"
      >
        <table class="w-full text-left border-collapse">
          <thead>
            <tr
              class="bg-slate-50 border-b border-gray-200 text-xs uppercase tracking-wider text-gray-500"
            >
              <th class="p-4 font-bold">Acción</th>
              <th class="p-4 font-bold text-right">Responsable</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-semibold text-deep"
                >Generar 1 set de datos "dummy" (ficticios) de quejas y soporte:
                3 tablas, ~50 registros cada una</td
              >
              <td class="p-4 text-right font-bold text-teal">Melody</td>
            </tr>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-semibold text-deep"
                >Configurar NotebookLM con las fuentes y el prompt de análisis</td
              >
              <td class="p-4 text-right font-bold text-teal">Melody</td>
            </tr>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="p-4 font-semibold text-deep"
                >Generar el primer HTML de diagnóstico con ese prompt</td
              >
              <td class="p-4 text-right font-bold text-teal">Melody</td>
