---
import Layout from "../../layouts/Layout.astro";
import { LINKS } from "../../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
---

<Layout
  title="Sesión Karina Zamalloa | LuciRMe AI"
  description="Sesión personalizada para Karina Zamalloa."
  hideHeader={true}
  hideFooter={true}
>
  <!-- HEADER REPLICADO DE PROFESIONALES -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="h-16 max-w-7xl mx-auto px-6 flex items-center justify-between gap-4">
      <a class="flex flex-col group" href="/">
        <span class="text-base font-bold tracking-tight text-slate-900 group-hover:text-teal-700 transition-colors">LuciRMe AI · Karina Zamalloa</span>
        <span class="text-[11px] font-mono text-slate-500">Sesión de trabajo personalizada.</span>
      </a>

      <div class="flex items-center gap-3">
        <a
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-teal-700 text-white text-xs font-semibold hover:bg-teal-800 transition-colors shadow-2xs cursor-pointer"
          href={`${whatsappBase}?text=${encodeURIComponent("Hola Pablo, tengo una duda sobre la sesión personalizada.")}`}
          rel="noopener noreferrer"
          target="_blank"
        >
          <span class="material-symbols-outlined text-[17px]">chat</span>
          <span>Hablemos por WhatsApp</span>
        </a>
      </div>
    </div>
  </header>

  <main class="w-full bg-[#F8FAFC] min-h-[calc(100vh-16rem)] py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-4xl font-extrabold text-slate-900 mb-8 tracking-tight">Sesión Personalizada</h1>
      
      <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
        <h2 class="text-2xl font-bold mb-4 text-slate-900">Bienvenida Karina</h2>
        <p class="text-slate-600 mb-6 leading-relaxed">
          Esta es tu página de sesión personalizada. Aquí encontrarás los recursos y seguimiento de nuestra colaboración.
        </p>
        
        <div class="flex items-center gap-4">
            <a href="/cafe-karinaz" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-teal-700 text-white font-semibold text-sm hover:bg-teal-800 transition-colors shadow-sm">
                Ir a Café Karinaz
            </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
