---
import RutaClaudeLayout from "../../layouts/RutaClaudeLayout.astro";
import PasoCard from "../../components/ruta-claude/PasoCard.astro";
import EmailCTA from "../../components/ruta-claude/EmailCTA.astro";
import { RUTA_CLAUDE_DATA, HERRAMIENTAS_CLAUDE } from "../../data/ruta-claude";
---

<RutaClaudeLayout
  title="Ruta Claude desde cero"
  description="Aprendé a trabajar con Claude desde cero, sobre tus propios documentos y con respuestas que podés comprobar. Dos pasos gratis y un kit."
>
  <div class="space-y-12 pb-16">
    <section class="space-y-5 pt-6 bg-white rounded-3xl border border-slate-200/80 p-8 shadow-sm relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-teal-50 rounded-full blur-3xl -z-10 translate-x-20 -translate-y-20"></div>

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-teal-50 border border-teal-200/80 rounded-full font-mono text-xs text-teal-800 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        Ruta de aprendizaje para profesionales. En construcción
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
        Claude desde cero, sobre tus propios documentos
      </h1>

      <p class="text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">
        Pasás de preguntarle cosas a una IA a trabajar con Claude sobre lo que ya tenés, con respuestas que podés comprobar. Sin saber programar y sin vueltas teóricas.
      </p>

      <div class="pt-2 space-y-2 text-xs text-slate-500 font-mono">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="font-semibold text-slate-700">Probado con</span>
          {HERRAMIENTAS_CLAUDE.probado.map((f) => (
            <span class="px-3 py-1 bg-slate-50 border border-slate-200 rounded-lg shadow-2xs text-slate-700 font-medium">{f}</span>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="font-semibold text-slate-700">Misma lógica, sin probar con</span>
          {HERRAMIENTAS_CLAUDE.mismaLogicaSinProbar.map((f) => (
            <span class="px-3 py-1 bg-white border border-dashed border-slate-300 rounded-lg text-slate-600 font-medium">{f}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="space-y-6">
      <div class="flex items-center justify-between px-2">
        <h2 class="text-xl font-bold text-slate-900 tracking-tight">Los pasos</h2>
        <span class="text-xs font-mono text-slate-500 bg-white px-3 py-1 rounded-full border border-slate-200/80">Dos gratis y tres en el kit</span>
      </div>

      <div class="space-y-4">
        {RUTA_CLAUDE_DATA.map((paso) => (
          <PasoCard paso={paso} />
        ))}
      </div>
    </section>

    <div class="px-2">
      <a
        href="/ruta-claude/kit"
        onclick="if (window.posthog) { window.posthog.capture('ruta_claude_landing_click', { origen: 'hub' }); }"
        class="inline-flex items-center justify-center gap-2 font-semibold bg-white border border-slate-300 hover:border-teal-600 text-slate-800 rounded-xl py-3.5 px-6 transition text-sm"
      >
        <span>Ver el kit completo</span>
        <span class="text-base leading-none">→</span>
      </a>
    </div>

    <EmailCTA ubicacion="hub" />
  </div>
</RutaClaudeLayout>
