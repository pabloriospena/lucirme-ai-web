  <!-- SCRIPT PARA BOTÓN COPIAR PROMPTS -->
  <script is:inline>
    function copyPrompt(elementId, btnElement) {
      const el = document.getElementById(elementId);
      if (!el) return;
      const text = el.innerText || el.textContent;
      navigator.clipboard.writeText(text).then(() => {
        const originalText = btnElement.innerHTML;
        btnElement.innerHTML = '<span>¡Copiado! ✓</span>';
        btnElement.classList.remove('bg-teal', 'hover:bg-tealHover');
        btnElement.classList.add('bg-emerald-600');
        setTimeout(() => {
          btnElement.innerHTML = originalText;
          btnElement.classList.remove('bg-emerald-600');
          btnElement.classList.add('bg-teal', 'hover:bg-tealHover');
        }, 2500);
      }).catch(err => {
        console.error('Error al copiar:', err);
      });
    }
  </script>

