---
import Layout from "../layouts/Layout.astro";
import Resultados from "../components/Resultados.astro";
import { LINKS } from "../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const calendlyUrl = LINKS.calendly_empresa || "https://calendly.com/pablorios";
---

<Layout
  title="LuciRMe AI · Empresas | Primero el problema. Después la tecnología."
  description="Encuentra un cuello de botella operativo en tu empresa, mide cuánto te está costando y decide si vale la pena intervenir. Soluciones con IA, automatización y adopción autónoma por Pablo Ríos."
  hideHeader={true}
  hideFooter={true}
>
  <!-- 1. NAVEGACIÓN DEDICADA B2B (HEADER) -->
  <header
    class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200"
  >
    <div
      class="h-16 max-w-7xl mx-auto px-6 flex items-center justify-between gap-4"
    >
      <div class="flex items-center gap-8">
        <a class="flex items-center gap-2.5 group" href="/">
          <img
            src="/logo-lucirme.png"
            alt="LuciRMe AI"
            class="h-8 w-auto object-contain group-hover:scale-105 transition-transform"
          />
          <span
            class="font-bold text-lg text-slate-900 tracking-tight group-hover:text-teal-800 transition-colors"
          >
            LuciRMe<span class="text-teal-700 ml-0.5">AI</span> · Empresas
          </span>
        </a>
      </div>
      <nav
        class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600"
      >
        <a class="hover:text-slate-900 transition-colors" href="#diagnostico"
          >Diagnóstico</a
        >
        <a class="hover:text-slate-900 transition-colors" href="#casos">Casos</a
        >
        <a
          class="hover:text-slate-900 transition-colors"
          href="#como-trabajamos">Cómo trabajamos</a
        >
        <a class="hover:text-slate-900 transition-colors" href="#pablo">Pablo</a
        >
      </nav>

      <div class="flex items-center gap-3">
        <a
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-emerald-600 text-white text-xs font-semibold hover:bg-emerald-700 transition-colors shadow-2xs"
          href={`${whatsappBase}?text=${encodeURIComponent("Hola Pablo, quiero revisar un cuello de botella operativo en mi empresa.")}`}
          rel="noopener noreferrer"
          target="_blank"
          onclick="if (window.posthog) { window.posthog.capture('bottleneck_diagnosis_whatsapp_click', { origen: 'header_b2b' }); }"
        >
          <span class="material-symbols-outlined text-[17px]">chat</span>
          <span>Hablemos por WhatsApp</span>
        </a>
      </div>
    </div>
  </header>

  <main class="w-full bg-[#F8FAFC]">
    <!-- 2. HERO -->
    <section
      class="w-full max-w-7xl mx-auto px-6 pt-12 pb-10 md:py-16 flex flex-col items-start gap-6 border-b border-slate-200/60"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center w-full">
        <div class="lg:col-span-7 flex flex-col items-start gap-5">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 bg-white border border-slate-200 rounded-full font-mono text-xs text-slate-700 shadow-2xs"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-teal-600"></span>
            Primero el problema. Después la tecnología.
          </div>
          <div class="max-w-2xl flex flex-col gap-3">
            <h1
              class="text-3xl md:text-5xl font-bold tracking-tight text-slate-900 leading-tight"
            >
              ¿Dónde se está perdiendo el tiempo en tu equipo?
            </h1>
            <p
              class="text-base md:text-lg text-slate-600 font-normal leading-relaxed"
            >
              Hay procesos que parecen pequeños hasta que calculas cuántas veces
              se repiten. Encuentra un cuello de botella, mide cuánto te está
              costando y decide si vale la pena intervenir.
            </p>
          </div>
          <div
            class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1 w-full sm:w-auto"
          >
            <a
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-teal-700 text-white font-semibold text-sm hover:bg-teal-800 transition-colors shadow-sm"
              href="#diagnostico"
              onclick="if (window.posthog) { window.posthog.capture('bottleneck_diagnosis_started', { origen: 'hero_btn' }); }"
            >
              <span>Empezar diagnóstico · 3 min</span>
              <span class="material-symbols-outlined text-[18px]"
                >arrow_downward</span
              >
            </a>
            <a
              class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-white border border-slate-200 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition-colors shadow-2xs"
              href={`${whatsappBase}?text=${encodeURIComponent("Hola Pablo, quiero conversar sobre un proceso operativo en mi empresa.")}`}
              rel="noopener noreferrer"
              target="_blank"
              onclick="if (window.posthog) { window.posthog.capture('bottleneck_diagnosis_whatsapp_click', { origen: 'hero_direct' }); }"
            >
              <span class="material-symbols-outlined text-slate-500 text-[18px]"
                >chat</span
              >
              <span>Hablar directamente con Pablo</span>
            </a>
          </div>
          <p class="text-xs font-mono text-slate-500">
            No necesitas saber de IA. Nosotros nos ocupamos de esa parte.
          </p>
        </div>

        <div class="lg:col-span-5 w-full flex justify-center lg:justify-end">
          <div
            class="w-full max-w-md bg-white rounded-2xl border border-slate-200 shadow-sm p-5 md:p-6 flex flex-col gap-4"
          >
            <div class="flex items-center justify-between pb-1">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                <span
                  class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-900"
                  >Diagnóstico LuciRMe AI</span
                >
              </div>
            </div>

            <div
              class="p-3.5 bg-slate-50 border border-slate-200/60 rounded-xl flex flex-col gap-2"
            >
              <div class="flex items-center justify-between">
                <span
                  class="font-mono text-[10px] uppercase font-semibold text-slate-500 tracking-wider"
                  >Fuga de tiempo típica</span
                >
                <span class="font-mono text-xs font-bold text-amber-700"
                  >~10 hrs/semana por integrante</span
                >
              </div>
              <p class="text-xs font-semibold text-slate-900 leading-snug">
                Consolidación manual de datos. Más tiempo recolectando que
                decidiendo
              </p>
              <div
                class="w-full bg-slate-200 rounded-full h-1.5 mt-1 overflow-hidden"
              >
                <div class="bg-amber-600 h-1.5 rounded-full w-[65%]"></div>
              </div>
            </div>

            <div
              class="p-3.5 bg-slate-50 border border-slate-200/60 rounded-xl flex flex-col gap-1"
            >
              <span
                class="font-mono text-[10px] uppercase font-semibold text-slate-500 tracking-wider"
                >Priorización:</span
              >
              <h4 class="text-xs font-bold text-amber-700">
                P1 Urgente · Alto ROI Inmediato
              </h4>
              <span class="text-[11px] font-medium text-teal-700 font-mono">
                Integración de herramientas
              </span>
            </div>

            <div
              class="p-3 bg-white border border-slate-200/80 rounded-xl flex items-start gap-2.5 text-xs text-slate-600 leading-relaxed shadow-2xs"
            >
              <span
                class="material-symbols-outlined text-teal-600 text-[18px] shrink-0 mt-0.5"
                >verified</span
              >
              <p class="text-[11px] leading-relaxed text-slate-600">
                Identificamos la causa raíz antes de gastar recursos. El 40% de
                los cuellos de botella se resuelven simplificando el flujo sin
                añadir costos fijos.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 & 4. DIAGNÓSTICO OPERATIVO (CONSOLA INTERACTIVA COMPACTA SIN SCROLL NI PRESELECCIÓN) -->
    <section
      class="w-full max-w-7xl mx-auto px-6 py-12 scroll-mt-20"
      id="diagnostico"
    >
      <div class="max-w-3xl mb-8 flex flex-col gap-2">
        <div
          class="inline-flex items-center gap-2 font-mono text-xs text-teal-800 uppercase font-semibold"
        >
          Diagnóstico Operativo
        </div>
        <h2
          class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900"
        >
          No necesitas saber de IA. Necesitas identificar qué está frenando al
          equipo.
        </h2>
        <p class="text-xs md:text-sm text-slate-600 leading-relaxed">
          Responde las siguientes preguntas para medir la fuga de tiempo de tu
          equipo sin sesgos iniciales.
        </p>
      </div>

      <!-- Consola Interactiva Compacta -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Columna Izquierda: Wizard Paso a Paso Compacto -->
        <div
          class="lg:col-span-7 flex flex-col bg-white p-5 md:p-6 rounded-2xl border border-slate-200 shadow-sm relative min-h-[380px]"
        >
          <!-- Header del Wizard: Barra de Progreso y Paso actual -->
          <div class="flex flex-col gap-2 pb-4 border-b border-slate-100">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"
                ></span>
                <span
                  class="font-mono text-xs font-semibold text-teal-800 uppercase"
                  id="step-counter">Paso 1 de 7</span
                >
              </div>
              <span class="text-[11px] font-mono text-slate-400" id="step-hint"
                >Selecciona una opción</span
              >
            </div>
            <!-- Barra de progreso -->
            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
              <div
                class="bg-teal-700 h-1.5 rounded-full transition-all duration-300 ease-out"
                id="progress-bar"
                style="width: 14.2857%;"
              >
              </div>
            </div>
          </div>

          <!-- Contenedor dinámico de pasos compacto -->
          <div
            class="py-4 flex-1 flex flex-col justify-between"
            id="wizard-container"
          >
            <!-- Paso 1: Proceso -->
            <div class="wizard-step flex flex-col gap-3" id="step-1">
              <div class="flex flex-col gap-1">
                <span
                  class="font-mono text-xs font-semibold text-teal-800 uppercase"
                  >Paso 1 · Proceso</span
                >
                <h3 class="text-base md:text-lg font-bold text-slate-900">
                  ¿Qué proceso te gustaría mejorar en tu equipo?
                </h3>
              </div>
              <div
                class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1"
                id="group-proceso"
              >
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Reportes y consolidación de información', this)"
                  type="button"
                >
                  <span>Reportes e información</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Atención y seguimiento de clientes', this)"
                  type="button"
                >
                  <span>Atención a clientes</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Documentación', this)"
                  type="button"
                >
                  <span>Documentación</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Reuniones y seguimiento', this)"
                  type="button"
                >
                  <span>Reuniones y minutas</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Procesos administrativos', this)"
                  type="button"
                >
                  <span>Procesos administrativos</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Ventas y marketing', this)"
                  type="button"
                >
                  <span>Ventas y comercial</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option sm:col-span-2 flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Otro proceso operativo', this)"
                  type="button"
                >
                  <span>Otro proceso operativo</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
              </div>
            </div>

            <!-- Paso 2: Frecuencia -->
            <div class="wizard-step hidden flex flex-col gap-3" id="step-2">
              <div class="flex flex-col gap-1">
                <span
                  class="font-mono text-xs font-semibold text-teal-800 uppercase"
                  >Paso 2 · Frecuencia</span
                >
                <h3 class="text-base md:text-lg font-bold text-slate-900">
                  ¿Con qué frecuencia se repite este proceso?
                </h3>
              </div>
              <div
                class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1"
                id="group-frecuencia"
              >
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('frecuencia', 'Varias veces al día', this)"
                  type="button"
                >
                  <span>Varias veces al día</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('frecuencia', 'Todos los días', this)"
                  type="button"
                >
                  <span>Todos los días</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('frecuencia', 'Varias veces por semana', this)"
                  type="button"
                >
                  <span>Varias veces por semana</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('frecuencia', 'Una vez por semana', this)"
                  type="button"
                >
                  <span>Una vez por semana</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option sm:col-span-2 flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('frecuencia', 'Algunas veces al mes', this)"
                  type="button"
                >
                  <span>Algunas veces al mes</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
              </div>
            </div>

            <!-- Paso 3: Tiempo -->
            <div class="wizard-step hidden flex flex-col gap-3" id="step-3">
              <div class="flex flex-col gap-1">
                <span
                  class="font-mono text-xs font-semibold text-teal-800 uppercase"
                  >Paso 3 · Tiempo por ejecución</span
                >
                <h3 class="text-base md:text-lg font-bold text-slate-900">
                  ¿Cuánto tiempo consume cada sesión?
                </h3>
              </div>
              <div
                class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1"
                id="group-tiempo"
              >
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('tiempo', 'Menos de 15 minutos', this)"
                  type="button"
                >
                  <span>Menos de 15 minutos</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('tiempo', '15–30 minutos', this)"
                  type="button"
                >
                  <span>15–30 minutos</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('tiempo', '30–60 minutos', this)"
                  type="button"
                >
                  <span>30–60 minutos</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('tiempo', '1–2 horas', this)"
                  type="button"
                >
                  <span>1–2 horas</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option sm:col-span-2 flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('tiempo', 'Más de 2 horas', this)"
                  type="button"
                >
                  <span>Más de 2 horas</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
              </div>
            </div>

            <!-- Paso 4: Equipo -->
            <div class="wizard-step hidden flex flex-col gap-3" id="step-4">
              <div class="flex flex-col gap-1">
                <span
                  class="font-mono text-xs font-semibold text-teal-800 uppercase"
                  >Paso 4 · Equipo</span
                >
                <h3 class="text-base md:text-lg font-bold text-slate-900">
                  ¿Cuántas personas participan en este proceso?
                </h3>
              </div>
              <div class="grid grid-cols-2 gap-2.5 pt-1" id="group-personas">
                <button
                  class="diag-option p-3 rounded-xl border border-slate-200 text-center font-medium text-slate-800 hover:border-slate-300 hover:bg-slate-50 transition-all flex flex-col items-center justify-center cursor-pointer"
                  onclick="window.selectStepOption('personas', '1 persona', this)"
                  type="button"
                >
                  <span class="text-xl font-bold font-mono">1</span>
                  <span class="text-[11px] text-slate-500">Solo 1 persona</span>
                </button>
                <button
                  class="diag-option p-3 rounded-xl border border-slate-200 text-center font-medium text-slate-800 hover:border-slate-300 hover:bg-slate-50 transition-all flex flex-col items-center justify-center cursor-pointer"
                  onclick="window.selectStepOption('personas', '2 a 4 personas', this)"
                  type="button"
                >
                  <span class="text-xl font-bold font-mono">2–3</span>
                  <span class="text-[11px] text-slate-500">Equipo pequeño</span>
                </button>
                <button
                  class="diag-option p-3 rounded-xl border border-slate-200 text-center font-medium text-slate-800 hover:border-slate-300 hover:bg-slate-50 transition-all flex flex-col items-center justify-center cursor-pointer"
                  onclick="window.selectStepOption('personas', '4 a 5 personas', this)"
                  type="button"
                >
                  <span class="text-xl font-bold font-mono">4–5</span>
                  <span class="text-[11px] text-slate-500">Varios roles</span>
                </button>
                <button
                  class="diag-option p-3 rounded-xl border border-slate-200 text-center font-medium text-slate-800 hover:border-slate-300 hover:bg-slate-50 transition-all flex flex-col items-center justify-center cursor-pointer"
                  onclick="window.selectStepOption('personas', 'Más de 5 personas', this)"
