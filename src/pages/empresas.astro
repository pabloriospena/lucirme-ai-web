  <script>
    import { generateBottleneckPDF } from "../lib/pdfGenerator";

    let currentStep = 1;
    const totalSteps = 7;

    const currentSelections: Record<string, string> = {
      proceso: "",
      frecuencia: "",
      tiempo: "",
      personas: "",
      impacto: "",
      esfuerzo: "",
      name: "",
      email: "",
      empresa: "",
      tamano: "11-50 personas",
      industria: "Tecnología/SaaS",
      pais: "Colombia",
      ciudad: "Bogotá",
    };

    function updateProgressBar() {
      const bar = document.getElementById("progress-bar");
      const counter = document.getElementById("step-counter");
      const prevBtn = document.getElementById(
        "btn-prev",
      ) as HTMLButtonElement | null;
      const nextBtn = document.getElementById("btn-next");
      const stepHint = document.getElementById("step-hint");
      const dotsContainer = document.getElementById("step-dots");

      if (!bar || !counter) return;

      if (currentStep <= totalSteps) {
        const percentage = (currentStep / totalSteps) * 100;
        bar.style.width = percentage + "%";
        counter.innerText = `Paso ${currentStep} de ${totalSteps}`;
        if (prevBtn) prevBtn.disabled = currentStep === 1;

        if (currentStep === totalSteps) {
          if (nextBtn) nextBtn.classList.add("hidden");
          if (stepHint) stepHint.innerText = "Último paso · Datos de contacto";
        } else {
          if (nextBtn) nextBtn.classList.remove("hidden");
          if (stepHint) stepHint.innerText = "Selecciona una opción";
        }

        if (dotsContainer) {
          dotsContainer.innerHTML = "";
          for (let i = 1; i <= totalSteps; i++) {
            const dot = document.createElement("span");
            dot.className = `h-2 rounded-full transition-all ${i === currentStep ? "bg-teal-700 w-4" : i < currentStep ? "bg-teal-300 w-2" : "bg-slate-200 w-2"}`;
            dotsContainer.appendChild(dot);
          }
        }
      } else {
        bar.style.width = "100%";
        counter.innerText = "Diagnóstico Finalizado";
        if (stepHint) stepHint.innerText = "Evaluación generada";
        if (prevBtn) prevBtn.disabled = false;
        if (nextBtn) nextBtn.classList.add("hidden");
        if (dotsContainer) {
          dotsContainer.innerHTML =
            '<span class="text-xs font-mono text-emerald-600 font-semibold">100% Completado</span>';
        }
      }
    }

    function goToStep(step: number) {
      document
        .querySelectorAll(".wizard-step")
        .forEach((el) => el.classList.add("hidden"));

      currentStep = step;
      if (step <= totalSteps) {
        const targetStep = document.getElementById(`step-${step}`);
        if (targetStep) targetStep.classList.remove("hidden");
      } else {
        const compStep = document.getElementById("step-completed");
        if (compStep) compStep.classList.remove("hidden");
      }

      updateProgressBar();
    }

    function nextStep() {
      if (currentStep < totalSteps) {
        goToStep(currentStep + 1);
      }
    }

    function prevStep() {
      if (currentStep > 1) {
        goToStep(currentStep - 1);
      }
    }

    function selectStepOption(
      category: string,
      value: string,
      btnElement: HTMLElement,
    ) {
      currentSelections[category] = value;

      const parent = btnElement.parentElement;
      if (parent) {
        const buttons = parent.querySelectorAll(".diag-option");
        buttons.forEach((btn) => {
          btn.classList.remove(
            "border-teal-700",
            "bg-teal-50/80",
            "text-teal-900",
            "font-bold",
          );
          btn.classList.add("border-slate-200", "text-slate-700");
          const icon = btn.querySelector(".material-symbols-outlined");
          if (icon) {
            icon.textContent = "circle";
            icon.classList.remove("text-teal-700");
            icon.classList.add("text-slate-300", "opacity-0");
          }
        });
      }

      btnElement.classList.remove("border-slate-200", "text-slate-700");
      btnElement.classList.add(
        "border-teal-700",
        "bg-teal-50/80",
        "text-teal-900",
        "font-bold",
      );
      const activeIcon = btnElement.querySelector(".material-symbols-outlined");
      if (activeIcon) {
        activeIcon.textContent = "check_circle";
        activeIcon.classList.remove("text-slate-300", "opacity-0");
        activeIcon.classList.add("text-teal-700");
      }

      recalculateAssessment();

      setTimeout(() => {
        if (currentStep < totalSteps) {
          nextStep();
        }
      }, 260);
    }

    function calculateEstimatedWeeklyHours() {
      if (!currentSelections.proceso && !currentSelections.frecuencia) {
        return 0;
      }

      let freqMultiplier = 5;
      if (currentSelections.frecuencia.includes("Varias veces al día"))
        freqMultiplier = 15;
      else if (currentSelections.frecuencia.includes("Todos los días"))
        freqMultiplier = 5;
      else if (currentSelections.frecuencia.includes("Varias veces por semana"))
        freqMultiplier = 3;
      else if (currentSelections.frecuencia.includes("Una vez por semana"))
        freqMultiplier = 1;
      else if (currentSelections.frecuencia.includes("Algunas veces al mes"))
        freqMultiplier = 0.5;

      let timeValue = 1.5;
      if (currentSelections.tiempo.includes("Menos de 15 minutos"))
        timeValue = 0.2;
      else if (currentSelections.tiempo.includes("15–30 minutos"))
        timeValue = 0.4;
      else if (currentSelections.tiempo.includes("30–60 minutos"))
        timeValue = 0.75;
      else if (currentSelections.tiempo.includes("1–2 horas")) timeValue = 1.5;
      else if (currentSelections.tiempo.includes("Más de 2 horas"))
        timeValue = 2.5;

      let personsCount = 2;
      if (currentSelections.personas.includes("1 persona")) personsCount = 1;
      else if (currentSelections.personas.includes("2 a 4 personas"))
        personsCount = 2.5;
      else if (currentSelections.personas.includes("4 a 5 personas"))
        personsCount = 4.5;
      else if (currentSelections.personas.includes("Más de 5 personas"))
        personsCount = 6;

      return Math.round(freqMultiplier * timeValue * personsCount * 10) / 10;
    }

    function recalculateAssessment() {
      const hasSelections = !!currentSelections.proceso;

      const elProc = document.getElementById("card-proceso");
      if (elProc) {
        elProc.innerText = hasSelections
          ? currentSelections.proceso
          : "Selecciona tus respuestas...";
      }

      const elFreq = document.getElementById("card-frecuencia");
      if (elFreq) {
        elFreq.innerText = currentSelections.frecuencia || "-";
      }

      const weeklyHours = calculateEstimatedWeeklyHours();
      const elTime = document.getElementById("card-tiempo");
      if (elTime) {
        elTime.innerText = hasSelections
          ? `~${weeklyHours} h/semana`
          : "Por calcular";
      }

      const elPers = document.getElementById("card-personas");
      if (elPers) elPers.innerText = currentSelections.personas || "-";

      const elImp = document.getElementById("card-impacto");
      if (elImp) elImp.innerText = currentSelections.impacto || "-";

      const elEsf = document.getElementById("card-esfuerzo");
      if (elEsf) elEsf.innerText = currentSelections.esfuerzo || "-";

      const elTag = document.getElementById("card-company-tag");
      if (elTag) {
        elTag.innerText = currentSelections.empresa
          ? `${currentSelections.empresa} · ${currentSelections.industria} (${currentSelections.ciudad}, ${currentSelections.pais})`
          : "Tus datos aparecerán aquí";
      }

      const badge = document.getElementById("card-priority-badge");
      const justification = document.getElementById("card-justification");

      if (!hasSelections) {
        if (badge) {
          badge.className =
            "px-2 py-0.5 rounded font-mono text-[10px] font-bold bg-slate-100 text-slate-600 uppercase";
          badge.innerText = "Sin selección";
        }
        if (justification) {
          justification.innerHTML =
            "Responde las preguntas del diagnóstico a la izquierda para estimar la fuga de tiempo semanal de tu equipo.";
        }
        return;
      }

      let prioridad: "Alta" | "Media" = "Media";
      if (
        weeklyHours >= 12 ||
        currentSelections.impacto.includes("ingresos") ||
        currentSelections.impacto.includes("varios") ||
        currentSelections.impacto.includes("cliente")
      ) {
        prioridad = "Alta";
      }

      if (badge && justification) {
        if (prioridad === "Alta") {
          badge.className =
            "px-2 py-0.5 rounded font-mono text-[10px] font-bold bg-amber-100 text-amber-900 uppercase";
          badge.innerText = "Prioridad: Alta";
          justification.innerHTML = `Este proceso genera una fuga de aproximadamente <strong class="text-slate-900">~${weeklyHours} horas/semana</strong> combinando alta recurrencia e impacto directo en la operación.`;
        } else {
          badge.className =
            "px-2 py-0.5 rounded font-mono text-[10px] font-bold bg-teal-100 text-teal-800 uppercase";
          badge.innerText = "Prioridad: Media";
          justification.innerHTML = `Este proceso genera cerca de <strong class="text-slate-900">~${weeklyHours} horas/semana</strong>. Recomendamos simplificarlo o automatizar pasos clave.`;
        }
      }

      const waBtn = document.getElementById(
        "card-whatsapp-btn",
      ) as HTMLAnchorElement | null;
      if (waBtn) {
        const encodedMsg = encodeURIComponent(
          `Hola Pablo, completé el diagnóstico de LuciRMe AI para ${currentSelections.empresa || "mi empresa"} (${currentSelections.pais}):\n\n` +
            `• Proceso a mejorar: ${currentSelections.proceso}\n` +
            `• Frecuencia: ${currentSelections.frecuencia}\n` +
            `• Tiempo por sesión: ${currentSelections.tiempo}\n` +
            `• Fuga calculada: ~${weeklyHours} hrs/semana\n` +
            `• Personas involucradas: ${currentSelections.personas}\n` +
            `• Impacto principal: ${currentSelections.impacto}\n` +
            `• Esfuerzo estimado: ${currentSelections.esfuerzo}\n\n` +
            `Quiero revisar este proceso contigo.`,
        );
        waBtn.href = `https://wa.me/573053046180?text=${encodedMsg}`;
      }

      (window as any).latestDiagnosis = {
        ...currentSelections,
        weeklyHours,
        prioridad,
        prioridadBadge:
          prioridad === "Alta"
            ? "P1 Urgente · Alto ROI Inmediato"
            : "P2 Recomendado · ROI Moderado",
        justificacion: `Fuga aproximada de ~${weeklyHours} horas/semana.`,
        recomendacion: "Revisión estratégica de 30 min con Pablo Ríos.",
        empresaTag: `${currentSelections.empresa || "Mi Empresa"} · ${currentSelections.industria} (${currentSelections.ciudad}, ${currentSelections.pais})`,
        empresa: currentSelections.empresa || "Mi Empresa",
        name: currentSelections.name || "Contacto",
        email: currentSelections.email || "contacto@empresa.com",
        tamano: currentSelections.tamano || "11-50 personas",
        industria: currentSelections.industria || "Tecnología/SaaS",
        pais: currentSelections.pais || "Colombia",
        ciudad: currentSelections.ciudad || "Bogotá",
      };
    }

    async function submitDiagnostic() {
      const nombreInput = document.getElementById(
        "nombre-input",
      ) as HTMLInputElement | null;
      const emailInput = document.getElementById(
        "email-input",
      ) as HTMLInputElement | null;
      const empInput = document.getElementById(
        "empresa-input",
      ) as HTMLInputElement | null;
      const tamSelect = document.getElementById(
        "tamano-select",
      ) as HTMLSelectElement | null;
      const indSelect = document.getElementById(
        "industria-select",
      ) as HTMLSelectElement | null;
      const paisInput = document.getElementById(
        "pais-input",
      ) as HTMLInputElement | null;
      const cdInput = document.getElementById(
        "ciudad-input",
      ) as HTMLInputElement | null;
      const submitBtn = document.getElementById(
        "submit-btn",
      ) as HTMLButtonElement | null;

      const nameVal = (nombreInput && nombreInput.value.trim()) || "";
      const emailVal = (emailInput && emailInput.value.trim()) || "";
      const empVal = (empInput && empInput.value.trim()) || "Mi Empresa";

      if (!emailVal || !emailVal.includes("@")) {
        alert("Por favor ingresa un correo electrónico corporativo válido.");
        return;
      }

      if (!nameVal) {
        alert("Por favor ingresa tu nombre.");
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = "Enviando y calculando...";
      }

      currentSelections.name = nameVal;
      currentSelections.email = emailVal;
      currentSelections.empresa = empVal;
      currentSelections.tamano =
        (tamSelect && tamSelect.value) || "11-50 personas";
      currentSelections.industria =
        (indSelect && indSelect.value) || "Tecnología/SaaS";
      currentSelections.pais =
        (paisInput && paisInput.value.trim()) || "Colombia";
      currentSelections.ciudad = (cdInput && cdInput.value.trim()) || "Bogotá";

      recalculateAssessment();

      try {
        const response = await fetch("/api/bottleneck-diagnosis", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(currentSelections),
        });

        const result = await response.json();

        if (!response.ok && result.error) {
          alert(result.error);
        } else if (result.diagnosis) {
          (window as any).latestDiagnosis = result.diagnosis;
        }
      } catch (err) {
        console.error("Error enviando diagnóstico:", err);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = "Ver diagnóstico de cuello de botella →";
        }
      }

      const hours = calculateEstimatedWeeklyHours();
      const sumText = document.getElementById("completion-summary-text");
      if (sumText) {
        sumText.innerHTML = `
          Para <strong>${currentSelections.empresa}</strong> (${currentSelections.industria}, ${currentSelections.tamano}), el proceso <strong>"${currentSelections.proceso || "Analizado"}"</strong> representa una carga de aproximadamente <strong>~${hours} horas por semana</strong> para ${currentSelections.personas || "el equipo"}.
        `;
      }

      if ((window as any).posthog) {
        (window as any).posthog.capture("bottleneck_diagnosis_completed", {
          process: currentSelections.proceso,
          company_size: currentSelections.tamano,
          industry: currentSelections.industria,
          estimated_hours_week: hours,
          priority: (window as any).latestDiagnosis?.prioridad || "Alta",
        });
        (window as any).posthog.capture("bottleneck_diagnosis_lead_submitted", {
          company_size: currentSelections.tamano,
          industry: currentSelections.industria,
          city: currentSelections.ciudad,
          country: currentSelections.pais,
        });
      }

      const card = document.getElementById("assessment-card");
      if (card) {
        card.classList.add("ring-2", "ring-emerald-500");
        setTimeout(() => {
          card.classList.remove("ring-2", "ring-emerald-500");
        }, 1500);
      }

      goToStep(totalSteps + 1);
    }

    function downloadPDF() {
      recalculateAssessment();

      const diag = (window as any).latestDiagnosis || {
        proceso:
          currentSelections.proceso ||
          "Reportes y consolidación de información",
        frecuencia: currentSelections.frecuencia || "Todos los días",
        tiempo: currentSelections.tiempo || "1–2 horas",
        personas: currentSelections.personas || "2 a 4 personas",
        impacto: currentSelections.impacto || "Afecta al cliente",
        esfuerzo: currentSelections.esfuerzo || "Moderado",
        weeklyHours: calculateEstimatedWeeklyHours() || 18.8,
        prioridad: "Alta",
        prioridadBadge: "P1 Urgente · Alto ROI Inmediato",
        justificacion: "Fuga estimada de tiempo semanal.",
        recomendacion:
          "Agendar revisión estratégica de 30 minutos con Pablo Ríos.",
        empresaTag: `${currentSelections.empresa || "Mi Empresa"} · ${currentSelections.industria} (${currentSelections.ciudad}, ${currentSelections.pais})`,
        empresa: currentSelections.empresa || "Mi Empresa",
        name: currentSelections.name || "Contacto",
        email: currentSelections.email || "contacto@empresa.com",
        tamano: currentSelections.tamano || "11-50 personas",
        industria: currentSelections.industria || "Tecnología/SaaS",
        pais: currentSelections.pais || "Colombia",
        ciudad: currentSelections.ciudad || "Bogotá",
      };

      try {
        generateBottleneckPDF(diag);

        if ((window as any).posthog) {
          (window as any).posthog.capture(
            "bottleneck_diagnosis_pdf_downloaded",
            {
              process: diag.proceso,
              company: diag.empresa,
              estimated_hours_week: diag.weeklyHours,
            },
          );
        }
      } catch (pdfErr) {
        console.error("Error generando PDF:", pdfErr);
        alert(
          "Ocurrió un error al generar el PDF. Por favor inténtalo de nuevo.",
        );
      }
    }

    async function shareDiagnostic() {
      recalculateAssessment();
      const hours = calculateEstimatedWeeklyHours() || 18.8;
      const shareData = {
        title: "Diagnóstico de Cuello de Botella - LuciRMe AI",
        text: `Diagnóstico operativo para ${currentSelections.empresa || "mi empresa"}: fuga estimada de ~${hours} hrs/semana en ${currentSelections.proceso || "proceso operativo"}.`,
        url: window.location.href,
      };

      if (navigator.share) {
        try {
          await navigator.share(shareData);
          if ((window as any).posthog) {
            (window as any).posthog.capture("bottleneck_diagnosis_shared", {
              method: "native_share",
            });
          }
        } catch (err) {
          console.log("Share cancelado o falló:", err);
        }
      } else if (navigator.clipboard) {
        try {
          await navigator.clipboard.writeText(window.location.href);
          alert("Enlace del diagnóstico copiado al portapapeles.");
          if ((window as any).posthog) {
            (window as any).posthog.capture("bottleneck_diagnosis_shared", {
              method: "clipboard",
            });
          }
        } catch (clipErr) {
          console.error("Error al copiar:", clipErr);
        }
      }
    }

    // Attach to window so inline onclick handlers work smoothly
    (window as any).goToStep = goToStep;
    (window as any).nextStep = nextStep;
    (window as any).prevStep = prevStep;
    (window as any).selectStepOption = selectStepOption;
    (window as any).submitDiagnostic = submitDiagnostic;
    (window as any).downloadPDF = downloadPDF;
    (window as any).shareDiagnostic = shareDiagnostic;
    (window as any).recalculateAssessment = recalculateAssessment;
    (window as any).currentSelections = currentSelections;

    document.addEventListener("DOMContentLoaded", () => {
      updateProgressBar();

      if ((window as any).posthog) {
        (window as any).posthog.capture("bottleneck_diagnosis_started", {
          pagina: "empresas_b2b_custom",
        });
      }
    });
  </script>
</Layout>
