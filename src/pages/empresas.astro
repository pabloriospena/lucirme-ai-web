---
import LayoutV2 from "../layouts/LayoutV2.astro";
import { LINKS } from "../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const calendlyUrl = LINKS.calendly_empresa || "https://calendly.com/pablorios";

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "IA aplicada a procesos para empresas",
  url: "https://lucirme.com/empresas",
  description: "Encuentra un cuello de botella operativo en tu empresa, mide cuánto te está costando y decide si vale la pena intervenir, con IA, automatización y adopción autónoma.",
  provider: { "@id": "https://lucirme.com/#organization" },
  areaServed: "Latinoamérica",
  availableLanguage: "es",
  audience: { "@type": "Audience", audienceType: "Empresas y equipos" },
};

---

<LayoutV2
  title="LuciRMe AI · Empresas | Primero el problema. Después la tecnología."
  description="Encuentra un cuello de botella operativo en tu empresa, mide cuánto te está costando y decide si vale la pena intervenir. Soluciones con IA, automatización y adopción autónoma por Pablo Ríos."
  jsonLd={serviceJsonLd}
>

<div class="w-full bg-v2-fondo">
    <!-- Empresas: elección de tamaño (Web v2). Las secciones anteriores están en _empresas-anterior.astro -->
    <section class="mx-auto flex w-full max-w-[1120px] flex-col gap-8 px-5 pb-6 pt-10 sm:px-8 sm:pt-16">
      <div class="flex max-w-[720px] flex-col gap-3">
        <p class="text-sm font-bold text-v2-accion">Empresas</p>
        <h1 class="text-[32px] font-extrabold leading-tight text-v2-texto sm:text-[44px]">Encuentra qué frena a tu equipo y qué hacer con la IA.</h1>
        <p class="text-base leading-7 text-v2-cuerpo">Elige el tamaño de tu empresa.</p>
      </div>
      <ul class="grid gap-4 md:grid-cols-2">
        {[
          { n: "Pymes", t: "Para equipos pequeños que quieren ordenar un proceso con IA." },
          { n: "Enterprise", t: "Para empresas grandes que quieren adoptar IA en varios equipos." },
        ].map((c) => (
          <li class="flex flex-col gap-3 rounded-3xl border-[0.8px] border-v2-borde bg-v2-superficie p-6">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-[22px] font-bold text-v2-texto">{c.n}</h2>
              <span class="rounded-full border-[0.8px] border-v2-borde bg-v2-fondo px-3 py-1 text-xs font-bold text-v2-cuerpo">Próximamente</span>
            </div>
            <p class="text-base leading-6 text-v2-cuerpo">{c.t}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- 3 & 4. DIAGNÓSTICO OPERATIVO (CONSOLA INTERACTIVA COMPACTA SIN SCROLL NI PRESELECCIÓN) -->
    <section
      class="mx-auto w-full max-w-[1120px] px-5 py-12 sm:px-8 scroll-mt-20"
      id="diagnostico"
    >
      <div class="mb-8 flex max-w-[720px] flex-col gap-2">
        <h2 class="text-[26px] font-bold text-v2-texto">Diagnóstico de 7 pasos</h2>
        <p class="text-base leading-6 text-v2-cuerpo">Responde siete preguntas cortas y recibe tu diagnóstico.</p>
      </div>

      <!-- Consola Interactiva Compacta -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Columna Izquierda: Wizard Paso a Paso Compacto -->
        <div
          class="lg:col-span-12 mx-auto w-full max-w-[720px] flex flex-col bg-white p-5 md:p-6 rounded-2xl border border-slate-200 shadow-sm relative min-h-[380px]"
        >
          <!-- Header del Wizard: Barra de Progreso y Paso actual -->
          <div class="flex flex-col gap-2 pb-4 border-b border-slate-100">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"
                ></span>
                <span
                  class="font-mono text-xs font-semibold text-teal-800 uppercase"
                  id="step-counter">Paso 1 de 7</span
                >
              </div>
              <span class="text-[11px] font-mono text-slate-400" id="step-hint"
                >Selecciona una opción</span
              >
            </div>
            <!-- Barra de progreso de 7 tramos -->
            <div id="progress-bar" role="progressbar" aria-label="Progreso del diagnóstico" aria-valuemin="1" aria-valuemax="7" aria-valuenow="1" class="flex gap-1.5">
<span data-seg class="h-2 flex-1 rounded-full bg-[#cad5e2]"></span>
<span data-seg class="h-2 flex-1 rounded-full bg-[#cad5e2]"></span>
<span data-seg class="h-2 flex-1 rounded-full bg-[#cad5e2]"></span>
<span data-seg class="h-2 flex-1 rounded-full bg-[#cad5e2]"></span>
<span data-seg class="h-2 flex-1 rounded-full bg-[#cad5e2]"></span>
<span data-seg class="h-2 flex-1 rounded-full bg-[#cad5e2]"></span>
<span data-seg class="h-2 flex-1 rounded-full bg-[#cad5e2]"></span>
            </div>
          </div>

          <!-- Contenedor dinámico de pasos compacto -->
          <div
            class="py-4 flex-1 flex flex-col justify-between"
            id="wizard-container"
          >
            <!-- Paso 1: Proceso -->
            <div class="wizard-step flex flex-col gap-3" id="step-1">
              <div class="flex flex-col gap-1">
                <span
                  class="font-mono text-xs font-semibold text-teal-800 uppercase"
                  >Paso 1 · Proceso</span
                >
                <h3 class="text-base md:text-lg font-bold text-slate-900">
                  ¿Qué proceso te gustaría mejorar en tu equipo?
                </h3>
              </div>
              <div
                class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1"
                id="group-proceso"
              >
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Reportes y consolidación de información', this)"
                  type="button"
                >
                  <span>Reportes e información</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Atención y seguimiento de clientes', this)"
                  type="button"
                >
                  <span>Atención a clientes</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Documentación', this)"
                  type="button"
                >
                  <span>Documentación</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Reuniones y seguimiento', this)"
                  type="button"
                >
                  <span>Reuniones y minutas</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Procesos administrativos', this)"
                  type="button"
                >
                  <span>Procesos administrativos</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Ventas y marketing', this)"
                  type="button"
                >
                  <span>Ventas y comercial</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option sm:col-span-2 flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('proceso', 'Otro', this); document.getElementById('otro-proceso-input').classList.toggle('hidden');"
                  type="button"
                >
                  <span>Otro (especificar)</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <input id="otro-proceso-input" class="hidden sm:col-span-2 w-full text-xs px-3 py-2 rounded-lg border border-slate-300 focus:border-teal-700 outline-none bg-white" placeholder="Describe el proceso..." type="text" oninput="currentSelections['proceso-otro'] = this.value;" />
              </div>
              <button 
                  class="mt-4 w-full px-4 py-3 bg-teal-700 text-white font-semibold rounded-xl hover:bg-teal-800 transition-colors"
                  onclick="nextStep()">
                  Continuar
              </button>
            </div>

            <!-- Paso 2: Frecuencia -->
            <div class="wizard-step hidden flex flex-col gap-3" id="step-2">
              <div class="flex flex-col gap-1">
                <span
                  class="font-mono text-xs font-semibold text-teal-800 uppercase"
                  >Paso 2 · Frecuencia</span
                >
                <h3 class="text-base md:text-lg font-bold text-slate-900">
                  ¿Con qué frecuencia se repite este proceso?
                </h3>
              </div>
              <div
                class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1"
                id="group-frecuencia"
              >
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('frecuencia', 'Varias veces al día', this)"
                  type="button"
                >
                  <span>Varias veces al día</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('frecuencia', 'Todos los días', this)"
                  type="button"
                >
                  <span>Todos los días</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('frecuencia', 'Varias veces por semana', this)"
                  type="button"
                >
                  <span>Varias veces por semana</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('frecuencia', 'Una vez por semana', this)"
                  type="button"
                >
                  <span>Una vez por semana</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option sm:col-span-2 flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('frecuencia', 'Algunas veces al mes', this)"
                  type="button"
                >
                  <span>Algunas veces al mes</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
              </div>
            </div>

            <!-- Paso 3: Tiempo -->
            <div class="wizard-step hidden flex flex-col gap-3" id="step-3">
              <div class="flex flex-col gap-1">
                <span
                  class="font-mono text-xs font-semibold text-teal-800 uppercase"
                  >Paso 3 · Tiempo por ejecución</span
                >
                <h3 class="text-base md:text-lg font-bold text-slate-900">
                  ¿Cuánto tiempo consume cada sesión?
                </h3>
              </div>
              <div
                class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1"
                id="group-tiempo"
              >
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('tiempo', 'Menos de 15 minutos', this)"
                  type="button"
                >
                  <span>Menos de 15 minutos</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('tiempo', '15–30 minutos', this)"
                  type="button"
                >
                  <span>15–30 minutos</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('tiempo', '30–60 minutos', this)"
                  type="button"
                >
                  <span>30–60 minutos</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('tiempo', '1–2 horas', this)"
                  type="button"
                >
                  <span>1–2 horas</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option sm:col-span-2 flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('tiempo', 'Más de 2 horas', this)"
                  type="button"
                >
                  <span>Más de 2 horas</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
              </div>
            </div>

            <!-- Paso 4: Equipo -->
            <div class="wizard-step hidden flex flex-col gap-3" id="step-4">
              <div class="flex flex-col gap-1">
                <span
                  class="font-mono text-xs font-semibold text-teal-800 uppercase"
                  >Paso 4 · Equipo</span
                >
                <h3 class="text-base md:text-lg font-bold text-slate-900">
                  ¿Cuántas personas participan en este proceso?
                </h3>
              </div>
              <div class="grid grid-cols-2 gap-2.5 pt-1" id="group-personas">
                <button
                  class="diag-option p-3 rounded-xl border border-slate-200 text-center font-medium text-slate-800 hover:border-slate-300 hover:bg-slate-50 transition-all flex flex-col items-center justify-center cursor-pointer"
                  onclick="window.selectStepOption('personas', '1 persona', this)"
                  type="button"
                >
                  <span class="text-xl font-bold font-mono">1</span>
                  <span class="text-[11px] text-slate-500">Solo 1 persona</span>
                </button>
                <button
                  class="diag-option p-3 rounded-xl border border-slate-200 text-center font-medium text-slate-800 hover:border-slate-300 hover:bg-slate-50 transition-all flex flex-col items-center justify-center cursor-pointer"
                  onclick="window.selectStepOption('personas', '2 a 4 personas', this)"
                  type="button"
                >
                  <span class="text-xl font-bold font-mono">2–3</span>
                  <span class="text-[11px] text-slate-500">Equipo pequeño</span>
                </button>
                <button
                  class="diag-option p-3 rounded-xl border border-slate-200 text-center font-medium text-slate-800 hover:border-slate-300 hover:bg-slate-50 transition-all flex flex-col items-center justify-center cursor-pointer"
                  onclick="window.selectStepOption('personas', '4 a 5 personas', this)"
                  type="button"
                >
                  <span class="text-xl font-bold font-mono">4–5</span>
                  <span class="text-[11px] text-slate-500">Varios roles</span>
                </button>
                <button
                  class="diag-option p-3 rounded-xl border border-slate-200 text-center font-medium text-slate-800 hover:border-slate-300 hover:bg-slate-50 transition-all flex flex-col items-center justify-center cursor-pointer"
                  onclick="window.selectStepOption('personas', 'Más de 5 personas', this)"
                  type="button"
                >
                  <span class="text-xl font-bold font-mono">&gt;5</span>
                  <span class="text-[11px] text-slate-500"
                    >Equipo extendido</span
                  >
                </button>
              </div>
            </div>

            <!-- Paso 5: Impacto -->
            <div class="wizard-step hidden flex flex-col gap-3" id="step-5">
              <div class="flex flex-col gap-1">
                <span
                  class="font-mono text-xs font-semibold text-teal-800 uppercase"
                  >Paso 5 · Impacto</span
                >
                <h3 class="text-base md:text-lg font-bold text-slate-900">
                  ¿Cuál es el impacto principal cuando falla o se retrasa?
                </h3>
              </div>
              <div
                class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1"
                id="group-impacto"
              >
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('impacto', 'Perdemos tiempo de trabajo', this)"
                  type="button"
                >
                  <span>Perdemos tiempo de trabajo</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('impacto', 'Tenemos que repetir tareas o corregir errores', this)"
                  type="button"
                >
                  <span>Repetir tareas / Errores</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('impacto', 'Se retrasan otros procesos', this)"
                  type="button"
                >
                  <span>Retrasan otros procesos</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('impacto', 'Afecta la atención o satisfacción de los clientes', this)"
                  type="button"
                >
                  <span>Afecta clientes</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('impacto', 'Perdemos oportunidades de venta o clientes', this)"
                  type="button"
                >
                  <span>Perdemos ventas/clientes</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('impacto', 'Genera costos adicionales', this)"
                  type="button"
                >
                  <span>Genera costos adicionales</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
                  class="diag-option flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-all cursor-pointer"
                  onclick="window.selectStepOption('impacto', 'Depende demasiado de una persona', this)"
                  type="button"
                >
                  <span>Depende de una persona</span>
                  <span
                    class="material-symbols-outlined text-[16px] text-slate-300 opacity-0"
                    >circle</span
                  >
                </button>
                <button
