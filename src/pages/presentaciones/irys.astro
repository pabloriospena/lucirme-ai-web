---
import Layout from '../../layouts/Layout.astro';
import IrysTaller from '../../components/IrysTaller.astro';
---

<Layout title="Taller de inmersión IA | IRYS">
  <IrysTaller>
    
    <!-- Slide 1: Portada -->
    <section class="slide active h-screen flex flex-col justify-center items-center px-6 md:px-12">
      <div class="max-w-3xl w-full text-center">
        <span class="inline-block px-4 py-1.5 bg-teal/10 text-teal rounded-full text-sm font-bold mb-6 tracking-wide uppercase">
          Taller de Inmersión • 120 min • Presencial
        </span>
        <h1 class="text-4xl md:text-6xl font-bold text-deep mb-6 leading-tight">Aprendamos y apliquemos la Inteligencia Artificial</h1>
        <p class="text-xl md:text-2xl text-gray-500 mb-10">Taller de Inmersión para IRYS</p>
        
        <div class="border-l-4 border-teal p-6 md:p-8 bg-teal/5 rounded-r-2xl max-w-2xl mx-auto mb-10 shadow-sm">
          <blockquote class="text-lg md:text-xl italic text-deep leading-relaxed">
            "La IA no reemplaza tu criterio. Te devuelve tiempo para usarlo mejor."
          </blockquote>
        </div>
        
        <p class="text-base md:text-lg text-gray-600 max-w-xl mx-auto leading-relaxed">
          Taller de Inmersión de 2 horas para que el equipo de IRYS entienda qué es la IA, pierda el miedo a usarla y construya su primer solución funcional con herramientas gratis.
        </p>
      </div>
    </section>

    <!-- Slide 2: Detalles de la sesión -->
    <section class="slide h-screen flex flex-col justify-center items-center px-6 md:px-12">
      <div class="max-w-2xl w-full">
        <h2 class="text-3xl md:text-4xl font-bold text-deep mb-8 text-center">👥 Detalles de la sesión</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          <div class="p-5 bg-gray-50 rounded-xl border border-gray-100 hover:border-teal/30 transition">
            <span class="block text-xs font-bold text-teal uppercase tracking-wider mb-1">Fecha</span>
            <span class="text-deep font-semibold">Miércoles, 27 de mayo</span>
          </div>
          <div class="p-5 bg-gray-50 rounded-xl border border-gray-100 hover:border-teal/30 transition">
            <span class="block text-xs font-bold text-teal uppercase tracking-wider mb-1">Hora</span>
            <span class="text-deep font-semibold">1:00 PM</span>
          </div>
          <div class="p-5 bg-gray-50 rounded-xl border border-gray-100 hover:border-teal/30 transition md:col-span-2">
            <span class="block text-xs font-bold text-teal uppercase tracking-wider mb-1">Modalidad</span>
            <span class="text-deep font-semibold">Presencial • 120 minutos</span>
          </div>
          <div class="p-5 bg-gray-50 rounded-xl border border-gray-100 hover:border-teal/30 transition md:col-span-2">
            <span class="block text-xs font-bold text-teal uppercase tracking-wider mb-1">Participantes</span>
            <span class="text-deep font-semibold">Equipo técnico y gerencial de IRYS (10–20 personas)</span>
          </div>
          <div class="p-5 bg-gray-50 rounded-xl border border-gray-100 hover:border-teal/30 transition md:col-span-2">
            <span class="block text-xs font-bold text-teal uppercase tracking-wider mb-1">Herramientas</span>
            <span class="text-deep font-semibold">100% gratuitas: NotebookLM, ChatGPT, Gemini, Qwen, Perplexity, Google Sheets</span>
          </div>
        </div>
        
        <div class="text-center">
          <span class="inline-flex items-center gap-2 bg-teal/10 text-teal px-5 py-2.5 rounded-full font-bold text-sm">
            <span>✅</span> Confirmado
          </span>
        </div>
      </div>
    </section>

    <!-- Slide 3: Temas a tratar -->
    <section class="slide h-screen flex flex-col justify-center items-center px-6 md:px-12">
      <div class="max-w-4xl w-full">
        <h2 class="text-3xl md:text-4xl font-bold text-deep mb-3 text-center">🗂️ Temas a tratar</h2>
        <p class="text-gray-500 text-center mb-12 text-lg">Un recorrido práctico: de "¿Qué es IA?" a "Este es mi agente"</p>
        
        <div class="grid md:grid-cols-2 gap-6">
          <!-- Bloque 1 -->
          <div class="group p-6 bg-white rounded-2xl border border-gray-100 hover:border-teal hover:shadow-lg transition-all duration-300">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">🔹</span>
              <h3 class="font-bold text-deep text-lg">Apertura y Conexión</h3>
            </div>
            <ul class="space-y-2 text-sm text-gray-600">
              <li class="flex items-start gap-2"><span class="text-teal mt-0.5">•</span> Presentación Pablo Ríos</li>
              <li class="flex items-start gap-2"><span class="text-teal mt-0.5">•</span> IA que ya usas: Spotify, Maps, Netflix</li>
            </ul>
          </div>
          
          <!-- Bloque 2 -->
          <div class="group p-6 bg-white rounded-2xl border border-gray-100 hover:border-teal hover:shadow-lg transition-all duration-300">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">🧠</span>
              <h3 class="font-bold text-deep text-lg">Fundamentos y Herramientas</h3>
            </div>
            <ul class="space-y-2 text-sm text-gray-600">
              <li class="flex items-start gap-2"><span class="text-teal mt-0.5">•</span> IA sin tecnicismos + fórmula de prompts</li>
              <li class="flex items-start gap-2"><span class="text-teal mt-0.5">•</span> Kit gratuito aplicado a IRYS</li>
            </ul>
          </div>
          
          <!-- Bloque 3 -->
          <div class="group p-6 bg-white rounded-2xl border border-gray-100 hover:border-teal hover:shadow-lg transition-all duration-300">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">🤖</span>
              <h3 class="font-bold text-deep text-lg">Agentes de IA + Demo en Vivo</h3>
            </div>
            <ul class="space-y-2 text-sm text-gray-600">
              <li class="flex items-start gap-2"><span class="text-teal mt-0.5">•</span> Chat vs Agente + creación en NotebookLM</li>
              <li class="flex items-start gap-2"><span class="text-teal mt-0.5">•</span> Caso real de IRYS</li>
            </ul>
          </div>
          
          <!-- Bloque 4 -->
          <div class="group p-6 bg-white rounded-2xl border border-gray-100 hover:border-teal hover:shadow-lg transition-all duration-300">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">🎯</span>
              <h3 class="font-bold text-deep text-lg">Identificación de Tareas</h3>
            </div>
            <ul class="space-y-2 text-sm text-gray-600">
              <li class="flex items-start gap-2"><span class="text-teal mt-0.5">•</span> Criterios de viabilidad + priorización</li>
              <li class="flex items-start gap-2"><span class="text-teal mt-0.5">•</span> Output: lista de tareas con responsables</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Slide: Sobre mí -->
<section class="slide h-screen w-full flex flex-col justify-center items-center px-6 md:px-20 bg-white">
  <div class="max-w-4xl w-full">
    
    <!-- Header -->
    <div class="text-center mb-10">
      <span class="inline-block px-4 py-1.5 bg-teal/10 text-teal rounded-full text-sm font-bold mb-4 tracking-wide uppercase">
        Tu facilitador
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-deep mb-2">Pablo Ríos Peña</h2>
      <p class="text-gray-500 text-lg">Product Manager · Facilitador de IA aplicada · Fundador de LuciRMe AI</p>
    </div>

    <!-- Propósito -->
    <div class="border-l-4 border-teal p-6 bg-teal/5 rounded-r-2xl max-w-2xl mx-auto mb-10">
      <blockquote class="text-lg italic text-deep leading-relaxed">
        "Mejorar la vida de las personas con tecnología. Ese es el propósito."
      </blockquote>
      <p class="text-sm text-gray-600 mt-3">No vengo a vender herramientas. Vengo a compartir lo que me ha funcionado para que tú y tu equipo decidan qué aplicar.</p>
    </div>

    <!-- Experiencia en grid -->
    <div class="grid md:grid-cols-2 gap-5 mb-10">
      <div class="bg-white border border-gray-100 rounded-xl p-5 hover:border-teal/30 transition">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-2xl">📈</span>
          <h4 class="font-bold text-deep">Experiencia clave</h4>
        </div>
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-start gap-2"><span class="text-teal font-bold">•</span> <strong>12+ años</strong> en Product Management (SaaS B2B/B2C)</li>
          <li class="flex items-start gap-2"><span class="text-teal font-bold">•</span> IA aplicada desde <strong>2021</strong>: voz, marketing, cadena de suministros</li>
          <li class="flex items-start gap-2"><span class="text-teal font-bold">•</span> Facilitación para equipos <strong>no técnicos</strong></li>
          <li class="flex items-start gap-2"><span class="text-teal font-bold">•</span> Fundador de <strong>LuciRMe AI</strong></li>
        </ul>
      </div>

      <div class="bg-white border border-gray-100 rounded-xl p-5 hover:border-teal/30 transition">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-2xl">🧰</span>
          <h4 class="font-bold text-deep">Lo que traigo a esta sesión</h4>
        </div>
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-start gap-2"><span class="text-teal font-bold">✓</span> Enfoque práctico: 70% aplicación, 30% teoría</li>
          <li class="flex items-start gap-2"><span class="text-teal font-bold">✓</span> Herramientas 100% gratuitas</li>
          <li class="flex items-start gap-2"><span class="text-teal font-bold">✓</span> Rigor ingenieril: validación humana siempre</li>
          <li class="flex items-start gap-2"><span class="text-teal font-bold">✓</span> Propiedad intelectual: tú eres dueño de tus agentes</li>
        </ul>
      </div>
    </div>

    <!-- Formación y contacto -->
    <div class="grid md:grid-cols-2 gap-5 items-start">
      <div class="bg-white border border-gray-100 rounded-xl p-5">
        <h4 class="font-bold text-deep mb-3 flex items-center gap-2">🎓 Formación relevante</h4>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-teal/10 text-teal rounded-full text-xs font-bold">Design Thinking</span>
          <span class="px-3 py-1 bg-teal/10 text-teal rounded-full text-xs font-bold">Scrum Master</span>
          <span class="px-3 py-1 bg-teal/10 text-teal rounded-full text-xs font-bold">User Story Mapping</span>
          <span class="px-3 py-1 bg-teal/10 text-teal rounded-full text-xs font-bold">Product-Led Growth</span>
        </div>
      </div>

      <div class="bg-teal/5 border border-teal/30 rounded-xl p-5 text-center md:text-left">
        <h4 class="font-bold text-teal mb-3">📬 Conectemos</h4>
        <div class="space-y-2 text-sm">
          <a href="https://www.linkedin.com/in/pabloriospena/" class="block text-deep hover:text-teal transition font-medium">LinkedIn</a>
          <a href="tel:+573128199661" class="block text-deep hover:text-teal transition font-medium">📱 312 819 9661</a>
        </div>
      </div>
    </div>

  </div>
</section>

    <section class="slide h-screen w-full flex flex-col justify-center items-center px-6 md:px-20 bg-white">
  <div class="max-w-3xl w-full">
    <h2 class="text-3xl font-bold text-deep mb-8 flex items-center gap-3">🔹 Apertura y Conexión</h2>
    <div class="space-y-6">
      <div class="bg-gray-50 border border-gray-100 p-6 rounded-xl">
        <h3 class="font-bold text-deep mb-2">Rompehielos</h3>
        <p class="text-sm text-gray-600 italic">"¿Cuándo usaste IA por última vez?"</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {['🎵 Spotify', '🗺️ Maps', '🎬 Netflix', '📹 Cámaras'].map(item => (
          <div class="p-4 bg-teal/5 border border-teal/10 rounded-lg text-center font-bold text-teal text-sm">{item}</div>
        ))}
      </div>
      <p class="text-sm text-gray-600 bg-orange/5 p-4 rounded-lg border border-orange/10 italic">
        💡 Si confías en que estas herramientas aprendan de ti para ayudarte, puedes confiar en la IA para optimizar tu flujo técnico.
      </p>
    </div>
  </div>
</section>

<!-- Slide: IA sin tecnicismos -->
<section class="slide h-screen w-full flex flex-col justify-center items-center px-6 md:px-20 bg-white">
  <div class="max-w-3xl w-full">
    
    <!-- Header -->
    <div class="text-center mb-10">
      <span class="inline-block px-4 py-1.5 bg-teal/10 text-teal rounded-full text-sm font-bold mb-4 tracking-wide uppercase">
        Fundamentos
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-deep mb-2">🧠 IA sin tecnicismos</h2>
      <p class="text-gray-500 text-lg">Conceptos claros, en palabras cortas</p>
    </div>

    <!-- Qué ES / Qué NO ES -->
    <div class="grid md:grid-cols-2 gap-4 mb-10">
      <div class="bg-teal/5 border border-teal/30 rounded-xl p-5">
        <h4 class="font-bold text-teal mb-3 flex items-center gap-2">✅ Qué ES</h4>
        <ul class="space-y-2 text-sm text-gray-700">
          <li>• Herramienta que aprende patrones</li>
          <li>• Asistente que sugiere, no decide</li>
          <li>• Motor que acelera tu flujo</li>
          <li>• Espejo que organiza tu conocimiento</li>
        </ul>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-5">
        <h4 class="font-bold text-gray-500 mb-3 flex items-center gap-2">❌ Qué NO es</h4>
        <ul class="space-y-2 text-sm text-gray-500">
          <li>• No piensa como humano</li>
          <li>• No tiene criterio propio</li>
          <li>• No reemplaza tu juicio</li>
          <li>• No es magia: es estadística</li>
        </ul>
      </div>
    </div>

    <!-- Mensajes clave -->
    <div class="space-y-4">
      <div class="border-l-4 border-teal p-4 bg-teal/5 rounded-r-xl">
        <p class="text-deep font-bold text-lg">Potencia tu criterio, no lo reemplaza</p>
        <p class="text-sm text-gray-600 mt-1">La IA te devuelve tiempo para hacer más de lo que solo tú puedes hacer: interpretar, decidir, innovar.</p>
      </div>
      
      <div class="border-l-4 border-deep p-4 bg-gray-50 rounded-r-xl">
        <p class="text-deep font-bold text-lg">Tú eres la última línea de defensa</p>
        <p class="text-sm text-gray-600 mt-1">Valida siempre. Confía, pero verifica. Tu experiencia es irreemplazable.</p>
      </div>
    </div>

    <!-- Regla de oro + CTA -->
    <div class="mt-10 text-center">
      <span class="inline-flex items-center gap-2 px-4 py-2 bg-deep text-white rounded-full text-sm font-bold mb-6">
        🎯 Regla de oro: La IA sugiere · Tú decides
      </span>
      
      <!-- Botón al Prompteador -->
      <a href="https://lucirme.com/recursos/prompteador" 
         target="_blank"
         class="inline-flex items-center gap-2 bg-teal text-white px-6 py-3 rounded-xl font-bold hover:bg-tealHover transition shadow-md active:scale-[0.98]">
        🛠️ Prueba el Prompteador ahora
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <p class="text-xs text-gray-400 mt-3">Abre en nueva pestaña · Herramienta 100% gratuita</p>
    </div>

  </div>
</section>

<!-- Slide: Tu Asistente con NotebookLM -->
<section class="slide h-screen w-full flex flex-col justify-center items-center px-6 md:px-20 bg-white">
  <div class="max-w-4xl w-full">
    
    <!-- Header -->
    <div class="text-center mb-10">
      <span class="inline-block px-4 py-1.5 bg-teal/10 text-teal rounded-full text-sm font-bold mb-4 tracking-wide uppercase">
        Demo en vivo
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-deep mb-2">🤖 Tu Asistente con NotebookLM</h2>
      <p class="text-gray-500 text-lg">De la búsqueda manual a la respuesta con contexto</p>
    </div>

    <!-- Comparación relevante -->
    <div class="grid md:grid-cols-2 gap-5 mb-10">
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-5">
        <h4 class="font-bold text-gray-500 mb-3 flex items-center gap-2">🔍 Búsqueda tradicional</h4>
        <ul class="space-y-2 text-sm text-gray-600">
          <li>• Abres 3-4 PDFs de normas</li>
          <li>• Buscas manualmente con Ctrl+F</li>
          <li>• Copias, pegas y cruzas datos</li>
          <li>• Riesgo: información desactualizada</li>
        </ul>
      </div>
      <div class="bg-teal/5 border border-teal/30 rounded-xl p-5">
        <h4 class="font-bold text-teal mb-3 flex items-center gap-2">✨ Asistente con contexto</h4>
        <ul class="space-y-2 text-sm text-gray-700">
          <li>• Subes tus normas y plantillas una vez</li>
          <li>• Preguntas en lenguaje natural</li>
          <li>• Respuestas con cita de fuente exacta</li>
          <li>• Siempre actualizado con tus documentos</li>
        </ul>
      </div>
    </div>
    <!-- CTA al Prompteador -->
    <div class="mt-8 text-center">
      <a href="https://notebooklm.google.com/notebook/b30d7c7c-276d-4955-b22e-530dce9e8ca0" 
         target="_blank"
         class="inline-flex items-center gap-2 bg-teal text-white px-6 py-3 rounded-xl font-bold hover:bg-tealHover transition shadow-md active:scale-[0.98]">
        🛠️ Probemos NotebookLM
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <p class="text-xs text-gray-400 mt-3">Abre en nueva pestaña · Herramienta 100% gratuita</p>
    </div>

  </div>
</section>
<!-- Slide: Identificación de Tareas -->
<section class="slide h-screen w-full flex flex-col justify-center items-center px-6 md:px-20 bg-white">
  <div class="max-w-4xl w-full">
    
    <!-- Header -->
    <div class="text-center mb-10">
      <span class="inline-block px-4 py-1.5 bg-teal/10 text-teal rounded-full text-sm font-bold mb-4 tracking-wide uppercase">
        Resultados prácticos
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-deep mb-2">🎯 Identificación de Tareas</h2>
      <p class="text-gray-500 text-lg">De la idea a la acción: ¿qué podemos "agentizar" hoy?</p>
    </div>

    <!-- Criterios de viabilidad -->
    <div class="grid md:grid-cols-2 gap-5 mb-10">
      <div class="bg-teal/5 border border-teal/30 rounded-xl p-5">
        <h4 class="font-bold text-teal mb-4">✅ Criterios de viabilidad</h4>
        <div class="grid grid-cols-2 gap-3">
          <div class="flex items-center gap-2 text-xs text-gray-700">
            <span class="text-teal font-bold">•</span>
