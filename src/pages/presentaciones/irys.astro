---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Workshop IA - IRYS | LuciRMe Ai">
  <main class="max-w-4xl mx-auto py-16 px-6 space-y-20">

    <!-- HERO -->
    <section class="text-center animate-fade-in">
      <h1 class="text-4xl md:text-5xl font-bold text-deep mb-4">🎯 Aprendamos y utilicemos la IA</h1>
      <p class="text-xl text-gray-600 mb-8">Workshop práctico para IRYS</p>
      <div class="bg-teal/5 border-l-4 border-teal p-6 rounded-r-xl text-left max-w-2xl mx-auto">
        <blockquote class="italic text-gray-700">"La IA no reemplaza tu criterio. Te devuelve tiempo para usarlo mejor."</blockquote>
      </div>
      <p class="text-sm text-gray-600 mt-8 leading-relaxed max-w-xl mx-auto">
        Workshop introductorio de 2 horas para que el equipo de IRYS entienda qué es la IA, pierda el miedo a usarla y construya su primer agente funcional con herramientas 100% gratis.
      </p>
    </section>

    <!-- DETALLES -->
    <section class="bg-gray-50 p-8 rounded-2xl border border-gray-100 animate-fade-in delay-100">
      <h2 class="text-xl font-bold text-deep mb-6">👥 Detalles de la sesión</h2>
      <div class="grid md:grid-cols-2 gap-4 text-sm text-gray-600">
        <div class="p-4 bg-white rounded-lg border border-gray-200"><strong>Fecha:</strong> 30 de abril</div>
        <div class="p-4 bg-white rounded-lg border border-gray-200"><strong>Hora:</strong> 1:00 PM</div>
        <div class="p-4 bg-white rounded-lg border border-gray-200"><strong>Modalidad:</strong> Presencial</div>
        <div class="p-4 bg-white rounded-lg border border-gray-200"><strong>Duración:</strong> 120 minutos</div>
        <div class="p-4 bg-white rounded-lg border border-gray-200 col-span-full"><strong>Participantes:</strong> Equipo técnico y gerencial de IRYS</div>
      </div>
      <div class="mt-4"><span class="bg-teal/10 text-teal text-xs font-bold px-3 py-1 rounded-full">✅ Confirmado</span></div>
    </section>

    <!-- TEMAS -->
    <section class="space-y-8 animate-fade-in delay-200">
      <h2 class="text-2xl font-bold text-deep">🗂️ Temas a tratar</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {[
          { t: "Apertura y Conexión", d: ["Propósito", "Rompehielos", "IA en el día a día"] },
          { t: "Fundamentos", d: ["¿Qué es IA (sin tecnicismos)?", "Fórmula de prompts efectivos", "Kit de herramientas gratis"] },
          { t: "Agentes de IA", d: ["Chat vs Agente", "Demo NotebookLM", "Caso práctico IRYS"] },
          { t: "Identificación de Tareas", d: ["Criterios de viabilidad", "Dinámica: identificación → priorización"] }
        ].map(bloque => (
          <div class="border-l-4 border-gray-200 pl-6 py-2">
            <h3 class="font-bold text-deep mb-3">{bloque.t}</h3>
            <ul class="text-sm text-gray-600 space-y-2 list-disc pl-4">
              {bloque.d.map(item => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- PROMPTS -->
    <section class="code-block bg-deep text-gray-200 p-8 rounded-2xl relative shadow-xl">
      <div class="flex justify-between items-center mb-4">
        <span class="text-[10px] font-bold text-teal uppercase tracking-widest">Fórmula de prompts</span>
        <button id="copy-btn" class="text-xs font-bold text-white hover:text-teal transition">📋 Copiar</button>
      </div>
      <pre class="font-mono text-sm"><code>[ROL] Actúa como un [especialista en ____] con experiencia en ____.
[CONTEXTO] El contexto es: ____.
[OBJETIVO] Necesito que ____.
[FORMATO] Entrega la respuesta como ____.</code></pre>
    </section>

    <!-- CONTACTO -->
    <section class="bg-white p-8 rounded-2xl border border-gray-200 shadow-sm text-center animate-fade-in">
        <img src="/pablo-rios.jpeg" class="w-20 h-20 rounded-full mx-auto mb-4 border-2 border-teal/20" alt="Pablo" />
        <h3 class="text-xl font-bold text-deep">Pablo Ríos Peña</h3>
        <p class="text-sm text-gray-500 mb-6">Product Manager · Facilitador de IA aplicada</p>
        <div class="flex gap-4 justify-center text-sm mb-6">
            <a href="https://www.linkedin.com/in/pabloriospena/" class="text-teal font-bold hover:underline">LinkedIn</a>
            <a href="tel:+573128199661" class="text-teal font-bold hover:underline">312 819 9661</a>

  </main>
<script>
    // 1. Copiar al clipboard
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const codeBlock = target.closest('.code-block')?.querySelector('code');
        const text = codeBlock?.textContent;
        
        if (text) {
          await navigator.clipboard.writeText(text);
          const originalText = target.textContent;
          target.textContent = '✅ Copiado';
          
          setTimeout(() => {
            target.textContent = originalText;
          }, 2000);
        }
      });
    });

    // 2. Intersection Observer para animaciones
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.opacity = '1';
          (entry.target as HTMLElement).style.transform = 'translateY(0)';
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.section').forEach(section => {
      const el = section as HTMLElement;
      el.style.opacity = '0';
      el.style.transform = 'translateY(20px)';
      el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
      observer.observe(el);
    });
  </script>
</Layout>