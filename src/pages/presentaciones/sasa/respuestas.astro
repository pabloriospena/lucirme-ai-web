---
// Respuestas del taller de Sasa Consultoría: crudas (tal cual las escribieron) y agrupadas (como se proyectó).
// Datos estáticos en src/data/taller-sasa-t1.ts. No usa Redis, así que no vence.
import Layout from "../../../layouts/Layout.astro";
import { dolores, usos, grupos } from "../../../data/taller-sasa-t1";

const porId = new Map(dolores.map((d) => [d.id, d]));
const etiquetaSN = (v: string | null) =>
    v === "si" ? "Sí" : v === "no" ? "No" : v === "parcial" ? "Parcial" : "—";
const cap = (s: string | null) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : "—");
const nombre = (n?: string) =>
    n ? n.toLowerCase().replace(/(^|\s)\S/g, (c) => c.toUpperCase()) : "Sin nombre";

const horasTotales = dolores.reduce((a, d) => a + (d.horas_semana ?? 0), 0);
const idsAgrupados = new Set(grupos.flatMap((g) => g.ids));
const sinGrupo = dolores.filter((d) => !idsAgrupados.has(d.id));
const hayGrupos = grupos.length > 0;
---

<Layout title="Respuestas del taller | Sasa Consultoría" hideHeader hideFooter noindex>
    <div class="min-h-screen bg-slate-50 py-8 px-4">
        <div class="max-w-4xl mx-auto">
            <p class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-1">
                Taller de inmersión en IA
            </p>
            <h1 class="text-3xl font-bold text-slate-900 tracking-tight mb-1">
                Respuestas del equipo
            </h1>
            <p class="text-sm text-slate-600 mb-6">
                Sasa Consultoría · lunes 9 de noviembre de 2026 · {dolores.length} dolores y {usos.length} usos de IA
                registrados en vivo.
            </p>

            <div class="flex gap-2 mb-6" role="tablist">
                <button type="button" data-tab="crudas" role="tab" class="tab flex-1 rounded-lg px-3 py-2 text-sm font-semibold border">
                    Crudas
                </button>
                <button type="button" data-tab="agrupadas" role="tab" class="tab flex-1 rounded-lg px-3 py-2 text-sm font-semibold border">
                    Agrupadas por IA
                </button>
            </div>

            <!-- CRUDAS -->
            <section id="panel-crudas" data-panel="crudas">
                <p class="text-sm text-slate-600 mb-4">
                    Tal cual las escribió cada persona durante la actividad, sin editar.
                </p>

                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-bold text-slate-900">Tareas que más tiempo les quitan</h2>
                    <button type="button" data-copiar="lista-dolores" class="copiar text-xs font-semibold text-teal-700 border border-teal-200 rounded-md px-2.5 py-1 hover:bg-teal-50">Copiar</button>
                </div>
                <ul id="lista-dolores" class="space-y-3 mb-10">
                    {dolores.map((d) => (
                        <li class="rounded-xl border border-slate-200 bg-white p-4">
                            <p class="font-semibold text-slate-900">{d.tarea}</p>
                            <p class="text-sm text-slate-600 mt-1">
                                {nombre(d.nombre)} · {d.rol}
                            </p>
                            <p class="text-xs text-slate-500 mt-2">
                                {d.horas_semana ?? "—"} h/semana · {cap(d.frecuencia)} · Procedimiento: {etiquetaSN(d.procedimiento)} · Estructurado: {etiquetaSN(d.estructurado)}
                            </p>
                        </li>
                    ))}
                </ul>

                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-bold text-slate-900">Cómo usan IA hoy</h2>
                    <button type="button" data-copiar="lista-usos" class="copiar text-xs font-semibold text-teal-700 border border-teal-200 rounded-md px-2.5 py-1 hover:bg-teal-50">Copiar</button>
                </div>
                <ul id="lista-usos" class="space-y-3">
                    {usos.map((u) => (
                        <li class="rounded-xl border border-slate-200 bg-white p-4">
                            <p class="text-sm font-semibold text-slate-900">{u.rol} · {cap(u.frecuencia)}</p>
                            <p class="text-sm text-slate-700 mt-1 whitespace-pre-line">{u.para_que}</p>
                            <p class="text-xs text-slate-500 mt-2">Herramientas: {u.herramientas.join(", ")}</p>
                        </li>
                    ))}
                </ul>
            </section>

            <!-- AGRUPADAS -->
            <section id="panel-agrupadas" data-panel="agrupadas" hidden>
                {hayGrupos ? (
                    <>
                        <div class="flex items-center justify-between mb-3">
                            <p class="text-sm text-slate-600">
                                Los {dolores.length} dolores agrupados por el problema de fondo que comparten, como se proyectó en el taller.
                                Suman {horasTotales} h/semana.
                            </p>
                            <button type="button" data-copiar="lista-grupos" class="copiar text-xs font-semibold text-teal-700 border border-teal-200 rounded-md px-2.5 py-1 hover:bg-teal-50">Copiar</button>
                        </div>
                        <div id="lista-grupos" class="space-y-6">
                            {grupos.map((g, i) => {
                                const miembros = g.ids.map((id) => porId.get(id)).filter(Boolean);
                                const horas = miembros.reduce((a, d) => a + (d?.horas_semana ?? 0), 0);
                                return (
                                    <article class="rounded-2xl border border-slate-200 bg-white p-5">
                                        <p class="text-xs font-bold text-teal-600">Grupo {i + 1} · {miembros.length} {miembros.length === 1 ? "dolor" : "dolores"} · {horas} h/semana</p>
                                        <h3 class="text-lg font-bold text-slate-900 mt-1">{g.nombre}</h3>
                                        <p class="text-sm text-slate-700 mt-1">{g.dolor_de_fondo}</p>
                                        <ul class="mt-3 space-y-2">
                                            {miembros.map((d) => (
                                                <li class="rounded-lg bg-slate-50 px-3 py-2 text-sm text-slate-800">
                                                    {d!.tarea}
                                                    <span class="text-slate-500"> — {nombre(d!.nombre)}, {d!.rol}, {d!.horas_semana ?? "—"} h/semana</span>
                                                </li>
                                            ))}
                                        </ul>
                                    </article>
                                );
                            })}
                            {sinGrupo.length > 0 && (
                                <article class="rounded-2xl border border-dashed border-slate-300 bg-white p-5">
                                    <h3 class="text-lg font-bold text-slate-900">Sin grupo</h3>
                                    <ul class="mt-3 space-y-2">
                                        {sinGrupo.map((d) => (
                                            <li class="rounded-lg bg-slate-50 px-3 py-2 text-sm text-slate-800">
                                                {d.tarea}
                                                <span class="text-slate-500"> — {nombre(d.nombre)}, {d.rol}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </article>
                            )}
                        </div>
                    </>
                ) : (
                    <p class="rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-600">
                        La agrupación aún no está cargada.
                    </p>
                )}
            </section>

            <p class="text-xs text-slate-400 mt-10">LuciRMe AI</p>
        </div>
    </div>
</Layout>

<style>
    .tab { background: #fff; color: #334155; border-color: #cbd5e1; }
    .tab[aria-selected="true"] { background: #0f766e; color: #fff; border-color: #0f766e; }
</style>

<script>
    const tabs = document.querySelectorAll<HTMLButtonElement>(".tab");
    const paneles = document.querySelectorAll<HTMLElement>("[data-panel]");
    function mostrar(nombre: string) {
        tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.tab === nombre)));
        paneles.forEach((p) => (p.hidden = p.dataset.panel !== nombre));
        history.replaceState(null, "", "#" + nombre);
    }
    tabs.forEach((t) => t.addEventListener("click", () => mostrar(t.dataset.tab!)));
    mostrar(location.hash === "#agrupadas" ? "agrupadas" : "crudas");

    document.querySelectorAll<HTMLButtonElement>(".copiar").forEach((b) =>
        b.addEventListener("click", async () => {
            const el = document.getElementById(b.dataset.copiar!);
            if (!el) return;
            try {
                await navigator.clipboard.writeText(el.innerText.trim());
                const antes = b.textContent;
                b.textContent = "Copiado";
                setTimeout(() => (b.textContent = antes), 1500);
            } catch {
                b.textContent = "No se pudo copiar";
            }
        }),
    );
</script>
