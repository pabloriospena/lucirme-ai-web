                            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons.chat}></path>
                            </svg>
                            <span>Conversar con Pablo Ríos en WhatsApp</span>
                        </a>
                    </div>
                </section>
            </main>
        </div>
    </div>
</Layout>

<!-- AVISO DE COPIADO -->
<div
    id="toast"
    class="fixed bottom-5 right-5 z-50 transform translate-y-10 opacity-0 transition-all duration-200 pointer-events-none print:hidden"
>
    <div class="bg-[#37352F] text-white text-xs px-3.5 py-2 rounded-md shadow-lg flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span>Petición copiada al portapapeles</span>
    </div>
</div>

<script>
    const toast = document.getElementById("toast");

    function showToast() {
        if (!toast) return;
        toast.classList.remove("translate-y-10", "opacity-0");
        setTimeout(() => toast.classList.add("translate-y-10", "opacity-0"), 2200);
    }

    document.querySelectorAll<HTMLButtonElement>(".copy-prompt").forEach((btn) => {
        btn.addEventListener("click", async () => {
            const text = btn.dataset.prompt ?? "";
            try {
                await navigator.clipboard.writeText(text);
                showToast();
            } catch {
                // Sin permiso de portapapeles: no se muestra aviso falso.
            }
        });
    });
</script>
