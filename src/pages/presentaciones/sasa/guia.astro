                    </ol>

                    <p class="text-xs text-[#787774]">
                        El taller 2 es el miércoles 18 de noviembre, 2:00 pm.
                    </p>
                </section>

                <!-- 6. BUENAS PRACTICAS -->
                <section id="practicas" class="space-y-4">
                    <div class="pb-2 border-b border-[#E9E9E7]">
