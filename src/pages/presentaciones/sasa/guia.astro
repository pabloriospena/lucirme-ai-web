                    </div>
                </section>

                <!-- CTA -->
                <section class="bg-white border border-[#E9E9E7] rounded-xl p-6 shadow-2xs">
                    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div class="text-xs text-[#787774]">
                            ¿Dudas o algo que quieras sumar antes del taller 2? Escríbeme y lo incluimos.
                        </div>
                        <a
                            href="https://lucirme.com/whatsapp?text=Hola%20Pablo,%20estuve%20revisando%20la%20guia%20del%20taller%201%20de%20Sasa"
