                            </table>
                        </div>
                        <p class="text-xs text-[#787774]">
                            Las instancias muy grandes (varias unidades de negocio) se consultan por capas, no en una sola petición.
                        </p>
                    </div>
                </section>

                <!-- 4. ALCANCES Y LIMITES -->
                <section id="limites" class="space-y-4">
