---
// Dolores del equipo de Sasa Consultoría, en formato documento legible para Sandra Arango.
// Datos estáticos en src/data/taller-sasa-t1.ts (talleres del 9 y 18 de nov 2026). No usa Redis, así que no vence.
// Formato de documento tipo Notion (design.md, sección 6).
import Layout from "../../../layouts/Layout.astro";
import { dolores, grupos } from "../../../data/taller-sasa-t1";
import type { DolorCrudo } from "../../../data/taller-sasa-t1";

// Valores del campo "nombre" que no son una persona (se escribió el nombre de un grupo o una actividad).
const NO_ES_PERSONA = new Set(["análisis de casos"]);

const titulo = (s: string) => s.toLowerCase().replace(/(^|\s)\S/g, (c) => c.toUpperCase());
const nombreDe = (d: DolorCrudo) =>
    d.nombre && !NO_ES_PERSONA.has(d.nombre.trim().toLowerCase()) ? titulo(d.nombre.trim()) : null;
const primeraMayuscula = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const horasTxt = (h: number | null) => (h === null ? "—" : String(h).replace(".", ","));
const frecuencia = (f: string | null) => (f ? primeraMayuscula(f) : "—");

const porId = new Map(dolores.map((d) => [d.id, d]));
const suma = (lista: DolorCrudo[]) => lista.reduce((a, d) => a + (d.horas_semana ?? 0), 0);

const idsAgrupados = new Set(grupos.flatMap((g) => g.ids));
const sinGrupo = dolores.filter((d) => !idsAgrupados.has(d.id));

const bloques = grupos
    .map((g, i) => {
        const miembros = g.ids.map((id) => porId.get(id)).filter((d): d is DolorCrudo => Boolean(d));
        const personas = [...new Set(miembros.map(nombreDe).filter((n): n is string => Boolean(n)))];
        return {
            ...g,
            slug: `grupo-${i + 1}`,
            miembros,
            horas: suma(miembros),
            personas,
            sinProcedimiento: miembros.filter((d) => d.procedimiento === "no").length,
        };
    })
    .sort((a, b) => b.horas - a.horas);

const horasTotales = suma(dolores);
const maxHoras = Math.max(...bloques.map((b) => b.horas), 1);
const areas = [...new Set(dolores.map((d) => d.rol))].sort((a, b) => a.localeCompare(b, "es"));
const porArea = areas
    .map((a) => {
        const l = dolores.filter((d) => d.rol === a);
        return { area: a, n: l.length, horas: suma(l) };
    })
    .sort((a, b) => b.horas - a.horas);
const sinProcedimientoTotal = dolores.filter((d) => d.procedimiento === "no").length;
const diarios = dolores.filter((d) => d.frecuencia === "diaria").length;

const toc = [
    { id: "resumen", label: "Resumen" },
    { id: "mapa", label: "Mapa de los grupos" },
    ...bloques.map((b, i) => ({ id: b.slug, label: `${i + 1}. ${b.nombre}` })),
    { id: "areas", label: "Por área" },
    { id: "todos", label: "Los 26 dolores" },
];

const etiquetaProc = (v: string | null) =>
    v === "si" ? "Con procedimiento" : v === "parcial" ? "Procedimiento parcial" : v === "no" ? "Sin procedimiento" : "Procedimiento sin indicar";
const etiquetaEstr = (v: string | null) =>
    v === "si" ? "Estructurado" : v === "no" ? "No estructurado" : "Estructura sin indicar";
const claseProc = (v: string | null) =>
    v === "no" ? "bg-orange-50 text-orange-800 border-orange-200" : "bg-slate-100 text-slate-700 border-slate-200";
---

<Layout title="Dolores del equipo | Sasa Consultoría" hideHeader hideFooter noindex>
    <div class="min-h-screen bg-[#FBFBFA]">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-10">
            <!-- Índice -->
            <nav aria-label="Contenido" class="hidden lg:block">
                <div class="sticky top-8">
                    <p class="text-[11px] font-semibold uppercase tracking-widest text-slate-500 mb-3">Contenido</p>
                    <ul class="space-y-1 text-sm">
                        {toc.map((t) => (
                            <li>
                                <a href={`#${t.id}`} class="block rounded-md px-2 py-1.5 text-slate-600 hover:bg-[#F1F1EF] hover:text-slate-900">{t.label}</a>
                            </li>
                        ))}
                    </ul>
                </div>
            </nav>

            <main class="min-w-0">
                <header class="mb-8">
                    <p class="text-xs font-bold tracking-widest uppercase text-teal-700 mb-2">LuciRMe AI · Proyecto Autonomía</p>
                    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 mb-4">
                        Dolores del equipo de Sasa Consultoría
                    </h1>

                    <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-2 rounded-xl border border-[#E9E9E7] bg-[#F7F7F5] p-4 text-sm">
                        <div class="flex gap-3"><dt class="w-28 shrink-0 text-slate-500">Para</dt><dd class="text-slate-900">Sandra Arango</dd></div>
                        <div class="flex gap-3"><dt class="w-28 shrink-0 text-slate-500">Organización</dt><dd class="text-slate-900">Sasa Consultoría</dd></div>
                        <div class="flex gap-3"><dt class="w-28 shrink-0 text-slate-500">Fuente</dt><dd class="text-slate-900">Actividad en vivo de los talleres del 9 y 18 de noviembre de 2026</dd></div>
                        <div class="flex gap-3"><dt class="w-28 shrink-0 text-slate-500">Objetivo</dt><dd class="text-slate-900">Decidir qué tareas del equipo atacar primero con IA</dd></div>
                    </dl>
                </header>

                <!-- Resumen -->
                <section id="resumen" class="mb-10 scroll-mt-8">
                    <h2 class="text-2xl font-bold tracking-tight text-slate-900 mb-3">Resumen</h2>
                    <div class="rounded-xl border border-[#E9E9E7] bg-[#F1F1EF] p-4 text-[15px] leading-relaxed text-slate-700">
                        <p>
                            El equipo registró <strong class="text-slate-900">{dolores.length} dolores</strong> en {areas.length} áreas. Sumados, son unas
                            <strong class="text-slate-900">{horasTotales.toString().replace(".", ",")} horas por semana</strong>, según lo que cada persona declaró.
                            Los agrupamos en <strong class="text-slate-900">{bloques.length} problemas de fondo</strong>, ordenados de los que más horas consumen a los que menos.
                        </p>
                        <p class="mt-3">
                            {sinProcedimientoTotal} de los {dolores.length} dolores no tienen un procedimiento definido y {diarios} se repiten todos los días.
                            Esas dos señales ayudan a decidir por dónde empezar: una tarea diaria y sin procedimiento es la que más se beneficia de ordenarse antes de automatizarse.
                        </p>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4">
                        <div class="rounded-xl border border-[#E9E9E7] bg-white p-4">
                            <p class="text-3xl font-extrabold text-slate-900">{dolores.length}</p>
                            <p class="text-xs text-slate-500 mt-1">dolores registrados</p>
                        </div>
                        <div class="rounded-xl border border-[#E9E9E7] bg-white p-4">
                            <p class="text-3xl font-extrabold text-slate-900">{horasTotales.toString().replace(".", ",")}</p>
                            <p class="text-xs text-slate-500 mt-1">horas por semana declaradas</p>
                        </div>
                        <div class="rounded-xl border border-[#E9E9E7] bg-white p-4">
                            <p class="text-3xl font-extrabold text-slate-900">{areas.length}</p>
                            <p class="text-xs text-slate-500 mt-1">áreas del equipo</p>
                        </div>
                        <div class="rounded-xl border border-[#E9E9E7] bg-white p-4">
                            <p class="text-3xl font-extrabold text-slate-900">{bloques.length}</p>
                            <p class="text-xs text-slate-500 mt-1">grupos de problemas</p>
                        </div>
                    </div>
                </section>

                <!-- Mapa -->
                <section id="mapa" class="mb-12 scroll-mt-8">
                    <h2 class="text-2xl font-bold tracking-tight text-slate-900 mb-1">Mapa de los grupos</h2>
                    <p class="text-sm text-slate-600 mb-4">Horas por semana que suma cada grupo. Toca un grupo para ir a su detalle.</p>
                    <ul class="space-y-2">
                        {bloques.map((b, i) => (
                            <li>
                                <a href={`#${b.slug}`} class="block rounded-xl border border-[#E9E9E7] bg-white p-4 hover:border-teal-600/40 transition">
                                    <div class="flex items-baseline justify-between gap-4">
                                        <p class="font-semibold text-slate-900">{i + 1}. {b.nombre}</p>
                                        <p class="text-sm text-slate-600 whitespace-nowrap"><strong class="text-slate-900">{b.horas.toString().replace(".", ",")}</strong> h/sem · {b.miembros.length} {b.miembros.length === 1 ? "dolor" : "dolores"}</p>
                                    </div>
                                    <div class="mt-2 h-2 rounded-full bg-slate-100" role="img" aria-label={`${b.horas} de ${maxHoras} horas, comparado con el grupo más grande`}>
                                        <div class="h-2 rounded-full bg-teal-600" style={`width:${Math.max(4, Math.round((b.horas / maxHoras) * 100))}%`}></div>
                                    </div>
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>

                <!-- Grupos -->
                {bloques.map((b, i) => (
                    <section id={b.slug} class="mb-12 scroll-mt-8">
                        <p class="text-xs font-bold uppercase tracking-widest text-teal-700 mb-1">Grupo {i + 1}</p>
                        <h2 class="text-2xl font-bold tracking-tight text-slate-900 mb-2">{b.nombre}</h2>
                        <p class="text-[15px] leading-relaxed text-slate-700 mb-3">{b.dolor_de_fondo}</p>
                        <p class="text-sm text-slate-600 mb-4">
                            <strong class="text-slate-900">{b.horas.toString().replace(".", ",")} h/semana</strong> ·
                            {b.miembros.length} {b.miembros.length === 1 ? "dolor" : "dolores"} ·
                            {b.sinProcedimiento} sin procedimiento
                            {b.personas.length > 0 && (<> · Lo mencionan: {b.personas.join(", ")}</>)}
                        </p>
                        <ul class="space-y-3">
                            {b.miembros.map((d) => (
                                <li class="rounded-xl border border-[#E9E9E7] bg-white p-4">
                                    <div class="flex items-start justify-between gap-4">
                                        <p class="font-medium text-slate-900 leading-snug">{primeraMayuscula(d.tarea)}</p>
                                        <p class="text-right whitespace-nowrap">
                                            <span class="text-lg font-bold text-slate-900">{horasTxt(d.horas_semana)}</span>
                                            <span class="text-xs text-slate-500"> h/sem</span>
                                        </p>
                                    </div>
                                    <p class="text-sm text-slate-600 mt-1">
                                        {nombreDe(d) ?? "Sin nombre"} · {d.rol} · {frecuencia(d.frecuencia)}
                                    </p>
                                    <div class="flex flex-wrap gap-2 mt-3">
                                        <span class={`text-xs rounded-full border px-2.5 py-0.5 ${claseProc(d.procedimiento)}`}>{etiquetaProc(d.procedimiento)}</span>
                                        <span class="text-xs rounded-full border px-2.5 py-0.5 bg-slate-100 text-slate-700 border-slate-200">{etiquetaEstr(d.estructurado)}</span>
                                    </div>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))}

                {sinGrupo.length > 0 && (
                    <section class="mb-12">
                        <h2 class="text-2xl font-bold tracking-tight text-slate-900 mb-3">Sin grupo</h2>
                        <ul class="space-y-2">
                            {sinGrupo.map((d) => (
                                <li class="rounded-xl border border-dashed border-slate-300 bg-white p-4 text-sm text-slate-800">
                                    {primeraMayuscula(d.tarea)} <span class="text-slate-500">— {nombreDe(d) ?? "Sin nombre"}, {d.rol}</span>
                                </li>
                            ))}
                        </ul>
                    </section>
                )}

                <!-- Por área -->
                <section id="areas" class="mb-12 scroll-mt-8">
                    <h2 class="text-2xl font-bold tracking-tight text-slate-900 mb-3">Por área</h2>
                    <div class="overflow-x-auto rounded-xl border border-[#E9E9E7] bg-white">
                        <table class="w-full text-sm">
                            <thead class="bg-[#F7F7F5] text-left text-slate-600">
                                <tr>
                                    <th scope="col" class="px-4 py-2.5 font-semibold">Área</th>
                                    <th scope="col" class="px-4 py-2.5 font-semibold text-right">Dolores</th>
                                    <th scope="col" class="px-4 py-2.5 font-semibold text-right">Horas/sem</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#E9E9E7]">
                                {porArea.map((a) => (
                                    <tr>
                                        <th scope="row" class="px-4 py-2.5 font-medium text-slate-900 text-left">{a.area}</th>
                                        <td class="px-4 py-2.5 text-right text-slate-700">{a.n}</td>
                                        <td class="px-4 py-2.5 text-right text-slate-700">{a.horas.toString().replace(".", ",")}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- Todos -->
                <section id="todos" class="mb-12 scroll-mt-8">
                    <h2 class="text-2xl font-bold tracking-tight text-slate-900 mb-1">Los {dolores.length} dolores</h2>
                    <p class="text-sm text-slate-600 mb-4">Tal cual los escribió cada persona, con su área y las horas que declaró. Filtra por área si quieres ver un solo equipo.</p>

                    <div class="flex flex-wrap gap-2 mb-4" role="group" aria-label="Filtrar por área">
                        <button type="button" data-area="" class="filtro rounded-lg border px-3 py-1.5 text-sm font-medium">Todas</button>
                        {areas.map((a) => (
                            <button type="button" data-area={a} class="filtro rounded-lg border px-3 py-1.5 text-sm font-medium">{a}</button>
                        ))}
                    </div>

                    <div class="overflow-x-auto rounded-xl border border-[#E9E9E7] bg-white">
                        <table class="w-full text-sm">
                            <thead class="bg-[#F7F7F5] text-left text-slate-600">
                                <tr>
                                    <th scope="col" class="px-4 py-2.5 font-semibold">Dolor</th>
                                    <th scope="col" class="px-4 py-2.5 font-semibold">Persona</th>
                                    <th scope="col" class="px-4 py-2.5 font-semibold">Área</th>
                                    <th scope="col" class="px-4 py-2.5 font-semibold">Frecuencia</th>
                                    <th scope="col" class="px-4 py-2.5 font-semibold text-right">Horas/sem</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#E9E9E7]">
                                {[...dolores].sort((a, b) => (b.horas_semana ?? -1) - (a.horas_semana ?? -1)).map((d) => (
                                    <tr data-fila-area={d.rol}>
                                        <td class="px-4 py-2.5 text-slate-900 min-w-[260px]">{primeraMayuscula(d.tarea)}</td>
                                        <td class="px-4 py-2.5 text-slate-700 whitespace-nowrap">{nombreDe(d) ?? "—"}</td>
                                        <td class="px-4 py-2.5 text-slate-700">{d.rol}</td>
                                        <td class="px-4 py-2.5 text-slate-700">{frecuencia(d.frecuencia)}</td>
                                        <td class="px-4 py-2.5 text-right font-semibold text-slate-900">{horasTxt(d.horas_semana)}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </section>

                <footer class="border-t border-[#E9E9E7] pt-4 text-xs text-slate-500 space-y-1">
                    <p>Las horas por semana son las que cada persona declaró en la actividad; algunas tareas son mensuales, así que son una referencia para comparar, no una medición.</p>
                    <p>Agrupación hecha con apoyo de IA a partir de las respuestas. LuciRMe AI.</p>
                </footer>
            </main>
        </div>
    </div>
</Layout>

<style>
    .filtro { background: #fff; color: #334155; border-color: #cbd5e1; }
    .filtro:hover { background: #f8fafc; }
    .filtro[aria-pressed="true"] { background: #0f766e; color: #fff; border-color: #0f766e; }
    @media print {
        nav { display: none !important; }
        .filtro { display: none; }
        section { break-inside: avoid-page; }
    }
</style>

<script>
    const botones = document.querySelectorAll<HTMLButtonElement>(".filtro");
    const filas = document.querySelectorAll<HTMLElement>("[data-fila-area]");
    function filtrar(area: string) {
        botones.forEach((b) => b.setAttribute("aria-pressed", String((b.dataset.area ?? "") === area)));
        filas.forEach((f) => (f.hidden = area !== "" && f.dataset.filaArea !== area));
    }
    botones.forEach((b) => b.addEventListener("click", () => filtrar(b.dataset.area ?? "")));
    filtrar("");
</script>
