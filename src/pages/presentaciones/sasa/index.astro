    </style>

    <script>
        const slider = document.getElementById("slider") as HTMLElement | null;
        const slides = document.querySelectorAll("main > section");
        const navDots = document.getElementById("navDots") as HTMLElement | null;
        const currentEl = document.getElementById("current") as HTMLElement | null;
        const totalEl = document.getElementById("total") as HTMLElement | null;
        const sesion = slider?.dataset.sesion ?? "sasa-t1";

        // ---------- Pantalla completa ----------
        const fsBtn = document.getElementById("fullscreen-btn") as HTMLElement | null;
        const fsIn = document.getElementById("fs-icon-enter") as HTMLElement | null;
        const fsOut = document.getElementById("fs-icon-exit") as HTMLElement | null;
        if (fsBtn && fsIn && fsOut) {
            fsBtn.addEventListener("click", () => {
                if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(() => {});
                else document.exitFullscreen();
            });
            document.addEventListener("fullscreenchange", () => {
                const on = Boolean(document.fullscreenElement);
                fsIn.classList.toggle("hidden", on);
                fsOut.classList.toggle("hidden", !on);
                fsBtn.setAttribute("aria-label", on ? "Salir de pantalla completa" : "Pantalla completa");
            });
        }

        // ---------- Navegación ----------
        if (slider && navDots && currentEl && totalEl && slides.length > 0) {
            totalEl.textContent = String(slides.length).padStart(2, "0");
            const inactivo = "w-2 h-2 rounded-full bg-slate-300 border-none cursor-pointer transition-all p-0 hover:bg-slate-400";
            const activo = "w-2 h-6 rounded bg-teal-500 border-none cursor-pointer transition-all p-0";
            slides.forEach((_, i) => {
                const dot = document.createElement("button");
                dot.className = i === 0 ? activo : inactivo;
                dot.setAttribute("aria-label", `Ir a la diapositiva ${i + 1}`);
                dot.addEventListener("click", () => slides[i].scrollIntoView({ behavior: "smooth" }));
                navDots.appendChild(dot);
            });
            const dots = navDots.querySelectorAll("button");
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        const index = [...slides].indexOf(entry.target as Element);
                        dots.forEach((d, i) => (d.className = i === index ? activo : inactivo));
                        currentEl.textContent = String(index + 1).padStart(2, "0");
                    });
                },
                { root: slider, threshold: 0.6 },
            );
            slides.forEach((s) => observer.observe(s));
            document.addEventListener("keydown", (e) => {
                if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
                const h = window.innerHeight;
                if (e.key === "ArrowDown" || e.key === "ArrowRight" || e.key === "PageDown") {
                    e.preventDefault();
                    slider.scrollBy({ top: h, behavior: "smooth" });
                } else if (e.key === "ArrowUp" || e.key === "ArrowLeft" || e.key === "PageUp") {
                    e.preventDefault();
                    slider.scrollBy({ top: -h, behavior: "smooth" });
                } else if (e.key === "f" || e.key === "F") {
                    fsBtn?.click();
                }
            });
        }

        // ---------- Datos en vivo ----------
        type Grupo = {
            id: string; nombre: string; dolor_de_fondo: string; n: number; personas: number;
            roles: string[]; impacto: number; con_horas: number; viabilidad: number | null;
            cuadrante: string; frecuencia_predominante: string | null;
        };
        type Estado = {
            ok: boolean; dolores_total: number; uso_total: number;
            uso: { herramientas: { nombre: string; n: number }[]; para_que: string[] };
            publicada: boolean;
            matriz: { umbral_impacto: number; umbral_viabilidad: number; grupos: Grupo[] } | null;
        };

        const NS = "http://www.w3.org/2000/svg";
        const svg = (tag: string, attrs: Record<string, string | number>, texto?: string) => {
            const e = document.createElementNS(NS, tag);
            for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
            if (texto !== undefined) e.textContent = texto;
            return e;
        };
        const el = (tag: string, cls: string, texto?: string) => {
            const e = document.createElement(tag);
            e.className = cls;
            if (texto !== undefined) e.textContent = texto;
            return e;
        };

        const CUADRANTES: Record<string, { nombre: string; color: string; fondo: string }> = {
            "empezar-ya": { nombre: "Empezar ya", color: "#0d9488", fondo: "bg-teal-50 border-teal-200" },
            "preparar-datos": { nombre: "Preparar datos primero", color: "#d97706", fondo: "bg-amber-50 border-amber-200" },
            "ganancia-pequena": { nombre: "Ganancia pequeña", color: "#2563eb", fondo: "bg-blue-50 border-blue-200" },
            "dejar-por-ahora": { nombre: "Dejar por ahora", color: "#64748b", fondo: "bg-slate-50 border-slate-200" },
            "sin-datos": { nombre: "Sin datos para ubicar", color: "#94a3b8", fondo: "bg-white border-slate-200" },
        };

        function pintarUso(e: Estado) {
            const total = document.getElementById("uso-total");
            if (total) total.textContent = String(e.uso_total);
            const cont = document.getElementById("uso-herramientas");
            if (cont) {
                cont.replaceChildren();
                const max = Math.max(1, ...e.uso.herramientas.map((h) => h.n));
                if (!e.uso.herramientas.length) cont.appendChild(el("p", "text-xs text-slate-400", "Esperando respuestas..."));
                for (const h of e.uso.herramientas) {
                    const fila = el("div", "flex items-center gap-3");
                    fila.appendChild(el("span", "w-24 text-xs text-slate-700 shrink-0", h.nombre));
                    const barra = el("div", "flex-1 bg-slate-200 rounded-full h-2.5 overflow-hidden");
                    const relleno = el("div", "h-full bg-teal-500 rounded-full transition-all");
                    relleno.style.width = `${(h.n / max) * 100}%`;
                    barra.appendChild(relleno);
                    fila.appendChild(barra);
                    fila.appendChild(el("span", "w-6 text-right text-xs font-semibold text-slate-700", String(h.n)));
                    cont.appendChild(fila);
                }
            }
            const lista = document.getElementById("uso-paraque");
            if (lista) {
                lista.replaceChildren();
                for (const t of e.uso.para_que) lista.appendChild(el("li", "border-l-2 border-teal-400 pl-3", t));
            }
        }

        function pintarMatriz(e: Estado) {
            const vacia = document.getElementById("matriz-vacia");
            const caja = document.getElementById("matriz");
            const grafico = document.getElementById("matriz-grafico");
            const lista = document.getElementById("matriz-lista");
            if (!vacia || !caja || !grafico || !lista) return;
            if (!e.matriz || !e.matriz.grupos.length) {
                vacia.classList.remove("hidden");
                caja.classList.add("hidden");
                return;
            }
            vacia.classList.add("hidden");
            caja.classList.remove("hidden");

            const { grupos, umbral_impacto, umbral_viabilidad } = e.matriz;
            const ubicables = grupos.filter((g) => g.cuadrante !== "sin-datos" && g.viabilidad !== null);
            const W = 560, H = 380, L = 54, R = 16, T = 16, B = 44;
            const maxImp = Math.max(1, umbral_impacto * 2, ...ubicables.map((g) => g.impacto)) * 1.1;
            const x = (v: number) => L + (W - L - R) * (0.05 + (v / 100) * 0.9);
            const y = (v: number) => H - B - (v / maxImp) * (H - T - B);

            const s = svg("svg", { viewBox: `0 0 ${W} ${H}`, class: "w-full h-auto", role: "img", "aria-label": "Matriz de dolores: horas por semana contra viabilidad" });
            s.appendChild(svg("rect", { x: L, y: T, width: W - L - R, height: H - T - B, fill: "#f8fafc", stroke: "#e2e8f0" }));
            const xv = x(umbral_viabilidad), yv = y(umbral_impacto);
            s.appendChild(svg("rect", { x: xv, y: T, width: W - R - xv, height: yv - T, fill: "#ccfbf1", opacity: 0.5 }));
            s.appendChild(svg("line", { x1: xv, y1: T, x2: xv, y2: H - B, stroke: "#94a3b8", "stroke-dasharray": "4 4" }));
            s.appendChild(svg("line", { x1: L, y1: yv, x2: W - R, y2: yv, stroke: "#94a3b8", "stroke-dasharray": "4 4" }));
            const rot = (txt: string, px: number, py: number, anchor = "start") =>
                s.appendChild(svg("text", { x: px, y: py, "font-size": 10, fill: "#64748b", "text-anchor": anchor, "font-weight": 600 }, txt));
            rot("Empezar ya", W - R - 6, T + 14, "end");
            rot("Preparar datos primero", L + 6, T + 14);
            rot("Ganancia pequeña", W - R - 6, H - B - 8, "end");
            rot("Dejar por ahora", L + 6, H - B - 8);
            s.appendChild(svg("text", { x: (L + W - R) / 2, y: H - 10, "font-size": 11, fill: "#475569", "text-anchor": "middle" }, "Viabilidad (procedimiento escrito y resultado estructurado) →"));
            const ty = svg("text", { x: 14, y: (T + H - B) / 2, "font-size": 11, fill: "#475569", "text-anchor": "middle", transform: `rotate(-90 14 ${(T + H - B) / 2})` }, "Horas por semana →");
            s.appendChild(ty);

            ubicables.forEach((g, i) => {
                const q = CUADRANTES[g.cuadrante];
                const r = 10 + Math.min(14, g.personas * 3);
                const cx = x(g.viabilidad as number), cy = y(g.impacto);
                const c = svg("g", {});
                c.appendChild(svg("circle", { cx, cy, r, fill: q.color, opacity: 0.85, stroke: "#fff", "stroke-width": 2 }));
                c.appendChild(svg("text", { x: cx, y: cy + 4, "font-size": 11, "font-weight": 700, fill: "#fff", "text-anchor": "middle" }, String(i + 1)));
                const t = svg("title", {}, `${g.nombre}: ${g.impacto} h/sem, viabilidad ${g.viabilidad}%`);
                c.appendChild(t);
                s.appendChild(c);
            });
            grafico.replaceChildren(s);

            lista.replaceChildren();
            const orden = ["empezar-ya", "preparar-datos", "ganancia-pequena", "dejar-por-ahora", "sin-datos"];
            for (const q of orden) {
                const delGrupo = grupos.filter((g) => g.cuadrante === q);
                if (!delGrupo.length) continue;
                const info = CUADRANTES[q];
                const bloque = el("div", `border rounded-lg p-3 ${info.fondo}`);
                bloque.appendChild(el("p", "text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-2", info.nombre));
                for (const g of delGrupo) {
                    const num = ubicables.indexOf(g) + 1;
                    const fila = el("div", "mb-2 last:mb-0");
                    fila.appendChild(el("p", "text-sm font-semibold text-slate-800", `${num > 0 ? num + ". " : ""}${g.nombre}`));
                    if (g.dolor_de_fondo) fila.appendChild(el("p", "text-xs text-slate-600 leading-snug", g.dolor_de_fondo));
                    const datos = [`${g.n} ${g.n === 1 ? "dolor" : "dolores"}`];
                    if (g.con_horas > 0) datos.push(`${g.impacto} h/sem`);
                    if (g.viabilidad !== null) datos.push(`viabilidad ${g.viabilidad}%`);
                    fila.appendChild(el("p", "text-[11px] text-slate-400 mt-0.5", datos.join(" · ")));
                    bloque.appendChild(fila);
                }
                lista.appendChild(bloque);
            }
        }

        function pintarPlan(e: Estado) {
            const celdas = document.querySelectorAll<HTMLElement>("#plan-filas .plan-tarea");
            const top = (e.matriz?.grupos ?? [])
                .filter((g) => g.cuadrante === "empezar-ya")
                .sort((a, b) => b.impacto - a.impacto)
                .slice(0, celdas.length);
            celdas.forEach((c, i) => {
                const g = top[i];
                if (g) {
                    c.textContent = g.nombre;
                    c.className = "p-3 font-semibold plan-tarea text-slate-800";
                } else {
                    c.textContent = "Por definir";
                    c.className = "p-3 font-semibold plan-tarea text-slate-400 italic";
                }
            });
        }

        async function actualizar() {
            try {
                const r = await fetch(`/api/taller/estado?sesion=${encodeURIComponent(sesion)}`, { cache: "no-store" });
                if (!r.ok) return;
                const e: Estado = await r.json();
                if (!e.ok) return;
                const d = document.getElementById("dolores-total");
                if (d) d.textContent = String(e.dolores_total);
                pintarUso(e);
                pintarMatriz(e);
                pintarPlan(e);
            } catch {
                /* sin conexión: se reintenta en el siguiente ciclo */
            }
        }
        actualizar();
        setInterval(() => {
            if (!document.hidden) actualizar();
        }, 4000);
    </script>
</Layout>
