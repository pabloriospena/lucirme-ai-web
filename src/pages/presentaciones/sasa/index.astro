---
// Taller de inmersión · Sasa Consultoría
// La sesión en vivo se elige con ?s=sasa-t1 (por defecto). Para otro grupo: ?s=sasa-t2
import Layout from "../../../layouts/Layout.astro";

const sesionParam = Astro.url.searchParams.get("s") ?? "sasa-t1";
const sesion = /^[a-z0-9-]{3,30}$/.test(sesionParam) ? sesionParam : "sasa-t1";

const cliente = "Sasa Consultoría";
const fecha = "Lunes 9 de noviembre de 2026";
const hora = "2:00 pm";
const duracion = "3 horas";
const lider = "Sandra Arango";
const resultadoEsperado =
    "Incorporar la IA en labores rutinarias y desarrollar herramientas que permitan automatizar procesos operativos y administrativos.";

const urlAportar =
    sesion === "sasa-t1"
        ? "lucirme.com/sasa"
        : `lucirme.com/presentaciones/sasa/aportar?s=${sesion}`;
const linkedin = "https://linkedin.com/in/pabloriospena";
const prompteador = "https://lucirme.com/recursos/prompteador";
---

<Layout
    title={`Taller de inmersión · ${cliente} | LuciRMe AI`}
    hideHeader
    hideFooter
    noindex
>
    <button
        id="fullscreen-btn"
        class="fixed top-6 left-6 z-50 bg-white/80 backdrop-blur-sm p-2.5 rounded-full border border-slate-200 shadow-sm hover:bg-slate-100 transition-colors text-slate-600"
        aria-label="Pantalla completa"
    >
        <svg
            id="fs-icon-enter"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
                d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
            ></path></svg
        >
        <svg
            id="fs-icon-exit"
            class="hidden"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
                d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"
            ></path></svg
        >
    </button>

    <div
        class="fixed top-6 right-6 text-xs font-semibold text-slate-500 bg-white/80 backdrop-blur-sm px-3 py-1.5 rounded-full border border-slate-200 shadow-sm z-50"
    >
        <span id="current">01</span> / <span id="total">14</span>
    </div>

    <nav
        class="fixed right-6 top-1/2 -translate-y-1/2 flex flex-col gap-2 z-50 bg-white/80 backdrop-blur-sm p-2 rounded-full border border-slate-200 shadow-sm"
        id="navDots"
    >
    </nav>

    <main
        class="h-screen overflow-y-auto snap-y snap-mandatory scroll-smooth"
        id="slider"
        data-sesion={sesion}
    >
        <!-- 01 PORTADA -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-slate-50 relative"
        >
            <div class="max-w-4xl w-full">
                <p
                    class="text-xs font-semibold text-slate-500 mb-5 tracking-wide"
                >
                    Taller de inmersión · {fecha} · {hora} · Presencial · {
                        duracion
                    }
                </p>
                <h1
                    class="text-4xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.05] mb-4"
                >
                    {cliente}
                </h1>
                <p class="text-xl md:text-2xl text-teal-700 font-semibold mb-8">
                    IA aplicada a la operación del equipo
                </p>
                <div class="grid md:grid-cols-3 gap-3 mb-6">
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm"
                    >
                        <p
                            class="text-[11px] uppercase tracking-wider font-semibold text-slate-400 mb-1"
                        >
                            Líder de IA
                        </p>
                        <p class="text-sm font-bold text-slate-800">{lider}</p>
                    </div>
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm md:col-span-1"
                    >
                        <p
                            class="text-[11px] uppercase tracking-wider font-semibold text-slate-400 mb-1"
                        >
                            Resultado esperado
                        </p>
                        <p class="text-xs text-slate-700 leading-relaxed">
                            {resultadoEsperado}
                        </p>
                    </div>
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm"
                    >
                        <p
                            class="text-[11px] uppercase tracking-wider font-semibold text-slate-400 mb-1"
                        >
                            Comodidad con IA
                        </p>
                        <p class="text-sm font-bold text-slate-800">
                            3 de 5 <span
                                class="font-normal text-xs text-slate-500"
                                >(según el formulario)</span
                            >
                        </p>
                    </div>
                </div>
                <div
                    class="bg-teal-50 border-l-4 border-teal-600 rounded-r-lg p-4 mb-8"
                >
                    <p class="text-sm text-slate-700 leading-relaxed">
                        <strong>Para aprovechar la sesión:</strong> trae el computador
                        y un ejemplo real de tu trabajo, sin nombres de clientes ni
                        datos sensibles. Puede ser un hilo de correos, un acta, un
                        caso de soporte o una toma de requerimientos.
                    </p>
                </div>
                <div>
                    <p
                        class="text-[11px] text-slate-500 uppercase tracking-wider font-semibold"
                    >
                        Facilitador
                    </p>
                    <p class="text-lg font-bold text-slate-900">
                        Pablo Ríos Peña
                    </p>
                    <p class="text-xs text-slate-500">
                        LuciRMe AI · Tu negocio es tu talento, no tu operatividad
                    </p>
                </div>
            </div>
        </section>

        <!-- 02 EN QUÉ USAN IA HOY (en vivo) -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-white"
        >
            <div class="max-w-5xl w-full">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-2"
                >
                    Punto de partida
                </p>
                <h2
                    class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-2"
                >
                    ¿En qué usan IA hoy?
                </h2>
                <div class="w-10 h-1 bg-teal-600 rounded-full mb-5"></div>
                <div class="grid md:grid-cols-5 gap-6">
                    <div class="md:col-span-2">
                        <p class="text-sm text-slate-600 mb-4 leading-relaxed">
                            Respondan desde el celular. Son dos minutos y es
                            anónimo: herramienta, para qué la usan y cada cuánto.
                        </p>
                        <div
                            class="bg-slate-900 text-white rounded-xl p-5 mb-3"
                        >
                            <p
                                class="text-[11px] uppercase tracking-wider text-slate-400 mb-1"
                            >
                                Entra en
                            </p>
                            <p
                                class="text-2xl md:text-3xl font-extrabold tracking-tight break-all"
                            >
                                {urlAportar}
                            </p>
                        </div>
                        <p class="text-xs text-slate-500">
                            Respuestas recibidas: <strong
                                id="uso-total"
                                class="text-slate-800">0</strong
                            >
                        </p>
                    </div>
                    <div class="md:col-span-3 space-y-4">
                        <div
                            class="bg-slate-50 border border-slate-200 rounded-lg p-4"
                        >
                            <p
                                class="text-xs font-semibold text-slate-500 mb-3"
                            >
                                Herramientas que usan
                            </p>
                            <div id="uso-herramientas" class="space-y-2">
                                <p class="text-xs text-slate-400">
                                    Esperando respuestas...
                                </p>
                            </div>
                        </div>
                        <div
                            class="bg-slate-50 border border-slate-200 rounded-lg p-4"
                        >
                            <p
                                class="text-xs font-semibold text-slate-500 mb-3"
                            >
                                Para qué la usan (en sus palabras)
                            </p>
                            <ul
                                id="uso-paraque"
                                class="space-y-1.5 text-sm text-slate-700"
                            >
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 03 QUIÉN SOY -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-slate-50"
        >
            <div
                class="max-w-4xl w-full grid md:grid-cols-2 gap-8 items-center"
            >
                <div>
                    <p
                        class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-2"
                    >
                        Tu facilitador
                    </p>
                    <h2
                        class="text-3xl font-bold text-slate-900 tracking-tight mb-2"
                    >
                        Pablo Ríos Peña
                    </h2>
                    <div class="w-10 h-1 bg-teal-600 rounded-full mb-4"></div>
                    <blockquote
                        class="text-base italic text-slate-600 border-l-2 border-teal-500 pl-4 mb-4"
                    >
                        "Mejorar la vida de las personas con tecnología. Ese es
                        el propósito."
                    </blockquote>
                    <p class="text-sm text-slate-600 leading-relaxed mb-4">
                        No vengo a vender herramientas. Vengo a compartir lo que
                        me ha funcionado para que ustedes decidan qué aplicar en
                        su equipo.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span
                            class="bg-teal-100 text-teal-700 px-2.5 py-1 rounded-full text-[11px] font-semibold"
                            >12+ años en Product Management</span
                        >
                        <span
                            class="bg-orange-100 text-orange-700 px-2.5 py-1 rounded-full text-[11px] font-semibold"
                            >IA aplicada desde 2021</span
                        >
                        <span
                            class="bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded-full text-[11px] font-semibold"
                            >Fundador de LuciRMe AI</span
                        >
                    </div>
                </div>
                <div class="space-y-3">
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm"
                    >
                        <h3 class="text-sm font-semibold text-teal-600 mb-2">
                            Cómo vamos a trabajar
                        </h3>
                        <ul class="space-y-1.5 text-sm text-slate-600 lista-ok">
                            <li>70% práctica, 30% explicación</li>
                            <li>Con ejemplos reales de ustedes</li>
                            <li>La IA propone, la persona valida siempre</li>
                        </ul>
                    </div>
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm"
                    >
                        <h3 class="text-sm font-semibold text-slate-500 mb-2">
                            Formación
                        </h3>
                        <div class="flex flex-wrap gap-1.5">
                            {
                                [
                                    "Design Thinking",
                                    "Scrum Master",
                                    "User Story Mapping",
                                    "Product-Led Growth",
                                ].map((f) => (
                                    <span class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded text-[11px] font-medium">
                                        {f}
                                    </span>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 04 LO QUE NOS DIJERON -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-white"
        >
            <div class="max-w-5xl w-full">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-2"
                >
                    Su formulario
                </p>
                <h2
                    class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-2"
                >
                    Lo que nos dijeron
                </h2>
                <div class="w-10 h-1 bg-teal-600 rounded-full mb-5"></div>
                <div class="grid md:grid-cols-3 gap-4">
                    <div class="space-y-4">
                        <div
                            class="bg-slate-50 border border-slate-200 rounded-lg p-4"
                        >
                            <h3 class="text-xs font-bold text-slate-500 mb-2">
                                A qué se dedican
                            </h3>
                            <p class="text-xs text-slate-700 leading-relaxed">
                                Ayudan a sus clientes a tomar el control de los
                                procesos de cara al cliente: gestión de leads,
                                proceso comercial y servicio al cliente.
                                Atienden empresas medianas y maduras de
                                Servicios, Distribución y Manufactura en
                                Latinoamérica.
                            </p>
                        </div>
                        <div
                            class="bg-slate-50 border border-slate-200 rounded-lg p-4"
                        >
                            <h3 class="text-xs font-bold text-slate-500 mb-2">
                                Dónde están hoy
                            </h3>
                            <ul class="text-xs text-slate-700 space-y-1">
                                <li>
                                    Usan ChatGPT, Gemini, Claude, Cursor y
                                    NotebookLM
                                </li>
                                <li>Cuentas aprobadas por la empresa</li>
                                <li>Aún sin política de uso de IA</li>
                                <li>Comodidad general: 3 de 5</li>
                            </ul>
                        </div>
                    </div>
                    <div class="space-y-4">
                        <div
                            class="bg-teal-50 border border-teal-200 rounded-lg p-4"
                        >
                            <h3 class="text-xs font-bold text-teal-700 mb-2">
                                Tareas rutinarias que quieren mejorar
                            </h3>
                            <ol
                                class="text-sm text-slate-800 space-y-1 list-decimal list-inside"
                            >
                                <li>Responder emails</li>
                                <li>Documentación de proyectos</li>
                                <li>Informes y actas</li>
                            </ol>
                        </div>
                        <div
                            class="bg-teal-50 border border-teal-200 rounded-lg p-4"
                        >
                            <h3 class="text-xs font-bold text-teal-700 mb-2">
                                Casos para el taller
                            </h3>
                            <ol
                                class="text-sm text-slate-800 space-y-1 list-decimal list-inside"
                            >
                                <li>Toma de requerimientos</li>
                                <li>Triage de casos de soporte y diagnóstico inicial</li>
                                <li>
                                    Proyección de facturación vinculada con
                                    oportunidades
                                </li>
                            </ol>
                        </div>
                    </div>
                    <div class="space-y-4">
                        <div
                            class="bg-emerald-50 border border-emerald-200 rounded-lg p-4"
                        >
                            <h3 class="text-xs font-bold text-emerald-700 mb-2">
                                Lo que les ha funcionado
                            </h3>
                            <p class="text-xs text-slate-700 leading-relaxed">
                                Ahorro de tiempo, optimización de tareas
                                operativas y repetitivas, estructurar
                                requerimientos y apoyo para aprender
                                herramientas nuevas.
                            </p>
                        </div>
                        <div
                            class="bg-orange-50 border border-orange-200 rounded-lg p-4"
                        >
                            <h3 class="text-xs font-bold text-orange-700 mb-2">
                                Lo que se les ha complicado
                            </h3>
                            <p class="text-xs text-slate-700 leading-relaxed">
                                Contextos muy grandes, bugs complejos, elementos
                                visuales avanzados y decisiones críticas que
                                necesitan criterio humano.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 05 POR QUÉ UNAS COSAS FUNCIONAN Y OTRAS NO -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-slate-50"
        >
            <div class="max-w-4xl w-full">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-2"
                >
                    Fundamentos
                </p>
                <h2
                    class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-2"
                >
                    Por qué unas cosas funcionan y otras no
                </h2>
                <div class="w-10 h-1 bg-teal-600 rounded-full mb-5"></div>
                <p class="text-base text-slate-600 mb-6">
                    Lo que ustedes ya vivieron tiene una explicación.
                </p>
                <div class="grid md:grid-cols-2 gap-6">
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-5 shadow-sm"
                    >
                        <h3 class="text-sm font-bold text-emerald-600 mb-3">
                            Funciona cuando
                        </h3>
                        <ul class="space-y-2 text-sm text-slate-600 lista-ok">
                            <li>La tarea es acotada y se repite</li>
                            <li>Hay un procedimiento o un ejemplo de cómo se hace</li>
                            <li>
                                El resultado es estructurado: tabla, acta, listado
                            </li>
                            <li>Una persona revisa antes de usarlo</li>
                        </ul>
                    </div>
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-5 shadow-sm"
                    >
                        <h3 class="text-sm font-bold text-orange-600 mb-3">
                            Se complica cuando
                        </h3>
                        <ul class="space-y-2 text-sm text-slate-600 lista-no">
                            <li>
                                Le damos un contexto enorme y sin organizar
                            </li>
                            <li>
                                Pedimos algo que exige seguir muchas piezas a la
                                vez, como un bug complejo
                            </li>
                            <li>
                                Esperamos un resultado visual avanzado de un
                                solo intento
                            </li>
                            <li>
                                La decisión es crítica y nadie pone criterio
                            </li>
                        </ul>
                    </div>
                </div>
                <div
                    class="mt-6 text-center p-4 bg-white rounded-lg border border-slate-200"
                >
                    <p class="text-lg font-semibold text-slate-800">
                        La IA sugiere. <span class="text-teal-600"
                            >Ustedes deciden.</span
                        >
                    </p>
                </div>
            </div>
        </section>

        <!-- 06 DOLORES DEL EQUIPO (captura en vivo) -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-white"
        >
            <div class="max-w-5xl w-full">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-2"
                >
                    Dinámica
                </p>
                <h2
                    class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-2"
                >
                    ¿Dónde pierden más tiempo?
                </h2>
                <div class="w-10 h-1 bg-teal-600 rounded-full mb-5"></div>
                <div class="grid md:grid-cols-5 gap-6">
                    <div class="md:col-span-3">
                        <p class="text-sm text-slate-600 mb-4 leading-relaxed">
                            Cada persona cuenta hasta 3 tareas que le quitan
                            tiempo. Para cada una:
                        </p>
                        <ul class="space-y-2 text-sm text-slate-700 lista-ok mb-5">
                            <li>Qué es, con sus palabras</li>
                            <li>Su rol y cuántas horas a la semana le dedica</li>
                            <li>Cada cuánto la hace</li>
                            <li>Si existe un procedimiento escrito</li>
                            <li>Si el resultado es una tabla, un documento o un listado</li>
                        </ul>
                        <p class="text-xs text-slate-500 leading-relaxed">
                            Sin nombres de clientes ni datos sensibles. Mientras
                            vemos lo que sigue, agrupamos lo que llegue para ver
                            dónde está el dolor.
                        </p>
                    </div>
                    <div class="md:col-span-2">
                        <div
                            class="bg-slate-900 text-white rounded-xl p-5 mb-4"
                        >
                            <p
                                class="text-[11px] uppercase tracking-wider text-slate-400 mb-1"
                            >
                                Entra en
                            </p>
                            <p
                                class="text-2xl md:text-3xl font-extrabold tracking-tight break-all"
                            >
                                {urlAportar}
                            </p>
                        </div>
                        <div
                            class="bg-teal-50 border border-teal-200 rounded-xl p-5 text-center"
                        >
                            <p
                                id="dolores-total"
                                class="text-5xl font-extrabold text-teal-700"
                            >
                                0
                            </p>
                            <p class="text-xs text-slate-600 mt-1">
                                dolores recibidos
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 07 CHAT VS AGENTE -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-slate-50"
        >
            <div class="max-w-4xl w-full">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-2"
                >
                    Contexto
                </p>
                <h2
                    class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-2"
                >
                    Del chat suelto al agente con contexto
                </h2>
                <div class="w-10 h-1 bg-teal-600 rounded-full mb-6"></div>
                <div class="grid md:grid-cols-2 gap-4 mb-5">
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm"
                    >
                        <h3 class="text-sm font-semibold text-slate-800 mb-2">
                            Chat tradicional
                        </h3>
                        <ul class="space-y-1.5 text-xs text-slate-600 lista-no">
                            <li>Responde con lo que sabe en general</li>
                            <li>Puede inventar datos con total seguridad</li>
                            <li>No conoce su empresa ni sus procesos</li>
                            <li>
                                Si le pegan demasiado, se pierde y mezcla cosas
                            </li>
                        </ul>
                    </div>
                    <div
                        class="bg-white border-2 border-teal-500 rounded-lg p-4 shadow-sm"
                    >
                        <h3 class="text-sm font-semibold text-teal-600 mb-2">
                            Agente con sus documentos (NotebookLM)
                        </h3>
                        <ul class="space-y-1.5 text-xs text-slate-600 lista-ok">
                            <li>Responde con base en las fuentes que suben</li>
                            <li>Muestra de dónde sacó cada respuesta</li>
                            <li>
                                Conoce sus procedimientos, plantillas y actas
                                anteriores
                            </li>
                            <li>Mantiene el contexto entre preguntas</li>
                        </ul>
                    </div>
                </div>
                <div class="bg-white border border-slate-200 rounded-lg p-4">
                    <h3 class="text-sm font-semibold text-slate-800 mb-3">
                        Cuando el contexto es muy grande
                    </h3>
                    <div class="grid md:grid-cols-3 gap-3 text-xs text-slate-600">
                        <p>
                            <strong class="text-slate-800 block mb-0.5"
                                >Dividan por tema</strong
                            >
                            Una fuente por asunto, no un solo archivo con todo.
                        </p>
                        <p>
                            <strong class="text-slate-800 block mb-0.5"
                                >Pidan la fuente</strong
                            >
                            Que indique de dónde sale cada dato para poder verificarlo.
                        </p>
                        <p>
                            <strong class="text-slate-800 block mb-0.5"
                                >Trabajen por etapas</strong
