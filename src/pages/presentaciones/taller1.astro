---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Aprendamos y apliquemos la Inteligencia Artificial | LuciRMe AI">
    <!-- Botón de Pantalla Completa (NUEVO) -->
    <button
        id="fullscreen-btn"
        class="fixed top-6 left-6 z-50 bg-white/80 backdrop-blur-sm p-2.5 rounded-full border border-slate-200 shadow-sm hover:bg-slate-100 transition-colors text-slate-600"
        aria-label="Pantalla completa"
    >
        <!-- Icono Entrar (se cambia por JS) -->
        <svg
            id="fs-icon-enter"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
                d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
            ></path></svg
        >
        <!-- Icono Salir (oculto por defecto) -->
        <svg
            id="fs-icon-exit"
            class="hidden"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
                d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"
            ></path></svg
        >
    </button>

    <!-- Contador de slides (Fijo) -->
    <div
        class="fixed top-6 right-6 text-xs font-semibold text-slate-500 bg-white/80 backdrop-blur-sm px-3 py-1.5 rounded-full border border-slate-200 shadow-sm z-50"
    >
        <span id="current">01</span> / <span id="total">12</span>
    </div>

    <!-- Nav Dots (Fijos) -->
    <nav
        class="fixed right-6 top-1/2 -translate-y-1/2 flex flex-col gap-2 z-50 bg-white/80 backdrop-blur-sm p-2 rounded-full border border-slate-200 shadow-sm"
        id="navDots"
    >
    </nav>

    <!-- Slider Principal -->
    <main
        class="h-screen overflow-y-auto snap-y snap-mandatory scroll-smooth"
        id="slider"
    >
        <!-- SLIDE 01: PORTADA -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-slate-50 relative"
        >
            <div class="max-w-4xl w-full text-center">
                <div
                    class="inline-flex items-center gap-2 bg-white border border-slate-200 px-4 py-1.5 rounded-full text-xs text-slate-600 font-medium mb-6 shadow-sm"
                >
                    <span
                        class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"
                    ></span>
                    Taller Práctico · 1 de julio 2026 · 9:00 AM
                </div>
                <h1
                    class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4"
                >
                    IA Aplicada:<br />
                    <span
                        class="bg-gradient-to-r from-teal-600 to-emerald-500 bg-clip-text text-transparent"
                        >Aprendamos y apliquemos la Inteligencia Artificial
                    </span>
                </h1>
                <p class="text-base text-slate-600 max-w-xl mx-auto mb-6">
                    Un recorrido práctico para que tú y tu equipo decidan qué
                    aplicar. Sin teoría vacía. Sin herramientas que no usan.
                </p>
                <div class="flex flex-wrap justify-center gap-2 mb-8">
                    <span
                        class="bg-white border border-slate-200 px-3 py-1 rounded-md text-xs font-medium text-slate-700 shadow-sm"
                        >Almamotor SAS</span
                    >
                    <span
                        class="bg-white border border-slate-200 px-3 py-1 rounded-md text-xs font-medium text-slate-700 shadow-sm"
                        >Mobila BLE SAS</span
                    >
                    <span
                        class="bg-white border border-slate-200 px-3 py-1 rounded-md text-xs font-medium text-slate-700 shadow-sm"
                        >Agropecuaria la Isla</span
                    >
                </div>
                <div>
                    <p
                        class="text-xs text-slate-500 uppercase tracking-wider font-semibold"
                    >
                        Facilitador
                    </p>
                    <p class="text-lg font-bold text-slate-900 mt-1">
                        Pablo Ríos Peña
                    </p>
                    <p class="text-xs text-slate-500">
                        Head of Product · Consultor en IA & Product Strategy
                    </p>
                </div>
            </div>
            <div
                class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center text-slate-400 text-xs animate-bounce"
            >
                <span>Desplázate</span>
                <span class="text-lg">↓</span>
            </div>
        </section>

        <!-- SLIDE 02: ROMPEHIELOS -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-white"
        >
            <div class="max-w-4xl w-full">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-2"
                >
                    🧊 Apertura y Conexión
                </p>
                <h2
                    class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-2"
                >
                    ¿Cuándo usaste IA<br />por última vez?
                </h2>
                <div class="w-10 h-1 bg-teal-600 rounded-full mb-4"></div>
                <p class="text-base text-slate-600 mb-6">
                    Probablemente hoy. Sin saberlo.
                </p>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-lg p-4 text-center hover:border-teal-500 transition-colors"
                    >
                        <span class="text-2xl block mb-1">🎵</span>
                        <span class="text-xs font-semibold text-slate-800"
                            >Spotify</span
                        >
                        <p class="text-[10px] text-slate-500 mt-0.5">
                            Descubre música
                        </p>
                    </div>
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-lg p-4 text-center hover:border-teal-500 transition-colors"
                    >
                        <span class="text-2xl block mb-1">🗺️</span>
                        <span class="text-xs font-semibold text-slate-800"
                            >Maps</span
                        >
                        <p class="text-[10px] text-slate-500 mt-0.5">
                            Rutas en tiempo real
                        </p>
                    </div>
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-lg p-4 text-center hover:border-teal-500 transition-colors"
                    >
                        <span class="text-2xl block mb-1">🎬</span>
                        <span class="text-xs font-semibold text-slate-800"
                            >Netflix</span
                        >
                        <p class="text-[10px] text-slate-500 mt-0.5">
                            Recomendaciones
                        </p>
                    </div>
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-lg p-4 text-center hover:border-teal-500 transition-colors"
                    >
                        <span class="text-2xl block mb-1">📹</span>
                        <span class="text-xs font-semibold text-slate-800"
                            >Cámaras</span
                        >
                        <p class="text-[10px] text-slate-500 mt-0.5">
                            Enfoque automático
                        </p>
                    </div>
                </div>
                <div
                    class="bg-teal-50 border-l-4 border-teal-500 rounded-r-lg p-4"
                >
                    <p class="text-sm text-slate-700">
                        Si confías en que estas herramientas aprendan de ti para
                        ayudarte, puedes confiar en la IA para optimizar <strong
                            >tu flujo de trabajo</strong
                        >.
                    </p>
                </div>
            </div>
        </section>

        <!-- SLIDE 03: QUIÉN SOY -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-slate-50"
        >
            <div
                class="max-w-4xl w-full grid md:grid-cols-2 gap-8 items-center"
            >
                <div>
                    <p
                        class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-2"
                    >
                        👨‍💼 Tu facilitador
                    </p>
                    <h2
                        class="text-3xl font-bold text-slate-900 tracking-tight mb-2"
                    >
                        Pablo Ríos Peña
                    </h2>
                    <div class="w-10 h-1 bg-teal-600 rounded-full mb-4"></div>
                    <blockquote
                        class="text-base italic text-slate-600 border-l-2 border-teal-500 pl-4 mb-4"
                    >
                        "Mejorar la vida de las personas con tecnología. Ese es
                        el propósito."
                    </blockquote>
                    <p class="text-sm text-slate-600 leading-relaxed mb-4">
                        No vengo a vender herramientas. Vengo a compartir lo que
                        me ha funcionado para que tú y tu equipo decidan qué
                        aplicar.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span
                            class="bg-teal-100 text-teal-700 px-2.5 py-1 rounded-full text-[10px] font-semibold"
                            >12+ años PM</span
                        >
                        <span
                            class="bg-orange-100 text-orange-700 px-2.5 py-1 rounded-full text-[10px] font-semibold"
                            >IA desde 2021</span
                        >
                        <span
                            class="bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded-full text-[10px] font-semibold"
                            >Fundador LuciRMe</span
                        >
                    </div>
                </div>
                <div class="space-y-3">
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm"
                    >
                        <h3 class="text-sm font-semibold text-teal-600 mb-2">
                            Lo que traigo a esta sesión
                        </h3>
                        <ul
                            class="space-y-1.5 text-sm text-slate-600 custom-check-list"
                        >
                            <li>
                                Enfoque práctico: 70% aplicación, 30% teoría
                            </li>
                            <li>Herramientas 100% gratuitas</li>
                            <li>Rigor ingenieril: validación humana siempre</li>
                            <li>
                                Propiedad intelectual: tú eres dueño de tus
                                mejoras, todas quedan en tus equipos o en
                                Lucirme.
                            </li>
                        </ul>
                    </div>
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm"
                    >
                        <h3 class="text-sm font-semibold text-slate-500 mb-2">
                            Formación
                        </h3>
                        <div class="flex flex-wrap gap-1.5">
                            <span
                                class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded text-[10px] font-medium"
                                >Design Thinking</span
                            >
                            <span
                                class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded text-[10px] font-medium"
                                >Scrum Master</span
                            >
                            <span
                                class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded text-[10px] font-medium"
                                >User Story Mapping</span
                            >
                            <span
                                class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded text-[10px] font-medium"
                                >Product-Led Growth</span
                            >
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SLIDE 04: IA SIN TECNICISMOS -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-white"
        >
            <div class="max-w-4xl w-full">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-2"
                >
                    🧠 Fundamentos
                </p>
                <h2
                    class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-2"
                >
                    IA sin tecnicismos
                </h2>
                <div class="w-10 h-1 bg-teal-600 rounded-full mb-4"></div>
                <p class="text-base text-slate-600 mb-6">
                    Conceptos claros, en palabras cortas.
                </p>
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <h3 class="text-sm font-bold text-emerald-600 mb-2">
                            ✅ Qué ES
                        </h3>
                        <ul
                            class="space-y-1.5 text-sm text-slate-600 custom-check-list"
                        >
                            <li>Herramienta que aprende patrones</li>
                            <li>Asistente que sugiere, no decide</li>
                            <li>Motor que acelera tu flujo</li>
                            <li>Espejo que organiza tu conocimiento</li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-red-500 mb-2">
                            ❌ Qué NO es
                        </h3>
                        <ul
                            class="space-y-1.5 text-sm text-slate-600 custom-x-list"
                        >
                            <li>No piensa como humano</li>
                            <li>No tiene criterio propio</li>
                            <li>No reemplaza tu juicio</li>
                            <li>No es magia: es estadística</li>
                        </ul>
                    </div>
                </div>
                <div
                    class="mt-6 text-center p-4 bg-slate-50 rounded-lg border border-slate-200"
                >
                    <p class="text-base font-semibold text-slate-800">
                        Potencia tu criterio, <span class="text-teal-600"
                            >no lo reemplaza</span
                        >.
                    </p>
                    <p class="text-xs text-slate-500 mt-1">
                        La IA te devuelve tiempo para hacer más de lo que solo
                        tú puedes hacer: interpretar, decidir, innovar.
                    </p>
                </div>
            </div>
        </section>

        <!-- SLIDE 05: REGLA DE ORO -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-slate-50"
        >
            <div class="max-w-4xl w-full text-center">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-4"
                >
                    ⚖️ La Regla de Oro
                </p>
                <h2
                    class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-6 bg-gradient-to-r from-teal-600 to-emerald-500 bg-clip-text text-transparent"
                >
                    La IA sugiere.<br />Tú decides.
                </h2>
                <div class="w-10 h-1 bg-teal-600 rounded-full mx-auto mb-6">
                </div>
                <p class="text-base text-slate-600 max-w-lg mx-auto mb-8">
                    Tú eres la última línea de defensa. Valida siempre.<br />
                    <strong class="text-slate-900"
                        >Confía, pero verifica.</strong
                    > Tu experiencia es irreemplazable.
                </p>
                <div
                    class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-2xl mx-auto"
                >
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-4 text-left shadow-sm"
                    >
                        <span class="text-xl block mb-1">🔍</span>
                        <h3 class="text-sm font-semibold text-slate-800 mb-1">
                            Revisa
                        </h3>
                        <p class="text-xs text-slate-500">
                            La IA puede inventar datos. Siempre verifica cifras.
                        </p>
                    </div>
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-4 text-left shadow-sm"
                    >
                        <span class="text-xl block mb-1">🧠</span>
                        <h3 class="text-sm font-semibold text-slate-800 mb-1">
                            Interpreta
                        </h3>
                        <p class="text-xs text-slate-500">
                            El contexto de tu empresa solo tú lo conoces.
                        </p>
                    </div>
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-4 text-left shadow-sm"
                    >
                        <span class="text-xl block mb-1">✅</span>
                        <h3 class="text-sm font-semibold text-slate-800 mb-1">
                            Decide
                        </h3>
                        <p class="text-xs text-slate-500">
                            La recomendación final siempre es tuya.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SLIDE 06: KIT GRATUITO -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-white"
        >
            <div class="max-w-4xl w-full">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-2"
                >
                    🧰 Herramientas
                </p>
                <h2
                    class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-2"
                >
                    Tu kit gratuito
                </h2>
                <div class="w-10 h-1 bg-teal-600 rounded-full mb-4"></div>
                <p class="text-base text-slate-600 mb-6">
                    100% gratuitas. Sin tarjeta de crédito. Sin excusas.
                </p>
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-lg p-3 text-center hover:border-teal-500 transition-colors"
                    >
                        <span class="text-xl block mb-1">📓</span>
                        <span class="text-xs font-bold text-slate-800 block"
                            >NotebookLM</span
                        >
                        <span class="text-[10px] text-slate-500"
                            >Agente conversacional con contexto</span
                        >
                    </div>
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-lg p-3 text-center hover:border-teal-500 transition-colors"
                    >
                        <span class="text-xl block mb-1">💬</span>
                        <span class="text-xs font-bold text-slate-800 block"
                            >ChatGPT</span
                        >
                        <span class="text-[10px] text-slate-500"
                            >Redacción y análisis</span
                        >
                    </div>
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-lg p-3 text-center hover:border-teal-500 transition-colors"
                    >
                        <span class="text-xl block mb-1">💎</span>
                        <span class="text-xs font-bold text-slate-800 block"
                            >Gemini</span
                        >
                        <span class="text-[10px] text-slate-500"
                            >Deep Research</span
                        >
                    </div>
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-lg p-3 text-center hover:border-teal-500 transition-colors"
                    >
                        <span class="text-xl block mb-1">🔮</span>
                        <span class="text-xs font-bold text-slate-800 block"
                            >Qwen</span
                        >
                        <span class="text-[10px] text-slate-500"
                            >Razonamiento</span
                        >
                    </div>
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-lg p-3 text-center hover:border-teal-500 transition-colors"
                    >
                        <span class="text-xl block mb-1">🔎</span>
                        <span class="text-xs font-bold text-slate-800 block"
                            >Perplexity</span
                        >
                        <span class="text-[10px] text-slate-500"
                            >Búsqueda con fuentes</span
                        >
                    </div>
                </div>
                <div class="mt-6 flex items-center gap-3 flex-wrap">
                    <a
                        target="_blank"
                        href="https://lucirme.com/recursos/prompteador"
                        class="inline-flex items-center gap-1.5 bg-teal-600 text-white px-4 py-2 rounded-md text-xs font-semibold hover:bg-teal-700 transition-colors shadow-sm"
                    >
                        🔗 Link al Prompteador
                    </a>
                    <span class="text-xs text-slate-500"
                        >Tu fórmula para pedirle cosas a la IA</span
                    >
                </div>
            </div>
        </section>

        <!-- SLIDE 07: CHAT VS AGENTE -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-slate-50"
        >
            <div class="max-w-4xl w-full">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-2"
                >
                    🤖 Agentes de IA
                </p>
                <h2
                    class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-2"
                >
                    De la búsqueda manual<br />a la respuesta con <span
                        class="text-teal-600">contexto</span
                    >
                </h2>
                <div class="w-10 h-1 bg-teal-600 rounded-full mb-6"></div>
                <div class="grid md:grid-cols-2 gap-4 mb-6">
                    <div
                        class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm"
                    >
                        <span class="text-xl block mb-2">💬</span>
                        <h3 class="text-sm font-semibold text-slate-800 mb-2">
                            Chat tradicional
                        </h3>
                        <ul
                            class="space-y-1.5 text-xs text-slate-600 custom-x-list"
                        >
                            <li>Responde con lo que sabe de internet</li>
                            <li>Puede alucinar o inventar datos</li>
                            <li>No conoce tu empresa</li>
                            <li>Cada pregunta empieza de cero</li>
                        </ul>
                    </div>
                    <div
                        class="bg-white border-2 border-teal-500 rounded-lg p-4 shadow-sm"
                    >
                        <span class="text-xl block mb-2">🤖</span>
                        <h3 class="text-sm font-semibold text-teal-600 mb-2">
                            Agente (NotebookLM)
                        </h3>
                        <ul
                            class="space-y-1.5 text-xs text-slate-600 custom-check-list"
                        >
                            <li>Responde solo con tus documentos</li>
                            <li>100% controlado y verificable</li>
                            <li>Conoce tus políticas y procesos</li>
                            <li>Mantiene contexto siempre</li>
                        </ul>
                    </div>
                </div>
                <div
                    class="bg-orange-50 border-l-4 border-orange-500 rounded-r-lg p-4"
                >
                    <p class="text-xs text-slate-700">
                        <strong>Caso real:</strong> Subir manuales de conciliación
                        bancaria y políticas contables → Preguntarle al agente paso
                        a paso cómo proceder ante cada diferencia.
                    </p>
                </div>
            </div>
        </section>

        <!-- SLIDE 08: DEMO EN VIVO -->
        <section
            class="min-h-screen snap-start flex items-center justify-center p-8 bg-white"
        >
            <div class="max-w-4xl w-full text-center">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-teal-600 mb-2"
                >
                    💻 Demo en Vivo
                </p>
                <h2
                    class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-2"
                >
                    Manos a la obra
                </h2>
                <div class="w-10 h-1 bg-teal-600 rounded-full mx-auto mb-4">
                </div>
                <p class="text-base text-slate-600 mb-8">
                    Vamos a crear un agente juntos, ahora mismo.
                </p>

                <div
                    class="flex flex-col md:flex-row items-center justify-center gap-4 mb-8"
                >
                    <div class="flex flex-col items-center">
                        <div
                            class="w-10 h-10 rounded-full bg-teal-50 border-2 border-teal-500 flex items-center justify-center text-sm font-bold text-teal-600 mb-2"
                        >
                            1
                        </div>
                        <span class="text-xs font-semibold text-slate-800"
                            >Crear Cuaderno</span
                        >
                    </div>
                    <div class="hidden md:block w-12 h-0.5 bg-slate-200"></div>
