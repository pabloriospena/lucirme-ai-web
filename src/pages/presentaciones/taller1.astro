    <!-- Estilos mínimos para Scroll Snap y Listas personalizadas -->
    <style is:global>
        .custom-check-list li::before {
            content: "✓";
            color: #10b981; /* emerald-500 */
            font-weight: 700;
            margin-right: 0.5rem;
        }
        .custom-x-list li::before {
            content: "✕";
            color: #ef4444; /* red-500 */
            font-weight: 700;
            margin-right: 0.5rem;
        }
        /* Ocultar scrollbar pero mantener funcionalidad */
        main::-webkit-scrollbar {
            display: none;
        }
        main {
            scrollbar-width: none;
        }
    </style>
    <script>
        const slider = document.getElementById("slider") as HTMLElement | null;
        const slides = document.querySelectorAll("section");
        const navDots = document.getElementById(
            "navDots",
        ) as HTMLElement | null;
        const currentEl = document.getElementById(
            "current",
        ) as HTMLElement | null;
        const totalEl = document.getElementById("total") as HTMLElement | null;

        // --- LÓGICA DE PANTALLA COMPLETA ---
        const fsBtn = document.getElementById(
            "fullscreen-btn",
        ) as HTMLElement | null;
        const fsIconEnter = document.getElementById(
            "fs-icon-enter",
        ) as HTMLElement | null;
        const fsIconExit = document.getElementById(
            "fs-icon-exit",
        ) as HTMLElement | null;

        if (fsBtn && fsIconEnter && fsIconExit) {
            fsBtn.addEventListener("click", () => {
                if (!document.fullscreenElement) {
                    document.documentElement
                        .requestFullscreen()
                        .catch((err) => {
                            console.log(
                                `Error al activar pantalla completa: ${err.message}`,
                            );
                        });
                } else {
                    document.exitFullscreen();
                }
            });

            document.addEventListener("fullscreenchange", () => {
                if (document.fullscreenElement) {
                    fsIconEnter.classList.add("hidden");
                    fsIconExit.classList.remove("hidden");
                    fsBtn.setAttribute(
                        "aria-label",
                        "Salir de pantalla completa",
                    );
                } else {
                    fsIconEnter.classList.remove("hidden");
                    fsIconExit.classList.add("hidden");
                    fsBtn.setAttribute("aria-label", "Pantalla completa");
                }
            });
        }
        // ---------------------------------------------

        if (slider && navDots && currentEl && totalEl && slides.length > 0) {
            totalEl.textContent = String(slides.length).padStart(2, "0");

            // Create nav dots
            slides.forEach((_, i) => {
                const dot = document.createElement("button");
                dot.className =
                    "w-2 h-2 rounded-full bg-slate-300 border-none cursor-pointer transition-all p-0 hover:bg-slate-400";
                if (i === 0) {
                    dot.classList.add("bg-teal-500", "h-6", "rounded");
                }
                dot.setAttribute("aria-label", `Ir a diapositiva ${i + 1}`);
                dot.addEventListener("click", () => {
                    slides[i].scrollIntoView({ behavior: "smooth" });
                });
                navDots.appendChild(dot);
            });

            const dots = document.querySelectorAll("#navDots button");

            // Update active dot & counter on scroll
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            // 👇 FIX: Agregamos 'as HTMLElement' para que TS no se queje
                            const index = [...slides].indexOf(
                                entry.target as HTMLElement,
                            );

                            dots.forEach((d, i) => {
                                if (i === index) {
                                    d.className =
                                        "w-2 h-6 rounded bg-teal-500 border-none cursor-pointer transition-all p-0";
                                } else {
                                    d.className =
                                        "w-2 h-2 rounded-full bg-slate-300 border-none cursor-pointer transition-all p-0 hover:bg-slate-400";
                                }
                            });
                            currentEl.textContent = String(index + 1).padStart(
                                2,
                                "0",
                            );
                        }
                    });
                },
                { root: slider, threshold: 0.6 },
            );

            slides.forEach((slide) => observer.observe(slide));

            // Keyboard navigation
            document.addEventListener("keydown", (e) => {
                if (
                    e.target instanceof HTMLInputElement ||
                    e.target instanceof HTMLTextAreaElement
                )
                    return;

                const slideHeight = window.innerHeight;
                if (e.key === "ArrowDown" || e.key === "ArrowRight") {
                    e.preventDefault();
                    slider.scrollBy({ top: slideHeight, behavior: "smooth" });
                } else if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
                    e.preventDefault();
                    slider.scrollBy({ top: -slideHeight, behavior: "smooth" });
                } else if (e.key === "f" || e.key === "F") {
                    fsBtn?.click();
                } else if (e.key === "Escape" && document.fullscreenElement) {
                    document.exitFullscreen();
                }
            });
        }
    </script>
