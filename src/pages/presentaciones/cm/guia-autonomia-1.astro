<Layout title="Guía sesión de autonomía 1 | Seguros CM" hideHeader hideFooter noindex>
    <div class="min-h-screen bg-[#FBFBFA] text-[#37352F] font-sans antialiased selection:bg-slate-200">
        <!-- BARRA SUPERIOR -->
        <div class="w-full bg-white border-b border-[#E9E9E7] px-4 py-3 sticky top-0 z-30 flex items-center justify-between text-xs text-[#787774] print:hidden">
            <div class="flex items-center gap-2 overflow-hidden">
                <span class="font-medium shrink-0">LuciRMe AI</span>
                <span>/</span>
                <span class="font-medium shrink-0">Seguros CM</span>
                <span>/</span>
                <span class="text-[#37352F] font-semibold truncate">Guía sesión de autonomía 1</span>
            </div>
            <button
                type="button"
                onclick="window.print()"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded border border-[#E9E9E7] hover:bg-[#F1F1EF] transition text-[#37352F] font-medium text-xs cursor-pointer shrink-0"
            >
                <svg class="w-3.5 h-3.5 text-[#787774]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                </svg>
                <span class="hidden sm:inline">Exportar / Imprimir</span>
            </button>
        </div>

        <div class="max-w-5xl mx-auto px-6 py-10 md:py-14 grid grid-cols-1 lg:grid-cols-12 gap-10">
            <!-- TABLA DE CONTENIDO -->
            <aside class="hidden lg:block lg:col-span-3 sticky top-20 self-start text-xs text-[#787774] print:hidden">
                <div class="text-[11px] font-semibold uppercase tracking-wider text-[#9B9A97] mb-2">En esta guía</div>
                <nav class="space-y-1 font-medium">
                    {toc.map((t) => (
                        <a href={`#${t.id}`} class="block px-2.5 py-1.5 rounded hover:bg-[#F1F1EF] hover:text-[#37352F] transition">
                            {t.label}
                        </a>
                    ))}
                </nav>
            </aside>

            <main class="lg:col-span-9 space-y-12 min-w-0">
                <!-- ENCABEZADO -->
                <header class="space-y-6 pb-6 border-b border-[#E9E9E7]">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl bg-[#F1F1EF] border border-[#E9E9E7] flex items-center justify-center text-[#37352F] shadow-2xs shrink-0">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                        </div>
                        <div>
                            <span class="text-xs font-mono uppercase tracking-widest text-[#9B9A97]">Guía post-sesión</span>
                            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#37352F] tracking-tight">
                                Renovaciones y cobro con IA: paso a paso
                            </h1>
                        </div>
                    </div>

                    <div class="bg-[#F7F7F5] border border-[#E9E9E7] rounded-lg p-4 text-xs space-y-2">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="flex items-center gap-2">
                                <span class="text-[#9B9A97] w-24 shrink-0 font-medium">Para:</span>
                                <span class="text-[#37352F] font-semibold">Equipo de Seguros CM</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-[#9B9A97] w-24 shrink-0 font-medium">Sesión:</span>
                                <span class="text-[#37352F] font-semibold">Autonomía 1 · 18 de noviembre de 2026</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-[#9B9A97] w-24 shrink-0 font-medium">Elaborado por:</span>
                                <span class="text-[#37352F] font-semibold">Pablo Ríos · LuciRMe AI</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-[#9B9A97] w-24 shrink-0 font-medium">Objetivo:</span>
                                <span class="text-[#37352F] font-semibold">Repetir lo de la sesión sin ayuda</span>
                            </div>
                        </div>
                    </div>

                    <div id="resumen" class="bg-[#F1F1EF] border border-[#E9E9E7] rounded-lg p-4 flex gap-3 text-xs leading-relaxed">
                        <div class="shrink-0 pt-0.5">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <div class="space-y-2">
                            <strong class="font-bold block">Resumen</strong>
                            <p class="text-[#5A5A58]">
                                En la sesión trabajamos tres tareas de renovaciones y cobro, y probamos varias herramientas para que el
                                equipo se familiarizara. Hasta ahora la que más ha gustado es Claude. Esta guía deja cada tarea como un
                                paso a paso, con las herramientas y sus enlaces, los prompts para copiar y lo que hay que revisar.
                            </p>
                            <ul class="text-[#5A5A58] list-disc pl-4 space-y-1">
                                <li><strong class="text-[#37352F]">Correos de renovaciones:</strong> con un cuaderno de NotebookLM y Gemini conectado.</li>
                                <li><strong class="text-[#37352F]">Asignación de renovaciones:</strong> con Claude, a partir del correo mensual, por día.</li>
                                <li><strong class="text-[#37352F]">Redacción de cobro:</strong> con una skill de Claude.</li>
                            </ul>
                            <p class="text-[#787774]">
                                Los prompts son un punto de partida: reemplaza lo que está entre [corchetes] y pruébalos con un caso real
                                antes de darlos por buenos. Lo que hoy se hace a mano, como siniestros, radicados y SOAT, está en la
                                sección 7 como ideas, no como algo ya resuelto.
                            </p>
                        </div>
                    </div>
                </header>

                <!-- 1. HERRAMIENTAS -->
                <section id="herramientas" class="space-y-5">
                    <div class="pb-2 border-b border-[#E9E9E7]">
                        <h2 class="text-lg font-bold">1. Las herramientas que probamos</h2>
                        <p class="text-xs text-[#787774] mt-1">
                            No hace falta dominarlas todas. Cada tarjeta dice qué es, para qué sirve y qué probamos con ella.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {herramientas.map((h) => (
                            <article class="bg-white border border-[#E9E9E7] rounded-lg p-5 space-y-3 shadow-2xs">
                                <div class="flex items-center justify-between gap-2">
                                    <h3 class="text-sm font-bold">{h.nombre}</h3>
                                    <a
                                        href={h.enlace}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-[11px] font-semibold text-teal-700 hover:text-teal-900 underline underline-offset-2 shrink-0"
                                    >
                                        Abrir
                                    </a>
                                </div>
                                <p class="text-xs text-[#37352F] leading-relaxed">{h.que}</p>
                                <dl class="text-xs space-y-1.5 pt-2 border-t border-[#F1F1EF]">
                                    <div>
                                        <dt class="text-[11px] font-semibold uppercase tracking-wider text-[#9B9A97]">Sirve para</dt>
                                        <dd class="text-[#5A5A58]">{h.sirve}</dd>
                                    </div>
                                    <div>
                                        <dt class="text-[11px] font-semibold uppercase tracking-wider text-[#9B9A97]">Qué probamos</dt>
                                        <dd class="text-[#5A5A58]">{h.probamos}</dd>
                                    </div>
                                    <div>
                                        <dt class="text-[11px] font-semibold uppercase tracking-wider text-[#9B9A97]">Ten en cuenta</dt>
                                        <dd class="text-[#5A5A58]">{h.ojo}</dd>
                                    </div>
                                </dl>
                            </article>
                        ))}
                    </div>
                </section>

                <!-- 2. ARMAR EL CUADERNO -->
                <section id="cuaderno" class="space-y-5">
                    <div class="pb-2 border-b border-[#E9E9E7]">
                        <h2 class="text-lg font-bold">2. Armar el cuaderno con la información para redactar el correo</h2>
                        <p class="text-xs text-[#787774] mt-1">
                            Un cuaderno es un espacio con sus propias fuentes: la IA responde a partir de ellas y marca de dónde sacó cada
                            dato. Esto es lo que hace que sirva para correos a clientes, porque puedes comprobar las cifras.
                        </p>
                    </div>

                    <ol class="space-y-3">
                        {cuadernoPasos.map((p, i) => (
                            <li class="bg-white border border-[#E9E9E7] rounded-lg p-4 flex gap-3 shadow-2xs">
                                <div class="w-6 h-6 rounded bg-teal-100 text-teal-800 flex items-center justify-center text-xs font-bold shrink-0">
                                    {i + 1}
                                </div>
                                <div class="space-y-1 min-w-0">
                                    <h3 class="text-sm font-bold">{p.titulo}</h3>
                                    <p class="text-xs text-[#5A5A58] leading-relaxed">{p.detalle}</p>
                                </div>
                            </li>
                        ))}
                    </ol>

                    <PromptBox titulo="Documento de instrucciones para agregar como fuente" prompt={instruccionesCuaderno} />

                    <div class="bg-[#F1F1EF] border border-[#E9E9E7] rounded-lg p-4 text-xs leading-relaxed space-y-1">
                        <strong class="font-bold block">Datos que hay que cuidar al armarlo</strong>
                        <p class="text-[#5A5A58]">
                            Un cuaderno por cliente o por mes, con pocas fuentes y vigentes, funciona mejor que uno con todo. Antes de subir
                            documentos con datos personales, revisa la regla de la sección 8.
                        </p>
                    </div>
                </section>

                <!-- 3. CORREOS DE RENOVACIONES -->
                <section id="correos" class="space-y-5">
                    <div class="pb-2 border-b border-[#E9E9E7]">
                        <h2 class="text-lg font-bold">3. Correos de renovaciones</h2>
                        <p class="text-xs text-[#787774] mt-1">
                            Es la tarea que más tiempo consume en el equipo, y la que probamos con más herramientas: NotebookLM con Gemini
                            conectado, ChatGPT y Copilot.
                        </p>
                    </div>

                    <div class="space-y-3">
                        <h3 class="text-sm font-bold">Camino recomendado: cuaderno de NotebookLM</h3>
                        <p class="text-xs text-[#5A5A58] leading-relaxed">
                            Arma el cuaderno como en la sección 2 y pide el correo. Después, pide la verificación: es el paso que más
                            confianza da.
                        </p>
                        <PromptBox titulo="Pedir el correo" prompt={promptCorreoRenovacion} />
                        <PromptBox titulo="Verificar cifras y fechas" prompt={promptVerificar} />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <article class="bg-white border border-[#E9E9E7] rounded-lg p-5 space-y-2 shadow-2xs">
                            <h3 class="text-sm font-bold">Si prefieres hacerlo desde Gemini</h3>
                            <p class="text-xs text-[#5A5A58] leading-relaxed">
                                Con Gemini conectado al cuaderno puedes pedir el correo desde una conversación de Gemini y usar el mismo
                                cuaderno como fuente. Sirve cuando quieres mezclar la tarea con otras en el mismo lugar. Si no ves los
                                cuadernos en Gemini, probablemente es el plan de la cuenta: trabaja directamente en NotebookLM.
                            </p>
                        </article>
                        <article class="bg-white border border-[#E9E9E7] rounded-lg p-5 space-y-3 shadow-2xs">
                            <h3 class="text-sm font-bold">Si usas ChatGPT o Copilot</h3>
                            <p class="text-xs text-[#5A5A58] leading-relaxed">
                                Estas herramientas no guardan tus documentos como un cuaderno: pega en el chat los datos del caso cada vez.
                                Usa este formato para que la respuesta sea más precisa.
                            </p>
                            <PromptBox prompt={promptSinCuaderno} />
                        </article>
                    </div>

                    <div class="bg-[#F1F1EF] border border-[#E9E9E7] rounded-lg p-4 text-xs leading-relaxed space-y-1">
                        <strong class="font-bold block">Qué revisar antes de enviar</strong>
                        <ul class="text-[#5A5A58] list-disc pl-4 space-y-1">
                            <li>Porcentaje de incremento, deducibles y sublímites: iguales a la fuente.</li>
                            <li>Nombre del cliente y de la aseguradora.</li>
                            <li>Fecha límite para decidir.</li>
                            <li>Que el tono suene a CM Seguros y no a plantilla.</li>
                        </ul>
                    </div>
                </section>

                <!-- 4. ASIGNACIÓN -->
                <section id="asignacion" class="space-y-5">
                    <div class="pb-2 border-b border-[#E9E9E7]">
                        <h2 class="text-lg font-bold">4. Asignación de renovaciones con Claude</h2>
                        <p class="text-xs text-[#787774] mt-1">
                            En la sesión usamos Claude para tomar el correo mensual de renovaciones y armar las asignaciones por día.
                        </p>
                    </div>

                    <ol class="space-y-3">
                        {pasosAsignacion.map((p, i) => (
                            <li class="bg-white border border-[#E9E9E7] rounded-lg p-4 flex gap-3 shadow-2xs">
                                <div class="w-6 h-6 rounded bg-teal-100 text-teal-800 flex items-center justify-center text-xs font-bold shrink-0">
                                    {i + 1}
                                </div>
                                <div class="space-y-1 min-w-0">
                                    <h3 class="text-sm font-bold">{p.titulo}</h3>
                                    <p class="text-xs text-[#5A5A58] leading-relaxed">{p.detalle}</p>
                                </div>
                            </li>
                        ))}
                    </ol>

                    <PromptBox titulo="Pedir la asignación por día" prompt={promptAsignacion} />
                </section>

                <!-- 5. COBRO -->
                <section id="cobro" class="space-y-5">
                    <div class="pb-2 border-b border-[#E9E9E7]">
                        <h2 class="text-lg font-bold">5. Redacción de cobro con una skill de Claude</h2>
                        <p class="text-xs text-[#787774] mt-1">
                            Para los correos de cobro creamos una skill. La ventaja es que todos redactan con el mismo tono y las mismas
                            reglas, sin tener que escribirlas cada vez.
                        </p>
                    </div>

                    <ol class="space-y-3">
                        {pasosCobro.map((p, i) => (
                            <li class="bg-white border border-[#E9E9E7] rounded-lg p-4 flex gap-3 shadow-2xs">
                                <div class="w-6 h-6 rounded bg-teal-100 text-teal-800 flex items-center justify-center text-xs font-bold shrink-0">
                                    {i + 1}
                                </div>
                                <div class="space-y-1 min-w-0">
                                    <h3 class="text-sm font-bold">{p.titulo}</h3>
                                    <p class="text-xs text-[#5A5A58] leading-relaxed">{p.detalle}</p>
                                </div>
                            </li>
                        ))}
                    </ol>

                    <PromptBox titulo="Instrucciones de la skill (ajusta con la política de cartera)" prompt={instruccionesCobro} />
                    <PromptBox titulo="Pedir un correo de cobro" prompt={promptCobro} />
                </section>

                <!-- 6. TOKENS Y COMPARACIÓN -->
                <section id="limites" class="space-y-5">
                    <div class="pb-2 border-b border-[#E9E9E7]">
                        <h2 class="text-lg font-bold">6. Cuando se acaban los tokens: comparación de datos</h2>
                        <p class="text-xs text-[#787774] mt-1">
                            Al comparar datos se agotaron los tokens de Claude. Probamos Qwen para seguir con la comparación, pero el
                            resultado fue regular.
                        </p>
                    </div>

                    <div class="bg-white border border-[#E9E9E7] rounded-lg p-5 space-y-2 shadow-2xs">
                        <h3 class="text-sm font-bold">Qué son los tokens</h3>
                        <p class="text-xs text-[#5A5A58] leading-relaxed">
                            Los tokens son la medida de cuánto texto procesa la IA. En la versión gratis hay un límite de uso, y cuanto más
                            larga es la conversación o más grande el archivo, más rápido se gasta. Cuando se acaba, hay que esperar a que se
                            renueve el cupo o usar otra herramienta.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {ahorroTokens.map((a) => (
                            <div class="bg-white border border-[#E9E9E7] rounded-lg p-4 space-y-1.5 shadow-2xs">
                                <h3 class="text-xs font-bold">{a.titulo}</h3>
                                <p class="text-xs text-[#5A5A58] leading-relaxed">{a.detalle}</p>
                            </div>
                        ))}
                    </div>

                    <PromptBox titulo="Prompt de comparación (por probar con otras herramientas)" prompt={promptComparar} />
                </section>

                <!-- 7. LO QUE HOY ES MANUAL -->
                <section id="manual" class="space-y-5">
                    <div class="pb-2 border-b border-[#E9E9E7]">
                        <h2 class="text-lg font-bold">7. Lo que hoy se hace a mano</h2>
                        <p class="text-xs text-[#787774] mt-1">
                            Estos procesos no se trabajaron con IA en la sesión. Dejo cómo funcionan hoy y por dónde podría empezar la
                            ayuda; son ideas para decidir juntos, no algo ya probado.
                        </p>
                    </div>

                    <div class="space-y-4">
                        {sinHacer.map((s) => (
                            <article class="bg-white border border-[#E9E9E7] rounded-lg p-5 space-y-3 shadow-2xs">
                                <div class="flex items-center justify-between gap-2">
                                    <h3 class="text-sm font-bold">{s.titulo}</h3>
                                    {s.enlace && (
                                        <a
                                            href={s.enlace}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="text-[11px] font-semibold text-teal-700 hover:text-teal-900 underline underline-offset-2 shrink-0"
                                        >
                                            {s.etiqueta}
                                        </a>
                                    )}
                                </div>
                                <dl class="text-xs space-y-2">
                                    <div>
                                        <dt class="text-[11px] font-semibold uppercase tracking-wider text-[#9B9A97]">Hoy</dt>
                                        <dd class="text-[#5A5A58] leading-relaxed">{s.hoy}</dd>
                                    </div>
                                    <div>
                                        <dt class="text-[11px] font-semibold uppercase tracking-wider text-[#9B9A97]">Por dónde podría ayudar la IA</dt>
                                        <dd class="text-[#5A5A58] leading-relaxed">{s.idea}</dd>
                                    </div>
                                </dl>
                            </article>
                        ))}
                    </div>

                    <PromptBox titulo="Ejemplo para el aviso del SOAT a comercial" prompt={promptAvisoSoat} />
                </section>

                <!-- 8. REGLAS -->
                <section id="reglas" class="space-y-5">
                    <div class="pb-2 border-b border-[#E9E9E7]">
                        <h2 class="text-lg font-bold">8. Reglas para todos</h2>
                        <p class="text-xs text-[#787774] mt-1">Seis acuerdos simples que valen para cualquier herramienta.</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {reglas.map((r) => (
                            <div class="bg-white border border-[#E9E9E7] rounded-lg p-4 space-y-1.5 shadow-2xs">
                                <h3 class="text-xs font-bold">{r.titulo}</h3>
                                <p class="text-xs text-[#5A5A58] leading-relaxed">{r.detalle}</p>
                            </div>
                        ))}
                    </div>
                </section>

                <!-- 9. LO QUE SIGUE -->
                <section id="siguiente" class="space-y-5">
                    <div class="pb-2 border-b border-[#E9E9E7]">
                        <h2 class="text-lg font-bold">9. Lo que sigue</h2>
                    </div>

                    <ul class="space-y-3">
                        {pendientes.map((p) => (
                            <li class="bg-white border border-[#E9E9E7] rounded-lg p-4 space-y-1 shadow-2xs">
                                <h3 class="text-sm font-bold">{p.titulo}</h3>
                                <p class="text-xs text-[#5A5A58] leading-relaxed">{p.detalle}</p>
                            </li>
                        ))}
                    </ul>
                </section>
            </main>
        </div>
    </div>
</Layout>

<!-- AVISO DE COPIADO -->
<div
    id="toast"
    class="fixed bottom-5 right-5 z-50 transform translate-y-10 opacity-0 transition-all duration-200 pointer-events-none print:hidden"
>
    <div class="bg-[#37352F] text-white text-xs px-3.5 py-2 rounded-md shadow-lg flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span>Petición copiada al portapapeles</span>
    </div>
</div>

<script>
    const toast = document.getElementById("toast");

    function showToast() {
        if (!toast) return;
        toast.classList.remove("translate-y-10", "opacity-0");
        setTimeout(() => toast.classList.add("translate-y-10", "opacity-0"), 2200);
    }

    document.querySelectorAll<HTMLButtonElement>(".copy-prompt").forEach((btn) => {
        btn.addEventListener("click", async () => {
            const text = btn.dataset.prompt ?? "";
            try {
                await navigator.clipboard.writeText(text);
                showToast();
            } catch {
                // Sin permiso de portapapeles: no se muestra aviso falso.
            }
        });
    });
</script>
