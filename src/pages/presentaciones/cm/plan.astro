      temas:[
        T("Línea base del grupo","Formulario base, 3 nov","Informe de renovaciones: 8 a 10 horas por semana reportadas.","Tabla de partida (horas, frecuencia y calidad del resultado) para comparar en la segunda ronda."),
        T("Reporte mensual de renovaciones en los ramos","Formulario base, caso para el taller","Material disponible: trazabilidad en correos y diligenciamiento manual en cotizadores.","Reporte del mes con porcentaje de incremento, cambios en deducibles o sublímites, mejoras en amparos y cotizaciones de otras aseguradoras, armado con IA y revisado contra las fuentes."),
        T("Instrucciones para repetir el informe","Sesión del 18 nov","Cuaderno de la sesión 1 como modelo.","Instrucciones guardadas para repetir el informe cada mes sin partir de cero.")
      ]}),
    S({num:3,titulo:"Siniestros y radicados",area:"Seguros generales",personas:["Juan Fernando Marín","Sara Restrepo"],
      objetivo:"Reducir el tiempo de lectura de la documentación de siniestros de seguros generales y ordenar los radicados.",
      temas:[
        T("Línea base del grupo","Formulario base, 3 nov","Lectura de documentación de siniestros de seguros generales: una de las tres tareas que más tiempo consumen, sin dato de horas.","Horas por semana medidas en la sesión para comparar en la segunda ronda."),
        T("Lectura de documentación de siniestros","Formulario base, tarea 2","Documentación leída a mano, sin dato de horas.","Resumen de un siniestro real con IA, contrastado con los documentos originales."),
        T("Radicados","Sesión del 18 nov","Siguen a mano.","Procedimiento de radicado escrito y primera prueba con IA.")
      ]}),
    S({num:4,titulo:"Historial y documentos del cliente",area:"Acceso a la información",personas:["Estefany Pérez","Carlos Daniel Osorio Mejía"],
      objetivo:"Encontrar la documentación y el historial de un cliente sin buscar a mano en correos y carpetas.",
      nota:"Depende de que Daniel separe OneDrive de la Nube de Sura para poder conectarlo.",
      temas:[
