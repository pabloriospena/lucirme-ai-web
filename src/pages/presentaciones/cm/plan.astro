var PAGO_ACTIVO = false; // false: el plan no muestra el saldo ni la fecha de pago. Pasa a true cuando Pablo lo indique.
var ENDPOINT = "";     // webhook de Make de CM que guarda el plan en Notion; vacío hasta crearlo
var ENDPOINT_TOKEN = "";

var DIAS = ["domingo","lunes","martes","miércoles","jueves","viernes","sábado"];
var MESES = ["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];
var MESES_C = ["ene","feb","mar","abr","may","jun","jul","ago","sep","oct","nov","dic"];
var HOLIDAYS = {"2026-12-08":"festivo","2026-12-25":"festivo","2027-01-01":"festivo","2027-01-11":"festivo","2027-03-22":"festivo"};
var MONDAYS = [];
(function(){ var d=Date.UTC(2026,10,23); for(var i=0;i<18;i++){ MONDAYS.push(iso(new Date(d+i*7*86400000))); } })();

var ROSTER = [
  ["Carlos Mario Osorio Franco","Gerente fundador"],
  ["Carlos Daniel Osorio Mejía","Director comercial y administrativo, líder de IA"],
  ["Yenni Patricia Giraldo","Líder operativa y de suscripción empresarial"],
  ["Sebastián Fuertes","Analista de negocio empresarial"],
  ["Juan Fernando Marín","Auxiliar de autos y copropiedades"],
  ["Sara Restrepo","Auxiliar de salud y hogar"],
  ["Estefany Pérez","Auxiliar de cartera, cumplimiento y vida"],
  ["Daniela Torres","Externa de comunicación organizacional"]
];

function T(nombre,fuente,inicio,cierre){ return {nombre:nombre,fuente:fuente,inicio:inicio,cierre:cierre}; }

function S(o){ return {num:o.num||null,tipo:o.tipo||"sesion",titulo:o.titulo,area:o.area,duracion:o.duracion||3,semana:o.semana||null,franja:o.franja||null,hecha:!!o.hecha,fecha:o.fecha||null,horario:o.horario||"",personas:o.personas||[],invitados:[],objetivo:o.objetivo,nota:o.nota||"",temas:o.temas}; }

function defaultState(){
  var list=[
    S({num:1,titulo:"Renovaciones: correos, asignación y cobro",area:"Renovaciones y cartera",hecha:true,fecha:"2026-11-18",horario:"8:00 a. m. a 12:00 m.",duracion:4,
