        T("Primeros pasos del resto del equipo","Formulario base, comodidad 2 de 5","El equipo se ubicó en 2 de 5 en comodidad con la IA.","Cada persona con una tarea propia probada con Claude o ChatGPT en su versión gratis.")
      ]}),
    S({num:5,titulo:"Recordatorios y SOAT",area:"Cartera y obligatorios",personas:["Estefany Pérez","Sara Restrepo"],
