        T("Licencias","Acuerdo con Daniel","Se usan Claude y ChatGPT en su versión gratis; no se compran licencias hasta que el equipo demuestre uso.","Decisión con los números del ciclo: qué licencias hacen falta, si alguna.")
      ]})
  ];
  return {version:1,savedAt:null,saldoFecha:null,
    notas:"Fuera de alcance según el formulario del 3 de noviembre: ningún tema. Restricción: no hay un sistema que permita o prohíba el uso de IA. Acuerdos: no se compran licencias hasta que el equipo demuestre uso, y el taller para todo el equipo va después de las primeras 4 sesiones, sin costo adicional. Pendiente: Daniel separa OneDrive de la Nube de Sura para conectarlo.",
    sessions:list};
}

/* ===== Utilidades ===== */
function lbl(s){ return s.tipo==="taller"?"Taller":"Sesión "+s.num; }
function numSes(n){ return state.sessions.filter(function(x){return x.num===n;})[0]; }
function iso(d){ return d.toISOString().slice(0,10); }
function parse(s){ var p=s.split("-"); return new Date(Date.UTC(+p[0],+p[1]-1,+p[2])); }
function addDays(s,n){ return iso(new Date(parse(s).getTime()+n*86400000)); }
function esc(s){ return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
function fmtDate(s){ var d=parse(s); var y=d.getUTCFullYear(); return DIAS[d.getUTCDay()]+" "+d.getUTCDate()+" de "+MESES[d.getUTCMonth()]+(y!==2026?" de "+y:""); }
function weekRange(m){ var a=parse(m), b=parse(addDays(m,4)); var sameM=a.getUTCMonth()===b.getUTCMonth(); return a.getUTCDate()+(sameM?"":" "+MESES_C[a.getUTCMonth()])+" al "+b.getUTCDate()+" de "+MESES_C[b.getUTCMonth()]+(b.getUTCFullYear()!==2026?" "+b.getUTCFullYear():""); }
function fmt12(h){ var H=Math.floor(h), M=Math.round((h-H)*60); if(H===12&&M===0) return "12:00 m."; var s=H>=12?"p. m.":"a. m."; return (H%12||12)+":"+String(M).padStart(2,"0")+" "+s; }
function money(n){ return "$"+Math.round(n).toLocaleString("es-CO")+" COP"; }
function slotsFor(m){ if(!m) return []; return [{k:"mar",off:1,name:"Martes"},{k:"jue",off:3,name:"Jueves"}].map(function(s){ s.date=addDays(m,s.off); s.holiday=!!HOLIDAYS[s.date]; return s; }); }
function slotTime(k,dur){ return fmt12(14)+" a "+fmt12(14+dur); }
function whenText(s){
  if(s.hecha) return fmtDate(s.fecha)+", "+s.horario+", realizada";
  if(!s.semana) return "Semana por elegir (martes o jueves por la tarde)";
  if(s.franja){ var sl=slotsFor(s.semana).filter(function(x){return x.k===s.franja;})[0]; return fmtDate(sl.date)+", "+slotTime(s.franja,s.duracion)+" (horario por confirmar con CM)"; }
  return "Semana del "+weekRange(s.semana)+", día por elegir";
}
function dateOf(s){ if(s.hecha) return s.fecha; if(!s.franja||!s.semana) return null; return slotsFor(s.semana).filter(function(x){return x.k===s.franja;})[0].date; }
/* ===== Estado ===== */
