---
// Plan de trabajo con Seguros CM: 8 sesiones del ciclo de autonomía y un taller para todo el equipo.
// Página interactiva: Daniel edita personas, temas y fechas, guarda en su navegador,
// genera el resumen (copiar o PDF). La parte del saldo está apagada: PAGO_ACTIVO en el script.
// El envío a Notion (ENDPOINT) queda vacío hasta que exista el webhook de Make de CM.
import Layout from "../../../layouts/Layout.astro";
---

<Layout title="Plan de trabajo | Seguros CM" hideHeader hideFooter noindex>
  <div id="plan-root">
    <div class="topbar"><b>LuciRMe AI</b><span>/</span><span>Seguros CM</span><span>/</span><span>Plan de trabajo</span></div>
    <div id="app"></div>
  </div>
</Layout>

<style is:global>
#plan-root *{box-sizing:border-box}
#plan-root{background:var(--p-paper);color:var(--p-ink);font-family:var(--p-font-body);font-size:16px;line-height:1.5;--p-ink:#0F172A;--p-paper:#FBFBFA;--p-card:#FFFFFF;--p-line:#E9E9E7;--p-muted:#64748B;--p-accent:#0F766E;--p-accent-soft:#E6F6F4;--p-warn:#B45309;--p-warn-soft:#FEF3C7;--p-bad:#B91C1C;--p-font-display:ui-sans-serif,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;--p-font-body:ui-sans-serif,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;min-height:100vh}
#plan-root h1,#plan-root h2,#plan-root h3{font-family:var(--p-font-display);text-wrap:balance;margin:0}
#plan-root button,#plan-root input,#plan-root select,#plan-root textarea{font:inherit;color:inherit}
#plan-root .wrap{max-width:980px;margin:0 auto;padding:24px 16px 120px}
#plan-root .topbar{position:sticky;top:0;z-index:30;background:#fff;border-bottom:1px solid var(--p-line);padding:12px 16px;font-size:12px;color:#787774;display:flex;gap:8px;align-items:center}
#plan-root .topbar b{font-weight:600;color:var(--p-ink)}
#plan-root .top{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:flex-end;padding-bottom:20px;border-bottom:1px solid var(--p-line)}
#plan-root .brand{font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:var(--p-muted);margin:0 0 6px}
#plan-root h1{font-size:clamp(28px,5vw,44px);line-height:1.05;font-weight:700}
#plan-root .sub{margin:8px 0 0;color:var(--p-muted);max-width:60ch}
#plan-root .status{display:inline-flex;align-items:center;gap:8px;font-size:14px;padding:6px 12px;border:1px solid var(--p-line);border-radius:999px;background:var(--p-card)}
#plan-root .dot{width:9px;height:9px;border-radius:50%;background:var(--p-warn)}
#plan-root .status.ok .dot{background:var(--p-accent)}
#plan-root .tabs{display:flex;gap:4px;margin:20px 0 0}
#plan-root .tab{padding:10px 18px;border:1px solid var(--p-line);border-bottom:none;background:transparent;border-radius:10px 10px 0 0;cursor:pointer;color:var(--p-muted);font-weight:500}
#plan-root .tab[aria-selected="true"]{background:var(--p-card);color:var(--p-ink);font-weight:600}
#plan-root .panel{background:var(--p-card);border:1px solid var(--p-line);border-radius:0 12px 12px 12px;padding:20px}
#plan-root .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:0 0 20px;padding:0;list-style:none;counter-reset:s}
#plan-root .steps li{counter-increment:s;padding:12px 14px;border:1px solid var(--p-line);border-radius:10px;font-size:15px;background:var(--p-paper)}
#plan-root .steps li::before{content:counter(s);display:inline-grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--p-ink);color:var(--p-paper);font-weight:600;font-size:13px;margin-right:8px}
#plan-root .lead{margin:0 0 20px;max-width:70ch}
#plan-root .tl-scroll{overflow-x:auto;margin:0 -4px 20px;padding:4px}
#plan-root .node.locked{opacity:.55;cursor:default;border-style:dashed}
#plan-root .decide{margin-top:24px;padding:18px 20px;border:1px solid var(--p-line);border-radius:12px;background:var(--p-accent-soft)}
#plan-root .decide p{margin:6px 0 12px}
#plan-root .tl{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
#plan-root .node{text-align:left;padding:10px;border:1px solid var(--p-line);border-radius:10px;background:var(--p-paper);cursor:pointer;display:flex;flex-direction:column;gap:2px}
#plan-root .node:hover{border-color:var(--p-accent)}
#plan-root .node[aria-current="true"]{border-color:var(--p-accent);background:var(--p-accent-soft);box-shadow:inset 0 3px 0 var(--p-accent)}
#plan-root .node b{font-family:var(--p-font-display);font-size:13px;color:var(--p-muted)}
#plan-root .node span{font-size:14px;font-weight:600;line-height:1.25}
#plan-root .node small{font-size:12px;color:var(--p-muted)}
#plan-root .node.set small{color:var(--p-accent);font-weight:600}
#plan-root .editor{border-top:1px solid var(--p-line);padding-top:20px}
#plan-root .kicker{font-size:13px;color:var(--p-muted);margin:0 0 4px;font-weight:600}
#plan-root .titulo{width:100%;font-family:var(--p-font-display);font-size:clamp(22px,3.4vw,30px);font-weight:700;border:1px solid transparent;border-radius:8px;padding:4px 8px;margin:0 0 12px -8px;background:transparent}
#plan-root .titulo:hover,#plan-root .titulo:focus{border-color:var(--p-line);background:var(--p-paper)}
#plan-root .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
#plan-root .grid2 .narrow{max-width:none}
#plan-root .row2{display:grid;grid-template-columns:2fr 1fr;gap:12px}
#plan-root label{display:flex;flex-direction:column;gap:4px;font-size:14px;font-weight:600;color:var(--p-muted)}
#plan-root input[type=text],#plan-root input[type=number],#plan-root select,#plan-root textarea{width:100%;padding:9px 11px;border:1px solid var(--p-line);border-radius:8px;background:var(--p-paper);color:var(--p-ink);font-weight:400;font-size:15px}
#plan-root textarea{resize:vertical;min-height:64px}
#plan-root input:focus-visible,#plan-root select:focus-visible,#plan-root textarea:focus-visible,#plan-root button:focus-visible{outline:3px solid var(--p-accent);outline-offset:1px}
#plan-root h3{font-size:18px;margin:24px 0 10px}
#plan-root .note{background:var(--p-warn-soft);color:var(--p-ink);border-left:4px solid var(--p-warn);padding:10px 14px;border-radius:6px;font-size:14px;margin:12px 0}
#plan-root .chips{display:flex;flex-wrap:wrap;gap:8px}
#plan-root .chip{display:flex;flex-direction:column;align-items:flex-start;padding:7px 12px;border:1px solid var(--p-line);border-radius:10px;background:var(--p-paper);cursor:pointer;text-align:left;min-width:140px}
#plan-root .chip small{font-size:12px;color:var(--p-muted)}
#plan-root .chip[aria-pressed="true"]{background:var(--p-accent-soft);border-color:var(--p-accent)}
#plan-root .chip[aria-pressed="true"] b::before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--p-accent);margin-right:7px}
#plan-root .chip b{font-size:14px}
#plan-root .guest{display:flex;gap:8px;margin-top:10px;max-width:420px}
#plan-root .btn{padding:9px 16px;border-radius:8px;border:1px solid var(--p-ink);background:transparent;cursor:pointer;font-weight:600}
#plan-root .btn:hover{background:var(--p-paper)}
#plan-root .btn.primary{background:var(--p-accent);border-color:var(--p-accent);color:#fff}
#plan-root .btn.primary:hover{filter:brightness(1.08)}
#plan-root .btn.small{padding:5px 10px;font-size:13px}
#plan-root .btn.danger{border-color:var(--p-line);color:var(--p-bad)}
#plan-root .slots{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:10px}
#plan-root .slot{padding:12px;border:1px solid var(--p-line);border-radius:10px;background:var(--p-paper);cursor:pointer;text-align:left;display:flex;flex-direction:column;gap:2px}
#plan-root .slot[aria-pressed="true"]{border-color:var(--p-accent);background:var(--p-accent-soft);box-shadow:inset 0 3px 0 var(--p-accent)}
#plan-root .slot[disabled]{opacity:.5;cursor:not-allowed}
#plan-root .slot b{font-size:15px}
#plan-root .slot span{font-size:14px}
#plan-root .slot small{font-size:12px;color:var(--p-muted)}
#plan-root .warn{color:var(--p-warn);font-size:14px;margin:8px 0 0}
#plan-root .tema{border:1px solid var(--p-line);border-radius:12px;padding:14px;margin-bottom:12px;background:var(--p-paper)}
#plan-root .tema-head{display:flex;gap:10px;align-items:center;justify-content:space-between;margin-bottom:10px}
#plan-root .tema-name{font-weight:600;font-size:16px;margin-bottom:10px}
#plan-root .tema .fuente{margin-top:10px}
#plan-root .tag{display:inline-block;font-size:12px;font-weight:600;padding:2px 9px;border-radius:999px;background:var(--p-accent-soft);color:var(--p-accent)}
#plan-root .start-lbl{color:var(--p-warn)}
#plan-root .end-lbl{color:var(--p-accent)}
#plan-root .nav{display:flex;justify-content:space-between;gap:12px;margin-top:20px}
#plan-root .bar{position:fixed;left:0;right:0;bottom:0;background:var(--p-card);border-top:1px solid var(--p-line);padding:12px 16px;z-index:5}
#plan-root .bar-in{max-width:980px;margin:0 auto;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}
#plan-root .bar-in p{margin:0;font-size:14px;color:var(--p-muted)}
#plan-root .sum-session{border:1px solid var(--p-line);border-radius:12px;padding:16px;margin-bottom:12px;background:var(--p-paper)}
#plan-root .sum-session h3{margin:0 0 4px;font-size:19px}
#plan-root .sum-meta{display:grid;grid-template-columns:110px 1fr;gap:4px 12px;font-size:15px;margin:10px 0}
#plan-root .sum-meta dt{color:var(--p-muted);font-weight:600}
#plan-root .sum-meta dd{margin:0}
#plan-root .sum-temas{width:100%;border-collapse:collapse;font-size:14px;margin-top:6px}
#plan-root .sum-temas th,#plan-root .sum-temas td{text-align:left;vertical-align:top;padding:8px 10px;border-top:1px solid var(--p-line)}
#plan-root .sum-temas th{color:var(--p-muted);font-size:13px}
#plan-root .wide{overflow-x:auto}
#plan-root .pay{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}
#plan-root .pay-card{text-align:left;border:1px solid var(--p-line);border-radius:12px;padding:16px;background:var(--p-paper);cursor:pointer;display:flex;flex-direction:column;gap:6px}
#plan-root .pay-card[aria-pressed="true"]{border-color:var(--p-accent);background:var(--p-accent-soft);box-shadow:inset 0 3px 0 var(--p-accent)}
#plan-root .pay-card h4{margin:0;font-family:var(--p-font-display);font-size:18px}
#plan-root .pay-card .amt{font-family:var(--p-font-display);font-size:26px;font-weight:700}
#plan-root .pay-card ul{margin:0;padding-left:18px;font-size:14px}
#plan-root .actions{display:flex;flex-wrap:wrap;gap:10px;margin:16px 0}
#plan-root .toast{position:fixed;left:50%;bottom:84px;transform:translateX(-50%);background:var(--p-ink);color:var(--p-paper);padding:10px 18px;border-radius:8px;font-size:14px;z-index:9;max-width:90vw}
#plan-root .small-print{font-size:13px;color:var(--p-muted)}
@media (max-width:700px){
#plan-root .tl{grid-template-columns:repeat(9,150px);min-width:1370px}#plan-root .steps,#plan-root .grid2,#plan-root .row2,#plan-root .slots,#plan-root .pay{grid-template-columns:1fr}
#plan-root .sum-meta{grid-template-columns:1fr}
#plan-root .panel{padding:14px}

}
@media (prefers-reduced-motion:reduce){#plan-root *{transition:none!important;animation:none!important}}


</style>

<script>
