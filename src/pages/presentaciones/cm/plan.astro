var PEND="Se define con Pablo después de la sesión 2.";
function closedLine(s){ return s.hecha ? "Realizada el "+fmtDate(s.fecha)+"." : PEND; }

function loadState(){
  var emb=null;
  var s=emb&&emb.sessions?emb:defaultState();
  try{
    var raw=localStorage.getItem(LS);
    if(raw){ var loc=JSON.parse(raw); if(loc&&loc.sessions&&loc.savedAt&&loc.savedAt>(s.savedAt||"")){ s=loc; notice="Hay cambios guardados en este navegador que aún no están en la versión compartida."; } }
  }catch(e){}
  return s;
}


