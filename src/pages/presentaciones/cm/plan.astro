/* ===== Resumen en texto ===== */
function summaryText(){
  var L=[];
  L.push("PLAN DE TRABAJO · SEGUROS CM");
  L.push("Ciclo de autonomía · 8 sesiones y un taller para todo el equipo"+(state.savedAt?" · guardado el "+new Date(state.savedAt).toLocaleDateString("es-CO",{day:"numeric",month:"long",year:"numeric"}):""));
  L.push("");
  L.push("Antes de seguir: lunes 23 de noviembre, 10:00 a. m. a 11:00 a. m., sesión virtual con Cider sobre la conexión del CRM con la IA (no cuenta dentro de las 8 sesiones)."); L.push("");
  L.push("Este plan tiene la sesión 2 completa. Las demás quedan por definir."); L.push("");
  state.sessions.forEach(function(s,i){
    L.push(lbl(s).toUpperCase()+" · "+s.titulo);
    if(!isOpen(i)){ L.push("Área propuesta: "+s.area); L.push(closedLine(s)); L.push(""); return; }
    L.push("Área: "+s.area);
    L.push("Fecha: "+whenText(s)+" ("+s.duracion+" h)");
    var ppl=s.personas.concat(s.invitados);
    L.push("Personas: "+(ppl.length?ppl.join(", "):"por definir"));
    L.push("Objetivo: "+s.objetivo);
    L.push("Temas:");
    s.temas.forEach(function(t,k){
      L.push("  "+(k+1)+". "+t.nombre+" ("+t.fuente+")");
      L.push("     Empezamos: "+t.inicio);
      L.push("     Terminamos: "+t.cierre);
    });
    L.push("");
  });
  if(state.notas){ L.push("NOTAS"); L.push(state.notas); L.push(""); }
  if(PAGO_ACTIVO){ L.push("SALDO"); L.push(payLine()); }
  return L.join("\n");
}

/* ===== PDF ===== */
function clean(t){ return String(t).replace(/[–—]/g,"-").replace(/[“”]/g,'"').replace(/[‘’]/g,"'").replace(/ /g," "); }
function makePdf(){
  var J=jsPDF;
  var doc=new J({unit:"mm",format:"a4"});
  var W=210, M=18, y=M, ACC=[11,122,102], INK=[18,38,43], MUT=[86,101,104];
  function para(t,o){
    o=o||{}; var size=o.size||10.5, x=M+(o.x||0), w=W-M-x, lh=size*0.3528*1.4;
    doc.setFont("helvetica",o.style||"normal"); doc.setFontSize(size); doc.setTextColor.apply(doc,o.color||INK);
    doc.splitTextToSize(clean(t),w).forEach(function(l){ if(y+lh>285){ doc.addPage(); y=M; } doc.text(l,x,y); y+=lh; });
    y+=(o.after==null?1.2:o.after);
  }
  para("Plan de trabajo · Seguros CM",{size:20,style:"bold",after:1});
  para("Ciclo de autonomía · 8 sesiones y un taller para todo el equipo"+(state.savedAt?" · guardado el "+new Date(state.savedAt).toLocaleDateString("es-CO",{day:"numeric",month:"long",year:"numeric"}):""),{color:MUT,after:6});
  state.sessions.forEach(function(s,i){
    if(y>235){ doc.addPage(); y=M; }
    para(lbl(s)+". "+s.titulo,{size:14,style:"bold",color:ACC,after:1.5});
    if(!isOpen(i)){ para("Área propuesta: "+s.area,{after:.5}); para(closedLine(s),{size:9,color:MUT,after:2}); y+=2; return; }
    var ppl=s.personas.concat(s.invitados);
    para("Área: "+s.area,{after:.5}); para("Fecha: "+whenText(s)+" ("+s.duracion+" h)",{after:.5});
    para("Personas: "+(ppl.length?ppl.join(", "):"por definir"),{after:.5}); para("Objetivo: "+s.objetivo,{after:2});
    s.temas.forEach(function(t,k){
      para((k+1)+". "+t.nombre,{style:"bold",x:3,after:.3});
      para("Fuente: "+t.fuente,{size:9,color:MUT,x:6,after:.3});
      para("Empezamos: "+t.inicio,{x:6,after:.3});
      para("Terminamos: "+t.cierre,{x:6,after:2});
    });
    y+=4;
  });
  if(state.notas){ para("Notas del plan",{size:14,style:"bold",color:ACC,after:1.5}); para(state.notas,{after:5}); }
  if(PAGO_ACTIVO){ para("Saldo",{size:14,style:"bold",color:ACC,after:1.5}); para(payLine()); }
  return doc;
}

/* ===== Guardado ===== */
function toast(msg){
  var slot=document.getElementById("toast-slot"); if(!slot) return;
  slot.innerHTML='<div class="toast" role="status">'+esc(msg)+'</div>';
  setTimeout(function(){ if(slot) slot.innerHTML=""; },5000);
}
async function save(goResumen){
  state.savedAt=new Date().toISOString();
  var okLocal=true;
  try{ localStorage.setItem(LS,JSON.stringify(state)); }catch(e){ okLocal=false; }
  dirty=false; notice="";
  if(goResumen) view="resumen";
  render();
  var msg=okLocal?"Plan guardado en este navegador.":"No se pudo guardar en este navegador. Copia el resumen para no perder los cambios.";
  // Envío a Notion: pendiente hasta que exista el webhook de Make de CM (ENDPOINT).
  if(!ENDPOINT) msg=msg+" Para enviárselo a Pablo, copia el resumen o descarga el PDF.";
  toast(msg);
}

/* ===== Eventos ===== */
function markDirty(){ if(!dirty){ dirty=true; setStatus(); } try{ state.draftAt=new Date().toISOString(); }catch(e){} }

app.addEventListener("input",function(e){
  var t=e.target, f=t.dataset.f, s=state.sessions[sel];
  if(t.dataset.g==="notas"){ state.notas=t.value; markDirty(); return; }
  if(!f) return;
  if(t.dataset.t!==undefined){ s.temas[+t.dataset.t][f]=t.value; markDirty(); return; }
  if(f==="semana") return;
  if(f==="duracion"){ var n=parseFloat(t.value); if(n>0) s.duracion=n; else return; }
  else s[f]=t.value;
  markDirty();
});
app.addEventListener("change",function(e){
  var t=e.target, f=t.dataset.f;
  if(t.dataset.g==="saldoFecha"){ state.saldoFecha=t.value||null; markDirty(); render(); return; }
  if(f==="semana"){ var s=state.sessions[sel]; s.semana=t.value||null; if(!s.semana) s.franja=null; if(s.franja){ var sl=slotsFor(s.semana).filter(function(x){return x.k===s.franja;})[0]; if(sl.holiday) s.franja=null; } markDirty(); refresh(); return; }
  if(f==="titulo"||f==="duracion"){ refresh(); }
});
function refresh(){ var tl=document.getElementById("tl"), ed=document.getElementById("editor"); if(tl) tl.innerHTML=timelineHTML(); if(ed) ed.innerHTML=editorHTML(); }
app.addEventListener("click",function(e){
  var b=e.target.closest("[data-act]"); if(!b) return;
  var a=b.dataset.act, s=state.sessions[sel];
  if(a==="view"){ view=b.dataset.v; render(); window.scrollTo(0,0); return; }
  if(a==="sel"){ var i=+b.dataset.i; if(i>=0&&i<state.sessions.length){ sel=i; refresh(); var ed=document.getElementById("editor"); if(ed) ed.scrollIntoView({block:"start"}); } return; }
  if(a==="person"){ var n=b.dataset.n, k=s.personas.indexOf(n); if(k>-1) s.personas.splice(k,1); else s.personas.push(n); markDirty(); refresh(); return; }
  if(a==="addguest"){ var inp=document.getElementById("guest"); var v=inp&&inp.value.trim(); if(v){ s.invitados.push(v); markDirty(); refresh(); } return; }
  if(a==="rmguest"){ s.invitados.splice(+b.dataset.k,1); markDirty(); refresh(); return; }
  if(a==="slot"){ s.franja=(s.franja===b.dataset.k)?null:b.dataset.k; markDirty(); refresh(); return; }
  if(a==="addtema"){ s.temas.push(T("Nuevo tema","Propuesto por CM","","")); markDirty(); refresh(); return; }
