---
// src/pages/propuestas/ia-aplicada.astro
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Propuesta La Chinca | LuciRMe AI">
  <main class="max-w-4xl mx-auto py-12 px-4 space-y-10 print:py-6 print:px-0">
    <!-- HEADER DE LA PROPUESTA -->
    <header
      class="border-b border-slate-200 pb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-6 print:border-slate-300"
    >
      <div>
        <div
          class="inline-block bg-teal-50 border border-teal-200 text-teal-700 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-3 print:border-slate-300 print:text-slate-800"
        >
          Propuesta
        </div>
        <h1
          class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight"
        >
          Programa de Aprendizaje en IA Aplicada
        </h1>
      </div>
      <div
        class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs md:text-sm text-slate-500 space-y-1 min-w-[240px] print:bg-white print:border-slate-300"
      >
        <p>
          <strong class="text-slate-800 font-semibold">Para:</strong> Casa Universitaria
          • La Chinca
        </p>
        <p>
          <strong class="text-slate-800 font-semibold">De:</strong> Pablo Ríos Peña
          • LuciRMe AI
        </p>
      </div>
    </header>

    <!-- 1. RESUMEN EJECUTIVO -->
    <section
      class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm print:shadow-none print:border-slate-300 card"
    >
      <h2
        class="text-2xl font-bold text-slate-900 mb-4 flex items-center gap-2.5"
      >
        <span class="text-xl">🎯</span> Resumen Ejecutivo
      </h2>
      <p class="text-slate-600 text-sm md:text-base leading-relaxed mb-6">
        Esta propuesta responde a los resultados de la <em
          class="italic text-slate-800 font-medium"
          >Encuesta de Intereses de Aprendizaje sobre Inteligencia Artificial</em
        > aplicada a jóvenes de Casa Universitaria (junio 2026):
      </p>

      <div
        class="overflow-x-auto border border-slate-200 rounded-xl mb-6 print:border-slate-300"
      >
        <table class="w-full text-xs md:text-sm text-left border-collapse">
          <thead
            class="bg-slate-50 text-slate-500 uppercase text-[10px] tracking-wider font-semibold print:bg-slate-100"
          >
            <tr>
              <th class="p-3 border-b border-slate-200 print:border-slate-300"
                >Hallazgo</th
              >
              <th class="p-3 border-b border-slate-200 print:border-slate-300"
                >Dato</th
              >
            </tr>
          </thead>
          <tbody
            class="text-slate-700 divide-y divide-slate-150 print:divide-slate-300"
          >
            <tr>
              <td class="p-3 font-medium"
                >Interés en seguir aprendiendo sobre IA</td
              >
              <td class="p-3 font-semibold text-slate-900"
                >78,6% manifestó "mucho interés"</td
              >
            </tr>
            <tr>
              <td class="p-3 font-medium">Tema #1 de interés</td>
              <td class="p-3 font-semibold text-slate-900"
                >IA para estudiar mejor y ahorrar tiempo (71,4%)</td
              >
            </tr>
            <tr>
              <td class="p-3 font-medium">Tema #2 de interés</td>
              <td class="p-3 font-semibold text-slate-900"
                >IA para emprender y desarrollar ideas de negocio (64,3%)</td
              >
            </tr>
            <tr>
              <td class="p-3 font-medium">Tema #3 de interés</td>
              <td class="p-3 font-semibold text-slate-900"
                >IA para fortalecer proyecto de vida (42,9%)</td
              >
            </tr>
          </tbody>
        </table>
      </div>

      <div
        class="bg-teal-50/60 border-l-4 border-teal-600 p-4 rounded-r-lg text-slate-800 text-sm md:text-base leading-relaxed print:bg-slate-100 print:border-slate-400"
      >
        <strong class="text-teal-900 print:text-slate-900"
          >Objetivo del programa:</strong
        > Entregar herramientas prácticas, gratuitas y aplicables de IA para que las
        jóvenes potencien su desempeño académico, exploren caminos profesionales y
        construyan autonomía tecnológica.
        <br /><br />
        <span
          class="italic text-slate-600 block border-t border-teal-100 pt-3 mt-1 text-xs md:text-sm print:border-slate-300"
        >
          "No enseño IA. Enseño a recuperar tu vida usando IA."<br />
          <strong class="text-slate-800 font-bold not-italic block mt-1"
            >— Pablo Ríos, Fundador LuciRMe AI</strong
          >
        </span>
      </div>
    </section>

    <!-- 3. ESTRUCTURA DEL PROGRAMA -->
    <section
      class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm print:shadow-none print:border-slate-300 card"
    >
      <h2
        class="text-2xl font-bold text-slate-900 mb-2 flex items-center gap-2.5"
      >
        <span class="text-xl">🗂️</span> Estructura del Programa
      </h2>
      <p class="text-slate-600 text-sm md:text-base leading-relaxed mb-6">
        <strong class="text-slate-800 font-semibold">Formato:</strong> 2 Sesiones
        Presenciales + Materiales Digitales de Apoyo
      </p>

      <div
        class="overflow-x-auto border border-slate-200 rounded-xl mb-6 print:border-slate-300"
      >
        <table class="w-full text-xs md:text-sm text-left border-collapse">
          <thead
            class="bg-slate-50 text-slate-500 uppercase text-[10px] tracking-wider font-semibold print:bg-slate-100"
          >
            <tr>
              <th class="p-3 border-b border-slate-200 print:border-slate-300"
                >Sesión</th
              >
              <th class="p-3 border-b border-slate-200 print:border-slate-300"
                >Duración</th
              >
              <th class="p-3 border-b border-slate-200 print:border-slate-300"
                >Contenido</th
              >
              <th class="p-3 border-b border-slate-200 print:border-slate-300"
                >Entregable</th
              >
            </tr>
          </thead>
          <tbody
            class="text-slate-700 divide-y divide-slate-150 print:divide-slate-300"
          >
            <tr>
              <td class="p-3 font-bold text-slate-900">Sesión 1</td>
              <td class="p-3 font-medium">90 min</td>
              <td class="p-3 text-slate-600"
                >📚 IA para estudiar mejor + 📄 CV con IA</td
              >
              <td class="p-3 text-slate-600"
                >• Flujo de estudio<br />• 3 prompts para apuntes<br />• CV
                listo para usar</td
              >
            </tr>
            <tr>
              <td class="p-3 font-bold text-slate-900">Sesión 2</td>
              <td class="p-3 font-medium">90 min</td>
              <td class="p-3 text-slate-600"
                >💡 IA para emprender + 🎨 Contenido visual</td
              >
              <td class="p-3 text-slate-600"
                >• Idea de negocio validada<br />• Portafolio web básico<br />•
                Biblioteca personal</td
              >
            </tr>
          </tbody>
        </table>
      </div>

      <h3
        class="text-base font-bold text-slate-900 uppercase tracking-wider mb-3"
      >
        Materiales incluidos (entrega digital):
      </h3>
      <ul
        class="space-y-2 text-sm md:text-base text-slate-600 custom-check-list"
      >
        <li>
          <strong class="text-slate-800 font-semibold"
            >Biblioteca de Prompts Personales</strong
          >
        </li>
        <li>
          <strong class="text-slate-800 font-semibold"
            >Guías Visuales Descargables (PDF):</strong
          >
          <ul class="list-disc pl-6 mt-1.5 space-y-1 text-slate-500">
            <li>"Tu Ruta Profesional con NotebookLM" (1 página)</li>
            <li>"CV con IA: Flujo en 5 pasos" (1 página)</li>
            <li>"Fórmula Maestra de Prompts" (1 página)</li>
          </ul>
        </li>
      </ul>
    </section>

    <!-- 4. INVERSIÓN Y CONDICIONES -->
    <section
      class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm print:shadow-none print:border-slate-300 card"
    >
      <h2
        class="text-2xl font-bold text-slate-900 mb-2 flex items-center gap-2.5"
      >
        <span class="text-xl">💰</span> Inversión: Descuento La Chinca
      </h2>

      <div
        class="bg-slate-900 text-slate-100 p-6 rounded-2xl my-6 text-center border border-slate-800 shadow-sm print:bg-slate-100 print:text-slate-900 print:border-slate-300"
      >
        <span
          class="inline-block bg-orange-600 text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-3 print:bg-slate-800 print:text-white"
        >
          Exclusivo Fundación
        </span>
        <div class="text-4xl font-black text-white mb-1.5 print:text-slate-900">
          $900.000 COP <span
            class="text-base font-normal text-slate-400 print:text-slate-500"
            >(modalidad presencial)</span
          >
        </div>
        <p class="text-sm text-slate-300 font-medium print:text-slate-700">
          o <strong class="text-white font-bold print:text-slate-900"
            >$700.000 COP</strong
          > en modalidad remota
        </p>
      </div>

      <div
        class="overflow-x-auto border border-slate-200 rounded-xl mb-6 print:border-slate-300"
      >
        <table class="w-full text-xs md:text-sm text-left border-collapse">
          <tbody
            class="text-slate-700 divide-y divide-slate-150 print:divide-slate-300"
          >
            <tr>
              <th
                class="p-3 bg-slate-50 font-bold text-slate-800 w-1/3 print:bg-slate-100"
                >Participantes</th
              >
              <td class="p-3 text-slate-600">A elección de La Chinca</td>
            </tr>
            <tr>
              <th
                class="p-3 bg-slate-50 font-bold text-slate-800 print:bg-slate-100"
                >Incluye</th
              >
              <td class="p-3 text-slate-600"
                >2 sesiones + materiales + biblioteca de prompts +
                Acompañamiento particular en 2 sesiones a demanda de 1 hora</td
              >
            </tr>
          </tbody>
        </table>
      </div>

      <h3
        class="text-base font-bold text-slate-900 uppercase tracking-wider mb-3"
      >
        Condiciones del descuento:
      </h3>
      <p class="text-slate-600 text-sm md:text-base mb-4 leading-relaxed">
        Este precio especial aplica <strong class="text-slate-900"
          >exclusivamente para La Chinca</strong
        >, bajo los siguientes acuerdos de contraprestación:
      </p>
      <ul
        class="space-y-3 text-sm md:text-base text-slate-600 custom-check-list"
      >
        <li>
          <strong class="text-slate-800 font-semibold"
            >Contraprestación no monetaria:</strong
          >
          <ul class="list-disc pl-6 mt-1.5 space-y-1 text-slate-500">
            <li>
              Publicaciones compartidas en redes sociales de las estudiantes
              etiquetando a @LuciRMeAI
            </li>
            <li>
              1 testimonio breve en video (30-60 seg) documentando la
              experiencia y resultados
            </li>
            <li>
              Recomendaciones formales a contactos de otras organizaciones que
              se beneficien de estas herramientas
            </li>
          </ul>
        </li>
        <li>
          <strong class="text-slate-800 font-semibold"
            >Opcional - Acompañamiento 1:1:</strong
          >
          <span class="block text-slate-500 text-xs md:text-sm mt-0.5"
            >Espacios de asesoría individual adicionales pueden acordarse
            mediante intercambios no económicos de mutuo acuerdo.</span
          >
        </li>
      </ul>
    </section>

    <!-- 5. SOBRE NOSOTROS -->
    <section class="grid md:grid-cols-2 gap-6 print:gap-4 print:grid-cols-1">
      <div
        class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm print:shadow-none print:border-slate-300 card flex flex-col justify-between"
      >
        <div>
          <h2
            class="text-2xl font-bold text-slate-900 mb-4 flex items-center gap-2.5"
          >
            <span class="text-xl">👋</span> Sobre LuciRMe AI
          </h2>
          <p class="text-slate-600 text-xs md:text-sm leading-relaxed mb-4">
            Iniciativa de acompañamiento práctico en IA aplicada, creada para
            profesionales y jóvenes que quieren recuperar tiempo y claridad sin
            volverse expertos en tecnología compleja.
          </p>
        </div>
        <p
          class="text-xs font-semibold text-teal-600 bg-teal-50 border border-teal-100 rounded-lg p-2.5 inline-block print:bg-slate-100 print:text-slate-800 print:border-slate-300"
        >
          Regla de oro: "Si no devuelve tiempo, claridad o control, no es
          LuciRMe."
        </p>
      </div>

      <div
        class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm print:shadow-none print:border-slate-300 card text-xs md:text-sm"
      >
        <h3 class="text-lg font-bold text-slate-900 mb-1">Pablo Ríos Peña</h3>
        <p class="text-slate-400 font-medium mb-3">
          Head of Product · Consultor en IA & Product Strategy
        </p>
        <p class="text-slate-600 leading-relaxed mb-4">
          Ingeniero de Sistemas con más de 10 años liderando productos digitales
          en startups y entornos SaaS. Especialista en estrategia de producto,
          Growth y adopción práctica de IA.
        </p>
        <div
          class="border-t border-slate-100 pt-3 space-y-1 text-[11px] text-slate-500 print:border-slate-300"
        >
          <p>
            🔗 <a
              href="https://linkedin.com/in/pabloriospena"
              target="_blank"
              class="hover:underline text-teal-600 font-semibold"
              >linkedin.com/in/pabloriospena</a
            >
          </p>
          <p>
            📧 <a
              href="mailto:pabloriospena@gmail.com"
              class="hover:underline text-teal-600 font-semibold"
              >pabloriospena@gmail.com</a
            >
          </p>
          <p>
            🌐 <a
              href="https://lucirme.com"
              target="_blank"
              class="hover:underline text-teal-600 font-semibold">lucirme.com</a
            >
          </p>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer
      class="text-center pt-8 border-t border-slate-200 text-slate-400 text-xs space-y-1 print:border-slate-300"
    >
      <p>© 2026 Pablo Ríos Peña • LuciRMe AI</p>
      <p class="font-medium">
        Documento estratégico. Todos los derechos reservados.
      </p>
    </footer>
  </main>

  <style is:global>
    /* Estilos personalizados para la lista */
    .custom-check-list li::before {
      content: "✓";
      color: #10b981; /* Verde Success */
      font-weight: bold;
      margin-right: 0.5rem;
    }

    /* Reglas específicas para la impresión limpia del PDF */
    @media print {
      body {
        background-color: white !important;
        color: #0f172a !important;
      }
      .card {
        page-break-inside: avoid;
        border: 1px solid #e2e8f0 !important;
      }
    }
  </style>

  <script is:inline>
    // Handler para el botón de imprimir
    const printBtn = document.getElementById("print-button");
    if (printBtn) {
      printBtn.addEventListener("click", () => {
        window.print();
      });
    }
  </script>
</Layout>
