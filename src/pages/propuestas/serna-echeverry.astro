---
// src/pages/propuestas/serna-echeverry.astro
import "../../styles/global.css";
export const prerender = false;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Propuesta de Inversión · LuciRMe AI & Serna & Echeverry</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: "Inter", system-ui, -apple-system, sans-serif;
      }
      .font-mono {
        font-family: "JetBrains Mono", monospace;
      }
    </style>
  </head>

  <body class="bg-[#f8f9ff] text-[#0b1c30] antialiased selection:bg-[#89f5e7] selection:text-[#00201d]">
    <!-- HEADER -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-[#f8f9ff]/90 backdrop-blur-xl border-b border-slate-200/80 shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
      <div class="h-16 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between gap-4">
        <div class="flex items-center gap-4 shrink-0">
          <a href="/" class="flex items-center gap-2.5">
            <img alt="LuciRMe AI" class="h-8 w-auto object-contain" src="/logo-lucirme.png" />
            <span class="font-semibold text-base text-[#0b1c30] tracking-tight">LuciRMe AI</span>
          </a>
          <span class="hidden sm:inline-block px-2.5 py-0.5 rounded-full bg-[#e5eeff] font-mono text-[11px] text-[#3d4947] uppercase tracking-wider font-medium">
            PROPUESTA DE INVERSIÓN · SERNA & ECHEVERRY
          </span>
        </div>

        <nav class="hidden lg:flex items-center gap-1.5">
          <a class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]" href="#enfoque">Enfoque</a>
          <a class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]" href="#taller">Taller</a>
          <a class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]" href="#ciclo">Ciclo</a>
          <a class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]" href="#organizacion">Organización</a>
          <a class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]" href="#inversion">Inversión</a>
        </nav>

        <div class="flex items-center gap-4 shrink-0">
          <div class="hidden md:flex flex-col text-right">
            <span class="font-mono text-[11px] text-[#0b1c30] font-semibold">Serna & Echeverry</span>
          </div>
          <div class="w-8 h-8 rounded-full bg-[#00685f] flex items-center justify-center shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-white text-[18px]">person</span>
          </div>
        </div>
      </div>
    </header>

    <main class="w-full pt-16 bg-[#f8f9ff]">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 py-10">
        <div class="flex flex-col w-full space-y-20">

          <!-- 1. HERO -->
          <section class="w-full pt-6" id="hero">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-start">
              <div class="flex flex-col gap-4">
                <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold">
                  Taller de Inmersión + Ciclo de Autonomía
                </span>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0b1c30] tracking-tight leading-tight">
                  IA aplicada al trabajo real de Serna & Echeverry
                </h1>
                <p class="text-xl sm:text-2xl text-[#565e74] font-semibold">
                  Taller de Inmersión + Ciclo de Autonomía
                </p>
                <div class="space-y-3 text-base text-[#3d4947] leading-relaxed pt-2">
                  <p>Una propuesta para identificar cuellos de botella, resolver situaciones reales de trabajo con inteligencia artificial y desarrollar capacidades prácticas dentro del equipo.</p>
                </div>
              </div>

              <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <span class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] block mb-4 font-semibold">
                    INTERESADOS
                  </span>
                  <dl class="flex flex-col gap-3">
                    <div class="flex items-baseline justify-between pb-2 border-b border-slate-100">
                      <dt class="text-sm text-[#3d4947]">Cliente</dt>
                      <dd class="text-base text-[#0b1c30] font-bold">Serna & Echeverry</dd>
                    </div>
                    <div class="flex items-baseline justify-between pb-2 border-b border-slate-100">
                      <dt class="text-sm text-[#3d4947]">Proveedor</dt>
                      <dd class="text-base text-[#0b1c30] font-bold">LuciRMe AI</dd>
                    </div>
                    <div class="flex items-baseline justify-between pb-2 border-b border-slate-100">
                      <dt class="text-sm text-[#3d4947]">Responsable</dt>
                      <dd class="text-base text-[#0b1c30] font-bold">Pablo Ríos</dd>
                    </div>
                  </dl>
                </div>
                <div class="mt-6 p-4 rounded-xl bg-[#e5eeff]/50 border border-[#b8ccff]/50 text-xs font-mono text-[#0b1c30]">
                  › Estructurado en dos etapas con abono acumulativo directo.
                </div>
              </div>
            </div>
          </section>

          <!-- 2. ENFOQUE (id: enfoque) -->
          <section class="w-full pt-6" id="enfoque">
            <div class="max-w-3xl mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold block mb-2">
                METODOLOGÍA DE TRANSFERENCIA
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight">
                De los cuellos de botella a soluciones aplicadas
              </h2>
              <p class="text-base text-[#3d4947] mt-3 leading-relaxed">
                La propuesta parte de situaciones reales del trabajo, identifica dolores y cuellos de botella y trabaja en soluciones con herramientas de IA aplicadas específicamente a las tareas del equipo.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
              <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <span class="font-mono text-[11px] text-[#00685f] font-bold uppercase tracking-wider block mb-2">01 / 03 · Diagnóstico</span>
                  <h4 class="text-base font-bold text-[#0b1c30] mb-2">Identificar oportunidades</h4>
                  <p class="text-xs sm:text-sm text-[#3d4947] leading-relaxed">Detección de fricciones operativas, tareas repetitivas y cuellos de botella en los flujos diarios del equipo.</p>
                </div>
              </div>

              <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <span class="font-mono text-[11px] text-[#00685f] font-bold uppercase tracking-wider block mb-2">02 / 03 · Construcción práctica</span>
                  <h4 class="text-base font-bold text-[#0b1c30] mb-2">Resolver situaciones reales</h4>
                  <p class="text-xs sm:text-sm text-[#3d4947] leading-relaxed">Construcción conjunta y puesta a punto de soluciones directas utilizando modelos de IA configurados para casos de uso específicos del negocio.</p>
                </div>
              </div>

              <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <span class="font-mono text-[11px] text-[#00685f] font-bold uppercase tracking-wider block mb-2">03 / 03 · Autonomía</span>
                  <h4 class="text-base font-bold text-[#0b1c30] mb-2">Transferir capacidades al equipo</h4>
                  <p class="text-xs sm:text-sm text-[#3d4947] leading-relaxed">Habilitación de criterio operativo para que el equipo utilice, mantenga y evolucione las soluciones de manera autónoma.</p>
                </div>
              </div>
            </div>

            <div class="p-4 rounded-xl bg-[#e5eeff]/60 border border-[#b8ccff]/60 flex items-start gap-3">
              <span class="material-symbols-outlined text-[#00685f] text-[20px] shrink-0 mt-0.5">info</span>
              <span class="font-mono text-sm text-[#0b1c30]">Nota: Estas etapas representan el enfoque conceptual transversal del trabajo y no constituyen servicios o rubros adicionales.</span>
            </div>
          </section>

          <!-- 3. TALLER (id: taller) -->
          <section class="w-full pt-6" id="taller">
            <div class="max-w-3xl mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold block mb-2">
                ETAPA INICIAL DEL PROCESO
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight">
                Taller de Inmersión
              </h2>
              <p class="text-base text-[#3d4947] mt-3 leading-relaxed">
                Una sesión práctica para introducir al equipo en la aplicación de IA al trabajo diario, identificar dolores y cuellos de botella y resolver una situación real en vivo.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
              <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80">
                <span class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] block mb-1 font-semibold">Duración</span>
                <p class="text-base font-bold text-[#0b1c30]">3 horas</p>
                <p class="text-xs text-[#565e74] mt-0.5">Sesión intensiva en vivo</p>
              </div>
              <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80">
                <span class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] block mb-1 font-semibold">Modalidad</span>
                <p class="text-base font-bold text-[#0b1c30]">Presencial o Remota</p>
                <p class="text-xs text-[#565e74] mt-0.5">En instalaciones de Serna & Echeverry</p>
              </div>
              <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80">
                <span class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] block mb-1 font-semibold">Inversión</span>
                <p class="text-base font-bold text-[#00685f]">$800.000 COP</p>
                <p class="text-xs text-[#565e74] mt-0.5">Abonable 100% al ciclo</p>
              </div>
            </div>

            <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 space-y-6 mb-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <h3 class="font-bold text-base text-[#0b1c30] mb-3">Incluye en sesión</h3>
                  <ul class="space-y-2 text-sm text-[#3d4947] list-disc pl-5">
                    <li>Contexto general de IA adaptado a los procesos de la firma.</li>
                    <li>Herramientas de IA aplicada directamente al trabajo diario.</li>
                    <li>Identificación precisa de dolores operativos y cuellos de botella.</li>
                    <li>Solución de una situación de trabajo en vivo junto al equipo.</li>
                  </ul>
                </div>
                <div>
                  <h3 class="font-bold text-base text-[#0b1c30] mb-3">Posterior al taller</h3>
                  <ul class="space-y-2 text-sm text-[#3d4947] list-disc pl-5">
                    <li>Guía del taller documentada y disponible para todo el equipo.</li>
                    <li>Propuesta de plan de trabajo personalizada para la ejecución del Ciclo de Autonomía.</li>
                  </ul>
                </div>
              </div>

              <div class="p-4 rounded-xl bg-[#e5eeff]/60 border border-[#b8ccff]/60 flex items-start gap-3">
                <span class="material-symbols-outlined text-[#00685f] text-[20px] shrink-0 mt-0.5">lightbulb</span>
                <span class="font-mono text-sm text-[#0b1c30]">Insumo clave: Los diagnósticos levantados sirven de arquitectura directa para las sesiones posteriores.</span>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80">
                <h4 class="font-bold text-sm text-[#0b1c30] mb-1 font-mono">CONDICIÓN DE PAGO</h4>
                <p class="text-sm text-[#3d4947]">El taller se paga hasta un día hábil antes de su realización.</p>
              </div>
              <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80">
                <h4 class="font-bold text-sm text-[#0b1c30] mb-1 font-mono">MECANISMO DE ABONO</h4>
                <p class="text-sm text-[#3d4947]">Si Serna & Echeverry continúa con el Ciclo de Autonomía, el 100% del valor del taller ($800.000 COP) se abona al ciclo.</p>
              </div>
            </div>
          </section>

          <!-- 4. CICLO (id: ciclo) -->
          <section class="w-full pt-6" id="ciclo">
            <div class="max-w-3xl mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold block mb-2">
                INVERSIÓN PRINCIPAL
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight">
                Ciclo de Autonomía
              </h2>
              <p class="text-base text-[#3d4947] mt-3 leading-relaxed">
                Un proceso de trabajo con el equipo para solucionar cuellos de botella mediante herramientas de IA aplicadas específicamente a su trabajo, con transferencia de conocimiento para que puedan utilizar las soluciones de forma autónoma.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
              <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80">
                <span class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] block mb-1 font-semibold">Inversión base</span>
                <p class="text-base font-bold text-[#0b1c30]">$12.600.000 COP</p>
                <p class="text-xs text-[#565e74] mt-0.5">Antes de abono</p>
              </div>
              <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80">
                <span class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] block mb-1 font-semibold">Modalidad</span>
                <p class="text-base font-bold text-[#0b1c30]">Presencial</p>
                <p class="text-xs text-[#565e74] mt-0.5">Instalaciones de Serna & Echeverry</p>
              </div>
              <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80">
                <span class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] block mb-1 font-semibold">Duración</span>
                <p class="text-base font-bold text-[#0b1c30]">8 sesiones</p>
                <p class="text-xs text-[#565e74] mt-0.5">4 horas cada una (32 h)</p>
              </div>
              <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80">
                <span class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] block mb-1 font-semibold">Cadencia</span>
                <p class="text-base font-bold text-[#0b1c30]">2 días a la semana</p>
                <p class="text-xs text-[#565e74] mt-0.5">O según acuerdo</p>
              </div>
            </div>

            <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 space-y-6">
              <div class="space-y-4">
                <div class="pb-4 border-b border-slate-100">
                  <h3 class="font-bold text-base text-[#0b1c30] mb-1">A. Trabajo aplicado con el equipo</h3>
                  <p class="text-sm text-[#3d4947]">8 sesiones de 4 horas con el equipo de trabajo; distribución sugerida por pares para maximizar absorción; las últimas 2 sesiones dedicadas a líderes, si es posible; solución de cuellos de botella con herramientas de IA aplicada específicamente al trabajo.</p>
                </div>
                <div class="pb-4 border-b border-slate-100">
                  <h3 class="font-bold text-base text-[#0b1c30] mb-1">B. Recursos para el equipo</h3>
                  <p class="text-sm text-[#3d4947] mb-3">Las soluciones desarrolladas son propiedad del equipo y pueden usarse indefinidamente; guía personalizada y documentada de cada sesión para consultas operativas posteriores.</p>
                  <div class="p-3 rounded-lg bg-[#e5eeff]/50 border border-[#b8ccff]/50 text-xs font-mono text-[#0b1c30]">
                    › Activos sin vencimiento de licencia ni dependencias externas.
                  </div>
                </div>
                <div>
                  <h3 class="font-bold text-base text-[#0b1c30] mb-1">C. Acompañamiento</h3>
                  <ul class="space-y-2 text-sm text-[#3d4947] list-disc pl-5">
                    <li>Grupo de WhatsApp con los integrantes del equipo para comunicación asíncrona: todos ven dudas y avances. Activo durante el ciclo y los 30 días siguientes.</li>
                    <li>1 hora semanal de reunión virtual para resolver un tema puntual, durante el ciclo y los 30 días siguientes (hasta 12 horas de seguimiento remoto en total).</li>
                  </ul>
                </div>
              </div>
            </div>
          </section>

          <!-- 5. ORGANIZACIÓN (id: organizacion) -->
          <section class="w-full pt-6" id="organizacion">
            <div class="max-w-3xl mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold block mb-2">
                CRONOGRAMA Y PLANIFICACIÓN
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight">
                Organización del ciclo
              </h2>
              <p class="text-base text-[#3d4947] mt-3 leading-relaxed">
                Visualización editorial de ocho sesiones con una cadencia semanal sugerida. Los temas específicos se definirán a partir de los dolores y cuellos de botella identificados durante el taller.
              </p>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 mb-6">
              <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 text-center">
                <span class="font-mono text-2xl font-black text-[#00685f] block mb-1">8</span>
                <span class="text-xs text-[#3d4947] font-semibold block">Sesiones en total</span>
                <span class="text-[11px] text-[#565e74] block mt-0.5">Programa completo</span>
              </div>
              <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 text-center">
                <span class="font-mono text-2xl font-black text-[#0b1c30] block mb-1">4h</span>
                <span class="text-xs text-[#3d4947] font-semibold block">Por cada sesión</span>
                <span class="text-[11px] text-[#565e74] block mt-0.5">Dedicación intensiva</span>
              </div>
              <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 text-center">
                <span class="font-mono text-2xl font-black text-[#0b1c30] block mb-1">Pares</span>
                <span class="text-xs text-[#3d4947] font-semibold block">Distribución sugerida</span>
                <span class="text-[11px] text-[#565e74] block mt-0.5">Trabajo práctico</span>
              </div>
              <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 text-center">
                <span class="font-mono text-2xl font-black text-[#0b1c30] block mb-1">Líderes</span>
                <span class="text-xs text-[#3d4947] font-semibold block">Última sesión</span>
                <span class="text-[11px] text-[#565e74] block mt-0.5">Cierre estratégico</span>
              </div>
            </div>

            <div class="p-4 rounded-xl bg-[#e5eeff]/60 border border-[#b8ccff]/60 flex items-start gap-3">
              <span class="material-symbols-outlined text-[#00685f] text-[20px] shrink-0 mt-0.5">schedule</span>
              <span class="font-mono text-sm text-[#0b1c30]">Nota de planificación: El calendario específico se acuerda con Serna & Echeverry según la disponibilidad operativa.</span>
            </div>
          </section>

          <!-- 6. INVERSIÓN (id: inversion) -->
          <section class="w-full pt-6" id="inversion">
            <div class="max-w-3xl mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold block mb-2">
                ESQUEMA FINANCIERO
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight">
                Inversión y modalidades de pago
              </h2>
              <p class="text-base text-[#3d4947] mt-3 leading-relaxed">
                El precio base del Ciclo de Autonomía es de $12.600.000 COP. A continuación se presentan las dos modalidades disponibles para realizar la inversión.
              </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch mb-6">
              <!-- Tarjeta Izquierda: Modalidad 1 · Pago por etapas -->
              <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <span class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] font-bold">
                      MODALIDAD 1
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 font-mono text-[11px] font-bold">
                      Sin descuento
                    </span>
                  </div>
                  <h3 class="text-xl font-bold text-[#0b1c30] mb-1">
                    Pago por etapas
                  </h3>
                  <p class="text-xs sm:text-sm text-[#3d4947] mb-6 leading-relaxed">
                    El cliente paga inicialmente el taller de inmersión y este se abona al precio del Ciclo de Autonomía.
                  </p>

                  <div class="bg-slate-50 p-4 sm:p-5 rounded-xl flex flex-col gap-3 border border-slate-200/60 mb-6">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-200/60">
                      <span class="text-xs sm:text-sm text-[#3d4947]">Precio del Ciclo de Autonomía</span>
