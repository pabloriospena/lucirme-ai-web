---
// src/pages/propuestas/serna-echeverry.astro
import "../../styles/global.css";
export const prerender = false;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Propuesta · Serna & Echeverry</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: "Inter", system-ui, -apple-system, sans-serif;
      }
      .font-mono {
        font-family: "JetBrains Mono", monospace;
      }
    </style>
  </head>

  <body class="bg-[#f8f9ff] text-[#0b1c30] antialiased selection:bg-[#89f5e7] selection:text-[#00201d]">
    <!-- HEADER -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-[#f8f9ff]/90 backdrop-blur-xl border-b border-slate-200/80 shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
      <div class="h-16 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between gap-4">
        <div class="flex items-center gap-4 shrink-0">
          <a href="/" class="flex items-center gap-2.5">
            <img alt="LuciRMe AI" class="h-8 w-auto object-contain" src="/logo-lucirme.png" />
            <span class="font-semibold text-base text-[#0b1c30] tracking-tight">LuciRMe AI</span>
          </a>
          <span class="hidden sm:inline-block px-2.5 py-0.5 rounded-full bg-[#e5eeff] font-mono text-[11px] text-[#3d4947] uppercase tracking-wider font-medium">
            PROPUESTA DE TRABAJO · SERNA & ECHEVERRY
          </span>
        </div>

        <nav class="hidden lg:flex items-center gap-1.5">
          <a class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]" href="#enfoque">Enfoque</a>
          <a class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]" href="#mi-dia">Mi Día</a>
          <a class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]" href="#proyectos">Proyectos</a>
          <a class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]" href="#notion">Notion</a>
          <a class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]" href="#ruta">Ruta</a>
          <a class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]" href="#inversion">Inversión</a>
          <a class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]" href="#siguiente-paso">Siguiente paso</a>
        </nav>

        <div class="flex items-center gap-4 shrink-0">
          <div class="hidden md:flex flex-col text-right">
            <span class="font-mono text-[11px] text-[#0b1c30] font-semibold">Serna & Echeverry</span>
          </div>
          <div class="w-8 h-8 rounded-full bg-[#00685f] flex items-center justify-center shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-white text-[18px]">person</span>
          </div>
        </div>
      </div>
    </header>

    <main class="w-full pt-16 bg-[#f8f9ff]">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 py-10">
        <div class="flex flex-col w-full space-y-20">

          <!-- 1. PUNTO DE PARTIDA (id: enfoque) -->
          <section class="w-full pt-6" id="enfoque">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-start">
              <div class="flex flex-col gap-4">
                <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold">
                  METODOLOGÍA DE TRANSFERENCIA
                </span>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0b1c30] tracking-tight leading-tight">
                  Qué puede cambiar en el día a día de su equipo
                </h1>
                <p class="text-xl sm:text-2xl text-[#565e74] font-semibold">
                  Inteligencia artificial práctica para la operación real
                </p>
                <div class="space-y-3 text-base text-[#3d4947] leading-relaxed pt-2">
                  <p><strong class="text-[#0b1c30]">Lo que queremos que se lleven de hoy:</strong> ver cómo se trabaja con Claude en el día a día y juzgar si sirve para su equipo.</p>
                  <p><strong class="text-[#0b1c30]">Lo que vamos a hacer:</strong> mostrar ejemplos reales y escuchar cómo trabaja su equipo.</p>
                </div>
              </div>

              <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <span class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] block mb-4 font-semibold">
                    INTERESADOS
                  </span>
                  <dl class="flex flex-col gap-3">
                    <div class="flex items-baseline justify-between pb-2 border-b border-slate-100">
                      <dt class="text-sm text-[#3d4947]">Cliente</dt>
                      <dd class="text-base text-[#0b1c30] font-bold">Serna & Echeverry</dd>
                    </div>
                    <div class="flex items-baseline justify-between pb-2 border-b border-slate-100">
                      <dt class="text-sm text-[#3d4947]">Proveedor</dt>
                      <dd class="text-base text-[#0b1c30] font-bold">LuciRMe AI</dd>
                    </div>
                    <div class="flex items-baseline justify-between pb-2 border-b border-slate-100">
                      <dt class="text-sm text-[#3d4947]">Responsable</dt>
                      <dd class="text-base text-[#0b1c30] font-bold">Pablo Ríos</dd>
                    </div>
                  </dl>
                </div>
                <div class="mt-6 p-4 rounded-xl bg-[#e5eeff]/50 border border-[#b8ccff]/50 text-xs font-mono text-[#0b1c30]">
                  › Enfoque práctico y orientado a resultados de negocio.
                </div>
              </div>
            </div>
          </section>

          <!-- 2. MI DÍA (id: mi-dia) -->
          <section class="w-full pt-6" id="mi-dia">
            <div class="max-w-3xl mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold block mb-2">
                01 / 03 · RUTINA MATUTINA
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight">
                Así empieza mi mañana
              </h2>
            </div>

            <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 space-y-6">
              <p class="text-base text-[#3d4947] leading-relaxed">
                Claude junta mi agenda, mis correos y mis tareas de Notion, y me dice qué atender primero.
              </p>

              <div class="p-4 rounded-xl bg-[#e5eeff]/60 border border-[#b8ccff]/60 flex items-start gap-3">
                <span class="material-symbols-outlined text-[#00685f] text-[20px] shrink-0 mt-0.5">lightbulb</span>
                <span class="font-mono text-sm text-[#0b1c30]">Idea para su equipo: cada persona arrancaría su día con algo parecido, sobre sus propios proyectos.</span>
              </div>
            </div>
          </section>

          <!-- 3. PROYECTOS (id: proyectos) -->
          <section class="w-full pt-6" id="proyectos">
            <div class="max-w-3xl mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold block mb-2">
                02 / 03 · GESTIÓN POR CONTEXTO
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight">
                Una conversación por proyecto
              </h2>
            </div>

            <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 space-y-6">
              <div class="space-y-3 text-base text-[#3d4947] leading-relaxed">
                <p>Cada proyecto tiene su propio espacio con su contexto, sus acuerdos y su seguimiento.</p>
                <p>Retoma donde se quedó, sin tener que volver a explicar.</p>
              </div>

              <div class="p-4 rounded-xl bg-[#e5eeff]/60 border border-[#b8ccff]/60 flex items-start gap-3">
                <span class="material-symbols-outlined text-[#00685f] text-[20px] shrink-0 mt-0.5">lightbulb</span>
                <span class="font-mono text-sm text-[#0b1c30]">Idea para su equipo: una obra o un cliente por espacio, con lo pendiente siempre a la vista.</span>
              </div>
            </div>
          </section>

          <!-- 4. NOTION (id: notion) -->
          <section class="w-full pt-6" id="notion">
            <div class="max-w-3xl mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold block mb-2">
                03 / 03 · INTEGRACIÓN DE SISTEMAS
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight">
                Claude trabaja dentro de sus herramientas
              </h2>
            </div>

            <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 space-y-6">
              <div class="space-y-3 text-base text-[#3d4947] leading-relaxed">
                <p>Claude lee una ficha de Notion, actualiza un campo y crea una tarea.</p>
                <p>Ya conectado en mi operación: Notion, Calendar, Gmail y Drive.</p>
              </div>

              <div class="p-4 rounded-xl bg-[#e5eeff]/60 border border-[#b8ccff]/60 flex items-start gap-3">
                <span class="material-symbols-outlined text-[#00685f] text-[20px] shrink-0 mt-0.5">lightbulb</span>
                <span class="font-mono text-sm text-[#0b1c30]">Idea para su equipo: la información que hoy está repartida en carpetas y chats queda en un solo lugar y con orden.</span>
              </div>
            </div>
          </section>

          <!-- 5. RUTA (id: ruta) -->
          <section class="w-full pt-6" id="ruta">
            <div class="max-w-3xl mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold block mb-2">
                PLAN DE TRABAJO
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight">
                Dos pasos: taller y ciclo de autonomía
              </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
              <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 space-y-3">
                <span class="font-mono text-xs text-[#00685f] font-bold">TALLER DE INMERSIÓN</span>
                <p class="text-base text-[#3d4947] leading-relaxed">
                  El equipo entiende qué es Claude y practica con sus propios casos.
                </p>
              </div>

              <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 space-y-3">
                <span class="font-mono text-xs text-[#00685f] font-bold">CICLO DE AUTONOMÍA</span>
                <p class="text-base text-[#3d4947] leading-relaxed">
                  8 sesiones de 4 horas, en las que cada persona aprende a trabajar sola con Claude en sus tareas reales.
                </p>
              </div>
            </div>

            <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 mb-10 space-y-3">
              <h3 class="text-lg font-bold text-[#0b1c30]">Acompañamiento</h3>
              <p class="text-base text-[#3d4947] leading-relaxed">
                Un grupo de seguimiento asíncrono donde todos ven dudas y avances, y una reunión virtual de 1 hora por semana para resolver un tema puntual. Dura el ciclo y los 30 días siguientes.
              </p>
            </div>

            <div class="max-w-3xl mb-6">
              <span class="font-mono text-xs uppercase tracking-widest text-[#6d7a77] font-semibold block mb-1">
                EVIDENCIA DE IMPACTO
              </span>
              <h3 class="text-xl font-bold text-[#0b1c30]">Resultados en otros equipos</h3>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <span class="font-mono text-[11px] text-[#00685f] font-bold uppercase tracking-wider block mb-2">+30 %</span>
                  <h4 class="text-sm font-bold text-[#0b1c30] mb-1">Eficiencia operativa</h4>
                  <p class="text-xs text-[#565e74]">Empresa de construcción</p>
                </div>
              </div>

              <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <span class="font-mono text-[11px] text-[#00685f] font-bold uppercase tracking-wider block mb-2">12 → 4 días</span>
                  <h4 class="text-sm font-bold text-[#0b1c30] mb-1">Ciclo de decisión</h4>
                  <p class="text-xs text-[#565e74]">Startup</p>
                </div>
              </div>

              <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <span class="font-mono text-[11px] text-[#00685f] font-bold uppercase tracking-wider block mb-2">-80 %</span>
                  <h4 class="text-sm font-bold text-[#0b1c30] mb-1">Error humano</h4>
                  <p class="text-xs text-[#565e74]">Empresa de servicios</p>
                </div>
              </div>

              <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <span class="font-mono text-[11px] text-[#00685f] font-bold uppercase tracking-wider block mb-2">4 horas</span>
                  <h4 class="text-sm font-bold text-[#0b1c30] mb-1">Ahorradas por proyecto</h4>
                  <p class="text-xs text-[#565e74]">Agencia</p>
                </div>
              </div>
            </div>
          </section>

          <!-- 6. INVERSIÓN (id: inversion) - Dos modalidades lado a lado -->
          <section class="w-full pt-6" id="inversion">
            <div class="max-w-3xl mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold block mb-2">
                PROPUESTA COMERCIAL
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight">
                Taller + Ciclo de autonomía
              </h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch mb-6">
              <!-- Tarjeta Izquierda: Modalidad 1 · Sin descuento -->
              <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <span class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] font-bold">
                      MODALIDAD 1
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 font-mono text-[11px] font-bold">
                      Sin descuento
                    </span>
                  </div>
                  <h3 class="text-xl font-bold text-[#0b1c30] mb-1">
                    Pago por etapas
                  </h3>
                  <p class="text-xs sm:text-sm text-[#3d4947] mb-6 leading-relaxed">
                    Distribución del pago en dos partes a lo largo del proceso.
                  </p>

                  <div class="bg-slate-50 p-4 sm:p-5 rounded-xl flex flex-col gap-3 border border-slate-200/60 mb-6">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-200/60">
                      <span class="text-xs sm:text-sm text-[#3d4947]">1. Pago inicial (50 %)</span>
                      <span class="font-mono text-xs sm:text-sm text-[#0b1c30] font-semibold">$6.300.000 COP</span>
                    </div>
                    <div class="text-[11px] text-[#6d7a77] -mt-2">Al inicio del proceso.</div>

                    <div class="flex items-center justify-between pb-2 border-b border-slate-200/60 pt-1">
                      <span class="text-xs sm:text-sm text-[#3d4947]">2. Segundo pago (50 %)</span>
                      <span class="font-mono text-xs sm:text-sm text-[#0b1c30] font-semibold">$6.300.000 COP</span>
                    </div>
                    <div class="text-[11px] text-[#6d7a77] -mt-2">En la semana 4.</div>

                    <div class="flex items-center justify-between pt-2 bg-slate-100 px-3 py-2 rounded-lg mt-1">
                      <span class="text-sm font-bold text-[#0b1c30]">Inversión total del proceso</span>
                      <span class="font-mono text-base font-extrabold text-[#0b1c30]">$12.600.000 COP</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Tarjeta Derecha: Modalidad 2 · Recomendada -->
              <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border-2 border-[#00685f] flex flex-col justify-between relative">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-2">
                      <span class="font-mono text-[11px] uppercase tracking-wider text-[#00685f] font-bold">
                        MODALIDAD 2
                      </span>
                      <span class="px-2.5 py-0.5 rounded-full bg-[#00685f] text-white font-mono text-[11px] font-bold">
                        Recomendada
                      </span>
                    </div>
                    <span class="px-2.5 py-0.5 rounded-full bg-[#008378]/15 text-[#00685f] font-mono text-[11px] font-bold border border-[#00685f]/20">
                      Ahorra $1.260.000 COP
                    </span>
                  </div>
                  <h3 class="text-xl font-bold text-[#0b1c30] mb-1">
                    Pago anticipado
                  </h3>
                  <p class="text-xs sm:text-sm text-[#3d4947] mb-6 leading-relaxed">
                    Pago completo antes de iniciar el proceso, con un 10 % de descuento.
                  </p>

                  <div class="bg-[#eff4ff] p-4 sm:p-5 rounded-xl flex flex-col gap-2 border border-blue-100/60 mb-6">
                    <div class="flex items-center justify-between py-1 border-b border-slate-200/60">
                      <span class="text-xs sm:text-sm text-[#3d4947]">Precio</span>
                      <span class="font-mono text-xs sm:text-sm text-[#0b1c30] font-medium">$12.600.000 COP</span>
                    </div>
                    <div class="flex items-center justify-between py-1 border-b border-slate-200/60">
                      <span class="text-xs sm:text-sm text-[#00685f] font-semibold">Descuento del 10 %</span>
                      <span class="font-mono text-xs sm:text-sm text-[#00685f] font-bold">−$1.260.000 COP</span>
                    </div>
                    <div class="flex items-center justify-between py-2 bg-[#008378]/10 px-2.5 rounded-lg border border-[#008378]/20 mt-1">
                      <div>
                        <span class="text-sm sm:text-base font-extrabold text-[#00685f] block">Inversión total anticipada</span>
                        <span class="text-[11px] text-[#3d4947] block">Pago completo antes de iniciar el proceso.</span>
                      </div>
                      <span class="text-lg sm:text-2xl font-black text-[#00685f] font-mono">$11.340.000 COP</span>
                    </div>

                    <div class="flex items-center justify-between py-2 px-3 bg-emerald-50 rounded-lg border border-emerald-200/80 mt-1">
                      <span class="text-xs sm:text-sm font-semibold text-[#059669]">Ahorro frente a la modalidad por etapas</span>
                      <span class="font-mono text-sm sm:text-base font-extrabold text-[#059669]">$1.260.000 COP</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Nota de validez de la propuesta -->
            <div class="p-4 rounded-xl bg-[#e5eeff]/60 border border-[#b8ccff]/60 flex items-start gap-3">
              <span class="material-symbols-outlined text-[#00685f] text-[20px] shrink-0 mt-0.5">calendar_month</span>
              <span class="font-mono text-sm text-[#0b1c30]">Validez de la propuesta: esta propuesta, sus precios y el descuento por pago anticipado son válidos hasta el viernes 20 de noviembre de 2026. El inicio del proceso está sujeto a la disponibilidad de agenda.</span>
            </div>
          </section>

          <!-- 7. SIGUIENTE PASO (id: siguiente-paso) -->
          <section class="w-full pt-6 pb-12" id="siguiente-paso">
            <div class="max-w-3xl mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-[#00685f] font-semibold block mb-2">
                ACCIÓN INMEDIATA
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight">
                Siguiente paso
              </h2>
            </div>

            <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 max-w-2xl">
              <p class="text-base text-[#3d4947] leading-relaxed">
                Acordar hoy la fecha del taller y los horarios de las sesiones.
              </p>
            </div>
          </section>

          <!-- SECCIÓN OCULTA (id: ciclo-enfocado) -->
          <section class="w-full pt-6" style="display: none;" id="ciclo-enfocado">
            <div class="max-w-3xl mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-[#6d7a77] font-semibold block mb-2">
                MODALIDAD ALTERNATIVA
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight">
                Ciclo enfocado
              </h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch mb-6">
              <!-- Tarjeta Izquierda: Pago por etapas (Ciclo Enfocado) -->
              <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <span class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] font-bold">
                      MODALIDAD 1
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 font-mono text-[11px] font-bold">
                      Sin descuento
                    </span>
                  </div>
