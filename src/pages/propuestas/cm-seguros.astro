---
// src/pages/propuestas/cm-seguros.astro
import "../../styles/global.css";
export const prerender = false;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Propuesta de Inversión · LuciRMe AI &amp; CM Seguros</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />

    <style>
      body {
        font-family:
          "Inter",
          system-ui,
          -apple-system,
          sans-serif;
      }
      .font-mono {
        font-family: "JetBrains Mono", monospace;
      }
    </style>
  </head>

  <body
    class="bg-[#f8f9ff] text-[#0b1c30] antialiased selection:bg-[#89f5e7] selection:text-[#00201d]"
  >
    <!-- HEADER -->
    <header
      class="fixed top-0 left-0 right-0 z-50 bg-[#f8f9ff]/90 backdrop-blur-xl border-b border-slate-200/80 shadow-[0_1px_8px_rgba(0,0,0,0.04)]"
    >
      <div
        class="h-16 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between gap-4"
      >
        <div class="flex items-center gap-4 shrink-0">
          <a href="/" class="flex items-center gap-2.5">
            <img
              alt="LuciRMe AI"
              class="h-8 w-auto object-contain"
              src="/logo-lucirme.png"
            />
            <span class="font-semibold text-base text-[#0b1c30] tracking-tight"
              >LuciRMe AI</span
            >
          </a>
          <span
            class="hidden sm:inline-block px-2.5 py-0.5 rounded-full bg-[#e5eeff] font-mono text-[11px] text-[#3d4947] uppercase tracking-wider font-medium"
          >
            PROPUESTA DE INVERSIÓN · CM SEGUROS
          </span>
        </div>

        <nav class="hidden lg:flex items-center gap-1.5">
          <a
            class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]"
            href="#enfoque">Enfoque</a
          >
          <a
            class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]"
            href="#taller">Taller</a
          >
          <a
            class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]"
            href="#ciclo">Ciclo</a
          >
          <a
            class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]"
            href="#organizacion">Organización</a
          >
          <a
            class="text-sm font-medium transition-colors py-1.5 px-3 rounded-lg text-[#3d4947] hover:text-[#0b1c30] hover:bg-[#e5eeff]"
            href="#inversion">Inversión</a
          >
        </nav>

        <div class="flex items-center gap-4 shrink-0">
          <div class="hidden md:flex flex-col text-right">
            <span class="font-mono text-[11px] text-[#0b1c30] font-semibold"
              >CM Seguros</span
            >
          </div>
          <div
            class="w-8 h-8 rounded-full bg-[#00685f] flex items-center justify-center shrink-0 shadow-sm"
          >
            <span class="material-symbols-outlined text-white text-[18px]"
              >person</span
            >
          </div>
        </div>
      </div>
    </header>

    <main class="w-full pt-16 bg-[#f8f9ff]">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 py-10">
        <div class="flex flex-col w-full">
          <!-- SECCIÓN 1: PORTADA EJECUTIVA -->
          <section class="w-full pb-10" id="portada">
            <div
              class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-start"
            >
              <div class="flex flex-col gap-4">
                <h1
                  class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0b1c30] tracking-tight leading-tight"
                >
                  IA aplicada al trabajo real de CM Seguros
                </h1>
                <p class="text-xl sm:text-2xl text-[#565e74] font-semibold">
                  Taller de Inmersión + Ciclo de Autonomía
                </p>
                <p class="text-base text-[#3d4947] leading-relaxed">
                  Una propuesta para identificar cuellos de botella, resolver
                  situaciones reales de trabajo con inteligencia artificial y
                  desarrollar capacidades prácticas dentro del equipo.
                </p>
              </div>

              <div
                class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between"
              >
                <div>
                  <span
                    class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] block mb-4 font-semibold"
                  >
                    Interesados
                  </span>
                  <dl class="flex flex-col gap-3">
                    <div
                      class="flex items-baseline justify-between pb-2 border-b border-slate-100"
                    >
                      <dt class="text-sm text-[#3d4947]">Cliente</dt>
                      <dd class="text-base text-[#0b1c30] font-bold">
                        CM Seguros
                      </dd>
                    </div>
                    <div
                      class="flex items-baseline justify-between pb-2 border-b border-slate-100"
                    >
                      <dt class="text-sm text-[#3d4947]">Proveedor</dt>
                      <dd class="text-base text-[#0b1c30] font-bold">
                        LuciRMe AI
                      </dd>
                    </div>
                    <div class="flex items-baseline justify-between pb-1">
                      <dt class="text-sm text-[#3d4947]">Responsable</dt>
                      <dd class="text-base text-[#00685f] font-bold">
                        Pablo Ríos
                      </dd>
                    </div>
                  </dl>
                </div>
                <div
                  class="mt-6 p-4 bg-[#eff4ff] rounded-xl border border-blue-100/60"
                >
                  <p
                    class="font-mono text-[11px] text-[#3d4947] leading-relaxed"
                  >
                    Estructurado en dos etapas con abono acumulativo directo.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- SECCIÓN 2: ENFOQUE DE TRABAJO -->
          <section class="w-full py-10" id="enfoque">
            <div class="max-w-3xl mb-8">
              <span
                class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] block mb-1 font-semibold"
              >
                Metodología de Transferencia
              </span>
              <h2
                class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight"
              >
                De los cuellos de botella a soluciones aplicadas
              </h2>
              <p class="text-base text-[#3d4947] mt-2 leading-relaxed">
                La propuesta parte de situaciones reales del trabajo, identifica
                dolores y cuellos de botella y trabaja en soluciones con
                herramientas de IA aplicadas específicamente a las tareas del
                equipo.
              </p>
            </div>

            <!-- Grid Visual de Tres Etapas Conectadas -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <!-- Etapa 1 -->
              <div
                class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between hover:border-slate-300 transition-colors"
              >
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <span
                      class="font-mono text-xs text-[#00685f] font-bold px-2 py-0.5 bg-[#e5eeff] rounded"
                      >01 / 03</span
                    >
                    <span
                      class="material-symbols-outlined text-[#6d7a77] text-[22px]"
                      >troubleshoot</span
                    >
                  </div>
                  <h3 class="text-lg font-bold text-[#0b1c30] mb-2">
                    Identificar oportunidades
                  </h3>
                  <p class="text-sm text-[#3d4947] leading-relaxed">
                    Detección de fricciones operativas, tareas repetitivas y
                    cuellos de botella en los flujos diarios del equipo
                  </p>
                </div>
                <div class="mt-6 pt-3 border-t border-slate-100">
                  <span
                    class="font-mono text-[11px] text-[#6d7a77] uppercase tracking-wider font-semibold"
                    >Diagnóstico</span
                  >
                </div>
              </div>

              <!-- Etapa 2 -->
              <div
                class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between hover:border-slate-300 transition-colors"
              >
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <span
                      class="font-mono text-xs text-[#00685f] font-bold px-2 py-0.5 bg-[#e5eeff] rounded"
                      >02 / 03</span
                    >
                    <span
                      class="material-symbols-outlined text-[#6d7a77] text-[22px]"
                      >terminal</span
                    >
                  </div>
                  <h3 class="text-lg font-bold text-[#0b1c30] mb-2">
                    Resolver situaciones reales
                  </h3>
                  <p class="text-sm text-[#3d4947] leading-relaxed">
                    Construcción conjunta y puesta a punto de soluciones
                    directas utilizando modelos de IA configurados para casos de
                    uso específicos del negocio.
                  </p>
                </div>
                <div class="mt-6 pt-3 border-t border-slate-100">
                  <span
                    class="font-mono text-[11px] text-[#6d7a77] uppercase tracking-wider font-semibold"
                    >Construcción práctica</span
                  >
                </div>
              </div>

              <!-- Etapa 3 -->
              <div
                class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between hover:border-slate-300 transition-colors"
              >
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <span
                      class="font-mono text-xs text-[#00685f] font-bold px-2 py-0.5 bg-[#e5eeff] rounded"
                      >03 / 03</span
                    >
                    <span
                      class="material-symbols-outlined text-[#6d7a77] text-[22px]"
                      >sync_saved_locally</span
                    >
                  </div>
                  <h3 class="text-lg font-bold text-[#0b1c30] mb-2">
                    Transferir capacidades al equipo
                  </h3>
                  <p class="text-sm text-[#3d4947] leading-relaxed">
                    Habilitación de criterio operativo para que el equipo
                    utilice, mantenga y evolucione las soluciones de manera
                    autónoma.
                  </p>
                </div>
                <div class="mt-6 pt-3 border-t border-slate-100">
                  <span
                    class="font-mono text-[11px] text-[#6d7a77] uppercase tracking-wider font-semibold"
                    >Autonomía</span
                  >
                </div>
              </div>
            </div>

            <!-- Nota Metodológica -->
            <div
              class="mt-5 p-4 bg-[#eff4ff] rounded-xl flex items-center gap-3 border border-blue-100/60"
            >
              <span class="material-symbols-outlined text-[#565e74] text-[18px]"
                >info</span
              >
              <p class="font-mono text-[11px] text-[#3d4947]">
                Nota: Estas etapas representan el enfoque conceptual transversal
                del trabajo y no constituyen servicios o rubros adicionales.
              </p>
            </div>
          </section>

          <!-- SECCIÓN 3: TALLER DE INMERSIÓN -->
          <section class="w-full py-10" id="taller">
            <div class="flex flex-col gap-1 max-w-3xl mb-8">
              <span
                class="font-mono text-[11px] uppercase tracking-wider text-[#00685f] font-bold"
              >
                Etapa inicial del proceso
              </span>
              <h2
                class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight"
              >
                Taller de Inmersión
              </h2>
              <p class="text-base text-[#3d4947] leading-relaxed mt-1">
                Una sesión práctica para introducir al equipo en la aplicación
                de IA al trabajo diario, identificar dolores y cuellos de
                botella y resolver una situación real en vivo.
              </p>
            </div>

            <!-- Métricas del Taller -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
              <div
                class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col"
              >
                <span
                  class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] font-semibold"
                  >Duración</span
                >
                <span class="text-2xl sm:text-3xl font-bold text-[#0b1c30] mt-1"
                  >3 horas</span
                >
                <span class="text-xs text-[#565e74] mt-0.5"
                  >Sesión intensiva en vivo</span
                >
              </div>
              <div
                class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col"
              >
                <span
                  class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] font-semibold"
                  >Modalidad</span
                >
                <span class="text-2xl sm:text-3xl font-bold text-[#0b1c30] mt-1"
                  >Presencial</span
                >
                <span class="text-xs text-[#565e74] mt-0.5"
                  >En instalaciones CM Seguros</span
                >
              </div>
              <div
                class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col"
              >
                <span
                  class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] font-semibold"
                  >Inversión</span
                >
                <div class="flex items-baseline gap-1 mt-1">
                  <span class="text-2xl sm:text-3xl font-bold text-[#0b1c30]"
                    >$800.000</span
                  >
                  <span class="font-mono text-[11px] text-[#6d7a77] font-bold"
                    >COP</span
                  >
                </div>
                <span class="text-xs text-[#00685f] font-bold mt-0.5"
                  >Abonable 100% al ciclo</span
                >
              </div>
            </div>

            <!-- Contenidos: Incluye y Posterior -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
              <div
                class="bg-white p-6 sm:p-7 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col"
              >
                <div class="flex items-center gap-2 mb-4">
                  <span
                    class="material-symbols-outlined text-[#00685f] text-[20px]"
                    >fact_check</span
                  >
                  <h3 class="text-base text-[#0b1c30] font-bold">
                    Incluye en sesión
                  </h3>
                </div>
                <ul class="flex flex-col gap-3">
                  <li class="flex items-start gap-2.5 text-sm text-[#3d4947]">
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-[#00685f] mt-2 shrink-0"
                    ></span>
                    <span
                      >Contexto general de IA adaptado a procesos del sector.</span
                    >
                  </li>
                  <li class="flex items-start gap-2.5 text-sm text-[#3d4947]">
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-[#00685f] mt-2 shrink-0"
                    ></span>
                    <span
                      >Herramientas de IA aplicada directamente al trabajo
                      diario.</span
                    >
                  </li>
                  <li class="flex items-start gap-2.5 text-sm text-[#3d4947]">
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-[#00685f] mt-2 shrink-0"
                    ></span>
                    <span
                      >Identificación precisa de dolores operativos y cuellos de
                      botella.</span
                    >
                  </li>
                  <li class="flex items-start gap-2.5 text-sm text-[#3d4947]">
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-[#00685f] mt-2 shrink-0"
                    ></span>
                    <span
                      >Solución de una situación de trabajo en vivo junto al
                      equipo.</span
                    >
                  </li>
                </ul>
              </div>

              <div
                class="bg-white p-6 sm:p-7 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col"
              >
                <div class="flex items-center gap-2 mb-4">
                  <span
                    class="material-symbols-outlined text-[#00685f] text-[20px]"
                    >inventory_2</span
                  >
                  <h3 class="text-base text-[#0b1c30] font-bold">
                    Posterior al taller
                  </h3>
                </div>
                <ul class="flex flex-col gap-3">
                  <li class="flex items-start gap-2.5 text-sm text-[#3d4947]">
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-[#565e74] mt-2 shrink-0"
                    ></span>
                    <span
                      >Guía del taller documentada y disponible para todo el
                      equipo.</span
                    >
                  </li>
                  <li class="flex items-start gap-2.5 text-sm text-[#3d4947]">
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-[#565e74] mt-2 shrink-0"
                    ></span>
                    <span
                      >Propuesta de plan de trabajo personalizada para la
                      ejecución del Ciclo de Autonomía.</span
                    >
                  </li>
                </ul>
                <div class="mt-auto pt-6">
                  <div
                    class="p-3 bg-[#e5eeff] rounded-xl border border-blue-100/60"
                  >
                    <p class="font-mono text-[11px] text-[#3d4947]">
                      Insumo clave: Los diagnósticos levantados sirven de
                      arquitectura directa para las sesiones posteriores.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Regla de Pago y Abono -->
            <div
              class="bg-white p-6 sm:p-7 rounded-2xl shadow-sm border border-slate-200/80"
            >
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex items-start gap-3">
                  <span
                    class="material-symbols-outlined text-[#00685f] text-[22px] mt-0.5"
                    >schedule</span
                  >
                  <div>
                    <span class="text-base text-[#0b1c30] block font-bold"
                      >Condición de pago</span
                    >
                    <p class="text-sm text-[#3d4947] mt-0.5">
                      El taller se paga hasta un día hábil antes de su
                      realización.
                    </p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <span
                    class="material-symbols-outlined text-[#059669] text-[22px] mt-0.5"
                    >savings</span
                  >
                  <div>
                    <span class="text-base text-[#0b1c30] block font-bold"
                      >Mecanismo de abono</span
                    >
                    <p class="text-sm text-[#3d4947] mt-0.5">
                      Si CM Seguros continúa con el Ciclo de Autonomía, el 100%
                      del valor del taller ($800.000 COP) se abona al ciclo.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- SECCIÓN 4: CICLO DE AUTONOMÍA -->
          <section class="w-full py-10" id="ciclo">
            <div class="flex flex-col gap-1 max-w-3xl mb-8">
              <span
                class="font-mono text-[11px] uppercase tracking-wider text-[#00685f] font-bold"
              >
                Inversión principal
              </span>
              <h2
                class="text-2xl sm:text-3xl font-bold text-[#0b1c30] tracking-tight"
              >
                Ciclo de Autonomía
              </h2>
              <p class="text-base text-[#3d4947] leading-relaxed mt-1">
                Un proceso de trabajo con el equipo para solucionar cuellos de
                botella mediante herramientas de IA aplicadas específicamente a
                su trabajo, con transferencia de conocimiento para que puedan
                utilizar las soluciones de forma autónoma.
              </p>
            </div>

            <!-- Datos Clave Destacados -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
              <div
                class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col"
              >
                <span
                  class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] font-semibold"
                  >Inversión Base</span
                >
                <span class="text-lg sm:text-xl font-bold text-[#0b1c30] mt-1"
                  >$11.600.000 COP</span
                >
                <span class="text-xs text-[#6d7a77] mt-0.5">Antes de abono</span
                >
              </div>
              <div
                class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col"
              >
                <span
                  class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] font-semibold"
                  >Modalidad</span
                >
                <span class="text-lg sm:text-xl font-bold text-[#0b1c30] mt-1"
                  >Presencial</span
                >
                <span class="text-xs text-[#6d7a77] mt-0.5"
                  >Instalaciones CM</span
                >
              </div>
              <div
                class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col"
              >
                <span
                  class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] font-semibold"
                  >Duración</span
                >
                <span class="text-lg sm:text-xl font-bold text-[#0b1c30] mt-1"
                  >8 sesiones</span
                >
                <span class="text-xs text-[#6d7a77] mt-0.5"
                  >4 horas cada una (32h)</span
                >
              </div>
              <div
                class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col"
              >
                <span
                  class="font-mono text-[11px] uppercase tracking-wider text-[#6d7a77] font-semibold"
                  >Cadencia</span
                >
                <span class="text-lg sm:text-xl font-bold text-[#0b1c30] mt-1"
                  >2 días a la semana</span
                >
                <span class="text-xs text-[#6d7a77] mt-0.5"
                  >O según acuerdo</span
                >
              </div>
            </div>

            <!-- Alcance Estructurado en 3 Grupos Visuales -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <!-- Grupo A: Trabajo Aplicado -->
              <div
                class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center gap-2 mb-4">
                    <h3 class="text-base text-[#0b1c30] font-bold">
                      A. Trabajo aplicado con el equipo
                    </h3>
                  </div>
                  <ul class="flex flex-col gap-3 text-sm text-[#3d4947]">
                    <li class="flex items-start gap-2">
                      <span class="text-[#00685f] font-bold">―</span>
                      <span
                        >8 sesiones de 4 horas con el equipo de trabajo.</span
                      >
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-[#00685f] font-bold">―</span>
                      <span
                        >Distribución sugerida por pares para maximizar
                        absorción.</span
                      >
                    </li>
                    <li class="flex items-start gap-2">
