---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Guía de Copilot para Producto | Proposal for Andrés Giraldo (Siigo)">
  <div class="min-h-screen bg-[#FBFBFA] text-[#37352F] font-sans antialiased selection:bg-slate-200">
    
    <!-- TOP NOTION COVER / HEADER BAR -->
    <div class="w-full bg-white border-b border-[#E9E9E7] px-4 py-3 sticky top-0 z-30 flex items-center justify-between text-xs text-[#787774]">
      <div class="flex items-center gap-2 overflow-hidden">
        <a href="/" class="hover:text-[#37352F] transition flex items-center gap-1 shrink-0 font-medium">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          LucirMe AI
        </a>
        <span>/</span>
        <a href="/propuestas/guia-copilot-siigo" class="hover:text-[#37352F] transition truncate font-medium">
          Propuestas
        </a>
        <span>/</span>
        <span class="text-[#37352F] font-semibold truncate">Guía Copilot — Siigo Producto</span>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button 
          onclick="window.print()" 
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded border border-[#E9E9E7] hover:bg-[#F1F1EF] transition text-[#37352F] font-medium text-xs cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-[#787774]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span class="hidden sm:inline">Exportar / Imprimir</span>
        </button>
      </div>
    </div>

    <!-- MAIN NOTION DOCUMENT LAYOUT -->
    <div class="max-w-5xl mx-auto px-6 py-10 md:py-14 grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- NOTION SIDEBAR / TOC (Desktop) -->
      <aside class="hidden lg:block lg:col-span-3 space-y-6 sticky top-20 self-start text-xs text-[#787774]">
        <div class="space-y-2">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-[#9B9A97]">En esta guía</div>
          <nav class="space-y-1 font-medium">
            <a href="#metadata" class="block px-2.5 py-1.5 rounded hover:bg-[#F1F1EF] hover:text-[#37352F] transition">Información General</a>
            <a href="#resumen" class="block px-2.5 py-1.5 rounded hover:bg-[#F1F1EF] hover:text-[#37352F] transition">Visión del Proyecto</a>
            <a href="#discovery" class="block px-2.5 py-1.5 rounded hover:bg-[#F1F1EF] hover:text-[#37352F] transition">1. Discovery & Research</a>
            <a href="#ejecucion" class="block px-2.5 py-1.5 rounded hover:bg-[#F1F1EF] hover:text-[#37352F] transition">2. Ejecución & Sprints</a>
            <a href="#lanzamiento" class="block px-2.5 py-1.5 rounded hover:bg-[#F1F1EF] hover:text-[#37352F] transition">3. Lanzamiento</a>
            <a href="#soporte" class="block px-2.5 py-1.5 rounded hover:bg-[#F1F1EF] hover:text-[#37352F] transition">4. Soporte & Incidencias</a>
            <a href="#adopcion" class="block px-2.5 py-1.5 rounded hover:bg-[#F1F1EF] hover:text-[#37352F] transition">5. Adopción & Engagement</a>
            <a href="#herramientas" class="block px-2.5 py-1.5 rounded hover:bg-[#F1F1EF] hover:text-[#37352F] transition">Ecosistema de Herramientas</a>
            <a href="#valor" class="block px-2.5 py-1.5 rounded hover:bg-[#F1F1EF] hover:text-[#37352F] transition">Valor para el Interesado</a>
          </nav>
        </div>

        <div class="pt-4 border-t border-[#E9E9E7] space-y-2">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-[#9B9A97]">Filtro de Entornos</div>
          <div class="flex flex-col gap-1.5" id="sidebar-filters">
            <button data-filter="all" class="filter-btn active w-full text-left px-2.5 py-1.5 rounded text-xs font-semibold bg-[#E9E9E7] text-[#37352F]">
              Mostrar Todo
            </button>
            <button data-filter="gratis" class="filter-btn w-full text-left px-2.5 py-1.5 rounded text-xs font-medium hover:bg-[#F1F1EF] text-[#787774]">
              Solo Microsoft Suite (Gratis)
            </button>
            <button data-filter="pro" class="filter-btn w-full text-left px-2.5 py-1.5 rounded text-xs font-medium hover:bg-[#F1F1EF] text-[#787774]">
              Solo Integraciones Pro
            </button>
          </div>
        </div>
      </aside>

      <!-- CONTENT COLUMN -->
      <main class="lg:col-span-9 space-y-10">
        
        <!-- HEADER METADATA BLOCK -->
        <header id="metadata" class="space-y-6 pb-6 border-b border-[#E9E9E7]">
          
          <!-- ICON HEADER -->
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-[#F1F1EF] border border-[#E9E9E7] flex items-center justify-center text-[#37352F] shadow-2xs">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-[#9B9A97]">Propuesta de Implementación</span>
              <h1 class="text-2xl sm:text-3xl font-extrabold text-[#37352F] tracking-tight">
                Guía de Uso de Copilot en el Ciclo de Vida de Producto
              </h1>
            </div>
          </div>

          <!-- NOTION METADATA TABLE -->
          <div class="bg-[#F7F7F5] border border-[#E9E9E7] rounded-lg p-4 text-xs font-sans space-y-2">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="flex items-center gap-2">
                <span class="text-[#9B9A97] w-24 shrink-0 font-medium">Destinatario:</span>
                <span class="text-[#37352F] font-semibold">Andrés Giraldo</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#9B9A97] w-24 shrink-0 font-medium">Organización:</span>
                <span class="text-[#37352F] font-semibold">Siigo (Área de Producto)</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#9B9A97] w-24 shrink-0 font-medium">Elaborado por:</span>
                <span class="text-[#37352F] font-semibold">Pablo Ríos Peña • LucirMe AI</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#9B9A97] w-24 shrink-0 font-medium">Objetivo:</span>
                <span class="text-[#37352F] font-semibold">Aprovechar Copilot IA en Producto</span>
              </div>
            </div>
          </div>

          <!-- NOTION CALLOUT BOX -->
          <div id="resumen" class="bg-[#F1F1EF] border border-[#E9E9E7] rounded-lg p-4 flex gap-3 text-xs leading-relaxed text-[#37352F]">
            <div class="shrink-0 pt-0.5 text-[#37352F]">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="space-y-1">
              <strong class="font-bold block text-[#37352F]">Resumen Ejecutivo para Andrés Giraldo</strong>
              <p class="text-[#5A5A58]">
                Esta guía establece el mapa táctico para integrar Microsoft Copilot y sus extensiones Pro en cada fase del desarrollo de producto dentro de Siigo. Ofrece dos modalidades de adopción: desde la infraestructura nativa de Microsoft 365 hasta integraciones avanzadas con herramientas líderes como Jira, Figma y Slack.
              </p>
            </div>
          </div>

          <!-- MOBILE FILTERS -->
          <div class="flex lg:hidden items-center gap-2 pt-2 overflow-x-auto pb-1">
            <span class="text-xs text-[#9B9A97] shrink-0 font-medium">Filtrar:</span>
            <button data-filter="all" class="filter-btn active px-3 py-1 rounded text-xs font-semibold bg-[#E9E9E7] text-[#37352F] shrink-0">
              Todos
            </button>
            <button data-filter="gratis" class="filter-btn px-3 py-1 rounded text-xs font-medium bg-white border border-[#E9E9E7] text-[#787774] shrink-0">
              Microsoft Suite (Gratis)
            </button>
            <button data-filter="pro" class="filter-btn px-3 py-1 rounded text-xs font-medium bg-white border border-[#E9E9E7] text-[#787774] shrink-0">
              Integraciones Pro
            </button>
          </div>

        </header>

        <!-- ETAPAS DEL CICLO DE VIDA DE PRODUCTO -->
        <div class="space-y-12">

          <!-- 1. DISCOVERY -->
          <section id="discovery" class="stage-section space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-[#E9E9E7]">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-md bg-[#F1F1EF] border border-[#E9E9E7] flex items-center justify-center text-[#37352F]">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </div>
                <div>
                  <h2 class="text-lg font-bold text-[#37352F]">Etapa 1: Discovery & Research</h2>
                  <p class="text-xs text-[#787774]">Objetivo: Reunir información, documentos y reuniones para definir el PRD y prototipo.</p>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              
              <!-- GRATIS -->
              <div class="tier-card tier-gratis bg-white border border-[#E9E9E7] rounded-lg p-5 space-y-3 shadow-2xs">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-[#37352F] bg-[#F1F1EF] px-2.5 py-0.5 rounded border border-[#E9E9E7]">
                    <svg class="w-3.5 h-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Microsoft Suite (Gratis)
                  </span>
                  <span class="text-[10px] text-[#9B9A97] font-mono">Research Sub-fase</span>
                </div>
                <ul class="space-y-2.5 text-xs text-[#5A5A58]">
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-[#787774] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span><strong>Edge Browser History:</strong> Recuperar referentes de mercado y análisis de competidores con ayuda de Copilot.</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-[#787774] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span><strong>OneDrive:</strong> Guardar hallazgos estructurados en carpetas temáticas para el equipo.</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-[#787774] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span><strong>Word / OneNote:</strong> Documentar insights clave y vincularlos directamente al PRD.</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-[#787774] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span><strong>Outlook Calendar:</strong> Agendar sesiones de sintesis y entrevistas de research.</span>
                  </li>
                </ul>

                <div class="pt-2 border-t border-[#F1F1EF]">
                  <button 
                    onclick="copyPrompt('Prompt Discovery: Sintetiza los hallazgos de las notas de OneNote adjuntas y estructura los 5 puntos clave para el PRD de Siigo en Word.')" 
                    class="text-[11px] font-semibold text-[#37352F] hover:text-blue-600 transition flex items-center gap-1.5 cursor-pointer"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    Copiar Prompt sugerido para Copilot
                  </button>
                </div>
              </div>

              <!-- PRO -->
              <div class="tier-card tier-pro bg-[#FBFBFA] border border-[#E9E9E7] rounded-lg p-5 space-y-3 shadow-2xs">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-[#37352F] bg-[#EBEBE8] px-2.5 py-0.5 rounded border border-[#DCDCB6]">
                    <svg class="w-3.5 h-3.5 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    Integraciones Pro
                  </span>
                  <span class="text-[10px] text-[#9B9A97] font-mono">Workflow Conectado</span>
                </div>
                <ul class="space-y-2.5 text-xs text-[#5A5A58]">
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-teal-700 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
                    </svg>
                    <span><strong>Confluence / Miro:</strong> Capturar referentes visuales y mapas de descubrimiento automáticamente.</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-teal-700 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
                    </svg>
                    <span><strong>Jira Link:</strong> Vincular research directamente con épicas e historias en Jira.</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-teal-700 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
                    </svg>
                    <span><strong>Figma:</strong> Generar prototipos iniciales a partir de especificaciones escritas.</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-teal-700 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
                    </svg>
                    <span><strong>Slack & Amplitude:</strong> Compartir hallazgos en canales del equipo y validar hipótesis de producto (en construcción).</span>
                  </li>
                </ul>
              </div>

            </div>
          </section>

          <!-- 2. EJECUCIÓN -->
          <section id="ejecucion" class="stage-section space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-[#E9E9E7]">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-md bg-[#F1F1EF] border border-[#E9E9E7] flex items-center justify-center text-[#37352F]">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <h2 class="text-lg font-bold text-[#37352F]">Etapa 2: Ejecución & Sprints</h2>
                  <p class="text-xs text-[#787774]">Objetivo: Seguimiento de sprints, control de desviaciones y avance del roadmap.</p>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              
              <!-- GRATIS -->
              <div class="tier-card tier-gratis bg-white border border-[#E9E9E7] rounded-lg p-5 space-y-3 shadow-2xs">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-[#37352F] bg-[#F1F1EF] px-2.5 py-0.5 rounded border border-[#E9E9E7]">
                    <svg class="w-3.5 h-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Microsoft Suite (Gratis)
                  </span>
                  <span class="text-[10px] text-[#9B9A97] font-mono">Excel + Copilot</span>
                </div>
                <ul class="space-y-2.5 text-xs text-[#5A5A58]">
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-[#787774] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Descargar reportes de Jira en formato CSV / Excel.</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-[#787774] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Almacenar los archivos en OneDrive en carpetas organizadas por sprint o fecha.</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-[#787774] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Analizar los datos con <strong>Copilot en Excel</strong> para generar informes ejecutivos de:
                      <span class="block text-[11px] text-[#787774] mt-1 pl-2 border-l border-[#E9E9E7]">
                        • Riesgos y temas pendientes.<br/>
                        • Estado del sprint y asignados.<br/>
                        • Épicas y rendimiento del equipo.
                      </span>
                    </span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-[#787774] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Guardar automáticamente resúmenes consolidados en OneDrive.</span>
                  </li>
                </ul>

                <div class="pt-2 border-t border-[#F1F1EF]">
                  <button 
                    onclick="copyPrompt('Prompt Excel Copilot: Analiza este archivo de Jira. Identifica las 3 tareas con mayor riesgo de retraso y genera una tabla resumen con porcentaje de avance por épica.')" 
                    class="text-[11px] font-semibold text-[#37352F] hover:text-blue-600 transition flex items-center gap-1.5 cursor-pointer"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    Copiar Prompt para Copilot en Excel
                  </button>
                </div>
              </div>

              <!-- PRO -->
              <div class="tier-card tier-pro bg-[#FBFBFA] border border-[#E9E9E7] rounded-lg p-5 space-y-3 shadow-2xs">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-[#37352F] bg-[#EBEBE8] px-2.5 py-0.5 rounded border border-[#DCDCB6]">
                    <svg class="w-3.5 h-3.5 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    Integraciones Pro
                  </span>
                  <span class="text-[10px] text-[#9B9A97] font-mono">Automático & Live</span>
                </div>
