---
import Layout from "../layouts/Layout.astro";
import RedesSociales from "../components/RedesSociales.astro";
import { LINKS } from "../lib/constants.js";

const checkoutUrl = LINKS.curso_presentaciones || "https://pay.hotmart.com/R107150726I?checkoutMode=10";
const whatsappUrl = LINKS.whatsapp;
---

<Layout 
  title="Curso Presentaciones con IA: De 'No tengo idea' a Presentación Completa | LuciRMe AI"
  description="Aprende a transformar información dispersa en una presentación ejecutiva clara, estructurada y lista para presentar con IA. Método de 5 pasos por $35 USD. 7 días de garantía."
>

  <!-- BARRA DE NAVEGACIÓN Y ALERTA URGENCIA STICKY -->
  <div class="bg-amber-500 text-slate-950 font-black text-xs py-2 px-4 text-center border-b border-amber-600/20 shadow-xs">
    🔥 <span class="uppercase tracking-wider">OFERTA ESPECIAL:</span> Acceso Inmediato por <span class="underline decoration-2 font-black">US$35</span> (Pago único · Garantía de 7 días según Hotmart)
  </div>

  <nav class="bg-white/95 backdrop-blur-md border-b border-slate-200 px-6 py-3 sticky top-0 z-40 text-slate-900 shadow-xs">
    <div class="max-w-5xl mx-auto flex justify-between items-center text-xs sm:text-sm">
      <a href="/recursos" class="font-bold text-slate-600 hover:text-amber-700 transition flex items-center gap-1">
        ← Volver a Recursos
      </a>
      <div class="flex items-center gap-3">
        <span class="font-bold text-slate-700 hidden md:inline text-xs">Garantía 7 Días • Hotmart</span>
        <a
          href={checkoutUrl}
          target="_blank"
          rel="noopener noreferrer"
          onclick="if (window.posthog) { window.posthog.capture('curso_presentaciones_nav_buy_click', { producto: 'curso_presentaciones', precio: '35 USD' }); }"
          class="inline-flex items-center gap-1.5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-black px-3.5 py-1.5 rounded-lg transition text-xs shadow-sm cursor-pointer transform hover:scale-105"
        >
          <span>Acceder al Curso (US$35)</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </nav>

  <div class="bg-slate-50 text-slate-800 font-sans selection:bg-amber-200 selection:text-slate-900 min-h-screen">

    <!-- 1. HERO SECTION -->
    <header class="bg-white relative pt-10 pb-12 md:pt-14 md:pb-16 px-6 overflow-hidden border-b border-slate-200">
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#94A3B8_1px,transparent_1px)] [background-size:20px_20px] pointer-events-none"></div>
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-4xl mx-auto text-center relative z-10 space-y-5">
        
        <div class="inline-flex items-center gap-1.5 bg-amber-500/10 text-amber-900 border border-amber-500/30 text-[11px] font-extrabold uppercase tracking-widest px-3.5 py-1 rounded-full">
          <span>🎓</span>
          <span>Método de 5 Pasos con IA</span>
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 leading-tight tracking-tight max-w-3xl mx-auto uppercase">
          DE “NO TENGO IDEA” A UNA <br class="hidden sm:block" />
          <span class="text-amber-700">
            PRESENTACIÓN EJECUTIVA COMPLETA
          </span> <br class="hidden sm:block" />
          EN SOLO 30 MINUTOS
        </h1>

        <p class="text-sm sm:text-base text-slate-600 font-medium max-w-2xl mx-auto leading-relaxed">
          Aprende a transformar información dispersa en una presentación ejecutiva clara, estructurada y lista para presentar con IA.
        </p>

        <!-- CHIPS DE TIPOS DE INFORMACIÓN -->
        <div class="flex flex-wrap justify-center items-center gap-1.5 max-w-xl mx-auto pt-1">
          <span class="bg-slate-100 text-slate-700 border border-slate-200 font-semibold text-xs px-2.5 py-1 rounded-md">📧 Emails</span>
          <span class="bg-slate-100 text-slate-700 border border-slate-200 font-semibold text-xs px-2.5 py-1 rounded-md">💬 WhatsApp</span>
          <span class="bg-slate-100 text-slate-700 border border-slate-200 font-semibold text-xs px-2.5 py-1 rounded-md">🎧 Audios</span>
          <span class="bg-slate-100 text-slate-700 border border-slate-200 font-semibold text-xs px-2.5 py-1 rounded-md">📊 Excel</span>
          <span class="bg-slate-100 text-slate-700 border border-slate-200 font-semibold text-xs px-2.5 py-1 rounded-md">📄 PDFs</span>
          <span class="bg-slate-100 text-slate-700 border border-slate-200 font-semibold text-xs px-2.5 py-1 rounded-md">📝 Notas</span>
        </div>

        <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
          Todo eso puede convertirse en una narrativa ejecutiva que puedas entender, revisar y presentar.<br/>
          <span class="text-slate-400">Sin pasar horas organizando información desde cero.</span>
        </p>

        <!-- CTA Y GARANTÍA -->
        <div class="pt-2 space-y-2.5">
          <a
            href={checkoutUrl}
            target="_blank"
            rel="noopener noreferrer"
            onclick="if (window.posthog) { window.posthog.capture('curso_presentaciones_hero_buy_click', { producto: 'curso_presentaciones', precio: '35 USD' }); }"
            class="inline-flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-black text-sm sm:text-base px-7 py-3.5 rounded-xl transition shadow-md cursor-pointer transform hover:-translate-y-0.5 w-full sm:w-auto"
          >
            <span>QUIERO APRENDER EL MÉTODO POR US$35 →</span>
          </a>

          <p class="text-[11px] text-slate-500 font-medium">
            Pago único · Curso online · Garantía de 7 días Hotmart
          </p>
        </div>

      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-12 space-y-16">

      <!-- 2. ¿TE HA PASADO ESTO? -->
      <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 space-y-5 shadow-2xs">
        <div class="space-y-1.5">
          <span class="text-[11px] font-extrabold uppercase tracking-widest text-slate-600 bg-slate-100 px-3 py-0.5 rounded-full border border-slate-200 inline-block">
            📍 El Escenario Real
          </span>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            ¿TE HA PASADO ESTO?
          </h2>
        </div>

        <div class="space-y-4 text-slate-700 text-xs sm:text-sm leading-relaxed">
          <p class="text-xs sm:text-sm font-medium text-slate-800">
            Tienes que preparar una presentación importante y la información está repartida por todas partes:
          </p>

          <ul class="grid sm:grid-cols-2 gap-2 text-xs text-slate-700 bg-slate-50/80 p-4 rounded-xl border border-slate-200">
            <li class="flex items-center gap-2"><span class="text-amber-600 font-bold">•</span> Un Excel con los datos.</li>
            <li class="flex items-center gap-2"><span class="text-amber-600 font-bold">•</span> Varios PDFs.</li>
            <li class="flex items-center gap-2"><span class="text-amber-600 font-bold">•</span> Correos con decisiones importantes.</li>
            <li class="flex items-center gap-2"><span class="text-amber-600 font-bold">•</span> Audios de WhatsApp.</li>
            <li class="flex items-center gap-2"><span class="text-amber-600 font-bold">•</span> Notas de reuniones.</li>
            <li class="flex items-center gap-2"><span class="text-amber-600 font-bold">•</span> Comentarios de diferentes personas.</li>
          </ul>

          <div class="space-y-2 pt-1 text-slate-600">
            <p class="font-bold text-slate-900">Abres PowerPoint.</p>
            <p class="italic text-slate-600 bg-amber-500/10 border-l-3 border-amber-500 p-3 rounded-r-lg">“¿Por dónde empiezo?”</p>
            <p>Pasas una hora leyendo. Otra organizando. Otra intentando encontrar el mensaje principal.</p>
            <p class="font-semibold text-slate-900">Y cuando finalmente abres la primera diapositiva… sigues sin saber qué debería decir.</p>
          </div>
        </div>
      </section>

      <!-- 3. AHORA IMAGINA OTRO FLUJO -->
      <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 space-y-5 shadow-2xs">
        <div class="space-y-1.5 text-center sm:text-left">
          <span class="text-[11px] font-extrabold uppercase tracking-widest text-emerald-800 bg-emerald-50 px-3 py-0.5 rounded-full border border-emerald-200 inline-block">
            💡 El Método
          </span>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            AHORA IMAGINA OTRO FLUJO
          </h2>
          <p class="text-slate-600 text-xs sm:text-sm">
            Tienes toda esa información. La entregas a un proceso estructurado con IA.<br/>
            Primero organizas. Después analizas. Luego sintetizas. Validas. Y finalmente construyes la presentación.
          </p>
        </div>

        <!-- DIAGRAMA DE FLUJO -->
        <div class="bg-slate-900 text-white p-5 rounded-xl space-y-2.5 max-w-xl mx-auto text-center font-mono text-xs shadow-sm border border-slate-800">
          <div class="text-amber-400 font-bold tracking-widest">INFORMACIÓN</div>
          <div class="text-slate-500">↓</div>
          <div class="text-sky-300 font-bold tracking-widest">ANÁLISIS</div>
          <div class="text-slate-500">↓</div>
          <div class="text-emerald-400 font-bold tracking-widest">NARRATIVA</div>
          <div class="text-slate-500">↓</div>
          <div class="text-amber-300 font-bold tracking-widest">VALIDACIÓN</div>
          <div class="text-slate-500">↓</div>
          <div class="text-teal font-bold tracking-widest">PRESENTACIÓN</div>
        </div>

        <p class="text-center font-bold text-slate-900 text-xs sm:text-sm pt-1">
          Ese es el método que vas a aprender en este curso.
        </p>
      </section>

      <!-- 4. MIRA LO QUE PUEDES LLEGAR A CONSTRUIR -->
      <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 space-y-5 shadow-2xs">
        <div class="space-y-1.5">
          <span class="text-[11px] font-extrabold uppercase tracking-widest text-sky-800 bg-sky-50 px-3 py-0.5 rounded-full border border-sky-200 inline-block">
            📊 Ejemplo Real
          </span>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            MIRA LO QUE PUEDES LLEGAR A CONSTRUIR
          </h2>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
            Una de las aplicaciones prácticas de esta metodología es transformar información operativa en un dashboard ejecutivo interactivo.<br/>
            Aquí puedes ver un ejemplo real de un reporte construido por un estudiante:
          </p>
        </div>

        <!-- REPORTE PREVIEW CARD -->
        <div class="bg-slate-50/70 border border-slate-200 rounded-xl p-5 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-200 pb-3">
            <h3 class="font-extrabold text-slate-900 text-xs sm:text-sm">Dashboard Ejecutivo · Cierre Agosto 2026</h3>
            <span class="text-[10px] font-mono bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-bold">Reporte Interactivo</span>
          </div>

          <p class="text-xs text-slate-600 font-medium">Incluye:</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5 text-xs text-slate-700">
            <span class="bg-white p-2 rounded border border-slate-200 text-[11px]">✓ Análisis financiero</span>
            <span class="bg-white p-2 rounded border border-slate-200 text-[11px]">✓ Resultados comerciales</span>
            <span class="bg-white p-2 rounded border border-slate-200 text-[11px]">✓ Comparación vs metas</span>
            <span class="bg-white p-2 rounded border border-slate-200 text-[11px]">✓ Identificación de riesgos</span>
            <span class="bg-white p-2 rounded border border-slate-200 text-[11px]">✓ Análisis de clientes</span>
            <span class="bg-white p-2 rounded border border-slate-200 text-[11px]">✓ Fuentes de información</span>
            <span class="bg-white p-2 rounded border border-slate-200 text-[11px]">✓ Datos faltantes</span>
            <span class="bg-white p-2 rounded border border-slate-200 text-[11px]">✓ Recomendaciones</span>
            <span class="bg-white p-2 rounded border border-slate-200 text-[11px]">✓ Próximos pasos</span>
          </div>

          <div class="pt-1 text-center">
            <a
              href="/resultado"
              target="_blank"
              class="inline-flex items-center gap-1.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs px-4 py-2 rounded-lg transition"
            >
              <span>VER EL REPORTE INTERACTIVO →</span>
            </a>
          </div>
        </div>

        <p class="text-xs text-slate-500 italic">
          Este ejemplo muestra el tipo de entregable que puedes construir cuando la IA deja de ser solamente un chat y empieza a formar parte de un proceso de trabajo.
        </p>
      </section>

      <!-- 5. ¿QUÉ VAS A APRENDER? -->
      <section class="space-y-5">
        <div class="text-center space-y-1.5">
          <span class="text-[11px] font-extrabold uppercase tracking-widest text-amber-900 bg-amber-50 px-3 py-0.5 rounded-full border border-amber-200 inline-block">
            📚 Metodología
          </span>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            ¿QUÉ VAS A APRENDER?
          </h2>
          <p class="text-slate-600 text-xs sm:text-sm max-w-lg mx-auto">
            No vas a aprender una colección de prompts aislados. Vas a aprender un proceso completo.
          </p>
        </div>

        <div class="space-y-4">

          <!-- 01 ORGANIZA -->
          <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 space-y-3 shadow-xs">
            <div class="flex items-center gap-3">
              <span class="bg-amber-500 text-slate-950 font-black text-xs px-2.5 py-1 rounded-md">01</span>
              <h3 class="font-extrabold text-slate-900 text-base">ORGANIZA — Construye tu fuente de verdad</h3>
            </div>
            <p class="text-xs sm:text-sm text-slate-600">
              Aprende a reunir información que viene de diferentes lugares y convertirla en una base organizada para trabajar con IA.
            </p>
            <div class="text-xs text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-1">
              <span class="font-bold text-slate-900 block">Vas a trabajar con ejemplos como:</span>
              <div class="flex flex-wrap gap-1.5 pt-1">
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">PDFs</span>
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Excel</span>
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Documentos</span>
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Correos</span>
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Notas</span>
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Información desestructurada</span>
              </div>
            </div>
            <p class="text-xs text-emerald-700 font-bold">🎯 Resultado: una fuente de información lista para analizar.</p>
          </div>

          <!-- 02 ANALIZA -->
          <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 space-y-3 shadow-xs">
            <div class="flex items-center gap-3">
              <span class="bg-amber-500 text-slate-950 font-black text-xs px-2.5 py-1 rounded-md">02</span>
              <h3 class="font-extrabold text-slate-900 text-base">ANALIZA — Haz que la IA encuentre lo importante</h3>
            </div>
            <p class="text-xs sm:text-sm text-slate-600">
              Aprende a utilizar instrucciones estructuradas para extraer:
            </p>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5 text-xs text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-200">
              <span>• Datos relevantes</span>
              <span>• Patrones</span>
              <span>• Problemas</span>
              <span>• Oportunidades</span>
              <span>• Inconsistencias</span>
              <span>• Información faltante</span>
              <span class="col-span-2">• Puntos que requieren revisión</span>
            </div>
            <p class="text-xs text-emerald-700 font-bold">🎯 Resultado: información organizada y analizada.</p>
          </div>

          <!-- 03 SINTETIZA -->
          <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 space-y-3 shadow-xs">
            <div class="flex items-center gap-3">
              <span class="bg-amber-500 text-slate-950 font-black text-xs px-2.5 py-1 rounded-md">03</span>
              <h3 class="font-extrabold text-slate-900 text-base">SINTETIZA — Convierte datos en una historia ejecutiva</h3>
            </div>
            <p class="text-xs sm:text-sm text-slate-600">
              Aquí ocurre una de las partes más importantes. Aprendes a pasar de <em class="text-slate-800 font-bold">“Tengo mucha información”</em> a <em class="text-emerald-800 font-bold">“Sé exactamente qué necesito comunicar.”</em>
            </p>
            <div class="text-xs text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-1">
              <span class="font-bold text-slate-900 block">Construirás un One-Pager ejecutivo con:</span>
              <div class="flex flex-wrap gap-1.5 pt-1">
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Contexto</span>
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Datos principales</span>
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Hallazgos</span>
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Riesgos</span>
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Oportunidades</span>
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Conclusión</span>
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Próximos pasos</span>
              </div>
            </div>
            <p class="text-xs text-emerald-700 font-bold">🎯 Resultado: una narrativa ejecutiva clara antes de diseñar las diapositivas.</p>
          </div>

          <!-- 04 VALIDA -->
          <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 space-y-3 shadow-xs">
            <div class="flex items-center gap-3">
              <span class="bg-amber-500 text-slate-950 font-black text-xs px-2.5 py-1 rounded-md">04</span>
              <h3 class="font-extrabold text-slate-900 text-base">VALIDA — Revisa antes de presentar</h3>
            </div>
            <p class="text-xs sm:text-sm text-slate-600">
              La IA puede ayudarte a construir rápido. También necesitas revisar lo que construyó.<br/>
              Aprenderás un proceso rápido para comprobar:
            </p>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5 text-xs text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-200">
              <span>• Cifras</span>
              <span>• Fuentes</span>
              <span>• Conclusiones</span>
              <span>• Inconsistencias</span>
              <span>• Información faltante</span>
              <span>• Afirmaciones con evidencia</span>
            </div>
            <p class="text-xs text-emerald-700 font-bold">🎯 Resultado: mayor control sobre el contenido antes de presentarlo.</p>
          </div>

          <!-- 05 PRESENTA -->
          <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 space-y-3 shadow-xs">
            <div class="flex items-center gap-3">
              <span class="bg-amber-500 text-slate-950 font-black text-xs px-2.5 py-1 rounded-md">05</span>
              <h3 class="font-extrabold text-slate-900 text-base">PRESENTA — Convierte la narrativa en un entregable</h3>
            </div>
            <p class="text-xs sm:text-sm text-slate-600">
              Con la estructura lista, pasas a construir la presentación o prototipo.<br/>
              Aprenderás a utilizar herramientas de IA para crear entregables interactivos y visuales.
            </p>
            <div class="bg-amber-50 border border-amber-300 p-3 rounded-xl text-xs font-bold text-amber-950 text-center">
              El objetivo es que la presentación sea: clara + estructurada + verificable + útil para tomar decisiones.
            </div>
          </div>

        </div>
      </section>

      <!-- 6. LO QUE CAMBIA EN TU FORMA DE TRABAJAR -->
      <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 space-y-5 shadow-2xs">
        <div class="text-center space-y-1.5">
          <span class="text-[11px] font-extrabold uppercase tracking-widest text-teal-900 bg-teal-50 px-3 py-0.5 rounded-full border border-teal-200 inline-block">
            🔄 Transformación
          </span>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            LO QUE CAMBIA EN TU FORMA DE TRABAJAR
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-5">
          
          <!-- ANTES -->
          <div class="bg-rose-50/40 border border-rose-200/80 rounded-xl p-5 space-y-2 text-center">
            <span class="text-[10px] font-black uppercase tracking-wider text-rose-900 bg-rose-100 px-2.5 py-0.5 rounded">ANTES</span>
            <div class="text-xs text-slate-600 space-y-1 font-mono pt-2">
              <p>Información dispersa.</p>
              <p class="text-slate-400">↓</p>
              <p>Lectura manual.</p>
              <p class="text-slate-400">↓</p>
              <p>Copiar y pegar.</p>
              <p class="text-slate-400">↓</p>
              <p>Intentar entender qué es importante.</p>
              <p class="text-slate-400">↓</p>
              <p>Abrir PowerPoint.</p>
              <p class="text-slate-400">↓</p>
              <p>Empezar a mover cajas.</p>
              <p class="text-slate-400">↓</p>
              <p>Cambiar diapositivas.</p>
              <p class="text-slate-400">↓</p>
              <p>Volver a revisar todo.</p>
            </div>
          </div>

          <!-- DESPUÉS -->
          <div class="bg-emerald-50/40 border border-emerald-200/80 rounded-xl p-5 space-y-2 text-center">
            <span class="text-[10px] font-black uppercase tracking-wider text-emerald-900 bg-emerald-100 px-2.5 py-0.5 rounded">DESPUÉS</span>
            <div class="text-xs text-slate-700 font-bold space-y-1 font-mono pt-2">
              <p>Información dispersa.</p>
              <p class="text-emerald-500">↓</p>
              <p>Fuente de verdad.</p>
              <p class="text-emerald-500">↓</p>
              <p>Análisis con IA.</p>
              <p class="text-emerald-500">↓</p>
              <p>One-Pager ejecutivo.</p>
