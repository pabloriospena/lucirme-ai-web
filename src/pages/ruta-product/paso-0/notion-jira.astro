---
export const prerender = false;

import RutaProductLayout from "../../../layouts/RutaProductLayout.astro";
import CafeCTA from "../../../components/ruta-product/CafeCTA.astro";
import { verificar, COOKIE_NAME } from "../../../lib/acceso-ruta";

// Verificar acceso desde la cookie firmada en el servidor
const cookieAcceso = Astro.cookies.get(COOKIE_NAME)?.value;
const accesoValido = verificar(cookieAcceso);
---

<RutaProductLayout
  title="Conecta Notion con Jira usando Claude"
  description="Aprende a conectar Notion con Jira usando Claude: de notas de entrevistas y discovery a historias y tareas estructuradas sin copiar y pegar."
>
  <div class="space-y-10">
    <!-- Migas de pan -->
    <div class="space-y-2">
      <a href="/ruta-product/paso-0" class="inline-flex items-center gap-1.5 text-xs font-semibold text-teal-800 hover:text-teal-900 transition-colors">
        ← Volver al Paso 0
      </a>
      <div class="font-mono text-xs text-slate-500">
        Ruta Product Management / Paso 0 / Contenido 2
      </div>
    </div>

    <!-- Encabezado -->
    <div class="space-y-3">
      <span class="inline-block text-xs font-mono font-bold text-teal-800 bg-teal-50 px-2.5 py-1 rounded-md border border-teal-200 uppercase">
        Paso 0 · Contenido 2
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Conecta Notion con Jira usando Claude
      </h1>
      <p class="text-base text-slate-600 leading-relaxed max-w-2xl">
        Pasa de notas de entrevistas, sesiones de discovery o documentos de producto a historias listas para Jira en minutos, manteniendo el contexto intacto.
      </p>
    </div>

    {/* Muro de correo si no tiene acceso válido */}
    {!accesoValido && (
      <section id="muro-notion-jira" class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200 shadow-md max-w-2xl mx-auto my-6 space-y-6">
        <div class="inline-flex items-center gap-2 bg-teal-50 text-teal-800 text-xs font-bold uppercase tracking-wider px-3.5 py-1 rounded-full border border-teal-200 font-mono">
          <span>🔗</span> Paso 0 · Contenido 2
        </div>

        <div class="space-y-2">
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight">
            Desbloquea esta guía
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            Ingresa tu correo para acceder a la guía paso a paso, los prompts de conversión y la plantilla de sincronización.
          </p>
        </div>

        <form id="wall-form-notion-jira" class="space-y-4 pt-2">
          <div>
            <label for="wall-email-notion-jira" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-mono">
              Tu Correo Electrónico *
            </label>
            <input
              type="email"
              id="wall-email-notion-jira"
              name="email"
              placeholder="Ej. tu@empresa.com"
              required
              autocomplete="email"
              class="w-full text-sm p-3.5 border border-slate-300 rounded-xl bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent transition"
            />
          </div>

          <div id="wall-error-notion-jira" class="hidden p-3 bg-red-50 border border-red-200 text-red-600 text-xs rounded-lg font-medium"></div>

          <button
            type="submit"
            id="wall-submit-notion-jira"
            class="w-full bg-[#00685F] hover:bg-[#005049] text-white font-bold text-base py-3.5 px-6 rounded-xl transition shadow-md cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Desbloquear guía</span> →
          </button>
        </form>

        <p class="text-xs text-slate-400 text-center flex items-center justify-center gap-1.5 pt-1">
          <span>🔒</span> Cero spam. Acceso inmediato a la guía.
        </p>
      </section>
    )}

    {/* Contenido protegido */}
    <div id="contenido-notion-jira" class={accesoValido ? "space-y-8 max-w-3xl" : "hidden space-y-8 max-w-3xl"}>
      
      <!-- Paso 1 -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-4 shadow-sm">
        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide font-mono flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span> Paso 1 · Estructura tus notas en Notion
        </h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Antes de pedirle a la IA que cree historias, tus notas en Notion deben capturar el problema, las citas del usuario y los hallazgos principales con una estructura consistente.
        </p>

        <!-- Marcador de Captura -->
        <div class="p-6 bg-slate-100 rounded-xl border border-slate-200 text-center font-mono text-xs text-slate-500 font-medium">
          [CAPTURA: Plantilla de notas de entrevista en Notion con bloques de problema, citas y contexto]
        </div>

        <div class="space-y-2 pt-2">
          <p class="text-xs font-mono font-bold text-slate-700 uppercase tracking-wider">
            Prompt para sintetizar notas crudas en Notion:
          </p>
          <div class="code-block bg-slate-900 text-slate-200 p-5 rounded-xl font-mono text-xs relative">
            <button class="copy-btn absolute top-3 right-3 bg-teal-700 hover:bg-teal-600 text-white px-3 py-1.5 rounded-md text-[10px] font-bold transition">
              📋 Copiar
            </button>
            <pre class="whitespace-pre-wrap leading-relaxed font-mono"><code>Actúa como un Product Manager Senior. Tengo las siguientes notas desestructuradas de una sesión de discovery o entrevista:

[PEGA AQUÍ TUS NOTAS DE NOTION]

Por favor extrae:
1. Problema central expresado por el usuario (en 1-2 oraciones).
2. Evidencia y citas textuales clave.
3. Fricciones específicas identificadas.
4. Criterios de éxito esperados si resolviéramos este problema.

Formato de salida: Viñetas claras, directas, sin jerga innecesaria.</code></pre>
          </div>
        </div>
      </div>

      <!-- Paso 2 -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-4 shadow-sm">
        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide font-mono flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-teal-600"></span> Paso 2 · Convierte la síntesis en historias con Claude
        </h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Usa Claude para transformar los hallazgos estructurados en historias de usuario ejecutables con criterios de aceptación en formato Given/When/Then listos para Jira.
        </p>

        <!-- Marcador de Captura -->
        <div class="p-6 bg-slate-100 rounded-xl border border-slate-200 text-center font-mono text-xs text-slate-500 font-medium">
          [CAPTURA: Conversación en Claude generando historias de usuario estructuradas a partir de notas]
        </div>

        <div class="space-y-2 pt-2">
          <p class="text-xs font-mono font-bold text-slate-700 uppercase tracking-wider">
            Prompt de generación de historias listas para Jira:
          </p>
          <div class="code-block bg-slate-900 text-slate-200 p-5 rounded-xl font-mono text-xs relative">
            <button class="copy-btn absolute top-3 right-3 bg-teal-700 hover:bg-teal-600 text-white px-3 py-1.5 rounded-md text-[10px] font-bold transition">
              📋 Copiar
            </button>
            <pre class="whitespace-pre-wrap leading-relaxed font-mono"><code>Con base en el problema y los hallazgos validados:
"[PEGA LA SÍNTESIS VALIDADA DEL PASO 1]"

Genera una User Story lista para Jira con el siguiente formato exacto:
- Título: [Acción clara y concisa]
- Descripción: Como [tipo de usuario], quiero [acción específica], para [beneficio o valor medible].
- Contexto del problema: 2 líneas resumiendo el dolor del usuario.
- Criterios de Aceptación (Gherkin):
  Scenario 1: [Nombre escenario principal]
    Given [precondición]
    When [acción]
    Then [resultado esperado]
  Scenario 2: [Manejo de error o caso borde]
    Given [precondición]
    When [acción]
    Then [resultado esperado]
- Fuera de alcance (Out of Scope): 2 puntos explícitos de lo que NO se debe construir en este sprint.</code></pre>
          </div>
        </div>
      </div>

      <!-- Paso 3 -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-4 shadow-sm">
        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide font-mono flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-600"></span> Paso 3 · Publica y vincula directamente en Jira
        </h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Copia las historias formateadas directamente al backlog de Jira o impórtalas manteniendo el enlace al documento de Notion original para que los desarrolladores tengan el contexto completo.
        </p>

        <!-- Marcador de Captura -->
        <div class="p-6 bg-slate-100 rounded-xl border border-slate-200 text-center font-mono text-xs text-slate-500 font-medium">
          [CAPTURA: Issue en Jira con historia, criterios Gherkin y enlace de contexto a Notion]
        </div>

        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-600 leading-relaxed space-y-2">
          <p class="font-bold text-slate-800 uppercase font-mono">💡 Regla de oro para el equipo:</p>
          <p>Siempre incluye en la descripción de Jira el link de Notion con las notas de discovery. Así el equipo técnico entiende el porqué detrás de cada criterio sin intermediarios ni reuniones extra.</p>
        </div>
      </div>

      <!-- Pie de secuencia -->
      <div class="pt-6 border-t border-slate-200">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-5 bg-slate-50 rounded-2xl border border-slate-200">
          <div>
            <span class="text-xs font-mono text-slate-500 uppercase tracking-wider block">Siguiente contenido</span>
            <span class="text-sm font-bold text-slate-900">Sigue con: PostHog ↔ Claude</span>
          </div>
          <a
            href="/ruta-product/paso-0/posthog-claude"
            onclick="if (window.posthog) { window.posthog.capture('contenido_paso_0_siguiente_click', { contenido: 'notion-jira' }); }"
            class="inline-flex items-center justify-center font-semibold bg-[#00685F] hover:bg-[#005049] text-white rounded-xl py-2.5 px-5 transition text-xs sm:text-sm shadow-sm"
          >
            Continuar →
          </a>
        </div>
      </div>

    </div>

    <!-- CafeCTA -->
    <CafeCTA ubicacion="paso-0-2" />
  </div>
</RutaProductLayout>

<script is:inline>
  // Evento al cargar la página
  if (window.posthog) {
    window.posthog.capture('contenido_paso_0_visto', { contenido: 'notion-jira' });
  }

  // Lógica del muro de correo
  (function () {
    function ejecutarDesbloqueo() {
      var muro = document.getElementById('muro-notion-jira');
      var contenido = document.getElementById('contenido-notion-jira');
      if (muro) muro.classList.add('hidden');
      if (contenido) contenido.classList.remove('hidden');
    }

    var form = document.getElementById('wall-form-notion-jira');
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var btn = document.getElementById('wall-submit-notion-jira');
        var errorEl = document.getElementById('wall-error-notion-jira');
        var emailVal = (document.getElementById('wall-email-notion-jira')?.value || '').trim();

        if (errorEl) errorEl.classList.add('hidden');
        if (btn) { btn.disabled = true; btn.innerHTML = '<span>Procesando...</span>'; }

        try {
          var res = await fetch('/api/unlock-recurso', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailVal })
          });
          var data = await res.json().catch(function () { return {}; });

          if (!res.ok || !data.ok) {
            var msg = data.error || 'No se pudo registrar el correo. Por favor intenta de nuevo.';
            if (errorEl) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); }
            if (btn) { btn.disabled = false; btn.innerHTML = '<span>Desbloquear guía</span> →'; }
            return;
          }

          if (window.posthog) {
            window.posthog.capture('resource_unlocked', { recurso: 'notion-jira', paso: '0' });
          }

          ejecutarDesbloqueo();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (err) {
          console.error('[muro-notion-jira]', err);
          if (errorEl) { errorEl.textContent = 'Error de conexión. Intenta de nuevo.'; errorEl.classList.remove('hidden'); }
          if (btn) { btn.disabled = false; btn.innerHTML = '<span>Desbloquear guía</span> →'; }
        }
      });
    }
  })();

  // Lógica de botones copiar
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const target = e.target;
      const codeBlock = target.closest('.code-block');
      const code = codeBlock.querySelector('code')?.textContent || '';
      
      await navigator.clipboard.writeText(code.trim());
      const original = target.textContent;
      target.textContent = '✅ Copiado';
      setTimeout(() => target.textContent = original, 2000);
    });
  });
</script>
