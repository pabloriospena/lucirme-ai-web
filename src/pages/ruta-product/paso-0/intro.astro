---
export const prerender = false;

import RutaProductLayout from "../../../layouts/RutaProductLayout.astro";
import CafeCTA from "../../../components/ruta-product/CafeCTA.astro";
import { verificar, COOKIE_NAME } from "../../../lib/acceso-ruta";

// Verificar acceso desde la cookie firmada en el servidor
const cookieAcceso = Astro.cookies.get(COOKIE_NAME)?.value;
const accesoValido = verificar(cookieAcceso);

// Validar si existe la variable de entorno del grupo de conexiones
const grupoConexiones = (process.env.MAILERLITE_GROUP_CONEXIONES || "").trim();
const tieneGrupo = Boolean(grupoConexiones);
---

<RutaProductLayout
  title="Conecta tus herramientas: el mapa de la ruta"
  description="Qué conecta la ruta y por qué importa antes de Discovery: mapa integral de integración entre tus herramientas de producto."
>
  <div class="space-y-10">
    <!-- Migas de pan -->
    <div class="space-y-2">
      <a href="/ruta-product/paso-0" class="inline-flex items-center gap-1.5 text-xs font-semibold text-teal-800 hover:text-teal-900 transition-colors">
        ← Volver al Paso 0
      </a>
      <div class="font-mono text-xs text-slate-500">
        Ruta Product Management / Paso 0 / Intro
      </div>
    </div>

    <!-- Encabezado -->
    <div class="space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Conecta tus herramientas: el mapa de la ruta
      </h1>
      <p class="text-base text-slate-600 leading-relaxed max-w-2xl">
        Conectar tus herramientas antes de iniciar Discovery evita silos de información, sincroniza el contexto del problema en tiempo real y sienta las bases operativas de todo el ciclo de producto con IA.
      </p>
    </div>

    {/* Si no tiene acceso válido, mostrar el muro de correo */}
    {!accesoValido && (
      <section id="muro-intro" class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200 shadow-md max-w-2xl mx-auto my-6 space-y-6">
        <div class="inline-flex items-center gap-2 bg-teal-50 text-teal-800 text-xs font-bold uppercase tracking-wider px-3.5 py-1 rounded-full border border-teal-200 font-mono">
          <span>🔗</span> Paso 0 · Conexiones
        </div>

        <div class="space-y-2">
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight">
            Accede al mapa de la ruta
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            Ingresa tu correo para desbloquear la guía completa de conexiones y el mapa de arquitectura operativa.
          </p>
        </div>

        {tieneGrupo ? (
          <form id="wall-form-intro" class="space-y-4 pt-2">
            <div>
              <label for="wall-email-intro" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-mono">
                Tu Correo Electrónico *
              </label>
              <input
                type="email"
                id="wall-email-intro"
                name="email"
                placeholder="Ej. tu@empresa.com"
                required
                autocomplete="email"
                class="w-full text-sm p-3.5 border border-slate-300 rounded-xl bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent transition"
              />
            </div>

            <div id="wall-error-intro" class="hidden p-3 bg-red-50 border border-red-200 text-red-600 text-xs rounded-lg font-medium"></div>

            <button
              type="submit"
              id="wall-submit-intro"
              class="w-full bg-[#00685F] hover:bg-[#005049] text-white font-bold text-base py-3.5 px-6 rounded-xl transition shadow-md cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Desbloquear mapa</span> →
            </button>
          </form>
        ) : (
          <div class="p-6 bg-slate-50 border border-dashed border-slate-300 rounded-xl text-center space-y-2">
            <p class="text-sm font-semibold text-slate-700">Próximamente</p>
            <p class="text-xs text-slate-500">
              El registro para este módulo estará disponible muy pronto.
            </p>
          </div>
        )}

        <p class="text-xs text-slate-400 text-center flex items-center justify-center gap-1.5 pt-1">
          <span>🔒</span> Cero spam. Acceso inmediato a la guía.
        </p>
      </section>
    )}

    {/* Contenido del cuerpo: visible directamente si es válido, o revelable tras formulario */}
    <div id="contenido-intro" class={accesoValido ? "space-y-8 max-w-3xl" : "hidden space-y-8 max-w-3xl"}>
      <div class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900">
          1. El ecosistema conectado de producto
        </h2>
        <p class="text-sm text-slate-700 leading-relaxed font-mono">
          [TEXTO POR ESCRIBIR]
        </p>
      </div>

      <div class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900">
          2. Por qué conectar antes de entrar a Discovery
        </h2>
        <p class="text-sm text-slate-700 leading-relaxed font-mono">
          [TEXTO POR ESCRIBIR]
        </p>
      </div>

      <div class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900">
          3. Flujo bidireccional y agentes de IA
        </h2>
        <p class="text-sm text-slate-700 leading-relaxed font-mono">
          [TEXTO POR ESCRIBIR]
        </p>
      </div>

      <!-- Pie de secuencia -->
      <div class="pt-8 border-t border-slate-200">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-5 bg-slate-50 rounded-2xl border border-slate-200">
          <div>
            <span class="text-xs font-mono text-slate-500 uppercase tracking-wider block">Siguiente contenido</span>
            <span class="text-sm font-bold text-slate-900">Sigue con: Notion ↔ Jira</span>
          </div>
          <a
            href="/ruta-product/paso-0/notion-jira"
            class="inline-flex items-center justify-center font-semibold bg-[#00685F] hover:bg-[#005049] text-white rounded-xl py-2.5 px-5 transition text-xs sm:text-sm shadow-sm"
          >
            Continuar →
          </a>
        </div>
      </div>
    </div>

    <!-- CafeCTA -->
    <CafeCTA ubicacion="paso-0-1" />
  </div>
</RutaProductLayout>

<script is:inline>
  (function () {
    function ejecutarDesbloqueo() {
      var muro = document.getElementById('muro-intro');
      var contenido = document.getElementById('contenido-intro');
      if (muro) muro.classList.add('hidden');
      if (contenido) contenido.classList.remove('hidden');
    }

    var form = document.getElementById('wall-form-intro');
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var btn = document.getElementById('wall-submit-intro');
        var errorEl = document.getElementById('wall-error-intro');
        var emailVal = (document.getElementById('wall-email-intro')?.value || '').trim();

        if (errorEl) errorEl.classList.add('hidden');
        if (btn) { btn.disabled = true; btn.innerHTML = '<span>Procesando...</span>'; }

        try {
          var res = await fetch('/api/unlock-recurso', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailVal })
          });
          var data = await res.json().catch(function () { return {}; });

          if (!res.ok || !data.ok) {
            var msg = data.error || 'No se pudo registrar el correo. Por favor intenta de nuevo.';
            if (errorEl) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); }
            if (btn) { btn.disabled = false; btn.innerHTML = '<span>Desbloquear mapa</span> →'; }
            return;
          }

          if (window.posthog) {
            window.posthog.capture('resource_unlocked', { recurso: 'Paso 0 · Mapa de la ruta', paso: '0' });
          }

          ejecutarDesbloqueo();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (err) {
          console.error('[muro-intro]', err);
          if (errorEl) { errorEl.textContent = 'Error de conexión. Intenta de nuevo.'; errorEl.classList.remove('hidden'); }
          if (btn) { btn.disabled = false; btn.innerHTML = '<span>Desbloquear mapa</span> →'; }
        }
      });
    }
  })();
</script>
