---
export const prerender = false;

import RutaProductLayout from "../../../layouts/RutaProductLayout.astro";
import CafeCTA from "../../../components/ruta-product/CafeCTA.astro";
import ComunidadCTA from "../../../components/ruta-product/ComunidadCTA.astro";
import { verificar, COOKIE_NAME } from "../../../lib/acceso-ruta";

const cookieAcceso = Astro.cookies.get(COOKIE_NAME)?.value;
const accesoValido = verificar(cookieAcceso);

const prompt1 = `Lee la página de Notion [título o enlace de la entrevista]. Es una entrevista de usuario para el feature [nombre del feature].
Devuelve, sin inventar nada:
1. Problemas detectados. Para cada uno: título corto, etiqueta y cita.
   - Etiqueta Hallazgo solo si hay una cita textual de la persona entrevistada, copiada tal cual y entre comillas.
   - Si no hay cita textual, la etiqueta es Hipótesis y en cita escribes: sin cita en la nota.
2. Qué contradice o matiza lo que ya sabemos del feature, si su página tiene evidencia previa.
3. Qué preguntas del guion no se respondieron.
4. Qué no puedes saber con esta entrevista.
No resumas la entrevista y no agregues problemas que la persona no mencionó. Escribe el resultado en la sección Análisis de problemas de la misma página.`;

const entrevistas = [
  {
    titulo: "Entrevista 1",
    perfil: "PM de plataforma B2B, varios años de experiencia",
    items: [
      {
        etiqueta: "Hallazgo",
        texto: "No sabe cómo validar qué construir ni si tendrá proyección.",
        cita: "el temor es en la primera parte del flujo [...] qué se tiene que construir y cómo validar yo que eso realmente sí tiene una proyección",
      },
      {
        etiqueta: "Hallazgo",
        texto: "Una validación anterior le pareció arbitraria y sin aprendizaje.",
        cita: "yo siento que muy arbitrario",
        extra: "Más adelante: \"siento que nunca aprendí nada de eso\".",
      },
      {
        etiqueta: "Hallazgo",
        texto: "Los resúmenes generados con IA tras una sesión no recogen lo que se habló.",
        cita: "las conclusiones que saca no son [...] las que realmente platicamos aquí tú y yo",
      },
      {
        etiqueta: "Hipótesis",
        texto: "Pagaría por un flujo ya armado.",
        cita: null,
      },
    ],
    sinResponder: "Cuánto tiempo le toma hoy analizar una entrevista y qué herramientas usa para ello.",
    noSePuedeSaber: "Si el problema es de método o de falta de práctica.",
  },
  {
    titulo: "Entrevista 2",
    perfil: "La misma persona, otro momento",
    items: [
      {
        etiqueta: "Hallazgo",
        texto: "Le faltan criterios para definir qué medir y qué cuenta como valor.",
        cita: "no tenemos una definición de qué es un usuario activo entonces como que me tocaría a mí construirla",
      },
      {
        etiqueta: "Hallazgo",
        texto: "Sabe lo que quiere resolver pero no con qué base decidir.",
        cita: "ahí es donde justo donde me siento perdida [...] en base a qué hago esa definición",
      },
      {
        etiqueta: "Hipótesis",
        texto: "Una cifra de segunda mano (casi la mitad de los tickets de soporte piden estatus) queda como hipótesis: viene de otra persona, sin fuente.",
        cita: null,
      },
    ],
    matiza: "Aquí el problema no es oír a usuarios sino definir qué medir. Es otro problema, del mismo tema.",
    noSePuedeSaber: "Si hacer entrevistas ayudaría con esta duda o si es un problema de métricas.",
  },
  {
    titulo: "Entrevista 3",
    perfil: "La misma persona, otro momento",
    items: [
      {
        etiqueta: "Hallazgo",
        texto: "Se bloquea con muchas decisiones abiertas y duda de que una solución simple sea suficiente.",
        cita: "ya estaba yo en un loop de como muchas decisiones por tomar",
        extra: "Y: \"parece más complicado que esto, cómo va a ser tan simple\".",
      },
      {
        etiqueta: "Hipótesis",
        texto: "Prefiere presentar con un prototipo antes que con un documento. Apareció en la conversación, pero sin una frase clara suya.",
        cita: null,
      },
    ],
    matiza: "Lo que la desbloqueó fue tener las ideas ordenadas, no una herramienta nueva. No pidió un producto.",
    noSePuedeSaber: "Si el bloqueo se repite o fue solo de ese día.",
  },
];
---

<RutaProductLayout
  title="De entrevista a decisión: un ejemplo resuelto"
  description="Tres entrevistas analizadas con una sola regla: sin cita textual no hay hallazgo. Más el prompt para aplicarlo a tu entrevista."
>
  <div class="space-y-10">
    <div class="space-y-2">
      <a href="/ruta-product/paso-1" class="inline-flex items-center gap-1.5 text-xs font-semibold text-teal-800 hover:text-teal-900 transition-colors">
        ← Volver al Paso 1
      </a>
      <div class="font-mono text-xs text-slate-500">
        Ruta Product Management / Paso 1 / Ejemplo resuelto
      </div>
    </div>

    <div class="space-y-3">
      <span class="inline-block text-xs font-mono font-bold text-teal-800 bg-teal-50 px-2.5 py-1 rounded-md border border-teal-200 uppercase">
        Paso 1 · Discovery
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        De entrevista a decisión: un ejemplo resuelto
      </h1>
      <p class="text-base text-slate-600 leading-relaxed max-w-2xl">
        Una regla separa un resumen de un análisis: un hallazgo solo es hallazgo si tiene una cita textual de la persona entrevistada. Sin cita, es hipótesis. Abajo la ves aplicada a tres entrevistas reales.
      </p>
    </div>

    {!accesoValido && (
      <section id="muro-ejemplo-discovery" class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200 shadow-md max-w-2xl mx-auto my-6 space-y-6">
        <div class="space-y-2">
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight">
            Desbloquea el ejemplo
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            Ingresa tu correo para ver las tres entrevistas analizadas, la decisión a la que llegan y el prompt para usarlo con tu propia entrevista.
          </p>
        </div>

        <form id="wall-form-ejemplo-discovery" class="space-y-4 pt-2">
          <div>
            <label for="wall-email-ejemplo-discovery" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-mono">
              Tu Correo Electrónico *
            </label>
            <input
              type="email"
              id="wall-email-ejemplo-discovery"
              name="email"
              placeholder="Ej. tu@empresa.com"
              required
              autocomplete="email"
              class="w-full text-sm p-3.5 border border-slate-300 rounded-xl bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent transition"
            />
          </div>

          <div id="wall-error-ejemplo-discovery" class="hidden p-3 bg-red-50 border border-red-200 text-red-600 text-xs rounded-lg font-medium"></div>

          <button
            type="submit"
            id="wall-submit-ejemplo-discovery"
            class="w-full bg-[#00685F] hover:bg-[#005049] text-white font-bold text-base py-3.5 px-6 rounded-xl transition shadow-md cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Ver el ejemplo</span> →
          </button>
        </form>

        <p class="text-xs text-slate-400 text-center">
          Acceso inmediato. Consulta nuestra <a href="/privacidad" target="_blank" class="underline hover:text-slate-600">Política de privacidad</a>.
        </p>
      </section>
    )}

    <div id="contenido-ejemplo-discovery" class={accesoValido ? "space-y-8 max-w-3xl" : "hidden space-y-8 max-w-3xl"}>

      <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-3 shadow-sm">
        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide font-mono flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-slate-900"></span> De dónde sale
        </h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Tres sesiones con una PM de una plataforma B2B, usadas con su permiso. Quitamos nombres de personas y de empresas. Las citas son literales, de transcripciones automáticas, y solo se recortó lo que no cambiaba el sentido.
        </p>
        <p class="text-sm text-slate-600 leading-relaxed">
          Una advertencia que el propio ejemplo muestra: es una sola persona y quien conducía las sesiones era su mentor, no un entrevistador neutral. Parte de las preguntas fueron guiadas. Por eso el ejemplo termina en "entrevistar más" y no en "construir".
        </p>
        <p class="text-sm text-slate-600 leading-relaxed">
          <strong class="text-slate-900">Feature de la página:</strong> validar features con entrevistas. <strong class="text-slate-900">Hipótesis a probar:</strong> los PM no saben convertir lo que oyen en una decisión de qué construir, y los resúmenes con IA no les resuelven eso.
        </p>
      </div>

      {entrevistas.map((e) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-5 shadow-sm">
          <div>
            <h2 class="text-lg font-bold text-slate-900 tracking-tight">{e.titulo}</h2>
            <p class="text-xs font-mono text-slate-500">{e.perfil}</p>
          </div>

          <ul class="space-y-4">
            {e.items.map((it) => (
              <li class="space-y-1.5">
                <div class="flex items-start gap-2">
                  <span class={`shrink-0 text-[10px] font-mono px-2 py-0.5 rounded font-semibold uppercase border ${
                    it.etiqueta === "Hallazgo"
                      ? "bg-emerald-50 text-emerald-700 border-emerald-200"
                      : "bg-amber-50 text-amber-700 border-amber-200"
                  }`}>{it.etiqueta}</span>
                  <p class="text-sm text-slate-800">{it.texto}</p>
                </div>
                {it.cita ? (
                  <blockquote class="ml-1 pl-3 border-l-2 border-teal-600 text-sm text-slate-600 italic">
                    "{it.cita}"
                    {it.extra && <span class="not-italic block text-xs text-slate-500 mt-1">{it.extra}</span>}
                  </blockquote>
                ) : (
                  <p class="ml-1 pl-3 border-l-2 border-amber-400 text-xs text-slate-500">Sin cita en la nota.</p>
                )}
              </li>
            ))}
          </ul>

          <div class="text-xs text-slate-600 space-y-1 pt-1 border-t border-slate-100">
            {e.sinResponder && <p><strong class="text-slate-800">Preguntas sin responder:</strong> {e.sinResponder}</p>}
            {e.matiza && <p><strong class="text-slate-800">Qué matiza lo anterior:</strong> {e.matiza}</p>}
            <p><strong class="text-slate-800">Qué no se puede saber:</strong> {e.noSePuedeSaber}</p>
          </div>
        </div>
      ))}

      <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-4 shadow-sm">
        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide font-mono flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-teal-600"></span> La página del feature, con las tres juntas
        </h2>
        <ul class="space-y-3 text-sm text-slate-600">
          <li>
            <strong class="text-slate-900">"No saben convertir lo que oyen en una decisión."</strong>
            Apoyan 2 de 3 entrevistas, ninguna contradice, una no toca el tema. Pero las tres son de la misma persona.
          </li>
          <li>
            <strong class="text-slate-900">"Los resúmenes con IA no resuelven eso."</strong>
            Apoya 1 de 3, con una sola cita.
          </li>
          <li>
            <strong class="text-slate-900">Perfiles que faltan:</strong> PM de producto de consumo, PM de startup, PM junior.
          </li>
        </ul>
      </div>

      <div class="bg-slate-900 text-white rounded-2xl p-6 sm:p-8 space-y-3 shadow-md">
        <span class="text-xs font-mono text-teal-400 uppercase tracking-wider block font-semibold">La decisión</span>
        <p class="text-sm text-slate-300 leading-relaxed">
          Criterio del PM de este ejemplo: una hipótesis se da por confirmada cuando tres PM de perfiles distintos la respaldan con cita. Hoy hay una persona. Ninguna hipótesis llega.
        </p>
        <p class="text-lg font-bold tracking-tight">
          Recomendación: entrevistar más, a PM de al menos dos perfiles más, antes de construir.
        </p>
        <p class="text-xs text-slate-400">
          El número lo pone cada PM. La decisión final también.
        </p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-4 shadow-sm">
        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide font-mono flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span> Pruébalo con tu entrevista
        </h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Este es el prompt de la primera entrevista. Pégalo en Claude con tu página de Notion conectada (si no la tienes conectada, el Paso 0 lo explica).
        </p>
        <pre id="prompt-1-texto" class="whitespace-pre-wrap text-xs bg-slate-50 border border-slate-200 rounded-xl p-4 text-slate-800 leading-relaxed">{prompt1}</pre>
        <button
          type="button"
          id="btn-copiar-prompt-1"
          class="inline-flex items-center justify-center font-medium bg-white border border-slate-200 hover:bg-slate-100 text-slate-800 rounded-xl py-2 px-4 transition text-xs shadow-sm cursor-pointer"
        >
          Copiar prompt
        </button>
        <p class="text-xs text-slate-500">
          Antes de confiar en el resultado, revisa que cada cita exista de verdad en tu nota. Si Claude inventa una, la regla no se cumplió.
        </p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-4 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900 tracking-tight">Lo que viene en el kit</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Estamos armando una base de Notion lista para duplicar, un guion de entrevista y los prompts para actualizar la página del feature y apoyar la decisión. Todavía no está a la venta y no tiene precio. Si quieres que te avisemos, deja tu correo.
        </p>
        <form id="aviso-kit-form" class="flex flex-col sm:flex-row gap-3">
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="tu@empresa.com"
            class="flex-1 text-sm p-3 border border-slate-300 rounded-xl bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent transition"
          />
          <button
            type="submit"
            id="aviso-kit-btn"
            class="inline-flex items-center justify-center font-semibold bg-[#00685F] hover:bg-[#005049] text-white rounded-xl py-3 px-5 text-sm transition shadow-sm cursor-pointer"
          >
            Avísame cuando esté
          </button>
        </form>
        <p id="aviso-kit-msg" class="hidden text-xs font-semibold"></p>
      </div>
    </div>

    <ComunidadCTA ubicacion="paso-1-ejemplo" />

    <CafeCTA ubicacion="paso-1-ejemplo" />
  </div>
</RutaProductLayout>

<script is:inline>
  if (window.posthog) {
    window.posthog.capture('contenido_paso_1_visto', { contenido: 'ejemplo-discovery' });
  }

  (function () {
    function ejecutarDesbloqueo() {
      var muro = document.getElementById('muro-ejemplo-discovery');
      var contenido = document.getElementById('contenido-ejemplo-discovery');
      if (muro) muro.classList.add('hidden');
      if (contenido) contenido.classList.remove('hidden');
    }

    var form = document.getElementById('wall-form-ejemplo-discovery');
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var btn = document.getElementById('wall-submit-ejemplo-discovery');
        var errorEl = document.getElementById('wall-error-ejemplo-discovery');
        var emailVal = (document.getElementById('wall-email-ejemplo-discovery')?.value || '').trim();

        if (errorEl) errorEl.classList.add('hidden');
        if (btn) { btn.disabled = true; btn.innerHTML = '<span>Procesando...</span>'; }

        try {
          var res = await fetch('/api/unlock-recurso', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailVal })
          });
          var data = await res.json().catch(function () { return {}; });

          if (!res.ok || !data.ok) {
            var msg = data.error || 'No se pudo registrar el correo. Por favor intenta de nuevo.';
            if (errorEl) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); }
            if (btn) { btn.disabled = false; btn.innerHTML = '<span>Ver el ejemplo</span> →'; }
            return;
          }

          if (window.posthog) {
            window.posthog.capture('resource_unlocked', { recurso: 'ejemplo-discovery', paso: '1' });
          }

          ejecutarDesbloqueo();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (err) {
          console.error('[muro-ejemplo-discovery]', err);
          if (errorEl) { errorEl.textContent = 'Error de conexión. Intenta de nuevo.'; errorEl.classList.remove('hidden'); }
          if (btn) { btn.disabled = false; btn.innerHTML = '<span>Ver el ejemplo</span> →'; }
        }
      });
    }

    var copiar = document.getElementById('btn-copiar-prompt-1');
    if (copiar) {
      copiar.addEventListener('click', function () {
        var el = document.getElementById('prompt-1-texto');
        if (!el || !navigator.clipboard) return;
        navigator.clipboard.writeText(el.textContent || '').then(function () {
          copiar.textContent = 'Copiado';
          if (window.posthog) {
            window.posthog.capture('prompt_copiado', { recurso: 'ejemplo-discovery', prompt: 'prompt-1', paso: '1' });
          }
          setTimeout(function () { copiar.textContent = 'Copiar prompt'; }, 2000);
        });
      });
    }

    var avisoForm = document.getElementById('aviso-kit-form');
    if (avisoForm) {
      avisoForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        var btn = document.getElementById('aviso-kit-btn');
        var msg = document.getElementById('aviso-kit-msg');
        var emailVal = (avisoForm.querySelector('input[name="email"]').value || '').trim();
        if (btn) { btn.disabled = true; }
        try {
          var res = await fetch('/api/aviso-paso', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailVal, paso: '1' })
          });
          var data = await res.json().catch(function () { return {}; });
          if (res.ok && data.ok) {
            if (msg) { msg.textContent = 'Listo. Te avisamos cuando el kit esté disponible.'; msg.className = 'text-xs font-semibold text-emerald-600'; }
            if (window.posthog) {
              window.posthog.capture('aviso_paso_registrado', { paso: '1', origen: 'ejemplo-discovery' });
            }
            avisoForm.reset();
          } else {
            if (msg) { msg.textContent = data.error || 'No pudimos registrar tu correo. Intenta de nuevo.'; msg.className = 'text-xs font-semibold text-red-600'; }
          }
        } catch (err) {
          if (msg) { msg.textContent = 'No pudimos registrar tu correo. Intenta de nuevo.'; msg.className = 'text-xs font-semibold text-red-600'; }
        }
        if (btn) { btn.disabled = false; }
      });
    }
  })();
</script>
