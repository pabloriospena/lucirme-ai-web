---
import RutaProductLayout from "../../layouts/RutaProductLayout.astro";
import CafeCTA from "../../components/ruta-product/CafeCTA.astro";
import { RUTA_PRODUCTO_DATA } from "../../data/ruta-product";

const paso2 = RUTA_PRODUCTO_DATA[1];
const tieneHoy = Boolean(paso2.loQueHacesHoy && paso2.loQueHacesHoy.length > 0);
const tieneTerminar = Boolean(paso2.loQueTienesAlTerminar && paso2.loQueTienesAlTerminar.length > 0);
const mostrarColumnas = tieneHoy || tieneTerminar;
---

<RutaProductLayout
  title="Ejecución: prioriza el backlog y convierte pitches en historias ejecutables"
  description="Paso 2 de la ruta de Product Management con IA: Ejecución, PRD y specs."
>
  <div class="space-y-10">
    <!-- Migas de pan -->
    <div class="space-y-2">
      <a href="/ruta-product" class="inline-flex items-center gap-1.5 text-xs font-semibold text-teal-800 hover:text-teal-900 transition-colors">
        ← Volver a la ruta
      </a>
      <div class="font-mono text-xs text-slate-500">
        Ruta Product Management / Paso 2 de 4
      </div>
    </div>

    <!-- Título principal y aviso de construcción -->
    <div class="space-y-3">
      <span class="inline-block text-xs font-mono font-bold text-amber-800 bg-amber-50 px-2.5 py-1 rounded-md border border-amber-200/60 uppercase">
        Paso 02 · Ejecución
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Ejecución: prioriza el backlog y convierte pitches en historias ejecutables
      </h1>
      <div class="bg-amber-50/80 border border-amber-200 text-amber-900 rounded-xl p-4 text-sm font-medium flex items-center gap-2.5">
        <span class="text-base">🚧</span>
        <span>Esta etapa está en construcción. Las herramientas de abajo ya están disponibles.</span>
      </div>
    </div>

    <!-- Dos columnas condicionales (solo si hay datos) -->
    {mostrarColumnas && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {tieneHoy && (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-4 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wide font-mono flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-amber-500"></span> Lo que haces hoy
            </h3>
            <ul class="space-y-3 text-xs sm:text-sm text-slate-600">
              {paso2.loQueHacesHoy?.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="text-amber-600 font-bold mt-0.5">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {tieneTerminar && (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-4 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wide font-mono flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-600"></span> Lo que tienes al terminar
            </h3>
            <ul class="space-y-3 text-xs sm:text-sm text-slate-600">
              {paso2.loQueTienesAlTerminar?.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-600 font-bold mt-0.5">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    <!-- Sección Recursos de este paso -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-6 shadow-sm">
      <div class="space-y-1">
        <h3 class="text-lg font-bold text-slate-900 tracking-tight">
          Recursos y herramientas de este paso
        </h3>
        <p class="text-xs text-slate-500">
          Herramientas prácticas para ejecutar la etapa de ejecución y specs.
        </p>
      </div>

      <div class="space-y-4">
        {paso2.recursos?.map((rec) => {
          const isPago = rec.tipo === "pago-proximamente";
          const tipoLabel = isPago ? "Próximamente" : "Gratis";

          return (
            <div class="p-4 rounded-xl border border-slate-200/80 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <h4 class="text-sm font-bold text-slate-900">{rec.titulo}</h4>
                  <span class={`text-[10px] font-mono px-2 py-0.5 rounded font-semibold uppercase border ${
                    isPago ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200'
                  }`}>
                    {tipoLabel}
                  </span>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed">{rec.descripcion}</p>
              </div>

              {isPago ? (
                <button
                  type="button"
                  disabled
                  class="inline-flex items-center justify-center font-medium bg-slate-100 border border-slate-200 text-slate-400 rounded-xl py-2 px-4 transition text-xs shadow-sm shrink-0 cursor-not-allowed"
                >
                  Próximamente
                </button>
              ) : (
                <a
                  href={rec.url}
                  onclick={`if (window.posthog) { window.posthog.capture('ruta_product_resource_click', { recurso: '${rec.titulo}', paso: '2' }); }`}
                  class="inline-flex items-center justify-center font-medium bg-white border border-slate-200 hover:bg-slate-100 text-slate-800 rounded-xl py-2 px-4 transition text-xs shadow-sm shrink-0"
                >
                  Acceder →
                </a>
              )}
            </div>
          );
        })}
      </div>
    </section>

    <CafeCTA ubicacion="paso-2" />
  </div>
</RutaProductLayout>
