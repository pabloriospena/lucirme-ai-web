---
import RutaProductLayout from "../../layouts/RutaProductLayout.astro";
import CafeCTA from "../../components/ruta-product/CafeCTA.astro";
import { RUTA_PRODUCTO_DATA } from "../../data/ruta-product";

const paso0 = RUTA_PRODUCTO_DATA[0];

const contenidos: Array<{
  numero: string;
  titulo: string;
  tipo: "Gratis" | "De pago";
  url: string;
  botonTexto: string;
  disponible: boolean;
  estadoBadge?: string;
}> = [
  {
    numero: "01",
    titulo: "Conecta tus herramientas: el mapa de la ruta",
    tipo: "Gratis",
    url: "/ruta-product/paso-0/intro",
    botonTexto: "Empezar",
    disponible: true,
  },
  {
    numero: "02",
    titulo: "Conecta Notion con Jira usando Claude",
    tipo: "Gratis",
    url: "/ruta-product/paso-0/notion-jira",
    botonTexto: "Empezar",
    disponible: true,
  },
  {
    numero: "03",
    titulo: "Conecta PostHog con Claude",
    tipo: "Gratis",
    url: "/ruta-product/paso-0/posthog-claude",
    botonTexto: "Empezar",
    disponible: true,
  },
  {
    numero: "04",
    titulo: "Plantilla de conexión completa",
    tipo: "De pago",
    url: "/ruta-product/paso-0/plantilla-conexion",
    botonTexto: "Ver producto",
    disponible: true,
    estadoBadge: "Próximamente",
  },
  {
    numero: "05",
    titulo: "Flujo automatizado de Discovery a Delivery",
    tipo: "De pago",
    url: "#",
    botonTexto: "Próximamente",
    disponible: false,
    estadoBadge: "Próximamente",
  },
];
---

<RutaProductLayout
  title="Paso 0 · Conexiones"
  description="Conecta las herramientas que ya usas antes de empezar el ciclo de producto."
>
  <div class="space-y-10">
    <!-- Migas de pan -->
    <div class="space-y-2">
      <a href="/ruta-product" class="inline-flex items-center gap-1.5 text-xs font-semibold text-teal-800 hover:text-teal-900 transition-colors">
        ← Volver a la ruta
      </a>
      <div class="font-mono text-xs text-slate-500">
        Ruta Product Management / Paso 0 de 5
      </div>
    </div>

    <!-- Encabezado -->
    <div class="space-y-3">
      <span class="inline-block text-xs font-mono font-bold text-amber-800 bg-amber-50 px-2.5 py-1 rounded-md border border-amber-200/60 uppercase">
        Paso 00 · Conexiones
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Conecta tus herramientas antes de empezar
      </h1>
      <p class="text-base text-slate-600 leading-relaxed max-w-2xl">
        {paso0.descripcion}
      </p>
    </div>

    <!-- Lista de contenidos en secuencia -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-6 shadow-sm">
      <div class="space-y-1">
        <h3 class="text-lg font-bold text-slate-900 tracking-tight">
          Contenidos de la etapa
        </h3>
        <p class="text-xs text-slate-500">
          Guías y configuraciones para conectar tu stack de trabajo.
        </p>
      </div>

      <div class="space-y-4">
        {contenidos.map((item) => (
          <div class={`p-4 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-4 ${
            item.disponible
              ? 'border-slate-200/80 bg-slate-50/50'
              : 'border-slate-200/60 bg-slate-50/30 opacity-80'
          }`}>
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono font-bold text-slate-500">{item.numero}</span>
                <h4 class="text-sm font-bold text-slate-900">{item.titulo}</h4>
                <span class={`text-[10px] font-mono px-2 py-0.5 rounded font-semibold uppercase border ${
                  item.tipo === 'Gratis'
                    ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                    : 'bg-amber-50 text-amber-700 border-amber-200'
                }`}>
                  {item.tipo}
                </span>
                {item.estadoBadge && (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-200 text-slate-600">
                    {item.estadoBadge}
                  </span>
                )}
              </div>
            </div>

            {item.disponible ? (
              <a
                href={item.url}
                class="inline-flex items-center justify-center font-medium bg-white border border-slate-200 hover:bg-slate-100 text-slate-800 rounded-xl py-2 px-4 transition text-xs shadow-sm shrink-0"
              >
                {item.botonTexto}
              </a>
            ) : (
              <button
                type="button"
                disabled
                class="inline-flex items-center justify-center font-medium bg-slate-100 border border-slate-200 text-slate-400 rounded-xl py-2 px-4 transition text-xs shadow-sm shrink-0 cursor-not-allowed"
              >
                {item.botonTexto}
              </button>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- CafeCTA -->
    <CafeCTA ubicacion="paso-0" />
  </div>
</RutaProductLayout>
