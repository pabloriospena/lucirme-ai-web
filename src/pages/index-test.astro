---
import Layout from '../layouts/Layout.astro';
import { LINKS } from '../lib/constants.js';

// Importamos tus secciones modulares que ya están optimizadas
import ProblemaSolucion from '../components/ProblemaSolucion.astro';
import Metodo from '../components/Metodo.astro';
import Resultados from '../components/SocialProof.astro';
import FAQ from '../components/FAQ.astro';
import SobreMi from '../components/SobreMi.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="LuciRMe AI | Enciende tu Foco">
  
  <!-- 1. MINIHEADER (La pregunta gancho) -->
  <div class="bg-amber-200 text-white py-1 px-2 text-center text-xs font-bold md:text-sm no-print">
    <p>
      ¿Cuál es tu dolor? <span class="text-teal font-black">Enciende tu foco en 60 segundos</span> 
      <button onclick="document.getElementById('selector-overlay').classList.remove('hidden')" class="underline ml-1 hover:text-teal transition">
        → Hacer test
      </button>
    </p>
  </div>

  <!-- Contenedor de la Home -->
  <main class="space-y-24 py-12">
    
    <!-- 3. HERO SECTION (La Promesa con Barra de Autoridad) -->
    <section class="max-w-4xl mx-auto px-6 text-center">
      
      <!-- Barra de Autoridad -->
      <div class="mb-10 inline-flex flex-wrap items-center justify-center gap-2 bg-gray-50 border border-gray-200 px-4 py-2 rounded-full text-xs font-bold text-gray-500">
        <span class="text-teal">+10 Acompañamientos</span>
        <span class="text-deep"></span>
      </div>

      <h1 class="text-4xl md:text-6xl font-black text-deep leading-tight tracking-tight mb-6">
        Devuelve tiempo a tu trabajo.<br />
        <span class="text-teal">Aplica IA con criterio.</span>
      </h1>
      
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-10 max-w-2xl mx-auto">
        No enseño prompts. Integro IA en flujos reales para que ejecutes menos y decidas más. Enciende tu Foco en 60 segundos y descubre tu siguiente paso.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={LINKS.calendly} target="_blank" class="bg-orange text-white px-8 py-4 rounded-lg font-bold hover:bg-orange/90 transition shadow-lg text-center">
          Agendar Café Estratégico →
        </a>
        <a href="#servicios" class="border-2 border-deep text-deep px-8 py-4 rounded-lg font-bold hover:bg-gray-100 transition text-center">
          Ver Servicios
        </a>
      </div>
    </section>

    <!-- 4. DOLOR CON CTA (El gancho emocional) -->
    <ProblemaSolucion />

    <!-- 5. SERVICIOS (Tu matriz de 2 columnas) -->
    <section id="servicios" class="py-16 px-4 bg-white">
      <div class="max-w-5xl mx-auto text-center space-y-12">
        <h2 class="text-3xl font-bold text-deep">Elige tu camino de optimización</h2>
        
        <div class="grid md:grid-cols-2 gap-8 text-left">
          <!-- Tarjeta Profesional -->
          <div class="p-8 rounded-2xl border border-gray-200 hover:border-teal transition-all flex flex-col justify-between">
            <div>
              <h3 class="font-bold text-deep text-xl mb-2">Para Profesionales</h3>
              <p class="text-sm text-gray-600 mb-6">Recupera 10h/semana y escala tu carrera con IA personalizada.</p>
            </div>
            <a href="/soluciones/profesionales" class="text-teal font-bold text-sm hover:underline">Ver opciones para profesionales →</a>
          </div>

          <!-- Tarjeta Empresas -->
          <div class="p-8 rounded-2xl border border-gray-200 hover:border-teal transition-all flex flex-col justify-between">
            <div>
              <h3 class="font-bold text-deep text-xl mb-2">Para Empresas</h3>
              <p class="text-sm text-gray-600 mb-6">Desatasca el roadmap de tu equipo y reduce la fricción operativa.</p>
            </div>
            <a href="/soluciones/empresas" class="text-teal font-bold text-sm hover:underline">Ver opciones para empresas →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA INTERMEDIO -->
    <div class="max-w-xl mx-auto text-center">
      <a href={LINKS.calendly} target="_blank" class="inline-block bg-teal text-white px-8 py-4 rounded-lg font-bold hover:bg-tealHover transition shadow-lg text-lg">
        Quiero empezar hoy mismo
      </a>
    </div>

    <!-- 6. MÉTODO (Detectar, Alinear, Ejecutar) -->
    <Metodo />

    <!-- 7. SOBRE MÍ (Pablo Ríos) -->
    <SobreMi />

    <!-- 8. RESULTADOS (Testimonios) -->
    <Resultados />

    <!-- 9. MIS INICIATIVAS (Tus otros frentes) -->
    <section class="py-16 px-4 bg-[#F8FAFC] border-y border-gray-100">
      <div class="max-w-3xl mx-auto text-center space-y-8">
        <h2 class="text-2xl font-bold text-deep">Mis otras iniciativas</h2>
        <p class="text-gray-600">Además de LuciRMe, construyo ecosistemas de automatización y productos digitales.</p>
        
        <div class="grid md:grid-cols-2 gap-6 text-left">
          <div class="bg-white p-6 rounded-xl border border-gray-200">
            <h4 class="font-bold text-deep text-base mb-1">🔥 AiTomate</h4>
            <p class="text-xs text-gray-500">Laboratorio de automatizaciones avanzadas para startups de alto crecimiento.</p>
          </div>
          <div class="bg-white p-6 rounded-xl border border-gray-200">
            <h4 class="font-bold text-deep text-base mb-1">📖 Ebook "PM Sin Bullshit"</h4>
            <p class="text-xs text-gray-500">Ecosistema de productos digitales y guías resellables en Hotmart.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. CONVERSEMOS (Cal.com Embebido seguro) -->
    <section id="calendario" class="py-24 px-4 bg-white text-center">
      <div class="max-w-2xl mx-auto space-y-6">
        <h2 class="text-3xl font-bold text-deep">Hablemos de tu proyecto</h2>
        <p class="text-gray-600">Selecciona el horario que mejor te quede para nuestra sesión de enfoque de 30 minutos.</p>
        
        <!-- Embebed de Cal.com (Estándar de la industria, 100% responsivo) -->
        <div class="w-full h-[600px] border border-gray-200 rounded-2xl overflow-hidden shadow-inner">
          <iframe src={`${LINKS.calendly}?embed=true`} width="100%" height="100%" frameborder="0"></iframe>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>