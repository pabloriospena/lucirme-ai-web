---
// /empezar: página de elección, sin producto de entrada, sin imágenes y sin botón de color. Referencia: lienzo, pantalla Empezar.
// El correo se pide en el recurso que la persona elija, no aquí.
import LayoutV2 from "../layouts/LayoutV2.astro";
import FilaBanda from "../components/v2/FilaBanda.astro";
import { LINKS } from "../lib/constants.js";

const evento = (c: string) =>
  `if (window.posthog) { window.posthog.capture('empezar_click', { camino: '${c}' }); }`;
---

<LayoutV2
  title="Empezar | LuciRMe AI"
  description="Elige por dónde empezar a aplicar IA en tu trabajo."
>
  <div class="mx-auto flex w-full max-w-[860px] flex-col gap-6 px-4 pb-4 pt-2 sm:px-6">
    <section class="flex flex-col gap-2 pt-4">
      <p class="text-sm font-semibold text-v2-accion">Empezar</p>
      <h1 class="text-[32px] font-extrabold leading-[1.14] tracking-[-1px] text-v2-texto sm:text-[40px]">¿Por dónde quieres empezar?</h1>
      <p class="text-lg leading-7 text-v2-cuerpo">Elige una opción. El correo te lo pedimos solo cuando abras un recurso.</p>
    </section>

    <section aria-label="Opciones para empezar" class="flex flex-col gap-2">
      <FilaBanda
        titulo="Usar algo hoy"
        texto="Una herramienta o guía que resuelve una cosa."
        icono="guias-herramientas"
        href="/recursos#banda-guias-herramientas"
        evento={evento("usar-hoy")}
      />
      <FilaBanda
        titulo="Aprender paso a paso"
        texto="Una ruta con pasos seguidos."
        icono="paso-a-paso"
        href="/recursos#banda-paso-a-paso"
        evento={evento("paso-a-paso")}
      />
      <FilaBanda
        titulo="Aprender en vivo"
        texto="Clases con Pablo que quedan grabadas."
        icono="clases"
        href="/clases"
        proximamente
        evento={evento("en-vivo")}
      />
      <FilaBanda
        titulo="Hablar con Pablo"
        texto="Una conversación de 30 minutos por WhatsApp."
        icono="hablar"
        href={LINKS.whatsapp}
        externo
        evento={evento("hablar")}
      />
    </section>
  </div>
</LayoutV2>
