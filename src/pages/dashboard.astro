---
import Layout from '../layouts/Layout.astro';
import { createClerkClient } from '@clerk/astro/server';

// 1. Obtenemos la sesión actual
const auth = (Astro.locals as any).auth;
const authData = typeof auth === 'function' ? await auth() : auth;

if (!authData?.userId) {
  return Astro.redirect('/sign-in');
}

// 2. Inicializamos el cliente de Clerk manualmente para obtener datos del usuario
const clerkClient = createClerkClient({ 
  secretKey: import.meta.env.CLERK_SECRET_KEY,
  publishableKey: import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY
});

const user = await clerkClient.users.getUser(authData.userId);
const diag = user.privateMetadata?.ultimoDiagnostico as any;
---

<Layout title="Mi Centro de Mando | LuciRMe AI">
  <div class="max-w-4xl">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-deep">Hola, {user.firstName || 'Product Lead'}</h1>
      <p class="text-xl text-gray-mid mt-2">Este es tu espacio de ejecución sin bullshit.</p>
    </header>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Card de Diagnóstico -->
      <div class="bg-white p-8 rounded-xl border border-gray-200 shadow-sm">
        <h2 class="text-sm font-bold text-teal uppercase tracking-widest mb-4">Estado de Sincronización</h2>
        {diag ? (
          <div>
            <p class="text-lg text-deep">Tu perfil es: <span class="font-bold capitalize">{diag.perfil}</span></p>
            <p class="text-gray-600 mt-2">Tu dolor identificado: {diag.dolor}</p>
            <a href="https://calendar.app.google/k4iYmA42X9NNBb5t8" class="mt-6 inline-block bg-orange text-white px-6 py-3 rounded-lg font-bold hover:bg-orange/90 transition">
              Agendar Café de Estrategia
            </a>
          </div>
        ) : (
          <div>
            <p class="text-gray-600">Aún no has completado tu diagnóstico.</p>
            <button onclick="document.getElementById('selector-overlay').classList.remove('hidden')" class="mt-4 text-teal font-bold hover:underline">
              → Iniciar El Selector ahora
            </button>
          </div>
        )}
      </div>

      <!-- Card de Recursos -->
      <div class="bg-deep p-8 rounded-xl text-white">
        <h2 class="text-sm font-bold text-teal uppercase tracking-widest mb-4">Recursos Disponibles</h2>
        <ul class="space-y-4">
          <li>
            <a href="/recursos" class="flex items-center gap-3 group">
              <span class="bg-white/10 p-2 rounded group-hover:bg-teal transition">📚</span>
              <span>Librería de Playbooks</span>
            </a>
          </li>
          <li>
            <a href="/recursos" class="flex items-center gap-3 group">
              <span class="bg-white/10 p-2 rounded group-hover:bg-teal transition">🛠️</span>
              <span>Micro-SaaS Builders</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</Layout>