---
import Layout from '../layouts/Layout.astro';
import { createClerkClient } from '@clerk/astro/server';
import { LINKS } from '../lib/constants.js';

const auth = (Astro.locals as any).auth;
const authData = typeof auth === 'function' ? await auth() : auth;

if (!authData?.userId) {
  return Astro.redirect('/sign-in');
}

const clerkClient = createClerkClient({ 
  secretKey: import.meta.env.CLERK_SECRET_KEY,
  publishableKey: import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY
});

const user = await clerkClient.users.getUser(authData.userId);
const diag = user.privateMetadata?.ultimoDiagnostico as any;

// Lógica de "Nivel de Evolución Potencial" (Fórmula de Negocio)
function calcularPotencial(dolorPrincipal: string) {
  const dolorLower = (dolorPrincipal || '').toLowerCase();
  if (dolorLower.includes('reportes') || dolorLower.includes('manual') || dolorLower.includes('copiar')) {
    return { horas: '10-12', porcentaje: 85 };
  }
  if (dolorLower.includes('decisión') || dolorLower.includes('backlog') || dolorLower.includes('roadmap')) {
    return { horas: '8-10', porcentaje: 75 };
  }
  return { horas: '5-8', porcentaje: 60 };
}

const potencial = calcularPotencial(diag?.dolor);

// Mapeo de herramientas sugeridas por perfil
const herramientas = {
  pro: { titulo: "Backlog Detox", url: "/recursos/backlog-detox", icono: "🧹", desc: "Filtra el ruido y prioriza con criterio." },
  startup: { titulo: "ShapeUp Builder", url: "/recursos/shapeup-builder", icono: "🎯", desc: "Estructura tu próximo ciclo sin perder el foco." },
  empresa: { titulo: "Guía NotebookLM", url: "/recursos/guia-notebooklm", icono: "📘", desc: "Automatiza reportes y documentación de procesos." }
};

const perfilActivo = diag?.perfil || 'pro';
const recomendado = herramientas[perfilActivo as keyof typeof herramientas] || herramientas.pro;
---

<Layout title="Mi Centro de Mando | LuciRMe AI">
  <main class="py-12 px-6 max-w-4xl mx-auto min-h-screen">
    
    <!-- HEADER -->
    <header class="mb-12 border-b border-gray-100 pb-8 flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-black text-deep">Consola: {user.firstName || 'Product Lead'}</h1>
        <p class="text-sm text-gray-500 mt-1">Tu espacio de ejecución y foco. Sin bullshit.</p>
      </div>
      <button id="dashboard-logout" class="text-xs font-bold text-gray-400 hover:text-red-500 transition">Cerrar Sesión</button>
    </header>

    <!-- PROCESANDO DIAGNÓSTICO RETARDADO -->
    <div id="loading-ia" class="hidden p-8 bg-teal/5 border border-teal/20 rounded-2xl text-center mb-8 animate-pulse">
      <p class="text-teal font-bold text-lg">🔄 Sincronizando tu diagnóstico con tu nueva cuenta...</p>
      <p class="text-xs text-gray-500 mt-2">Nuestra IA está modelando tu plan de acción.</p>
    </div>

    <!-- CONTENIDO GENERAL -->
    <div class="space-y-12">
      
      {diag ? (
        <!-- CARD PRINCIPAL: DIAGNÓSTICO -->
        <div class="bg-white p-8 md:p-10 rounded-2xl border border-gray-200 shadow-sm relative overflow-hidden">
          <div class="absolute top-0 left-0 w-2 h-full bg-teal"></div>
          
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-xs font-bold text-gray-400 uppercase tracking-widest">Diagnóstico de Foco</h2>
            <span class="text-xs font-bold text-deep bg-gray-100 px-3 py-1 rounded-md capitalize">Perfil: {diag.perfil}</span>
          </div>
          
          <div class="space-y-8">
            <!-- Fricción -->
            <div>
              <p class="text-xs font-bold text-orange uppercase tracking-widest mb-2">Fricción Identificada</p>
              <p class="text-lg text-deep leading-relaxed font-semibold">{diag.dolor}</p>
            </div>

            <!-- BARRA DE POTENCIAL -->
            <div class="bg-teal/5 border border-teal/10 rounded-xl p-5">
              <div class="flex items-center justify-between mb-3">
                <span class="text-sm font-bold text-deep">Potencial de recuperación</span>
                <span class="text-sm font-bold text-teal">{potencial.horas} h/semana</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
                <div class="bg-teal h-2 rounded-full transition-all duration-1000" style={`width: ${potencial.porcentaje}%`}></div>
              </div>
              <p class="text-xs text-gray-400 mt-2 font-medium">Estimado según tu contexto operativo actual</p>
            </div>

            <!-- Acciones -->
            <div class="bg-[#F8FAFC] p-6 rounded-xl border border-gray-100">
              <p class="text-xs font-bold text-teal uppercase tracking-widest mb-4">Acciones Concretas Recomendadas</p>
              <ul class="space-y-3 text-sm text-gray-700">
                <li class="flex items-start gap-3"><span class="text-teal font-bold">•</span> {diag.act1 || 'Automatiza 1 tarea recurrente esta semana con IA.'}</li>
                <li class="flex items-start gap-3"><span class="text-teal font-bold">•</span> {diag.act2 || 'Mapea tus flujos de trabajo personales.'}</li>
                <li class="flex items-start gap-3"><span class="text-teal font-bold">•</span> {diag.act3 || 'Agenda tu sesión de enfoque.'}</li>
              </ul>
            </div>
          </div>

          <div class="pt-8 mt-8 border-t border-gray-100 flex flex-col sm:flex-row gap-4 items-center justify-between">
            <button onclick="document.getElementById('selector-overlay').classList.remove('hidden')" class="text-xs font-bold text-gray-400 hover:text-deep transition underline">
              🔄 Recalibrar Foco
            </button>
            <a href={LINKS.calendly} target="_blank" class="w-full sm:w-auto text-center bg-orange text-white px-8 py-3.5 rounded-lg font-bold hover:bg-orange/90 transition shadow-md">
              Agendar Café Estratégico →
            </a>
          </div>
        </div>
      ) : (
        <!-- ESTADO SIN CALIBRAR -->
        <div class="bg-[#F8FAFC] p-10 rounded-2xl border-2 border-dashed border-gray-200 text-center flex flex-col items-center justify-center py-20">
          <span class="text-4xl mb-4">🔍</span>
          <h2 class="text-xl font-bold text-deep mb-2">Consola sin calibrar</h2>
          <p class="text-gray-500 mb-8 max-w-sm">No tenemos datos sobre tus operaciones. Inicia el Selector para recibir tu diagnóstico y plan de acción.</p>
          <button onclick="document.getElementById('selector-overlay').classList.remove('hidden')" class="bg-teal text-white px-8 py-3 rounded-lg font-bold hover:bg-tealHover transition shadow-sm">
            ⚡ Enciende tu Foco
          </button>
        </div>
      )}

      <!-- RECURSOS SUGERIDOS (Bento Grid Estilo Resultados) -->
      <div class="space-y-6">
        <h3 class="text-xl font-bold text-deep">Tus recursos para ejecutar ahora:</h3>
        
        <div class="grid md:grid-cols-2 gap-4">
          <!-- Herramienta Dinámica -->
          <a href={recomendado.url} class="group block p-6 bg-white border border-gray-200 rounded-xl hover:border-teal transition shadow-sm">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-2xl">{recomendado.icono}</span>
              <h4 class="font-bold text-deep text-sm group-hover:text-teal transition">{recomendado.titulo}</h4>
            </div>
            <p class="text-xs text-gray-500">{recomendado.desc}</p>
            <span class="text-xs text-teal font-bold mt-4 inline-block group-hover:translate-x-1 transition-transform">
              Abrir herramienta →
            </span>
          </a>

          <!-- Ebook (Acceso directo con descuento) -->
          <a href="/recursos/ebook-pm" class="group block p-6 bg-white border border-gray-200 rounded-xl hover:border-teal transition shadow-sm">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-2xl">📖</span>
              <h4 class="font-bold text-deep text-sm group-hover:text-teal transition">Ebook Oficial "PM Sin Bullshit"</h4>
            </div>
            <p class="text-xs text-gray-500">Acceso a tu cupón exclusivo de 50% de descuento por ser miembro.</p>
            <span class="text-xs text-orange font-bold mt-4 inline-block group-hover:translate-x-1 transition-transform">
              Obtener con descuento →
            </span>
          </a>
        </div>
      </div>

    </div>
  </main>
</Layout>

<script is:inline>
  // LÓGICA DE GUARDADO RETARDADO
  window.addEventListener('load', async () => {
    const pending = localStorage.getItem('lucirme_pending_diagnostic');
    if (pending) {
      const data = JSON.parse(pending);
      const loadingEl = document.getElementById('loading-ia');
      if (loadingEl) loadingEl.classList.remove('hidden');

      try {
        const response = await fetch('/api/guardar-diagnostico', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ respuestas: data.respuestas })
        });

        if (response.ok) {
          localStorage.removeItem('lucirme_pending_diagnostic');
          window.location.reload();
        }
      } catch (err) {
        console.error("Error al guardar diagnóstico pendiente:", err);
      } finally {
        if (loadingEl) loadingEl.classList.add('hidden');
      }
    }
  });

  // Logout
  const logoutBtn = document.getElementById('dashboard-logout');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      // @ts-ignore
      if (window.Clerk) {
        // @ts-ignore
        await window.Clerk.signOut();
        window.location.href = '/';
      }
    });
  }
</script>