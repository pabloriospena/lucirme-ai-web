---
import Layout from "../layouts/Layout.astro";
import RedesSociales from "../components/RedesSociales.astro";
import { LINKS } from "../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";

const herramientasGratuitas = [
  {
    titulo: "Prompteador R+C+T+E",
    url: "/recursos/prompteador",
    etiqueta: "Herramienta Gratis",
    desc: "Optimiza tus prompts con la fórmula R+C+T+E para obtener respuestas ejecutivas y de ingeniería sin ambigüedad.",
    icono: "tune"
  },
  {
    titulo: "Backlog Detox",
    url: "/recursos/backlog-detox",
    etiqueta: "Micro-SaaS Gratis",
    desc: "Limpia, filtra y prioriza tu backlog de producto con inteligencia artificial en segundos.",
    icono: "cleaning_services"
  },
  {
    titulo: "Shape Up Builder",
    url: "/recursos/shapeup-builder",
    etiqueta: "Micro-SaaS Gratis",
    desc: "Estructura pitches de producto bajo la metodología Shape Up listos para tu equipo técnico.",
    icono: "view_kanban"
  },
  {
    titulo: "CV con IA",
    url: "/recursos/cv-con-ia",
    etiqueta: "Herramienta Gratis",
    desc: "Optimiza tu hoja de vida profesional para superar filtros de contratación ATS sin clichés.",
    icono: "badge"
  },
  {
    titulo: "Job Prompt AI",
    url: "/recursos/job-prompt-ai",
    etiqueta: "Herramienta Gratis",
    desc: "Genera el prompt exacto para analizar vacantes de empleo reales y preparar entrevistas técnicas.",
    icono: "travel_explore"
  },
  {
    titulo: "Guía Deep Research",
    url: "/recursos/guia-deepresearch",
    etiqueta: "Guía Táctica",
    desc: "El superpoder de investigación profunda con IA: de 3 semanas de lectura a 4 horas estratégicas.",
    icono: "biotech"
  },
];
---

<Layout
  title="Educación & Rutas de Aprendizaje con IA | LuciRMe AI"
  description="Rutas guiadas de aprendizaje con IA: Comunicación y presentaciones ejecutivas, NotebookLM y síntesis, Product Management táctico y Empleabilidad. Empieza gratis o avanza con acompañamiento 1-1."
>
  <style>
    .route-highlight {
      animation: pulse-ring 1.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    @keyframes pulse-ring {
      0% {
        box-shadow: 0 0 0 0 rgba(13, 148, 136, 0.65);
        transform: translateY(-2px);
      }
      40% {
        box-shadow: 0 0 0 6px rgba(13, 148, 136, 0.28);
        transform: translateY(-2px);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(13, 148, 136, 0);
        transform: translateY(0);
      }
    }
  </style>

  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    
    <!-- 1. BREADCRUMB & HERO -->
    <header class="space-y-4">
      <nav class="flex flex-wrap items-center gap-2 text-xs text-gray-400 font-mono" aria-label="Breadcrumb">
        <a href="/" class="hover:text-teal transition-colors flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Inicio</span>
        </a>
        <span>/</span>
        <span class="text-deep font-semibold flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span>Educación</span>
        </span>
      </nav>

      <div class="max-w-4xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal/10 text-teal text-xs font-mono font-bold uppercase tracking-wider border border-teal/20">
          <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span>
          <span>Rutas de Aprendizaje con IA</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-deep tracking-tight">
          ¿Qué quieres resolver hoy con IA?
        </h1>
        <p class="text-base sm:text-lg text-gray-600 max-w-3xl leading-relaxed">
          No necesitas otro curso teórico de 40 horas. Elige tu problema operativo: puedes empezar gratis con un recurso concreto o profundizar con el método completo y acompañamiento directo.
        </p>
      </div>

      <!-- 2. CAMINO 1: RESOLVERLO POR MI CUENTA (SELECTOR DIRECTO DE DOLOR) -->
      <div class="pt-4 flex flex-col gap-6">
        <div class="flex flex-col gap-3">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-teal"></span>
              <h2 class="text-lg md:text-xl text-deep font-bold tracking-tight">
                Quiero resolverlo por mi cuenta
              </h2>
            </div>
            <p class="text-xs text-gray-500 font-mono">
              5 rutas disponibles · Elige y salta al recurso
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 items-stretch">
            
            <!-- Tarjeta 1: Presentaciones -->
            <button
              onclick="if (window.posthog) { window.posthog.capture('educacion_card_click', { ruta: 'ruta-comunicacion', titulo: 'Necesito hacer una presentación' }); } selectRoute('ruta-comunicacion')"
              class="group relative p-4 rounded-xl bg-white border border-gray-200 hover:border-teal hover:shadow-md transition-all flex flex-col justify-between text-left cursor-pointer"
            >
              <div>
                <div class="w-10 h-10 rounded-lg bg-teal/10 text-teal flex items-center justify-center text-xl mb-3 group-hover:scale-105 transition-transform">
                  📊
                </div>
                <h3 class="font-bold text-sm text-deep group-hover:text-teal transition-colors mb-1.5">
                  Necesito hacer una presentación
                </h3>
                <p class="text-xs text-gray-500 leading-snug">
                  Haz una presentación clara sin pasar horas ordenando datos ni peleando con slides.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-teal font-bold">
                <span>Ver ruta</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </button>

            <!-- Tarjeta 2: NotebookLM -->
            <button
              onclick="if (window.posthog) { window.posthog.capture('educacion_card_click', { ruta: 'ruta-notebooklm', titulo: 'Necesito ordenar información' }); } selectRoute('ruta-notebooklm')"
              class="group relative p-4 rounded-xl bg-white border border-gray-200 hover:border-indigo-600 hover:shadow-md transition-all flex flex-col justify-between text-left cursor-pointer"
            >
              <div>
                <div class="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center text-xl mb-3 group-hover:scale-105 transition-transform">
                  🧠
                </div>
                <h3 class="font-bold text-sm text-deep group-hover:text-indigo-700 transition-colors mb-1.5">
                  Necesito ordenar información
                </h3>
                <p class="text-xs text-gray-500 leading-snug">
                  Convierte documentos, audios y fuentes densas en síntesis útil con citas verificables.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-indigo-700 font-bold">
                <span>Ver ruta</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </button>

            <!-- Tarjeta 3: Product Management -->
            <button
              onclick="if (window.posthog) { window.posthog.capture('educacion_card_click', { ruta: 'ruta-pm', titulo: 'Necesito trabajar mejor como PM' }); } selectRoute('ruta-pm')"
              class="group relative p-4 rounded-xl bg-white border border-gray-200 hover:border-orange hover:shadow-md transition-all flex flex-col justify-between text-left cursor-pointer"
            >
              <div>
                <div class="w-10 h-10 rounded-lg bg-orange/10 text-orange flex items-center justify-center text-xl mb-3 group-hover:scale-105 transition-transform">
                  🚀
                </div>
                <h3 class="font-bold text-sm text-deep group-hover:text-orange transition-colors mb-1.5">
                  Necesito trabajar mejor como PM
                </h3>
                <p class="text-xs text-gray-500 leading-snug">
                  Prioriza backlog, estructura problemas y toma decisiones sin plantillas vacías.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-orange font-bold">
                <span>Ver ruta</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </button>

            <!-- Tarjeta 4: Carrera -->
            <button
              onclick="if (window.posthog) { window.posthog.capture('educacion_card_click', { ruta: 'ruta-empleabilidad', titulo: 'Necesito mejorar mi carrera' }); } selectRoute('ruta-empleabilidad')"
              class="group relative p-4 rounded-xl bg-white border border-gray-200 hover:border-emerald-600 hover:shadow-md transition-all flex flex-col justify-between text-left cursor-pointer"
            >
              <div>
                <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl mb-3 group-hover:scale-105 transition-transform">
                  💼
                </div>
                <h3 class="font-bold text-sm text-deep group-hover:text-emerald-600 transition-colors mb-1.5">
                  Necesito mejorar mi carrera
                </h3>
                <p class="text-xs text-gray-500 leading-snug">
                  Usa IA para mejorar tu CV, posicionamiento, rastreo de vacantes y plan de crecimiento.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-emerald-600 font-bold">
                <span>Ver ruta</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </button>

            <!-- Tarjeta 5: Imágenes & Video -->
            <button
              onclick="if (window.posthog) { window.posthog.capture('educacion_card_click', { ruta: 'ruta-visual', titulo: 'Crear imágenes y videos' }); } selectRoute('ruta-visual')"
              class="group relative p-4 rounded-xl bg-white border border-gray-200 hover:border-teal hover:shadow-md transition-all flex flex-col justify-between text-left cursor-pointer"
            >
              <div>
                <div class="w-10 h-10 rounded-lg bg-teal/10 text-teal flex items-center justify-center text-xl mb-3 group-hover:scale-105 transition-transform">
                  📷
                </div>
                <h3 class="font-bold text-sm text-deep group-hover:text-teal transition-colors mb-1.5">
                  Crear imágenes y videos
                </h3>
                <p class="text-xs text-gray-500 leading-snug">
                  Crea, transforma y edita piezas visuales con IA mediante comandos directos.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-teal font-bold">
                <span>Ver ruta</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </button>

          </div>
        </div>

        <!-- 3. CAMINO 2: RESOLVERLO CONTIGO (CAFÉ DE ESTRATEGIA) -->
        <div class="p-6 md:p-8 rounded-2xl bg-[#0F172A] border border-slate-800 text-white shadow-md flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="flex items-start gap-4 max-w-2xl">
            <div class="w-11 h-11 rounded-xl bg-slate-800/90 text-teal-300 border border-slate-700/80 flex items-center justify-center text-xl shrink-0">
              ☕
            </div>
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <span class="text-[11px] font-bold uppercase tracking-wider text-teal-300 font-mono">
                  QUIERO RESOLVERLO CONTIGO
                </span>
                <span class="text-slate-600">•</span>
                <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700 font-mono">
                  Café de Estrategia • 30 min • 1:1
                </span>
              </div>
              <h3 class="text-xl font-bold text-white tracking-tight mb-1">
                Tengo un problema concreto y no quiero perder más semanas
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                Revisamos tus archivos, proceso de trabajo o cuello de botella en vivo. Sin compras obligadas ni teoría abstracta.
              </p>
            </div>
          </div>
          <div class="shrink-0 flex sm:self-center">
            <a
              href={`${whatsappBase}?text=${encodeURIComponent("Hola Pablo, estuve revisando la sección de Educación y quiero agendar un Café de Estrategia 1:1.")}`}
              target="_blank"
              rel="noopener noreferrer"
              onclick="if (window.posthog) { window.posthog.capture('educacion_whatsapp_click', { origen: 'banner_resolverlo_contigo', tipo: 'cafe_estrategia' }); }"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-all shadow-sm cursor-pointer"
            >
              <span>☕ Agendar Café de Estrategia</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- 4. TERMÓMETRO IA (TERCERA VÍA PARA INDECISOS) -->
    <section class="bg-gradient-to-r from-teal/5 via-teal/10 to-emerald-50 rounded-2xl p-6 md:p-8 border border-teal/20 relative overflow-hidden shadow-2xs" id="termometro-banner">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="flex items-start gap-4 max-w-2xl">
          <div class="w-10 h-10 rounded-xl bg-white border border-teal/20 text-teal flex items-center justify-center shrink-0 shadow-2xs text-lg">
            🌡️
          </div>
          <div>
            <h3 class="text-lg md:text-xl text-deep tracking-tight mb-1 font-bold">
              ¿No sabes por cuál ruta empezar?
            </h3>
            <p class="text-xs md:text-sm text-gray-600 leading-relaxed mb-2">
              Responde 9 preguntas rápidas en 2 minutos y descubre qué cuello de botella te conviene destrabar primero con IA.
            </p>
            <div class="flex flex-wrap items-center gap-y-1 gap-x-3 text-[11px] text-gray-500 font-mono">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-teal"></span> 2 minutos
              </span>
              <span>•</span>
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 100% gratis
              </span>
              <span>•</span>
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-orange"></span> Diagnóstico inmediato
              </span>
            </div>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full lg:w-auto shrink-0">
          <button
            onclick="if (window.posthog) { window.posthog.capture('educacion_termometro_open_click', { origen: 'banner_termometro' }); } document.getElementById('selector-overlay')?.classList.remove('hidden')"
            class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl bg-teal text-white font-bold text-xs hover:bg-teal/90 transition-all shadow-2xs cursor-pointer text-center"
          >
            <span>Descubrir mi ruta</span>
            <span>→</span>
          </button>
          <a
            href={`${whatsappBase}?text=${encodeURIComponent("Hola Pablo, tengo dudas sobre qué ruta educativa tomar y quiero consultarte.")}`}
            target="_blank"
            rel="noopener noreferrer"
            onclick="if (window.posthog) { window.posthog.capture('educacion_whatsapp_click', { origen: 'banner_termometro', tipo: 'hablar_conmigo' }); }"
            class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl bg-white border border-gray-200 text-deep font-bold text-xs hover:bg-gray-50 transition-all text-center"
          >
            <span>💬 Hablar con Pablo</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 5. SECCIÓN RUTAS MAESTRAS COMPLETAS -->
    <main class="space-y-6 pt-2" id="rutas-maestras">
      
      <!-- Pestañas / Filtros de Categoría -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-3 border-b border-gray-200">
        <div>
          <h2 class="text-2xl font-bold text-deep tracking-tight mb-1">
            Rutas de Aprendizaje Guiadas
          </h2>
          <p class="text-xs sm:text-sm text-gray-500">
            Empieza con el recurso gratuito. Si requieres el método completo o aceleración, avanza en los siguientes pasos Pro.
          </p>
        </div>

        <div class="inline-flex p-1 bg-gray-200/60 rounded-xl border border-gray-200/80 self-start sm:self-auto overflow-x-auto max-w-full shrink-0">
          <button
            id="tab-all"
            onclick="filterRoutes('all')"
            class="route-tab px-3 py-1.5 rounded-lg text-xs font-bold text-teal bg-white shadow-2xs transition-colors whitespace-nowrap cursor-pointer"
          >
            Todas las rutas
          </button>
          <button
            id="tab-ruta-comunicacion"
            onclick="filterRoutes('ruta-comunicacion')"
            class="route-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:text-deep transition-colors whitespace-nowrap cursor-pointer"
          >
            Presentaciones
          </button>
          <button
            id="tab-ruta-notebooklm"
            onclick="filterRoutes('ruta-notebooklm')"
            class="route-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:text-deep transition-colors whitespace-nowrap cursor-pointer"
          >
            Información
          </button>
          <button
            id="tab-ruta-pm"
            onclick="filterRoutes('ruta-pm')"
            class="route-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:text-deep transition-colors whitespace-nowrap cursor-pointer"
          >
            Product Management
          </button>
          <button
            id="tab-ruta-empleabilidad"
            onclick="filterRoutes('ruta-empleabilidad')"
            class="route-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:text-deep transition-colors whitespace-nowrap cursor-pointer"
          >
            Carrera
          </button>
          <button
            id="tab-ruta-visual"
            onclick="filterRoutes('ruta-visual')"
            class="route-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:text-deep transition-colors whitespace-nowrap cursor-pointer"
          >
            Imágenes y videos
          </button>
        </div>
      </div>

      <!-- Wrapper de las 5 Rutas Maestras -->
      <div class="flex flex-col gap-10" id="routes-wrapper">
        
        <!-- ========================================================= -->
        <!-- RUTA 01: PRESENTACIONES                                  -->
        <!-- ========================================================= -->
        <article
          class="route-master-card bg-white rounded-2xl border border-gray-200 shadow-2xs overflow-hidden p-6 md:p-8 space-y-6 transition-all"
          data-route="ruta-comunicacion"
          id="ruta-comunicacion"
        >
          <div>
            <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded bg-teal/10 text-teal font-mono">
              Ruta 01 • Presentaciones
            </span>
            <h3 class="text-xl md:text-2xl font-extrabold text-deep tracking-tight mt-1">
              De información desordenada a presentación ejecutiva lista
            </h3>
          </div>

          <!-- PASO 1 DOMINANTE: GRATIS -->
          <div class="bg-teal/5 rounded-xl border-2 border-teal/40 p-5 md:p-6 shadow-2xs">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div class="max-w-2xl">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] bg-emerald-100 text-emerald-800 font-bold mb-2 font-mono">
                  Empieza aquí • Gratis
                </span>
                <h4 class="text-lg md:text-xl text-deep font-bold">
                  Presentaciones con IA en 30 minutos
                </h4>
                <p class="text-xs text-gray-600 mt-1 leading-relaxed">
                  Aprende a estructurar una presentación clara en 4 pasos y usa prompts prácticos para empezar sin bloqueo.
                </p>
              </div>
              <a
                href="/presentaciones-con-ia"
                onclick="if (window.posthog) { window.posthog.capture('educacion_free_resource_click', { ruta: 'ruta-comunicacion', recurso: 'presentaciones-con-ia' }); }"
                class="inline-flex items-center justify-center gap-1.5 px-5 py-3 rounded-xl bg-teal text-white font-bold text-xs hover:bg-teal/90 transition-all shrink-0 shadow-2xs"
              >
                <span>Empezar gratis</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- DIVISOR SUTIL -->
          <div class="flex items-center gap-3">
            <span class="text-[10px] text-gray-400 font-bold uppercase tracking-wider font-mono">
              SI NECESITAS OTRA FORMA DE RESOLVERLO:
            </span>
            <div class="h-px bg-gray-100 flex-1"></div>
          </div>

          <!-- 3 COLUMNAS COMPLEMENTARIAS: HERRAMIENTA / CURSO / 1:1 -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-stretch">
            
            <div class="p-4 rounded-xl bg-gray-50 border border-gray-200/80 flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between gap-1 mb-2">
                  <span class="text-[10px] text-gray-500 font-medium">Más rápido • Herramienta</span>
                  <span class="text-[10px] px-2 py-0.5 rounded bg-amber-100 text-amber-900 font-bold font-mono">$8 USD</span>
                </div>
                <h5 class="text-sm text-deep font-bold mb-1">Bot Asistente de Presentaciones</h5>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Asistente IA que te guía paso a paso para estructurar tu presentación y avanzar slide a slide sin perder el hilo.
                </p>
              </div>
              <a
                href="/bot-presentaciones"
                onclick="if (window.posthog) { window.posthog.capture('educacion_bot_buy_click', { producto: 'bot_presentaciones', precio: '8 USD', ruta: 'ruta-comunicacion' }); }"
