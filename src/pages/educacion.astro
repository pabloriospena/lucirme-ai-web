  <!-- SCRIPT INTERACTIVO: FILTRO DE RUTAS, HIGHLIGHT & HASH NAVIGATION -->
  <script is:inline>
    function selectRoute(targetRouteId) {
      if (window.posthog) {
        window.posthog.capture('educacion_select_route', { ruta: targetRouteId });
      }
      filterRoutes(targetRouteId);
      const targetElement = document.getElementById(targetRouteId);
      if (targetElement) {
        targetElement.scrollIntoView({ behavior: "smooth", block: "start" });
        targetElement.classList.remove("route-highlight");
        void targetElement.offsetWidth; // trigger reflow
        targetElement.classList.add("route-highlight");
        setTimeout(() => {
          targetElement.classList.remove("route-highlight");
        }, 1800);
      }
    }

    function filterRoutes(routeFilter) {
      if (window.posthog) {
        window.posthog.capture('educacion_filter_routes', { filtro: routeFilter });
      }
      const cards = document.querySelectorAll(".route-master-card");
      const tabs = document.querySelectorAll(".route-tab");

      tabs.forEach((tab) => {
        tab.classList.remove("text-teal", "bg-white", "shadow-2xs", "font-bold");
        tab.classList.add("text-gray-500", "font-semibold");
      });

      const activeTab = document.getElementById("tab-" + routeFilter);
      if (activeTab) {
        activeTab.classList.add(
          "text-teal",
          "bg-white",
          "shadow-2xs",
          "font-bold",
        );
        activeTab.classList.remove("text-gray-500", "font-semibold");
      }

      cards.forEach((card) => {
        if (
          routeFilter === "all" ||
          card.getAttribute("data-route") === routeFilter
        ) {
          card.style.display = "block";
        } else {
          card.style.display = "none";
        }
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
      if (window.posthog) {
        window.posthog.capture("educacion_page_view", {
          pagina: "educacion",
          categoria: "educacion"
        });
      }

      const hash = window.location.hash.replace("#", "");
      if (hash && document.getElementById(hash)) {
        selectRoute(hash);
      }
    });
  </script>
