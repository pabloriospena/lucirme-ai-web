---
import Layout from "../../layouts/Layout.astro";
import { LINKS } from "../../lib/constants.js";
import SobreMi from '../../components/SobreMi.astro';
import RedesSociales from '../../components/RedesSociales.astro';


const tareas = [
    { id: 1, categoria: "Profesionales", titulo: "Compilar reportes semanales de Excel", meta: "ChatGPT / Claude • 5 min", prompt: "Resume estos datos en un reporte ejecutivo con 3 puntos clave, 2 tendencias y 2 recomendaciones. Tono: profesional y directo.", resultado: "De 2 horas manuales → 10 min de revisión." },
    { id: 2, categoria: "Profesionales", titulo: "Correos repetitivos de seguimiento", meta: "Copilot / ChatGPT • 2 min", prompt: "Redacta un correo de seguimiento para [cliente]. Contexto: [pegar correo]. Tono: cordial, directo. Incluye próximo paso y fecha.", resultado: "De 15 min pensando → 2 min ajustando." },
    { id: 3, categoria: "Profesionales", titulo: "Organizar información de múltiples fuentes", meta: "ChatGPT / Claude • 3 min", prompt: "Organiza esta información en: 1) Categorías, 2) Subcategorías, 3) Puntos clave, 4) Acciones pendientes. Formato: tabla.", resultado: "De 30 min clasificando → 5 min validando." },
    { id: 4, categoria: "Profesionales", titulo: "Seguimiento manual de tareas pendientes", meta: "ChatGPT + Notion/Sheets • 5 min", prompt: "Crea una plantilla de seguimiento con: Tarea | Responsable | Fecha | Estado | Bloqueadores. Genera 5 filas de ejemplo para [proyecto].", resultado: "De 20 min creando tracker → 5 min personalizando." },
    { id: 5, categoria: "Empresas", titulo: "Procesamiento de documentos (facturas/contratos)", meta: "ChatGPT Plus (Análisis) • 5 min", prompt: "Extrae de este PDF: fecha, monto, proveedor, concepto. Organízalo en formato tabla CSV para importar a Excel.", resultado: "De 15 min digitando → 2 min validando." },
    { id: 6, categoria: "Empresas", titulo: "Generar reportes mensuales para clientes", meta: "ChatGPT / Claude • 8 min", prompt: "Basado en estos datos, genera reporte con: 1) Resumen (3 líneas), 2) Resultados vs objetivos, 3) Tendencias, 4) Recomendaciones.", resultado: "De 1 hora redactando → 10 min ajustando." },
    { id: 7, categoria: "Empresas", titulo: "Responder consultas frecuentes de clientes", meta: "Copilot / ChatGPT • 2 min", prompt: "Responde esta consulta: [pregunta]. Incluye: saludo, respuesta en 2 párrafos, recursos adicionales, cierre. Tono: [formal/cercano].", resultado: "De 10 min redactando → 2 min ajustando." },
    { id: 8, categoria: "Empresas", titulo: "Transcripción y resumen de reuniones", meta: "Otter.ai / Whisper + ChatGPT • 5 min", prompt: "Genera resumen con: 1) Puntos clave (máx 5), 2) Decisiones, 3) Acciones con responsables, 4) Fecha seguimiento. Formato: acta ejecutiva.", resultado: "De 30 min transcribiendo → 5 min validando." },
    { id: 9, categoria: "Todos", titulo: "Crear borradores de presentaciones", meta: "ChatGPT / Claude • 10 min", prompt: "Crea outline para presentación sobre [tema] a [audiencia]. Incluye: Gancho, Problema, Solución, Beneficios, Casos, Próximos pasos.", resultado: "De 2 horas estructurando → 15 min ajustando." },
    { id: 10, categoria: "Todos", titulo: "Búsqueda interna en historiales de correos", meta: "ChatGPT / Claude • 3 min", prompt: "Busca en este texto información sobre: [tema]. Extrae: Fechas, Personas, Decisiones, Documentos. Formato: resumen cronológico.", resultado: "De 20 min buscando → 3 min validando." },
];

const calendlyUrl = LINKS.calendly_empresa || LINKS.calendly;
---

<Layout title="¿Dónde pierdes más tiempo? | Diagnóstico Express - LuciRMe AI">
    
    <!-- SUB-NAV MINIMALISTA -->
    <nav class="bg-white/80 backdrop-blur-md border-b border-gray-100 px-6 py-4 sticky top-0 z-50">
        <div class="max-w-5xl mx-auto flex justify-between items-center">
            <a href="/" class="text-sm font-medium text-gray-500 hover:text-deep transition flex items-center gap-2">
                <span>←</span> Volver al inicio
            </a>
            <a href="#diagnostico" class="btn-primary text-sm py-2 px-5">
                Agendar Diagnóstico (30 min)
            </a>
        </div>
    </nav>

    <!-- HERO: MÁS AIRE, MENOS RUIDO -->
    <section class="bg-deep text-white py-24 px-6">
        <div class="max-w-3xl mx-auto text-center">
            <span class="inline-block bg-teal/10 text-teal text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full mb-6 border border-teal/20">
                Guía Práctica &amp; Diagnóstico Express
            </span>
            <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-[1.1] tracking-tight">
                ¿Dónde pierdes más <span class="text-teal">tiempo</span>?
            </h1>
            <p class="text-xl text-gray-300 mb-10 leading-relaxed max-w-2xl mx-auto">
                10 tareas que puedes automatizar HOY con un solo copy-paste. 
                Sin volverte técnico. Sin teoría vacía.
            </p>
            <a href="#checklist" class="btn-primary text-lg py-4 px-8 inline-flex items-center gap-2">
                Ver las 10 tareas ↓
            </a>
        </div>
    </section>

    <!-- INTRODUCCIÓN: LIMPIA Y DIRECTA -->
    <section class="py-20 px-6 bg-light">
        <div class="max-w-3xl mx-auto text-center">
            <h2 class="text-3xl font-bold text-deep mb-6">
                No es tu culpa. Es que los tutoriales son genéricos.
            </h2>
            <p class="text-lg text-gray-600 leading-relaxed mb-8">
                Sabes que pierdes horas compilando datos o respondiendo lo mismo. 
                Pero la IA no sirve de nada si no se adapta a <strong>tu</strong> contexto. 
                Esta no es una guía teórica. Es una lista de verificación con prompts listos para usar en tu trabajo real, hoy mismo.
            </p>
        </div>
    </section>

    <!-- CHECKLIST: DIVULGACIÓN PROGRESIVA (ACORDEÓN) -->
    <section id="checklist" class="py-20 px-6 bg-white border-t border-gray-100">
        <div class="max-w-3xl mx-auto">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-deep mb-3">Las 10 Tareas Automatizables</h2>
                <p class="text-gray-500">Haz clic en la que más te duela para ver el prompt exacto.</p>
            </div>

            <div class="space-y-3">
                {tareas.map((tarea) => (
                    <details class="group border border-gray-200 rounded-xl bg-light open:bg-white open:shadow-md open:border-teal/30 transition-all duration-300">
                        <summary class="flex justify-between items-center p-5 cursor-pointer list-none select-none">
                            <div class="flex items-center gap-4">
                                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-deep/5 text-deep font-bold flex items-center justify-center text-sm group-open:bg-teal group-open:text-white transition-colors">
                                    {tarea.id}
                                </span>
                                <span class="font-semibold text-deep text-lg group-open:text-teal transition-colors">
                                    {tarea.titulo}
                                </span>
                            </div>
                            <span class="text-gray-400 group-open:rotate-180 transition-transform duration-300">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </span>
                        </summary>
                        
                        <!-- CONTENIDO DESPLEGABLE -->
                        <div class="px-5 pb-6 pt-2 border-t border-gray-100 mt-2">
                            <div class="flex flex-wrap gap-3 mb-4 text-sm">
                                <span class="bg-gray-100 text-gray-600 px-3 py-1 rounded-md font-medium">
                                    🛠️ {tarea.meta}
                                </span>
                                <span class="bg-teal/10 text-teal px-3 py-1 rounded-md font-medium">
                                    🏷️ {tarea.categoria}
                                </span>
                            </div>

                            <div class="bg-deep rounded-lg p-4 mb-4 relative group">
                                <button 
                                    type="button" 
                                    class="copy-btn absolute top-3 right-3 text-xs bg-white/10 hover:bg-white/20 text-white px-3 py-1.5 rounded transition flex items-center gap-1.5 cursor-pointer"
                                    data-prompt={tarea.prompt}
                                >
                                    <span>📋 Copiar</span>
                                </button>
                                <p class="text-sm text-gray-300 font-mono leading-relaxed pr-20">
                                    "{tarea.prompt}"
                                </p>
                            </div>

                            <div class="flex items-start gap-2 text-sm">
                                <span class="text-green-600 font-bold mt-0.5">✅</span>
                                <span class="text-gray-600"><strong>Resultado esperado:</strong> {tarea.resultado}</span>
                            </div>
                        </div>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <!-- CALCULADORA: SLIDER TÁCTIL -->
    <section id="diagnostico" class="py-24 px-6 bg-slate-50">
        <div class="max-w-2xl mx-auto text-center">
            <h2 class="text-3xl font-bold text-deep mb-4">Lo que no se mide, no se mejora.</h2>
            <p class="text-gray-600 mb-10">Desliza para estimar cuántas horas <strong>reales</strong> pierdes a la semana en estas tareas.</p>

            <div class="bg-white border border-gray-200 rounded-2xl p-8 shadow-sm max-w-md mx-auto">
                <div class="mb-8">
                    <label class="block text-sm font-bold text-gray-500 uppercase tracking-wider mb-4">
                        Horas semanales desperdiciadas
                    </label>
                    <input 
                        type="range" 
                        id="calc-slider" 
                        min="1" 
                        max="40" 
                        value="10" 
                        class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-orange"
                    >
                    <div class="flex justify-between text-xs text-gray-400 mt-2">
                        <span>1h</span>
                        <span>20h</span>
                        <span>40h</span>
                    </div>
                </div>

                <div class="bg-orange/5 border border-orange/10 rounded-xl p-6">
                    <p class="text-gray-600 text-sm mb-1">
                        Estás perdiendo aproximadamente:
                    </p>
                    <p id="calc-resultado" class="text-3xl md:text-4xl font-black text-orange my-2">
                        $2.000.000 COP
                    </p>
                    <p class="text-gray-500 text-xs leading-relaxed">
                        ...al mes (calculado a $50.000/hora). Dinero y energía que podrías recuperar esta misma semana.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA FINAL: CLARO Y SIN PRESIÓN -->
    <section class="py-24 px-6 bg-deep text-white">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">¿Qué haces ahora con esta información?</h2>
            <p class="text-xl text-gray-300 mb-12 max-w-2xl mx-auto">
                Los prompts de arriba son el punto de partida. Pero cada trabajo es diferente.
            </p>

            <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto text-left">
                <!-- Opción A -->
                <div class="bg-white/5 border border-white/10 rounded-2xl p-8">
                    <h3 class="text-xl font-bold text-white mb-3">🚀 Opción A: Lo hago solo</h3>
                    <p class="text-gray-400 text-sm leading-relaxed mb-6">
                        Copia los prompts, pruébalos y empieza a recuperar tu tiempo hoy mismo. Sin compromiso.
                    </p>
                    <p class="text-xs text-gray-500 italic border-t border-white/10 pt-4">
                        "Si no devuelve tiempo, claridad o control, no es LuciRMe."
                    </p>
                </div>

                <!-- Opción B -->
                <div class="bg-orange/10 border-2 border-orange/40 rounded-2xl p-8 relative">
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-orange text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full">
                        Recomendado
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">🎯 Opción B: Quiero un experto</h3>
                    <p class="text-gray-300 text-sm leading-relaxed mb-6">
                        Agenda un <strong>Diagnóstico de 30 min</strong>. Mapeamos tu proceso real y te digo exactamente qué automatizar. Sin venta agresiva.
                    </p>
                    <a href={calendlyUrl} target="_blank" class="btn-primary w-full block text-center py-3.5">
                        Reservar mi Diagnóstico →
                    </a>
                    <p class="text-center text-xs text-gray-400 mt-3">Sin tarjeta de crédito requerida</p>
                </div>
            </div>
        </div>
    </section>
    <SobreMi />
    <RedesSociales />

</Layout>

<style>
    @import "../../styles/global.css";

    .btn-primary {
        @apply inline-flex items-center justify-center font-bold bg-orange text-white rounded-xl py-3 px-6 hover:bg-orange/90 transition-all shadow-sm hover:shadow-md cursor-pointer;
    }
    
    details > summary {
        list-style: none;
    }
    details > summary::-webkit-details-marker {
        display: none;
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        // 1. Copiar al portapapeles
        document.querySelectorAll(".copy-btn").forEach((btn) => {
            btn.addEventListener("click", async () => {
                const promptText = btn.getAttribute("data-prompt");
                if (promptText) {
                    try {
                        await navigator.clipboard.writeText(promptText);
                        const originalHTML = btn.innerHTML;
                        btn.innerHTML = "<span>✅ ¡Copiado!</span>";
                        setTimeout(() => { btn.innerHTML = originalHTML; }, 2000);
                    } catch (e) { 
                        console.error("Error al copiar", e); 
                    }
                }
            });
        });

        // 2. Calculadora con Slider
        const slider = document.getElementById("calc-slider");
        const resultado = document.getElementById("calc-resultado");

        if (slider && resultado) {
            const updateCalc = () => {
                const h = parseInt(slider.value) || 0;
                const cop = h * 4 * 50000;
                resultado.textContent = new Intl.NumberFormat("es-CO", {
                    style: "currency", 
                    currency: "COP", 
                    maximumFractionDigits: 0
                }).format(cop);
            };
            slider.addEventListener("input", updateCalc);
            updateCalc(); // Inicializar
        }
    });
</script>
