---
import Layout from "../../layouts/Layout.astro";
import { LINKS } from "../../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const ctaGeneral = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, estuve viendo la landing de IA para Producto y quiero agendar una conversación.")}`;
const ctaRevisarProceso = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, quiero revisar mi proceso de Producto con IA.")}`;
const ctaProfesional = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, soy profesional de producto y quiero mejorar mi forma de trabajar con IA.")}`;
const ctaLider = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, soy líder / head de producto y quiero incorporar IA en mi equipo.")}`;
const ctaConsultarCaso = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, tengo un caso de uso específico de Producto que quiero consultar.")}`;
const ctaFinalWA = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, quiero revisar un proceso de Producto que me quita mucho tiempo.")}`;

const productSeoSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://lucirme.com/servicios/producto#service",
      "name": "IA para Producto y Product Operations",
      "serviceType": "Artificial Intelligence Consulting & Implementation",
      "provider": {
        "@type": "Organization",
        "name": "LuciRMe AI",
        "url": "https://lucirme.com"
      },
      "areaServed": ["Colombia", "Latinoamérica", "Global"],
      "description": "Acompañamiento en vivo e implementación de Inteligencia Artificial para Product Managers, Product Designers, Product Ops y Heads of Product.",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://lucirme.com/servicios/producto#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Necesitamos saber programar o tener conocimientos técnicos de IA?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Todos los flujos se diseñan en lenguaje natural e interfaces accesibles para cualquier perfil de producto u operaciones."
          }
        },
        {
          "@type": "Question",
          "name": "¿Esto sustituye nuestras herramientas actuales (Jira, Notion, Figma, Slack)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En absoluto. El objetivo es acoplar la IA al stack existente donde ya trabaja tu equipo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se maneja la privacidad y la seguridad de los datos de la empresa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Utilizamos entornos corporativos y APIs con acuerdos de no retención de datos, lo que garantiza que la información no se utiliza para entrenar modelos públicos."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title="IA para Producto | LuciRMe AI — Acompañamiento en Vivo e Implementación"
  description="Acompaño a profesionales, PMs y líderes de Producto a integrar IA práctica directamente en sus flujos diarios: research, feedback, síntesis de syncs, PRDs y reporting ejecutivo."
  keywords="ia para producto, product management ia, automatizaciones de producto, consultoria ia colombia, pablo rios, product ops ia, mentorias inteligencia artificial"
  jsonLd={productSeoSchema}
>

  <!-- STICKY HEADER EDITORIAL -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
      
      <!-- BRAND / LOGO -->
      <div class="flex items-center gap-3 shrink-0">
        <a href="/" class="flex items-center gap-1.5 font-bold text-lg tracking-tight text-slate-900 hover:text-teal-700 transition-colors">
          <span>LuciRMe</span>
          <span class="text-teal-600 font-extrabold">AI</span>
        </a>
        <span class="hidden sm:inline-block text-[10px] font-mono uppercase tracking-widest bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md border border-slate-200">
          PRODUCTO
        </span>
      </div>

      <!-- DESKTOP NAV -->
      <nav class="hidden lg:flex items-center gap-6 text-xs font-semibold text-slate-600">
        <a href="#que-resolvemos" class="hover:text-teal-600 transition-colors">Qué resolvemos</a>
        <a href="#casos-de-uso" class="hover:text-teal-600 transition-colors">Casos de uso</a>
        <a href="#como-trabajamos" class="hover:text-teal-600 transition-colors">Cómo trabajamos</a>
        <a href="#sobre-mi" class="hover:text-teal-600 transition-colors">Sobre mí</a>
        <a href="#faq" class="hover:text-teal-600 transition-colors">FAQ</a>
      </nav>

      <!-- RIGHT ACTIONS -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a 
          href="/rutas" 
          class="hidden sm:inline-flex items-center text-xs font-medium text-slate-700 bg-slate-100 hover:bg-slate-200/80 px-3 py-1.5 rounded-lg transition-colors border border-slate-200"
        >
          Rutas de Aprendizaje
        </a>
        <a 
          href={ctaGeneral}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 px-3.5 py-1.5 rounded-lg transition-all shadow-xs cursor-pointer"
        >
          <span class="material-symbols-outlined text-[16px]">chat</span>
          <span>Agendar conversación</span>
        </a>
      </div>

    </div>
  </header>

  <!-- MAIN WRAPPER -->
  <main class="w-full bg-slate-50 min-h-screen">
    
    <!-- HERO SECTION: Editorial & Clean -->
    <section class="w-full max-w-5xl mx-auto px-4 sm:px-6 pt-12 pb-16 flex flex-col items-start text-left">
      
      <!-- Eyebrow Tag -->
      <div class="inline-flex items-center gap-2 bg-slate-100 border border-slate-200/80 px-3 py-1 rounded-full mb-6 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"></span>
        <span class="text-xs font-mono font-semibold text-teal-700 uppercase tracking-wider">IA APLICADA A PRODUCT MANAGEMENT & OPS</span>
        <span class="text-slate-300">•</span>
        <span class="text-xs text-slate-600 font-medium">Acompañamiento en vivo</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight max-w-4xl mb-4 leading-[1.15]">
        Tu equipo de Producto tiene suficiente trabajo. 
        <span class="text-teal-700 block mt-1">No debería perder tiempo en procesos que pueden estar mejor diseñados.</span>
      </h1>

      <p class="text-base sm:text-lg text-slate-600 max-w-3xl mb-8 leading-relaxed font-normal">
        Acompaño a profesionales, PMs y líderes de Producto a integrar IA práctica directamente en sus flujos diarios: research, feedback, síntesis de syncs, PRDs y reporting ejecutivo. Sin teoría vacía ni cambiar el stack donde ya operas.
      </p>

      <!-- Fast Action Area -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-12">
        <a 
          href={ctaRevisarProceso}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm sm:text-base px-6 py-3.5 rounded-xl shadow-xs transition-all hover:shadow-md cursor-pointer"
        >
          <span class="material-symbols-outlined text-[20px]">chat</span>
          <span>Revisar mi proceso con Pablo</span>
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>

        <div class="flex items-center gap-2 text-slate-500 text-xs sm:text-sm px-1">
          <span class="material-symbols-outlined text-teal-600 text-[18px]">verified</span>
          <span>Diagnóstico de 20 min en vivo · Sin presentaciones de venta agresivas</span>
        </div>
      </div>

      <!-- Clean Process Ribbon -->
      <div class="w-full bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 flex flex-wrap items-center justify-between gap-3 shadow-2xs">
        <div class="text-xs font-mono font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[16px] text-teal-600">route</span>
          Ruta de intervención:
        </div>

        <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-slate-800">
          <span class="px-2.5 py-1 bg-slate-100 rounded-md font-medium border border-slate-200/60">01 Diagnóstico</span>
          <span class="text-slate-300">→</span>
          <span class="px-2.5 py-1 bg-slate-100 rounded-md font-medium border border-slate-200/60">02 Diseño</span>
          <span class="text-slate-300">→</span>
          <span class="px-2.5 py-1 bg-slate-100 rounded-md font-medium border border-slate-200/60">03 Implementación</span>
          <span class="text-slate-300">→</span>
          <span class="px-2.5 py-1 bg-slate-100 rounded-md font-medium border border-slate-200/60">04 Adopción</span>
          <span class="text-slate-300">→</span>
          <span class="px-2.5 py-1 bg-teal-50 text-teal-800 font-bold rounded-md border border-teal-200">05 Autonomía</span>
        </div>
      </div>

    </section>

    <!-- PROFILES / SEGMENT CARDS -->
    <section id="que-resolvemos" class="w-full max-w-5xl mx-auto px-4 sm:px-6 mb-16">
      <div class="flex items-center gap-2 mb-6">
        <span class="text-xs font-mono font-bold uppercase text-slate-400 tracking-wider">Perfiles y Enfoque</span>
        <div class="h-px bg-slate-200 flex-1"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Option 1: Individual -->
        <a 
          href={ctaProfesional}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white border border-slate-200/90 p-6 sm:p-8 rounded-2xl hover:border-teal-500/50 hover:shadow-md transition-all flex flex-col justify-between cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold uppercase bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md border border-slate-200">Para Profesionales</span>
              <span class="material-symbols-outlined text-slate-400 group-hover:text-teal-600 transition-colors">person</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 group-hover:text-teal-700 transition-colors">
              Quiero optimizar mi propio flujo de trabajo diario
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">
              Pensado para Product Managers, Product Designers, Product Ops y Consultores. Identifica tareas lentas, diseña tus asistentes y crea flujos autónomos sin depender de nadie.
            </p>
          </div>
          <div class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-teal-700 pt-2 border-t border-slate-100">
            <span>Soy profesional independiente o PM</span>
            <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>

        <!-- Option 2: Teams & Leads -->
        <a 
          href={ctaLider}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white border border-slate-200/90 p-6 sm:p-8 rounded-2xl hover:border-teal-500/50 hover:shadow-md transition-all flex flex-col justify-between cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold uppercase bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md border border-slate-200">Para Equipos y Líderes</span>
              <span class="material-symbols-outlined text-slate-400 group-hover:text-teal-600 transition-colors">groups</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 group-hover:text-teal-700 transition-colors">
              Quiero elevar la capacidad operativa de mi equipo
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">
              Para Heads of Product, VPs y líderes de área. Diagnosticamos dónde se fuga tiempo valioso, armamos sistemas estándar y acompañamos a las personas hasta su adopción natural.
            </p>
          </div>
          <div class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-teal-700 pt-2 border-t border-slate-100">
            <span>Lidero un equipo de Producto</span>
            <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>

      </div>
    </section>

    <!-- THE PROBLEM SECTION -->
    <section class="w-full bg-slate-100/80 py-16 border-y border-slate-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs font-mono font-bold uppercase text-amber-700">El Contexto Real</span>
          <span class="text-slate-300">•</span>
          <span class="text-xs text-slate-500 font-medium">Diagnóstico de operaciones</span>
        </div>

        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mb-2">
          El trabajo de Producto no termina en el roadmap.
        </h2>

        <p class="text-sm sm:text-base text-slate-600 max-w-2xl mb-8 leading-relaxed">
          La mayor parte de la fricción cognitiva de un equipo no proviene de pensar la estrategia, sino del volumen excesivo de micro-tareas manuales necesarias para sostenerla.
        </p>

        <!-- Pill Cloud -->
        <div class="flex flex-wrap gap-2.5 mb-8">
          <span class="bg-white border border-slate-200 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-700 shadow-2xs">Entrevistas a usuarios</span>
          <span class="bg-white border border-slate-200 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-700 shadow-2xs">Clasificación de tickets</span>
          <span class="bg-white border border-slate-200 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-700 shadow-2xs">Feedback de ventas y soporte</span>
          <span class="bg-white border border-slate-200 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-700 shadow-2xs">Syncs de alineación</span>
          <span class="bg-white border border-slate-200 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-700 shadow-2xs">Métricas & OKRs dispersos</span>
          <span class="bg-white border border-slate-200 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-700 shadow-2xs">Redacción de PRDs</span>
          <span class="bg-white border border-slate-200 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-700 shadow-2xs">Informes ejecutivos</span>
        </div>

        <!-- Friction Callout -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs max-w-3xl">
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-amber-600 mt-0.5 text-[24px]">format_quote</span>
            <div>
              <p class="text-base font-bold text-slate-900 mb-2">
                El trabajo de alto valor está sepultado bajo acciones mecánicas:
              </p>
              <div class="flex flex-wrap items-center gap-1.5 text-xs font-mono text-slate-500 mb-4">
                <span class="bg-slate-100 px-2 py-0.5 rounded border border-slate-200/60">Leer transcripciones</span>
                <span>·</span>
                <span class="bg-slate-100 px-2 py-0.5 rounded border border-slate-200/60">Buscar en 5 apps</span>
                <span>·</span>
                <span class="bg-slate-100 px-2 py-0.5 rounded border border-slate-200/60">Copiar y pegar</span>
                <span>·</span>
                <span class="bg-slate-100 px-2 py-0.5 rounded border border-slate-200/60">Clasificar</span>
                <span>·</span>
                <span class="bg-slate-100 px-2 py-0.5 rounded border border-slate-200/60">Sintetizar notas</span>
                <span>·</span>
                <span class="bg-slate-100 px-2 py-0.5 rounded border border-slate-200/60">Volver a explicar</span>
              </div>
              <p class="text-xs sm:text-sm text-teal-700 font-bold">
                Ahí es exactamente donde encontramos palanca y diseñamos soluciones con IA.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- SOLUTIONS CATALOGUE / BENTO GRID -->
    <section id="casos-de-uso" class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-16">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-mono font-bold uppercase text-teal-600">Catálogo de Soluciones</span>
            <span class="text-slate-300">•</span>
            <span class="text-xs text-slate-500 font-medium">Arquitectura Entrada → IA → Persona → Salida</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            Procesos clave que transformamos
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 max-w-md">
          Diseñamos sistemas donde la máquina acelera la síntesis y el humano conserva la decisión crítica.
        </p>
      </div>

      <!-- BENTO GRID (6 CASES) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Case 1 -->
        <div class="bg-white border border-slate-200/90 p-5 rounded-2xl shadow-2xs hover:shadow-xs transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-teal-700 bg-teal-50 border border-teal-200 px-2.5 py-0.5 rounded-md">01. Discovery</span>
              <span class="material-symbols-outlined text-[20px] text-slate-400">search</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1">Research → Insights</h3>
            <p class="text-xs text-slate-600 mb-4 leading-relaxed">
              Convierte horas de entrevistas y notas de usuario en matrices de evidencias, citas y patrones accionables.
            </p>
          </div>
          <div class="bg-slate-50 rounded-xl p-3.5 space-y-2 text-xs font-mono border border-slate-100">
            <div class="flex items-start gap-2 text-slate-600">
              <span class="text-slate-400 font-bold">IN:</span>
              <span>Grabaciones + notas brutas</span>
            </div>
            <div class="flex items-start gap-2 text-teal-700">
              <span class="font-bold">IA:</span>
              <span>Categoriza fricciones y agrupa patrones</span>
            </div>
            <div class="flex items-start gap-2 text-slate-800 font-medium">
              <span class="text-slate-400 font-bold">TÚ:</span>
              <span>Valida criterio y prioriza hipótesis</span>
            </div>
            <div class="flex items-start gap-2 text-emerald-700 font-bold pt-1 border-t border-slate-200/60">
              <span>OUT:</span>
              <span>Insights listos para roadmap</span>
            </div>
          </div>
        </div>

        <!-- Case 2 -->
        <div class="bg-white border border-slate-200/90 p-5 rounded-2xl shadow-2xs hover:shadow-xs transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-teal-700 bg-teal-50 border border-teal-200 px-2.5 py-0.5 rounded-md">02. Feedback</span>
              <span class="material-symbols-outlined text-[20px] text-slate-400">chat_bubble_outline</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1">Feedback → Patrones</h3>
            <p class="text-xs text-slate-600 mb-4 leading-relaxed">
              Procesa tickets de soporte, llamadas de ventas y reseñas para detectar qué duele más sin sesgo de recencia.
            </p>
          </div>
          <div class="bg-slate-50 rounded-xl p-3.5 space-y-2 text-xs font-mono border border-slate-100">
            <div class="flex items-start gap-2 text-slate-600">
              <span class="text-slate-400 font-bold">IN:</span>
              <span>Zendesk, Intercom, Gong, Hubspot</span>
            </div>
            <div class="flex items-start gap-2 text-teal-700">
              <span class="font-bold">IA:</span>
              <span>Taggeo semántico y clústeres de dolor</span>
            </div>
            <div class="flex items-start gap-2 text-slate-800 font-medium">
              <span class="text-slate-400 font-bold">TÚ:</span>
              <span>Evalúa impacto en negocio y churn</span>
            </div>
            <div class="flex items-start gap-2 text-emerald-700 font-bold pt-1 border-t border-slate-200/60">
              <span>OUT:</span>
              <span>Matriz priorizada de causas raíz</span>
            </div>
          </div>
        </div>

        <!-- Case 3 -->
        <div class="bg-white border border-slate-200/90 p-5 rounded-2xl shadow-2xs hover:shadow-xs transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-teal-700 bg-teal-50 border border-teal-200 px-2.5 py-0.5 rounded-md">03. Alineación</span>
              <span class="material-symbols-outlined text-[20px] text-slate-400">sync</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1">Reuniones → Acciones</h3>
            <p class="text-xs text-slate-600 mb-4 leading-relaxed">
              Extrae de 60 minutos de sync ejecutiva únicamente acuerdos, riesgos, fechas de entrega y tareas en Jira.
            </p>
          </div>
          <div class="bg-slate-50 rounded-xl p-3.5 space-y-2 text-xs font-mono border border-slate-100">
            <div class="flex items-start gap-2 text-slate-600">
              <span class="text-slate-400 font-bold">IN:</span>
              <span>Transcripción cruda de Meet/Zoom</span>
            </div>
            <div class="flex items-start gap-2 text-teal-700">
              <span class="font-bold">IA:</span>
              <span>Filtra charla casual y redacta acuerdos</span>
            </div>
            <div class="flex items-start gap-2 text-slate-800 font-medium">
              <span class="text-slate-400 font-bold">TÚ:</span>
              <span>Confirma responsables finales</span>
            </div>
            <div class="flex items-start gap-2 text-emerald-700 font-bold pt-1 border-t border-slate-200/60">
              <span>OUT:</span>
              <span>Minuta ejecutiva + tickets creados</span>
            </div>
          </div>
        </div>

        <!-- Case 4 -->
        <div class="bg-white border border-slate-200/90 p-5 rounded-2xl shadow-2xs hover:shadow-xs transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-teal-700 bg-teal-50 border border-teal-200 px-2.5 py-0.5 rounded-md">04. Reporting</span>
              <span class="material-symbols-outlined text-[20px] text-slate-400">bar_chart</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1">Datos → Narrativa</h3>
            <p class="text-xs text-slate-600 mb-4 leading-relaxed">
              Convierte números fríos de sprint y métricas de retención en una historia ejecutiva comprensible para stakeholders.
            </p>
          </div>
          <div class="bg-slate-50 rounded-xl p-3.5 space-y-2 text-xs font-mono border border-slate-100">
            <div class="flex items-start gap-2 text-slate-600">
              <span class="text-slate-400 font-bold">IN:</span>
              <span>Mixpanel, Amplitude, PostHog, CSV</span>
            </div>
            <div class="flex items-start gap-2 text-teal-700">
              <span class="font-bold">IA:</span>
              <span>Detecta variaciones e hila el resumen</span>
            </div>
            <div class="flex items-start gap-2 text-slate-800 font-medium">
              <span class="text-slate-400 font-bold">TÚ:</span>
              <span>Aporta contexto de decisiones estratégicas</span>
            </div>
            <div class="flex items-start gap-2 text-emerald-700 font-bold pt-1 border-t border-slate-200/60">
              <span>OUT:</span>
              <span>Reporte ejecutivo o slide deck listo</span>
            </div>
          </div>
        </div>

        <!-- Case 5 -->
        <div class="bg-white border border-slate-200/90 p-5 rounded-2xl shadow-2xs hover:shadow-xs transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-teal-700 bg-teal-50 border border-teal-200 px-2.5 py-0.5 rounded-md">05. Base de Conocimiento</span>
              <span class="material-symbols-outlined text-[20px] text-slate-400">menu_book</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1">Información → Respuestas</h3>
            <p class="text-xs text-slate-600 mb-4 leading-relaxed">
              Construye un asistente interno con trazabilidad exacta a tus especificaciones, políticas y wikis en Notion/Confluence.
            </p>
          </div>
          <div class="bg-slate-50 rounded-xl p-3.5 space-y-2 text-xs font-mono border border-slate-100">
            <div class="flex items-start gap-2 text-slate-600">
              <span class="text-slate-400 font-bold">IN:</span>
              <span>Docs técnicos, PDFs, guías de estilo</span>
            </div>
            <div class="flex items-start gap-2 text-teal-700">
              <span class="font-bold">IA:</span>
              <span>Cita la fuente y responde sin alucinar</span>
            </div>
            <div class="flex items-start gap-2 text-slate-800 font-medium">
              <span class="text-slate-400 font-bold">TÚ:</span>
              <span>Aplica la respuesta al dilema actual</span>
            </div>
            <div class="flex items-start gap-2 text-emerald-700 font-bold pt-1 border-t border-slate-200/60">
              <span>OUT:</span>
              <span>Respuestas inmediatas sin molestar a otros</span>
            </div>
          </div>
        </div>

        <!-- Case 6 -->
        <div class="bg-white border border-slate-200/90 p-5 rounded-2xl shadow-2xs hover:shadow-xs transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-teal-700 bg-teal-50 border border-teal-200 px-2.5 py-0.5 rounded-md">06. Especificación</span>
              <span class="material-symbols-outlined text-[20px] text-slate-400">description</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1">Documentación → Sistema</h3>
            <p class="text-xs text-slate-600 mb-4 leading-relaxed">
              De notas dispersas de discovery a PRDs estandarizados con criterios de aceptación en Gherkin y edge-cases cubiertos.
            </p>
          </div>
          <div class="bg-slate-50 rounded-xl p-3.5 space-y-2 text-xs font-mono border border-slate-100">
            <div class="flex items-start gap-2 text-slate-600">
              <span class="text-slate-400 font-bold">IN:</span>
              <span>Idea base + restricciones técnicas</span>
            </div>
            <div class="flex items-start gap-2 text-teal-700">
              <span class="font-bold">IA:</span>
              <span>Estructura PRD completo y casos de error</span>
            </div>
            <div class="flex items-start gap-2 text-slate-800 font-medium">
              <span class="text-slate-400 font-bold">TÚ:</span>
              <span>Negocia alcance y viabilidad con ingeniería</span>
            </div>
            <div class="flex items-start gap-2 text-emerald-700 font-bold pt-1 border-t border-slate-200/60">
              <span>OUT:</span>
              <span>Documento listo para refinamiento</span>
            </div>
          </div>
        </div>

      </div>

      <!-- REASSURANCE STRIP -->
      <div class="mt-8 p-4 bg-white border border-slate-200 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-xs">
        <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-600">
          <span class="material-symbols-outlined text-teal-600 text-[20px]">lock_reset</span>
          <span><strong class="text-slate-900">Cero cajas negras:</strong> Cada solución se adapta a tus plantillas y formatos habituales.</span>
        </div>
        <a 
          href={ctaConsultarCaso} 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-xs sm:text-sm font-bold text-teal-700 hover:underline flex items-center gap-1 shrink-0 cursor-pointer"
        >
          <span>¿Tienes un proceso distinto? Consúltamelo por WhatsApp</span> →
        </a>
      </div>

    </section>

    <!-- METHODOLOGY SECTION -->
    <section id="como-trabajamos" class="w-full bg-white py-16 border-y border-slate-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        
        <div class="max-w-2xl mb-12">
          <span class="text-xs font-mono font-bold uppercase text-teal-600">Metodología de Trabajo</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-1 mb-2">
            Acompañamiento en directo hasta la autonomía
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            No entrego un PDF genérico ni configuro un software misterioso para luego desaparecer. Nos conectamos y construimos la solución mientras tú operas tu pantalla.
          </p>
        </div>

        <!-- 4 STEPS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <div class="bg-slate-50 border border-slate-200 p-5 rounded-2xl flex flex-col justify-between">
            <div>
              <span class="text-xs font-mono font-bold text-teal-700 block mb-2">FASE 01</span>
              <h3 class="text-base font-bold text-slate-900 mb-2">Diagnóstico</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Mapeamos el flujo actual del equipo, identificamos dónde se pierde más tiempo y priorizamos el caso de mayor ROI inmediato.
              </p>
            </div>
            <div class="pt-4 text-[11px] font-mono text-slate-400 border-t border-slate-200/60 mt-4">Sesión de 45-60 min</div>
          </div>

          <div class="bg-slate-50 border border-slate-200 p-5 rounded-2xl flex flex-col justify-between">
            <div>
              <span class="text-xs font-mono font-bold text-teal-700 block mb-2">FASE 02</span>
              <h3 class="text-base font-bold text-slate-900 mb-2">Diseño del flujo</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Definimos la arquitectura: qué procesa el modelo, qué criterios valida la persona y cómo se conecta con tu software habitual.
              </p>
            </div>
            <div class="pt-4 text-[11px] font-mono text-slate-400 border-t border-slate-200/60 mt-4">Definición de reglas</div>
          </div>

          <div class="bg-slate-50 border border-slate-200 p-5 rounded-2xl flex flex-col justify-between">
            <div>
              <span class="text-xs font-mono font-bold text-teal-700 block mb-2">FASE 03</span>
              <h3 class="text-base font-bold text-slate-900 mb-2">Construcción en vivo</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Desarrollamos prompts, asistentes y pipelines sobre datos y archivos de tus proyectos reales. Sin ejemplos abstractos de juguete.
              </p>
            </div>
            <div class="pt-4 text-[11px] font-mono text-slate-400 border-t border-slate-200/60 mt-4">Manos en el teclado</div>
          </div>

          <div class="bg-slate-50 border border-slate-200 p-5 rounded-2xl flex flex-col justify-between">
            <div>
              <span class="text-xs font-mono font-bold text-emerald-700 block mb-2">FASE 04</span>
              <h3 class="text-base font-bold text-slate-900 mb-2">Autonomía total</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                El equipo domina la lógica de prompts, aprende a iterar cuando surgen cambios y opera 100% independiente.
              </p>
            </div>
            <div class="pt-4 text-[11px] font-mono text-emerald-700 font-bold border-t border-slate-200/60 mt-4">Sin dependencias</div>
          </div>

        </div>

        <!-- PHILOSOPHY CARD -->
        <div class="mt-8 p-5 bg-slate-100 border border-slate-200 rounded-2xl flex items-center gap-4">
          <span class="material-symbols-outlined text-teal-600 text-[28px] shrink-0">co_present</span>
          <div class="text-xs sm:text-sm text-slate-800 leading-relaxed">
            <strong class="text-slate-900">Enfoque práctico:</strong> «El mejor entrenamiento no es ver a alguien hacer algo en una demo perfecta; es resolver tu problema real mientras tú tomas el control.»
          </div>
        </div>

      </div>
    </section>

    <!-- ABOUT SECTION (PABLO RÍOS) -->
    <section id="sobre-mi" class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-16">
      <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-xs">
        <div class="flex flex-col md:flex-row items-start gap-8">
          
          <!-- AVATAR & META -->
          <div class="flex md:flex-col items-center md:items-start gap-4 shrink-0">
            <img 
              src="/pablo-rios.jpeg" 
              alt="Pablo Ríos — Consultor y Mentor en IA" 
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover shadow-sm border-2 border-teal-500/30"
            />
            <div>
              <span class="text-xs font-mono font-bold uppercase text-slate-400 block">Consultor & Mentor</span>
              <h3 class="text-xl font-bold text-slate-900">Pablo Ríos</h3>
              <span class="text-xs text-slate-500 font-medium">Fundador de LuciRMe AI</span>
            </div>
          </div>

          <!-- BIO & METRICS -->
          <div class="flex-1 space-y-6">
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              Más de 13 años liderando tecnología, ingeniería de software y gestión de producto digital. Desde 2021 ayudo a profesionales y organizaciones a convertir la Inteligencia Artificial en una ventaja operativa tangible, eliminando el ruido y el humo del mercado.
            </p>

            <!-- 4 METRICS -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm text-slate-800">
              <div class="flex items-center gap-2 bg-slate-50 p-3 rounded-xl border border-slate-100">
                <span class="material-symbols-outlined text-teal-600 text-[18px]">history_edu</span>
                <span>+13 años en tecnología y software</span>
              </div>
              <div class="flex items-center gap-2 bg-slate-50 p-3 rounded-xl border border-slate-100">
                <span class="material-symbols-outlined text-teal-600 text-[18px]">psychology</span>
                <span>Especializado en IA aplicada desde 2021</span>
              </div>
              <div class="flex items-center gap-2 bg-slate-50 p-3 rounded-xl border border-slate-100">
                <span class="material-symbols-outlined text-teal-600 text-[18px]">terminal</span>
                <span>Cero jerga técnica innecesaria</span>
              </div>
              <div class="flex items-center gap-2 bg-slate-50 p-3 rounded-xl border border-slate-100">
                <span class="material-symbols-outlined text-teal-600 text-[18px]">support_agent</span>
                <span>Acompañamiento directo en vivo</span>
              </div>
            </div>

            <div class="p-4 bg-teal-50/60 border-l-4 border-teal-600 rounded-r-xl text-xs sm:text-sm text-slate-800 italic">
              «La IA no está para sustituir el criterio del Product Manager; está para quitarle de encima el trabajo mecánico y devolverle el tiempo para pensar estratégicamente.»
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section id="faq" class="w-full max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8 text-left">
        <span class="text-xs font-mono font-bold uppercase text-slate-400">Resolviendo Dudas</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-1">
          Preguntas frecuentes
        </h2>
      </div>

      <div class="space-y-3">
        
        <details class="group bg-white border border-slate-200 rounded-2xl p-5 shadow-2xs transition-all [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-slate-900 select-none">
            <span>¿Necesitamos saber programar o tener conocimientos técnicos de IA?</span>
            <span class="material-symbols-outlined text-slate-400 group-open:rotate-180 transition-transform">expand_more</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
            No. Todos los flujos se diseñan en lenguaje natural y utilizando interfaces accesibles (chat, prompts estructurados o herramientas visuales no-code). Cualquier persona con perfil de diseño, producto u operaciones puede operarlos sin tocar una línea de código.
          </p>
        </details>

        <details class="group bg-white border border-slate-200 rounded-2xl p-5 shadow-2xs transition-all [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-slate-900 select-none">
            <span>¿Esto sustituye nuestras herramientas actuales (Jira, Notion, Figma, Slack)?</span>
            <span class="material-symbols-outlined text-slate-400 group-open:rotate-180 transition-transform">expand_more</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
            En absoluto. El objetivo es acoplar la IA al stack que tu equipo ya utiliza para reducir fricción. No te obligamos a migrar a una plataforma nueva ni a cambiar la forma en que colaboran tus desarrolladores y diseñadores.
          </p>
        </details>

        <details class="group bg-white border border-slate-200 rounded-2xl p-5 shadow-2xs transition-all [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-slate-900 select-none">
            <span>¿Cómo se maneja la privacidad y la seguridad de los datos de la empresa?</span>
            <span class="material-symbols-outlined text-slate-400 group-open:rotate-180 transition-transform">expand_more</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
            Utilizamos entornos corporativos y APIs con acuerdos de no retención de datos, lo que garantiza que la información de tus usuarios, finanzas y estrategia jamás se use para entrenar modelos públicos. Cumplimos con estándares de confidencialidad estrictos.
          </p>
        </details>

        <details class="group bg-white border border-slate-200 rounded-2xl p-5 shadow-2xs transition-all [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-slate-900 select-none">
            <span>¿Cuánto tiempo toma un acompañamiento típico?</span>
            <span class="material-symbols-outlined text-slate-400 group-open:rotate-180 transition-transform">expand_more</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
            Depende del alcance acordado: desde intervenciones rápidas de 1 a 2 semanas para destrabar un cuello de botella puntual (como research o syncs), hasta programas de 4 a 6 semanas para sistematizar toda la operación del equipo de producto.
          </p>
        </details>

        <details class="group bg-white border border-slate-200 rounded-2xl p-5 shadow-2xs transition-all [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-slate-900 select-none">
            <span>¿Cuál es la diferencia respecto a un curso grabado tradicional?</span>
            <span class="material-symbols-outlined text-slate-400 group-open:rotate-180 transition-transform">expand_more</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
            Un curso grabado te muestra teoría en un entorno idealizado que raramente calza con tus datos caóticos. Aquí nos conectamos juntos, abrimos tus archivos reales y resolvemos tus problemas de hoy en tu propia pantalla.
          </p>
        </details>

      </div>
    </section>

    <!-- FINAL CTA CARD -->
    <section class="w-full max-w-5xl mx-auto px-4 sm:px-6 pb-20">
      <div class="bg-white border border-slate-200 rounded-3xl p-8 sm:p-12 shadow-sm text-center flex flex-col items-center">
        
        <div class="w-12 h-12 rounded-2xl bg-teal-50 border border-teal-200 flex items-center justify-center text-teal-700 mb-4">
          <span class="material-symbols-outlined text-[24px]">schedule</span>
        </div>

        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight max-w-xl mb-3">
          ¿Tienes un proceso de Producto que te quita demasiado tiempo?
        </h2>

        <p class="text-xs sm:text-sm text-slate-600 max-w-lg mb-8 leading-relaxed">
          Hablemos 20 minutos por WhatsApp. Lo revisamos juntos sobre tu caso real y evaluamos si tiene sentido trabajarlo. Sin rodeos ni presión comercial.
        </p>

        <a 
          href={ctaFinalWA}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm sm:text-base px-8 py-4 rounded-xl shadow-xs hover:shadow-md transition-all cursor-pointer"
        >
          <span class="material-symbols-outlined text-[20px]">chat</span>
          <span>Hablar por WhatsApp con Pablo</span>
          <span class="material-symbols-outlined text-[18px]">open_in_new</span>
        </a>

        <span class="text-xs font-mono text-slate-400 mt-4">
          Respuesta directa en menos de 24 horas hábiles · Cupos limitados por mes
        </span>

      </div>
    </section>

  </main>

