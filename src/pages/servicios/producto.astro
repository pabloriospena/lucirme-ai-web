---
import Layout from "../../layouts/Layout.astro";
import { LINKS } from "../../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const whatsappPM = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, llegué a la página de Product Management y quiero hablarte sobre un problema que tengo en mi trabajo como PM.")}`;
---

<Layout
  title="Product Management: Research, Discovery e IA aplicada | LuciRMe AI"
  description="Acompañamiento 1-1 para Product Managers que quieren mejorar Research, Discovery, documentación, Jira y sus procesos de trabajo con IA y automatización."
  canonical="https://lucirme.com/servicios/producto"
  hideHeader={true}
  hideFooter={true}
>
  <header class="fixed top-0 left-0 right-0 z-50 bg-[#F8FAFC]/85 backdrop-blur-xl border-b border-[#E2E8F0]">
    <div class="h-16 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <a class="flex items-center gap-3" href="#">
          <img alt="LuciRMe AI" class="h-8 w-auto object-contain" src="/logo-lucirme.png" />
          <span class="text-base font-semibold text-[#0b1c30] tracking-tight">LuciRMe AI</span>
        </a>
        <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full bg-[#F1F1EF] text-[#3d4947] font-mono text-[11px] border border-[#E9E9E7]">PM & Teams</span>
      </div>
      <nav class="hidden md:flex items-center gap-8 h-full">
        <a class="text-sm text-[#3d4947] hover:text-[#0b1c30] transition-colors py-5" href="/empresas">Empresas</a>
        <a class="text-sm text-[#3d4947] hover:text-[#0b1c30] transition-colors py-5" href="/profesionales">Profesionales</a>
        <a class="text-sm text-[#3d4947] hover:text-[#0b1c30] transition-colors py-5" href="/educacion">Educación</a>
        <a class="text-sm text-[#3d4947] hover:text-[#0b1c30] transition-colors py-5" href="/sobre-pablo">Sobre Pablo</a>
      </nav>
      <div class="flex items-center gap-3">
        <a class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-[#059669] text-white text-xs font-medium hover:bg-[#059669]/90 transition-all shadow-2xs" href={whatsappPM} rel="noopener noreferrer" target="_blank" onclick="if(window.posthog) window.posthog.capture('product_whatsapp_click', { cta_location: 'header' });">Hablar con Pablo</a>
        <div class="w-8 h-8 rounded-full bg-[#00685f] flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-white text-[18px]">person</span>
        </div>
      </div>
    </div>
  </header>

  <main class="w-full pt-16 bg-[#F8FAFC] min-h-screen">
    <div class="flex flex-col w-full">
      <!-- SECTION 1: HERO EDITORIAL -->
      <section class="relative w-full overflow-hidden px-6 lg:px-12 py-16 lg:py-24">
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <div class="lg:col-span-7 flex flex-col items-start">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-[#F1F1EF] text-[#3d4947] font-mono text-[11px] tracking-widest uppercase">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00685f]"></span>
              PRODUCT MANAGEMENT
            </div>
            <h1 class="mt-6 font-bold text-3xl sm:text-4xl lg:text-[46px] lg:leading-[54px] text-[#0b1c30] tracking-tight">
              ¿Qué parte de tu trabajo como PM te está quitando más tiempo del que debería?
            </h1>
            <p class="mt-6 text-base lg:text-lg text-[#3d4947] leading-relaxed max-w-2xl">
              Research, entrevistas, discovery, documentación, Jira, análisis, presentaciones… Hay muchas cosas que hacemos porque “tocan”, pero que terminan llevándose horas todas las semanas.
            </p>
            <p class="mt-4 text-sm text-[#0b1c30] leading-relaxed max-w-2xl font-medium">
              Yo trabajo con PMs para revisar cómo están haciendo esas cosas hoy y encontrar una forma más simple de hacerlas.
            </p>
            <div class="mt-8 w-full p-4 rounded-lg bg-[#F1F1EF] border-l-4 border-[#00685f]">
              <p class="text-sm lg:text-base font-semibold text-[#0b1c30]">
                No empezamos por una herramienta. Empezamos por el problema.
              </p>
            </div>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-[#00685f] text-white font-medium text-sm hover:bg-[#005049] transition-all shadow-xs" href="#diagnostico-interactivo" onclick="if(window.posthog) { window.posthog.capture('product_diagnostic_started'); window.posthog.capture('product_cta_click', { cta_location: 'hero', cta_type: 'diagnostico' }); }">
                Quiero revisar mi caso
              </a>
              <a class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-white text-[#0b1c30] font-medium text-sm border border-[#E9E9E7] hover:bg-[#F7F7F5] transition-all shadow-xs" href={whatsappPM} rel="noopener noreferrer" target="_blank" onclick="if(window.posthog) window.posthog.capture('product_whatsapp_click', { cta_location: 'hero' });">
                <span class="material-symbols-outlined text-[18px] text-[#059669]">chat</span>
                Hablar con Pablo
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 relative w-full">
            <div class="relative w-full rounded-xl bg-white p-6 border border-[#E9E9E7] shadow-xs space-y-4">
              <div class="flex items-center justify-between pb-3 border-b border-[#E9E9E7]">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#E2E8F0]"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-[#E2E8F0]"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-[#E2E8F0]"></span>
                </div>
                <span class="font-mono text-[11px] text-[#3d4947]">pm-workflow.sys</span>
              </div>
              <div class="grid grid-cols-2 gap-2 text-left">
                <div class="p-3 rounded-md bg-[#F1F1EF] border border-[#E9E9E7]">
                  <div class="flex items-center justify-between text-[#3d4947] text-[11px] font-mono">
                    <span>01. Discovery</span>
                    <span class="material-symbols-outlined text-[14px]">psychology</span>
                  </div>
                  <p class="mt-1 text-xs font-medium text-[#0b1c30]">Entrevistas & Audio</p>
                  <div class="mt-2 h-1 w-full bg-[#E2E8F0] rounded-full overflow-hidden">
                    <div class="h-full bg-[#6d7a77] w-3/4"></div>
                  </div>
                </div>
                <div class="p-3 rounded-md bg-[#F1F1EF] border border-[#E9E9E7]">
                  <div class="flex items-center justify-between text-[#3d4947] text-[11px] font-mono">
                    <span>02. Jira Admin</span>
                    <span class="material-symbols-outlined text-[14px]">checklist</span>
                  </div>
                  <p class="mt-1 text-xs font-medium text-[#0b1c30]">Specs & Historias</p>
                  <div class="mt-2 h-1 w-full bg-[#E2E8F0] rounded-full overflow-hidden">
                    <div class="h-full bg-[#6d7a77] w-1/2"></div>
                  </div>
                </div>
                <div class="p-3 rounded-md bg-[#F1F1EF] border border-[#E9E9E7]">
                  <div class="flex items-center justify-between text-[#3d4947] text-[11px] font-mono">
                    <span>03. Docs Repartidos</span>
                    <span class="material-symbols-outlined text-[14px]">folder_copy</span>
                  </div>
                  <p class="mt-1 text-xs font-medium text-[#0b1c30]">Notion, Confluence, GDocs</p>
                  <div class="mt-2 h-1 w-full bg-[#E2E8F0] rounded-full overflow-hidden">
                    <div class="h-full bg-[#6d7a77] w-2/3"></div>
                  </div>
                </div>
                <div class="p-3 rounded-md bg-[#F1F1EF] border border-[#E9E9E7]">
                  <div class="flex items-center justify-between text-[#3d4947] text-[11px] font-mono">
                    <span>04. IA & Prompts</span>
                    <span class="material-symbols-outlined text-[14px]">auto_awesome</span>
                  </div>
                  <p class="mt-1 text-xs font-medium text-[#0b1c30]">ChatGPT & NotebookLM</p>
                  <div class="mt-2 h-1 w-full bg-[#E2E8F0] rounded-full overflow-hidden">
                    <div class="h-full bg-[#00685f] w-4/5"></div>
                  </div>
                </div>
              </div>
              <div class="p-5 rounded-lg bg-[#F7F7F5] border border-[#E2E8F0] relative overflow-hidden">
                <div class="flex items-start justify-between">
                  <div>
                    <span class="font-mono text-[11px] text-[#00685f] uppercase tracking-wider font-semibold">Resultado Esperado</span>
                    <h4 class="mt-1 font-semibold text-sm text-[#0b1c30]">Una forma de trabajar mejor</h4>
                  </div>
                  <span class="px-2 py-1 rounded bg-[#059669]/10 text-[#059669] font-mono text-[11px] font-medium">Activo</span>
                </div>
                <div class="mt-4 pt-3 border-t border-[#E9E9E7] grid grid-cols-2 gap-4">
                  <div>
                    <span class="font-mono text-[11px] text-[#3d4947] block">Alivio cognitivo</span>
                    <span class="font-bold text-lg text-[#0b1c30] tracking-tight">Directo</span>
                  </div>
                  <div>
                    <span class="font-mono text-[11px] text-[#3d4947] block">Horas recuperadas</span>
                    <span class="font-bold text-lg text-[#00685f] tracking-tight">4 – 8 h / sem</span>
                  </div>
                </div>
              </div>
              <div class="text-center">
                <span class="font-mono text-[11px] text-[#3d4947]">Conexión directa: Problema real → Automatización sobria</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 2: DIAGNÓSTICO INTERACTIVO -->
      <div id="diagnostico" class="scroll-mt-20"></div>
      <section class="w-full px-6 lg:px-12 py-16 bg-[#F8FAFC] scroll-mt-20" id="diagnostico-interactivo">
        <div class="max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border border-[#E9E9E7] p-8 lg:p-12 shadow-xs">
            <div class="flex items-center justify-between pb-6 border-b border-[#E9E9E7]">
              <div>
                <h2 class="font-bold text-2xl text-[#0b1c30] tracking-tight">
                  Cuéntame qué te está quitando tiempo
                </h2>
                <p class="mt-1 text-xs text-[#3d4947]">
                  No es un test y no hay respuestas correctas. Quiero entender qué estás haciendo hoy, cuánto tiempo te está tomando y qué te gustaría mejorar.
                </p>
              </div>
              <div class="text-right shrink-0 ml-4">
                <span class="font-mono text-sm text-[#00685f] font-semibold" id="step-counter">01 / 05</span>
              </div>
            </div>
            <div class="w-full bg-[#F1F1EF] h-1 mt-4 rounded-full overflow-hidden">
              <div class="h-full bg-[#00685f] transition-all duration-300 ease-out" id="step-progress-bar" style="width: 20%;"></div>
            </div>

            <div class="mt-8 min-h-[290px] flex flex-col justify-between">
              <!-- STEP 1 -->
              <div class="step-view space-y-4" id="step-1">
                <div class="flex items-center justify-between">
                  <span class="font-semibold text-base text-[#0b1c30]">1. ¿Qué tareas te consumen más fricción o tiempo?</span>
                  <span class="font-mono text-[11px] text-[#3d4947]">Puedes elegir varias</span>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 pt-2" id="step1-options">
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Research" type="button">Research</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Discovery" type="button">Discovery</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Entrevistas" type="button">Entrevistas</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Documentación" type="button">Documentación</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Priorización" type="button">Priorización</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Backlog" type="button">Backlog</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Jira" type="button">Jira</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Análisis" type="button">Análisis</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Estrategia" type="button">Estrategia</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Reuniones" type="button">Reuniones</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Presentaciones" type="button">Presentaciones</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Tareas repetitivas" type="button">Tareas repetitivas</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer col-span-2 sm:col-span-2" data-val="Información repartida entre herramientas" type="button">Información repartida entre herramientas</button>
                  <button class="diag-chip px-3.5 py-2.5 text-left rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="No estoy seguro todavía" type="button">No estoy seguro todavía</button>
                </div>
              </div>

              <!-- STEP 2 -->
              <div class="step-view hidden space-y-4" id="step-2">
                <span class="font-semibold text-base text-[#0b1c30]">2. ¿Con qué frecuencia realizas o sufres este trabajo manual?</span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2" id="step2-options">
                  <button class="diag-single-chip p-4 text-left rounded-md border border-[#E9E9E7] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Todos los días" type="button">
                    <span class="font-semibold text-xs text-[#0b1c30] block">A diario</span>
                    <span class="text-[11px] text-[#3d4947]">Es parte ineludible de mi rutina operativa diaria.</span>
                  </button>
                  <button class="diag-single-chip p-4 text-left rounded-md border border-[#E9E9E7] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Varias veces por semana" type="button">
                    <span class="font-semibold text-xs text-[#0b1c30] block">Varias veces por semana</span>
                    <span class="text-[11px] text-[#3d4947]">Sprints, preparación de planning, reuniones de refinamiento.</span>
                  </button>
                  <button class="diag-single-chip p-4 text-left rounded-md border border-[#E9E9E7] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Ciclos periódicos" type="button">
                    <span class="font-semibold text-xs text-[#0b1c30] block">Por ciclos o releases</span>
                    <span class="text-[11px] text-[#3d4947]">Cuando toca sintetizar research grande o armar decks ejecutivos.</span>
                  </button>
                  <button class="diag-single-chip p-4 text-left rounded-md border border-[#E9E9E7] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Constante desorganización" type="button">
                    <span class="font-semibold text-xs text-[#0b1c30] block">Impredecible</span>
                    <span class="text-[11px] text-[#3d4947]">Surge como fricción constante acumulada sin orden.</span>
                  </button>
                </div>
              </div>

              <!-- STEP 3 -->
              <div class="step-view hidden space-y-4" id="step-3">
                <span class="font-semibold text-base text-[#0b1c30]">3. ¿Cuánto tiempo estimas que se te va semanalmente en esto?</span>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2" id="step3-options">
                  <button class="diag-single-chip p-4 text-left rounded-md border border-[#E9E9E7] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="2–4 h / semana" type="button">
                    <span class="font-bold text-lg text-[#00685f] block">2 – 4 h</span>
                    <span class="text-[11px] text-[#3d4947]">Molesto pero manejable.</span>
                  </button>
                  <button class="diag-single-chip p-4 text-left rounded-md border border-[#E9E9E7] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="5–10 h / semana" type="button">
                    <span class="font-bold text-lg text-[#00685f] block">5 – 10 h</span>
                    <span class="text-[11px] text-[#3d4947]">Una jornada laboral entera en tareas mecánicas.</span>
                  </button>
                  <button class="diag-single-chip p-4 text-left rounded-md border border-[#E9E9E7] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="+10 h / semana" type="button">
                    <span class="font-bold text-lg text-[#00685f] block">+10 h</span>
                    <span class="text-[11px] text-[#3d4947]">Carga cognitiva crítica que frena mi impacto.</span>
                  </button>
                </div>
              </div>

              <!-- STEP 4 -->
              <div class="step-view hidden space-y-4" id="step-4">
                <div class="flex items-center justify-between">
                  <span class="font-semibold text-base text-[#0b1c30]">4. ¿Qué herramientas estás usando hoy?</span>
                  <span class="font-mono text-[11px] text-[#3d4947]">Selecciona las que apliquen</span>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-2" id="step4-options">
                  <button class="diag-chip-tools px-3 py-2 text-center rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="ChatGPT" type="button">ChatGPT</button>
                  <button class="diag-chip-tools px-3 py-2 text-center rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Claude" type="button">Claude</button>
                  <button class="diag-chip-tools px-3 py-2 text-center rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="NotebookLM" type="button">NotebookLM</button>
                  <button class="diag-chip-tools px-3 py-2 text-center rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Jira" type="button">Jira</button>
                  <button class="diag-chip-tools px-3 py-2 text-center rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Linear" type="button">Linear</button>
                  <button class="diag-chip-tools px-3 py-2 text-center rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Notion" type="button">Notion</button>
                  <button class="diag-chip-tools px-3 py-2 text-center rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Confluence" type="button">Confluence</button>
                  <button class="diag-chip-tools px-3 py-2 text-center rounded-md border border-[#E9E9E7] text-xs text-[#0b1c30] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Ninguna IA aún" type="button">Ninguna IA</button>
                </div>
              </div>

              <!-- STEP 5 -->
              <div class="step-view hidden space-y-4" id="step-5">
                <span class="font-semibold text-base text-[#0b1c30]">5. ¿Cuál es tu prioridad principal hoy?</span>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2" id="step5-options">
                  <button class="diag-single-chip p-4 text-left rounded-md border border-[#E9E9E7] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Ahorrar tiempo" type="button">
                    <span class="font-semibold text-xs text-[#0b1c30] block">Recuperar horas</span>
                    <span class="text-[11px] text-[#3d4947]">Automatizar o delegar la talacha repetitiva.</span>
                  </button>
                  <button class="diag-single-chip p-4 text-left rounded-md border border-[#E9E9E7] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Mejorar el flujo" type="button">
                    <span class="font-semibold text-xs text-[#0b1c30] block">Mejorar el flujo</span>
                    <span class="text-[11px] text-[#3d4947]">Conectar research con Jira y decisiones sin fricción.</span>
                  </button>
                  <button class="diag-single-chip p-4 text-left rounded-md border border-[#E9E9E7] hover:bg-[#F1F1EF] transition-colors cursor-pointer" data-val="Usar mejor IA" type="button">
                    <span class="font-semibold text-xs text-[#0b1c30] block">Usar mejor IA</span>
                    <span class="text-[11px] text-[#3d4947]">Pasar de prompts aislados a un sistema consistente.</span>
                  </button>
                </div>
              </div>

              <!-- STEP PROCESSING -->
              <div class="step-view hidden flex flex-col items-center justify-center gap-4 py-12 text-center" id="step-processing">
