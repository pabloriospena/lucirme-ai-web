  <!-- SCRIPT DIAGNÓSTICO PM, RECOMENDACIÓN DETERMINÍSTICA Y TRACKING -->
  <script>
    interface ProductDiagData {
      currentStep: number;
      problems: string[];
      frequency: string | null;
      estimatedTime: string | null;
      tools: string[];
      goals: string[];
      name: string;
      email: string;
      whatsapp: string;
      recommendationText?: string;
    }

    const STORAGE_KEY = 'lucirme_product_diagnostic';
    const totalPmSteps = 5;
    let pmStep = 1;

    const pmData: ProductDiagData = {
      currentStep: 1,
      problems: [],
      frequency: null,
      estimatedTime: null,
      tools: [],
      goals: [],
      name: '',
      email: '',
      whatsapp: '',
    };

    try {
      const saved = sessionStorage.getItem(STORAGE_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        if (parsed && typeof parsed === 'object') {
          Object.assign(pmData, parsed);
        }
      }
    } catch (e) {}

    function saveState() {
      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(pmData));
      } catch (e) {}
    }

    function clearState() {
      try {
        sessionStorage.removeItem(STORAGE_KEY);
      } catch (e) {}
    }

    function generateProductRecommendation(data: ProductDiagData): string {
      const probs = data.problems || [];
      const hasResearch = probs.includes('Research');
      const hasDiscovery = probs.includes('Discovery');
      const hasJira = probs.includes('Jira') || probs.includes('Backlog');
      const hasDocs = probs.includes('Documentación');
      const freqStr = data.frequency || 'frecuentemente';
      const timeStr = data.estimatedTime || 'varias horas a la semana';

      if (hasResearch && hasDiscovery && hasDocs) {
        return `Revisaría cómo pasa la información desde Research y Discovery hasta la documentación. Por lo que indicas, la fricción aparece ${freqStr} y consume ${timeStr}. En tu caso, el problema suele estar en la desconexión entre la recolección de contexto y la redacción de PRDs, no en cada tarea por separado. Se puede estructurar un flujo continuo donde la síntesis alimente tus documentos sin reescrituras manuales.`;
      }

      if (hasDiscovery && hasJira) {
        return `Revisaría la relación entre las decisiones tomadas en Discovery y los tickets en Jira o Linear. Si esta tarea consume ${timeStr}, la oportunidad está en automatizar la transferencia de especificaciones y criterios de aceptación desde las notas de entrevistas hacia el backlog del equipo técnico.`;
      }

      if (hasResearch) {
        return `Revisaría tu proceso de búsqueda, recopilación y síntesis de información. Para tareas que ocurren ${freqStr}, estandarizar cómo extraes patrones e insights clave desde notas crudas te permitirá tomar decisiones de producto más rápidas y con menos carga mental.`;
      }

      if (hasDiscovery) {
        return `Revisaría cómo analizas entrevistas y feedback de usuarios. En lugar de procesar cada conversación manualmente, conviene armar una matriz de patrones para conectar problemas directamente con oportunidades claras de producto.`;
      }

      if (hasJira) {
        return `Revisaría la información que copias o actualizas manualmente entre tus documentos y Jira. Mapear este proceso evita errores de traslape y libera tiempo administrativo recurrente en tus refinamientos.`;
      }

      if (hasDocs) {
        return `Revisaría el origen y la estructura de tus documentos y PRDs. Para flujos que se repiten ${freqStr}, conviene definir plantillas contextuales vivas que se completen a partir de las minutas de reuniones y briefs.`;
      }

      return `Revisaría cómo está estructurado tu flujo de trabajo cotidiano como PM. Con un volumen estimado de ${timeStr}, no empezaría buscando otra herramienta de IA, sino identificando los puntos exactos de duplicación manual para simplificar el proceso y ganar autonomía.`;
    }

    function updateWizardUI() {
      const counter = document.getElementById('step-counter');
      const bar = document.getElementById('step-progress-bar');
      const prevBtn = document.getElementById('btn-diag-back') as HTMLButtonElement | null;

      if (counter && bar) {
        if (pmStep <= totalPmSteps) {
          counter.innerText = `0${pmStep} / 0${totalPmSteps}`;
          bar.style.width = `${(pmStep / totalPmSteps) * 100}%`;
        } else if (pmStep >= 7) {
          counter.innerText = `05 / 05`;
          bar.style.width = `100%`;
        }
      }

      if (prevBtn) {
        prevBtn.classList.toggle('hidden', pmStep === 1 || pmStep >= 6);
      }

      syncButtonStates();
    }

    function syncButtonStates() {
      // Step 1
      document.querySelectorAll('#step1-options .diag-chip').forEach(b => {
        const val = b.getAttribute('data-val');
        const selected = val ? pmData.problems.includes(val) : false;
        b.setAttribute('aria-pressed', selected ? 'true' : 'false');
        if (selected) {
          b.classList.add('bg-[#00685f]', 'text-white', 'font-medium');
          b.classList.remove('border-[#E9E9E7]', 'text-[#0b1c30]');
        } else {
          b.classList.remove('bg-[#00685f]', 'text-white', 'font-medium');
          b.classList.add('border-[#E9E9E7]', 'text-[#0b1c30]');
        }
      });

      // Step 2
      document.querySelectorAll('#step2-options .diag-single-chip').forEach(b => {
        const val = b.getAttribute('data-val');
        const selected = pmData.frequency === val;
        b.setAttribute('aria-pressed', selected ? 'true' : 'false');
        if (selected) {
          b.classList.add('border-[#00685f]', 'bg-[#F1F1EF]');
          b.classList.remove('border-[#E9E9E7]');
        } else {
          b.classList.remove('border-[#00685f]', 'bg-[#F1F1EF]');
          b.classList.add('border-[#E9E9E7]');
        }
      });

      // Step 3
      document.querySelectorAll('#step3-options .diag-single-chip').forEach(b => {
        const val = b.getAttribute('data-val');
        const selected = pmData.estimatedTime === val;
        b.setAttribute('aria-pressed', selected ? 'true' : 'false');
        if (selected) {
          b.classList.add('border-[#00685f]', 'bg-[#F1F1EF]');
          b.classList.remove('border-[#E9E9E7]');
        } else {
          b.classList.remove('border-[#00685f]', 'bg-[#F1F1EF]');
          b.classList.add('border-[#E9E9E7]');
        }
      });

      // Step 4
      document.querySelectorAll('#step4-options .diag-chip-tools').forEach(b => {
        const val = b.getAttribute('data-val');
        const selected = val ? pmData.tools.includes(val) : false;
        b.setAttribute('aria-pressed', selected ? 'true' : 'false');
        if (selected) {
          b.classList.add('bg-[#00685f]', 'text-white', 'font-medium');
          b.classList.remove('border-[#E9E9E7]', 'text-[#0b1c30]');
        } else {
          b.classList.remove('bg-[#00685f]', 'text-white', 'font-medium');
          b.classList.add('border-[#E9E9E7]', 'text-[#0b1c30]');
        }
      });

      // Step 5
      document.querySelectorAll('#step5-options .diag-single-chip').forEach(b => {
        const val = b.getAttribute('data-val');
        const selected = val ? pmData.goals.includes(val) : false;
        b.setAttribute('aria-pressed', selected ? 'true' : 'false');
        if (selected) {
          b.classList.add('border-[#00685f]', 'bg-[#F1F1EF]');
          b.classList.remove('border-[#E9E9E7]');
        } else {
          b.classList.remove('border-[#00685f]', 'bg-[#F1F1EF]');
          b.classList.add('border-[#E9E9E7]');
        }
      });
    }

    function pmGoToStep(step: number) {
      document.querySelectorAll('.step-view').forEach(el => el.classList.add('hidden'));

      pmStep = step;
      pmData.currentStep = step;
      saveState();

      if (step <= totalPmSteps) {
        const target = document.getElementById(`step-${step}`);
        if (target) target.classList.remove('hidden');
      } else if (step === 6) {
        const target = document.getElementById('step-processing');
        if (target) target.classList.remove('hidden');
        setTimeout(() => pmGoToStep(7), 500);
      } else if (step === 7) {
        const target = document.getElementById('step-result');
        if (target) target.classList.remove('hidden');

        const recText = generateProductRecommendation(pmData);
        pmData.recommendationText = recText;
        saveState();

        const summaryEl = document.getElementById('res-recomendacion');
        if (summaryEl) summaryEl.innerText = recText;

        const sitEl = document.getElementById('res-situacion');
        if (sitEl) sitEl.innerText = pmData.problems.length > 0 ? pmData.problems.join(' · ') : 'Research · Discovery';

        const tEl = document.getElementById('res-tiempo');
        if (tEl) tEl.innerText = pmData.estimatedTime || '5–10 h / semana';

        const objEl = document.getElementById('res-objetivo');
        if (objEl) objEl.innerText = pmData.goals.length > 0 ? pmData.goals.join(' · ') : 'Ahorrar tiempo';

        if ((window as any).posthog) {
          (window as any).posthog.capture('product_diagnostic_completed', {
            problem_area: pmData.problems,
            frequency: pmData.frequency,
            estimated_time: pmData.estimatedTime,
            current_tools: pmData.tools,
            goal: pmData.goals,
          });
        }
      } else if (step === 8) {
        const target = document.getElementById('step-contact');
        if (target) target.classList.remove('hidden');
      } else if (step === 9) {
        const target = document.getElementById('step-submitting');
        if (target) target.classList.remove('hidden');
      } else if (step === 10) {
        const target = document.getElementById('step-success');
        if (target) target.classList.remove('hidden');
      } else if (step === 11) {
        const target = document.getElementById('step-error');
        if (target) target.classList.remove('hidden');
      }

      updateWizardUI();
    }

    function pmPrevStep() {
      if (pmStep > 1 && pmStep <= totalPmSteps) {
        pmGoToStep(pmStep - 1);
      } else if (pmStep === 8) {
        pmGoToStep(7);
      }
    }

    function pmToggleProblem(val: string) {
      const idx = pmData.problems.indexOf(val);
      if (idx >= 0) pmData.problems.splice(idx, 1);
      else pmData.problems.push(val);
      saveState();
      syncButtonStates();
    }

    function pmSelectFrequency(val: string) {
      pmData.frequency = val;
      saveState();
      syncButtonStates();
      if ((window as any).posthog) {
        (window as any).posthog.capture('product_diagnostic_question_answered', {
          question_number: 2,
          question_type: 'frequency',
        });
      }
    }

    function pmSelectEstimatedTime(val: string) {
      pmData.estimatedTime = val;
      saveState();
      syncButtonStates();
      if ((window as any).posthog) {
        (window as any).posthog.capture('product_diagnostic_question_answered', {
          question_number: 3,
          question_type: 'estimatedTime',
        });
      }
    }

    function pmToggleTool(val: string) {
      const idx = pmData.tools.indexOf(val);
      if (idx >= 0) pmData.tools.splice(idx, 1);
      else pmData.tools.push(val);
      saveState();
      syncButtonStates();
    }

    function pmToggleGoal(val: string) {
      const idx = pmData.goals.indexOf(val);
      if (idx >= 0) pmData.goals.splice(idx, 1);
      else pmData.goals.push(val);
      saveState();
      syncButtonStates();
    }

    async function pmSubmitLead() {
      const nomInput = document.getElementById('pm-input-nombre') as HTMLInputElement | null;
      const emInput = document.getElementById('pm-input-email') as HTMLInputElement | null;
      const waInput = document.getElementById('pm-input-whatsapp') as HTMLInputElement | null;
      const submitBtn = document.getElementById('pm-btn-submit') as HTMLButtonElement | null;

      const nom = nomInput?.value.trim() || '';
      const em = emInput?.value.trim() || '';
      const wa = waInput?.value.trim() || '';

      if (!nom) {
        alert('Por favor ingresa tu nombre.');
        return;
      }

      if (!em || !em.includes('@')) {
        alert('Por favor ingresa un correo electrónico válido.');
        return;
      }

      if (!wa) {
        alert('Por favor ingresa tu número de WhatsApp.');
        return;
      }

      pmData.name = nom;
      pmData.email = em;
      pmData.whatsapp = wa;
      saveState();

      if (submitBtn) submitBtn.disabled = true;

      pmGoToStep(9); // Submitting

      try {
        const finalRecText = pmData.recommendationText || generateProductRecommendation(pmData);

        const res = await fetch('/api/professional-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: pmData.name,
            email: pmData.email,
            whatsapp: pmData.whatsapp,
            problema_principal: pmData.problems.length > 0 ? pmData.problems : ['Product Management'],
            frecuencia: pmData.frequency || 'Semanal',
            tiempo_estimado: pmData.estimatedTime || '3–5 horas',
            herramientas_actuales: pmData.tools,
            objetivo: pmData.goals.length > 0 ? pmData.goals : ['Ahorrar tiempo'],
            recomendacion: finalRecText,
            fuente: 'Landing /servicios/producto',
            tipo_de_pagina: 'producto',
          }),
        });

        const result = await res.json().catch(() => ({}));

        if (res.ok && result.success) {
          if ((window as any).posthog) {
            (window as any).posthog.capture('product_lead_submitted', {
              problem_area: pmData.problems,
              frequency: pmData.frequency,
              estimated_time: pmData.estimatedTime,
              current_tools: pmData.tools,
              goal: pmData.goals,
            });
          }

          const successWaBtn = document.getElementById('pm-success-wa-btn') as HTMLAnchorElement | null;
          if (successWaBtn) {
            const waMsg = encodeURIComponent(
              `Hola Pablo, hice el diagnóstico de Product Management en LuciRMe y quiero hablarte sobre mi caso.`
            );
            successWaBtn.href = `https://wa.me/573053046180?text=${waMsg}`;
          }

          clearState();
          pmGoToStep(10); // Success
        } else {
          pmGoToStep(11); // Error
        }
      } catch (err) {
        pmGoToStep(11); // Error
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Step 1
      document.querySelectorAll('#step1-options .diag-chip').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-val');
          if (val) pmToggleProblem(val);
        });
      });

      // Step 2
      document.querySelectorAll('#step2-options .diag-single-chip').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-val');
          if (val) pmSelectFrequency(val);
        });
      });

      // Step 3
      document.querySelectorAll('#step3-options .diag-single-chip').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-val');
          if (val) pmSelectEstimatedTime(val);
        });
      });

      // Step 4
      document.querySelectorAll('#step4-options .diag-chip-tools').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-val');
          if (val) pmToggleTool(val);
        });
      });

      // Step 5
      document.querySelectorAll('#step5-options .diag-single-chip').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-val');
          if (val) pmToggleGoal(val);
        });
      });

      // Navigation buttons
      const btnNext = document.getElementById('btn-diag-next');
      if (btnNext) {
        btnNext.addEventListener('click', () => {
          if (pmStep <= totalPmSteps) {
            pmGoToStep(pmStep + 1);
          }
        });
      }

      const btnBack = document.getElementById('btn-diag-back');
      if (btnBack) {
        btnBack.addEventListener('click', pmPrevStep);
      }

      if (pmData.currentStep && pmData.currentStep > 1 && pmData.currentStep <= totalPmSteps) {
        pmStep = pmData.currentStep;
      }

      updateWizardUI();

      if ((window as any).posthog) {
        (window as any).posthog.capture('product_page_view', {
          url: window.location.href,
        });
      }
    });

    (window as any).pmGoToStep = pmGoToStep;
    (window as any).pmSubmitLead = pmSubmitLead;
  </script>
</Layout>
