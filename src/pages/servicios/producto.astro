---
import Layout from "../../layouts/Layout.astro";
import { LINKS } from "../../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const ctaGeneral = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, estuve viendo la landing de IA para Producto y quiero agendar una conversación.")}`;
const ctaRevisarProceso = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, quiero revisar mi proceso de Producto con IA.")}`;
const ctaProfesional = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, soy profesional de producto y quiero mejorar mi forma de trabajar con IA.")}`;
const ctaLider = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, soy líder / head de producto y quiero incorporar IA en mi equipo.")}`;
const ctaCardProcess = (nombre: string) => `${whatsappBase}?text=${encodeURIComponent(`Hola Pablo, quiero transformar el proceso de ${nombre} en mi equipo de Producto.`)}`;
---

<Layout 
  title="IA para Producto | LuciRMe AI — Acompañamiento e Implementación"
  description="Ayudamos a profesionales y equipos de Producto a incorporar IA en procesos reales: research, feedback, documentación, análisis, reporting, reuniones y presentaciones."
>

  <!-- NAVEGACIÓN STICKY HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
      <!-- LOGO -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="font-extrabold text-xl tracking-tight text-deep group-hover:text-teal transition-colors">
          lucirme<span class="text-teal">.com</span>
        </span>
        <span class="hidden sm:inline-block text-[10px] uppercase font-bold tracking-widest bg-teal/10 text-teal px-2 py-0.5 rounded-full border border-teal/20">
          Producto
        </span>
      </a>

      <!-- NAVEGACIÓN DESKTOP -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-600">
        <a href="#que-hacemos" class="hover:text-teal transition-colors">Qué hacemos</a>
        <a href="#para-quien" class="hover:text-teal transition-colors">Para quién</a>
        <a href="#como-trabajamos" class="hover:text-teal transition-colors">Cómo trabajamos</a>
        <a href="#sobre-mi" class="hover:text-teal transition-colors">Sobre mí</a>
      </nav>

      <!-- CTA CABECERA -->
      <div class="flex items-center gap-3">
        <a 
          href={ctaGeneral} 
          target="_blank" 
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center justify-center gap-2 bg-teal text-white font-bold text-xs md:text-sm px-4 py-2.5 rounded-xl hover:bg-teal/90 transition shadow-xs hover:shadow-md"
        >
          <span>💬</span>
          <span>Agendar conversación</span>
        </a>

        <!-- HAMBURGER BUTTON (MOBILE) -->
        <button 
          id="product-mobile-menu-btn"
          aria-label="Toggle Navigation Menu"
          class="md:hidden p-2 rounded-lg border border-gray-200 text-gray-700 hover:bg-gray-100 transition"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- MENÚ DESPLEGABLE MOBILE -->
    <div id="product-mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white px-4 py-4 space-y-3 shadow-lg">
      <a href="#que-hacemos" class="block py-2 text-sm font-semibold text-gray-700 hover:text-teal">Qué hacemos</a>
      <a href="#para-quien" class="block py-2 text-sm font-semibold text-gray-700 hover:text-teal">Para quién</a>
      <a href="#como-trabajamos" class="block py-2 text-sm font-semibold text-gray-700 hover:text-teal">Cómo trabajamos</a>
      <a href="#sobre-mi" class="block py-2 text-sm font-semibold text-gray-700 hover:text-teal">Sobre mí</a>
      <a 
        href={ctaGeneral} 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 bg-teal text-white font-bold text-sm py-3 rounded-xl hover:bg-teal/90 transition w-full mt-2"
      >
        <span>💬</span>
        <span>Agendar conversación</span>
      </a>
    </div>
  </header>

  <main class="overflow-x-hidden">

    <!-- HERO SECTION -->
    <section class="relative bg-gradient-to-b from-[#0F172A] via-[#131F37] to-[#0F172A] text-white py-16 sm:py-24 px-4 sm:px-6 overflow-hidden">
      <!-- Decoración de fondo -->
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#0D9488_1px,transparent_1px)] [background-size:20px_20px] pointer-events-none"></div>
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-full max-w-4xl h-96 bg-teal/15 blur-3xl pointer-events-none rounded-full"></div>

      <div class="max-w-4xl mx-auto text-center relative z-10 space-y-8">
        
        <!-- ETIQUETA PEQUEÑA -->
        <div class="inline-flex items-center gap-2 bg-teal/15 text-teal text-xs font-extrabold uppercase tracking-widest px-4 py-1.5 rounded-full border border-teal/30 backdrop-blur-xs">
          <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span>
          IA PARA PRODUCTO
        </div>

        <!-- H1 HEADLINE -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black leading-tight sm:leading-tight text-white tracking-tight">
          Tu equipo de Producto tiene suficiente trabajo.<br class="hidden sm:block"/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal via-teal-300 to-amber-300">
            No debería perder tiempo en trabajo que puede estar mejor diseñado.
          </span>
        </h1>

        <!-- SUBTÍTULO -->
        <p class="text-base sm:text-lg md:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed font-medium">
          Ayudo a profesionales y equipos de Producto a incorporar IA en procesos reales: 
          <strong class="text-white font-semibold">research, feedback, documentación, análisis, reporting, reuniones y presentaciones.</strong>
        </p>

        <!-- CTA PRINCIPAL -->
        <div class="pt-2 flex flex-col items-center gap-3">
          <a 
            href={ctaRevisarProceso}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-orange text-white text-base sm:text-lg font-black px-8 py-4 rounded-2xl hover:bg-orange/90 transition transform hover:-translate-y-0.5 shadow-xl hover:shadow-orange/20 w-full sm:w-auto"
          >
            <span>⚡</span>
            <span>Quiero revisar mi proceso</span>
            <span>→</span>
          </a>

          <!-- MICROSEÑAL DEBAJO DEL CTA -->
          <p class="text-xs sm:text-sm text-gray-400 max-w-md mx-auto leading-normal">
            No necesitas saber qué herramienta usar.<br/>
            <strong class="text-gray-200 font-semibold">Llegas con el problema. Lo revisamos juntos.</strong>
          </p>
        </div>

        <!-- TEXTO SECUNDARIO / PROCESO FLUIDO -->
        <div class="pt-6 border-t border-slate-800/80 max-w-3xl mx-auto">
          <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-xs sm:text-sm font-semibold text-gray-400">
            <span class="text-teal font-bold">Diagnóstico</span>
            <span>→</span>
            <span class="text-teal font-bold">Diseño</span>
            <span>→</span>
            <span class="text-teal font-bold">Implementación</span>
            <span>→</span>
            <span class="text-teal font-bold">Capacitación</span>
            <span>→</span>
            <span class="text-teal font-bold">Adopción</span>
            <span>→</span>
            <span class="text-amber-400 font-bold">Autonomía</span>
          </div>
        </div>

      </div>
    </section>

    <!-- BLOQUE DE ELECCIÓN (PARA QUIÉN) -->
    <section id="para-quien" class="py-16 sm:py-24 px-4 sm:px-6 bg-white border-b border-gray-100">
      <div class="max-w-5xl mx-auto space-y-12">
        
        <div class="text-center space-y-3">
          <span class="text-xs font-bold uppercase tracking-widest text-teal">PERFILES</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-deep">¿Qué estás buscando?</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6 sm:gap-8">
          
          <!-- CARD 1: PROFESIONALES -->
          <a 
            href={ctaProfesional}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex flex-col justify-between bg-[#F8FAFC] border-2 border-gray-200 hover:border-teal rounded-3xl p-6 sm:p-8 transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
          >
            <div class="space-y-4">
              <div class="w-14 h-14 bg-teal/10 rounded-2xl flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
                👤
              </div>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-teal">Para profesionales</span>
                <h3 class="text-2xl font-bold text-deep group-hover:text-teal transition-colors mt-1">
                  Quiero mejorar mi forma de trabajar
                </h3>
              </div>
              <p class="text-xs font-semibold text-gray-500 bg-white px-3 py-1.5 rounded-lg border border-gray-200 inline-block">
                PMs, Product Designers, Product Ops, consultores y profesionales de Producto.
              </p>
              <p class="text-sm text-gray-600 leading-relaxed pt-2">
                Aprende a identificar oportunidades, construir tus propios flujos y trabajar con IA de forma autónoma.
              </p>
            </div>

            <div class="pt-8 mt-6 border-t border-gray-200/80 flex items-center justify-between text-teal font-bold text-sm group-hover:gap-2 transition-all">
              <span>Soy profesional</span>
              <span class="text-lg group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>

          <!-- CARD 2: LÍDERES / EQUIPOS -->
          <a 
            href={ctaLider}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex flex-col justify-between bg-[#F8FAFC] border-2 border-gray-200 hover:border-orange/80 rounded-3xl p-6 sm:p-8 transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
          >
            <div class="space-y-4">
              <div class="w-14 h-14 bg-orange/10 rounded-2xl flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
                👥
              </div>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-orange">Para equipos</span>
                <h3 class="text-2xl font-bold text-deep group-hover:text-orange transition-colors mt-1">
                  Quiero mejorar la forma de trabajar de mi equipo
                </h3>
              </div>
              <p class="text-xs font-semibold text-gray-500 bg-white px-3 py-1.5 rounded-lg border border-gray-200 inline-block">
                Heads of Product, líderes y equipos de Producto.
              </p>
              <p class="text-sm text-gray-600 leading-relaxed pt-2">
                Diseñamos e implementamos flujos de IA sobre procesos reales del equipo y acompañamos su adopción.
              </p>
            </div>

            <div class="pt-8 mt-6 border-t border-gray-200/80 flex items-center justify-between text-orange font-bold text-sm group-hover:gap-2 transition-all">
              <span>Soy líder / equipo</span>
              <span class="text-lg group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>

        </div>

      </div>
    </section>

    <!-- BLOQUE PROBLEMA -->
    <section class="py-16 sm:py-24 px-4 sm:px-6 bg-[#F8FAFC] border-b border-gray-200">
      <div class="max-w-4xl mx-auto space-y-10 text-center">
        
        <div class="space-y-3">
          <span class="text-xs font-bold uppercase tracking-widest text-red-600 bg-red-50 border border-red-200 px-3 py-1 rounded-full">
            EL PROBLEMA
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-deep">
            El trabajo de Producto no termina en el roadmap.
          </h2>
        </div>

        <!-- GRID DE TAREAS PERDIDAS -->
        <div class="flex flex-wrap justify-center gap-2.5 sm:gap-3 max-w-3xl mx-auto">
          {['Entrevistas', 'Tickets', 'Feedback', 'Reuniones', 'Métricas', 'Documentación', 'Reportes', 'Presentaciones', 'Investigación'].map((task) => (
            <span class="bg-white border border-gray-300 text-gray-700 font-semibold text-xs sm:text-sm px-4 py-2 rounded-xl shadow-2xs hover:border-teal transition-colors">
              {task}
            </span>
          ))}
        </div>

        <!-- DEBAJO -->
        <div class="bg-white border border-gray-200 rounded-3xl p-6 sm:p-10 shadow-sm space-y-6 max-w-3xl mx-auto text-left sm:text-center">
          <h3 class="text-xl sm:text-2xl font-bold text-deep leading-snug">
            El trabajo importante muchas veces está rodeado de trabajo manual.
          </h3>

          <!-- ACCIONES MANUALES -->
          <div class="flex flex-wrap justify-center gap-2 text-xs sm:text-sm text-gray-600 font-mono">
            <span class="bg-gray-100 px-2.5 py-1 rounded">Leer.</span>
            <span class="bg-gray-100 px-2.5 py-1 rounded">Buscar.</span>
            <span class="bg-gray-100 px-2.5 py-1 rounded">Copiar.</span>
            <span class="bg-gray-100 px-2.5 py-1 rounded">Clasificar.</span>
            <span class="bg-gray-100 px-2.5 py-1 rounded">Comparar.</span>
            <span class="bg-gray-100 px-2.5 py-1 rounded">Resumir.</span>
            <span class="bg-gray-100 px-2.5 py-1 rounded">Actualizar.</span>
            <span class="bg-gray-100 px-2.5 py-1 rounded">Volver a explicar.</span>
          </div>

          <div class="pt-4 border-t border-gray-100">
            <p class="text-lg sm:text-xl font-extrabold text-teal">
              Ahí es donde buscamos oportunidades.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- BLOQUE DE OPORTUNIDADES (QUÉ PODEMOS HACER) -->
    <section id="que-hacemos" class="py-16 sm:py-24 px-4 sm:px-6 bg-white border-b border-gray-200">
      <div class="max-w-5xl mx-auto space-y-12">
        
        <div class="text-center space-y-3">
          <span class="text-xs font-bold uppercase tracking-widest text-teal">QUÉ PODEMOS HACER</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-deep">
            Algunos procesos que podemos transformar
          </h2>
          <p class="text-sm text-gray-500 max-w-xl mx-auto">
            Haz clic en cualquier proceso para desplegar el flujo exacto (Entrada → IA → Persona → Salida).
          </p>
        </div>

        <!-- GRID DE 7 CARDS EXPANDIBLES -->
        <div class="grid md:grid-cols-2 gap-4 sm:gap-6">
          
          <!-- CARD 1 -->
          <div class="product-card border border-gray-200 rounded-2xl bg-[#F8FAFC] overflow-hidden transition-all duration-200 hover:border-teal">
            <button class="product-card-header w-full text-left p-5 flex items-start justify-between gap-4 cursor-pointer focus:outline-none">
              <div class="flex items-start gap-3.5">
                <span class="text-2xl p-2 bg-white rounded-xl border border-gray-200 shadow-2xs">🔍</span>
                <div>
                  <h3 class="text-lg font-bold text-deep">Research → Insights</h3>
                  <p class="text-xs text-gray-600 mt-1">
                    Entrevistas, transcripciones y notas → <strong class="text-deep">temas + patrones + evidencias + insights</strong>
                  </p>
                </div>
              </div>
              <span class="card-chevron text-gray-400 font-bold text-lg transition-transform duration-200 mt-1">↓</span>
            </button>
            <div class="card-content hidden border-t border-gray-200 bg-white p-5 space-y-4 text-xs sm:text-sm">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="bg-gray-50 p-3 rounded-xl border border-gray-100">
                  <span class="text-[10px] font-bold text-gray-400 uppercase block mb-1">📥 Entrada</span>
                  <p class="text-gray-700 font-medium">Entrevistas + transcripciones</p>
                </div>
                <div class="bg-teal/5 p-3 rounded-xl border border-teal/20">
                  <span class="text-[10px] font-bold text-teal uppercase block mb-1">🤖 IA</span>
                  <p class="text-teal-900 font-medium">Agrupa temas, encuentra patrones y extrae evidencias</p>
                </div>
                <div class="bg-amber-50 p-3 rounded-xl border border-amber-200">
                  <span class="text-[10px] font-bold text-amber-600 uppercase block mb-1">👤 Persona</span>
                  <p class="text-amber-900 font-medium">Valida e interpreta</p>
                </div>
                <div class="bg-emerald-50 p-3 rounded-xl border border-emerald-200">
                  <span class="text-[10px] font-bold text-emerald-600 uppercase block mb-1">🎯 Salida</span>
                  <p class="text-emerald-900 font-bold">Insights estructurados</p>
                </div>
              </div>
              <a href={ctaCardProcess("Research a Insights")} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-teal hover:underline pt-1">
                <span>Quiero implementar este flujo en mi equipo</span> →
              </a>
            </div>
          </div>

          <!-- CARD 2 -->
          <div class="product-card border border-gray-200 rounded-2xl bg-[#F8FAFC] overflow-hidden transition-all duration-200 hover:border-teal">
            <button class="product-card-header w-full text-left p-5 flex items-start justify-between gap-4 cursor-pointer focus:outline-none">
              <div class="flex items-start gap-3.5">
                <span class="text-2xl p-2 bg-white rounded-xl border border-gray-200 shadow-2xs">💬</span>
                <div>
                  <h3 class="text-lg font-bold text-deep">Feedback → Patrones</h3>
                  <p class="text-xs text-gray-600 mt-1">
                    Tickets, soporte, ventas y conversaciones → <strong class="text-deep">clasificación + tendencias + problemas</strong>
                  </p>
                </div>
              </div>
              <span class="card-chevron text-gray-400 font-bold text-lg transition-transform duration-200 mt-1">↓</span>
            </button>
            <div class="card-content hidden border-t border-gray-200 bg-white p-5 space-y-4 text-xs sm:text-sm">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="bg-gray-50 p-3 rounded-xl border border-gray-100">
                  <span class="text-[10px] font-bold text-gray-400 uppercase block mb-1">📥 Entrada</span>
                  <p class="text-gray-700 font-medium">Tickets + feedback de soporte y ventas</p>
                </div>
                <div class="bg-teal/5 p-3 rounded-xl border border-teal/20">
                  <span class="text-[10px] font-bold text-teal uppercase block mb-1">🤖 IA</span>
                  <p class="text-teal-900 font-medium">Clasifica por temas, identifica severidad y tendencias</p>
                </div>
                <div class="bg-amber-50 p-3 rounded-xl border border-amber-200">
                  <span class="text-[10px] font-bold text-amber-600 uppercase block mb-1">👤 Persona</span>
                  <p class="text-amber-900 font-medium">Prioriza y decide accionables</p>
                </div>
                <div class="bg-emerald-50 p-3 rounded-xl border border-emerald-200">
                  <span class="text-[10px] font-bold text-emerald-600 uppercase block mb-1">🎯 Salida</span>
                  <p class="text-emerald-900 font-bold">Matriz de problemas recurrentes</p>
                </div>
              </div>
              <a href={ctaCardProcess("Feedback a Patrones")} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-teal hover:underline pt-1">
                <span>Quiero implementar este flujo en mi equipo</span> →
              </a>
            </div>
          </div>

          <!-- CARD 3 -->
          <div class="product-card border border-gray-200 rounded-2xl bg-[#F8FAFC] overflow-hidden transition-all duration-200 hover:border-teal">
            <button class="product-card-header w-full text-left p-5 flex items-start justify-between gap-4 cursor-pointer focus:outline-none">
              <div class="flex items-start gap-3.5">
                <span class="text-2xl p-2 bg-white rounded-xl border border-gray-200 shadow-2xs">🎙️</span>
                <div>
                  <h3 class="text-lg font-bold text-deep">Reuniones → Acciones</h3>
                  <p class="text-xs text-gray-600 mt-1">
                    Transcripción → <strong class="text-deep">decisiones + tareas + documentación</strong>
                  </p>
                </div>
              </div>
              <span class="card-chevron text-gray-400 font-bold text-lg transition-transform duration-200 mt-1">↓</span>
            </button>
            <div class="card-content hidden border-t border-gray-200 bg-white p-5 space-y-4 text-xs sm:text-sm">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="bg-gray-50 p-3 rounded-xl border border-gray-100">
                  <span class="text-[10px] font-bold text-gray-400 uppercase block mb-1">📥 Entrada</span>
                  <p class="text-gray-700 font-medium">Transcripciones de Syncs / 1:1 / Discovery</p>
                </div>
                <div class="bg-teal/5 p-3 rounded-xl border border-teal/20">
                  <span class="text-[10px] font-bold text-teal uppercase block mb-1">🤖 IA</span>
                  <p class="text-teal-900 font-medium">Extrae acuerdos, compromisos y redacta minuta</p>
                </div>
                <div class="bg-amber-50 p-3 rounded-xl border border-amber-200">
                  <span class="text-[10px] font-bold text-amber-600 uppercase block mb-1">👤 Persona</span>
                  <p class="text-amber-900 font-medium">Confirma responsables y fechas</p>
                </div>
                <div class="bg-emerald-50 p-3 rounded-xl border border-emerald-200">
                  <span class="text-[10px] font-bold text-emerald-600 uppercase block mb-1">🎯 Salida</span>
                  <p class="text-emerald-900 font-bold">Minuta ejecutiva y tareas asignadas</p>
                </div>
              </div>
              <a href={ctaCardProcess("Reuniones a Acciones")} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-teal hover:underline pt-1">
                <span>Quiero implementar este flujo en mi equipo</span> →
              </a>
            </div>
          </div>

          <!-- CARD 4 -->
          <div class="product-card border border-gray-200 rounded-2xl bg-[#F8FAFC] overflow-hidden transition-all duration-200 hover:border-teal">
            <button class="product-card-header w-full text-left p-5 flex items-start justify-between gap-4 cursor-pointer focus:outline-none">
              <div class="flex items-start gap-3.5">
                <span class="text-2xl p-2 bg-white rounded-xl border border-gray-200 shadow-2xs">📊</span>
                <div>
                  <h3 class="text-lg font-bold text-deep">Datos → Reportes</h3>
                  <p class="text-xs text-gray-600 mt-1">
                    Métricas + contexto → <strong class="text-deep">análisis + narrativa + presentación</strong>
                  </p>
                </div>
              </div>
