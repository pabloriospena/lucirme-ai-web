---
import Layout from "../../layouts/Layout.astro";
import { LINKS } from "../../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const whatsappPM = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, estuve viendo la landing de Product Management y quiero revisar mi caso.")}`;
---

<Layout
  title="Product Management e IA Aplicada | LuciRMe AI"
  description="Acompañamiento 1-1 para Product Managers y profesionales de producto que quieren mejorar sus procesos, aplicar IA y trabajar de forma más simple."
  canonical="https://lucirme.com/servicios/producto"
  hideHeader={true}
  hideFooter={true}
>
  <!-- HEADER DEDICADO PRODUCT MANAGEMENT -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="h-16 max-w-7xl mx-auto px-6 flex items-center justify-between gap-4">
      <a class="flex flex-col group" href="#">
        <span class="text-base font-bold tracking-tight text-slate-900 group-hover:text-teal-700 transition-colors">LuciRMe AI · Product Management</span>
        <span class="text-[11px] font-mono text-slate-500">Product Management aplicado a problemas reales.</span>
      </a>

      <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-slate-600">
        <a class="hover:text-slate-900 transition-colors" href="#diagnostico-pm">Diagnóstico</a>
        <a class="hover:text-slate-900 transition-colors" href="#en-que-trabajamos">¿En qué trabajamos?</a>
        <a class="hover:text-slate-900 transition-colors" href="#como-trabajamos">Cómo trabajamos</a>
        <a class="hover:text-slate-900 transition-colors" href="#pm-ia">PM + IA</a>
        <a class="hover:text-slate-900 transition-colors" href="#pm-sin-bullshit">PM Sin Bullshit</a>
        <a class="hover:text-slate-900 transition-colors" href="#pablo">Pablo</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-teal-700 text-white text-xs font-semibold hover:bg-teal-800 transition-colors shadow-2xs cursor-pointer"
          href="#diagnostico-pm"
        >
          <span class="material-symbols-outlined text-[17px]">inventory_2</span>
          <span>Quiero revisar mi caso</span>
        </a>
      </div>
    </div>
  </header>

  <main class="w-full bg-[#F8FAFC]">

    <!-- HERO SECTION -->
    <section class="w-full max-w-7xl mx-auto px-6 pt-12 pb-12 md:py-20 border-b border-slate-200/60">
      <div class="max-w-3xl mx-auto flex flex-col items-center text-center gap-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-slate-100 border border-slate-200/80 rounded-full font-mono text-xs text-teal-800 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"></span>
          PRODUCT MANAGEMENT
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
          ¿Hay algo de tu trabajo como PM que sientes que podría hacerse mucho mejor?
        </h1>

        <p class="text-base md:text-lg text-slate-600 font-normal leading-relaxed">
          Research, discovery, documentación, priorización, estrategia, análisis, reuniones, presentaciones… podemos revisar cómo lo estás haciendo hoy y encontrar dónde tiene sentido simplificar, mejorar o aplicar IA.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2 w-full sm:w-auto">
          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer"
            href="#diagnostico-pm"
            onclick="if(window.posthog) window.posthog.capture('product_diagnostic_started');"
          >
            <span>Quiero revisar mi caso →</span>
          </a>

          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white border border-slate-200 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition-colors shadow-2xs"
            href={whatsappPM}
            rel="noopener noreferrer"
            target="_blank"
            onclick="if(window.posthog) window.posthog.capture('product_whatsapp_click', { origen: 'hero' });"
          >
            <span class="material-symbols-outlined text-[18px]">chat</span>
            <span>Hablar con Pablo</span>
          </a>
        </div>

        <div class="p-3 bg-white border border-slate-200 rounded-xl text-xs text-slate-600 font-medium mt-2 max-w-xl">
          💡 <strong>Filosofía de trabajo:</strong> Primero entendemos el problema. Después vemos qué herramienta, método o solución tiene sentido.
        </div>

      </div>
    </section>

    <!-- COMPONENTE DIAGNÓSTICO INTERACTIVO PARA PMs -->
    <section class="w-full max-w-7xl mx-auto px-6 py-12 scroll-mt-20" id="diagnostico-pm">
      <div class="max-w-2xl mx-auto flex flex-col gap-6">

        <div class="bg-white rounded-2xl border border-slate-200 shadow-md p-6 md:p-8 relative min-h-[400px] flex flex-col justify-between" id="pm-wizard-card">
          
          <!-- Wizard Header -->
          <div class="flex flex-col gap-2 pb-4 border-b border-slate-100" id="pm-wizard-header">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="font-mono text-xs font-semibold text-slate-900 uppercase" id="pm-step-counter">Paso 1 de 5</span>
              </div>
              <span class="text-xs font-mono text-slate-400" id="pm-step-time">~2 min</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
              <div class="bg-emerald-600 h-1.5 rounded-full transition-all duration-300 ease-out" id="pm-progress-bar" style="width: 20%;"></div>
            </div>
          </div>

          <!-- PASO 1: ÁREA DE TRABAJO -->
          <div class="pm-step flex flex-col gap-4 py-4" id="pm-step-1">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 1 · Área de Fricción</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Qué parte de tu trabajo como PM te está quitando más tiempo?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-pm-area">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectArea('Research', this)" type="button">🔍 Research</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectArea('Discovery', this)" type="button">🧭 Discovery</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectArea('Documentación', this)" type="button">📄 Documentación / PRDs</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectArea('Priorización', this)" type="button">📌 Priorización</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectArea('Análisis', this)" type="button">📊 Análisis cuali/cuanti</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectArea('Estrategia', this)" type="button">🎯 Estrategia</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectArea('Reuniones', this)" type="button">👥 Reuniones & Syncs</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectArea('Presentaciones', this)" type="button">🖼️ Presentaciones a Stakeholders</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectArea('Backlog', this)" type="button">📦 Backlog & Refinement</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectArea('Tareas repetitivas', this)" type="button">🔄 Tareas repetitivas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectArea('Otra', this)" type="button">Otra</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectArea('No estoy seguro todavía', this)" type="button">❓ No estoy seguro todavía</button>
            </div>
          </div>

          <!-- PASO 2: FRECUENCIA -->
          <div class="pm-step hidden flex flex-col gap-4 py-4" id="pm-step-2">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 2 · Frecuencia</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Con qué frecuencia haces ese trabajo?</h3>
            </div>
            <div class="flex flex-col gap-2 pt-2" id="group-pm-frecuencia">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectFrecuencia('Varias veces al día', this)" type="button">⚡ Varias veces al día</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectFrecuencia('Todos los días', this)" type="button">📅 Todos los días</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectFrecuencia('Varias veces por semana', this)" type="button">🗓️ Varias veces por semana</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectFrecuencia('Una vez por semana', this)" type="button">📌 Una vez por semana</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectFrecuencia('De vez en cuando', this)" type="button">⏳ De vez en cuando</button>
            </div>
          </div>

          <!-- PASO 3: TIEMPO ESTIMADO -->
          <div class="pm-step hidden flex flex-col gap-4 py-4" id="pm-step-3">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 3 · Tiempo invertido</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Cuánto tiempo crees que te consume a la semana?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-pm-tiempo">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectTiempo('Menos de 1 hora a la semana', this)" type="button">⏱️ Menos de 1 hora a la semana</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectTiempo('1–3 horas', this)" type="button">⏳ 1–3 horas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectTiempo('3–5 horas', this)" type="button">📊 3–5 horas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectTiempo('5–10 horas', this)" type="button">🔥 5–10 horas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectTiempo('Más de 10 horas', this)" type="button">🚨 Más de 10 horas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectTiempo('No tengo idea', this)" type="button">❓ No tengo idea</button>
            </div>
          </div>

          <!-- PASO 4: HERRAMIENTAS ACTUALES -->
          <div class="pm-step hidden flex flex-col gap-4 py-4" id="pm-step-4">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 4 · Stack actual</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Qué estás usando hoy para resolverlo?</h3>
              <p class="text-xs text-slate-500">Puedes seleccionar varias opciones.</p>
            </div>
            <div class="grid grid-cols-2 gap-2 pt-2" id="group-pm-herramientas">
              <button class="multi-option p-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmToggleHerramienta('ChatGPT', this)" type="button">🤖 ChatGPT</button>
              <button class="multi-option p-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmToggleHerramienta('Claude', this)" type="button">🧠 Claude</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmToggleHerramienta('Gemini', this)" type="button">✨ Gemini</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmToggleHerramienta('NotebookLM', this)" type="button">📚 NotebookLM</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmToggleHerramienta('Copilot', this)" type="button">💻 Copilot</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmToggleHerramienta('Notion', this)" type="button">📓 Notion</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmToggleHerramienta('Jira', this)" type="button">🔷 Jira</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmToggleHerramienta('Linear', this)" type="button">📐 Linear</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmToggleHerramienta('Confluence', this)" type="button">📖 Confluence</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmToggleHerramienta('Excel / Sheets', this)" type="button">📊 Excel / Sheets</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmToggleHerramienta('Automatizaciones', this)" type="button">⚡ Automatizaciones</button>
              <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmToggleHerramienta('Nada todavía', this)" type="button">⏳ Nada todavía</button>
            </div>
            <button
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-teal-700 text-white font-semibold text-sm hover:bg-teal-800 transition-colors cursor-pointer self-start mt-2"
              onclick="window.pmNextStep(4)"
              type="button"
            >
              <span>Continuar →</span>
            </button>
          </div>

          <!-- PASO 5: OBJETIVO -->
          <div class="pm-step hidden flex flex-col gap-4 py-4" id="pm-step-5">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 5 · Objetivo deseado</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Qué te gustaría conseguir?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-pm-objetivo">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectObjetivo('Ahorrar tiempo', this)" type="button">⏱️ Ahorrar tiempo</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectObjetivo('Resolver mejor una tarea concreta', this)" type="button">🎯 Resolver mejor una tarea concreta</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectObjetivo('Mejorar mi workflow', this)" type="button">⚙️ Mejorar mi workflow de Producto</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectObjetivo('Automatizar algo repetitivo', this)" type="button">🔄 Automatizar algo repetitivo</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectObjetivo('Conectar mejor las herramientas que ya uso', this)" type="button">🔗 Conectar herramientas que ya uso</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectObjetivo('Aplicar IA a mi trabajo', this)" type="button">🧠 Aplicar IA a mi trabajo de PM</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectObjetivo('Tener más claridad sobre por dónde empezar', this)" type="button">💡 Tener claridad sobre por dónde empezar</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.pmSelectObjetivo('Mejorar mi proceso de Product Management', this)" type="button">🚀 Mejorar mi proceso de PM</button>
            </div>
          </div>

          <!-- PASO 6: DATOS DE CONTACTO -->
          <div class="pm-step hidden flex flex-col gap-4 py-4" id="pm-step-6">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 6 · Enviar Diagnóstico</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">Ya tenemos una idea mucho más clara.</h3>
              <p class="text-sm text-slate-600">¿A dónde te envío el diagnóstico y la recomendación personalizada?</p>
            </div>
            <form class="flex flex-col gap-3 pt-2" onsubmit="event.preventDefault(); window.pmSubmitLead();">
              <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-slate-700" for="pm-input-nombre">Tu Nombre *</label>
                <input class="w-full text-sm px-4 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white" id="pm-input-nombre" placeholder="Ej. Andrea Gómez (PM)" required type="text" />
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="flex flex-col gap-1">
                  <label class="text-xs font-semibold text-slate-700" for="pm-input-email">Correo Electrónico *</label>
                  <input class="w-full text-sm px-4 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white" id="pm-input-email" placeholder="andrea@empresa.com" required type="email" />
                </div>
                <div class="flex flex-col gap-1">
                  <label class="text-xs font-semibold text-slate-700" for="pm-input-whatsapp">Número de WhatsApp *</label>
                  <input class="w-full text-sm px-4 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white" id="pm-input-whatsapp" placeholder="+57 300 000 0000" required type="tel" />
                </div>
              </div>

              <div class="pt-2">
                <button id="pm-btn-submit" class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer" type="submit">
                  <span>Ver diagnóstico y recomendación →</span>
                </button>
              </div>
            </form>
          </div>

          <!-- RESULTADO PERSONALIZADO -->
          <div class="pm-step hidden flex flex-col gap-5 py-4" id="pm-step-result">
            <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex flex-col gap-2">
              <div class="flex items-center gap-2 text-emerald-800 font-bold text-sm">
                <span class="material-symbols-outlined text-emerald-600 text-xl">verified</span>
                <span>Diagnóstico de Producto Completado</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900">Esto es lo que veo en tu caso:</h3>
              <p class="text-xs text-slate-700 leading-relaxed" id="pm-result-summary">
