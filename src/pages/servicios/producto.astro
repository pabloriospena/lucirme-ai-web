      <div class="max-w-3xl mx-auto space-y-8 relative z-10">
        
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white leading-tight">
          ¿Tienes un proceso de Producto que te quita demasiado tiempo?
        </h2>

        <p class="text-base sm:text-xl text-gray-300 font-medium max-w-2xl mx-auto leading-relaxed">
          Hablemos 20 minutos. Lo revisamos juntos, sin compromiso, y vemos si tiene sentido trabajarlo.
        </p>

        <div class="pt-2 flex flex-col items-center gap-4">
          <a 
            href={ctaRevisarProceso}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-emerald-500 text-slate-950 text-lg sm:text-xl font-black px-10 py-5 rounded-2xl hover:bg-emerald-400 transition transform hover:-translate-y-1 shadow-2xl hover:shadow-emerald-500/20 w-full sm:w-auto"
          >
            <span>💬</span>
            <span>Hablar por WhatsApp con Pablo</span>
          </a>

          <p class="text-xs sm:text-sm text-gray-400">
            Sin presentaciones de ventas agresivas. Directo a tu problema real.
          </p>
        </div>

      </div>
    </section>

  </main>

  <!-- JAVASCRIPT DE INTERACTIVIDAD (MOBILE MENU, EXPANDABLE CARDS, FAQ) -->
  <script is:inline>
    // 1. Mobile Menu Toggle
    const mobileBtn = document.getElementById('product-mobile-menu-btn');
    const mobileMenu = document.getElementById('product-mobile-menu');
    const iconBars = document.getElementById('menu-icon-bars');
    const iconClose = document.getElementById('menu-icon-close');

    if (mobileBtn && mobileMenu) {
      mobileBtn.addEventListener('click', () => {
        const isHidden = mobileMenu.classList.contains('hidden');
        if (isHidden) {
          mobileMenu.classList.remove('hidden');
          iconBars.classList.add('hidden');
          iconClose.classList.remove('hidden');
        } else {
          mobileMenu.classList.add('hidden');
          iconBars.classList.remove('hidden');
          iconClose.classList.add('hidden');
        }
      });
    }

    // 2. Expandable Opportunity Cards
    document.querySelectorAll('.product-card').forEach((card) => {
      const header = card.querySelector('.product-card-header');
      const content = card.querySelector('.card-content');
      const chevron = card.querySelector('.card-chevron');

      if (header && content) {
        header.addEventListener('click', () => {
          const isHidden = content.classList.contains('hidden');
          
          // Opcional: cerrar otras
          document.querySelectorAll('.product-card').forEach((otherCard) => {
            if (otherCard !== card) {
              otherCard.querySelector('.card-content')?.classList.add('hidden');
              const otherChevron = otherCard.querySelector('.card-chevron');
              if (otherChevron) otherChevron.style.transform = 'rotate(0deg)';
            }
          });

          if (isHidden) {
            content.classList.remove('hidden');
            if (chevron) chevron.style.transform = 'rotate(180deg)';
          } else {
            content.classList.add('hidden');
            if (chevron) chevron.style.transform = 'rotate(0deg)';
          }
        });
      }
    });

    // 3. FAQ Toggle
    document.querySelectorAll('.faq-item').forEach((item) => {
      const toggle = item.querySelector('.faq-toggle');
      const answer = item.querySelector('.faq-answer');
      const chevron = item.querySelector('.faq-chevron');

      if (toggle && answer) {
        toggle.addEventListener('click', () => {
          const isHidden = answer.classList.contains('hidden');
          
          document.querySelectorAll('.faq-item').forEach((otherItem) => {
            if (otherItem !== item) {
              otherItem.querySelector('.faq-answer')?.classList.add('hidden');
              const otherChevron = otherItem.querySelector('.faq-chevron');
              if (otherChevron) otherChevron.style.transform = 'rotate(0deg)';
            }
          });

          if (isHidden) {
            answer.classList.remove('hidden');
            if (chevron) chevron.style.transform = 'rotate(180deg)';
          } else {
            answer.classList.add('hidden');
            if (chevron) chevron.style.transform = 'rotate(0deg)';
          }
        });
      }
    });
  </script>

</Layout>
