          <p class="text-xs font-mono text-slate-500">Product Management aplicado a problemas reales.</p>
        </div>
        <div class="flex items-center gap-4 text-xs text-slate-600 font-medium">
          <a class="hover:text-slate-900 transition-colors" href={whatsappPM} target="_blank">WhatsApp Directo</a>
          <a class="hover:text-slate-900 transition-colors" href="/profesionales">Profesionales</a>
          <a class="hover:text-slate-900 transition-colors" href="/empresas">Empresas</a>
          <a class="hover:text-slate-900 transition-colors" href="/educacion">Educación</a>
          <a class="hover:text-slate-900 transition-colors" href="/sobre-pablo">Sobre Pablo</a>
        </div>
      </div>
      <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-500">
        <span>© 2026 LuciRMe AI · Todos los derechos reservados.</span>
        <span>lucirme.com/servicios/producto</span>
      </div>
    </div>
  </footer>

  <!-- SCRIPT DIAGNÓSTICO PM Y EVENTOS POSTHOG -->
  <script>
    let pmStep = 1;
    const totalPmSteps = 5;

    const pmState: Record<string, any> = {
      area: '',
      frecuencia: '',
      tiempo: '',
      herramientas: [],
      objetivo: '',
      nombre: '',
      email: '',
      whatsapp: '',
    };

    // Restore from sessionStorage
    try {
      const saved = sessionStorage.getItem('pm_diag_state');
      if (saved) {
        Object.assign(pmState, JSON.parse(saved));
      }
    } catch (e) {}

    function savePmState() {
      try {
        sessionStorage.setItem('pm_diag_state', JSON.stringify(pmState));
      } catch (e) {}
    }

    function updatePmWizardProgress() {
      const counter = document.getElementById('pm-step-counter');
      const bar = document.getElementById('pm-progress-bar');
      const tag = document.getElementById('pm-status-tag');
      const prevBtn = document.getElementById('pm-btn-prev') as HTMLButtonElement | null;

      if (!counter || !bar) return;

      if (pmStep <= totalPmSteps) {
        const pct = (pmStep / totalPmSteps) * 100;
        counter.innerText = `Paso ${pmStep} de ${totalPmSteps}`;
        bar.style.width = `${pct}%`;
        if (tag) tag.innerText = `Paso ${pmStep}`;
        if (prevBtn) prevBtn.disabled = pmStep === 1;
      } else {
        counter.innerText = 'Diagnóstico Completado';
        bar.style.width = '100%';
        if (tag) tag.innerText = 'Completado';
        if (prevBtn) prevBtn.disabled = false;
      }
    }

    function pmGoToStep(step: number) {
      document.querySelectorAll('.pm-step').forEach(el => el.classList.add('hidden'));

      pmStep = step;
      if (step <= totalPmSteps) {
        const target = document.getElementById(`pm-step-${step}`);
        if (target) target.classList.remove('hidden');
      } else if (step === 6) {
        const target = document.getElementById('pm-step-6');
        if (target) target.classList.remove('hidden');
      } else {
        const res = document.getElementById('pm-step-result');
        if (res) res.classList.remove('hidden');
      }

      updatePmWizardProgress();
    }

    function pmPrevStep() {
      if (pmStep > 1 && pmStep <= totalPmSteps) {
        pmGoToStep(pmStep - 1);
      } else if (pmStep > totalPmSteps) {
        pmGoToStep(totalPmSteps);
      }
    }

    function pmNextStep(step: number) {
      if (step === 4) {
        pmGoToStep(5);
      }
    }

    function pmSelectArea(val: string, btn: HTMLElement) {
      pmState.area = val;
      savePmState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('product_diagnostic_question_answered', {
          question: 'area_friccion_pm',
          answer: val,
        });
      }

      setTimeout(() => pmGoToStep(2), 250);
    }

    function pmSelectFrecuencia(val: string, btn: HTMLElement) {
      pmState.frecuencia = val;
      savePmState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('product_diagnostic_question_answered', {
          question: 'frecuencia_pm',
          answer: val,
        });
      }

      setTimeout(() => pmGoToStep(3), 250);
    }

    function pmSelectTiempo(val: string, btn: HTMLElement) {
      pmState.tiempo = val;
      savePmState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('product_diagnostic_question_answered', {
          question: 'tiempo_estimado_pm',
          answer: val,
        });
      }

      setTimeout(() => pmGoToStep(4), 250);
    }

    function pmToggleHerramienta(val: string, btn: HTMLElement) {
      const list: string[] = pmState.herramientas || [];
      const idx = list.indexOf(val);

      if (idx >= 0) {
        list.splice(idx, 1);
        btn.classList.remove('border-teal-700', 'bg-teal-50', 'text-teal-900', 'font-bold');
        btn.classList.add('border-slate-200', 'text-slate-700');
      } else {
        list.push(val);
        btn.classList.remove('border-slate-200', 'text-slate-700');
        btn.classList.add('border-teal-700', 'bg-teal-50', 'text-teal-900', 'font-bold');
      }

      pmState.herramientas = list;
      savePmState();
    }

    function pmSelectObjetivo(val: string, btn: HTMLElement) {
      pmState.objetivo = val;
      savePmState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('product_diagnostic_question_answered', {
          question: 'objetivo_pm',
          answer: val,
        });
      }

      setTimeout(() => pmGoToStep(6), 300);
    }

    async function pmSubmitLead() {
      const nomInput = document.getElementById('pm-input-nombre') as HTMLInputElement | null;
      const emInput = document.getElementById('pm-input-email') as HTMLInputElement | null;
      const waInput = document.getElementById('pm-input-whatsapp') as HTMLInputElement | null;
      const submitBtn = document.getElementById('pm-btn-submit') as HTMLButtonElement | null;

      const nom = nomInput?.value.trim() || '';
      const em = emInput?.value.trim() || '';
      const wa = waInput?.value.trim() || '';

      if (!nom) {
        alert('Por favor ingresa tu nombre.');
        return;
      }

      if (!em || !em.includes('@')) {
        alert('Por favor ingresa un correo electrónico válido.');
        return;
      }

      if (!wa) {
        alert('Por favor ingresa tu número de WhatsApp.');
        return;
      }

      pmState.nombre = nom;
      pmState.email = em;
      pmState.whatsapp = wa;
      savePmState();

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Enviando y calculando...';
      }

      try {
        const res = await fetch('/api/professional-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: pmState.nombre,
            email: pmState.email,
            whatsapp: pmState.whatsapp,
            problema_principal: pmState.area || 'Product Management',
            frecuencia: pmState.frecuencia || 'Semanal',
            tiempo_estimado: pmState.tiempo || '3–5 horas',
            herramientas_actuales: pmState.herramientas,
            objetivo: pmState.objetivo || 'Mejorar workflow PM',
            recomendacion: 'Acompañamiento PM e IA',
            fuente: 'Landing /servicios/producto',
            tipo_de_pagina: 'producto',
          }),
        });

        const result = await res.json();
        if (!res.ok && result.error) {
          alert(result.error);
        }
      } catch (err) {
        console.error('Error enviando lead de producto:', err);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Ver diagnóstico y recomendación →';
        }
      }

      // Dynamic Summary
      const summaryText = document.getElementById('pm-result-summary');
      if (summaryText) {
        const toolsStr = Array.isArray(pmState.herramientas) && pmState.herramientas.length > 0
          ? pmState.herramientas.join(', ')
          : 'herramientas habituales';

        summaryText.innerHTML = `
          Por lo que me cuentas, una parte importante de tu tiempo como PM se está yendo en el área de <strong>${pmState.area || 'documentación y análisis'}</strong>. Si esta tarea aparece <strong>${pmState.frecuencia || 'frecuentemente'}</strong> y puede estar consumiendo entre <strong>${pmState.tiempo || '3 y 5 horas'}</strong> semanales, vale la pena revisarla con más detalle. Ya utilizas algunas herramientas (<em>${toolsStr}</em>), pero todavía no existe un flujo claro entre ellas. En tu caso no empezaría buscando otra herramienta: empezaría por revisar cómo estás haciendo hoy ese trabajo y detectar qué partes realmente vale la pena simplificar o automatizar.
        `;
      }

      if ((window as any).posthog) {
        (window as any).posthog.capture('product_diagnostic_completed', {
          problem_area: pmState.area,
          frequency: pmState.frecuencia,
          estimated_time: pmState.tiempo,
          current_tools: pmState.herramientas,
          goal: pmState.objetivo,
        });
        (window as any).posthog.capture('product_lead_submitted', {
          problem_area: pmState.area,
          frequency: pmState.frecuencia,
          goal: pmState.objetivo,
        });
      }

      pmGoToStep(7);
    }

    // Window assignments
    (window as any).pmGoToStep = pmGoToStep;
    (window as any).pmPrevStep = pmPrevStep;
    (window as any).pmNextStep = pmNextStep;
    (window as any).pmSelectArea = pmSelectArea;
    (window as any).pmSelectFrecuencia = pmSelectFrecuencia;
    (window as any).pmSelectTiempo = pmSelectTiempo;
    (window as any).pmToggleHerramienta = pmToggleHerramienta;
    (window as any).pmSelectObjetivo = pmSelectObjetivo;
    (window as any).pmSubmitLead = pmSubmitLead;

    document.addEventListener('DOMContentLoaded', () => {
      updatePmWizardProgress();

      if ((window as any).posthog) {
        (window as any).posthog.capture('product_page_view', {
          url: window.location.href,
        });
      }
    });
  </script>
</Layout>
