<script is:inline>
  // Dropdown filtering logic
  document.addEventListener("DOMContentLoaded", () => {
    const routeSelect = document.getElementById("route-select-filter");
    const cards = document.querySelectorAll(".route-card");

    if (routeSelect) {
      // Check for hash in URL on load (e.g. #ruta-pm or #ruta-comunicacion)
      const hash = window.location.hash.replace("#", "");
      if (hash) {
        const targetElement = document.getElementById(hash);
        if (targetElement) {
          const routeAttr = targetElement.getAttribute("data-route");
          if (routeAttr) {
            routeSelect.value = routeAttr;
            cards.forEach(card => {
              card.style.display = card.getAttribute("data-route") === routeAttr ? "block" : "none";
            });
          }
        }
      }

      routeSelect.addEventListener("change", function() {
        const filter = this.value;
        cards.forEach(card => {
          if (filter === "all" || card.getAttribute("data-route") === filter) {
            card.style.display = "block";
          } else {
            card.style.display = "none";
          }
        });
      });
    }
  });
</script>
