---
import Layout from "../layouts/Layout.astro";
import { LINKS } from "../lib/constants.js";
---

<Layout title="Rutas para LuciRMe | Rutas de Aprendizaje con IA">
  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-10">
    
    <!-- TOP METADATA & BREADCRUMB -->
    <section class="space-y-4 border-b border-gray-100 pb-8">
      <div class="flex flex-wrap items-center gap-2 text-xs text-gray-400 font-mono">
        <a href="/recursos" class="hover:text-teal transition-colors flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
          </svg>
          <span>Recursos</span>
        </a>
        <span>/</span>
        <span class="text-deep font-semibold flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          <span>Rutas de Aprendizaje</span>
        </span>
        <span class="text-gray-300">•</span>
        <span class="bg-teal/10 text-teal px-2 py-0.5 rounded-full font-bold text-[10px] uppercase tracking-wider">Método LuciRMe AI</span>
      </div>

      <!-- TITLE BLOCK -->
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-2xl bg-teal/10 border border-teal/20 flex items-center justify-center text-teal shrink-0 shadow-2xs">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
        </div>
        <div class="space-y-1">
          <h1 class="text-3xl sm:text-4xl font-extrabold text-deep tracking-tight">
            Rutas de Aprendizaje con IA
          </h1>
          <p class="text-sm sm:text-base text-gray-500 max-w-3xl leading-relaxed">
            Aprende a tu ritmo: Comienza con recursos prácticos 100% gratuitos y avanza a sistemas guiados para dominar la IA con criterio profesional.
          </p>
        </div>
      </div>

      <!-- QUICK METRIC CHIPS -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-2">
        <div class="bg-white border border-gray-200/80 rounded-xl p-3 flex items-center gap-3 shadow-2xs">
          <div class="w-8 h-8 rounded-lg bg-teal/10 flex items-center justify-center text-teal shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div>
            <span class="block font-bold text-sm text-deep leading-none">4 Rutas</span>
            <span class="block text-[11px] text-gray-400">Especializadas</span>
          </div>
        </div>

        <div class="bg-white border border-gray-200/80 rounded-xl p-3 flex items-center gap-3 shadow-2xs">
          <div class="w-8 h-8 rounded-lg bg-teal/10 flex items-center justify-center text-teal shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19a2 2 0 01-2-2V7a2 2 0 012-2h4l2 2h4a2 2 0 012 2v1M5 19h14a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <span class="block font-bold text-sm text-deep leading-none">19 Recursos</span>
            <span class="block text-[11px] text-gray-400">Tácticos</span>
          </div>
        </div>

        <div class="bg-white border border-gray-200/80 rounded-xl p-3 flex items-center gap-3 shadow-2xs">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-700 shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <span class="block font-bold text-sm text-deep leading-none">80% Gratis</span>
            <span class="block text-[11px] text-gray-400">Para comenzar</span>
          </div>
        </div>

        <div class="bg-white border border-gray-200/80 rounded-xl p-3 flex items-center gap-3 shadow-2xs">
          <div class="w-8 h-8 rounded-lg bg-orange/10 flex items-center justify-center text-orange shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <span class="block font-bold text-sm text-deep leading-none">Sin Relleno</span>
            <span class="block text-[11px] text-gray-400">Ni teoría vacía</span>
          </div>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE FILTER DROPDOWN -->
    <section class="sticky top-16 z-30 bg-[#F8FAFC]/95 backdrop-blur-md py-2.5 border-b border-gray-100">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <label for="route-select-filter" class="text-xs font-bold text-deep flex items-center gap-1.5 shrink-0">
            <svg class="w-4 h-4 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            <span>Filtrar Ruta:</span>
          </label>
          <div class="relative w-full sm:w-80">
            <select 
              id="route-select-filter"
              class="w-full appearance-none bg-white border border-gray-200 hover:border-teal rounded-xl px-3.5 py-2 pr-9 text-xs font-bold text-deep transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-teal/20 shadow-2xs"
            >
              <option value="all">Todas las rutas (4 especialidades)</option>
              <option value="ruta-1">01. Comunicación & Presentaciones Ejecutivas</option>
              <option value="ruta-2">02. Product Management & Estrategia</option>
              <option value="ruta-3">03. Productividad, Investigación & NotebookLM</option>
              <option value="ruta-4">04. Empleabilidad y Desarrollo Profesional</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-gray-400">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>

        <div class="hidden lg:flex items-center gap-3 text-xs text-gray-400 font-medium shrink-0">
          <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Nivel 01-03: Gratis</span>
          <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Nivel 04-05: Pro</span>
        </div>
      </div>
    </section>

    <!-- LIST OF 4 DETAILED LEARNING PATHS -->
    <div class="space-y-12" id="routes-container">
      
      <!-- ========================================== -->
      <!-- RUTA 1: COMUNICACIÓN Y PRESENTACIONES      -->
      <!-- ========================================== -->
      <article class="route-card bg-white border border-gray-200 rounded-2xl p-6 shadow-2xs space-y-6" data-route="ruta-1" id="ruta-comunicacion">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-gray-100">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-xl bg-teal/10 text-teal flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2 flex-wrap mb-1">
                <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded bg-teal text-white">Ruta 01</span>
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-teal/10 text-teal">5 Etapas Progresivas</span>
                <span class="text-[11px] text-gray-400 font-mono">3.5 hrs estimadas</span>
              </div>
              <h2 class="text-xl font-bold text-deep">Comunicación y Presentaciones Ejecutivas</h2>
              <p class="text-xs text-gray-500 mt-0.5">Convierte notas dispersas, reuniones y datos en historias ejecutivas sin trasnochar.</p>
            </div>
          </div>
        </div>

        <!-- Stepper Levels -->
        <div class="space-y-3">
          
          <!-- Level 01 -->
          <div class="p-4 rounded-xl bg-[#F7F7F5] border border-gray-200/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-[#F1F1EF] transition-all">
            <div class="flex items-start gap-3">
              <span class="text-xs font-mono font-bold text-teal bg-white border border-gray-200 px-2 py-1 rounded shrink-0">01</span>
              <div>
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="text-xs font-bold text-deep">Presentaciones con IA en 30 Minutos</span>
                  <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.2 rounded-full">Gratis</span>
                </div>
                <p class="text-xs text-gray-500">Diseña la estructura, contenido y layout de tus slides en 4 pasos y 4 prompts probados.</p>
              </div>
            </div>
            <a href="/presentaciones-con-ia" class="self-end sm:self-center px-3.5 py-1.5 rounded-lg bg-teal text-white text-xs font-bold hover:bg-teal/90 transition shrink-0 shadow-2xs">
              Acceder Gratis →
            </a>
          </div>

          <!-- Level 02 -->
          <div class="p-4 rounded-xl bg-[#F7F7F5] border border-gray-200/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-[#F1F1EF] transition-all">
            <div class="flex items-start gap-3">
              <span class="text-xs font-mono font-bold text-teal bg-white border border-gray-200 px-2 py-1 rounded shrink-0">02</span>
              <div>
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="text-xs font-bold text-deep">Convierte una reunión en decisiones claras</span>
                  <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.2 rounded-full">Gratis</span>
                </div>
                <p class="text-xs text-gray-500">Extrae acuerdos, responsables y riesgos de transcripciones con 3 prompts maestros.</p>
              </div>
            </div>
            <a href="/recursos/reunion-claridad" class="self-end sm:self-center px-3.5 py-1.5 rounded-lg bg-white border border-gray-300 text-deep text-xs font-bold hover:bg-gray-50 transition shrink-0">
              Ver Guía →
            </a>
          </div>

          <!-- Level 03 -->
          <div class="p-4 rounded-xl bg-[#F7F7F5] border border-gray-200/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-[#F1F1EF] transition-all">
            <div class="flex items-start gap-3">
              <span class="text-xs font-mono font-bold text-teal bg-white border border-gray-200 px-2 py-1 rounded shrink-0">03</span>
              <div>
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="text-xs font-bold text-deep">De Notas a Reportes con NotebookLM</span>
                  <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.2 rounded-full">Gratis</span>
                </div>
                <p class="text-xs text-gray-500">Flujo de 3 pasos para consolidar emails, audios y hojas de cálculo en síntesis directivas.</p>
              </div>
            </div>
            <a href="/recursos/career-path-notebooklm" class="self-end sm:self-center px-3.5 py-1.5 rounded-lg bg-white border border-gray-300 text-deep text-xs font-bold hover:bg-gray-50 transition shrink-0">
              Ver Flujo →
            </a>
          </div>

          <!-- Level 04 -->
          <div class="p-4 rounded-xl bg-[#F7F7F5] border border-gray-200/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-[#F1F1EF] transition-all">
            <div class="flex items-start gap-3">
              <span class="text-xs font-mono font-bold text-orange bg-white border border-gray-200 px-2 py-1 rounded shrink-0">04</span>
              <div>
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="text-xs font-bold text-deep">Bot Presentaciones ($8 USD)</span>
                  <span class="text-[10px] font-bold text-slate-900 bg-amber-200 px-2 py-0.2 rounded-full">Tool IA • $8</span>
                </div>
                <p class="text-xs text-gray-500">Asistente IA interactivo con framework de narrativa que te guía paso a paso en el armado de tu presentación.</p>
              </div>
            </div>
            <a href="/bot-presentaciones" class="self-end sm:self-center px-3.5 py-1.5 rounded-lg bg-orange text-white text-xs font-bold hover:bg-orange/90 transition shrink-0 shadow-2xs">
              Obtener Bot ($8) →
            </a>
          </div>

          <!-- Level 05 -->
          <div class="p-4 rounded-xl bg-gradient-to-r from-amber-500/10 via-amber-100/30 to-teal/10 border border-amber-300/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs">
            <div class="flex items-start gap-3">
              <span class="text-xs font-mono font-black text-slate-950 bg-amber-400 px-2 py-1 rounded shrink-0">05</span>
              <div>
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="text-xs font-bold text-deep">Curso Presentaciones con IA ($35 USD)</span>
                  <span class="text-[10px] font-black uppercase text-slate-950 bg-amber-400 px-2 py-0.5 rounded-full">Programa Completo</span>
                </div>
                <p class="text-xs text-gray-600">Método de 5 pasos (<strong class="text-deep">Organiza, Analiza, Sintetiza, Valida, Presenta</strong>) para crear reportes y dashboards ejecutivos con alto impacto de decisión.</p>
              </div>
            </div>
            <a href="/curso-presentaciones" class="self-end sm:self-center px-4 py-2 rounded-lg bg-amber-500 text-slate-950 text-xs font-black hover:bg-amber-400 transition shrink-0 shadow-sm">
              Inscribirme ($35 USD) →
            </a>
          </div>

        </div>
      </article>

      <!-- ========================================== -->
      <!-- RUTA 2: PRODUCT MANAGEMENT                 -->
      <!-- ========================================== -->
      <article class="route-card bg-white border border-gray-200 rounded-2xl p-6 shadow-2xs space-y-6" data-route="ruta-2" id="ruta-pm">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-gray-100">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-xl bg-orange/10 text-orange flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2 flex-wrap mb-1">
                <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded bg-orange text-white">Ruta 02</span>
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-orange/10 text-orange">De Idea a Entrega Táctica</span>
                <span class="text-[11px] text-gray-400 font-mono">4 hrs estimadas</span>
              </div>
              <h2 class="text-xl font-bold text-deep">Product Management & Estrategia Sin Bullshit</h2>
              <p class="text-xs text-gray-500 mt-0.5">Diseña, prioriza y construye productos reales sin perderte en marcos teóricos vacíos.</p>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          
          <!-- Level 01 -->
          <div class="p-4 rounded-xl bg-[#F7F7F5] border border-gray-200/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-[#F1F1EF] transition-all">
            <div class="flex items-start gap-3">
              <span class="text-xs font-mono font-bold text-orange bg-white border border-gray-200 px-2 py-1 rounded shrink-0">01</span>
              <div>
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="text-xs font-bold text-deep">Ideador de Productos</span>
                  <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.2 rounded-full">Gratis</span>
                </div>
                <p class="text-xs text-gray-500">Estructura y valida la idea de tu app o funcionalidad en 4 fases usando Jobs to be Done, Perplexity y Lovable.</p>
              </div>
            </div>
            <a href="/recursos/ideador-producto" class="self-end sm:self-center px-3.5 py-1.5 rounded-lg bg-teal text-white text-xs font-bold hover:bg-teal/90 transition shrink-0">
              Usar Ideador →
            </a>
          </div>

          <!-- Level 02 -->
          <div class="p-4 rounded-xl bg-[#F7F7F5] border border-gray-200/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-[#F1F1EF] transition-all">
            <div class="flex items-start gap-3">
              <span class="text-xs font-mono font-bold text-orange bg-white border border-gray-200 px-2 py-1 rounded shrink-0">02</span>
              <div>
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="text-xs font-bold text-deep">Backlog Detox</span>
                  <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.2 rounded-full">Gratis</span>
                </div>
                <p class="text-xs text-gray-500">Limpia y prioriza tu backlog de tareas acumuladas al instante evaluando impacto, esfuerzo y valor real.</p>
              </div>
            </div>
            <a href="/recursos/backlog-detox" class="self-end sm:self-center px-3.5 py-1.5 rounded-lg bg-teal text-white text-xs font-bold hover:bg-teal/90 transition shrink-0 shadow-2xs">
              Usar Detox →
            </a>
          </div>

          <!-- Level 03 -->
          <div class="p-4 rounded-xl bg-[#F7F7F5] border border-gray-200/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-[#F1F1EF] transition-all">
            <div class="flex items-start gap-3">
              <span class="text-xs font-mono font-bold text-orange bg-white border border-gray-200 px-2 py-1 rounded shrink-0">03</span>
              <div>
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="text-xs font-bold text-deep">ShapeUp Builder</span>
                  <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.2 rounded-full">Gratis</span>
                </div>
                <p class="text-xs text-gray-500">Pasa de un problema difuso a un Pitch listo para construir definiendo apetito, riesgos y límites con Shape Up.</p>
              </div>
            </div>
            <a href="/recursos/shapeup-builder" class="self-end sm:self-center px-3.5 py-1.5 rounded-lg bg-teal text-white text-xs font-bold hover:bg-teal/90 transition shrink-0 shadow-2xs">
              Usar ShapeUp →
            </a>
          </div>

          <!-- Level 04 -->
          <div class="p-4 rounded-xl bg-[#F7F7F5] border border-gray-200/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-[#F1F1EF] transition-all">
            <div class="flex items-start gap-3">
              <span class="text-xs font-mono font-bold text-orange bg-white border border-gray-200 px-2 py-1 rounded shrink-0">04</span>
              <div>
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="text-xs font-bold text-deep">Ebook: Product Management Sin Bullshit (Vol. 1)</span>
                  <span class="text-[10px] font-bold text-orange bg-orange/10 px-2 py-0.2 rounded-full">$53.000 COP</span>
                </div>
                <p class="text-xs text-gray-500">Manual táctico para construir y lanzar productos en startups reales, evitando métricas vanidosas y feature creep.</p>
              </div>
            </div>
            <a href={LINKS.ebook} target="_blank" rel="noopener noreferrer" class="self-end sm:self-center px-3.5 py-1.5 rounded-lg bg-orange text-white text-xs font-bold hover:bg-orange/90 transition shrink-0 shadow-2xs">
              Comprar Ebook →
            </a>
          </div>

        </div>
      </article>

      <!-- ========================================== -->
      <!-- RUTA 3: NOTEBOOKLM Y RESEARCH              -->
      <!-- ========================================== -->
      <article class="route-card bg-white border border-gray-200 rounded-2xl p-6 shadow-2xs space-y-6" data-route="ruta-3" id="ruta-notebooklm">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-gray-100">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
