                class="inline-flex items-center justify-center gap-1 w-full py-2 rounded-lg bg-emerald-600 text-white font-bold text-xs hover:bg-emerald-500 transition-colors"
              >
                <span>Trabajarlo conmigo</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- BOTTOM MANIFESTO CALLOUT -->
    <section
      class="mt-8 p-4 rounded-xl bg-gray-50 border border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <div class="flex items-center gap-3">
        <span class="text-teal text-xl">🛡️</span>
        <p class="text-xs text-gray-600 leading-relaxed">
          <strong class="font-bold text-deep">Compromiso LucirMe:</strong> Cada recurso
          responde a un caso de uso real. Cero teoría innecesaria ni contenido desactualizado.
        </p>
      </div>
      <a
        href="/content/como_funciona"
        class="inline-flex items-center gap-1 text-xs font-bold text-teal hover:underline shrink-0"
      >
        <span>Leer Manifiesto</span>
        <span>→</span>
      </a>
    </section>
  </div>
</Layout>

<script is:inline>
  function selectRoute(targetRouteId) {
    filterRoutes(targetRouteId);
    const targetElement = document.getElementById(targetRouteId);
    if (targetElement) {
      targetElement.scrollIntoView({ behavior: "smooth", block: "start" });
      targetElement.classList.remove("route-highlight");
      void targetElement.offsetWidth; // trigger reflow
      targetElement.classList.add("route-highlight");
      setTimeout(() => {
        targetElement.classList.remove("route-highlight");
      }, 1800);
    }
  }

  function filterRoutes(routeFilter) {
    const cards = document.querySelectorAll(".route-master-card");
    const tabs = document.querySelectorAll(".route-tab");

    tabs.forEach((tab) => {
      tab.classList.remove("text-teal", "bg-white", "shadow-2xs", "font-bold");
      tab.classList.add("text-gray-500", "font-semibold");
    });

    const activeTab = document.getElementById("tab-" + routeFilter);
    if (activeTab) {
      activeTab.classList.add(
        "text-teal",
        "bg-white",
        "shadow-2xs",
        "font-bold",
      );
      activeTab.classList.remove("text-gray-500", "font-semibold");
    }

    cards.forEach((card) => {
      if (
        routeFilter === "all" ||
        card.getAttribute("data-route") === routeFilter
      ) {
        card.style.display = "block";
      } else {
        card.style.display = "none";
      }
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    const hash = window.location.hash.replace("#", "");
    if (hash && document.getElementById(hash)) {
      selectRoute(hash);
    }
  });
</script>
