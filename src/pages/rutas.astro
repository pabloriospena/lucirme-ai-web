---
import Layout from "../layouts/Layout.astro";
import { LINKS } from "../lib/constants.js";
---

<Layout title="Rutas para LuciRMe | Rutas de Aprendizaje con IA">
  <style>
    .route-highlight {
      animation: pulse-ring 1.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    @keyframes pulse-ring {
      0% {
        box-shadow: 0 0 0 0 rgba(13, 148, 136, 0.65);
        transform: translateY(-2px);
      }
      40% {
        box-shadow: 0 0 0 6px rgba(13, 148, 136, 0.28);
        transform: translateY(-2px);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(13, 148, 136, 0);
        transform: translateY(0);
      }
    }
  </style>

  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- 1. HERO & BREADCRUMB -->
    <section class="space-y-4">
      <div
        class="flex flex-wrap items-center gap-2 text-xs text-gray-400 font-mono"
      >
        <a
          href="/recursos"
          class="hover:text-teal transition-colors flex items-center gap-1"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
            ></path>
          </svg>
          <span>Recursos</span>
        </a>
        <span>/</span>
        <span class="text-deep font-semibold flex items-center gap-1">
          <svg
            class="w-3.5 h-3.5 text-teal"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
            ></path>
          </svg>
          <span>Rutas</span>
        </span>
      </div>

      <div class="max-w-4xl space-y-2">
        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-deep tracking-tight"
        >
          ¿Qué quieres resolver hoy?
        </h1>
        <p class="text-base sm:text-lg text-gray-600 max-w-3xl leading-relaxed">
          Elige tu problema. Puedes empezar gratis por tu cuenta o trabajarlo
          directamente conmigo.
        </p>
      </div>

      <!-- 2. CAMINO 1: RESOLVERLO POR MI CUENTA -->
      <div class="pt-4 flex flex-col gap-6">
        <div class="flex flex-col gap-3">
          <div
            class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2"
          >
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-teal"></span>
              <h2 class="text-lg md:text-xl text-deep font-bold tracking-tight">
                Quiero resolverlo por mi cuenta
              </h2>
            </div>
            <p class="text-xs text-gray-500">
              Elige el problema y empieza con una solución concreta.
            </p>
          </div>

          <div
            class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 items-stretch"
          >
            <!-- Tarjeta 1 -->
            <button
              onclick="selectRoute('ruta-comunicacion')"
              class="group relative p-4 rounded-xl bg-white border border-gray-200 hover:border-teal hover:shadow-md transition-all flex flex-col justify-between text-left cursor-pointer"
            >
              <div>
                <div
                  class="w-10 h-10 rounded-lg bg-teal/10 text-teal flex items-center justify-center text-xl mb-3 group-hover:scale-105 transition-transform"
                >
                  📊
                </div>
                <h3
                  class="font-bold text-sm text-deep group-hover:text-teal transition-colors mb-1.5"
                >
                  Necesito hacer una presentación
                </h3>
                <p class="text-xs text-gray-500 leading-snug">
                  Haz una presentación clara sin pasar horas organizando
                  información y peleando con diapositivas.
                </p>
              </div>
              <div
                class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-teal font-bold"
              >
                <span>Empezar presentación</span>
                <span class="group-hover:translate-x-1 transition-transform"
                  >→</span
                >
              </div>
            </button>

            <!-- Tarjeta 2 -->
            <button
              onclick="selectRoute('ruta-notebooklm')"
              class="group relative p-4 rounded-xl bg-white border border-gray-200 hover:border-slate-800 hover:shadow-md transition-all flex flex-col justify-between text-left cursor-pointer"
            >
              <div>
                <div
                  class="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center text-xl mb-3 group-hover:scale-105 transition-transform"
                >
                  🧠
                </div>
                <h3
                  class="font-bold text-sm text-deep group-hover:text-slate-800 transition-colors mb-1.5"
                >
                  Necesito ordenar información
                </h3>
                <p class="text-xs text-gray-500 leading-snug">
                  Convierte documentos, audios, reuniones y otras fuentes
                  dispersas en trabajo útil y síntesis clara.
                </p>
              </div>
              <div
                class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-indigo-700 font-bold"
              >
                <span>Ordenar información</span>
                <span class="group-hover:translate-x-1 transition-transform"
                  >→</span
                >
              </div>
            </button>

            <!-- Tarjeta 3 -->
            <button
              onclick="selectRoute('ruta-pm')"
              class="group relative p-4 rounded-xl bg-white border border-gray-200 hover:border-orange hover:shadow-md transition-all flex flex-col justify-between text-left cursor-pointer"
            >
              <div>
                <div
                  class="w-10 h-10 rounded-lg bg-orange/10 text-orange flex items-center justify-center text-xl mb-3 group-hover:scale-105 transition-transform"
                >
                  🚀
                </div>
                <h3
                  class="font-bold text-sm text-deep group-hover:text-orange transition-colors mb-1.5"
                >
                  Necesito trabajar mejor como PM
                </h3>
                <p class="text-xs text-gray-500 leading-snug">
                  Prioriza, estructura problemas y toma decisiones de producto
                  sin rodeos ni plantillas vacías.
                </p>
              </div>
              <div
                class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-orange font-bold"
              >
                <span>Resolver problema PM</span>
                <span class="group-hover:translate-x-1 transition-transform"
                  >→</span
                >
              </div>
            </button>

            <!-- Tarjeta 4 -->
            <button
              onclick="selectRoute('ruta-empleabilidad')"
              class="group relative p-4 rounded-xl bg-white border border-gray-200 hover:border-emerald-600 hover:shadow-md transition-all flex flex-col justify-between text-left cursor-pointer"
            >
              <div>
                <div
                  class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl mb-3 group-hover:scale-105 transition-transform"
                >
                  💼
                </div>
                <h3
                  class="font-bold text-sm text-deep group-hover:text-emerald-600 transition-colors mb-1.5"
                >
                  Necesito mejorar mi carrera
                </h3>
                <p class="text-xs text-gray-500 leading-snug">
                  Usa IA para mejorar tu CV, posicionamiento profesional,
                  búsqueda de empleo y plan de carrera.
                </p>
              </div>
              <div
                class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-emerald-600 font-bold"
              >
                <span>Mejorar mi CV</span>
                <span class="group-hover:translate-x-1 transition-transform"
                  >→</span
                >
              </div>
            </button>

            <!-- Tarjeta 5 -->
            <button
              onclick="selectRoute('ruta-visual')"
              class="group relative p-4 rounded-xl bg-white border border-gray-200 hover:border-teal hover:shadow-md transition-all flex flex-col justify-between text-left cursor-pointer"
            >
              <div>
                <div
                  class="w-10 h-10 rounded-lg bg-teal/10 text-teal flex items-center justify-center text-xl mb-3 group-hover:scale-105 transition-transform"
                >
                  📷
                </div>
                <h3
                  class="font-bold text-sm text-deep group-hover:text-teal transition-colors mb-1.5"
                >
                  Crear imágenes y videos
                </h3>
                <p class="text-xs text-gray-500 leading-snug">
                  Crea, transforma y edita imágenes y videos con IA usando
                  comandos sencillos.
                </p>
              </div>
              <div
                class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-teal font-bold"
              >
                <span>Crear algo</span>
                <span class="group-hover:translate-x-1 transition-transform"
                  >→</span
                >
              </div>
            </button>
          </div>
        </div>

        <!-- 3. CAMINO 2: RESOLVERLO CONTIGO -->
        <div
          class="p-6 md:p-8 rounded-2xl bg-[#0F172A] border border-slate-800 text-white shadow-md flex flex-col md:flex-row md:items-center justify-between gap-6"
        >
          <div class="flex items-start gap-4 max-w-2xl">
            <div
              class="w-11 h-11 rounded-xl bg-slate-800/90 text-teal-300 border border-slate-700/80 flex items-center justify-center text-xl shrink-0"
            >
              ☕
            </div>
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <span
                  class="text-[11px] font-bold uppercase tracking-wider text-teal-300 font-mono"
                  >QUIERO RESOLVERLO CONTIGO</span
                >
                <span class="text-slate-600">•</span>
                <span
                  class="text-[11px] px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700 font-mono"
                  >Café de Estrategia • 30 min • 1:1</span
                >
              </div>
              <h3 class="text-xl font-bold text-white tracking-tight mb-1">
                Tengo un problema concreto
              </h3>
              <p class="text-sm text-slate-300 leading-relaxed">
                No necesito otro recurso. Necesito aterrizar mi problema y
                decidir qué hacer.
              </p>
            </div>
          </div>
          <div class="shrink-0 flex sm:self-center">
            <a
              href={LINKS.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-all shadow-sm"
            >
              <span>☕ Agendar Café de Estrategia</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. TERMÓMETRO IA (TERCERA VÍA PARA INDECISOS) -->
    <section
      class="bg-gradient-to-r from-teal/5 via-teal/10 to-emerald-50 rounded-2xl p-6 md:p-8 border border-teal/20 relative overflow-hidden shadow-2xs"
      id="termometro-banner"
    >
      <div
        class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6"
      >
        <div class="flex items-start gap-4 max-w-2xl">
          <div
            class="w-10 h-10 rounded-xl bg-white border border-teal/20 text-teal flex items-center justify-center shrink-0 shadow-2xs text-lg"
          >
            🌡️
          </div>
          <div>
            <h3
              class="text-lg md:text-xl text-deep tracking-tight mb-1 font-bold"
            >
              ¿No sabes cuál camino elegir?
            </h3>
            <p class="text-xs md:text-sm text-gray-600 leading-relaxed mb-2">
              Responde 9 preguntas y descubre qué podrías resolver con IA hoy.
            </p>
            <div
              class="flex flex-wrap items-center gap-y-1 gap-x-3 text-[11px] text-gray-500 font-mono"
            >
              <span class="flex items-center gap-1.5"
                ><span class="w-1.5 h-1.5 rounded-full bg-teal"></span> 2 minutos</span
              >
              <span>•</span>
              <span class="flex items-center gap-1.5"
                ><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 100%
                gratis</span
              >
              <span>•</span>
              <span class="flex items-center gap-1.5"
                ><span class="w-1.5 h-1.5 rounded-full bg-orange"></span> Recomendación
                personalizada</span
              >
            </div>
          </div>
        </div>
        <div
          class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full lg:w-auto shrink-0"
        >
          <button
            onclick="document.getElementById('selector-overlay')?.classList.remove('hidden')"
            class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl bg-teal text-white font-bold text-xs hover:bg-teal/90 transition-all shadow-2xs cursor-pointer text-center"
          >
            <span>Descubrir mi ruta</span>
            <span>→</span>
          </button>
          <a
            href={LINKS.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl bg-white border border-gray-200 text-deep font-bold text-xs hover:bg-gray-50 transition-all text-center"
          >
            <span>💬 Hablar conmigo</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 5. SECCIÓN RUTAS MAESTRAS -->
    <section class="space-y-6 pt-4" id="rutas-maestras">
      <div
        class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-3 border-b border-gray-200"
      >
        <div>
          <h2 class="text-2xl font-bold text-deep tracking-tight mb-1">
            Elige una ruta
          </h2>
          <p class="text-xs text-gray-500">
            Empieza con el recurso gratuito. Si necesitas más velocidad, el
            método completo o acompañamiento, avanza en los siguientes pasos.
          </p>
        </div>

        <!-- Pestañas/Filtros simples -->
        <div
          class="inline-flex p-1 bg-gray-200/60 rounded-xl border border-gray-200/80 self-start sm:self-auto overflow-x-auto max-w-full shrink-0"
        >
          <button
            id="tab-all"
            onclick="filterRoutes('all')"
            class="route-tab px-3 py-1.5 rounded-lg text-xs font-bold text-teal bg-white shadow-2xs transition-colors whitespace-nowrap cursor-pointer"
          >
            Todas las rutas
          </button>
          <button
            id="tab-ruta-comunicacion"
            onclick="filterRoutes('ruta-comunicacion')"
            class="route-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:text-deep transition-colors whitespace-nowrap cursor-pointer"
          >
            Presentaciones
          </button>
          <button
            id="tab-ruta-notebooklm"
            onclick="filterRoutes('ruta-notebooklm')"
            class="route-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:text-deep transition-colors whitespace-nowrap cursor-pointer"
          >
            Información
          </button>
          <button
            id="tab-ruta-pm"
            onclick="filterRoutes('ruta-pm')"
            class="route-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:text-deep transition-colors whitespace-nowrap cursor-pointer"
          >
            Product Management
          </button>
          <button
            id="tab-ruta-empleabilidad"
            onclick="filterRoutes('ruta-empleabilidad')"
            class="route-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:text-deep transition-colors whitespace-nowrap cursor-pointer"
          >
            Carrera
          </button>
          <button
            id="tab-ruta-visual"
            onclick="filterRoutes('ruta-visual')"
            class="route-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:text-deep transition-colors whitespace-nowrap cursor-pointer"
          >
            Imágenes y videos
          </button>
        </div>
      </div>

      <!-- 6. ESTRUCTURA DE LAS 4 RUTAS -->
      <div class="flex flex-col gap-10" id="routes-wrapper">
        <!-- ========================================================= -->
        <!-- RUTA 01: PRESENTACIONES                                  -->
        <!-- ========================================================= -->
        <article
          class="route-master-card bg-white rounded-2xl border border-gray-200 shadow-2xs overflow-hidden p-6 md:p-8 space-y-6 transition-all"
          data-route="ruta-comunicacion"
          id="ruta-comunicacion"
        >
          <div>
            <span
              class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded bg-teal/10 text-teal font-mono"
              >Ruta 01 • Presentaciones</span
            >
            <h3
              class="text-xl md:text-2xl font-extrabold text-deep tracking-tight mt-1"
            >
              De información desordenada a presentación ejecutiva lista
            </h3>
          </div>

          <!-- PASO 1 DOMINANTE -->
          <div
            class="bg-teal/5 rounded-xl border-2 border-teal/40 p-5 md:p-6 shadow-2xs"
          >
            <div
              class="flex flex-col md:flex-row md:items-center justify-between gap-4"
            >
              <div class="max-w-2xl">
                <span
                  class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] bg-emerald-100 text-emerald-800 font-bold mb-2 font-mono"
                >
                  Empieza aquí • Gratis
                </span>
                <h4 class="text-lg md:text-xl text-deep font-bold">
                  Presentaciones con IA en 30 minutos
                </h4>
                <p class="text-xs text-gray-600 mt-1 leading-relaxed">
                  Aprende a estructurar una presentación clara en 4 pasos y usa
                  prompts prácticos para empezar.
                </p>
              </div>
              <a
                href="/presentaciones-con-ia"
                class="inline-flex items-center justify-center gap-1.5 px-5 py-3 rounded-xl bg-teal text-white font-bold text-xs hover:bg-teal/90 transition-all shrink-0 shadow-2xs"
              >
                <span>Empezar gratis</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- DIVISOR SUTIL -->
          <div class="flex items-center gap-3">
            <span
              class="text-[10px] text-gray-400 font-bold uppercase tracking-wider font-mono"
              >SI NECESITAS OTRA FORMA DE RESOLVERLO:</span
            >
            <div class="h-px bg-gray-100 flex-1"></div>
          </div>

          <!-- 3 COLUMNAS COMPLEMENTARIAS -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-stretch">
            <div
              class="p-4 rounded-xl bg-gray-50 border border-gray-200/80 flex flex-col justify-between space-y-4"
            >
              <div>
                <div class="flex items-center justify-between gap-1 mb-2">
                  <span class="text-[10px] text-gray-500 font-medium"
                    >Más rápido • Herramienta</span
                  >
                  <span
                    class="text-[10px] px-2 py-0.5 rounded bg-amber-100 text-amber-900 font-bold font-mono"
                    >$8 USD</span
                  >
                </div>
                <h5 class="text-sm text-deep font-bold mb-1">
                  Bot Asistente de Presentaciones
                </h5>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Asistente IA que te guía para estructurar tu presentación y
                  avanzar slide a slide.
                </p>
              </div>
              <a
                href="/bot-presentaciones"
                class="inline-flex items-center justify-center gap-1 w-full py-2 rounded-lg bg-white border border-gray-200 text-deep font-bold text-xs hover:bg-gray-100 transition-colors"
              >
                <span>Probar Bot</span>
                <span>→</span>
              </a>
            </div>

            <div
              class="p-4 rounded-xl bg-gray-50 border border-gray-200/80 flex flex-col justify-between space-y-4"
            >
              <div>
                <div class="flex items-center justify-between gap-1 mb-2">
                  <span class="text-[10px] text-gray-500 font-medium"
                    >Aprende el método • Curso</span
                  >
                  <span
                    class="text-[10px] px-2 py-0.5 rounded bg-teal/10 text-teal font-bold font-mono"
                    >$35 USD</span
                  >
                </div>
                <h5 class="text-sm text-deep font-bold mb-1">
                  Curso Presentaciones con IA
                </h5>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Aprende el método completo para organizar, analizar,
                  sintetizar, validar y presentar información.
                </p>
              </div>
              <a
                href="/curso-presentaciones"
                class="inline-flex items-center justify-center gap-1 w-full py-2 rounded-lg bg-white border border-gray-200 text-deep font-bold text-xs hover:bg-gray-100 transition-colors"
              >
                <span>Ver curso</span>
                <span>→</span>
              </a>
            </div>

            <div
              class="p-4 rounded-xl bg-gray-50 border border-gray-200/80 flex flex-col justify-between space-y-4"
            >
              <div>
                <div class="flex items-center justify-between gap-1 mb-2">
                  <span class="text-[10px] text-gray-500 font-medium"
                    >Trabajarlo conmigo • 1:1</span
                  >
                  <span
                    class="text-[10px] px-2 py-0.5 rounded bg-slate-200 text-slate-800 font-bold font-mono"
                    >30 min</span
                  >
                </div>
                <h5 class="text-sm text-deep font-bold mb-1">
                  Café de Estrategia
                </h5>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Trabajamos directamente sobre tu presentación, estructura o
                  problema de comunicación.
                </p>
              </div>
              <a
                href={LINKS.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1 w-full py-2 rounded-lg bg-emerald-600 text-white font-bold text-xs hover:bg-emerald-500 transition-colors"
              >
                <span>Trabajarlo conmigo</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </article>

        <!-- ========================================================= -->
        <!-- RUTA 02: INFORMACIÓN & SÍNTESIS                           -->
        <!-- ========================================================= -->
        <article
          class="route-master-card bg-white rounded-2xl border border-gray-200 shadow-2xs overflow-hidden p-6 md:p-8 space-y-6 transition-all"
          data-route="ruta-notebooklm"
          id="ruta-notebooklm"
        >
          <div>
            <span
              class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded bg-indigo-100 text-indigo-800 font-mono"
              >Ruta 02 • Información & Síntesis</span
            >
            <h3
              class="text-xl md:text-2xl font-extrabold text-deep tracking-tight mt-1"
            >
              De documentos y audios densos a trabajo y síntesis útil
            </h3>
          </div>

          <!-- PASO 1 DOMINANTE -->
          <div
            class="bg-indigo-50/60 rounded-xl border-2 border-indigo-200 p-5 md:p-6 shadow-2xs"
          >
            <div
              class="flex flex-col md:flex-row md:items-center justify-between gap-4"
            >
