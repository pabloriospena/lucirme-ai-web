---
import Layout from '../../layouts/Layout.astro';
import ActionHub from '../../components/ActionHub.astro';
---

<Layout title="Prompteador de Tareas | LuciRMe AI">
  <main class="py-12 px-4 max-w-4xl mx-auto">
    <header class="text-center mb-12">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">🛠️ Prompteador de Tareas</h1>
      <p class="text-gray-600">Configura tu tarea, genera un prompt estructurado y pégalo en tu IA favorita.</p>
    </header>

    <section class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm space-y-6">
      <form id="promptForm" class="space-y-6">
        <!-- ROL -->
        <fieldset class="grid gap-4">
          <div>
            <label class="block text-xs font-bold text-blue-600 uppercase mb-2">[ROL] Actúa como...</label>
            <input type="text" id="rol" required placeholder="Ej: ingeniero geotécnico senior especializado en estabilidad de taludes y normativa NSR-10" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500 transition">
          </div>
        </fieldset>

        <!-- CONTEXTO -->
        <fieldset class="pt-6 border-t border-gray-100">
          <div>
            <label class="block text-xs font-bold text-gray-500 uppercase mb-2">[CONTEXTO] Tu tarea:</label>
            <textarea id="contexto" rows="2" required placeholder="Ej: Revisar un informe de estabilidad de talud para proyecto hidroeléctrico ubicado en zona de alta sismicidad. El informe contiene datos de campo y laboratorio que requieren validación normativa y de supuestos de modelación." class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500 resize-none transition"></textarea>
          </div>
        </fieldset>

        <!-- OBJETIVO -->
        <fieldset class="pt-6 border-t border-gray-100">
          <div>
            <label class="block text-xs font-bold text-gray-500 uppercase mb-2">[OBJETIVO] Específicamente, debes:</label>
            <textarea id="objetivo" rows="3" required placeholder="Ej: Identificar omisiones normativas (NSR-10)...&#10;Validar supuestos de modelación y parámetros geotécnicos...&#10;Mejorar redacción técnica para stakeholders no especializados..." class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500 resize-none transition"></textarea>
          </div>
        </fieldset>

        <!-- FORMATO -->
        <fieldset class="pt-6 border-t border-gray-100">
          <div>
            <label class="block text-xs font-bold text-gray-500 uppercase mb-2">[FORMATO] Formato de entrega:</label>
            <textarea id="formato" rows="3" required placeholder="Ej: Presenta la respuesta como tabla con columnas: Categoría | Observación | Referencia NSR-10 o sugerencia.&#10;Al final, añade un resumen ejecutivo de máximo 3 líneas destacando hallazgos críticos." class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500 resize-none transition"></textarea>
          </div>
        </fieldset>

        <button type="button" id="generateBtn" class="w-full bg-blue-600 text-white font-bold py-4 rounded-xl hover:bg-blue-700 transition shadow-lg active:scale-[0.98]">✨ Generar Prompt Estructurado</button>
      </form>
    </section>

    <!-- Output -->
    <section id="output-section" class="hidden mt-8 bg-white p-8 rounded-2xl border border-gray-200 space-y-6">
      <h2 class="text-xl font-bold text-gray-900">📋 Tu Prompt Generado</h2>
      <pre id="promptOutput" class="w-full bg-gray-50 p-6 rounded-xl text-sm font-mono text-gray-800 border border-gray-200 whitespace-pre-wrap leading-relaxed"></pre>
      <button id="copyBtn" class="w-full bg-gray-800 text-white font-bold py-4 rounded-lg hover:bg-gray-900 transition">📋 Copiar Prompt</button>
    </section>
    
    <ActionHub />
  </main>

  <script is:inline>
    document.getElementById('generateBtn').addEventListener('click', () => {
      const v = (id) => document.getElementById(id)?.value.trim();
      
      const rol = v('rol');
      const contexto = v('contexto');
      const objetivo = v('objetivo');
      const formato = v('formato');

      if (!rol || !contexto || !objetivo || !formato) {
        alert('Por favor completa todos los campos para generar el prompt.');
        return;
      }

      // Estructura exacta solicitada
      const prompt = `Actúa como ${rol}.

Tu tarea:
${contexto}

Específicamente, debes:
${objetivo}

Formato de entrega:
${formato}`;

      document.getElementById('promptOutput').textContent = prompt;
      document.getElementById('output-section').classList.remove('hidden');
      document.getElementById('output-section').scrollIntoView({ behavior: 'smooth' });
    });

    document.getElementById('copyBtn').addEventListener('click', async () => {
      const text = document.getElementById('promptOutput').textContent;
      try {
        await navigator.clipboard.writeText(text);
        const btn = document.getElementById('copyBtn');
        const original = btn.textContent;
        btn.textContent = '✅ ¡Copiado al portapapeles!';
        btn.classList.remove('bg-gray-800', 'hover:bg-gray-900');
        btn.classList.add('bg-green-600', 'hover:bg-green-700');
        
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('bg-green-600', 'hover:bg-green-700');
          btn.classList.add('bg-gray-800', 'hover:bg-gray-900');
        }, 2000);
      } catch (err) {
        alert('No se pudo copiar automáticamente. Selecciona el texto manualmente.');
      }
    });
  </script>
</Layout>