---
import Layout from '../../layouts/Layout.astro';
import ActionHub from '../../components/ActionHub.astro';
import { LINKS } from '../../lib/constants.js';

const auth = (Astro.locals as any).auth;
const userId = typeof auth === 'function' ? auth().userId : auth?.userId;

if (!userId) {
 return Astro.redirect(`/sign-in?redirect_url=${encodeURIComponent('/recursos/prompteador')}`);
}
---

<Layout title="Prompteador de Tareas | LuciRMe AI">
  <!-- BREADCRUMB -->
  <nav class="bg-white border-b border-gray-100 px-4 py-3">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <a href="/recursos" class="text-sm font-bold text-gray-400 hover:text-teal transition">← Volver a Recursos</a>
      <span class="text-xs font-bold text-teal uppercase tracking-widest flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span> Evaluador de IA
      </span>
    </div>
  </nav>

  <!-- BANNER CAFÉ GRATIS -->
  <div class="bg-gradient-to-r from-teal to-tealHover text-white px-4 py-3 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-center gap-3">
      <span class="text-2xl">☕</span>
      <div class="text-sm sm:text-base">
        <strong>¿Tienes dudas sobre los resultados?</strong> Agenda un café virtual de 30 minutos y te ayudo a priorizar tus tareas.
      </div>
      <a href={LINKS.calendly} target="_blank" class="bg-white text-teal px-4 py-2 rounded-lg font-bold text-sm hover:bg-gray-100 transition whitespace-nowrap">
        Agendar café gratis →
      </a>
    </div>
    <button id="close-cafe-banner" class="absolute top-2 right-2 text-white/80 hover:text-white text-xl">×</button>
  </div>

  <main class="py-12 px-4 max-w-4xl mx-auto">
    <header class="text-center mb-12">
      <h1 class="text-3xl font-bold text-deep mb-4">🛠️ Prompteador de Tareas</h1>
      <p class="text-gray-600">Configura tu tarea, genera un prompt estructurado y pégalo en tu IA favorita.</p>
    </header>

    <section class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm space-y-6">
      <form id="promptForm" class="space-y-6">
        <!-- ROL -->
        <fieldset class="grid gap-4">
          <div>
            <label class="block text-xs font-bold text-teal uppercase mb-2">[ROL] Actúa como...</label>
            <input type="text" id="rol" required placeholder="Ej: ingeniero geotécnico senior especializado en estabilidad de taludes y normativa NSR-10" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-teal transition">
          </div>
        </fieldset>

        <!-- CONTEXTO -->
        <fieldset class="pt-6 border-t border-gray-100">
          <div>
            <label class="block text-xs font-bold text-gray-500 uppercase mb-2">[CONTEXTO] Tu tarea:</label>
            <textarea id="contexto" rows="2" required placeholder="Ej: Revisar un informe de estabilidad de talud para proyecto..." class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-teal resize-none transition"></textarea>
          </div>
        </fieldset>

        <!-- OBJETIVO -->
        <fieldset class="pt-6 border-t border-gray-100">
          <div>
            <label class="block text-xs font-bold text-gray-500 uppercase mb-2">[OBJETIVO] Específicamente, debes:</label>
            <textarea id="objetivo" rows="3" required placeholder="Ej: Identificar omisiones normativas..." class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-teal resize-none transition"></textarea>
          </div>
        </fieldset>

        <!-- FORMATO -->
        <fieldset class="pt-6 border-t border-gray-100">
          <div>
            <label class="block text-xs font-bold text-gray-500 uppercase mb-2">[FORMATO] Formato de entrega:</label>
            <textarea id="formato" rows="3" required placeholder="Ej: Presenta la respuesta como tabla..." class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-teal resize-none transition"></textarea>
          </div>
        </fieldset>

        <button type="button" id="generateBtn" class="w-full bg-teal text-white font-bold py-4 rounded-xl hover:bg-tealHover transition shadow-lg">✨ Generar Prompt Estructurado</button>
      </form>
    </section>

    <!-- Output -->
    <section id="output-section" class="hidden mt-8 bg-white p-8 rounded-2xl border border-gray-200 space-y-6 animate-fade-in">
      <h2 class="text-xl font-bold text-deep">📋 Tu Prompt Generado</h2>
      <pre id="promptOutput" class="w-full bg-gray-50 p-6 rounded-xl text-sm font-mono text-gray-800 border border-gray-200 whitespace-pre-wrap leading-relaxed"></pre>
      <button id="copyBtn" class="w-full bg-orange text-white font-bold py-4 rounded-lg hover:bg-orange/90 transition">📋 Copiar Prompt</button>
    </section>
    
    <ActionHub />
  </main>

  <script is:inline>
    document.getElementById('generateBtn').addEventListener('click', async () => {
      const btn = document.getElementById('generateBtn');
      const originalText = btn.textContent;
      btn.textContent = '⏳ Optimizando con IA...';
      btn.disabled = true;

      // CORRECCIÓN CLAVE: Mapeamos los IDs reales en español que tienes en tu HTML
      const payload = {
        role: document.getElementById('rol')?.value.trim() || 'Cualquier especialista',
        context: document.getElementById('contexto')?.value.trim() || 'Flexible',
        goal: document.getElementById('objetivo')?.value.trim() || 'Automatización',
        format: document.getElementById('formato')?.value.trim() || 'Markdown'
      };

      try {
        const response = await fetch('/api/optimizar-prompt', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!response.ok) throw new Error();
        const data = await response.json();

        const output = document.getElementById('promptOutput');
        if (output) {
          output.textContent = data.prompt;
          document.getElementById('output-section')?.classList.remove('hidden');
          document.getElementById('output-section')?.scrollIntoView({ behavior: 'smooth' });
        }

      } catch (err) {
        alert('Error al generar el prompt. Inténtalo de nuevo.');
      } finally {
        btn.textContent = originalText;
        btn.disabled = false;
      }
    });

    document.getElementById('copyBtn').addEventListener('click', async () => {
      const text = document.getElementById('promptOutput').textContent;
      try {
        await navigator.clipboard.writeText(text);
        const btn = document.getElementById('copyBtn');
        const original = btn.textContent;
        btn.textContent = '✅ ¡Copiado al portapapeles!';
        
        setTimeout(() => {
          btn.textContent = original;
        }, 2000);
      } catch (err) {
        alert('No se pudo copiar automáticamente.');
      }
    });
  </script>
</Layout>