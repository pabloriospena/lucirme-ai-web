---
// Prompteador con la plantilla de herramienta interactiva (Web v2).
// Cambio frente a la versión anterior: un solo campo principal y uno opcional, en lugar de cuatro campos.
// La API /api/optimizar-prompt sigue igual (role, context, goal, format); los vacíos se llenan aquí.
import LayoutV2 from "../../layouts/LayoutV2.astro";
import MuroCorreo from "../../components/v2/MuroCorreo.astro";
import PlantillaHerramienta from "../../components/v2/PlantillaHerramienta.astro";

const campo = "w-full rounded-xl border-[0.8px] border-v2-control bg-v2-fondo px-4 py-3 text-base text-v2-texto aria-[invalid=true]:border-v2-error";
---

<LayoutV2 title="Prompteador de tareas | LuciRMe AI" description="Cuéntale tu tarea y recibe un prompt estructurado para pegarlo en tu IA favorita.">
  <div class="w-full bg-v2-fondo">
    <div class="mx-auto flex w-full max-w-[1120px] flex-col gap-8 px-5 py-10 sm:px-8 sm:py-14">
      <header class="mx-auto flex w-full max-w-[560px] flex-col gap-3">
        <a href="/recursos" class="text-sm font-semibold text-v2-accion underline">Volver a recursos</a>
        <div class="flex flex-wrap gap-2">
          <span class="rounded-full bg-v2-superficie px-3 py-1 text-xs font-bold text-v2-accion">Herramienta</span>
          <span class="rounded-full bg-v2-superficie px-3 py-1 text-xs font-bold text-v2-accion">Gratis</span>
        </div>
        <h1 class="text-[32px] font-extrabold leading-tight text-v2-texto sm:text-[40px]">Prompteador de tareas</h1>
        <p class="text-base leading-6 text-v2-cuerpo">Cuéntanos qué necesitas y te armamos un prompt estructurado para pegarlo en tu IA favorita.</p>
      </header>

      <MuroCorreo recurso="Prompteador de tareas" titulo="Abre el Prompteador" texto="Escribe tu correo y usas la herramienta ahora. Es gratis y sin contraseña." boton="Abrir la herramienta">
        <PlantillaHerramienta nombre="Prompteador" etiquetaResultado="Tu prompt">
          <div class="flex flex-col gap-2">
            <label for="p-tarea" class="text-sm font-semibold text-v2-texto">¿Qué quieres que haga la IA?</label>
            <textarea id="p-tarea" required rows="4" placeholder="Ej: revisar un informe y decirme qué le falta antes de enviarlo" class={`${campo} resize-none`}></textarea>
          </div>
          <div class="flex flex-col gap-2">
            <label for="p-rol" class="text-sm font-semibold text-v2-texto">¿Quién debería responder? <span class="font-normal text-v2-suave">(opcional)</span></label>
            <input id="p-rol" type="text" placeholder="Ej: ingeniero senior de proyectos" class={campo} />
          </div>
        </PlantillaHerramienta>
      </MuroCorreo>
    </div>
  </div>
</LayoutV2>

<script is:inline>
  (function () {
    var host = document.querySelector('[data-herramienta][data-nombre="Prompteador"]');
    if (!host) return;
    host.generar = function (signal) {
      var tarea = document.getElementById('p-tarea').value.trim();
      var rol = document.getElementById('p-rol').value.trim();
      return fetch('/api/optimizar-prompt', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        signal: signal,
        body: JSON.stringify({
          role: rol || 'Cualquier especialista',
          context: tarea,
          goal: tarea,
          format: 'Texto estructurado en Markdown con encabezados claros.'
        })
      }).then(function (r) {
        if (!r.ok) throw new Error('fallo');
        return r.json();
      }).then(function (d) {
        if (!d || !d.prompt) throw new Error('vacio');
        return d.prompt;
      });
    };
  })();
</script>
