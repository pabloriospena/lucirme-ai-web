---
// Crea tu primera imagen con IA, herramienta gratis con correo (Web v2). Cierra con Atajos Visuales, la guía de pago.
// El texto de los tres comandos es el de la página anterior, archivada en _crear-imagenes-ia-anterior.astro.
import LayoutV2 from "../../layouts/LayoutV2.astro";
import PlantillaGuiaGratis from "../../components/v2/PlantillaGuiaGratis.astro";
import PromptDetalle from "../../components/v2/PromptDetalle.astro";
import { textoPrecio } from "../../data/precios.ts";

const herramientas = [
  { n: "ChatGPT", d: "Sube una foto en el chat y pídele que la transforme con el comando.", url: "https://chatgpt.com" },
  { n: "Gemini", d: "Sube una foto y crea una nueva versión con una instrucción rápida.", url: "https://gemini.google.com" },
  { n: "Google Labs", d: "Explora las herramientas de creación visual disponibles en Google Labs.", url: "https://labs.google" },
];
const pasos = [
  ["Abre", "La herramienta que elegiste."],
  ["Adjunta", "Una foto tuya con buena luz y rostro claro."],
  ["Copia", "Uno de los comandos de abajo con un solo clic."],
  ["Pégalo", "En el cuadro de texto, junto a la foto."],
  ["Genera", "Envía el mensaje y compara las alternativas."],
];
const comandos = [
  { titulo: "/haircut, prueba diferentes cortes de cabello", texto: "/haircut\nAnaliza mi rostro y prueba 4 estilos de corte de cabello que puedan favorecerme.\nMantén mi rostro, identidad, proporciones y características físicas. Cambia únicamente el cabello.\nMuestra las 4 opciones de forma clara para poder compararlas." },
  { titulo: "/outfit, prueba diferentes estilos de ropa", texto: "/outfit\nCrea 4 versiones de esta foto con estilos de vestuario diferentes que puedan favorecerme.\nMantén mi rostro, cuerpo, proporciones e identidad.\nCambia únicamente la ropa y adapta el entorno de forma coherente con cada estilo.\nHaz que los resultados se vean naturales y realistas." },
  { titulo: "/profile, retrato profesional para tu perfil laboral", texto: "/profile\nConvierte esta foto en un retrato profesional para usar en mi perfil laboral.\nMantén exactamente mis rasgos faciales e identidad.\nMejora la iluminación, el encuadre y el fondo.\nUsa un fondo limpio y profesional, iluminación natural y una apariencia realista.\nNo hagas que parezca una foto excesivamente retocada." },
];
const precio = textoPrecio("atajos-visuales");
const h2 = "mt-6 text-[26px] font-bold tracking-[-0.5px] text-v2-texto";
---

<LayoutV2
  title="Crea tu primera imagen con IA | LuciRMe AI"
  description="Abre una herramienta, adjunta una foto y prueba un comando. No necesitas saber prompting."
>
  <PlantillaGuiaGratis
    slug="crear-imagenes-ia"
    titulo="Crea tu primera imagen con IA"
    descripcion="Abre una herramienta, adjunta una foto y prueba un comando. No necesitas saber prompting."
    tema="Imágenes"
    aprendes={[
      "Cómo transformar una foto con IA en 5 minutos, sin saber de prompts.",
      "Tres comandos listos para copiar, /haircut, /outfit y /profile.",
      "La lógica detrás de cualquier comando visual, qué cambiar y qué conservar.",
    ]}
    claveLocal="lucirme_unlocked_crear_imagenes_ia"
    relacionados={[
      { titulo: "Atajos visuales", tipo: "Guía", url: "/atajos-visuales" },
      { titulo: "Atajos de IA", tipo: "Guía", url: "/atajos-ia" },
      { titulo: "Tu CV con IA", tipo: "Herramienta", url: "/recursos/cv-con-ia" },
    ]}
  >
    <section class="flex flex-col gap-4">
      <h2 class={h2}>1. Elige dónde hacerlo</h2>
      <p class="text-v2-cuerpo">No necesitas usar las tres. Elige una y sigue los pasos.</p>
      <ul class="grid gap-3 sm:grid-cols-3">
        {herramientas.map((h) => (
          <li class="flex flex-col gap-2 rounded-2xl border-[0.8px] border-v2-borde bg-v2-fondo p-5">
            <b class="text-base text-v2-texto">{h.n}</b>
            <span class="text-sm leading-5 text-v2-cuerpo">{h.d}</span>
            <a href={h.url} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-v2-accion underline underline-offset-2">Abrir {h.n}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class={h2}>2. Adjunta una foto</h2>
      <ol class="flex flex-col gap-3">
        {pasos.map(([t, d], i) => (
          <li class="flex items-start gap-3 text-v2-cuerpo">
            <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full border-[0.8px] border-v2-marca-borde bg-v2-marca-tinte text-sm font-bold text-v2-marca-texto" aria-hidden="true">{i + 1}</span>
            <span><b class="text-v2-texto">{t}.</b> {d}</span>
          </li>
        ))}
      </ol>
      <p class="rounded-2xl border-[0.8px] border-v2-marca-borde bg-v2-marca-tinte p-5 text-v2-cuerpo">Usa una foto donde se vea claramente la persona u objeto que quieres transformar. Evita las fotos borrosas o con fondos muy saturados.</p>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class={h2}>3. Prueba tu primer comando</h2>
      <p class="text-v2-cuerpo">Están pensados para conservar tus rasgos y darte alternativas realistas. Empieza con el primero, tarda unos 30 segundos. Si funcionó, prueba los otros.</p>
      <div class="flex flex-col gap-3">
        {comandos.map((c) => <PromptDetalle titulo={c.titulo} texto={c.texto} />)}
      </div>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class={h2}>¿Viste lo que acaba de pasar?</h2>
      <p class="text-v2-cuerpo">Elegiste una herramienta, subiste una foto, copiaste un comando y obtuviste un resultado. No necesitaste aprender nada nuevo.</p>
      <p class="text-v2-cuerpo">El slash es solo una forma rápida de organizar una instrucción. Lo importante es decirle a la herramienta qué quieres cambiar y qué quieres conservar.</p>
    </section>

    <section class="flex flex-col gap-3 rounded-3xl border-[0.8px] border-v2-pago-borde bg-v2-pago-fondo p-6 sm:p-8">
      <h2 class="text-[26px] font-bold tracking-[-0.5px] text-v2-texto">¿Quieres más?</h2>
      <p class="text-v2-cuerpo">Puedes usar la misma lógica para crear imágenes de productos, cambiar escenarios, probar estilos, crear contenido para redes y experimentar con video. Atajos visuales reúne 75 comandos listos para copiar, organizados por objetivo.</p>
      <a href="/atajos-visuales" class="inline-flex min-h-[52px] items-center justify-center self-start rounded-full bg-v2-pago-boton px-7 text-base font-bold text-v2-pago-boton-texto">Ver Atajos visuales{precio ? `, ${precio}` : ""}</a>
    </section>
  </PlantillaGuiaGratis>
</LayoutV2>

<script is:inline>
  document.querySelectorAll("button[data-copiar-texto]").forEach(function (b) {
    b.addEventListener("click", function () {
      var et = b.querySelector("[data-etiqueta]");
      var texto = b.getAttribute("data-copiar-texto");
      var listo = function () { et.textContent = "¡Copiado!"; setTimeout(function () { et.textContent = "Copiar prompt"; }, 2000); };
      var falla = function () { et.textContent = "Selecciona el texto y cópialo"; setTimeout(function () { et.textContent = "Copiar prompt"; }, 3000); };
      if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(texto).then(listo, falla);
      else falla();
    });
  });
</script>
