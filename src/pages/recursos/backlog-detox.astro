---
import Layout from '../../layouts/Layout.astro';
import { LINKS } from '../../lib/constants.js';


// 1. Muro de Seguridad: Solo usuarios logueados
//const auth = (Astro.locals as any).auth;
//const userId = typeof auth === 'function' ? auth().userId : auth?.userId;

//if (!userId) {
 // return Astro.redirect(`/sign-in?redirect_url=${encodeURIComponent('/recursos/backlog-detox')}`);
//}
---

<Layout title="Backlog Detox | LuciRMe AI">

  <!-- SUB-NAV (Breadcrumb) -->
  <nav class="bg-white border-b border-gray-100 px-4 py-3">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <a href="/recursos" class="text-sm font-bold text-gray-400 hover:text-teal transition">← Volver a Recursos</a>
      <span class="text-xs font-bold text-teal uppercase tracking-widest flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span> Evaluador de IA
      </span>
    </div>
  </nav>

  <!-- BANNER CAFÉ GRATIS -->
  <div class="bg-gradient-to-r from-teal to-tealHover text-white px-4 py-3 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-center gap-3">
      <span class="text-2xl">☕</span>
      <div class="text-sm sm:text-base">
        <strong>¿Tienes dudas sobre los resultados?</strong> Agenda un café virtual de 30 minutos y te ayudo a priorizar tus tareas.
      </div>
      <a href="https://calendar.app.google/tu-link-cafe" target="_blank" class="bg-white text-teal px-4 py-2 rounded-lg font-bold text-sm hover:bg-gray-100 transition whitespace-nowrap">
        Agendar café gratis →
      </a>
    </div>
    <button id="close-cafe-banner" class="absolute top-2 right-2 text-white/80 hover:text-white text-xl">×</button>
  </div>
      
      <!-- HERO -->
      <div class="text-center mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-deep mb-3">Backlog Detox</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-6">Tu backlog está lleno de ruido. En 2 minutos te muestro qué mover, qué archivar y qué validar.</p>
        <div class="bg-teal/5 border border-teal/20 inline-block px-4 py-2 rounded-lg text-sm text-teal font-medium">
          💡 <strong>Tip:</strong> Pega directamente desde Excel/Sheets. El sistema lo formatea por ti.
        </div>
      </div>

      <!-- CUADRÍCULA (APP) -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-6">
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse min-w-[800px]">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-4 py-4 text-left font-bold text-deep w-1/4">Definición / Nombre</th>
                <th class="px-3 py-4 text-left font-bold text-deep">Métricas<br><span class="text-xs font-normal text-gray-500">(selecciona múltiples)</span></th>
                <th class="px-3 py-4 text-left font-bold text-deep">Tamaño</th>
                <th class="px-3 py-4 text-left font-bold text-deep">Impacto</th>
                <th class="px-3 py-4 text-left font-bold text-deep">Validación<br><span class="text-xs font-normal text-gray-500">(selecciona múltiples)</span></th>
                <th class="px-2 py-4 w-10"></th>
              </tr>
            </thead>
            <tbody id="table-body" class="divide-y divide-gray-100">
              <!-- Filas generadas por JS -->
            </tbody>
          </table>
        </div>

        <!-- CONTROLES -->
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 px-6 py-4 bg-gray-50 border-t border-gray-200">
          <div class="flex items-center gap-4">
            <button id="add-row-btn" class="text-sm text-teal font-bold hover:text-tealHover flex items-center gap-1 transition">+ Agregar fila</button>
            <button id="clear-btn" class="text-sm text-gray-400 hover:text-red-500 font-bold transition">Limpiar todo</button>
          </div>
          <div class="flex items-center gap-4">
            <span id="item-count" class="text-xs font-bold text-gray-400 uppercase tracking-widest">0 ítems</span>
            <button id="prioritize-btn" class="bg-deep hover:bg-teal text-white px-8 py-3 rounded-lg font-bold transition shadow-md disabled:opacity-50 disabled:cursor-not-allowed" disabled>
              Priorizar Backlog
            </button>
          </div>
        </div>
      </div>

      <!-- BANNER LÍMITE -->
      <div id="soft-limit-banner" class="hidden mb-6 p-4 bg-orange/10 border border-orange/20 rounded-lg text-sm font-medium text-orange text-center">
        💡 Consejo de Producto: Prioriza en lotes de 10-15 ítems para mantener la claridad.
      </div>

      <!-- RESULTADOS -->
      <div id="results-section" class="hidden space-y-8 mt-16 animate-fade-in">
        <h2 class="text-3xl font-bold text-deep text-center">Tu Backlog Clasificado</h2>
        
        <div class="grid lg:grid-cols-3 gap-6">
          <!-- HACER YA -->
          <div class="bg-white border-2 border-emerald-500 p-6 rounded-xl shadow-sm">
            <h3 class="font-bold text-emerald-700 text-lg mb-4 flex items-center gap-2">✅ Hacer Ya</h3>
            <div id="list-do" class="space-y-4"></div>
          </div>
          
          <!-- VALIDAR PRIMERO -->
          <div class="bg-white border-2 border-amber-500 p-6 rounded-xl shadow-sm">
            <h3 class="font-bold text-amber-700 text-lg mb-4 flex items-center gap-2">🔍 Validar Primero</h3>
            <div id="list-validate" class="space-y-4"></div>
          </div>
          
          <!-- ARCHIVAR -->
          <div class="bg-white border-2 border-gray-300 p-6 rounded-xl shadow-sm">
            <h3 class="font-bold text-gray-600 text-lg mb-4 flex items-center gap-2">🗃️ Archivar</h3>
            <div id="list-archive" class="space-y-4"></div>
          </div>
        </div>

        <!-- ACCIONES FINALES -->
        <div class="bg-white p-8 rounded-2xl border border-gray-200 text-center shadow-sm mt-8">
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <button id="copy-results-btn" class="bg-gray-100 hover:bg-gray-200 text-deep px-6 py-3 rounded-lg font-bold transition flex items-center justify-center gap-2">
              📋 Copiar resultados
            </button>
            <button id="explain-btn" class="bg-white hover:bg-gray-50 text-deep border-2 border-gray-200 px-6 py-3 rounded-lg font-bold transition flex items-center justify-center gap-2">
              💡 Ver Fórmula
            </button>
            <a href={LINKS.calendly} target="_blank" class="bg-orange hover:bg-orange/90 text-white px-8 py-3 rounded-lg font-bold transition shadow-md flex items-center justify-center">
              ☕ Revisar esto en un Café (15 min)
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- MODAL EXPLICACIÓN FÓRMULAS -->
    <div id="explain-modal" class="hidden fixed inset-0 z-50 items-center justify-center p-4 bg-[#0F172A]/80 backdrop-blur-sm">
      <div class="bg-white p-8 rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto relative animate-fade-in">
        <button id="close-explain-btn" class="absolute top-6 right-6 text-gray-400 hover:text-deep text-2xl transition">✕</button>
        
        <h3 class="text-3xl font-bold text-deep mb-4">La Fórmula Sin Bullshit</h3>
        <p class="text-base text-gray-600 mb-8">Solo lógica de producto basada en impacto, validación y esfuerzo.</p>
        
        <div class="space-y-6">
          <div class="bg-emerald-50 border border-emerald-200 p-5 rounded-xl">
            <h4 class="font-bold text-emerald-800 text-lg mb-2">✅ HACER YA (ROI Inmediato)</h4>
            <ul class="text-sm text-emerald-900 space-y-2 ml-4 list-disc">
              <li>Impacto: <strong>Alto/Crítico</strong></li>
              <li>Validación: <strong>Datos/Recurrente</strong></li>
              <li>Tamaño: <strong>S/M</strong></li>
            </ul>
          </div>

          <div class="bg-amber-50 border border-amber-200 p-5 rounded-xl">
            <h4 class="font-bold text-amber-800 text-lg mb-2">🔍 VALIDAR PRIMERO</h4>
            <ul class="text-sm text-amber-900 space-y-2 ml-4 list-disc">
              <li>Impacto alto PERO validación débil (Intuición)</li>
              <li>Tamaño L/XL (Requiere dividirse)</li>
            </ul>
          </div>

          <div class="bg-gray-50 border border-gray-200 p-5 rounded-xl">
            <h4 class="font-bold text-gray-700 text-lg mb-2">🗃️ ARCHIVAR</h4>
            <ul class="text-sm text-gray-600 space-y-2 ml-4 list-disc">
              <li>Impacto <strong>Bajo</strong> = No mueve la aguja</li>
              <li>Sin validación + Esfuerzo alto = Riesgo puro</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

  </main>

  <script is:inline>
    // === ESTADO TIPADO ===
    let items = [];
    const MAX_SOFT = 15;
    const MAX_HARD = 50;

    // === DOM ELEMENTS ===
    const tbody = document.getElementById('table-body');
    const addRowBtn = document.getElementById('add-row-btn');
    const clearBtn = document.getElementById('clear-btn');
    const prioritizeBtn = document.getElementById('prioritize-btn');
    const itemCount = document.getElementById('item-count');
    const softBanner = document.getElementById('soft-limit-banner');
    const resultsSection = document.getElementById('results-section');
    const listDo = document.getElementById('list-do');
    const listValidate = document.getElementById('list-validate');
    const listArchive = document.getElementById('list-archive');
    const copyBtn = document.getElementById('copy-results-btn');

    // === OPCIONES ===
    const METRICS = ['Activación', 'Retención', 'MRR', 'CAC', 'Soporte'];
    const SIZES = ['S', 'M', 'L', 'XL'];
    const IMPACTS = ['Bajo', 'Medio', 'Alto', 'Crítico'];
    const VALIDATIONS = ['Intuición', '1 cliente', 'Recurrente', 'Datos'];

    // === RENDER TABLE ===
    function renderTable() {
      if (!tbody) return;
      tbody.innerHTML = '';
      
      if (items.length === 0) {
        tbody.innerHTML = `
          <tr class="text-center text-gray-400">
            <td colspan="6" class="py-12 border-b border-dashed border-gray-200">Pega tu tabla de Excel aquí o haz clic en "+ Agregar fila"</td>
          </tr>`;
      } else {
        items.forEach(item => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-gray-50 transition border-b border-gray-100';
          
          const metricsHtml = METRICS.map(m => `
            <label class="inline-flex items-center mr-3 mb-1 cursor-pointer">
              <input type="checkbox" data-field="metric" data-value="${m}" data-id="${item.id}" ${item.metrics.includes(m) ? 'checked' : ''} class="item-checkbox w-4 h-4 text-teal rounded border-gray-300 focus:ring-teal">
              <span class="ml-1.5 text-xs font-medium text-gray-700">${m}</span>
            </label>
          `).join('');
          
          const validationsHtml = VALIDATIONS.map(v => `
            <label class="inline-flex items-center mr-3 mb-1 cursor-pointer">
              <input type="checkbox" data-field="validation" data-value="${v}" data-id="${item.id}" ${item.validations.includes(v) ? 'checked' : ''} class="item-checkbox w-4 h-4 text-teal rounded border-gray-300 focus:ring-teal">
              <span class="ml-1.5 text-xs font-medium text-gray-700">${v}</span>
            </label>
          `).join('');
          
          tr.innerHTML = `
            <td class="p-3"><input type="text" value="${item.name}" data-field="name" data-id="${item.id}" class="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-teal focus:border-transparent outline-none bg-white placeholder-gray-300" placeholder="Nombre de la tarea..."></td>
            <td class="p-3"><div class="flex flex-wrap">${metricsHtml}</div></td>
            <td class="p-3"><select data-field="size" data-id="${item.id}" class="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-teal outline-none bg-white"><option value="">-</option>${SIZES.map(s => `<option value="${s}" ${item.size === s ? 'selected' : ''}>${s}</option>`).join('')}</select></td>
            <td class="p-3"><select data-field="impact" data-id="${item.id}" class="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-teal outline-none bg-white"><option value="">-</option>${IMPACTS.map(i => `<option value="${i}" ${item.impact === i ? 'selected' : ''}>${i}</option>`).join('')}</select></td>
            <td class="p-3"><div class="flex flex-wrap">${validationsHtml}</div></td>
            <td class="p-3 text-center"><button data-remove-id="${item.id}" class="remove-btn text-gray-300 hover:text-red-500 transition text-xl font-bold">✕</button></td>
          `;
          tbody.appendChild(tr);
        });
      }
      updateUI();
    }

    function updateUI() {
      if (!itemCount || !prioritizeBtn) return;
      itemCount.textContent = `${items.length} ítems`;
      prioritizeBtn.disabled = items.length === 0;
      if (softBanner) softBanner.classList.toggle('hidden', items.length <= MAX_SOFT);
    }

    // === LOGIC ===
    function addItem() {
      if (items.length >= MAX_HARD) return alert('Límite máximo: 50 ítems. Prioriza en lotes.');
      items.push({ id: Date.now(), name: '', metrics: [], size: '', impact: '', validations: [] });
      renderTable();
    }

    function removeItem(id) {
      items = items.filter(i => i.id !== id);
      renderTable();
    }

    function updateItem(id, field, value) {
      const item = items.find(i => i.id === id);
      if (!item) return;
      if (['name', 'size', 'impact'].includes(field)) item[field] = value;
      else if (['metric', 'validation'].includes(field)) {
        const arr = field === 'metric' ? item.metrics : item.validations;
        arr.includes(value) ? arr.splice(arr.indexOf(value), 1) : arr.push(value);
      }
    }

    function clearAll() {
      if (items.length === 0) return;
      if (confirm('¿Limpiar toda la tabla?')) {
        items = [];
        renderTable();
        if (resultsSection) resultsSection.classList.add('hidden');
      }
    }

    function handlePaste(e) {
      e.preventDefault();
      const text = e.clipboardData.getData('text/plain');
      if (!text.trim()) return;
      const rows = text.split(/\r?\n/).filter(r => r.trim());
      const newItems = rows.map((row, i) => {
        const delimiter = row.includes('\t') ? '\t' : (row.includes(',') ? ',' : '|');
        const cols = row.split(delimiter).map(c => c.trim());
        return {
          id: Date.now() + i + Math.random(),
          name: cols[0] || '',
          metrics: cols[1] ? cols[1].split(';').map(m => m.trim()).filter(Boolean) : [],
          size: cols[2] || '',
          impact: cols[3] || '',
          validations: cols[4] ? cols[4].split(';').map(v => v.trim()).filter(Boolean) : []
        };
      }).filter(item => item.name);

      if (items.length + newItems.length > MAX_HARD) return alert(`Límite máximo: ${MAX_HARD} ítems.`);
      items = [...items, ...newItems];
      renderTable();
    }

    function classifyItems() {
      if (!listDo || !listValidate || !listArchive) return;
      listDo.innerHTML = ''; listValidate.innerHTML = ''; listArchive.innerHTML = '';

      items.forEach(item => {
        const isHighImpact = ['Alto', 'Crítico'].includes(item.impact);
        const isValidated = item.validations.some(v => ['Recurrente', 'Datos'].includes(v));
        const isSmall = ['S', 'M'].includes(item.size);

        const card = document.createElement('div');
        card.className = 'bg-gray-50 p-4 rounded-lg border border-gray-200 mb-3';
        
        let category, reason;
        
        if (isHighImpact && isValidated && isSmall) {
          category = 'do';
          reason = '<span class="text-emerald-700 font-bold text-xs uppercase tracking-wider bg-emerald-100 px-2 py-1 rounded">ROI Inmediato</span>';
        } else if (item.impact === 'Bajo' || (!isHighImpact && !isValidated)) {
          category = 'archive';
          reason = '<span class="text-gray-600 font-bold text-xs uppercase tracking-wider bg-gray-200 px-2 py-1 rounded">No es prioridad</span>';
        } else {
          category = 'validate';
          reason = '<span class="text-amber-700 font-bold text-xs uppercase tracking-wider bg-amber-100 px-2 py-1 rounded">Requiere Certeza</span>';
        }

        card.innerHTML = `
          <div class="flex justify-between items-start mb-2">
            <h4 class="font-bold text-deep">${item.name || 'Ítem sin nombre'}</h4>
            ${reason}
          </div>
          <div class="text-xs text-gray-500 flex gap-3 mt-2">
            ${item.impact ? `<span>🎯 Imp: <b>${item.impact}</b></span>` : ''}
            ${item.size ? `<span>⏱️ Tam: <b>${item.size}</b></span>` : ''}
            ${item.validations.length ? `<span>🔍 Val: <b>${item.validations.join(', ')}</b></span>` : ''}
          </div>
        `;
        
        if (category === 'do') listDo.appendChild(card);
        else if (category === 'validate') listValidate.appendChild(card);
        else listArchive.appendChild(card);
      });

      if (resultsSection) {
        resultsSection.classList.remove('hidden');
        resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function copyResults() {
      const getListText = (list) => Array.from(list?.querySelectorAll('h4') || []).map(el => `- ${el.textContent}`).join('\n');
      const text = `✅ HACER YA:\n${getListText(listDo) || '(vacío)'}\n\n🔍 VALIDAR PRIMERO:\n${getListText(listValidate) || '(vacío)'}\n\n🗃️ ARCHIVAR:\n${getListText(listArchive) || '(vacío)'}`;
      
      navigator.clipboard.writeText(text).then(() => {
        const original = copyBtn.innerHTML;
        copyBtn.innerHTML = '✅ Copiado con éxito';
        setTimeout(() => copyBtn.innerHTML = original, 2000);
      });
    }

    // MODAL
    const explainBtn = document.getElementById('explain-btn');
    const explainModal = document.getElementById('explain-modal');
    const closeExplainBtn = document.getElementById('close-explain-btn');

    if (explainBtn) explainBtn.addEventListener('click', () => { explainModal.classList.remove('hidden'); explainModal.classList.add('flex'); });
    if (closeExplainBtn) closeExplainBtn.addEventListener('click', () => { explainModal.classList.add('hidden'); explainModal.classList.remove('flex'); });
    
    // EVENTS
    if (addRowBtn) addRowBtn.addEventListener('click', addItem);
    if (clearBtn) clearBtn.addEventListener('click', clearAll);
    if (prioritizeBtn) prioritizeBtn.addEventListener('click', classifyItems);
    if (copyBtn) copyBtn.addEventListener('click', copyResults);
    
    if (tbody) {
      tbody.addEventListener('paste', handlePaste);
      tbody.addEventListener('input', e => {
        const target = e.target;
        if (target.dataset.field) updateItem(Number(target.dataset.id), target.dataset.field, target.value);
      });
      tbody.addEventListener('change', e => {
        const target = e.target;
        if (target.classList.contains('item-checkbox')) updateItem(Number(target.dataset.id), target.dataset.field, target.dataset.value);
      });
      tbody.addEventListener('click', e => {
        const btn = e.target.closest('.remove-btn');
        if (btn) removeItem(Number(btn.dataset.removeId));
      });
    }

    renderTable();
  </script>

  <style>
    .animate-fade-in { animation: fadeIn 0.5s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  </style>

</Layout>