---
// Guía de prompting para PMs, con la plantilla de guía gratis y el muro de correo (Web v2).
// El texto de cada prompt es el de la guía anterior. Los títulos y las explicaciones se reescribieron en tú neutro.
import LayoutV2 from "../../layouts/LayoutV2.astro";
import PlantillaGuiaGratis from "../../components/v2/PlantillaGuiaGratis.astro";

export const PROMPTS_PM = [
  {
    "titulo": "Refina una historia de usuario sin ambigüedad",
    "uso": "Úsalo cuando el equipo de desarrollo te diga que algo no está claro, o para evitar que el alcance crezca sin control.",
    "texto": "Actúa como un Product Manager Senior con enfoque práctico. Necesito escribir una User Story para la siguiente funcionalidad: \"[DESCRIBE LA FUNCIONALIDAD EN 1 ORACIÓN]\".\n\nEl usuario final es: \"[DESCRIBE AL USUARIO]\".\nEl problema real que resuelve es: \"[DESCRIBE EL PROBLEMA, NO LA SOLUCIÓN]\".\n\nGenera la User Story siguiendo este formato exacto:\n1. Título claro y accionable.\n2. Historia de usuario (Como [rol], quiero [acción], para [beneficio]).\n3. Criterios de Aceptación (máximo 4 puntos, usando formato Given/When/Then, enfocados en el resultado, no en la implementación técnica).\n4. Una nota de \"Fuera del Alcance\" (Out of scope) para evitar que el equipo agregue features innecesarios.\n\nTono: Directo, sin buzzwords, listo para Jira."
  },
  {
    "titulo": "Encuentra el problema real detrás de una solicitud",
    "uso": "Úsalo cuando un cliente o un stakeholder te pida una solución específica en lugar de contarte su problema.",
    "texto": "Actúa como un Product Manager con enfoque práctico. Un stakeholder me pidió lo siguiente: \"[PEGA LA SOLICITUD DEL CLIENTE/STAKEHOLDER AQUÍ]\".\n\n1. Analiza y dime cuál crees que es el problema real detrás de esta solicitud (lee entre líneas).\n2. Propón 2 alternativas más simples y escalables que resuelvan ese problema real sin agregar complejidad técnica innecesaria (evita el feature creep).\n3. Redacta una respuesta breve y empática para el stakeholder explicando por qué iremos por la alternativa simple, sin usar jerga técnica y manteniendo un tono de colega senior, calmado y confiado."
  },
  {
    "titulo": "Analiza una métrica que se movió",
    "uso": "Úsalo para encontrar la causa de un cambio en los datos, con foco en ingresos recurrentes, cancelación, valor del cliente o retención.",
    "texto": "Tengo los siguientes datos de mi producto: \"[PEGA AQUÍ TUS DATOS O DESCRIPCIÓN DEL COMPORTAMIENTO, ej: 'El registro subió un 20%, pero la activación bajó un 15%']\".\n\nActúa como un analista de producto pragmático. \n1. Identifica las 3 hipótesis más probables de por qué está pasando esto (enfócate en fricción de usuario, no en suposiciones mágicas).\n2. Para cada hipótesis, dime qué dato o métrica específica necesito buscar para validarla o descartarla.\n3. Propón un experimento o cambio pequeño (MVP del 70%) que podamos lanzar rápido para probar la hipótesis más fuerte."
  },
  {
    "titulo": "Di que no sin quemar puentes",
    "uso": "Úsalo para proteger el roadmap sin quemar puentes con Ventas, la gerencia o un cliente grande.",
    "texto": "Necesito decirle que \"NO\" a una solicitud de [VENTAS / UN CLIENTE GRANDE / EL CEO] sobre: \"[INSERTA LA SOLICITUD]\".\n\nRedacta un mensaje corto (máximo 3 párrafos), profesional y firme.\n- Párrafo 1: Reconoce su necesidad y valida su intención.\n- Párrafo 2: Explica claramente por qué no se alineará con la visión actual del producto o las métricas clave (menciona [METRICA CLAVE]), sin sonar condescendiente.\n- Párrafo 3: Ofrece una alternativa concreta o un momento futuro para revisarlo, sin prometer falsas esperanzas.\n\nTono: Colega senior, calmado, sin urgencia falsa y cero buzzwords."
  }
];

const pasos = [
  { t: "Rol y contexto", d: "Dile a la IA quién es y cuál es la situación." },
  { t: "Tarea específica", d: "Pide una acción concreta, con verbos claros." },
  { t: "Restricciones", d: "Indica longitud, tono y qué debe evitar." },
  { t: "Formato de salida", d: "Elige cómo quieres recibir el resultado, por ejemplo una tabla o una lista." },
];
const checklist = [
  "¿Le di a la IA un rol claro y el contexto necesario del negocio?",
  "¿La tarea es una acción concreta y no una petición vaga?",
  "¿Incluí restricciones de longitud, tono y qué evitar?",
  "¿Dije exactamente en qué formato quiero la respuesta?",
];
const relacionados = [
  { titulo: "Prompteador", tipo: "Herramienta", url: "/recursos/prompteador" },
  { titulo: "Prompts listos para copiar", tipo: "Prompts", url: "/recursos/prompts" },
];
---

<LayoutV2
  title="Guía de prompting para PMs | LuciRMe AI"
  description="Una fórmula para pedir mejor y cuatro prompts para historias de usuario, análisis de métricas y priorización."
>
  <PlantillaGuiaGratis
    slug="checklistpm-vol1"
    titulo="Guía de prompting para PMs"
    descripcion="Una fórmula para pedir mejor y cuatro prompts listos para historias de usuario, problemas reales, métricas y priorización."
    tema="Producto"
    aprendes={["Una fórmula de cuatro partes para que la IA te devuelva algo útil.", "Cómo reemplazar el texto entre corchetes de cada prompt con tu caso.", "Una lista para revisar tu prompt antes de enviarlo."]}
    relacionados={relacionados}
  >
    <h2 class="text-[22px] font-bold text-v2-texto">La fórmula del prompt</h2>
    <p class="text-v2-cuerpo">Un buen prompt devuelve tiempo, claridad o control. Para lograrlo, dale a la IA la estructura que necesita.</p>
    <ol class="grid gap-3 sm:grid-cols-2">
      {pasos.map((p, i) => (
        <li class="rounded-2xl border-[0.8px] border-v2-borde bg-v2-superficie p-4">
          <p class="text-sm font-bold text-v2-accion">{i + 1}. {p.t}</p>
          <p class="mt-1 text-sm leading-5 text-v2-cuerpo">{p.d}</p>
        </li>
      ))}
    </ol>

    <h2 class="mt-4 text-[22px] font-bold text-v2-texto">Prompts listos para copiar</h2>
    <p class="text-v2-cuerpo">Abre cada uno, copia el texto y reemplaza lo que está entre corchetes con tu caso.</p>
    <div class="flex flex-col gap-3">
      {PROMPTS_PM.map((p) => (
        <details class="group rounded-2xl border-[0.8px] border-v2-borde bg-v2-fondo">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-3 px-5 py-3 text-base font-bold text-v2-texto">
            {p.titulo}
            <span aria-hidden="true" class="text-xl font-light text-v2-accion transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="flex flex-col gap-3 border-t-[0.8px] border-v2-borde p-5">
            <p class="text-sm leading-5 text-v2-cuerpo">{p.uso}</p>
            <pre class="whitespace-pre-wrap rounded-xl border-[0.8px] border-v2-borde bg-v2-superficie p-4 text-sm leading-5 text-v2-texto select-all" tabindex="0">{p.texto}</pre>
            <div>
              <button type="button" data-copiar-texto={p.texto} class="inline-flex h-11 cursor-pointer items-center rounded-full border-[0.8px] border-v2-control bg-v2-fondo px-4 text-sm font-bold text-v2-accion">
                <span data-etiqueta>Copiar prompt</span><span class="sr-only">: {p.titulo}</span>
              </button>
            </div>
          </div>
        </details>
      ))}
    </div>

    <h2 class="mt-4 text-[22px] font-bold text-v2-texto">Antes de enviar tu prompt</h2>
    <ul class="flex flex-col gap-2">
      {checklist.map((c, i) => (
        <li>
          <label class="flex min-h-11 cursor-pointer items-start gap-3 rounded-xl border-[0.8px] border-v2-borde bg-v2-superficie p-3 text-sm leading-5 text-v2-texto">
            <input type="checkbox" class="mt-0.5 h-5 w-5 flex-none cursor-pointer accent-[#00786f]" />
            <span>{c}</span>
          </label>
        </li>
      ))}
    </ul>
  </PlantillaGuiaGratis>
</LayoutV2>

<script is:inline>
  document.querySelectorAll("button[data-copiar-texto]").forEach(function (b) {
    b.addEventListener("click", function () {
      var et = b.querySelector("[data-etiqueta]");
      var texto = b.getAttribute("data-copiar-texto");
      var listo = function () { et.textContent = "¡Copiado!"; setTimeout(function () { et.textContent = "Copiar prompt"; }, 2000); };
      var falla = function () { et.textContent = "Selecciona el texto y cópialo"; setTimeout(function () { et.textContent = "Copiar prompt"; }, 3000); };
      if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(texto).then(listo, falla);
      else falla();
    });
  });
</script>
