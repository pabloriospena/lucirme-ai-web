<script is:inline>
  function copyCommand(button, elementId) {
    const textElement = document.getElementById(elementId);
    if (!textElement) return;

    const textToCopy = textElement.innerText;
    
    navigator.clipboard.writeText(textToCopy).then(() => {
      const label = button.querySelector('.btn-label');
      const originalText = label ? label.innerText : 'Copiar';
      
      if (label) label.innerText = '¡Copiado!';
      button.classList.add('bg-emerald-600', 'text-white');
      
      // Toast notification
      const toast = document.getElementById('copy-toast');
      if (toast) {
        toast.classList.remove('translate-y-16', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
      }
      
      setTimeout(() => {
        if (label) label.innerText = originalText;
        button.classList.remove('bg-emerald-600', 'text-white');
      }, 2000);

      setTimeout(() => {
        if (toast) {
          toast.classList.add('translate-y-16', 'opacity-0');
          toast.classList.remove('translate-y-0', 'opacity-100');
        }
      }, 3000);
    }).catch(err => {
      console.error('Error al copiar:', err);
    });
  }
</script>
