---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Roadmap Builder | LuciRMe AI">
  <!-- SUB-NAV (Breadcrumb) -->
  <nav class="bg-white border-b border-gray-100 px-4 py-3">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <a href="/recursos" class="text-sm font-bold text-gray-400 hover:text-teal transition">← Volver a Recursos</a>
      <span class="text-xs font-bold text-teal uppercase tracking-widest flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span> Evaluador de IA
      </span>
    </div>
  </nav>

  <!-- BANNER CAFÉ GRATIS -->
  <div class="bg-gradient-to-r from-teal to-tealHover text-white px-4 py-3 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-center gap-3">
      <span class="text-2xl">☕</span>
      <div class="text-sm sm:text-base">
        <strong>¿Tienes dudas sobre los resultados?</strong> Agenda un café virtual de 30 minutos y te ayudo a priorizar tus tareas.
      </div>
      <a href="https://calendar.app.google/tu-link-cafe" target="_blank" class="bg-white text-teal px-4 py-2 rounded-lg font-bold text-sm hover:bg-gray-100 transition whitespace-nowrap">
        Agendar café gratis →
      </a>
    </div>
    <button id="close-cafe-banner" class="absolute top-2 right-2 text-white/80 hover:text-white text-xl">×</button>
  </div>
  <main class="py-10 px-6 max-w-7xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-deep">🗺️ Roadmap Builder</h1>
      <p class="text-sm text-gray-500">Vista de ejecución técnica. Columnas fijas, control total.</p>
    </div>

    <!-- CARGA -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm mb-6">
      <input type="file" id="csv-file" accept=".csv" class="w-full text-sm file:bg-teal file:text-white file:px-4 file:py-2 file:rounded-lg file:border-0 cursor-pointer" />
    </div>

    <!-- CONTROLES DE TIEMPO -->
    <div class="flex gap-2 mb-6" id="zoom-controls">
      <button onclick="zoom('week')" class="px-4 py-2 bg-gray-100 rounded-lg text-xs font-bold hover:bg-teal hover:text-white transition">Semana</button>
      <button onclick="zoom('month')" class="px-4 py-2 bg-gray-100 rounded-lg text-xs font-bold hover:bg-teal hover:text-white transition">Mes</button>
      <button onclick="zoom('year')" class="px-4 py-2 bg-gray-100 rounded-lg text-xs font-bold hover:bg-teal hover:text-white transition">Año</button>
    </div>

    <!-- ROADMAP VISUAL -->
    <div id="timeline-container" class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm"></div>
  </main>

  <link href="https://unpkg.com/vis-timeline@7.7.3/styles/vis-timeline-graph2d.min.css" rel="stylesheet" />
  <script is:inline src="https://unpkg.com/papaparse@5.4.1/papaparse.min.js"></script>
  <script is:inline src="https://unpkg.com/vis-timeline@7.7.3/standalone/umd/vis-timeline-graph2d.min.js"></script>

  <script is:inline>
    let timeline = null;

    document.getElementById('csv-file').addEventListener('change', function(e) {
      Papa.parse(e.target.files[0], {
        header: true,
        complete: function(results) {
          const items = results.data.filter(r => r.Title).map((r, i) => ({
            id: i,
            content: `<div class="font-bold text-xs">${r.Title}</div><div class="text-[10px] opacity-70">${r.State}</div>`,
            start: r['Start Date'] || '2026-05-28',
            end: r['Due Date'] || '2026-06-28',
            group: r.ID // Esto agrupa por ID para tener filas separadas
          }));

          const container = document.getElementById('timeline-container');
          container.innerHTML = '';
          
          timeline = new window.vis.Timeline(container, new window.vis.DataSet(items), {
            height: '500px',
            orientation: 'top',
            zoomable: false, // Desactivamos scroll-zoom
            moveable: true
          });
        }
      });
    });

    window.zoom = function(scale) {
      if (!timeline) return;
      const now = new Date();
      const ranges = {
        week: { start: new Date(now.getTime() - 7*864e5), end: new Date(now.getTime() + 7*864e5) },
        month: { start: new Date(now.getTime() - 30*864e5), end: new Date(now.getTime() + 30*864e5) },
        year: { start: new Date(now.getTime() - 180*864e5), end: new Date(now.getTime() + 180*864e5) }
      };
      timeline.setWindow(ranges[scale].start, ranges[scale].end);
    };
  </script>
</Layout>