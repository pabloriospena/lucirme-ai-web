---
import Layout from "../../layouts/Layout.astro";
import ActionHub from "../../components/ActionHub.astro";
import RedesSociales from "../../components/RedesSociales.astro";
import { LINKS } from "../../lib/constants.js";

const calendlyUrl =
  LINKS.calendly_empresa || LINKS.calendly_taller || LINKS.calendly;
---

<Layout
  title="Guía Completa de Deep Research: Investigación Avanzada con IA | LuciRMe AI"
>
  <!-- SUB-NAV (Breadcrumb) -->
  <nav
    class="bg-white/90 backdrop-blur-md border-b border-gray-200 px-6 py-4 sticky top-0 z-50"
  >
    <div class="max-w-5xl mx-auto flex justify-between items-center">
      <a
        href="/recursos"
        class="text-xs md:text-sm font-bold text-gray-500 hover:text-teal transition flex items-center gap-1"
      >
        ← Volver a Recursos
      </a>
      <a
        href={calendlyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center font-bold bg-orange text-white rounded-xl py-2 px-4 hover:bg-orange/90 transition shadow-xs text-xs text-center cursor-pointer"
      >
        Agendar Sesión
      </a>
    </div>
  </nav>

  <!-- HEADER / HERO SECTION -->
  <header
    class="bg-deep text-white py-16 md:py-20 px-6 relative overflow-hidden"
  >
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <!-- EYEBROW -->
      <div
        class="inline-flex items-center gap-2 bg-teal/15 text-teal text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 border border-teal/30"
      >
        <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span>
        Guía Completa de Investigación Avanzada
      </div>

      <!-- H1 -->
      <h1
        class="text-3xl md:text-5xl font-black mb-4 leading-tight tracking-tight text-white"
      >
        Guía Completa de <span class="text-teal">Deep Research</span>
      </h1>

      <!-- SUBTÍTULO -->
      <p
        class="text-lg md:text-xl text-gray-300 font-medium max-w-2xl mx-auto mb-8"
      >
        El Superpoder de la Investigación Avanzada con IA: de 3 semanas de
        trabajo a 4 horas estratégicas.
      </p>

      <!-- META BADGES -->
      <div
        class="inline-flex flex-wrap justify-center items-center gap-3 md:gap-4 bg-white/5 border border-white/10 rounded-2xl px-5 py-3 text-xs md:text-sm text-gray-300 max-w-3xl"
      >
        <span class="flex items-center gap-1.5">
          🔍 <strong>Nombre:</strong> Deep Research
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          ⚡ <strong>Modelos:</strong> Gemini & ChatGPT
        </span>
        <span class="text-gray-500 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5">
          📈 <strong>Impacto:</strong> Eficiencia 10x
        </span>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-12 space-y-16">
    <!-- CONTAINER CON MURO MAILERLITE -->
    <div id="guia-content-container" class="relative">
      <!-- OVERLAY MURO MAILERLITE (GATE) -->
      <div
        id="guia-gate-overlay"
        class="absolute inset-x-0 top-0 z-30 flex items-start justify-center pt-4 sm:pt-10 px-4 bg-gradient-to-b from-white/40 via-slate-900/40 to-slate-900/80 backdrop-blur-[3px] transition-all duration-500 min-h-[600px] rounded-2xl"
      >
        <div
          id="guia-gate-card"
          class="bg-white border border-gray-200/90 rounded-2xl p-6 sm:p-8 shadow-2xl w-full max-w-md mx-auto font-sans transition-all"
        >
          <div id="gate-form-wrapper">
            <span
              class="inline-block text-[10px] font-bold uppercase tracking-widest text-teal bg-teal/10 px-3 py-1 rounded-full mb-3 border border-teal/20"
            >
              Recurso Exclusivo · LuciRMe AI
            </span>
            <h2 class="text-2xl font-black text-deep mb-2 tracking-tight">
              Desbloquea la Guía Completa
            </h2>
            <p class="text-xs sm:text-sm text-gray-600 mb-6 leading-relaxed">
              Ingresa tu correo para acceder al instante a la metodología
              completa de 4 pasos y recibir la plantilla en tu bandeja de
              entrada.
            </p>

            <form id="guia-unlock-form" class="space-y-4">
              <!-- Honeypot oculto anti-bots -->
              <input
                type="text"
                id="gate-website"
                name="website"
                tabindex="-1"
                autocomplete="off"
                class="hidden"
                aria-hidden="true"
              />

              <div>
                <label
                  for="gate-name"
                  class="block text-xs font-bold text-deep mb-1 uppercase tracking-wider"
                >
                  Tu Nombre *
                </label>
                <input
                  type="text"
                  id="gate-name"
                  required
                  placeholder="Ej. Carlos Mendoza"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-gray-300 rounded-xl text-deep placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent transition"
                />
              </div>

              <div>
                <label
                  for="gate-email"
                  class="block text-xs font-bold text-deep mb-1 uppercase tracking-wider"
                >
                  Correo Electrónico *
                </label>
                <input
                  type="email"
                  id="gate-email"
                  required
                  placeholder="ejemplo@empresa.com"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-gray-300 rounded-xl text-deep placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent transition"
                />
              </div>

              <div>
                <label
                  for="gate-perfil"
                  class="block text-xs font-bold text-deep mb-1 uppercase tracking-wider"
                >
                  Tu Perfil <span class="text-gray-400 font-normal lowercase"
                    >(opcional)</span
                  >
                </label>
                <select
                  id="gate-perfil"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-gray-300 rounded-xl text-deep focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent transition cursor-pointer"
                >
                  <option value="">Selecciona tu perfil...</option>
                  <option value="Product Manager / Líder"
                    >Product Manager / Líder de Producto</option
                  >
                  <option value="Consultor / Independiente"
                    >Consultor / Independiente</option
                  >
                  <option value="Dueño de Empresa / Fundador"
                    >Dueño de Empresa / Fundador</option
                  >
                  <option value="Investigador / Estudiante"
                    >Investigador / Profesional de datos</option
                  >
                </select>
              </div>

              <div
                id="gate-error-msg"
                class="hidden bg-red-50 border border-red-200 text-red-700 text-xs p-3 rounded-xl leading-snug font-medium"
              >
                Algo falló. Inténtalo de nuevo o contáctanos por redes.
              </div>

              <button
                type="submit"
                id="gate-submit-btn"
                class="w-full bg-orange hover:bg-orange/90 text-white font-bold text-sm py-4 px-6 rounded-xl transition duration-200 shadow-lg cursor-pointer disabled:opacity-70 disabled:cursor-not-allowed mt-2"
              >
                Desbloquear Guía Gratis
              </button>

              <p class="text-[11px] text-gray-500 text-center mt-3">
                🔒 Sin spam. Un correo con la guía y acceso a futuros recursos.
              </p>
            </form>
          </div>

          <div id="gate-success-box" class="hidden text-center py-6 space-y-3">
            <div
              class="w-12 h-12 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center text-2xl mx-auto font-bold"
            >
              ✓
            </div>
            <p
              id="gate-success-msg"
              class="text-base font-bold text-deep leading-relaxed"
            >
              ¡Listo! Guía desbloqueada. También te hemos enviado el acceso a tu
              correo.
            </p>
          </div>
        </div>
      </div>

      <!-- CONTENIDO BLOQUEADO (LOCKED BODY) -->
      <div
        id="guia-locked-body"
        class="space-y-16 blur-sm pointer-events-none select-none transition-all duration-500 max-h-[750px] overflow-hidden"
      >
        <!-- INTRODUCCIÓN & CONCEPTO -->
        <section
          class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4"
        >
          <div class="flex items-center gap-3 border-b border-gray-100 pb-4">
            <div
              class="w-10 h-10 rounded-full bg-teal/15 text-teal flex items-center justify-center font-bold text-lg"
            >
              🚀
            </div>
            <div>
              <h2 class="text-xl md:text-2xl font-bold text-deep">
                El Cambio de Paradigma en IA
              </h2>
              <p class="text-xs text-gray-500">
                De la respuesta rápida al análisis de nivel consultoría
              </p>
            </div>
          </div>

          <p class="text-base text-gray-700 leading-relaxed">
            El <strong>Deep Research</strong> en Gemini y <em
              >"investigación profunda"</em
            > en ChatGPT) representa un cambio de paradigma en cómo interactuamos
            con la inteligencia artificial. Mientras que los chats conversacionales
            convencionales priorizan la velocidad de respuesta para mejorar la experiencia
            de usuario inmediata, el Deep Research prioriza la <strong
              >profundidad, la exhaustividad y la veracidad de la información</strong
            >.
          </p>

          <div
            class="bg-slate-50 border-l-4 border-teal p-5 rounded-r-xl space-y-2"
          >
            <span
              class="text-xs font-bold text-teal uppercase tracking-wider block"
              >Promesa de Metodología</span
            >
            <p
              class="text-sm md:text-base text-gray-800 font-semibold leading-relaxed"
            >
              Esta guía te enseñará paso a paso la metodología exacta para
              transformar una investigación técnica que normalmente tomaría <strong
                >tres semanas</strong
              > en un flujo de trabajo estratégico de <strong
                >solo cuatro horas</strong
              >.
            </p>
          </div>
        </section>

        <!-- ¿CÓMO FUNCIONA EL DEEP RESEARCH? -->
        <section class="space-y-6">
          <div class="border-b border-gray-200 pb-4">
            <span
              class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full"
            >
              Mecanismo Interno
            </span>
            <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
              📋 ¿Cómo funciona el Deep Research?
            </h2>
          </div>

          <div
            class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-6 text-gray-700"
          >
            <p class="text-base leading-relaxed">
              A diferencia de una consulta estándar en la que la IA responde con
              sus datos preentrenados o una búsqueda web superficial, el motor
              de Deep Research ejecuta un proceso estructurado de navegación
              autónoma:
            </p>

            <div class="grid md:grid-cols-3 gap-6">
              <div
                class="bg-slate-50 border border-gray-200 p-5 rounded-xl space-y-2"
              >
                <span class="text-2xl">🌐</span>
                <h3 class="font-bold text-deep text-sm">Búsqueda Simultánea</h3>
                <p class="text-xs text-gray-600 leading-relaxed">
                  Realiza múltiples consultas web activas de manera simultánea
                  explorando fuentes oficiales y técnicas.
                </p>
              </div>

              <div
                class="bg-slate-50 border border-gray-200 p-5 rounded-xl space-y-2"
              >
                <span class="text-2xl">📊</span>
                <h3 class="font-bold text-deep text-sm">
                  Lectura & Extracción
                </h3>
                <p class="text-xs text-gray-600 leading-relaxed">
                  Lee decenas de fuentes reales, extrae datos duros, tablas,
                  fórmulas y requerimientos técnicos específicos.
                </p>
              </div>

              <div
                class="bg-slate-50 border border-gray-200 p-5 rounded-xl space-y-2"
              >
                <span class="text-2xl">⏱️</span>
                <h3 class="font-bold text-deep text-sm">
                  Procesamiento Autónomo
                </h3>
                <p class="text-xs text-gray-600 leading-relaxed">
                  Toma entre <strong>3 y 5 minutos</strong> estructurando un informe
                  coherente antes de entregar el resultado final.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- METODOLOGÍA PASO A PASO -->
        <section class="space-y-6">
          <div class="border-b border-gray-200 pb-4">
            <span
              class="text-xs font-bold text-orange uppercase tracking-widest bg-orange/10 px-3 py-1 rounded-full"
            >
              Flujo de Trabajo
            </span>
            <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
              🛠️ Metodología Paso a Paso: De la Idea al Negocio
            </h2>
          </div>

          <div class="space-y-6">
            <!-- PASO 1 -->
            <div
              class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4 relative overflow-hidden"
            >
              <div class="flex items-center gap-3">
                <span
                  class="w-8 h-8 rounded-lg bg-teal text-white flex items-center justify-center font-black text-sm"
                >
                  1
                </span>
                <h3 class="text-xl font-extrabold text-deep">
                  Paso 1: Crear el "Prompt Maestro"
                </h3>
              </div>

              <p class="text-sm text-gray-600 leading-relaxed">
                El mayor error al usar Deep Research es darle una instrucción
                directa o vaga. Para obtener resultados de nivel consultoría,
                debes estructurar un prompt avanzado. No tienes que pensarlo de
                cero; pídele a la propia IA que lo escriba por ti:
              </p>

              <div class="space-y-3 pl-4 border-l-2 border-teal/40">
                <p class="text-xs md:text-sm text-gray-700">
                  1. Inicia un chat convencional y mantén una conversación
                  inicial para acotar tu idea o negocio (por ejemplo, <em
                    >"quiero montar un cultivo frutal de 5 hectáreas en San
                    Jerónimo"</em
                  >).
                </p>
                <p class="text-xs md:text-sm text-gray-700">
                  2. Una vez que la IA entienda el contexto general, pídele
                  exactamente lo siguiente:
                </p>
                <div
                  class="bg-slate-900 text-teal-300 p-4 rounded-xl font-mono text-xs md:text-sm border border-slate-700"
                >
                  "Escribe un prompt para una investigación profunda sobre lo
                  que estamos hablando."
                </div>
                <p class="text-xs md:text-sm text-gray-700">
                  3. La IA generará una instrucción avanzada dándose a sí misma
                  un <strong>Rol experto</strong>, definiendo un <strong
                    >Contexto</strong
                  >, un <strong>Objetivo</strong> claro y una <strong
                    >Estructura</strong
                  > técnica para la búsqueda.
                </p>
              </div>
            </div>

            <!-- PASO 2 -->
            <div
              class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4 relative overflow-hidden"
            >
              <div class="flex items-center gap-3">
                <span
                  class="w-8 h-8 rounded-lg bg-orange text-white flex items-center justify-center font-black text-sm"
                >
                  2
                </span>
                <h3 class="text-xl font-extrabold text-deep">
                  Paso 2: Ejecutar la Investigación Profunda
                </h3>
              </div>

              <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4 pt-2">
                <div class="bg-slate-50 p-4 rounded-xl space-y-1">
                  <span class="text-xs font-bold text-teal"
                    >01. Chat Limpio</span
                  >
                  <p class="text-xs text-gray-600">
                    Abre un nuevo chat totalmente limpio en la plataforma.
                  </p>
                </div>

                <div class="bg-slate-50 p-4 rounded-xl space-y-1">
                  <span class="text-xs font-bold text-teal"
                    >02. Activar Modo</span
                  >
                  <p class="text-xs text-gray-600">
                    Activa la opción de <strong>"Deep Research"</strong>
                  </p>
                </div>

                <div class="bg-slate-50 p-4 rounded-xl space-y-1">
                  <span class="text-xs font-bold text-teal"
                    >03. Pegar Prompt</span
                  >
                  <p class="text-xs text-gray-600">
                    Pega el "Prompt Maestro" generado en el Paso 1 y envíalo.
                  </p>
                </div>

                <div class="bg-slate-50 p-4 rounded-xl space-y-1">
                  <span class="text-xs font-bold text-teal"
                    >04. Aprobar Plan</span
                  >
                  <p class="text-xs text-gray-600">
                    Revisa el plan en viñetas que propone la IA y confírmalo
                    para iniciar.
                  </p>
                </div>
              </div>
            </div>

            <!-- PASO 3 -->
            <div
              class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4 relative overflow-hidden"
            >
              <div class="flex items-center gap-3">
                <span
                  class="w-8 h-8 rounded-lg bg-teal text-white flex items-center justify-center font-black text-sm"
                >
                  3
                </span>
                <h3 class="text-xl font-extrabold text-deep">
                  Paso 3: Transformar los Datos en una Web Interactiva (App)
                </h3>
              </div>

              <p class="text-sm text-gray-600 leading-relaxed">
                Una vez terminada la investigación, tendrás un documento de
                texto sumamente extenso y detallado. En Gemini, puedes
                convertirlo instantáneamente en una herramienta visual:
              </p>

              <div class="grid md:grid-cols-2 gap-4">
                <div
                  class="bg-gradient-to-br from-slate-50 to-white border border-gray-200 p-5 rounded-xl space-y-2"
                >
                  <span class="text-xs font-bold text-teal uppercase"
                    >Función "Crear"</span
                  >
                  <p class="text-xs md:text-sm text-gray-700 leading-relaxed">
                    Haz clic en la opción <strong>"Crear"</strong> que aparece al
                    finalizar la investigación profunda. La IA interpretará todos
                    los datos recopilados y creará un <strong
                      >reporte visual interactivo (sitio web funcional)</strong
                    > en cuestión de minutos.
                  </p>
                </div>

                <div
                  class="bg-gradient-to-br from-slate-50 to-white border border-gray-200 p-5 rounded-xl space-y-2"
                >
                  <span class="text-xs font-bold text-teal uppercase"
                    >Entregables Listos</span
                  >
                  <p class="text-xs md:text-sm text-gray-700 leading-relaxed">
                    Este reporte incluirá visión general, modelos técnicos,
                    viabilidad económica (cálculos de TIR, VPN y retorno de
                    inversión) y fuentes consultadas. Puedes compartir el enlace
                    o exportar el reporte directamente a clientes.
                  </p>
                </div>
              </div>
            </div>

            <!-- PASO 4 -->
            <div
              class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-xs space-y-4 relative overflow-hidden"
            >
              <div class="flex items-center gap-3">
                <span
                  class="w-8 h-8 rounded-lg bg-orange text-white flex items-center justify-center font-black text-sm"
                >
                  4
                </span>
                <h3 class="text-xl font-extrabold text-deep">
                  Paso 4: Crear tu "Cuaderno Inteligente" para Simulaciones
                </h3>
              </div>

              <p class="text-sm text-gray-600 leading-relaxed">
                El verdadero superpoder del Deep Research es poder interactuar
                de forma segura con la información investigada para tomar
                decisiones estratégicas en tiempo real:
              </p>

              <div
                class="space-y-3 text-xs md:text-sm text-gray-700 bg-slate-50 p-5 rounded-xl border border-gray-200"
              >
                <p>
                  1. Copia todo el contenido detallado de la investigación
                  profunda.
                </p>
                <p>
                  2. Ve a la sección de <strong
                    >Proyectos / Cuadernos (Notebooks)</strong
                  > de tu plataforma de IA y crea uno nuevo.
                </p>
                <p>
                  3. Pega el texto copiado para guardarlo como tu <strong
                    >fuente de información base</strong
                  >.
                </p>
                <p
                  class="pt-2 border-t border-gray-200 font-semibold text-deep"
                >
                  4. <strong>Conversa con tus datos:</strong> Ahora puedes realizar
                  preguntas hiperespecíficas que solo se responderán basándose strictly
                  en la investigación técnica previa.
                </p>
              </div>

              <div
                class="bg-teal/10 border border-teal/30 p-4 rounded-xl text-xs md:text-sm text-teal-950 font-medium"
              >
                💡 <em>Ejemplo de consulta:</em> "¿Cuál es la rentabilidad (TIR),
                el Valor Presente Neto (VPN) y el tiempo estimado de equilibrio de
                mi proyecto agrícola según este informe?"
              </div>
            </div>
          </div>
        </section>

        <!-- EL ENFOQUE ESTRATÉGICO -->
        <section class="space-y-6">
          <div class="border-b border-gray-200 pb-4">
            <span
              class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full"
            >
              Criterio Humano
            </span>
            <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
              🧠 El Enfoque Estratégico (Criterio Humano vs. IA)
            </h2>
          </div>

          <div class="grid md:grid-cols-3 gap-6">
            <div
              class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-3 hover:border-teal/50 transition"
            >
              <div class="text-2xl">⚙️</div>
              <h3 class="font-bold text-deep text-base">
                La IA hace el trabajo pesado
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                Investiga, rastrea la web, recopila datos, estructuras fórmulas
                complejas y maqueta los primeros entregables visuales.
              </p>
            </div>

            <div
              class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-3 hover:border-teal/50 transition"
            >
              <div class="text-2xl">🎯</div>
              <h3 class="font-bold text-deep text-base">
                Tú pones el criterio
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                El resultado final requiere siempre de tu <strong
                  >pensamiento crítico</strong
                >. Ninguna IA reemplaza la validación del experto sobre el
                terreno o las dinámicas reales del mercado.
              </p>
            </div>

            <div
              class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-3 hover:border-teal/50 transition"
            >
              <div class="text-2xl">💡</div>
              <h3 class="font-bold text-deep text-base">
                Monetización y Valor
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                Esta secuencia (<code
                  >Contexto ➔ Deep Research ➔ Cuaderno ➔ Reporte visual</code
                >) es la forma más rápida y rentable de validar e idear nuevos
                productos y servicios profesionales.
              </p>
            </div>
          </div>
        </section>

        <!-- ACTION HUB & REDES SOCIALES -->
        <ActionHub />
        <RedesSociales />
      </div>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const LOCAL_STORAGE_KEY = "guia_deepresearch_unlocked";
    const gateOverlay = document.getElementById("guia-gate-overlay");
    const lockedBody = document.getElementById("guia-locked-body");
    const unlockForm = document.getElementById(
      "guia-unlock-form",
    ) as HTMLFormElement | null;
    const nameInput = document.getElementById(
      "gate-name",
    ) as HTMLInputElement | null;
    const emailInput = document.getElementById(
      "gate-email",
    ) as HTMLInputElement | null;
    const perfilInput = document.getElementById(
      "gate-perfil",
    ) as HTMLSelectElement | null;
    const websiteInput = document.getElementById(
      "gate-website",
    ) as HTMLInputElement | null;
    const errorMsg = document.getElementById("gate-error-msg");
    const submitBtn = document.getElementById(
      "gate-submit-btn",
    ) as HTMLButtonElement | null;
    const formWrapper = document.getElementById("gate-form-wrapper");
    const successBox = document.getElementById("gate-success-box");
    const successMsg = document.getElementById("gate-success-msg");

    const executeUnlock = () => {
      if (gateOverlay) {
        gateOverlay.style.opacity = "0";
        setTimeout(() => {
          gateOverlay.style.display = "none";
        }, 400);
      }
      if (lockedBody) {
        lockedBody.classList.remove(
          "blur-sm",
          "pointer-events-none",
          "select-none",
          "max-h-[750px]",
          "overflow-hidden",
        );
      }
    };

    // Auto-desbloqueo si ya lo envió anteriormente
    if (localStorage.getItem(LOCAL_STORAGE_KEY) === "true") {
      executeUnlock();
      return;
    }

    // Submit del formulario
    if (unlockForm) {
      unlockForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (errorMsg) errorMsg.classList.add("hidden");

        const nameVal = nameInput ? nameInput.value.trim() : "";
        const emailVal = emailInput ? emailInput.value.trim() : "";
        const perfilVal = perfilInput ? perfilInput.value : "";
        const websiteVal = websiteInput ? websiteInput.value : "";

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Procesando...";
        }

        try {
          const response = await fetch("/api/unlock-guia", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name: nameVal,
              email: emailVal,
              perfil: perfilVal,
              website: websiteVal,
            }),
          });

          const resData = await response.json().catch(() => ({}));

          if (!response.ok && resData.error) {
            if (errorMsg) {
              errorMsg.textContent = resData.error;
              errorMsg.classList.remove("hidden");
            }
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "Desbloquear Guía Gratis";
            }
            return;
          }

          // Éxito - guardar en localStorage
          localStorage.setItem(LOCAL_STORAGE_KEY, "true");

          if (formWrapper) formWrapper.classList.add("hidden");
          if (successMsg && nameVal) {
            successMsg.textContent = `¡Listo, ${nameVal}! Guía desbloqueada. También te hemos enviado el acceso a tu correo.`;
          }
          if (successBox) successBox.classList.remove("hidden");

          setTimeout(() => {
            executeUnlock();
          }, 1000);
        } catch (err) {
          console.error("Unlock error:", err);
          if (errorMsg) {
            errorMsg.textContent =
              "Ocurrió un error. Inténtalo de nuevo o contáctanos por redes.";
            errorMsg.classList.remove("hidden");
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Desbloquear Guía Gratis";
          }
        }
      });
    }
  });
</script>
