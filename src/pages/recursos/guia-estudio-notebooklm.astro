    <!-- LÓGICA DEL CLIENTE (INTERACTIVIDAD Y MURO) -->
    <script is:inline>
        // 1. Verificación de Desbloqueo (localStorage o ?guia=ok)
        const params = new URLSearchParams(window.location.search);
        const hasUrlParam = params.get("guia") === "ok";
        const hasLocalStorage =
            localStorage.getItem("guia_notebooklm_unlocked") === "true";

        const contentBody = document.getElementById("guia-content-body");
        const gateOverlay = document.getElementById("guia-gate-overlay");

        function executeUnlock() {
            localStorage.setItem("guia_notebooklm_unlocked", "true");
            if (gateOverlay) {
                gateOverlay.style.display = "none";
            }
            if (contentBody) {
                contentBody.classList.remove(
                    "blur-md",
                    "pointer-events-none",
                    "select-none",
                    "max-h-[520px]",
                    "overflow-hidden",
                );
            }
        }

        if (hasUrlParam || hasLocalStorage) {
            executeUnlock();
        }

        // 2. Envío del Formulario del Muro
        const unlockForm = document.getElementById("guia-unlock-form");
        const submitBtn = document.getElementById("gate-submit-btn");
        const errorMsg = document.getElementById("gate-error-msg");
        const formWrapper = document.getElementById("gate-form-wrapper");
        const successBox = document.getElementById("gate-success-box");
        const successMsg = document.getElementById("gate-success-msg");

        if (unlockForm) {
            unlockForm.addEventListener("submit", async (e) => {
                e.preventDefault();

                if (errorMsg) errorMsg.classList.add("hidden");

                const nameInput = document.getElementById("gate-name");
                const emailInput = document.getElementById("gate-email");
                const perfilInput = document.getElementById("gate-perfil");
                const websiteInput = document.getElementById("gate-website");

                const nameVal = nameInput ? nameInput.value.trim() : "";
                const emailVal = emailInput ? emailInput.value.trim() : "";
                const perfilVal = perfilInput ? perfilInput.value : "";
                const websiteVal = websiteInput ? websiteInput.value : "";

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = "Enviando...";
                }

                try {
                    const response = await fetch("/api/unlock-guia", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            name: nameVal,
                            email: emailVal,
                            perfil: perfilVal,
                            website: websiteVal,
                        }),
                    });

                    const resData = await response.json().catch(() => ({}));

                    if (!response.ok && resData.error) {
                        if (errorMsg) {
                            errorMsg.textContent = resData.error;
                            errorMsg.classList.remove("hidden");
                        }
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.textContent = "Enviarme la guía";
                        }
                        return;
                    }

                    // Éxito
                    localStorage.setItem("guia_notebooklm_unlocked", "true");

                    if (formWrapper) formWrapper.classList.add("hidden");
                    if (successMsg) {
                        successMsg.textContent = `Listo, ${nameVal}. La guía también va en camino a tu correo.`;
                    }
                    if (successBox) successBox.classList.remove("hidden");

                    setTimeout(() => {
                        executeUnlock();
                        window.scrollTo({ top: 0, behavior: "smooth" });
                    }, 1200);
                } catch (err) {
                    console.error("Unlock error:", err);
                    if (errorMsg) {
                        errorMsg.textContent =
                            "Algo falló. Inténtalo de nuevo o escríbeme por cualquier red y te la paso directo.";
                        errorMsg.classList.remove("hidden");
                    }
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = "Enviarme la guía";
                    }
                }
            });
        }

        // Control del Banner Café Gratis
        const cafeBanner = document.getElementById("cafe-banner");
        const closeCafeBtn = document.getElementById("close-cafe-banner");

        if (cafeBanner && closeCafeBtn) {
            closeCafeBtn.addEventListener("click", () => {
                cafeBanner.style.opacity = "0";
                setTimeout(() => {
                    cafeBanner.style.display = "none";
                }, 300);
            });
        }

        // Copia de prompts individuales de las tarjetas
        document.querySelectorAll(".copy-prompt-btn").forEach((btn) => {
            btn.addEventListener("click", async () => {
                const textPre = btn.previousElementSibling;
                if (!textPre) return;

                const textToCopy = textPre.textContent || "";
                try {
                    await navigator.clipboard.writeText(textToCopy);
                    const originalText = btn.textContent;
                    btn.textContent = "¡Copiado!";
                    btn.classList.add(
                        "bg-teal-50",
                        "text-teal-700",
                        "border-teal-300",
                    );

                    setTimeout(() => {
                        btn.textContent = originalText;
                        btn.classList.remove(
                            "bg-teal-50",
                            "text-teal-700",
                            "border-teal-300",
                        );
                    }, 2000);
                } catch (err) {
                    alert("No se pudo copiar el prompt automáticamente.");
                }
            });
        });
    </script>
</Layout>
