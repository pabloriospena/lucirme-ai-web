---
// Ebook Product Management Sin Bullshit, con la plantilla de guía de pago (Web v2).
// El pago va a Hotmart con el cupón dentro del enlace (LINKS.ebook). El precio sale de src/data/precios.ts.
// La página anterior quedó archivada en _ebook-pm-anterior.astro.
import LayoutV2 from "../../layouts/LayoutV2.astro";
import PlantillaGuiaPago from "../../components/v2/PlantillaGuiaPago.astro";
import { LINKS } from "../../lib/constants.js";
---

<LayoutV2
  title="Ebook: Product Management Sin Bullshit | LuciRMe AI"
  description="Cómo construir productos que importan en startups, sin frameworks mágicos. Lo que funciona en el campo, escrito por Pablo Ríos."
>
  <PlantillaGuiaPago
    slug="ebook-pm"
    titulo="Product Management Sin Bullshit"
    descripcion="Cómo construir productos que importan en startups. Sin frameworks mágicos, solo lo que funciona en el campo."
    tema="Producto"
    precioClave="ebook-pm"
    hrefPago={LINKS.ebook}
    incluye={[
      "El backlog y el roadmap: hacerlos simples y ágiles, para que no te controlen a ti.",
      "Producción sin miedo: el momento perfecto no existe, lanza rápido y aprende rápido.",
      "El equipo de desarrollo como aliado, no como ejecutor ciego ni como enemigo.",
      "El cliente como aliado, aunque no sea tu jefe, y cómo leer entre líneas lo que pide.",
    ]}
    vistaPrevia="Evita las métricas vanidosas, deja de obsesionarte con la metodología al pie de la letra y esquiva la trampa del feature creep. Más de diez años de golpes y aprendizajes en startups, en un solo libro."
    relacionados={[
      { titulo: "Backlog Detox", tipo: "Herramienta", url: "/recursos/backlog-detox" },
      { titulo: "Ruta Product", tipo: "Ruta", url: "/ruta-product" },
      { titulo: "Roadmap Builder", tipo: "Herramienta", url: "/recursos/roadmap-builder" },
    ]}
  />
</LayoutV2>
