---
import Layout from "../layouts/Layout.astro";
import SobreMi from "../components/SobreMi.astro";
import CurrencySelector from "../components/CurrencySelector.astro";
import Metodologia from "../components/Metodologia.astro";
import { LINKS } from "../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
---

<Layout
  title="Página Web para tu Negocio | LuciRMe AI"
  description="Creamos páginas comerciales profesionales para que tus clientes entiendan lo que haces y sepan cómo contactarte."
>
  <main class="w-full bg-[#F8FAFC]">
    <!-- SUB-NAVEGACIÓN PARA COMERCIAL -->
    <nav
      class="w-full bg-white border-b border-slate-200 py-3 sticky top-16 z-30"
    >
      <div
        class="max-w-7xl mx-auto px-6 flex flex-wrap gap-4 text-xs font-semibold text-slate-600"
      >
        <a class="hover:text-teal-700" href="#concepto">Cómo funciona</a>
        <a class="hover:text-teal-700" href="#diagnostico-conversacional"
          >Cotizar mi página</a
        >
        <a class="hover:text-teal-700" href="#que-incluye">Qué incluye</a>
        <a class="hover:text-teal-700 text-amber-700" href="#precios"
          >Lanzamiento 50% OFF</a
        >
      </div>
    </nav>

    <!-- HERO SECTION -->
    <section
      class="w-full max-w-7xl mx-auto px-6 pt-12 pb-10 md:py-16 flex flex-col items-start gap-6 border-b border-slate-200/60"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start w-full">
        <div class="lg:col-span-7 flex flex-col items-start gap-5">
          <div
            class="inline-flex items-center gap-2 px-3.5 py-1 bg-teal-50 border border-teal-200/80 rounded-full font-mono text-xs text-teal-800 shadow-2xs"
          >
            Presencia digital profesional para tu negocio
          </div>
          <div class="max-w-2xl flex flex-col gap-3">
            <h1
              class="text-3xl md:text-5xl font-bold tracking-tight text-slate-900 leading-tight"
            >
              Tu negocio merece algo mejor que un Instagram y un WhatsApp.
            </h1>
            <p
              class="text-base md:text-lg text-slate-600 font-normal leading-relaxed"
            >
              Te ayudo a tener una página que muestre bien lo que haces y que
              haga más fácil que un cliente te contacte.
            </p>
            <p
              class="text-base md:text-lg text-slate-600 font-normal leading-relaxed"
            >
              Que cuando alguien llegue pueda entender rápidamente qué vendes,
              quién eres, qué te hace diferente y cómo puede hablar contigo.
            </p>
            <p
              class="text-base md:text-lg text-slate-600 font-normal leading-relaxed"
            >
              Sin agencia. Sin tecnicismos. Sin una página llena de cosas que
              nadie necesita.
            </p>
          </div>

          <div
            class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2 w-full sm:w-auto"
          >
            <button
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-sm cursor-pointer"
              onclick="window.startCommercialForm()"
            >
              <span>Quiero mi página</span>
            </button>
            <a
              class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-white border border-slate-200 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition-colors shadow-2xs"
              href="#metodologia"
            >
              <span>Ver qué incluye</span>
            </a>
          </div>

          <p class="text-xs font-mono text-slate-500">
            Toma 2 minutos contarme sobre tu negocio.
          </p>
        </div>

        <div class="lg:col-span-5 w-full flex justify-center lg:justify-end">
          <div
            class="w-full max-w-md bg-white rounded-2xl border border-slate-200 shadow-sm p-5 md:p-6 flex flex-col gap-4"
          >
            <div
              class="flex items-center justify-between pb-1 border-b border-slate-100"
            >
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                <span
                  class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-900"
                  >PÁGINA COMERCIAL</span
                >
              </div>
              <span class="font-mono text-[10px] text-slate-400"
                >LuciRMe AI</span
              >
            </div>

            <div
              class="p-4 bg-slate-50 border border-slate-200/60 rounded-xl flex flex-col gap-2"
            >
              <span
                class="font-mono text-[10px] uppercase font-semibold text-teal-800 tracking-wider"
                >La propuesta directa</span
              >
              <p class="text-xs font-medium text-slate-800 leading-relaxed">
                "Tú conoces tu negocio. Yo me encargo de convertirlo en una
                página que lo explique bien."
              </p>
            </div>

            <div
              class="p-3.5 bg-teal-50/60 border border-teal-100 rounded-xl flex items-start gap-2.5 text-xs text-slate-700 leading-relaxed"
            >
              <p class="text-[11px] leading-relaxed">
                Sin tecnicismos innecesarios. Sin agencias complicadas. Una
                herramienta comercial lista para funcionar.
              </p>
            </div>

            <div class="p-3 bg-slate-100 rounded-xl text-center">
              <div class="flex items-center justify-between mb-2">
                <span class="text-slate-500 text-[10px] font-mono">Moneda:</span
                >
                <CurrencySelector />
              </div>
              <div data-currency-price="COP">
                <span class="text-xs font-semibold text-slate-900"
                  >Lanzamiento 50% OFF:</span
                >
                <span class="font-bold text-emerald-600 text-xs ml-1"
                  >$1.075.000 COP</span
                >
              </div>
              <div data-currency-price="USD" class="hidden">
                <span class="text-xs font-semibold text-slate-900"
                  >Lanzamiento 50% OFF:</span
                >
                <span class="font-bold text-emerald-600 text-xs ml-1"
                  >$305 USD</span
                >
              </div>
              <span class="text-[10px] text-slate-500 font-mono block mt-0.5"
                >Hasta el viernes 9 de octubre</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- NUEVO DISEÑO: CONCEPTO DEL SERVICIO -->
    <section
      class="w-full max-w-7xl mx-auto px-6 py-16 border-b border-slate-200"
      id="concepto"
    >
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Izquierda: Texto -->
        <div class="flex flex-col gap-6">
          <span
            class="font-mono text-xs font-bold tracking-wider text-teal-800 uppercase"
            >EL PUNTO DE PARTIDA</span
          >
          <h2
            class="text-3xl md:text-5xl font-bold tracking-tight text-slate-900 leading-tight"
          >
            Cuando alguien te pregunta “¿tienes página?”, ¿qué le mandas?
          </h2>
          <p class="text-sm md:text-base text-slate-600 leading-relaxed">
            Muchas veces termina siendo el Instagram. O un catálogo en PDF
            desactualizado. O un chat de WhatsApp donde toca explicar todo otra
            vez desde cero.
          </p>
          <p class="text-sm md:text-base text-slate-600 leading-relaxed">
            La idea es tener un solo lugar donde esté lo importante de tu
            negocio, para que puedas mandarlo por WhatsApp, ponerlo en tu perfil
            o compartirlo con cualquier persona que quiera conocerte.
          </p>
          <p
            class="text-sm md:text-base text-slate-900 leading-relaxed font-bold"
          >
            Yo me encargo de armar esa página contigo y dejarla funcionando.
          </p>
        </div>

        <!-- Derecha: Caja de Objetivo Comercial -->
        <div class="border border-slate-200 rounded-2xl p-8 bg-white shadow-sm">
          <span
            class="font-mono text-[10px] font-bold text-slate-500 uppercase block mb-4"
            >OBJETIVO COMERCIAL</span
          >
          <p class="text-base font-semibold text-slate-900 leading-snug mb-6">
            Que cualquier persona entienda en menos de 30 segundos:
          </p>
          <div class="space-y-4 mb-8">
            <div
              class="text-xs font-medium text-slate-600 border-b border-slate-100 pb-2"
            >
              01 | Qué haces
            </div>
            <div
              class="text-xs font-medium text-slate-600 border-b border-slate-100 pb-2"
            >
              02 | Qué ofreces
            </div>
            <div
              class="text-xs font-medium text-slate-600 border-b border-slate-100 pb-2"
            >
              03 | Por qué confiar en ti
            </div>
            <div
              class="text-xs font-medium text-slate-600 border-b border-slate-100 pb-2"
            >
              04 | Cómo contactarte
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPONENTE DIAGNÓSTICO CONVERSACIONAL (BusinessDiagnostic) -->
    <section
      class="w-full max-w-7xl mx-auto px-6 py-12 scroll-mt-20"
      id="diagnostico-conversacional"
    >
      <div class="max-w-2xl mx-auto flex flex-col gap-6">
        <div
          class="bg-white rounded-2xl border border-slate-200 shadow-md p-6 md:p-8 relative min-h-[400px] flex flex-col justify-between"
          id="bus-wizard-card"
        >
          <!-- Wizard Header -->
          <div
            class="flex flex-col gap-2 pb-4 border-b border-slate-100"
            id="bus-wizard-header"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span
                  class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"
                ></span>
                <span
                  class="font-mono text-xs font-semibold text-slate-900 uppercase"
                  id="bus-step-counter">Paso 1 de 4</span
                >
              </div>
              <span class="text-xs font-mono text-slate-400" id="bus-step-time"
                >~1 min</span
              >
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
              <div
                class="bg-emerald-600 h-1.5 rounded-full transition-all duration-300 ease-out"
                id="bus-progress-bar"
                style="width: 25%;"
              >
              </div>
            </div>
          </div>

          <!-- PASO 1: NOMBRE -->
          <div class="bus-step flex flex-col gap-4 py-4" id="bus-step-1">
            <div class="flex flex-col gap-1.5">
              <span
                class="font-mono text-xs font-semibold text-teal-800 uppercase"
                >Paso 1 · Identidad</span
              >
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">
                Cuéntame un poco de tu negocio 💼
              </h3>
              <p class="text-sm text-slate-600">¿Cómo se llama tu negocio?</p>
            </div>
            <div class="flex flex-col gap-3 pt-2">
              <input
                class="w-full text-sm px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none bg-white transition-colors"
                id="bus-input-nombre"
                placeholder="Ej. Mi Tienda / Servicios Profesionales..."
                type="text"
              />
              <button
                class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-teal-700 text-white font-semibold text-sm hover:bg-teal-800 transition-colors cursor-pointer self-start"
                onclick="window.busNextStep(1)"
                type="button"><span>Continuar →</span></button
              >
            </div>
          </div>

          <!-- PASO 2: TIPO DE NEGOCIO -->
          <div class="bus-step hidden flex flex-col gap-4 py-4" id="bus-step-2">
            <div class="flex flex-col gap-1.5">
              <span
                class="font-mono text-xs font-semibold text-teal-800 uppercase"
                >Paso 2 · Categoría</span
              >
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">
                ¿A qué se dedica tu negocio?
              </h3>
            </div>
            <div
              class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2"
              id="group-bus-tipo"
            >
              <button
                class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer"
                onclick="window.busSelectTipo('Veterinaria', this)"
                type="button">Veterinaria</button
              >
              <button
                class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer"
                onclick="window.busSelectTipo('Salud y bienestar', this)"
                type="button">Salud y bienestar</button
              >
              <button
                class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer"
                onclick="window.busSelectTipo('Educación', this)"
                type="button">Educación</button
              >
              <button
                class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer"
                onclick="window.busSelectTipo('Restaurante / gastronomía', this)"
                type="button">Restaurante / gastronomía</button
              >
              <button
                class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer"
                onclick="window.busSelectTipo('Profesional independiente', this)"
                type="button">Profesional independiente</button
              >
              <button
                class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer"
                onclick="window.busSelectTipo('Servicios para empresas', this)"
                type="button">Servicios para empresas</button
              >
              <button
                class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer"
                onclick="window.busSelectTipo('Comercio / tienda', this)"
                type="button">Comercio / tienda</button
              >
              <button
                class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer"
                onclick="window.busSelectTipo('Inmobiliaria', this)"
                type="button">Inmobiliaria</button
              >
              <button
                class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer"
                onclick="window.busSelectTipo('Belleza y estética', this)"
                type="button">Belleza y estética</button
              >
              <button
                class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer"
                onclick="window.busSelectTipo('Otro', this)"
                type="button">Otro</button
              >
            </div>
          </div>

          <!-- PASO 3: CONTACTO -->
          <div class="bus-step hidden flex flex-col gap-4 py-4" id="bus-step-3">
            <div class="flex flex-col gap-1.5">
              <span
                class="font-mono text-xs font-semibold text-teal-800 uppercase"
                >Paso 3 · Contacto</span
              >
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">
                ¿A dónde te envío la propuesta?
              </h3>
            </div>
            <form class="flex flex-col gap-3 pt-2" id="bus-form-lead">
              <div class="flex flex-col gap-1">
                <input
                  class="w-full text-sm px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white"
                  id="bus-input-email"
                  placeholder="Correo electrónico"
                  required
                  type="email"
                />
              </div>
              <div class="flex flex-col gap-1">
                <input
                  class="w-full text-sm px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white"
                  id="bus-input-whatsapp"
                  placeholder="WhatsApp (Ej. +57300...)"
                  required
                  type="tel"
                />
              </div>
              <button
                class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors cursor-pointer"
                type="submit"><span>Enviar solicitud →</span></button
              >
            </form>
          </div>

          <!-- PASO 4: RESULTADO -->
          <div class="bus-step hidden flex flex-col gap-4 py-4" id="bus-step-4">
            <h3 class="text-xl font-bold text-slate-900">¡Recibido!</h3>
            <p class="text-sm text-slate-600">
              Te contactaré pronto por WhatsApp para conversar sobre tu negocio.
            </p>
            <p class="text-sm text-slate-600">
              O para un menor tiempo de respuesta:
            </p>
            <a
              href={whatsappBase}
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-green-500 text-white font-semibold text-sm hover:bg-green-600 transition-colors cursor-pointer"
              target="_blank"><span>Hablar por WhatsApp →</span></a
            >
          </div>

          <!-- Wizard Footer Navigation -->
          <div
            class="pt-3 border-t border-slate-100 flex items-center justify-between mt-2"
          >
            <button
              class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-medium text-slate-600 hover:bg-slate-50 cursor-pointer"
              disabled
              id="bus-btn-prev"
              onclick="window.busPrevStep()"
              type="button">Anterior</button
            >
          </div>
        </div>
      </div>
    </section>

    <Metodologia />

    <!-- SECCIÓN: SIN SORPRESAS -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16" id="precios">
      <!-- ... -->
    </section>

    <SobreMi />
  </main>

  <script is:inline>
    let busStep = 1;
    const busState = { nombre: "", tipo: "", email: "", whatsapp: "" };

    function busGoToStep(step) {
      document
        .querySelectorAll(".bus-step")
        .forEach((el) => el.classList.add("hidden"));
      busStep = step;
      document.getElementById("bus-step-" + step).classList.remove("hidden");
      document.getElementById("bus-progress-bar").style.width =
        (step / 4) * 100 + "%";
      document.getElementById("bus-step-counter").innerText =
        "Paso " + step + " de 4";
      document.getElementById("bus-btn-prev").disabled = step === 1;
    }

    window.busNextStep = (step) => {
      if (step === 1) {
        busState.nombre = document.getElementById("bus-input-nombre").value;
        if (!busState.nombre) return alert("Ingresa el nombre");
        busGoToStep(2);
      }
    };

    window.busSelectTipo = (val, btn) => {
      busState.tipo = val;
      busGoToStep(3);
    };

    document.getElementById("bus-form-lead").onsubmit = async (e) => {
      e.preventDefault();
      busState.email = document.getElementById("bus-input-email").value;
      busState.whatsapp = document.getElementById("bus-input-whatsapp").value;

      try {
        const res = await fetch("/api/page-commercial-lead", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: "Cliente",
            email: busState.email,
            whatsapp: busState.whatsapp,
            empresa: busState.nombre,
            tipo_de_página: busState.tipo,
            fuente: "Landing pagina-comercial",
          }),
        });

        if (res.ok) {
          busGoToStep(4);
        } else {
          alert("Error al enviar, intenta de nuevo.");
        }
      } catch (err) {
        console.error("Error:", err);
      }
    };

    window.busPrevStep = () => {
      if (busStep > 1) busGoToStep(busStep - 1);
    };

    window.startCommercialForm = () => {
      document
        .getElementById("diagnostico-conversacional")
        .scrollIntoView({ behavior: "smooth" });
    };
  </script>
</Layout>
