---
import Layout from "../layouts/Layout.astro";
import SobreMi from "../components/SobreMi.astro";
import { LINKS } from "../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
---

<Layout
  title="Página Web para tu Negocio | LuciRMe AI"
  description="Creamos páginas comerciales profesionales para que tus clientes entiendan lo que haces y sepan cómo contactarte."
>

  <main class="w-full bg-[#F8FAFC]">
    <!-- SUB-NAVEGACIÓN PARA COMERCIAL -->
    <nav class="w-full bg-white border-b border-slate-200 py-3 sticky top-16 z-30">
      <div class="max-w-7xl mx-auto px-6 flex flex-wrap gap-4 text-xs font-semibold text-slate-600">
        <a class="hover:text-teal-700" href="#concepto">Cómo funciona</a>
        <a class="hover:text-teal-700" href="#diagnostico-conversacional">Cotizar mi página</a>
        <a class="hover:text-teal-700" href="#que-incluye">Qué incluye</a>
        <a class="hover:text-teal-700 text-amber-700" href="#precios">Lanzamiento 50% OFF</a>
      </div>
    </nav>

    <!-- HERO SECTION -->
    <section
      class="w-full max-w-7xl mx-auto px-6 pt-12 pb-10 md:py-16 flex flex-col items-start gap-6 border-b border-slate-200/60"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start w-full">
        <div class="lg:col-span-7 flex flex-col items-start gap-5">
          <div
            class="inline-flex items-center gap-2 px-3.5 py-1 bg-teal-50 border border-teal-200/80 rounded-full font-mono text-xs text-teal-800 shadow-2xs"
          >
            Presencia digital profesional para tu negocio
          </div>
          <div class="max-w-2xl flex flex-col gap-3">
            <h1
              class="text-3xl md:text-5xl font-bold tracking-tight text-slate-900 leading-tight"
            >
              Tu negocio merece algo mejor que un Instagram y un WhatsApp.
            </h1>
            <p
              class="text-base md:text-lg text-slate-600 font-normal leading-relaxed"
            >
              Te ayudo a tener una página que muestre bien lo que haces y que haga más fácil que un cliente te contacte.
            </p>
            <p
              class="text-base md:text-lg text-slate-600 font-normal leading-relaxed"
            >
              Que cuando alguien llegue pueda entender rápidamente qué vendes, quién eres, qué te hace diferente y cómo puede hablar contigo.
            </p>
            <p
              class="text-base md:text-lg text-slate-600 font-normal leading-relaxed"
            >
              Sin agencia. Sin tecnicismos. Sin una página llena de cosas que nadie necesita.
            </p>
          </div>

          <div
            class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2 w-full sm:w-auto"
          >
            <button
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-sm cursor-pointer"
              onclick="window.startCommercialForm()"
            >
              <span>Quiero mi página</span>
            </button>
            <a
              class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-white border border-slate-200 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition-colors shadow-2xs"
              href="#que-incluye"
            >
              <span>Ver qué incluye</span>
            </a>
          </div>

          <p class="text-xs font-mono text-slate-500">
            Toma 2 minutos contarme sobre tu negocio.
          </p>
        </div>

        <div class="lg:col-span-5 w-full flex justify-center lg:justify-end">
          <div
            class="w-full max-w-md bg-white rounded-2xl border border-slate-200 shadow-sm p-5 md:p-6 flex flex-col gap-4"
          >
            <div
              class="flex items-center justify-between pb-1 border-b border-slate-100"
            >
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                <span
                  class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-900"
                  >PÁGINA COMERCIAL</span
                >
              </div>
              <span class="font-mono text-[10px] text-slate-400"
                >LuciRMe AI</span
              >
            </div>

            <div
              class="p-4 bg-slate-50 border border-slate-200/60 rounded-xl flex flex-col gap-2"
            >
              <span
                class="font-mono text-[10px] uppercase font-semibold text-teal-800 tracking-wider"
                >La propuesta directa</span
              >
              <p class="text-xs font-medium text-slate-800 leading-relaxed">
                "Tú conoces tu negocio. Yo me encargo de convertirlo en una
                página que lo explique bien."
              </p>
            </div>

            <div
              class="p-3.5 bg-teal-50/60 border border-teal-100 rounded-xl flex items-start gap-2.5 text-xs text-slate-700 leading-relaxed"
            >
              <p class="text-[11px] leading-relaxed">
                Sin tecnicismos innecesarios. Sin agencias complicadas. Una
                herramienta comercial lista para funcionar.
              </p>
            </div>

            <div class="p-3 bg-slate-100 rounded-xl text-center">
              <span class="text-xs font-semibold text-slate-900"
                >Lanzamiento 50% OFF:</span
              >
              <span class="font-bold text-emerald-600 text-xs ml-1"
                >$1.075.000 COP</span
              >
              <span class="text-[10px] text-slate-500 font-mono block mt-0.5"
                >Hasta el viernes 9 de octubre</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CONCEPTO DEL SERVICIO -->
    <section
      class="w-full max-w-7xl mx-auto px-6 py-16 border-b border-slate-200"
      id="concepto"
    >
      <div class="max-w-3xl mb-12 flex flex-col gap-3">
        <h2
          class="text-2xl md:text-4xl font-bold tracking-tight text-slate-900"
        >
          Cuando alguien te pregunta “¿tienes página?”, ¿qué le mandas?
        </h2>
        <p class="text-sm md:text-base text-slate-600 leading-relaxed">
          Muchas veces termina siendo el Instagram. O un catálogo. O un WhatsApp donde toca explicar todo otra vez.
        </p>
        <p class="text-sm md:text-base text-slate-600 leading-relaxed">
          La idea es tener un solo lugar donde esté lo importante de tu negocio, para que puedas mandarlo por WhatsApp, ponerlo en tu Instagram o compartirlo con cualquier persona que quiera conocerte.
        </p>
        <p class="text-sm md:text-base text-slate-600 leading-relaxed font-bold">
          Que quede claro: qué haces · qué ofreces · por qué confiar en ti · cómo contactarte
        </p>
        <p class="text-sm md:text-base text-slate-600 leading-relaxed">
          Yo me encargo de armar esa página contigo y dejarla funcionando.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Paso 01 -->
        <div
          class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-4"
        >
          <div
            class="w-10 h-10 rounded-xl bg-teal-50 border border-teal-200 text-teal-800 font-mono text-sm font-bold flex items-center justify-center"
          >
            01
          </div>
          <h3 class="text-lg font-bold text-slate-900">Me cuentas</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Me cuentas qué haces, qué vendes, quiénes son tus clientes y qué quieres conseguir con la página. No necesitas saber de diseño, código ni marketing.
          </p>
        </div>

        <!-- Paso 02 -->
        <div
          class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-4"
        >
          <div
            class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 font-mono text-sm font-bold flex items-center justify-center"
          >
            02
          </div>
          <h3 class="text-lg font-bold text-slate-900">Yo la construyo</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Con esa información armo la página: estructura, diseño, textos y todo lo necesario para que tu negocio se entienda rápido.
          </p>
        </div>

        <!-- Paso 03 -->
        <div
          class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col gap-4"
        >
          <div
            class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 font-mono text-sm font-bold flex items-center justify-center"
          >
            03
          </div>
          <h3 class="text-lg font-bold text-slate-900">La publicamos</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Configuramos dominio, certificado SSL, botones de WhatsApp y dejamos
            tu página 100% lista para recibir clientes.
          </p>
        </div>
      </div>
    </section>

    <!-- FORMULARIO CONVERSACIONAL (WIZARD PASO A PASO) -->
    <section
      class="w-full max-w-7xl mx-auto px-6 py-16 scroll-mt-20"
      id="diagnostico-conversacional"
    >
      <div class="max-w-3xl mx-auto flex flex-col gap-6">
        <!-- Contenedor Principal del Wizard Conversacional -->
        <div
          class="bg-white rounded-2xl border border-slate-200 shadow-md p-6 md:p-8 relative min-h-[420px] flex flex-col justify-between"
          id="form-container"
        >
          <!-- Header del Formulario / Barra de Progreso -->
          <div
            class="flex flex-col gap-2 pb-4 border-b border-slate-100"
            id="wizard-header"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
                ></span>
                <span
                  class="font-mono text-xs font-semibold text-slate-900 uppercase"
                  id="step-counter">Paso 1 de 9</span
                >
              </div>
              <span class="text-xs font-mono text-slate-400" id="step-time"
                >~2 min</span
              >
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
              <div
                class="bg-emerald-600 h-1.5 rounded-full transition-all duration-300 ease-out"
                id="progress-bar"
                style="width: 11.11%;"
              >
              </div>
            </div>
          </div>

          <!-- PANTALLA INTRO PRE-FORMULARIO -->
          <div class="wizard-step flex flex-col gap-5 py-4" id="step-intro">
            <div class="flex flex-col gap-2">
              <h2 class="text-2xl md:text-3xl font-bold text-slate-900">
                Quiero conocer tu negocio.
              </h2>
              <p class="text-sm text-slate-600 leading-relaxed">
                Preparé unas preguntas muy sencillas para entender qué haces, qué tienes hoy y qué estás buscando. No es un formulario técnico ni tienes que saber qué necesitas exactamente.
              </p>
              <p class="text-sm text-slate-600 leading-relaxed font-bold">
                Cuéntame primero. Después vemos qué tiene sentido hacer.
              </p>
            </div>
            <div class="pt-2">
              <button
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer"
                onclick="window.startSteps()"
                type="button"
              >
                <span>Quiero contarle sobre mi negocio</span>
              </button>
            </div>
          </div>

          <!-- PASOS... -->
        </div>
      </div>
    </section>

    <!-- SECCIÓN: SIN SORPRESAS -->
    <section class="w-full max-w-7xl mx-auto px-6 py-16" id="precios">
      <div class="bg-[#111827] p-8 md:p-12 rounded-3xl text-white">
        <div class="flex flex-wrap gap-2 mb-6">
            <span class="bg-emerald-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">LANZAMIENTO</span>
            <span class="bg-amber-500 text-slate-950 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">50% OFF</span>
            <span class="bg-slate-700 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Cupos limitados</span>
        </div>
        
        <h2 class="text-3xl font-bold mb-4">Una inversión clara y sin cobros ocultos.</h2>
        <p class="text-slate-400 mb-8 max-w-2xl">Aprovecha el precio especial de lanzamiento por tiempo limitado. Oferta válida hasta el viernes 9 de octubre.</p>
        
        <div class="grid md:grid-cols-2 gap-8 mb-8 items-center">
          <div>
            <h3 class="font-bold text-lg mb-4">Tu Página Comercial incluye:</h3>
            <ul class="space-y-3 text-slate-300">
              <li>Una página hecha para tu negocio</li>
              <li>Se ve bien en cualquier pantalla</li>
              <li>Dominio y configuración</li>
              <li>WhatsApp integrado</li>
              <li>Formulario de contacto</li>
              <li>Tus redes sociales</li>
              <li>SEO básico</li>
              <li>Te explico cómo funciona</li>
            </ul>
          </div>
          <div class="flex flex-col gap-2">
            <p class="text-slate-400">Precio habitual: <span class="line-through">$2.150.000 COP</span></p>
            <p class="text-6xl font-black text-emerald-400">$1.075.000 COP</p>
            <p class="text-slate-400 mb-6">≈ US$275 para clientes internacionales</p>
            <button
              class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-lg hover:bg-emerald-700 transition-colors shadow-sm cursor-pointer w-full"
              onclick="window.startCommercialForm()"
            >
              <span>Quiero mi página</span>
            </button>
            <p class="text-slate-500 text-sm text-center mt-2">Respuesta directa por WhatsApp con Pablo Ríos.</p>
          </div>
        </div>
        <p class="text-slate-500 text-sm">Oferta disponible hasta el 9 de octubre.</p>
      </div>
    </section>

    <SobreMi />

  </main>
  
  <!-- STICKY BAR -->
  <div class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-slate-200 p-4 shadow-lg md:hidden">
      <button
        class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors cursor-pointer"
        onclick="window.startCommercialForm()"
      >
        <span>Quiero mi página</span>
      </button>
  </div>
</Layout>
