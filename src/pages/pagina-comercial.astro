  <script>
    let currentStep = 0; // 0 = intro, 1..9 = pasos, 10 = result
    const totalSteps = 9;

    const selections: Record<string, any> = {
      empresa: '',
      dedicacion: '',
      ciudad: 'Bogotá',
      pais: 'Colombia',
      tieneWeb: '',
      queQuiereMejorar: '',
      tieneDominio: '',
      queTieneListo: [],
      objetivos: [],
      accionPrincipal: '',
      nombre: '',
      email: '',
      whatsapp: '',
    };

    function updateWizardProgress() {
      const counter = document.getElementById('step-counter');
      const bar = document.getElementById('progress-bar');
      const statusTag = document.getElementById('wizard-status-tag');
      const prevBtn = document.getElementById('btn-prev-step') as HTMLButtonElement | null;

      if (!counter || !bar) return;

      if (currentStep === 0) {
        counter.innerText = 'Paso 0 de 9';
        bar.style.width = '5%';
        if (statusTag) statusTag.innerText = 'Inicio';
        if (prevBtn) prevBtn.disabled = true;
      } else if (currentStep <= totalSteps) {
        const pct = (currentStep / totalSteps) * 100;
        counter.innerText = `Paso ${currentStep} de ${totalSteps}`;
        bar.style.width = `${pct}%`;
        if (statusTag) statusTag.innerText = `Paso ${currentStep}`;
        if (prevBtn) prevBtn.disabled = currentStep === 1;
      } else {
        counter.innerText = 'Cotización Lista';
        bar.style.width = '100%';
        if (statusTag) statusTag.innerText = 'Completado';
        if (prevBtn) prevBtn.disabled = false;
      }
    }

    function goToStep(step: number) {
      document.querySelectorAll('.wizard-step').forEach(el => el.classList.add('hidden'));

      currentStep = step;
      if (step === 0) {
        const intro = document.getElementById('step-intro');
        if (intro) intro.classList.remove('hidden');
      } else if (step <= totalSteps) {
        const target = document.getElementById(`step-${step}`);
        if (target) target.classList.remove('hidden');
      } else {
        const res = document.getElementById('step-result');
        if (res) res.classList.remove('hidden');
      }

      updateWizardProgress();
    }

    function startSteps() {
      if ((window as any).posthog) {
        (window as any).posthog.capture('page_commercial_form_started');
      }
      goToStep(1);
    }

    function startCommercialForm() {
      const el = document.getElementById('diagnostico-conversacional');
      if (el) el.scrollIntoView({ behavior: 'smooth' });
      if (currentStep === 0) {
        startSteps();
      }
    }

    function prevStep() {
      if (currentStep > 1 && currentStep <= totalSteps) {
        goToStep(currentStep - 1);
      } else if (currentStep > totalSteps) {
        goToStep(totalSteps);
      }
    }

    function validateAndNext(step: number) {
      if (step === 1) {
        const inp = document.getElementById('input-empresa') as HTMLInputElement | null;
        const val = inp?.value.trim() || '';
        if (!val) {
          alert('Por favor escribe el nombre de tu negocio.');
          return;
        }
        selections.empresa = val;
        goToStep(2);
      } else if (step === 2) {
        const inp = document.getElementById('input-dedicacion') as HTMLTextAreaElement | null;
        const val = inp?.value.trim() || '';
        if (!val) {
          alert('Por favor cuéntame brevemente a qué se dedica tu negocio.');
          return;
        }
        selections.dedicacion = val;
        goToStep(3);
      } else if (step === 3) {
        const cd = (document.getElementById('input-ciudad') as HTMLInputElement | null)?.value.trim() || 'Bogotá';
        const ps = (document.getElementById('input-pais') as HTMLInputElement | null)?.value.trim() || 'Colombia';
        selections.ciudad = cd;
        selections.pais = ps;
        goToStep(4);
      }
    }

    function selectTieneWeb(val: string, btn: HTMLElement) {
      selections.tieneWeb = val;

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      const sub = document.getElementById('subquestion-mejorar');
      if (val.includes('Sí') || val.includes('Tengo')) {
        if (sub) sub.classList.remove('hidden');
      } else {
        if (sub) sub.classList.add('hidden');
        selections.queQuiereMejorar = 'Partir desde cero';
        setTimeout(() => goToStep(5), 250);
      }
    }

    function selectQueMejorar(val: string, btn: HTMLElement) {
      selections.queQuiereMejorar = val;

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-suboption').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50', 'text-emerald-900', 'font-bold');
        });
      }
      btn.classList.add('border-emerald-600', 'bg-emerald-50', 'text-emerald-900', 'font-bold');

      setTimeout(() => goToStep(5), 250);
    }

    function selectDominio(val: string, btn: HTMLElement) {
      selections.tieneDominio = val;

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      const nudge = document.getElementById('nudge-dominio');
      if (val.includes('No sé') || val.includes('No')) {
        if (nudge) nudge.classList.remove('hidden');
      } else {
        if (nudge) nudge.classList.add('hidden');
      }

      setTimeout(() => goToStep(6), 300);
    }

    function toggleMultiOption(category: 'queTieneListo' | 'objetivos', optionVal: string, btn: HTMLElement) {
      const list: string[] = selections[category] || [];
      const idx = list.indexOf(optionVal);

      if (idx >= 0) {
        list.splice(idx, 1);
        btn.classList.remove('border-teal-700', 'bg-teal-50', 'text-teal-900', 'font-bold');
        btn.classList.add('border-slate-200', 'text-slate-700');
      } else {
        list.push(optionVal);
        btn.classList.remove('border-slate-200', 'text-slate-700');
        btn.classList.add('border-teal-700', 'bg-teal-50', 'text-teal-900', 'font-bold');
      }

      selections[category] = list;
    }

    function selectAccion(val: string, btn: HTMLElement) {
      selections.accionPrincipal = val;

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      const nudge = document.getElementById('nudge-accion');
      if (val.includes('WhatsApp') && nudge) {
        nudge.classList.remove('hidden');
      } else if (nudge) {
        nudge.classList.add('hidden');
      }

      setTimeout(() => goToStep(9), 300);
    }

    async function submitCommercialLead() {
      const nomInput = document.getElementById('input-nombre') as HTMLInputElement | null;
      const emInput = document.getElementById('input-email') as HTMLInputElement | null;
      const waInput = document.getElementById('input-whatsapp') as HTMLInputElement | null;
      const submitBtn = document.getElementById('btn-submit-lead') as HTMLButtonElement | null;

      const nom = nomInput?.value.trim() || '';
      const em = emInput?.value.trim() || '';
      const wa = waInput?.value.trim() || '';

      if (!nom) {
        alert('Por favor ingresa tu nombre.');
        return;
      }

      if (!em || !em.includes('@')) {
        alert('Por favor ingresa un correo electrónico válido.');
        return;
      }

      if (!wa) {
        alert('Por favor ingresa tu número de WhatsApp.');
        return;
      }

      selections.nombre = nom;
      selections.email = em;
      selections.whatsapp = wa;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Procesando tu solicitud...';
      }

      try {
        const res = await fetch('/api/page-commercial-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: selections.nombre,
            email: selections.email,
            whatsapp: selections.whatsapp,
            empresa: selections.empresa,
            dedicacion: selections.dedicacion,
            ciudad: selections.ciudad,
            pais: selections.pais,
            tieneWeb: selections.tieneWeb,
            queQuiereMejorar: selections.queQuiereMejorar,
            tieneDominio: selections.tieneDominio,
            queTieneListo: selections.queTieneListo,
            objetivos: selections.objetivos,
            accionPrincipal: selections.accionPrincipal,
          }),
        });

        const result = await res.json();
        if (!res.ok && result.error) {
          alert(result.error);
        }
      } catch (err) {
        console.error('Error enviando lead comercial:', err);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Ver mi propuesta personalizada →';
        }
      }

      // Populate Result Screen
      const leadText = document.getElementById('result-summary-lead');
      if (leadText) {
        leadText.innerHTML = `
          Para <strong>${selections.empresa}</strong> (${selections.ciudad}, ${selections.pais}), la página comercial estará optimizada para conectar directamente con tus clientes potenciales.
        `;
      }

      const bulletsContainer = document.getElementById('result-bullets');
      if (bulletsContainer) {
        const listItems = [
          `Presentar ${selections.dedicacion ? selections.dedicacion.substring(0, 60) : 'tus servicios'} con total claridad.`,
          `Posicionar la marca de ${selections.empresa} en ${selections.ciudad}.`,
          `Llevar prospectos a ${selections.accionPrincipal || 'conversar por WhatsApp'}.`,
          `Tener un canal digital corporativo propio.`,
        ];
        bulletsContainer.innerHTML = listItems
          .map(item => `<li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> ${item}</li>`)
          .join('');
      }

      const noteEl = document.getElementById('result-context-note');
      if (noteEl) {
        if (selections.tieneWeb && (selections.tieneWeb.includes('Sí') || selections.tieneWeb.includes('Tengo'))) {
          noteEl.innerText = `Podemos partir de lo que ya tienes en tu web actual y renovar lo que no está funcionando (${selections.queQuiereMejorar || 'diseño y conversión'}).`;
        } else {
          noteEl.innerText = `Podemos construirla desde cero y dejarla lista para empezar a recibir visitas y contactos.`;
        }
      }

      const waBtn = document.getElementById('result-wa-btn') as HTMLAnchorElement | null;
      if (waBtn) {
        const msg = encodeURIComponent(
          `Hola Pablo, completé el formulario de Página Comercial para ${selections.empresa} en ${selections.ciudad}:\n\n` +
          `• Negocio: ${selections.empresa}\n` +
          `• Actividad: ${selections.dedicacion}\n` +
          `• Ubicación: ${selections.ciudad}, ${selections.pais}\n` +
          `• Web actual: ${selections.tieneWeb} (${selections.queQuiereMejorar || 'N/A'})\n` +
          `• Acción deseada: ${selections.accionPrincipal}\n` +
          `• Contacto: ${selections.nombre} (${selections.email})\n\n` +
          `Quiero revisar la propuesta de $1.075.000 COP con la oferta de lanzamiento.`
        );
        waBtn.href = `https://wa.me/573053046180?text=${msg}`;
      }

      if ((window as any).posthog) {
        (window as any).posthog.capture('page_commercial_form_completed', {
          has_website: selections.tieneWeb,
          has_domain: selections.tieneDominio,
          city: selections.ciudad,
          country: selections.pais,
          main_action: selections.accionPrincipal,
        });
        (window as any).posthog.capture('page_commercial_lead_submitted', {
          city: selections.ciudad,
          country: selections.pais,
          has_website: selections.tieneWeb,
          main_action: selections.accionPrincipal,
        });
      }

      goToStep(10);
    }

    // Attach functions to window
    (window as any).startSteps = startSteps;
    (window as any).startCommercialForm = startCommercialForm;
    (window as any).goToStep = goToStep;
    (window as any).prevStep = prevStep;
    (window as any).validateAndNext = validateAndNext;
    (window as any).selectTieneWeb = selectTieneWeb;
    (window as any).selectQueMejorar = selectQueMejorar;
    (window as any).selectDominio = selectDominio;
    (window as any).toggleMultiOption = toggleMultiOption;
    (window as any).selectAccion = selectAccion;
    (window as any).submitCommercialLead = submitCommercialLead;

    document.addEventListener('DOMContentLoaded', () => {
      updateWizardProgress();

      if ((window as any).posthog) {
        (window as any).posthog.capture('page_commercial_view', {
          url: window.location.href,
        });
      }
    });
  </script>
</Layout>
