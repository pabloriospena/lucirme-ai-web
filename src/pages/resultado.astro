---
import Layout from '../layouts/Layout.astro';

// Obtenemos los parámetros desde la URL
const perfil = Astro.url.searchParams.get('perfil') || 'pro';
const dolor = Astro.url.searchParams.get('dolor') || 'Operativa';

// 1. Lógica de Negocio (El Cerebro)
const obtenerRecomendacion = (perfil: string) => {
  if (perfil === 'startup') {
    return {
      titulo: "🚀 Diagnóstico: Fuga de Foco en Startup",
      accion: "Reserva tu Taller de Inmersión (2-3 horas) y alinea a tu equipo en un flujo prioritario.",
      producto: "Taller de Inmersión",
      link: "https://calendar.app.google/k4iYmA42X9NNBb5t8",
      potencial: { horas: "8-12", pct: 85 }
    };
  }
  if (perfil === 'empresa') {
    return {
      titulo: "🏢 Diagnóstico: Fricción Operativa detectada",
      accion: "Coordina un Taller de Inmersión y valida el impacto operativo antes de escalar.",
      producto: "Taller de Inmersión",
      link: "https://calendar.app.google/k4iYmA42X9NNBb5t8",
      potencial: { horas: "12-15", pct: 90 }
    };
  }
  // Default: Profesional
  return {
    titulo: "👤 Diagnóstico: Foco Atascado",
    accion: "Agenda tu Sesión de Enfoque (1 hora) y configura tu primer flujo de IA hoy mismo.",
    producto: "Sesión de Enfoque",
    link: "https://calendar.app.google/k4iYmA42X9NNBb5t8",
    potencial: { horas: "5-8", pct: 60 }
  };
};

const res = obtenerRecomendacion(perfil);
---

<Layout title="Tu Diagnóstico | LuciRMe Ai">
  <main class="max-w-3xl mx-auto py-20 px-6">
    
    <!-- Badge de Estado -->
    <div class="text-center mb-8">
      <span class="inline-block bg-teal/10 text-teal text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full border border-teal/20">
        {res.titulo}
      </span>
    </div>

    <!-- Diagnóstico -->
    <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-sm mb-10">
      <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Fricción identificada</h3>
      <p class="text-lg text-gray-700 mb-8">{dolor}</p>
      
      <!-- Indicador visual de evolución -->
      <div class="bg-teal/5 border border-teal/10 rounded-xl p-4 mb-8">
        <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-bold text-deep">Potencial de recuperación</span>
            <span class="text-sm font-bold text-teal">{res.potencial.horas} h/semana</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2">
            <div class="bg-teal h-2 rounded-full" style={`width: ${res.potencial.pct}%`}></div>
        </div>
      </div>

      <h3 class="text-xs font-bold text-orange uppercase tracking-widest mb-4">Acción concreta</h3>
      <p class="text-xl font-bold text-deep leading-relaxed">{res.accion}</p>
    </div>

    <!-- Recursos -->
    <h2 class="text-lg font-bold text-deep mb-6">Recursos para avanzar solo</h2>
    <div class="grid md:grid-cols-2 gap-4 mb-12">
        <a href="/recursos/backlog-detox" class="p-4 border border-gray-200 rounded-lg hover:border-teal transition text-sm font-medium text-gray-700">
            🧹 Backlog Detox (Plantilla)
        </a>
        <a href="/recursos/guia-notebooklm" class="p-4 border border-gray-200 rounded-lg hover:border-teal transition text-sm font-medium text-gray-700">
            📘 Guía NotebookLM
        </a>
        <a href="/recursos/shapeup-builder" class="p-4 border border-gray-200 rounded-lg hover:border-teal transition text-sm font-medium text-gray-700">
            📘 ShapeUp Builder
        </a>
    </div>

    <!-- CTA Principal -->
    <a href={res.link} class="block w-full bg-teal text-white font-bold py-5 rounded-xl text-center hover:bg-tealHover transition shadow-lg text-lg mb-8">
      Reservar {res.producto} →
    </a>

    <!-- Ebook Bonus -->
    <div class="bg-deep text-white p-6 rounded-xl text-center mb-10">
        <p class="text-sm mb-4">¿Quieres profundizar? Ebook "PM Sin Bullshit"</p>
        <a href="https://pay.hotmart.com/D96093022S?off=OFF50" class="text-teal font-bold hover:underline">Obtener por 50% OFF →</a>
    </div>

    <p class="text-xs text-gray-400 text-center uppercase tracking-widest">30 minutos · 100% gratis · Sin venta · Sin presión.</p>
  </main>
</Layout>