---
import LayoutV2 from '../layouts/LayoutV2.astro';
import { LINKS } from '../lib/constants';

// 1. Obtenemos los parámetros dinámicos de la URL
const perfil = Astro.url.searchParams.get('perfil') || 'individual';
const dolor = Astro.url.searchParams.get('dolor') || 'Operativa repetitiva';

// Leemos las 3 acciones del query param
const act1 = Astro.url.searchParams.get('act1') || 'Mapea tus procesos manuales.';
const act2 = Astro.url.searchParams.get('act2') || 'Identifica la mayor fuga de tiempo.';
const act3 = Astro.url.searchParams.get('act3') || 'Aplica IA en el paso crítico.';

const acciones = [act1, act2, act3];

// 2. Lógica de "Nivel de Evolución Potencial" (Fórmula de Negocio)
function calcularPotencial(dolorPrincipal: string) {
  const dolorLower = dolorPrincipal.toLowerCase();
  if (dolorLower.includes('reportes') || dolorLower.includes('manual') || dolorLower.includes('copiar')) {
    return { horas: '10-12', porcentaje: 85 };
  }
  if (dolorLower.includes('decisión') || dolorLower.includes('backlog') || dolorLower.includes('roadmap')) {
    return { horas: '8-10', porcentaje: 75 };
  }
  if (dolorLower.includes('aprobaciones') || dolorLower.includes('silos')) {
    return { horas: '12-15', porcentaje: 90 };
  }
  return { horas: '5-8', porcentaje: 60 };
}

const potencial = calcularPotencial(dolor);

// 3. Matriz de Contenido Dinámico por Perfil
const configs = {
  individual: {
    badge: "Profesional Independiente",
    friccion: "Operativa repetitiva que consume tu tiempo de valor.",
    siguientePaso: `Agenda tu Sesión de Enfoque (1 hora) y configura tu primer flujo de IA hoy mismo.`,
    recursos: [
      { titulo: "Guía NotebookLM", desc: "De notas sueltas a reportes listos.", url: "/recursos/guia-notebooklm" },
      { titulo: "Backlog Detox", desc: "Limpia tus tareas y prioriza.", url: "/recursos/backlog-detox" }
    ]
  },
  startup: {
    badge: "Startup / Equipo",
    friccion: "Decisiones de producto sin protocolo claro.",
    siguientePaso: `Reserva tu Taller de Inmersión (2-3 horas) y alinea a tu equipo en un flujo prioritario.`,
    recursos: [
      { titulo: "Pitch Builder", desc: "Genera prompts estratégicos en 10 min.", url: "/recursos/shapeup-builder" },
      { titulo: "Backlog Detox", desc: "Filtra el ruido de tus tableros.", url: "/recursos/backlog-detox" }
    ]
  },
  empresa: {
    badge: "Empresa / Organización",
    friccion: "Procesos manuales que generan errores y lentitud.",
    siguientePaso: `Coordina un Taller de Inmersión con tu área y valida el impacto antes de escalar.`,
    recursos: [
      { titulo: "Guía NotebookLM", desc: "Estructura tus reportes ejecutivos.", url: "/recursos/guia-notebooklm" },
      { titulo: "JobPrompt AI", desc: "Encuentra vacantes de élite con IA.", url: "/recursos/job-prompt-ai" }
    ]
  }
};

const currentConfig = configs[perfil as keyof typeof configs] || configs.individual;
---

<LayoutV2 title="Tu diagnóstico de foco | LuciRMe AI">
  <main class="mx-auto flex w-full max-w-[720px] flex-col gap-8 px-4 pb-16 pt-6 sm:px-6">
    <header class="flex flex-col items-center gap-3 text-center">
      <span class="rounded-full border-[0.8px] border-v2-marca-borde bg-v2-marca-tinte px-3.5 py-1.5 font-mono text-xs font-semibold uppercase tracking-[0.6px] text-v2-marca-texto">{currentConfig.badge}</span>
      <h1 class="text-[34px] font-extrabold leading-[1.14] tracking-[-0.9px] text-v2-texto sm:text-[44px]">Tu foco reveló esto</h1>
    </header>

    <section class="flex flex-col gap-7 rounded-3xl border-[0.8px] border-v2-borde bg-v2-fondo p-6 sm:p-8">
      <div class="flex flex-col gap-2">
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.6px] text-v2-suave">Fricción identificada</h2>
        <p class="text-lg leading-7 text-v2-texto">{dolor}</p>
      </div>

      <div class="flex flex-col gap-3 rounded-2xl border-[0.8px] border-v2-marca-borde bg-v2-marca-tinte p-5">
        <div class="flex items-center justify-between gap-3">
          <span class="text-sm font-bold text-v2-texto">Potencial de recuperación</span>
          <span class="text-sm font-bold text-v2-marca-texto">{potencial.horas} h por semana</span>
        </div>
        <div class="h-2 w-full overflow-hidden rounded-full bg-v2-barra-fondo" role="img" aria-label={`Potencial de recuperación: ${potencial.porcentaje} por ciento`}>
          <div class="h-2 rounded-full bg-v2-barra-relleno" style={`width: ${potencial.porcentaje}%`}></div>
        </div>
        <p class="text-xs leading-4 text-v2-cuerpo">Estimado según tu contexto operativo actual.</p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.6px] text-v2-pago-texto">Acciones concretas para esta semana</h2>
        <ul class="flex flex-col gap-3">
          {acciones.map((act) => (
            <li class="flex items-start gap-3 text-base leading-6 text-v2-cuerpo">
              <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-v2-accion" aria-hidden="true"></span>
              <span>{act}</span>
            </li>
          ))}
        </ul>
        <p class="text-sm leading-5 text-v2-suave">{currentConfig.siguientePaso}</p>
      </div>

      <div class="flex flex-col gap-3 border-t-[0.8px] border-v2-borde pt-6">
        <a
          href={LINKS.calendly}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-v2-accion px-7 text-base font-bold text-v2-accion-texto hover:bg-v2-accion-hover"
        >Agendar Café Estratégico</a>
        <p class="text-center text-xs leading-4 text-v2-cuerpo">30 minutos, sin venta y sin presión. Si en 15 minutos ves que no es para ti, cerramos igual.</p>
      </div>
    </section>

    <section aria-labelledby="recursos" class="flex flex-col gap-4">
      <h2 id="recursos" class="text-xl font-bold tracking-[-0.3px] text-v2-texto">Recursos para empezar hoy</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {currentConfig.recursos.map((r) => (
          <a href={r.url} class="flex flex-col gap-2 rounded-2xl border-[0.8px] border-v2-borde bg-v2-fondo p-5 hover:border-v2-accion">
            <h3 class="text-base font-bold text-v2-texto">{r.titulo}</h3>
            <p class="text-sm leading-5 text-v2-cuerpo">{r.desc}</p>
            <span class="text-sm font-semibold text-v2-accion">Explorar recurso</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</LayoutV2>
