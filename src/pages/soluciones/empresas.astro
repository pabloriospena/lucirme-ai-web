---
import Layout from "../../layouts/Layout.astro";
import { LINKS } from "../../lib/constants.js";
---

<Layout title="IA para Empresas y Startups | LuciRMe Ai">
  <!-- HERO -->
  <header class="py-24 px-4 bg-[#F8FAFC] border-b border-gray-100">
    <div class="max-w-4xl mx-auto text-center">
      <span
        class="inline-block bg-teal/10 text-teal text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-md mb-6"
      >
        Para Startups y Equipos de Producto
      </span>
      <h1 class="text-4xl md:text-5xl font-bold text-deep leading-tight mb-6">
        Reduce la fricción operativa un 40%.<br />
        <span class="text-teal">Sin migrar de herramientas.</span>
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed mb-10 max-w-2xl mx-auto">
        Integramos IA en tus flujos actuales (Jira, Slack, Notion) para que tu
        equipo deje de hacer "trabajo de robots" y se enfoque en construir
        producto.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a
          href={LINKS.calendly_empresa}
          class="inline-flex items-center justify-center gap-2 bg-orange hover:bg-orange/90 text-white px-8 py-4 rounded-lg font-bold transition shadow-lg"
        >
          Agendar Diagnóstico Operativo →
        </a>
        <a
          href="#precios"
          class="inline-flex items-center justify-center gap-2 bg-white border border-gray-300 text-deep px-8 py-4 rounded-lg font-bold hover:bg-gray-50 transition"
        >
          Ver Sesiones y talleres
        </a>
      </div>

      <!-- LOGOS DE AUTORIDAD (CRUCIAL PARA B2B) -->
      <div class="pt-8 border-t border-gray-200">
        <p class="text-xs text-gray-400 uppercase tracking-widest mb-4">
          Metodología aplicada en equipos de:
        </p>
        <div
          class="flex flex-wrap justify-center gap-8 opacity-60 grayscale hover:grayscale-0 transition-all duration-500"
        >
          <!-- Reemplaza esto con tus imágenes de logos reales -->
          <span class="font-bold text-xl text-gray-600">Irys</span>
          <span class="font-bold text-xl text-gray-600"
            >Fundación La Chinca</span
          >
          <span class="font-bold text-xl text-gray-600"
            >Asesorías Integrales</span
          >
          <span class="font-bold text-xl text-gray-600">Almamotor</span>
          <span class="font-bold text-xl text-gray-600">InterobrasER</span>
        </div>
      </div>
    </div>
  </header>

  <!-- SECCIÓN: EL DOLOR DEL LÍDER -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-deep mb-12 text-center">
        ¿Tu operación está frenando tu crecimiento?
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        {
          [
            "Tu equipo senior pierde 10h/semana en reportes manuales y coordinación.",
            "Los datos viven en silos: Jira dice una cosa, Excel dice otra.",
            "Quieres innovar con IA, pero te da miedo detener la operación actual.",
            "Los errores manuales en procesos críticos están costando clientes.",
          ].map((dolor) => (
            <div class="flex gap-4 p-6 bg-slate-50 rounded-xl border border-gray-100 hover:border-teal transition-all group">
              <span class="text-orange text-xl font-bold group-hover:scale-110 transition-transform">
                ⚠️
              </span>
              <p class="text-sm text-gray-700 leading-relaxed font-medium">
                {dolor}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SECCIÓN: IMPACTO FINANCIERO/OPERATIVO -->
  <section class="py-20 px-4 bg-[#F8FAFC]">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-deep text-center mb-12">
        De Cuellos de Botella a Autonomía
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="border border-gray-200 rounded-2xl p-8 bg-white shadow-sm">
          <h3 class="font-bold text-gray-500 mb-6 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-400"></span> Operación Actual
          </h3>
          <ul class="space-y-4 text-sm text-gray-600">
            <li class="flex gap-3">
              <span>✕</span>
              <strong>Costo Oculto:</strong> Salarios senior usados en tareas junior.
            </li>
            <li class="flex gap-3">
              <span>✕</span>
              <strong>Lentitud:</strong> Decisiones basadas en datos de la semana
              pasada.
            </li>
            <li class="flex gap-3">
              <span>✕</span>
              <strong>Fricción:</strong> El equipo se frustra copiando/pegando información.
            </li>
          </ul>
        </div>
        <div class="border border-teal/30 rounded-2xl p-8 bg-teal/5 shadow-md">
          <h3 class="font-bold text-teal mb-6 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-teal"></span> Con LuciRMe
          </h3>
          <ul class="space-y-4 text-sm text-gray-700 font-medium">
            <li class="flex gap-3">
              <span>✓</span>
              <strong>ROI Inmediato:</strong> Recuperas ~40h/mes por empleado clave.
            </li>
            <li class="flex gap-3">
              <span>✓</span>
              <strong>Velocidad:</strong> Reportes y alertas en tiempo real.
            </li>
            <li class="flex gap-3">
              <span>✓</span>
              <strong>Escalabilidad:</strong> Procesos que crecen sin necesitar más
              gente.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN PRECIOS (ESTRATEGIA B2B) -->
  <section id="precios" class="py-24 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-deep mb-4">
          Inversión en tu crecimiento
        </h2>
        <p class="text-gray-600">
          Inversión flexible, sin contratos de mantenimiento eternos.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 items-start">
        <!-- Taller: Producto de Entrada (Tripwire) -->
        <div
          class="bg-white p-8 rounded-2xl border-2 border-gray-100 hover:border-teal transition-all relative group"
        >
          <div
            class="absolute top-0 right-0 bg-gray-100 text-gray-600 text-[10px] font-bold uppercase tracking-widest px-4 py-1 rounded-bl-lg"
          >
            Inicio Rápido
          </div>
          <h3 class="font-bold text-deep text-xl mb-2">Taller de Inmersión</h3>
          <p class="text-xs text-gray-500 uppercase tracking-widest mb-6">
            Workshop de 2-3 horas con tu equipo
          </p>

          <!-- <div class="text-3xl font-bold text-deep mb-6">
            $620.000 COP <span class="text-sm font-normal text-gray-400"
              >/ $170 USD</span
            >
          </div>-->

          <ul class="space-y-3 text-sm text-gray-600 mb-8">
            <li class="flex gap-2">
              <span class="text-teal">✓</span> Auditoría en vivo de tus procesos.
            </li>
            <li class="flex gap-2">
              <span class="text-teal">✓</span> Configuración de 1 flujo prioritario.
            </li>
            <li class="flex gap-2">
              <span class="text-teal">✓</span> Hoja de ruta de implementación.
            </li>
          </ul>

          <a
            href={LINKS.calendly_taller}
            class="block w-full bg-white border-2 border-deep text-deep font-bold py-3 rounded-lg text-center hover:bg-deep hover:text-white transition"
          >
            Reservar Taller
          </a>
        </div>

        <!-- Ciclo: Producto Principal (High Ticket) -->
        <div
          class="bg-slate-50 p-8 rounded-2xl border-2 border-teal shadow-xl relative transform md:-translate-y-4"
        >
          <div
            class="absolute top-0 right-0 bg-teal text-white text-[10px] font-bold uppercase tracking-widest px-4 py-1 rounded-bl-lg"
          >
            Transformación Completa
          </div>
          <h3 class="font-bold text-deep text-xl mb-2">Ciclo de Autonomía</h3>
          <p class="text-xs text-teal font-bold uppercase tracking-widest mb-6">
            Implementación en 8 semanas
          </p>

          <!-- <div class="text-3xl font-bold text-deep mb-6">
            Desde $8.8M COP <span class="text-sm font-normal text-gray-400"
              >/ $2.6k USD</span
            >
          </div>-->

          <ul class="space-y-3 text-sm text-gray-700 font-medium mb-8">
            <li class="flex gap-2">
              <span class="text-teal">✓</span> Automatización de 3-5 flujos complejos
              por sesión.
            </li>
            <li class="flex gap-2">
              <span class="text-teal">✓</span> Capacitación y documentación del equipo.
            </li>
            <li class="flex gap-2">
              <span class="text-teal">✓</span> Soporte post-implementación de 30 días.
            </li>
          </ul>

          <a
            href={LINKS.calendly_empresa}
            class="block w-full bg-teal text-white font-bold py-3 rounded-lg text-center hover:bg-teal/90 transition shadow-lg"
          >
            Agendar Diagnóstico Gratuito
          </a>
          <p class="text-xs text-center text-gray-500 mt-3">
            Para validar si este ciclo es viable para tu empresa.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
