---
import Layout from "../../layouts/Layout.astro";
import { LINKS } from "../../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const ctaDescuentoWA = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, quiero aprovechar la oferta de lanzamiento (50% OFF) para la Página Comercial de mi restaurante.")}`;
---

<Layout
  title="Página Web para Restaurantes | LuciRMe AI"
  description="Creamos páginas comerciales profesionales para restaurantes que quieren mostrar su menú, generar confianza y facilitar reservas y contacto con sus clientes."
  hideHeader={true}
  hideFooter={true}
>
  <!-- HEADER DEDICADO RESTAURANTES -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="h-16 max-w-7xl mx-auto px-6 flex items-center justify-between gap-4">
      <a class="flex flex-col group" href="#">
        <span class="text-base font-bold tracking-tight text-slate-900 group-hover:text-teal-700 transition-colors">LuciRMe AI · Restaurantes</span>
        <span class="text-[11px] font-mono text-slate-500">Página comercial profesional para restaurantes y gastronomía</span>
      </a>

      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600">
        <a class="hover:text-slate-900 transition-colors" href="#diagnostico-restaurante">Diagnóstico 2 min</a>
        <a class="hover:text-slate-900 transition-colors" href="#que-incluye">Qué incluye</a>
        <a class="hover:text-slate-900 transition-colors" href="#ejemplos-restaurante">Ejemplos</a>
        <a class="hover:text-slate-900 transition-colors" href="#pablo">Pablo</a>
        <a class="hover:text-slate-900 transition-colors font-bold text-amber-700" href="#oferta-precio">Lanzamiento 50% OFF</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-teal-700 text-white text-xs font-semibold hover:bg-teal-800 transition-colors shadow-2xs cursor-pointer"
          href="#diagnostico-restaurante"
        >
          <span class="material-symbols-outlined text-[17px]">restaurant</span>
          <span>Empezar diagnóstico</span>
        </a>
      </div>
    </div>
  </header>

  <main class="w-full bg-[#F8FAFC]">

    <!-- HERO SECTION -->
    <section class="w-full max-w-7xl mx-auto px-6 pt-12 pb-12 md:py-20 border-b border-slate-200/60">
      <div class="max-w-3xl mx-auto flex flex-col items-center text-center gap-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-teal-50 border border-teal-200/80 rounded-full font-mono text-xs text-teal-800 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"></span>
          Especial para restaurantes y negocios gastronómicos
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
          ¿Tu restaurante depende demasiado de Instagram y WhatsApp?
        </h1>

        <p class="text-base md:text-lg text-slate-600 font-normal leading-relaxed">
          Tus clientes quieren saber qué vendes, ver tu menú, saber dónde estás, cuándo abres y cómo reservar. Si hoy tienen que buscar esa información entre Instagram, WhatsApp, Google y otros enlaces, podemos organizarlo mejor.
        </p>

        <div class="p-5 bg-white border border-slate-200 rounded-2xl shadow-xs w-full max-w-xl flex flex-col items-center gap-3 mt-2">
          <h2 class="text-base font-bold text-slate-900">
            Hagamos una prueba rápida 🍽️
          </h2>
          <p class="text-xs text-slate-600 leading-relaxed">
            En menos de 2 minutos te ayudo a definir qué debería tener la página de tu restaurante.
          </p>
          <a
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer w-full sm:w-auto"
            href="#diagnostico-restaurante"
            onclick="if(window.posthog) window.posthog.capture('diagnostic_started', { tipo_de_pagina: 'restaurante' });"
          >
            <span>Empezar diagnóstico →</span>
          </a>
        </div>

      </div>
    </section>

    <!-- COMPONENTE DIAGNÓSTICO CONVERSACIONAL (RestaurantDiagnostic) -->
    <section class="w-full max-w-7xl mx-auto px-6 py-12 scroll-mt-20" id="diagnostico-restaurante">
      <div class="max-w-2xl mx-auto flex flex-col gap-6">

        <div class="bg-white rounded-2xl border border-slate-200 shadow-md p-6 md:p-8 relative min-h-[400px] flex flex-col justify-between" id="rest-wizard-card">
          
          <!-- Wizard Header -->
          <div class="flex flex-col gap-2 pb-4 border-b border-slate-100" id="rest-wizard-header">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="font-mono text-xs font-semibold text-slate-900 uppercase" id="rest-step-counter">Paso 1 de 7</span>
              </div>
              <span class="text-xs font-mono text-slate-400" id="rest-step-time">~2 min</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
              <div class="bg-emerald-600 h-1.5 rounded-full transition-all duration-300 ease-out" id="rest-progress-bar" style="width: 14.28%;"></div>
            </div>
          </div>

          <!-- PASO 1: NOMBRE -->
          <div class="rest-step flex flex-col gap-4 py-4" id="rest-step-1">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 1 · Identidad</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">Cuéntame un poco de tu restaurante 🍽️</h3>
              <p class="text-sm text-slate-600">¿Cómo se llama tu restaurante o negocio gastronómico?</p>
            </div>
            <div class="flex flex-col gap-3 pt-2">
              <input
                class="w-full text-sm px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none bg-white transition-colors"
                id="rest-input-nombre"
                placeholder="Ej. Restaurante La Terraza / Trattoria Bella Vista..."
                type="text"
              />
              <button
                class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-teal-700 text-white font-semibold text-sm hover:bg-teal-800 transition-colors cursor-pointer self-start"
                onclick="window.restNextStep(1)"
                type="button"
              >
                <span>Continuar →</span>
              </button>
            </div>
          </div>

          <!-- PASO 2: CANAL ACTUAL -->
          <div class="rest-step hidden flex flex-col gap-4 py-4" id="rest-step-2">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 2 · Información</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Cómo encuentran hoy tus clientes la información sobre tu restaurante?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-rest-canal">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectCanal('Instagram', this)" type="button">📸 Instagram</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectCanal('WhatsApp', this)" type="button">💬 WhatsApp</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectCanal('Google', this)" type="button">🔍 Google</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectCanal('Facebook', this)" type="button">👥 Facebook</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectCanal('Página web', this)" type="button">🌐 Página web</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectCanal('Una combinación de varias', this)" type="button">🔀 Una combinación de varias</button>
              <button class="diag-option sm:col-span-2 px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectCanal('Otro', this)" type="button">Otro</button>
            </div>
            <div class="hidden p-3 bg-teal-50 border border-teal-200 rounded-xl text-xs text-teal-900 font-medium" id="rest-nudge-canal"></div>
          </div>

          <!-- PASO 3: BÚSQUEDA DE MENÚ O SERVICIOS -->
          <div class="rest-step hidden flex flex-col gap-4 py-4" id="rest-step-3">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 3 · Menú y Experiencia</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">Cuando alguien quiere conocer tu menú o lo que ofreces, ¿qué tiene que hacer?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-rest-menu">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectMenu('Buscar publicaciones', this)" type="button">Buscar publicaciones</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectMenu('Escribirte por WhatsApp', this)" type="button">Escribirte por WhatsApp</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectMenu('Preguntar directamente', this)" type="button">Preguntar directamente</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectMenu('Revisar varios enlaces', this)" type="button">Revisar varios enlaces</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectMenu('Buscar en Google', this)" type="button">Buscar en Google</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectMenu('Ver un menú digital', this)" type="button">Ver un menú digital</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectMenu('Ya tenemos todo organizado', this)" type="button">Ya tenemos todo organizado</button>
            </div>
          </div>

          <!-- PASO 4: LO QUE QUEREMOS RESOLVER -->
          <div class="rest-step hidden flex flex-col gap-4 py-4" id="rest-step-4">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 4 · Propósito</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">Si tuvieras una página para tu restaurante, ¿qué te gustaría que resolviera principalmente?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-rest-resolver">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectResolver('Mostrar mi menú', this)" type="button">Mostrar mi menú</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectResolver('Conseguir más clientes', this)" type="button">Conseguir más clientes</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectResolver('Llevar personas a WhatsApp', this)" type="button">Llevar personas a WhatsApp</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectResolver('Facilitar reservas', this)" type="button">Facilitar reservas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectResolver('Mostrar ubicación y horarios', this)" type="button">Mostrar ubicación y horarios</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectResolver('Aparecer mejor en Google', this)" type="button">Aparecer mejor en Google</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectResolver('Tener toda la información en un solo lugar', this)" type="button">Tener todo en un solo lugar</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectResolver('Mostrar una imagen más profesional', this)" type="button">Imagen más profesional</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectResolver('Varias de las anteriores', this)" type="button">Varias de las anteriores</button>
            </div>
          </div>

          <!-- PASO 5: WEB ACTUAL Y MATERIALES -->
          <div class="rest-step hidden flex flex-col gap-4 py-4" id="rest-step-5">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 5 · Situación y Recursos</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Ya tienes página web actualmente?</h3>
            </div>
            <div class="flex flex-col gap-2 pt-1" id="group-rest-tiene-web">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectTieneWeb('No', this)" type="button">No</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectTieneWeb('Sí', this)" type="button">Sí</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectTieneWeb('Sí, pero quiero cambiarla', this)" type="button">Sí, pero quiero cambiarla</button>
            </div>
            <div class="hidden p-3 bg-teal-50 border border-teal-200 rounded-xl text-xs text-teal-900 font-medium" id="rest-nudge-web"></div>

            <div class="flex flex-col gap-1.5 pt-3 border-t border-slate-100">
              <h4 class="text-xs font-bold text-slate-900">¿Qué tienes listo para construirla?</h4>
              <div class="grid grid-cols-2 gap-2" id="group-rest-materiales">
                <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restToggleMaterial('Logo', this)" type="button">🎨 Logo</button>
                <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restToggleMaterial('Fotos de mis platos', this)" type="button">📸 Fotos de platos</button>
                <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restToggleMaterial('Fotos del restaurante', this)" type="button">🏛️ Fotos del local</button>
                <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restToggleMaterial('Menú', this)" type="button">📜 Menú / Carta</button>
                <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restToggleMaterial('Textos', this)" type="button">✍️ Textos</button>
                <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restToggleMaterial('Redes sociales', this)" type="button">📲 Redes sociales</button>
              </div>
            </div>

            <button
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-teal-700 text-white font-semibold text-sm hover:bg-teal-800 transition-colors cursor-pointer self-start mt-2"
              onclick="window.restNextStep(5)"
              type="button"
            >
              <span>Continuar →</span>
            </button>
          </div>

          <!-- PASO 6: ACCIÓN PRINCIPAL DEL VISITANTE -->
          <div class="rest-step hidden flex flex-col gap-4 py-4" id="rest-step-6">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 6 · Llamado a la acción</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">Cuando alguien entre a tu página, ¿qué quieres que haga?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-rest-accion">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectAccion('Ver el menú', this)" type="button">📜 Ver el menú</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectAccion('Escribir por WhatsApp', this)" type="button">💬 Escribir por WhatsApp</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectAccion('Reservar una mesa', this)" type="button">🍷 Reservar una mesa</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectAccion('Llamar', this)" type="button">📞 Llamar</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectAccion('Ver ubicación', this)" type="button">📍 Ver ubicación</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.restSelectAccion('Ver horarios', this)" type="button">🕒 Ver horarios</button>
            </div>
          </div>

          <!-- PASO 7: DATOS DE CONTACTO (POST-DIAGNÓSTICO) -->
          <div class="rest-step hidden flex flex-col gap-4 py-4" id="rest-step-7">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 7 · Enviar Resultado</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">Ya tenemos una idea mucho más clara.</h3>
              <p class="text-sm text-slate-600">¿A dónde te envío el diagnóstico y la propuesta para tu restaurante?</p>
            </div>
            <form class="flex flex-col gap-3 pt-2" onsubmit="event.preventDefault(); window.restSubmitLead();">
              <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-slate-700" for="rest-input-contacto-nombre">Tu Nombre *</label>
                <input class="w-full text-sm px-4 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white" id="rest-input-contacto-nombre" placeholder="Ej. Chef Manuel Gómez" required type="text" />
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="flex flex-col gap-1">
                  <label class="text-xs font-semibold text-slate-700" for="rest-input-email">Correo Electrónico *</label>
                  <input class="w-full text-sm px-4 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white" id="rest-input-email" placeholder="contacto@restaurante.com" required type="email" />
                </div>
                <div class="flex flex-col gap-1">
                  <label class="text-xs font-semibold text-slate-700" for="rest-input-whatsapp">Número de WhatsApp *</label>
                  <input class="w-full text-sm px-4 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white" id="rest-input-whatsapp" placeholder="+57 300 000 0000" required type="tel" />
                </div>
              </div>

              <div class="pt-2">
                <button id="rest-btn-submit" class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer" type="submit">
                  <span>Ver resultado y propuesta →</span>
                </button>
              </div>
            </form>
          </div>

          <!-- RESULTADO PERSONALIZADO DEL DIAGNÓSTICO -->
          <div class="rest-step hidden flex flex-col gap-5 py-4" id="rest-step-result">
            <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex flex-col gap-2">
              <div class="flex items-center gap-2 text-emerald-800 font-bold text-sm">
                <span class="material-symbols-outlined text-emerald-600 text-xl">verified</span>
                <span>Diagnóstico Completado</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900">Esto es lo que debería resolver tu página:</h3>
              <p class="text-xs text-slate-700 leading-relaxed" id="rest-result-summary">
                Por lo que me cuentas, hoy tus clientes llegan principalmente desde redes sociales, pero tienen que buscar información entre diferentes lugares para conocer tu menú, ubicación y opciones de reserva.
              </p>
