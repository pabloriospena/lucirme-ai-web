  <!-- SCRIPT CONVERSACIONAL DE RESTAURANTES Y EVENTOS POSTHOG -->
  <script>
    let restStep = 1;
    const totalRestSteps = 7;

    const restState: Record<string, any> = {
      nombre: '',
      canal: '',
      menu: '',
      resolver: '',
      tieneWeb: '',
      materiales: [],
      accion: '',
      contactoNombre: '',
      email: '',
      whatsapp: '',
    };

    // Load from sessionStorage if available
    try {
      const saved = sessionStorage.getItem('restaurant_diag_state');
      if (saved) {
        Object.assign(restState, JSON.parse(saved));
      }
    } catch (e) {
      console.warn('sessionStorage not available:', e);
    }

    function saveRestState() {
      try {
        sessionStorage.setItem('restaurant_diag_state', JSON.stringify(restState));
      } catch (e) {}
    }

    function updateRestWizardProgress() {
      const counter = document.getElementById('rest-step-counter');
      const bar = document.getElementById('rest-progress-bar');
      const tag = document.getElementById('rest-status-tag');
      const prevBtn = document.getElementById('rest-btn-prev') as HTMLButtonElement | null;

      if (!counter || !bar) return;

      if (restStep <= totalRestSteps) {
        const pct = (restStep / totalRestSteps) * 100;
        counter.innerText = `Paso ${restStep} de ${totalRestSteps}`;
        bar.style.width = `${pct}%`;
        if (tag) tag.innerText = `Paso ${restStep}`;
        if (prevBtn) prevBtn.disabled = restStep === 1;
      } else {
        counter.innerText = 'Diagnóstico Completado';
        bar.style.width = '100%';
        if (tag) tag.innerText = 'Completado';
        if (prevBtn) prevBtn.disabled = false;
      }
    }

    function restGoToStep(step: number) {
      document.querySelectorAll('.rest-step').forEach(el => el.classList.add('hidden'));

      restStep = step;
      if (step <= totalRestSteps) {
        const target = document.getElementById(`rest-step-${step}`);
        if (target) target.classList.remove('hidden');
      } else {
        const res = document.getElementById('rest-step-result');
        if (res) res.classList.remove('hidden');
      }

      updateRestWizardProgress();
    }

    function restPrevStep() {
      if (restStep > 1 && restStep <= totalRestSteps) {
        restGoToStep(restStep - 1);
      } else if (restStep > totalRestSteps) {
        restGoToStep(totalRestSteps);
      }
    }

    function restNextStep(step: number) {
      if (step === 1) {
        const inp = document.getElementById('rest-input-nombre') as HTMLInputElement | null;
        const val = inp?.value.trim() || '';
        if (!val) {
          alert('Por favor cuéntame el nombre de tu restaurante.');
          return;
        }
        restState.nombre = val;
        saveRestState();
        restGoToStep(2);
      } else if (step === 5) {
        restGoToStep(6);
      }
    }

    function restSelectCanal(val: string, btn: HTMLElement) {
      restState.canal = val;
      saveRestState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      const nudge = document.getElementById('rest-nudge-canal');
      if (nudge) {
        if (val.includes('Instagram')) {
          nudge.innerText = 'Tiene sentido. Instagram funciona muy bien para mostrar tus platos y el ambiente, pero no siempre es el mejor lugar para reunir toda la información de tu restaurante.';
          nudge.classList.remove('hidden');
        } else if (val.includes('WhatsApp')) {
          nudge.innerText = 'WhatsApp es perfecto para conversar y recibir reservas. El problema aparece cuando toda la información depende de una conversación.';
          nudge.classList.remove('hidden');
        } else if (val.includes('Google')) {
          nudge.innerText = 'Perfecto. Entonces tiene sentido que cuando alguien encuentre tu restaurante pueda llegar a un lugar donde entienda rápidamente qué ofreces y cómo visitarte.';
          nudge.classList.remove('hidden');
        } else {
          nudge.classList.add('hidden');
        }
      }

      if ((window as any).posthog) {
        (window as any).posthog.capture('diagnostic_question_answered', {
          question: 'canal_actual',
          answer: val,
          tipo_de_pagina: 'restaurante',
        });
      }

      setTimeout(() => restGoToStep(3), 300);
    }

    function restSelectMenu(val: string, btn: HTMLElement) {
      restState.menu = val;
      saveRestState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('diagnostic_question_answered', {
          question: 'busqueda_menu',
          answer: val,
          tipo_de_pagina: 'restaurante',
        });
      }

      setTimeout(() => restGoToStep(4), 250);
    }

    function restSelectResolver(val: string, btn: HTMLElement) {
      restState.resolver = val;
      saveRestState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('diagnostic_question_answered', {
          question: 'que_resolver',
          answer: val,
          tipo_de_pagina: 'restaurante',
        });
      }

      setTimeout(() => restGoToStep(5), 250);
    }

    function restSelectTieneWeb(val: string, btn: HTMLElement) {
      restState.tieneWeb = val;
      saveRestState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      const nudge = document.getElementById('rest-nudge-web');
      if (nudge) {
        if (val === 'No') {
          nudge.innerText = 'Perfecto. Entonces podemos diseñarla desde cero alrededor de lo que realmente necesita tu restaurante.';
          nudge.classList.remove('hidden');
        } else if (val.includes('Sí, pero')) {
          nudge.innerText = 'Entendido. Primero identificamos qué no está funcionando y después vemos qué conviene reconstruir.';
          nudge.classList.remove('hidden');
        } else {
          nudge.innerText = 'Perfecto. Entonces podemos revisar qué papel está cumpliendo hoy esa página.';
          nudge.classList.remove('hidden');
        }
      }
    }

    function restToggleMaterial(val: string, btn: HTMLElement) {
      const list: string[] = restState.materiales || [];
      const idx = list.indexOf(val);

      if (idx >= 0) {
        list.splice(idx, 1);
        btn.classList.remove('border-teal-700', 'bg-teal-50', 'text-teal-900', 'font-bold');
        btn.classList.add('border-slate-200', 'text-slate-700');
      } else {
        list.push(val);
        btn.classList.remove('border-slate-200', 'text-slate-700');
        btn.classList.add('border-teal-700', 'bg-teal-50', 'text-teal-900', 'font-bold');
      }

      restState.materiales = list;
      saveRestState();
    }

    function restSelectAccion(val: string, btn: HTMLElement) {
      restState.accion = val;
      saveRestState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('diagnostic_question_answered', {
          question: 'accion_principal',
          answer: val,
          tipo_de_pagina: 'restaurante',
        });
      }

      setTimeout(() => restGoToStep(7), 300);
    }

    async function restSubmitLead() {
      const nomInput = document.getElementById('rest-input-contacto-nombre') as HTMLInputElement | null;
      const emInput = document.getElementById('rest-input-email') as HTMLInputElement | null;
      const waInput = document.getElementById('rest-input-whatsapp') as HTMLInputElement | null;
      const submitBtn = document.getElementById('rest-btn-submit') as HTMLButtonElement | null;

      const nom = nomInput?.value.trim() || '';
      const em = emInput?.value.trim() || '';
      const wa = waInput?.value.trim() || '';

      if (!nom) {
        alert('Por favor ingresa tu nombre.');
        return;
      }

      if (!em || !em.includes('@')) {
        alert('Por favor ingresa un correo electrónico válido.');
        return;
      }

      if (!wa) {
        alert('Por favor ingresa tu número de WhatsApp.');
        return;
      }

      restState.contactoNombre = nom;
      restState.email = em;
      restState.whatsapp = wa;
      saveRestState();

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Enviando y calculando...';
      }

      try {
        const res = await fetch('/api/page-commercial-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: restState.contactoNombre,
            email: restState.email,
            whatsapp: restState.whatsapp,
            empresa: restState.nombre || 'Restaurante',
            dedicacion: 'Restaurante y Gastronomía',
            ciudad: 'Colombia',
            pais: 'Colombia',
            tieneWeb: restState.tieneWeb,
            queQuiereMejorar: restState.resolver,
            tieneDominio: 'Por verificar',
            queTieneListo: restState.materiales,
            objetivos: [restState.resolver || 'Mostrar menú y reservas'],
            accionPrincipal: restState.accion || 'WhatsApp',
            tipo_de_pagina: 'restaurante',
            tipo_de_empresa: 'restaurante',
            fuente: 'Landing /soluciones/web-restaurantes',
          }),
        });

        const result = await res.json();
        if (!res.ok && result.error) {
          alert(result.error);
        }
      } catch (err) {
        console.error('Error enviando lead de restaurante:', err);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Ver resultado y propuesta →';
        }
      }

      // Populate Result Screen
      const sumText = document.getElementById('rest-result-summary');
      if (sumText) {
        sumText.innerHTML = `
          Por lo que me cuentas, hoy los clientes de <strong>${restState.nombre || 'tu restaurante'}</strong> llegan principalmente desde <strong>${restState.canal || 'redes sociales'}</strong>, pero tienen que buscar información entre diferentes lugares para conocer tu menú, ubicación y opciones de reserva. Tu página debería reunir esa información en un solo lugar y llevar a tus clientes directamente a <strong>${restState.accion || 'conversar por WhatsApp'}</strong>.
        `;
      }

      if ((window as any).posthog) {
        (window as any).posthog.capture('diagnostic_completed', {
          tipo_de_pagina: 'restaurante',
          has_website: restState.tieneWeb,
          main_action: restState.accion,
        });
        (window as any).posthog.capture('page_commercial_lead_submitted', {
          tipo_de_pagina: 'restaurante',
          has_website: restState.tieneWeb,
          main_action: restState.accion,
        });
        (window as any).posthog.capture('page_commercial_price_shown', {
          tipo_de_pagina: 'restaurante',
        });
      }

      restGoToStep(8);
    }

    // Window assignments
    (window as any).restGoToStep = restGoToStep;
    (window as any).restPrevStep = restPrevStep;
    (window as any).restNextStep = restNextStep;
    (window as any).restSelectCanal = restSelectCanal;
    (window as any).restSelectMenu = restSelectMenu;
    (window as any).restSelectResolver = restSelectResolver;
    (window as any).restSelectTieneWeb = restSelectTieneWeb;
    (window as any).restToggleMaterial = restToggleMaterial;
    (window as any).restSelectAccion = restSelectAccion;
    (window as any).restSubmitLead = restSubmitLead;

    document.addEventListener('DOMContentLoaded', () => {
      updateRestWizardProgress();

      if ((window as any).posthog) {
        (window as any).posthog.capture('page_commercial_view', {
          url: window.location.href,
          tipo_de_pagina: 'restaurante',
        });
      }
    });
  </script>
</Layout>
