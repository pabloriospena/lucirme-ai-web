---
import Layout from "../../layouts/Layout.astro";
import SobreMi from "../../components/SobreMi.astro";
import CurrencySelector from "../../components/CurrencySelector.astro";
import { LINKS } from "../../lib/constants.js";

const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
const ctaDescuentoWA = `${whatsappBase}?text=${encodeURIComponent("Hola Pablo, quiero aprovechar la oferta de lanzamiento (50% OFF) para la Página Comercial de mi veterinaria.")}`;
---

<Layout
  title="Página Web para Veterinarias | LuciRMe AI"
  description="Creamos páginas comerciales profesionales para veterinarias que quieren mostrar sus servicios, generar confianza y facilitar el contacto con sus clientes."
>

  <main class="w-full bg-[#F8FAFC]">
    <!-- SUB-NAVEGACIÓN PARA VETERINARIAS -->
    <nav class="w-full bg-white border-b border-slate-200 py-3 sticky top-16 z-30">
      <div class="max-w-7xl mx-auto px-6 flex flex-wrap gap-4 text-xs font-semibold text-slate-600">
        <a class="hover:text-teal-700" href="#diagnostico-veterinaria">Diagnóstico 2 min</a>
        <a class="hover:text-teal-700" href="#que-incluye">Qué incluye</a>
        <a class="hover:text-teal-700" href="#ejemplos-veterinaria">Ejemplos</a>
        <a class="hover:text-teal-700" href="#pablo">Pablo</a>
        <a class="hover:text-teal-700 text-amber-700" href="#oferta-precio">Lanzamiento 50% OFF</a>
      </div>
    </nav>

    <!-- HERO SECTION -->
    <section class="w-full max-w-7xl mx-auto px-6 pt-12 pb-12 md:py-20 border-b border-slate-200/60">
      <div class="max-w-3xl mx-auto flex flex-col items-center text-center gap-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-teal-50 border border-teal-200/80 rounded-full font-mono text-xs text-teal-800 shadow-2xs">
          Especial para clínicas y centros veterinarios
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
          ¿Tu veterinaria depende demasiado de Instagram y WhatsApp?
        </h1>

        <p class="text-base md:text-lg text-slate-600 font-normal leading-relaxed">
          Tus clientes quieren saber qué servicios tienes, dónde estás, cómo contactarte y por qué confiar en ti. Si hoy tienen que buscar esa información entre Instagram, WhatsApp, Google y otros enlaces, podemos organizarlo mejor.
        </p>

        <div class="p-5 bg-white border border-slate-200 rounded-2xl shadow-xs w-full max-w-xl flex flex-col items-center gap-3 mt-2">
          <h2 class="text-base font-bold text-slate-900">
            Hagamos una prueba rápida
          </h2>
          <p class="text-xs text-slate-600 leading-relaxed">
            En menos de 2 minutos te ayudo a definir qué debería tener la página de tu veterinaria.
          </p>
          <a
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer w-full sm:w-auto"
            href="#diagnostico-veterinaria"
            onclick="if(window.posthog) window.posthog.capture('diagnostic_started', { tipo_de_pagina: 'veterinaria' });"
          >
            <span>Empezar diagnóstico →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- COMPONENTE DIAGNÓSTICO CONVERSACIONAL (VetDiagnostic) -->
    <section class="w-full max-w-7xl mx-auto px-6 py-12 scroll-mt-20" id="diagnostico-veterinaria">
      <div class="max-w-2xl mx-auto flex flex-col gap-6">

        <div class="bg-white rounded-2xl border border-slate-200 shadow-md p-6 md:p-8 relative min-h-[400px] flex flex-col justify-between" id="vet-wizard-card">
          
          <!-- Wizard Header -->
          <div class="flex flex-col gap-2 pb-4 border-b border-slate-100" id="vet-wizard-header">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="font-mono text-xs font-semibold text-slate-900 uppercase" id="vet-step-counter">Paso 1 de 7</span>
              </div>
              <span class="text-xs font-mono text-slate-400" id="vet-step-time">~2 min</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
              <div class="bg-emerald-600 h-1.5 rounded-full transition-all duration-300 ease-out" id="vet-progress-bar" style="width: 14.28%;"></div>
            </div>
          </div>

          <!-- PASO 1: NOMBRE -->
          <div class="vet-step flex flex-col gap-4 py-4" id="vet-step-1">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 1 · Identidad</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">Cuéntame un poco de tu veterinaria 🐾</h3>
              <p class="text-sm text-slate-600">¿Cómo se llama tu veterinaria o clínica?</p>
            </div>
            <div class="flex flex-col gap-3 pt-2">
              <input
                class="w-full text-sm px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none bg-white transition-colors"
                id="vet-input-nombre"
                placeholder="Ej. Veterinaria San Francisco / Clínica Veterinaria Mascotas..."
                type="text"
              />
              <button
                class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-teal-700 text-white font-semibold text-sm hover:bg-teal-800 transition-colors cursor-pointer self-start"
                onclick="window.vetNextStep(1)"
                type="button"
              >
                <span>Continuar →</span>
              </button>
            </div>
          </div>

          <!-- PASO 2: CANAL ACTUAL -->
          <div class="vet-step hidden flex flex-col gap-4 py-4" id="vet-step-2">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 2 · Información</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Cómo encuentran hoy tus clientes la información sobre tu veterinaria?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-vet-canal">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectCanal('Instagram', this)" type="button">📲 Instagram</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectCanal('WhatsApp', this)" type="button">💬 WhatsApp</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectCanal('Google', this)" type="button">🔍 Google</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectCanal('Facebook', this)" type="button">👥 Facebook</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectCanal('Página web', this)" type="button">🌐 Página web</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectCanal('Una combinación de varias', this)" type="button">🔀 Una combinación de varias</button>
              <button class="diag-option sm:col-span-2 px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectCanal('Otro', this)" type="button">Otro</button>
            </div>
            <div class="hidden p-3 bg-teal-50 border border-teal-200 rounded-xl text-xs text-teal-900 font-medium" id="vet-nudge-canal"></div>
          </div>

          <!-- PASO 3: BÚSQUEDA DE SERVICIOS -->
          <div class="vet-step hidden flex flex-col gap-4 py-4" id="vet-step-3">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 3 · Experiencia del cliente</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">Cuando alguien quiere conocer tus servicios, ¿qué tiene que hacer?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-vet-servicios">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectServicios('Buscar publicaciones', this)" type="button">Buscar publicaciones</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectServicios('Escribirte por WhatsApp', this)" type="button">Escribirte por WhatsApp</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectServicios('Preguntar directamente', this)" type="button">Preguntar directamente</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectServicios('Revisar varios enlaces', this)" type="button">Revisar varios enlaces</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectServicios('Buscar en Google', this)" type="button">Buscar en Google</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectServicios('Ya tenemos todo organizado', this)" type="button">Ya tenemos todo organizado</button>
            </div>
          </div>

          <!-- PASO 4: LO QUE QUEREMOS RESOLVER -->
          <div class="vet-step hidden flex flex-col gap-4 py-4" id="vet-step-4">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 4 · Propósito</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">Si tuvieras una página para tu veterinaria, ¿qué te gustaría que resolviera principalmente?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-vet-resolver">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectResolver('Mostrar mis servicios', this)" type="button">Mostrar mis servicios</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectResolver('Conseguir más contactos', this)" type="button">Conseguir más contactos</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectResolver('Llevar personas a WhatsApp', this)" type="button">Llevar personas a WhatsApp</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectResolver('Facilitar reservas/citas', this)" type="button">Facilitar reservas/citas</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectResolver('Aparecer mejor en Google', this)" type="button">Aparecer mejor en Google</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectResolver('Tener toda la información en un solo lugar', this)" type="button">Tener todo en un solo lugar</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectResolver('Mostrar una imagen más profesional', this)" type="button">Imagen más profesional</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectResolver('Varias de las anteriores', this)" type="button">Varias de las anteriores</button>
            </div>
          </div>

          <!-- PASO 5: WEB ACTUAL Y MATERIALES -->
          <div class="vet-step hidden flex flex-col gap-4 py-4" id="vet-step-5">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 5 · Situación y Recursos</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">¿Ya tienes página web actualmente?</h3>
            </div>
            <div class="flex flex-col gap-2 pt-1" id="group-vet-tiene-web">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectTieneWeb('No', this)" type="button">No</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectTieneWeb('Sí', this)" type="button">Sí</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectTieneWeb('Sí, pero quiero cambiarla', this)" type="button">Sí, pero quiero cambiarla</button>
            </div>
            <div class="hidden p-3 bg-teal-50 border border-teal-200 rounded-xl text-xs text-teal-900 font-medium" id="vet-nudge-web"></div>

            <div class="flex flex-col gap-1.5 pt-3 border-t border-slate-100">
              <h4 class="text-xs font-bold text-slate-900">¿Qué tienes disponible para construirla?</h4>
              <div class="grid grid-cols-2 gap-2" id="group-vet-materiales">
                <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetToggleMaterial('Logo', this)" type="button">🎨 Logo</button>
                <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetToggleMaterial('Fotos', this)" type="button">📸 Fotos</button>
                <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetToggleMaterial('Textos', this)" type="button">✍️ Textos</button>
                <button class="multi-option p-2.5 rounded-lg border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetToggleMaterial('Redes sociales', this)" type="button">📲 Redes sociales</button>
              </div>
            </div>

            <button
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-teal-700 text-white font-semibold text-sm hover:bg-teal-800 transition-colors cursor-pointer self-start mt-2"
              onclick="window.vetNextStep(5)"
              type="button"
            >
              <span>Continuar →</span>
            </button>
          </div>

          <!-- PASO 6: ACCIÓN PRINCIPAL DEL VISITANTE -->
          <div class="vet-step hidden flex flex-col gap-4 py-4" id="vet-step-6">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 6 · Llamado a la acción</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">Cuando alguien entre a tu página, ¿qué quieres que haga?</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2" id="group-vet-accion">
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectAccion('Escribir por WhatsApp', this)" type="button">💬 Escribir por WhatsApp</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectAccion('Agendar una cita', this)" type="button">📅 Agendar una cita</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectAccion('Llamar', this)" type="button">📞 Llamar</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectAccion('Conocer los servicios', this)" type="button">👁️ Conocer los servicios</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectAccion('Solicitar información', this)" type="button">ℹ️ Solicitar información</button>
              <button class="diag-option px-3.5 py-2.5 rounded-xl border border-slate-200 text-left text-xs font-medium text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="window.vetSelectAccion('Ver ubicación', this)" type="button">📍 Ver ubicación</button>
            </div>
          </div>

          <!-- PASO 7: DATOS DE CONTACTO (POST-DIAGNÓSTICO) -->
          <div class="vet-step hidden flex flex-col gap-4 py-4" id="vet-step-7">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-xs font-semibold text-teal-800 uppercase">Paso 7 · Enviar Resultado</span>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900">Ya tenemos una idea mucho más clara.</h3>
              <p class="text-sm text-slate-600">¿A dónde te envío el diagnóstico y la propuesta para tu veterinaria?</p>
            </div>
            <form class="flex flex-col gap-3 pt-2" onsubmit="event.preventDefault(); window.vetSubmitLead();">
              <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-slate-700" for="vet-input-contacto-nombre">Tu Nombre *</label>
                <input class="w-full text-sm px-4 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white" id="vet-input-contacto-nombre" placeholder="Ej. Dr. Carlos Mendoza" required type="text" />
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="flex flex-col gap-1">
                  <label class="text-xs font-semibold text-slate-700" for="vet-input-email">Correo Electrónico *</label>
                  <input class="w-full text-sm px-4 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white" id="vet-input-email" placeholder="contacto@veterinaria.com" required type="email" />
                </div>
                <div class="flex flex-col gap-1">
                  <label class="text-xs font-semibold text-slate-700" for="vet-input-whatsapp">Número de WhatsApp *</label>
                  <input class="w-full text-sm px-4 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-600 outline-none bg-white" id="vet-input-whatsapp" placeholder="+57 300 000 0000" required type="tel" />
                </div>
              </div>

              <div class="pt-2">
                <button id="vet-btn-submit" class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer" type="submit">
                  <span>Ver resultado y propuesta →</span>
                </button>
              </div>
            </form>
          </div>

          <!-- RESULTADO PERSONALIZADO DEL DIAGNÓSTICO -->
          <div class="vet-step hidden flex flex-col gap-5 py-4" id="vet-step-result">
            <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex flex-col gap-2">
              <div class="flex items-center gap-2 text-emerald-800 font-bold text-sm">
                <span class="material-symbols-outlined text-emerald-600 text-xl">verified</span>
                <span>Diagnóstico Completado</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900">Esto es lo que debería resolver tu página:</h3>
              <p class="text-xs text-slate-700 leading-relaxed" id="vet-result-summary">
                Basado en las respuestas de tu veterinaria, este es el plan de acción sugerido:
              </p>
            </div>

            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 flex flex-col gap-2.5 text-xs text-slate-800">
              <span class="font-mono text-[10px] uppercase font-bold text-slate-500">Recomendaciones personalizadas:</span>
              <ul class="flex flex-col gap-2 text-slate-700 font-medium" id="vet-result-bullets">
                <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Mostrar claramente tus servicios de consulta, vacunas y atención.</li>
                <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Explicar quién eres y generar confianza antes de la cita.</li>
                <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Facilitar el contacto y la ubicación exacta de tu sede.</li>
                <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Llevar clientes directamente a conversar contigo por WhatsApp.</li>
              </ul>
            </div>

            <a
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-teal-700 text-white font-semibold text-sm hover:bg-teal-800 transition-colors shadow-2xs text-center cursor-pointer"
              href="#oferta-precio"
            >
              <span>Ver oferta y precio de lanzamiento ↓</span>
            </a>
          </div>

          <!-- Wizard Footer Navigation -->
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between mt-2" id="vet-wizard-navigation">
            <button
              class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
              disabled
              id="vet-btn-prev"
              onclick="window.vetPrevStep()"
              type="button"
            >
              <span class="material-symbols-outlined text-[15px]">arrow_back</span>
              <span>Anterior</span>
            </button>
