  <!-- SCRIPT CONVERSACIONAL DE VETERINARIAS Y EVENTOS POSTHOG -->
  <script>
    let vetStep = 1;
    const totalVetSteps = 7;

    const vetState: Record<string, any> = {
      nombre: '',
      canal: '',
      servicios: '',
      resolver: '',
      tieneWeb: '',
      materiales: [],
      accion: '',
      contactoNombre: '',
      email: '',
      whatsapp: '',
    };

    // Load from sessionStorage if available
    try {
      const saved = sessionStorage.getItem('vet_diag_state');
      if (saved) {
        Object.assign(vetState, JSON.parse(saved));
      }
    } catch (e) {
      console.warn('sessionStorage not available:', e);
    }

    function saveVetState() {
      try {
        sessionStorage.setItem('vet_diag_state', JSON.stringify(vetState));
      } catch (e) {}
    }

    function updateVetWizardProgress() {
      const counter = document.getElementById('vet-step-counter');
      const bar = document.getElementById('vet-progress-bar');
      const tag = document.getElementById('vet-status-tag');
      const prevBtn = document.getElementById('vet-btn-prev') as HTMLButtonElement | null;

      if (!counter || !bar) return;

      if (vetStep <= totalVetSteps) {
        const pct = (vetStep / totalVetSteps) * 100;
        counter.innerText = `Paso ${vetStep} de ${totalVetSteps}`;
        bar.style.width = `${pct}%`;
        if (tag) tag.innerText = `Paso ${vetStep}`;
        if (prevBtn) prevBtn.disabled = vetStep === 1;
      } else {
        counter.innerText = 'Diagnóstico Completado';
        bar.style.width = '100%';
        if (tag) tag.innerText = 'Completado';
        if (prevBtn) prevBtn.disabled = false;
      }
    }

    function vetGoToStep(step: number) {
      document.querySelectorAll('.vet-step').forEach(el => el.classList.add('hidden'));

      vetStep = step;
      if (step <= totalVetSteps) {
        const target = document.getElementById(`vet-step-${step}`);
        if (target) target.classList.remove('hidden');
      } else {
        const res = document.getElementById('vet-step-result');
        if (res) res.classList.remove('hidden');
      }

      updateVetWizardProgress();
    }

    function vetPrevStep() {
      if (vetStep > 1 && vetStep <= totalVetSteps) {
        vetGoToStep(vetStep - 1);
      } else if (vetStep > totalVetSteps) {
        vetGoToStep(totalVetSteps);
      }
    }

    function vetNextStep(step: number) {
      if (step === 1) {
        const inp = document.getElementById('vet-input-nombre') as HTMLInputElement | null;
        const val = inp?.value.trim() || '';
        if (!val) {
          alert('Por favor cuéntame el nombre de tu veterinaria.');
          return;
        }
        vetState.nombre = val;
        saveVetState();
        vetGoToStep(2);
      } else if (step === 5) {
        vetGoToStep(6);
      }
    }

    function vetSelectCanal(val: string, btn: HTMLElement) {
      vetState.canal = val;
      saveVetState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      const nudge = document.getElementById('vet-nudge-canal');
      if (nudge) {
        if (val.includes('Instagram')) {
          nudge.innerText = 'Tiene sentido. Instagram funciona muy bien para mostrar lo que haces, pero no siempre es el mejor lugar para reunir toda la información de tu veterinaria.';
          nudge.classList.remove('hidden');
        } else if (val.includes('WhatsApp')) {
          nudge.innerText = 'WhatsApp es perfecto para conversar con tus clientes. El problema aparece cuando toda la información depende de una conversación.';
          nudge.classList.remove('hidden');
        } else if (val.includes('Google')) {
          nudge.innerText = 'Perfecto. Entonces tiene sentido que cuando alguien te encuentre pueda llegar a un lugar donde entienda rápidamente quién eres y qué haces.';
          nudge.classList.remove('hidden');
        } else {
          nudge.classList.add('hidden');
        }
      }

      if ((window as any).posthog) {
        (window as any).posthog.capture('diagnostic_question_answered', {
          question: 'canal_actual',
          answer: val,
          tipo_de_pagina: 'veterinaria',
        });
      }

      setTimeout(() => vetGoToStep(3), 300);
    }

    function vetSelectServicios(val: string, btn: HTMLElement) {
      vetState.servicios = val;
      saveVetState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('diagnostic_question_answered', {
          question: 'busqueda_servicios',
          answer: val,
          tipo_de_pagina: 'veterinaria',
        });
      }

      setTimeout(() => vetGoToStep(4), 250);
    }

    function vetSelectResolver(val: string, btn: HTMLElement) {
      vetState.resolver = val;
      saveVetState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('diagnostic_question_answered', {
          question: 'que_resolver',
          answer: val,
          tipo_de_pagina: 'veterinaria',
        });
      }

      setTimeout(() => vetGoToStep(5), 250);
    }

    function vetSelectTieneWeb(val: string, btn: HTMLElement) {
      vetState.tieneWeb = val;
      saveVetState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      const nudge = document.getElementById('vet-nudge-web');
      if (nudge) {
        if (val === 'No') {
          nudge.innerText = 'Perfecto. Entonces podemos diseñarla desde cero alrededor de lo que realmente necesita tu veterinaria.';
          nudge.classList.remove('hidden');
        } else if (val.includes('Sí, pero')) {
          nudge.innerText = 'Entendido. Primero identificamos qué no está funcionando y después vemos qué conviene reconstruir.';
          nudge.classList.remove('hidden');
        } else {
          nudge.innerText = 'Perfecto. Entonces podemos revisar qué papel está cumpliendo hoy esa página.';
          nudge.classList.remove('hidden');
        }
      }
    }

    function vetToggleMaterial(val: string, btn: HTMLElement) {
      const list: string[] = vetState.materiales || [];
      const idx = list.indexOf(val);

      if (idx >= 0) {
        list.splice(idx, 1);
        btn.classList.remove('border-teal-700', 'bg-teal-50', 'text-teal-900', 'font-bold');
        btn.classList.add('border-slate-200', 'text-slate-700');
      } else {
        list.push(val);
        btn.classList.remove('border-slate-200', 'text-slate-700');
        btn.classList.add('border-teal-700', 'bg-teal-50', 'text-teal-900', 'font-bold');
      }

      vetState.materiales = list;
      saveVetState();
    }

    function vetSelectAccion(val: string, btn: HTMLElement) {
      vetState.accion = val;
      saveVetState();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.diag-option').forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');
          b.classList.add('border-slate-200', 'text-slate-700');
        });
      }
      btn.classList.remove('border-slate-200', 'text-slate-700');
      btn.classList.add('border-emerald-600', 'bg-emerald-50/80', 'text-emerald-900', 'font-bold');

      if ((window as any).posthog) {
        (window as any).posthog.capture('diagnostic_question_answered', {
          question: 'accion_principal',
          answer: val,
          tipo_de_pagina: 'veterinaria',
        });
      }

      setTimeout(() => vetGoToStep(7), 300);
    }

    async function vetSubmitLead() {
      const nomInput = document.getElementById('vet-input-contacto-nombre') as HTMLInputElement | null;
      const emInput = document.getElementById('vet-input-email') as HTMLInputElement | null;
      const waInput = document.getElementById('vet-input-whatsapp') as HTMLInputElement | null;
      const submitBtn = document.getElementById('vet-btn-submit') as HTMLButtonElement | null;

      const nom = nomInput?.value.trim() || '';
      const em = emInput?.value.trim() || '';
      const wa = waInput?.value.trim() || '';

      if (!nom) {
        alert('Por favor ingresa tu nombre.');
        return;
      }

      if (!em || !em.includes('@')) {
        alert('Por favor ingresa un correo electrónico válido.');
        return;
      }

      if (!wa) {
        alert('Por favor ingresa tu número de WhatsApp.');
        return;
      }

      vetState.contactoNombre = nom;
      vetState.email = em;
      vetState.whatsapp = wa;
      saveVetState();

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Enviando y calculando...';
      }

      try {
        const res = await fetch('/api/page-commercial-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: vetState.contactoNombre,
            email: vetState.email,
            whatsapp: vetState.whatsapp,
            empresa: vetState.nombre || 'Veterinaria',
            dedicacion: 'Veterinaria y Salud Animal',
            ciudad: 'Colombia',
            pais: 'Colombia',
            tieneWeb: vetState.tieneWeb,
            queQuiereMejorar: vetState.resolver,
            tieneDominio: 'Por verificar',
            queTieneListo: vetState.materiales,
            objetivos: [vetState.resolver || 'Mostrar servicios'],
            accionPrincipal: vetState.accion || 'WhatsApp',
            tipo_de_pagina: 'veterinaria',
            tipo_de_empresa: 'veterinaria',
            fuente: 'Landing /soluciones/web-veterinarios',
          }),
        });

        const result = await res.json();
        if (!res.ok && result.error) {
          alert(result.error);
        }
      } catch (err) {
        console.error('Error enviando lead de veterinaria:', err);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Ver resultado y propuesta →';
        }
      }

      // Populate Result Screen
      const sumText = document.getElementById('vet-result-summary');
      if (sumText) {
        sumText.innerHTML = `
          Por lo que me cuentas, hoy los clientes de <strong>${vetState.nombre || 'tu veterinaria'}</strong> llegan principalmente desde <strong>${vetState.canal || 'redes sociales'}</strong>, pero tienen que buscar información entre diferentes lugares para conocer tus servicios. Tu página debería reunir esa información en un solo lugar y llevar a tus clientes directamente a <strong>${vetState.accion || 'conversar por WhatsApp'}</strong>.
        `;
      }

      if ((window as any).posthog) {
        (window as any).posthog.capture('diagnostic_completed', {
          tipo_de_pagina: 'veterinaria',
          has_website: vetState.tieneWeb,
          main_action: vetState.accion,
        });
        (window as any).posthog.capture('page_commercial_lead_submitted', {
          tipo_de_pagina: 'veterinaria',
          has_website: vetState.tieneWeb,
          main_action: vetState.accion,
        });
        (window as any).posthog.capture('page_commercial_price_shown', {
          tipo_de_pagina: 'veterinaria',
        });
      }

      vetGoToStep(8);
    }

    // Window assignments
    (window as any).vetGoToStep = vetGoToStep;
    (window as any).vetPrevStep = vetPrevStep;
    (window as any).vetNextStep = vetNextStep;
    (window as any).vetSelectCanal = vetSelectCanal;
    (window as any).vetSelectServicios = vetSelectServicios;
    (window as any).vetSelectResolver = vetSelectResolver;
    (window as any).vetSelectTieneWeb = vetSelectTieneWeb;
    (window as any).vetToggleMaterial = vetToggleMaterial;
    (window as any).vetSelectAccion = vetSelectAccion;
    (window as any).vetSubmitLead = vetSubmitLead;

    document.addEventListener('DOMContentLoaded', () => {
      updateVetWizardProgress();

      if ((window as any).posthog) {
        (window as any).posthog.capture('page_commercial_view', {
          url: window.location.href,
          tipo_de_pagina: 'veterinaria',
        });
      }
    });
  </script>
</Layout>
