---
import LayoutV2 from "../layouts/LayoutV2.astro";
import PaginaGracias from "../components/v2/PaginaGracias.astro";
---

<LayoutV2 title="¡Listo! Nos vemos en el Taller de Inmersión | LuciRMe AI">
  <PaginaGracias
    titulo="¡Taller agendado!"
    resumen="Ya tengo tu información. En las próximas 24 horas te contactaré para confirmar los detalles."
    pasos={[
      { t: "Te contacto en 24 horas", d: "Te llamaré o escribiré por WhatsApp para confirmar fecha, hora y coordinar los detalles del Taller de Inmersión." },
      { t: "Prepara tu proceso crítico", d: "Identifica ese proceso manual que más tiempo les consume, como reportes en Excel, organización de documentos o seguimiento de tareas." },
      { t: "Reúne a tu equipo clave", d: "Invita a las personas que conocen mejor ese proceso. Su participación es clave para diseñar la solución." },
    ]}
    listas={[
      {
        titulo: "Qué incluye el Taller de Inmersión",
        items: [
          "Entendimiento de tus procesos actuales.",
          "Identificamos las mayores fugas de tiempo en tu operación.",
          "Demo en vivo de cómo optimizar un proceso real de tu empresa.",
          "Plan de acción personalizado con prioridades claras.",
          "Protocolos de seguridad para uso de IA con datos de clientes.",
        ],
      },
      {
        titulo: "Para aprovechar al máximo el Taller",
        items: [
          "Ten a la mano un ejemplo real del proceso que quieres automatizar, como un Excel, un correo tipo o un documento.",
          "Calcula aproximadamente cuántas horas semanales dedica tu equipo a ese proceso.",
          "Asegúrate de que las personas clave puedan asistir a la sesión.",
        ],
      },
    ]}
    pregunta="¿Tienes alguna pregunta antes del Taller?"
  />
</LayoutV2>
