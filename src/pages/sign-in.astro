---
import Layout from '../layouts/Layout.astro';
import { SignIn as ClerkSignIn } from "@clerk/astro/components";

// 1. Capturamos la URL a la que el usuario quería ir originalmente
const redirectUrl = Astro.url.searchParams.get('redirect_url') || '/dashboard';

// 2. Forzamos a TypeScript a tratar el componente como 'any' para evitar que se queje
const SignInComponent = ClerkSignIn as any;

const traduccionES = {
  signIn: {
    start: {
      title: "Bienvenido al Laboratorio",
      subtitle: "La tecnología que trabaja en silencio empieza aquí.",
      actionText: "¿No tienes una cuenta?",
      actionLink: "Regístrate"
    }
  },
  dividerText: "o continúa con",
  formButtonPrimary: "Acceder al Centro de Mando"
};
---

<Layout title="Iniciar Sesión | LuciRMe AI">
  <main class="flex justify-center py-20 px-4 bg-[#F8FAFC]">
    <div class="w-full max-w-md">
      <!-- 
        3. Forzamos la redirección usando 'signUpUrl' y 'forceRedirectUrl'.
        Esto obliga a Clerk a respetar el destino original ignorando el .env
      -->
      <SignInComponent 
        localization={traduccionES}
        forceRedirectUrl={redirectUrl}
        signUpUrl={`/sign-up?redirect_url=${encodeURIComponent(redirectUrl)}`}
        appearance={{
          variables: {
            colorPrimary: '#0D9488', 
            borderRadius: '8px',
          }
        }}
      />
    </div>
  </main>
</Layout>