---
// Vista de ejemplo de Mi cuenta: Progreso, Mis invitaciones, Mis datos y Autorizaciones. No se indexa.
// Solo diseño. Las cuentas, el progreso y las invitaciones llegan en las fases 2 y 3 del PRD.
// PENDIENTE LEGAL: validar con un asesor el texto de Habeas Data (Ley 1581 de 2012) antes de abrir cuentas.
import LayoutV2 from "../../layouts/LayoutV2.astro";
import BarraProgreso from "../../components/v2/BarraProgreso.astro";
import ContadorInvitaciones from "../../components/v2/ContadorInvitaciones.astro";
import SigueEnRedes from "../../components/v2/SigueEnRedes.astro";

const auths = [
  { id: "a-ig", label: "Ya sigo a Pablo en Instagram", on: true },
  { id: "a-tt", label: "Ya sigo a Pablo en TikTok", on: false },
  { id: "a-fb", label: "Ya sigo a Pablo en Facebook", on: true },
  { id: "a-li", label: "Ya sigo a Pablo en LinkedIn", on: false },
  { id: "a-nombre", label: "Otras personas pueden ver mi nombre cuando las invito", on: false },
  { id: "a-correos", label: "Recibir correos con contenido nuevo", on: true },
];
const seccion = "border-t-[0.8px] border-v2-borde px-5 py-4";
const h2 = "mb-3 text-[22px] font-bold text-v2-texto";
const etiqueta = "mb-1.5 block text-xs font-bold uppercase tracking-[0.04em] text-v2-suave";
const campo = "box-border h-12 w-full rounded-xl border-[0.8px] border-v2-control bg-v2-fondo px-3.5 text-base text-v2-texto";
---

<LayoutV2 title="Vista de ejemplo de Mi cuenta | LuciRMe AI" noindex>
  <div class="bg-v2-superficie px-4 py-2 text-center text-xs text-v2-cuerpo">Pantalla de ejemplo para revisar el diseño. Datos de muestra.</div>
  <main class="mx-auto max-w-2xl pb-12">
    <div class="px-5 pb-2 pt-6">
      <h1 class="mb-3 text-[32px] font-extrabold leading-[1.15] tracking-[-0.9px] text-v2-texto">Mi cuenta</h1>
      <nav aria-label="Secciones de Mi cuenta" class="flex flex-wrap gap-x-4 text-sm font-semibold">
        <a href="#progreso" class="inline-flex min-h-11 items-center text-v2-accion">Progreso</a>
        <a href="#invitaciones" class="inline-flex min-h-11 items-center text-v2-accion">Mis invitaciones</a>
        <a href="#datos" class="inline-flex min-h-11 items-center text-v2-accion">Mis datos</a>
        <a href="#autorizaciones" class="inline-flex min-h-11 items-center text-v2-accion">Autorizaciones</a>
      </nav>
    </div>

    <section id="progreso" class={seccion} aria-labelledby="t-progreso">
      <h2 id="t-progreso" class={h2}>Progreso</h2>
      <div class="rounded-2xl border-[0.8px] border-v2-borde p-5">
        <p class="text-base font-bold text-v2-texto">Estudia con tus documentos</p>
        <div class="my-2"><BarraProgreso aplicados={1} total={5} etiqueta="Progreso de Estudia con tus documentos" /></div>
        <a href="/v2/camino" class="inline-flex min-h-11 items-center text-sm font-bold text-v2-accion">Seguir donde quedé ›</a>
      </div>
    </section>

    <section id="invitaciones" class={seccion} aria-labelledby="t-inv">
      <h2 id="t-inv" class={h2}>Mis invitaciones</h2>
      <div class="rounded-2xl border border-v2-pago-borde bg-v2-pago-fondo p-4">
        <p class="mb-3 text-sm font-bold text-v2-pago-texto">Un recurso de pago se desbloquea con 3 invitaciones</p>
        <ContadorInvitaciones actual={1} total={3} />
      </div>
      <label for="enlace" class={`mt-4 ${etiqueta}`}>Mi enlace</label>
      <input id="enlace" type="text" readonly value="lucirme.com/i/tu-enlace" class={`${campo} bg-v2-superficie font-mono text-sm`} />
      <button type="button" data-copiar-enlace class="mt-2 flex min-h-12 w-full items-center justify-center rounded-xl border-[1.5px] border-v2-accion text-sm font-bold text-v2-accion hover:bg-v2-marca-tinte">Copiar mi enlace</button>
      <p class="mt-3 text-sm leading-6 text-v2-cuerpo">Solo cuenta quien crea su cuenta con el correo verificado. El nombre de cada persona lo ves solo si ella lo autoriza.</p>
      <p class="mt-3 text-sm leading-7 text-v2-cuerpo">
        <span class="font-bold text-v2-accion">Con 1 invitación</span> un recurso extra gratis.
        <span class="font-bold text-v2-cuerpo">Con 3 invitaciones</span> acceso anticipado a lo nuevo.
      </p>
    </section>

    <section id="datos" class={seccion} aria-labelledby="t-datos">
      <h2 id="t-datos" class={h2}>Mis datos</h2>
      <div class="flex flex-col gap-3">
        <div><label for="nom" class={etiqueta}>Nombre</label><input id="nom" type="text" autocomplete="name" placeholder="Tu nombre" class={campo} /></div>
        <div><label for="mail" class={etiqueta}>Correo</label><input id="mail" type="email" autocomplete="email" placeholder="tu@correo.com" class={campo} /></div>
      </div>
      <div class="mt-1 flex flex-wrap gap-x-5">
        <a href="#datos" class="inline-flex min-h-11 items-center text-sm font-bold text-v2-accion">Descargar mis datos</a>
        <a href="#datos" class="inline-flex min-h-11 items-center text-sm font-bold text-v2-texto underline">Borrar mi cuenta</a>
      </div>
    </section>

    <section id="autorizaciones" class={seccion} aria-labelledby="t-aut">
      <h2 id="t-aut" class="mb-1 text-[22px] font-bold text-v2-texto">Autorizaciones</h2>
      <p class="mb-2 text-sm leading-6 text-v2-cuerpo">Marcar que ya me sigues es una declaración tuya. No desbloquea nada.</p>
      {
        auths.map((a) => (
          <label for={a.id} class="flex min-h-12 cursor-pointer items-center gap-3 border-t-[0.8px] border-v2-borde text-base">
            <input id={a.id} type="checkbox" checked={a.on} class="h-[22px] w-[22px] shrink-0 accent-v2-accion" />
            {a.label}
          </label>
        ))
      }
      <div class="mt-4 border-t-[0.8px] border-v2-borde pt-3"><SigueEnRedes redes={["TikTok", "LinkedIn"]} tarjeta={false} posicion="mi-cuenta" /></div>
    </section>
  </main>

  <script is:inline>
    document.querySelectorAll("[data-copiar-enlace]").forEach(function (b) {
      b.addEventListener("click", function () {
        var t = "https://lucirme.com/i/tu-enlace";
        if (navigator.clipboard) navigator.clipboard.writeText(t);
        b.textContent = "Enlace copiado";
      });
    });
  </script>
</LayoutV2>
