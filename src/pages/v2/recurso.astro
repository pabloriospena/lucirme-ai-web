---
// Vista de ejemplo del recurso en tres estados: antes, punto de pago y después.
// Se elige con ?estado=antes, ?estado=pago o ?estado=despues. No es un recurso real ni se indexa.
// Los datos son de muestra para revisar el diseño. El precio sale de src/data/precios.ts, no se escribe aquí.
import LayoutV2 from "../../layouts/LayoutV2.astro";
import EstadoAcceso from "../../components/v2/EstadoAcceso.astro";
import AvisoPago from "../../components/v2/AvisoPago.astro";
import CasillaAplique from "../../components/v2/CasillaAplique.astro";
import ContenidoRelacionado from "../../components/v2/ContenidoRelacionado.astro";
import { textoPrecio } from "../../data/precios.ts";
import { LINKS } from "../../lib/constants.js";

const estado = ["antes", "pago", "despues"].includes(Astro.url.searchParams.get("estado") ?? "")
  ? Astro.url.searchParams.get("estado")!
  : "antes";
const titulo = "20 prompts para NotebookLM";
const etiquetas = ["NotebookLM", "Para empezar"];
const precio = textoPrecio("ruta-product-paso-0");
const relacionados = [
  { titulo: "De notas a reportes con NotebookLM", tipo: "Guía", url: "/recursos/guia-notebooklm" },
  { titulo: "Guía de estudio con NotebookLM", tipo: "Guía", url: "/recursos/guia-estudio-notebooklm" },
  { titulo: "Prompteador", tipo: "Herramienta", url: "/recursos/prompteador" },
];
const pill = "rounded-full border-[0.8px] border-v2-borde bg-v2-chip px-2.5 py-0.5 text-xs font-semibold text-v2-cuerpo";
const volver = "inline-flex min-h-11 items-center text-sm font-semibold text-v2-accion";
const boton = "mt-6 flex min-h-[52px] items-center justify-center rounded-xl bg-v2-accion px-6 text-base font-bold text-v2-accion-texto hover:bg-v2-accion-hover";
---

<LayoutV2 title="Vista de ejemplo del recurso | LuciRMe AI" noindex>
  <div class="bg-v2-superficie px-4 py-2 text-center text-xs text-v2-cuerpo">
    Pantalla de ejemplo para revisar el diseño.
    <a href="?estado=antes" class="font-semibold text-v2-accion underline">Antes</a>,
    <a href="?estado=pago" class="font-semibold text-v2-accion underline">Punto de pago</a>,
    <a href="?estado=despues" class="font-semibold text-v2-accion underline">Después</a>.
  </div>

  <main class="px-4 pb-12 pt-5 sm:px-6">
    <div class="mx-auto max-w-2xl">
      {
        estado === "antes" && (
          <>
            <a href="/recursos" class={volver}>‹ Guías y herramientas</a>
            <ul class="mb-3 mt-1 flex flex-wrap gap-1.5">{etiquetas.map((t) => <li class={pill}>{t}</li>)}</ul>
            <h1 class="text-[32px] font-extrabold leading-[1.15] tracking-[-0.9px] text-v2-texto">{titulo}</h1>
            <p class="mb-4 mt-2 text-base leading-6 text-v2-cuerpo">Prompts listos para copiar y usar con tus propios documentos.</p>
            <EstadoAcceso estado="de-pago" precio={precio} grande />
            <p class="mt-5 text-xs font-bold uppercase tracking-[0.05em] text-v2-suave">Vista previa</p>
            <div class="mt-2 flex flex-col gap-2.5 rounded-xl border-[0.8px] border-v2-borde bg-v2-superficie p-4" aria-hidden="true">
              <span class="h-2.5 w-[90%] rounded-md bg-v2-barra-fondo"></span>
              <span class="h-2.5 w-full rounded-md bg-v2-barra-fondo"></span>
              <span class="h-2.5 w-[70%] rounded-md bg-v2-barra-fondo"></span>
              <span class="h-2.5 w-[40%] rounded-md bg-v2-barra-fondo"></span>
            </div>
            <a href="?estado=pago" class={boton}>Desbloquear la guía</a>
          </>
        )
      }
      {
        estado === "pago" && (
          <>
            <a href="?estado=antes" class={volver}>‹ {titulo}</a>
            <h1 class="mb-2 mt-1 text-[32px] font-extrabold leading-[1.15] tracking-[-0.9px] text-v2-texto">Desbloquea {titulo}</h1>
            <p class="mb-4 text-base leading-6 text-v2-cuerpo">Tienes dos salidas. Elige la que te sirva.</p>
            <AvisoPago titulo={titulo} precio={precio} hrefPago={LINKS.whatsapp} invitaciones={3} invitados={1} />
          </>
        )
      }
      {
        estado === "despues" && (
          <>
            <a href="/recursos" class={volver}>‹ Guías y herramientas</a>
            <div class="mb-3 mt-1 flex flex-wrap items-center gap-1.5">
              <EstadoAcceso estado="desbloqueada" />
              {etiquetas.map((t) => <span class={pill}>{t}</span>)}
            </div>
            <h1 class="mb-4 text-[32px] font-extrabold leading-[1.15] tracking-[-0.9px] text-v2-texto">{titulo}</h1>
            <div class="flex flex-col gap-3">
              {[1, 2].map((n) => (
                <div class="rounded-2xl border-[0.8px] border-v2-borde bg-v2-fondo p-5">
                  <p class="text-xs font-bold uppercase tracking-[0.05em] text-v2-suave">Prompt {n}</p>
                  <div class="mt-2.5 flex flex-col gap-2" aria-hidden="true">
                    <span class="h-2.5 w-[95%] rounded-md bg-v2-barra-fondo"></span>
                    <span class="h-2.5 w-4/5 rounded-md bg-v2-barra-fondo"></span>
                  </div>
                </div>
              ))}
            </div>
            <div class="mt-4"><CasillaAplique /></div>
            <div class="mt-8"><ContenidoRelacionado items={relacionados} /></div>
          </>
        )
      }
    </div>
  </main>
  <script is:inline>
    document.querySelectorAll("[data-copiar-enlace]").forEach(function (b) {
      b.addEventListener("click", function () {
        var t = "https://lucirme.com/i/tu-enlace";
        if (navigator.clipboard) navigator.clipboard.writeText(t);
        b.textContent = "Enlace copiado";
      });
    });
  </script>
</LayoutV2>
