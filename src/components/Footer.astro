---
// Footer.astro
const year = new Date().getFullYear();
---

<footer class="bg-deep text-white py-12 px-6 mt-24 border-t border-white/5">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    
    <!-- Marca + Tagline -->
    <div class="flex items-center gap-3">
      <span class="text-lg font-bold text-white">LuciRMe AI</span>
      <span class="text-gray-500 text-sm hidden md:inline">·</span>
      <p class="text-sm text-gray-500">Devuelve tiempo. Aplica IA con criterio.</p>
    </div>

    <!-- Legal + Dashboard (discreto) -->
    <div class="flex items-center gap-4 text-xs text-gray-600">
      <a href="/terminos" class="hover:text-gray-400 transition">Términos</a>
      <span>/</span>
      <a href="/privacidad" class="hover:text-gray-400 transition">Privacidad</a>
      <span class="hidden md:inline">/</span>
      <a href="/dashboard" class="hidden md:inline hover:text-teal transition">Dashboard</a>
    </div>

  </div>

  <!-- Copyright (sutil) -->
  <div class="max-w-6xl mx-auto mt-8 pt-6 border-t border-white/5 text-center">
    <p class="text-[10px] text-gray-700 uppercase tracking-widest">
      © LuciRMe AI {year}
    </p>
  </div>
</footer>