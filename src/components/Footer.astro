---
import { LINKS } from "../lib/constants.js";

const year = new Date().getFullYear();
const whatsappBase = LINKS.whatsapp || "https://wa.me/573053046180";
---

<footer class="w-full bg-white border-t border-slate-200 py-16">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-12">
    
    <!-- Logo & Description -->
    <div class="lg:col-span-2 flex flex-col gap-4">
      <a class="flex items-center gap-2.5" href="/">
        <img
          src="/logo-lucirme.png"
          alt="LuciRMe AI"
          class="h-8 w-auto object-contain"
        />
        <span class="font-bold text-lg text-slate-900 tracking-tight">
          LuciRMe<span class="text-teal-700 ml-0.5">AI</span>
        </span>
      </a>
      <p class="text-sm text-slate-600 leading-relaxed max-w-xs">
        Menos operatividad manual. Aplica Inteligencia Artificial con criterio en flujos reales de trabajo.
      </p>
      <div class="mt-2">
        <p class="text-xs font-bold text-slate-900 uppercase tracking-wider">Arquitecto & Estratega</p>
        <p class="text-sm font-semibold text-slate-700">Pablo Ríos</p>
        <p class="text-xs text-slate-500">Consultor de Producto, Ops e IA.</p>
      </div>
    </div>

    <!-- Col 1: Empresas -->
    <div class="space-y-4">
      <h3 class="font-bold text-sm text-slate-900">1. Empresas</h3>
      <ul class="space-y-2 text-sm text-slate-600">
        <li><a href="/empresas#diagnostico" class="hover:text-teal-700">Diagnóstico de Procesos</a></li>
        <li><a href="/empresas#talleres" class="hover:text-teal-700">Talleres Inmersión B2B</a></li>
        <li><a href="/empresas#autonomia" class="hover:text-teal-700">Ciclo Autonomía Operativa</a></li>
        <li><a href="/empresas#casos" class="hover:text-teal-700">Casos Reales & Evidencia</a></li>
      </ul>
    </div>

    <!-- Col 2: Mentorías -->
    <div class="space-y-4">
      <h3 class="font-bold text-sm text-slate-900">2. Mentorías</h3>
      <ul class="space-y-2 text-sm text-slate-600">
        <li><a href="/mentoria" class="hover:text-teal-700">Mentoria 1 a 1 Estratégica</a></li>
        <li><a href="/mentoria#producto" class="hover:text-teal-700">En Producto (PM & Discovery)</a></li>
        <li><a href="/mentoria#educacion" class="hover:text-teal-700">En Educación & Formación</a></li>
        <li><a href="/mentoria#cafe" class="hover:text-teal-700">Café Estrategia (30 min)</a></li>
      </ul>
    </div>

    <!-- Col 3: Rutas & Hub -->
    <div class="space-y-4">
      <h3 class="font-bold text-sm text-slate-900">3. Rutas & Hub</h3>
      <ul class="space-y-2 text-sm text-slate-600">
        <li><a href="/rutas" class="hover:text-teal-700">Ver todas las Rutas</a></li>
        <li><a href="/rutas/comunicacion" class="hover:text-teal-700">01. Comunicación con IA</a></li>
        <li><a href="/rutas/product" class="hover:text-teal-700">02. Product Management</a></li>
        <li><a href="/rutas/notebooklm" class="hover:text-teal-700">03. NotebookLM Mastery</a></li>
        <li><a href="/rutas/empleabilidad" class="hover:text-teal-700">04. Empleabilidad & CV</a></li>
        <li><a href="/rutas/creacion" class="hover:text-teal-700">05. Creación Visual</a></li>
      </ul>
    </div>

    <!-- Col 4: Recursos & Contacto -->
    <div class="space-y-4">
      <h3 class="font-bold text-sm text-slate-900">4. Recursos</h3>
      <ul class="space-y-2 text-sm text-slate-600">
        <li><a href="/recursos/termometro" class="hover:text-teal-700">Termómetro IA</a></li>
        <li><a href="/recursos/atajos" class="hover:text-teal-700">Atajos Visuales</a></li>
        <li><a href="/recursos/biblioteca" class="hover:text-teal-700">Biblioteca Abierta</a></li>
        <li><a href="/recursos/guias" class="hover:text-teal-700">Guías y Plantillas</a></li>
      </ul>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 mt-16 pt-8 border-t border-slate-200 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
    <p>© {year} LuciRMe AI · Diseñado con criterio y sobriedad técnica.</p>
    <div class="flex gap-4">
      <a href="/terminos" class="hover:text-slate-900">Términos</a>
      <a href="/privacidad" class="hover:text-slate-900">Privacidad</a>
      <a href="/etica" class="hover:text-slate-900">Código de Ética de IA</a>
      <a href="/aviso-legal" class="hover:text-slate-900">Aviso Legal</a>
    </div>
  </div>
</footer>