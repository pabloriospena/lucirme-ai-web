---
---
<div class="currency-selector inline-flex items-center gap-1 bg-slate-800 text-white rounded-lg px-3 py-1.5 text-xs font-semibold cursor-pointer relative currency-toggle">
  <span class="current-currency-label">🇨🇴 COP</span>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
  
  <div class="absolute top-full right-0 mt-2 bg-white text-slate-800 rounded-lg shadow-xl border border-slate-200 hidden min-w-[140px] z-50 currency-menu">
    <button class="w-full text-left px-4 py-2 hover:bg-slate-50 flex items-center gap-2" data-currency="COP">
      <span>🇨🇴</span> COP — Colombia
    </button>
    <button class="w-full text-left px-4 py-2 hover:bg-slate-50 flex items-center gap-2" data-currency="USD">
      <span>🌎</span> USD — Internacional
    </button>
  </div>
</div>

<script is:inline>
  console.log("CurrencySelector initialized");
  (function initCurrencySelectors() {
    function setCurrency(currency) {
      console.log("Setting currency to:", currency);
      localStorage.setItem('user_currency', currency);
      
      const priceElements = document.querySelectorAll('[data-currency-price]');
      priceElements.forEach(el => {
        el.classList.add('hidden');
        if (el.dataset.currencyPrice === currency) {
          el.classList.remove('hidden');
        }
      });
      
      document.querySelectorAll('.current-currency-label').forEach(el => {
        el.innerText = currency === 'COP' ? '🇨🇴 COP' : '🌎 USD';
      });
      document.querySelectorAll('.currency-menu').forEach(el => el.classList.add('hidden'));
    }

    document.addEventListener('click', (e) => {
      const toggle = e.target.closest('.currency-toggle');
      if (toggle) {
        console.log("Toggle clicked");
        const menu = toggle.querySelector('.currency-menu');
        if(menu) {
            e.stopPropagation();
            menu.classList.toggle('hidden');
        }
        return;
      }
      
      const btn = e.target.closest('[data-currency]');
      if (btn) {
        console.log("Currency button clicked:", btn.dataset.currency);
        setCurrency(btn.dataset.currency);
        return;
      }
      
      document.querySelectorAll('.currency-menu').forEach(el => el.classList.add('hidden'));
    });

    // Initialize based on saved preference or IP detection
    const saved = localStorage.getItem('user_currency');
    if (saved) {
      console.log("Saved currency found:", saved);
      setCurrency(saved);
    } else {
      console.log("No saved currency, detecting...");
      fetch('https://ipapi.co/json/')
        .then(res => res.json())
        .then(data => {
            console.log("IP detection result:", data.country_code);
            setCurrency(data.country_code === 'CO' ? 'COP' : 'USD');
        })
        .catch(err => {
            console.error("IP detection failed, defaulting to USD", err);
            setCurrency('USD');
        });
    }
  })();
</script>
