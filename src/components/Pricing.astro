---
// Componente de Precios Optimizado con doble moneda y desglose de horas
import { LINKS } from '../lib/constants.js';

---

<section id="precios" class="py-24 px-4 bg-white">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold text-deep text-center mb-16">Inversión orientativa</h2>
    <div class="grid md:grid-cols-2 gap-8">
      
      <!-- COLUMNA PROFESIONALES -->
      <div class="space-y-8">
        <h3 class="text-xl font-bold text-deep flex items-center gap-3">👤 Para Profesionales</h3>
        
        <!-- Foco Express -->
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm hover:border-teal transition-all">
          <h4 class="font-bold text-deep text-lg mb-1">🎯 Sesión de Enfoque</h4>
          <p class="text-xs text-teal font-bold uppercase tracking-widest mb-4">1 hora de trabajo directo</p>
          <div class="text-2xl font-bold text-deep mb-6">$116.000 COP <span class="text-sm font-normal text-gray-400">/ $35 USD</span></div>
          <p class="text-sm text-gray-600 mb-6">Diagnóstico rápido + 1 flujo de IA configurado. Sales con tareas resueltas y pasos exactos para mañana.</p>
                    <hr class="my-6 border-t-2 border-deep-300" />

          <h4 class="font-bold text-deep text-lg mb-1">🔄 Ciclo Individual</h4><span class="text-sm font-normal text-gray-400">Para quienes quieren escalar</span>
          <p class="text-xs text-teal font-bold uppercase tracking-widest mb-4">8 horas de trabajo (4 sesiones)</p>
          <div class="text-2xl font-bold text-deep mb-6">$350.000 COP <span class="text-sm font-normal text-gray-400">/ $98 USD</span></div>
          <p class="text-sm text-gray-600 mb-6 font-medium">Protocolos, Refinamiento e IA personalizada para tu carrera.</p>
          <ul class="space-y-2 text-sm text-gray-600 mb-6">
            <li>✓ Semana 1: Auditoría profunda</li>
            <li>✓ Semana 2-3: 4 acciones con IA</li>
            <li>✓ Semana 4: Documentación de autonomía</li>
          </ul>

        </div>
        
      </div>

      <!-- COLUMNA EMPRESAS -->
      <div class="space-y-8">
        <h3 class="text-xl font-bold text-deep flex items-center gap-3">🏢 Para Startups / Empresas</h3>
        
        <!-- Taller -->
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm hover:border-teal transition-all">
          <h4 class="font-bold text-deep text-lg mb-1">🔥 Taller de Inmersión</h4>
          <p class="text-xs text-teal font-bold uppercase tracking-widest mb-4">2-3 horas de taller práctico</p>
          <p class="text-2xl font-bold text-deep mb-6">$620.000 COP <span class="text-sm font-normal text-gray-400">/ $170 USD</span></p>
          <p class="text-sm text-gray-600 mb-6">Trabajo directo con tu equipo. Identificamos cuellos de botella y configuramos el primer flujo prioritario.</p>
          <hr class="my-6 border-t-2 border-deep-300" />
          <h4 class="font-bold text-deep text-lg mb-1">🚀 Ciclo de Autonomía</h4><span class="text-sm font-normal text-gray-400">Para quienes quieren escalar</span>
          <p class="text-xs text-teal font-bold uppercase tracking-widest mb-4">Mín. 32 horas (8 semanas + seguimiento)</p>
          <p class="text-2xl font-bold text-deep mb-6">Desde $8.800.000 COP <span class="text-sm font-normal text-gray-400">/ $1.160 USD</span></p>
          <p class="text-sm text-gray-600 mb-6 font-medium">Implementación completa para escalar procesos operativos.</p>
          <ul class="space-y-2 text-sm text-gray-600 mb-6">
            <li>✓ Auditoría de procesos + IA</li>
            <li>✓ 2-3 flujos complejos</li>
            <li>✓ Entrenamiento equipo y soporte</li>
          </ul>
        </div>
      </div>
    </div>
     <!-- CTA CENTRALIZADO -->
    <div class="mt-20 text-center">
      <a 
        href={LINKS.calendly} 
        target="_blank"
        class="inline-block bg-orange text-white px-12 py-5 rounded-lg font-bold text-lg hover:bg-orange/90 transition shadow-xl"
      >
        Agendar Café Estratégico (30 min) →
      </a>
    </div>
  </div>
</section>