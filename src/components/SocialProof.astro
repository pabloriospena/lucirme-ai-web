---
// src/components/Resultados.astro
const testimonios = [
  {
    perfil: "👤 Administrador Anónimo",
    quote:
      "Recuperé 7h/semana automatizando reportes. Ahora enfoco ese tiempo en clientes que sí pagan.",
    result: "Sesión de enfoque + Guía personalizada",
  },
  {
    perfil: "👤 María Camila B. - Product Manager",
    quote:
      "Mi objetivo no es usar IA por moda, es dejar de apagar incendios y tener una visión más tranquila y estratégica de mi pipeline.",
    result: "Sesión de enfoque + Estructura de Automatización",
  },
  {
    perfil: "👤 José Madriz - Data Analytics",
    quote:
      "LucirMe me dio el 'chip' para dejar de quebrarme la cabeza por algo que no es mío y empezar a sistematizar soluciones.",
    result: "Sesión de enfoque + Guía personalizada",
  },
  {
    perfil: "👤 David M. Muñoz - Líder de desarrollo",
    quote:
      "Pude validar el camino para mi cliente y las iniciativas de IA que estamos implementando. Fue justo lo que necesitaba para aterrizar la estrategia.",
    result: "Sesión de enfoque + Plan de ejecución estratégico",
  },
  {
    perfil: "🏢 Almamotor",
    quote:
      "Nos encantó la metodología y la manera de enseñar. Nos diste claridad práctica para aplicar lo aprendido de inmediato en el equipo.",
    result: "Taller de inmersión",
  },
  {
    perfil: "🏢 InterobrasER",
    quote:
      "Un taller productivo y muy necesario. El equipo entendió la situación y vio los beneficios reales de aplicar estos cambios.",
    result: "Taller de inmersión + Ciclo de autonomía",
  },
  {
    perfil: "👤 Cecilia Morete - Alumno",
    quote:
      "Qué felicidad ser parte de este proceso. Ahora tengo las herramientas organizadas y la claridad para hacer las preguntas correctas y avanzar.",
    result: "Acompañamiento individual",
  },
  {
    perfil: "👤 Melody Abele - Alumno (Melfa CX)",
    quote:
      "Gracias a tus herramientas y devoluciones, mi proyecto hoy tiene mucho más sentido, un norte claro y gran potencial. Aprendizaje real.",
    result: "Sesión de enfoque + Estructura de Automatización",
  },
  {
    perfil: "🚀 Startup B2B (5 personas)",
    quote:
      "Redujimos de 12 a 4 días el ciclo de decisión de features. Sin contratar más PMs.",
    result: "Taller de inmersión + Ciclo de autonomía",
  },
  {
    perfil: "🏢 Empresa de Servicios (50+) RRHH",
    quote:
      "Eliminamos 3 aprobaciones manuales en onboarding. Error humano: -80%.",
    result: "Taller de inmersión + Ciclo de autonomía",
  },
  {
    perfil: "🏢 Administradora - Fundación Casa Universitaria La Chinca",
    quote:
      "Tu charla tuvo muy buenos comentarios. A las estudiantes les gustó mucho el enfoque práctico.",
    result: "Taller de inmersión",
  },
  {
    perfil: "💼 Consultor Tech",
    quote:
      "Sistematicé mi propuesta de valor. El tiempo de onboarding de clientes bajó a la mitad.",
    result: "Sesión de enfoque",
  },
  {
    perfil: "🌱 Agencia de Diseño",
    quote:
      "Automatizamos la entrega de assets. 4 horas ahorradas por proyecto entregado.",
    result: "Ciclo de autonomía",
  },
];
---

<section class="py-16 px-4 bg-white border-t border-gray-100">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-2xl font-bold text-deep tracking-tight mb-3">
        Algunos resultados
      </h2>
      <p class="text-base text-gray-600 max-w-xl mx-auto">
        Impacto real medido en los flujos de trabajo de nuestros usuarios. Sin
        teoría vacía.
      </p>
    </div>

    <!-- Rejilla compacta de 3 columnas en desktop y 2 en tablets -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        testimonios.map((t) => (
          <div class="group bg-[#F8FAFC] p-6 rounded-xl border border-gray-100 flex flex-col justify-between hover:bg-white hover:shadow-lg hover:border-[#0D9488]/30 transition-all duration-200">
            <div>
              <div class="mb-4">
                <span class="inline-block bg-gray-200/50 group-hover:bg-[#0D9488]/10 text-gray-600 group-hover:text-[#0D9488] text-[10px] font-semibold px-2.5 py-1 rounded-md transition-colors duration-200">
                  {t.perfil}
                </span>
              </div>

              <blockquote class="text-gray-600 leading-relaxed mb-6 text-sm">
                "{t.quote}"
              </blockquote>
            </div>

            <div class="pt-4 border-t border-gray-100 mt-auto">
              <span class="block text-[9px] font-bold text-gray-400 uppercase tracking-wider mb-1">
                Solución
              </span>
              <div class="flex items-center gap-1.5 text-[#0D9488] font-medium text-xs">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2.5"
                  stroke="currentColor"
                  class="w-3.5 h-3.5 shrink-0"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                  />
                </svg>
                <span class="truncate" title={t.result}>
                  {t.result}
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
