---
// src/components/SocialProof.astro
// Componente de prueba social modular para Empresas y Mentorías 1-1 (100% libre de emojis)
interface Props {
  tipo?: "empresas" | "mentorías" | "mentorias" | "1-1" | "profesionales" | "general" | string;
  id?: string;
  class?: string;
  titulo?: string;
  subtitulo?: string;
  eyebrow?: string;
}

const {
  tipo = "general",
  id = "testimonios",
  class: className = "",
  titulo,
  subtitulo,
  eyebrow,
} = Astro.props;

import { testimonios } from "../lib/testimonios";

const normalized = tipo.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

const esEmpresas = normalized === "empresas" || normalized === "equipos";
const esMentorias = normalized === "mentorias" || normalized === "1-1" || normalized === "profesionales";

const items = esEmpresas
  ? testimonios.filter((t) => t.categoria === "empresas")
  : esMentorias
  ? testimonios.filter((t) => t.categoria === "mentorias")
  : testimonios;

const headerConfig = esEmpresas
  ? {
      eyebrow: eyebrow || "Casos de Equipos · B2B",
      titulo: titulo || "Resultados que ya conseguimos con equipos",
      subtitulo:
        subtitulo ||
        "No hablamos de IA en abstracto. Trabajamos sobre procesos reales y buscamos cambios que el equipo pueda aplicar y sostener.",
    }
  : esMentorias
  ? {
      eyebrow: eyebrow || "Acompañamiento 1-1 · Profesionales",
      titulo: titulo || "Personas que ya están trabajando de otra manera",
      subtitulo:
        subtitulo ||
        "Cada acompañamiento parte de un problema concreto. La idea no es darte más teoría, sino ayudarte a encontrar claridad y avanzar.",
    }
  : {
      eyebrow: eyebrow || "Evidencia Real",
      titulo: titulo || "Algunos resultados",
      subtitulo:
        subtitulo ||
        "Impacto medido en el trabajo real de nuestros usuarios y clientes. Sin teoría vacía.",
    };
---

<section id={id} class={`py-16 px-4 sm:px-6 bg-white border-t border-slate-200/80 ${className}`}>
  <div class="max-w-6xl mx-auto">
    <!-- Header de Sección -->
    <div class="max-w-3xl mb-12 text-left">
      <span class="font-mono text-xs font-semibold text-teal-800 uppercase tracking-wider block mb-2">
        {headerConfig.eyebrow}
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight mb-3">
        {headerConfig.titulo}
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        {headerConfig.subtitulo}
      </p>
    </div>

    <!-- Rejilla de Tarjetas -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 items-stretch">
      {
        items.map((t) => (
          <div class="group bg-[#F8FAFC] p-6 rounded-2xl border border-slate-200/80 flex flex-col justify-between hover:bg-white hover:border-[#0D9488]/40 hover:shadow-md transition-all duration-200">
            <div>
              <!-- Cabecera de la Tarjeta: Quién -->
              <div class="flex items-start justify-between gap-3 mb-4 pb-3.5 border-b border-slate-200/60">
                <div class="min-w-0 flex-1">
                  <h3 class="text-sm font-bold text-slate-900 truncate group-hover:text-[#0D9488] transition-colors">
                    {t.nombre}
                  </h3>
                  <p class="text-[11px] font-mono text-slate-500 truncate mt-0.5">
                    {t.rol}
                  </p>
                </div>
                {t.metrica && (
                  <span class="shrink-0 bg-emerald-50 text-emerald-800 border border-emerald-200/80 text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full">
                    {t.metrica}
                  </span>
                )}
              </div>

              <!-- Testimonio / Qué cambió -->
              <blockquote class="text-slate-700 text-xs sm:text-sm leading-relaxed mb-6 font-normal">
                "{t.quote}"
              </blockquote>
            </div>

            <!-- Información secundaria: Solución -->
            <div class="pt-3.5 border-t border-slate-200/60 mt-auto flex items-center justify-between gap-2">
              <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider shrink-0 font-medium">
                Solución:
              </span>
              <div class="flex items-center gap-1.5 min-w-0">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2.5"
                  stroke="currentColor"
                  class="w-3.5 h-3.5 text-[#0D9488] shrink-0"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                  />
                </svg>
                <span
                  class="text-[11px] font-medium text-[#0D9488] truncate text-right bg-white px-2 py-0.5 rounded-md border border-slate-200/70"
                  title={t.solucion}
                >
                  {t.solucion}
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
