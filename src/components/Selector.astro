---
// Selector.astro
---
<div id="selector-overlay" class="fixed inset-0 bg-[#0F172A] z-[100] hidden flex items-center justify-center p-6 backdrop-blur-sm">
  <button onclick="document.getElementById('selector-overlay').classList.add('hidden')" class="absolute top-8 right-8 text-white/40 hover:text-white text-3xl">✕</button>

  <div class="max-w-xl w-full">
    <!-- Contenedor dinámico -->
    <div id="selector-container" class="space-y-8 text-center animate-fade-in">
       <h2 id="titulo" class="text-3xl font-bold text-white mb-8">¿Cuál es tu situación profesional actual?</h2>
       <div id="opciones-container" class="grid gap-4">
          <button onclick="seleccionarPerfil('empresa')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">Profesional, buscando potenciar mi carrera y eficiencia.</button>
          <button onclick="seleccionarPerfil('startup')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">Líder de equipo, Project Manager o Product Manager en una Startup.</button>
          <button onclick="seleccionarPerfil('pro')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">Fundador, Director o Dueño de Empresa tradicional.</button>
       </div>
    </div>
  </div>
</div>

<script is:inline>
  let estado = { perfil: null, paso: 1, respuestas: {} };

  const estructura = {
    empresa: [
      { q: "¿Cuál es tu mayor cuello de botella operativo esta semana?", opts: ["'Copiar, pegar' datos y tareas repetitivas que me quitan tiempo para aportar valor real o buscar mejores oportunidades.", "La parálisis por análisis: demasiadas herramientas e ideas de IA, pero ningún flujo automatizado que use el equipo.", "Gestión e infoxicación: pierdo horas compilando reportes manuales o persiguiendo actualizaciones de mi operación."] },
      { q: "¿Cómo manejas la IA en tu día a día actualmente?", opts: ["Uso prompts sueltos en ChatGPT, pero me frustra tener que repetir lo mismo de forma manual cada vez.", "Intentamos conectar herramientas (ej. Notion, Make), pero los flujos son frágiles o dependemos de desarrolladores.", "No la implementamos formalmente por falta de tiempo o por considerarla demasiado técnica para el negocio actual."] },
      { q: "Si liberaras 10 horas operativas de tu semana, ¿dónde estaría tu foco?", opts: ["A) En liderar iniciativas estratégicas, capacitarme o dar el salto al siguiente nivel.", "En pulir el roadmap del producto, mejorar la UX o acelerar los lanzamientos del equipo.", "En optimizar el margen del negocio, delegar la operación o recuperar mi tiempo personal."] }
    ],
    startup: [
      { q: "¿Cuál es tu mayor cuello de botella operativo esta semana?", opts: ["'Copiar, pegar' datos y tareas repetitivas que me quitan tiempo para aportar valor real o buscar mejores oportunidades.", "La parálisis por análisis: demasiadas herramientas e ideas de IA, pero ningún flujo automatizado que use el equipo.", "Gestión e infoxicación: pierdo horas compilando reportes manuales o persiguiendo actualizaciones de mi operación."] },
      { q: "¿Cómo manejas la IA en tu día a día actualmente?", opts: ["Uso prompts sueltos en ChatGPT, pero me frustra tener que repetir lo mismo de forma manual cada vez.", "Intentamos conectar herramientas (ej. Notion, Make), pero los flujos son frágiles o dependemos de desarrolladores.", "No la implementamos formalmente por falta de tiempo o por considerarla demasiado técnica para el negocio actual."] },
      { q: "Si liberaras 10 horas operativas de tu semana, ¿dónde estaría tu foco?", opts: ["A) En liderar iniciativas estratégicas, capacitarme o dar el salto al siguiente nivel.", "En pulir el roadmap del producto, mejorar la UX o acelerar los lanzamientos del equipo.", "En optimizar el margen del negocio, delegar la operación o recuperar mi tiempo personal."] }

    ],
    pro: [
      { q: "¿Cuál es tu mayor cuello de botella operativo esta semana?", opts: ["'Copiar, pegar' datos y tareas repetitivas que me quitan tiempo para aportar valor real o buscar mejores oportunidades.", "La parálisis por análisis: demasiadas herramientas e ideas de IA, pero ningún flujo automatizado que use el equipo.", "Gestión e infoxicación: pierdo horas compilando reportes manuales o persiguiendo actualizaciones de mi operación."] },
      { q: "¿Cómo manejas la IA en tu día a día actualmente?", opts: ["Uso prompts sueltos en ChatGPT, pero me frustra tener que repetir lo mismo de forma manual cada vez.", "Intentamos conectar herramientas (ej. Notion, Make), pero los flujos son frágiles o dependemos de desarrolladores.", "No la implementamos formalmente por falta de tiempo o por considerarla demasiado técnica para el negocio actual."] },
      { q: "Si liberaras 10 horas operativas de tu semana, ¿dónde estaría tu foco?", opts: ["A) En liderar iniciativas estratégicas, capacitarme o dar el salto al siguiente nivel.", "En pulir el roadmap del producto, mejorar la UX o acelerar los lanzamientos del equipo.", "En optimizar el margen del negocio, delegar la operación o recuperar mi tiempo personal."] }

    ]
  };

  function seleccionarPerfil(p) {
    estado.perfil = p;
    estado.paso = 1; // Primer paso de las preguntas específicas
    renderizarPaso();
  }

  function renderizarPaso() {
    const contenedor = document.getElementById('opciones-container');
    const titulo = document.getElementById('titulo');
    const preguntas = estructura[estado.perfil];
    
    if (estado.paso > preguntas.length) {
      finalizar();
      return;
    }

    const pasoActual = preguntas[estado.paso - 1];
    titulo.innerText = pasoActual.q;
    contenedor.innerHTML = '';
    
    pasoActual.opts.forEach(op => {
      const btn = document.createElement('button');
      btn.innerText = op;
      btn.className = "w-full p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5";
      btn.onclick = () => {
        estado.paso++;
        renderizarPaso();
      };
      contenedor.appendChild(btn);
    });
  }

function finalizar() {
  const params = new URLSearchParams({
    perfil: estado.perfil,
    dolor: estado.dolor
  });
    window.location.href = `/resultado?perfil=${estado.perfil}&dolor=${estado.dolor}`;
}
</script>