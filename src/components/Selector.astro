---
// Selector.astro - Flujo de diagnóstico profesional
---
<div id="selector-overlay" class="fixed inset-0 bg-[#0F172A] z-[100] hidden flex items-center justify-center p-6 backdrop-blur-sm">
  <button onclick="document.getElementById('selector-overlay').classList.add('hidden')" class="absolute top-8 right-8 text-white/40 hover:text-white text-3xl">✕</button>

  <div class="max-w-xl w-full text-white" x-data="selectorLogica()">
    <div id="selector-container" class="space-y-8 animate-fade-in">
       <h2 id="selector-title" class="text-3xl font-bold text-white text-center">¿Quién toma la decisión?</h2>
       <div id="opciones-container" class="grid gap-3"></div>
    </div>
  </div>
</div>

<script is:inline>
  const flujo = {
    paso0: {
      q: "¿Quién toma la decisión de implementar IA en tu caso?",
      opts: ["Yo decido por mí", "Decido con mi equipo", "Necesito aprobación de otros", "Ninguna de las anteriores", "Es un contexto mixto"]
    },
    paso1: {
      individual: { q: "¿Qué te quita más tiempo?", opts: ["Reportes/coordinación manual", "Documentación repetitiva", "Información dispersa", "Seguimiento de tareas", "Otro"] },
      equipo: { q: "¿Qué frena más a tu equipo?", opts: ["Decisiones sin datos", "Coordinación WhatsApp/Email", "Backlog sin rumbo", "Herramientas desconectadas", "Otro"] },
      empresa: { q: "¿Qué proceso genera más fricción?", opts: ["Aprobaciones manuales", "Datos en silos", "Reportes sin insights", "Onboarding lento", "Otro"] }
    },
    paso2: { q: "¿Cómo usas la IA hoy?", opts: ["Prompts sueltos manuales", "Conexión frágil (Make/Notion)", "No implementada", "Escalando con criterio"] },
    paso3: { q: "¿Si recuperaras 10h, qué priorizarías?", opts: ["Enfocarme en trabajo de alto valor", "Pulir procesos internos", "Presentar propuesta a decisores", "Explorar opciones", "Otro"] }
  };

  let estado = { perfil: '', respuestas: {}, paso: 0 };

  function renderizar() {
    const container = document.getElementById('opciones-container');
    const titulo = document.getElementById('selector-title');
    container.innerHTML = '';

    if (estado.paso === 0) {
      titulo.innerText = flujo.paso0.q;
      flujo.paso0.opts.forEach(op => agregarBoton(op, () => {
        estado.respuestas.decision = op;
        estado.perfil = op.includes('Yo decido') ? 'individual' : op.includes('equipo') ? 'equipo' : 'empresa';
        estado.paso = 1;
        renderizar();
      }));
    } else if (estado.paso === 1) {
      titulo.innerText = flujo.paso1[estado.perfil].q;
      flujo.paso1[estado.perfil].opts.forEach(op => agregarBoton(op, () => { estado.respuestas.dolor = op; estado.paso++; renderizar(); }));
    } else if (estado.paso === 2) {
      titulo.innerText = flujo.paso2.q;
      flujo.paso2.opts.forEach(op => agregarBoton(op, () => { estado.respuestas.usoIA = op; estado.paso++; renderizar(); }));
    } else if (estado.paso === 3) {
      titulo.innerText = flujo.paso3.q;
      flujo.paso3.opts.forEach(op => agregarBoton(op, () => { estado.respuestas.objetivo = op; finalizar(); }));
    }
  }

  function agregarBoton(texto, callback) {
    const btn = document.createElement('button');
    btn.className = "w-full p-4 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5";
    btn.innerText = texto;
    btn.onclick = callback;
    document.getElementById('opciones-container').appendChild(btn);
  }

  async function finalizar() {
    await fetch('/api/guardar-diagnostico', { method: 'POST', body: JSON.stringify(estado.respuestas) });
    window.location.href = `/resultado?perfil=${estado.perfil}&dolor=${estado.respuestas.dolor}`;
  }

  window.iniciarFlujo = () => renderizar();
  renderizar();
</script>