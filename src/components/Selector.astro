---
// Selector.astro
---
<div id="selector-overlay" class="fixed inset-0 bg-[#0F172A] z-[100] hidden flex items-center justify-center p-6 backdrop-blur-sm">
  <button onclick="document.getElementById('selector-overlay').classList.add('hidden')" class="absolute top-8 right-8 text-white/40 hover:text-white text-3xl">✕</button>

  <div class="max-w-xl w-full">
    <!-- Contenedor dinámico -->
    <div id="selector-container" class="space-y-8 text-center animate-fade-in">
       <h2 id="titulo" class="text-3xl font-bold text-white mb-8">¿Qué te trae al laboratorio?</h2>
       <div id="opciones-container" class="grid gap-4">
          <button onclick="seleccionarPerfil('empresa')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">🏢 Empresa</button>
          <button onclick="seleccionarPerfil('startup')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">🚀 Startup</button>
          <button onclick="seleccionarPerfil('pro')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">👤 Profesional</button>
       </div>
    </div>
  </div>
</div>

<script is:inline>
  let estado = { perfil: null, paso: 1, respuestas: {} };

  const estructura = {
    empresa: [
      { q: "¿Área interesada?", opts: ["Operaciones", "RRHH", "Finanzas"] },
      { q: "¿Cual es el mayor dolor?", opts: ["Procesos manuales", "Errores repetitivos"] }
    ],
    startup: [
      { q: "¿En qué etapa está tu producto?", opts: ["MVP", "Escala", "Pre-seed"] },
      { q: "¿Tu cuello de botella es...?", opts: ["Backlog", "Roadmap"] }
    ],
    pro: [
      { q: "¿Qué te quita más tiempo?", opts: ["Organización", "Reportes", "Decisiones"] }
    ]
  };

  function seleccionarPerfil(p) {
    estado.perfil = p;
    estado.paso = 1; // Primer paso de las preguntas específicas
    renderizarPaso();
  }

  function renderizarPaso() {
    const contenedor = document.getElementById('opciones-container');
    const titulo = document.getElementById('titulo');
    const preguntas = estructura[estado.perfil];
    
    if (estado.paso > preguntas.length) {
      finalizar();
      return;
    }

    const pasoActual = preguntas[estado.paso - 1];
    titulo.innerText = pasoActual.q;
    contenedor.innerHTML = '';
    
    pasoActual.opts.forEach(op => {
      const btn = document.createElement('button');
      btn.innerText = op;
      btn.className = "w-full p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5";
      btn.onclick = () => {
        estado.paso++;
        renderizarPaso();
      };
      contenedor.appendChild(btn);
    });
  }

function finalizar() {
  const params = new URLSearchParams({
    perfil: estado.perfil,
    dolor: estado.dolor
  });
  window.location.href = `/resultado?${params.toString()}`;
}
</script>