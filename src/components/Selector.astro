---
// Selector.astro
---
<div id="selector-overlay" class="fixed inset-0 bg-[#0F172A] z-[100] hidden flex items-center justify-center p-6 backdrop-blur-sm">
  
  <button 
    onclick="document.getElementById('selector-overlay').classList.add('hidden')"
    class="absolute top-8 right-8 text-white/40 hover:text-white text-3xl"
  >✕</button>

  <div class="max-w-xl w-full">
    <!-- Paso 1 -->
    <div id="step-1" class="space-y-8 text-center">
      <h2 class="text-3xl font-bold text-white">¿Qué te trae al laboratorio?</h2>
      <div class="grid gap-4">
        <button onclick="showStep(2, 'Empresa')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">🏢 Empresa / Equipo Operativo</button>
        <button onclick="showStep(2, 'Startup')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">🚀 Startup / Founder</button>
        <button onclick="showStep(2, 'Profesional')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">👤 Profesional Independiente</button>
      </div>
    </div>

    <!-- Paso 2 (Oculto inicialmente) -->
    <div id="step-2" class="hidden space-y-8 text-center">
      <h2 class="text-3xl font-bold text-white">¿Dónde está el cuello de botella?</h2>
      <div class="grid gap-4">
        <button onclick="showStep(3, 'caos')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">El caos operativo me quita el foco</button>
        <button onclick="showStep(3, 'ejecución')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">Mi ejecución es lenta y dispersa</button>
      </div>
    </div>

    <!-- Paso 3 (Oculto inicialmente) -->
    <div id="step-3" class="hidden space-y-8 text-center text-white">
      <h2 class="text-3xl font-bold text-teal">¡Diagnóstico listo!</h2>
      <p class="text-xl">Tu perfil es: <span id="res-perfil" class="font-bold"></span></p>
      <div class="bg-white/5 p-8 rounded-2xl border border-white/10">
        <button onclick="window.location.href='https://calendar.app.google/k4iYmA42X9NNBb5t8'" class="w-full bg-orange text-white py-4 rounded-lg font-bold hover:bg-orange/90 transition">AGENDAR CAFÉ ESTRATÉGICO</button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  let userData = {};
  function showStep(step, value) {
    if (step === 2) userData.perfil = value;
    if (step === 3) {
      userData.dolor = value;
      document.getElementById('res-perfil').innerText = userData.perfil;
    }
    document.getElementById('step-1').classList.add('hidden');
    document.getElementById('step-2').classList.add('hidden');
    document.getElementById('step-3').classList.add('hidden');
    document.getElementById('step-' + step).classList.remove('hidden');
  }
</script>