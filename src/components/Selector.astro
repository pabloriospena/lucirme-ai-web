---
// Selector.astro
---
<div id="selector-overlay" class="fixed inset-0 bg-[#0F172A] z-[100] hidden flex items-center justify-center p-6 backdrop-blur-sm">
  <button onclick="document.getElementById('selector-overlay').classList.add('hidden')" class="absolute top-8 right-8 text-white/40 hover:text-white text-3xl">✕</button>

  <div class="max-w-xl w-full">
    <!-- Contenedor dinámico -->
    <div id="selector-container" class="space-y-8 text-center animate-fade-in">
       <h2 id="titulo" class="text-3xl font-bold text-white mb-8">¿Qué te trae al laboratorio?</h2>
       <div id="opciones-container" class="grid gap-4">
          <button onclick="seleccionarPerfil('empresa')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">🏢 Empresa</button>
          <button onclick="seleccionarPerfil('startup')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">🚀 Startup</button>
          <button onclick="seleccionarPerfil('pro')" class="p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5">👤 Profesional</button>
       </div>
    </div>
  </div>
</div>

<script is:inline>
  let estado = { perfil: null, paso: 1, respuestas: {} };

  const estructura = {
    empresa: [
      { q: "¿Dónde sientes que tu equipo pierde más tiempo/esfuerzo?", opts: ["Aprobaciones manuales y cuellos de botella", "Datos dispersos o versiones desactualizadas", "Procesos operativos con errores recurrentes", "Falta de protocolos entre áreas"] },
      { q: "¿Qué te gustaría lograr en los próximos 15 días?", opts: ["Recuperar 5+ horas semanales de tiempo operativo", "Integrar IA en un flujo de trabajo actual", "Reducir errores manuales y repetitivos", "Que mi equipo llegue al siguiente nivel usando herramientas de IA"] },
      { q: "¿Cómo prefieres avanzar?", opts: ["Quiero hacerlo yo mismo con una guía clara", "Prefiero acompañamiento estratégico para afinar el plan", "Necesito implementación directa para mi equipo o varios equipos"] }
    ],
    startup: [
      { q: "¿Dónde se frena tu producto o proceso?", opts: ["Backlog infinito sin criterios de priorización", "Reuniones de alineación sin acuerdos claros", "Integrar IA sin sobrecargar al equipo técnico", "Medir impacto real de features o campañas"] },
      { q: "¿Qué te gustaría lograr en los próximos 15 días?", opts: ["Recuperar 5+ horas semanales de tiempo", "Integrar IA en mi día a día sin detener el trabajo actual", "Que mi equipo tenga un performance TOP usando herramientas de IA", "Claridad para priorizar y cortar lo que no impacta"] },
      { q: "¿Cómo prefieres avanzar?", opts: ["Quiero hacerlo yo mismo con una guía clara", "Prefiero acompañamiento estratégico para afinar el plan", "Necesito implementación directa para mi equipo o varios equipos"] }

    ],
    pro: [
      { q: "¿Qué te quita más tiempo?", opts: ["Reportes, hojas de cálculo y coordinación manual", "Documentación y comunicación repetitiva", "Búsqueda o síntesis de información dispersa"] },
      { q: "¿Qué te gustaría lograr en los próximos 15 días?", opts: ["Recuperar 5+ horas semanales de tiempo", "Integrar IA en mi día a día sin detener el trabajo actual", "Llegar al siguiente nivel profesional siendo PRO en IA", "Crear algo propio sin que me consuma demasiado tiempo apoyado en herramientas de IA"] },
      { q: "¿Cómo prefieres avanzar?", opts: ["Quiero hacerlo yo mismo con una guía clara", "Prefiero acompañamiento estratégico para afinar el plan", "Necesito implementación directa para solucionar varios problemas específicos"] }

    ]
  };

  function seleccionarPerfil(p) {
    estado.perfil = p;
    estado.paso = 1; // Primer paso de las preguntas específicas
    renderizarPaso();
  }

  function renderizarPaso() {
    const contenedor = document.getElementById('opciones-container');
    const titulo = document.getElementById('titulo');
    const preguntas = estructura[estado.perfil];
    
    if (estado.paso > preguntas.length) {
      finalizar();
      return;
    }

    const pasoActual = preguntas[estado.paso - 1];
    titulo.innerText = pasoActual.q;
    contenedor.innerHTML = '';
    
    pasoActual.opts.forEach(op => {
      const btn = document.createElement('button');
      btn.innerText = op;
      btn.className = "w-full p-6 border border-white/10 rounded-xl text-white hover:bg-teal transition-all text-left bg-white/5";
      btn.onclick = () => {
        estado.paso++;
        renderizarPaso();
      };
      contenedor.appendChild(btn);
    });
  }

function finalizar() {
  const params = new URLSearchParams({
    perfil: estado.perfil,
    dolor: estado.dolor
  });
  window.location.href = `/resultado?${params.toString()}`;
}
</script>