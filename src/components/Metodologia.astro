---
const steps = [
  { num: "01", title: "Entiendo tu negocio", desc: "Investigo a fondo la realidad operativa y comercial de tu empresa.", details: ["Cliente ideal", "Motivaciones de compra", "Objeciones", "Propuesta de valor", "Servicios y diferenciales"], footer: "El objetivo: entender qué debe comunicar la página." },
  { num: "02", title: "Reviso cómo estás compitiendo", desc: "Analizo el entorno de mercado y el lenguaje de otros oferentes.", details: ["Competidores", "Reputación online", "Presencia digital", "Qué están comunicando otros negocios"], callout: "¿Qué están diciendo todos y qué oportunidad están dejando libre?" },
  { num: "03", title: "Encuentro la oportunidad", desc: "Separo datos de suposiciones para hallar tu ángulo comercial único.", details: ["Qué deberíamos destacar", "Qué evitar copiar", "Qué hacer diferente", "Posicionamiento sugerido", "Hallazgos sobre el cliente"], mono: "HECHOS → PATRONES → INFERENCIAS", footer: "Aquí separo hechos, patrones e inferencias para no diseñar basándome en suposiciones." },
  { num: "04", title: "Convierto eso en una página", desc: "Arquitectura de información, redacción y diseño visual armónico.", details: ["Arquitectura y secciones", "Jerarquía de información", "Copy y tono de voz", "CTAs y flujo hacia WhatsApp"], pills: ["Colores", "Tipografía", "espaciado", "componentes", "imágenes", "iconografía"], footer: "El diseño nace de la investigación, no de plantillas al azar." },
  { num: "05", title: "La construyo y la dejo funcionando", desc: "Desarrollo técnico, dominio, pruebas y entrega llave en mano.", details: ["Página completamente desarrollada", "Responsive para celular, tablet y computador", "WhatsApp integrado", "Formularios cuando hagan sentido", "Navegación y enlaces funcionando", "Dominio conectado y publicación", "Revisión final y ajustes"] }
];
---
<section class="w-full bg-white py-16" id="metodologia">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-bold mb-8">Metodología</h2>
    <div class="space-y-4">
      {steps.map((step, i) => (
        <details class="group bg-slate-50 p-6 rounded-xl border border-slate-200">
          <summary class="font-bold text-lg cursor-pointer">
            {step.num}. {step.title}
          </summary>
          <div class="mt-4 text-slate-600">
            <p>{step.desc}</p>
            <ul class="list-disc ml-5 mt-2">
              {step.details.map(d => <li>{d}</li>)}
            </ul>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
