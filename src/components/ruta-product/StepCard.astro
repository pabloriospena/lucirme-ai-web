---
import type { PasoRuta } from "../../data/ruta-product";

interface Props {
  paso: PasoRuta;
}

const { paso } = Astro.props;
const isAvailable = paso.estado === "disponible";
const isEnConstruccion = paso.estado === "en-construccion";
const canEnter = isAvailable || isEnConstruccion;

const modalId = `modal-paso-${paso.numero}`;
const formId = `form-paso-${paso.numero}`;
const feedbackId = `feedback-paso-${paso.numero}`;
const btnId = `btn-paso-${paso.numero}`;
---

<div class={`rounded-3xl border p-6 sm:p-8 space-y-4 transition-all duration-200 ${canEnter ? 'bg-white border-slate-200/90 shadow-sm hover:shadow-md' : 'bg-white/80 border-slate-200/60 opacity-90'}`}>
  <div class="flex items-center justify-between gap-2">
    <span class="font-mono text-xs font-bold text-slate-500 uppercase tracking-wider">
      Paso {paso.numero} / 04
    </span>
    {isAvailable ? (
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span> Disponible
      </span>
    ) : isEnConstruccion ? (
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span> En construcción
      </span>
    ) : (
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200/80">
        Próximamente
      </span>
    )}
  </div>

  <div class="space-y-1.5">
    <h3 class="text-2xl font-bold text-slate-900 tracking-tight">
      {paso.titulo}
    </h3>
    <p class="text-xs font-mono text-teal-800 uppercase tracking-wide font-semibold">
      {paso.subtituloCategoria}
    </p>
  </div>

  <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
    {paso.descripcion}
  </p>

  <div class="pt-3 flex items-center justify-end">
    {canEnter ? (
      <a
        href={`/ruta-product/paso-${Number(paso.numero)}`}
        onclick={`if (window.posthog) { window.posthog.capture('ruta_product_step_click', { paso: '${Number(paso.numero)}', estado: '${paso.estado}' }); }`}
        class="inline-flex items-center justify-center gap-2 font-semibold bg-[#00685F] hover:bg-[#005049] text-white rounded-xl py-3 px-6 transition text-xs sm:text-sm shadow-sm hover:shadow active:scale-[0.99]"
      >
        <span>Entrar</span>
        <span class="text-base leading-none">→</span>
      </a>
    ) : (
      <button
        type="button"
        onclick={`document.getElementById('${modalId}').classList.remove('hidden')`}
        class="inline-flex items-center justify-center rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-medium px-5 py-2.5 text-xs sm:text-sm transition shadow-sm cursor-pointer"
      >
        🔔 Avísame cuando esté
      </button>
    )}
  </div>
</div>

{!canEnter && (
  <div id={modalId} class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl relative animate-in fade-in duration-150">
      <button 
        type="button"
        onclick={`document.getElementById('${modalId}').classList.add('hidden')`}
        class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-1 rounded-lg hover:bg-slate-100 cursor-pointer"
      >
        ✕
      </button>

      <div class="mb-4 space-y-1">
        <span class="font-mono text-[11px] text-teal-700 uppercase tracking-wider font-semibold">Notificación de Lanzamiento</span>
        <h4 class="text-lg font-bold text-slate-900">{paso.titulo}</h4>
        <p class="text-xs text-slate-600">
          Ingresa tu correo para avisarte y enviarte el blueprint tan pronto se publique este módulo.
        </p>
      </div>

      <form id={formId} onsubmit={`handleAvisoSubmit(event, '${Number(paso.numero)}', '${feedbackId}', '${btnId}', '${modalId}')`} class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-slate-700 mb-1">
            Correo electrónico
          </label>
          <input 
            type="email" 
            name="email"
            required
            placeholder="tu.correo@empresa.com"
            class="w-full px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-xs focus:outline-none focus:bg-white focus:border-teal-600 transition"
          />
        </div>
        <button 
          id={btnId}
          type="submit"
          class="w-full inline-flex items-center justify-center font-semibold bg-[#00685F] hover:bg-[#005049] text-white rounded-xl py-2.5 text-xs transition shadow-sm cursor-pointer"
        >
          Confirmar notificación
        </button>
        <p class="text-[11px] text-slate-500 text-center leading-normal">
          Al suscribirte aceptas recibir correos de LuciRMe AI. Consulta nuestra <a href="/privacidad" target="_blank" class="text-teal-700 underline hover:text-teal-800">Política de privacidad</a>.
        </p>
        <p id={feedbackId} class="hidden text-center text-xs font-semibold pt-1"></p>
      </form>
    </div>
  </div>
)}

<script is:inline>
  window.handleAvisoSubmit = async function(e, pasoNum, feedbackId, btnId, modalId) {
    e.preventDefault();
    const form = e.target;
    const emailInput = form.querySelector('input[name="email"]');
    const feedback = document.getElementById(feedbackId);
    const btn = document.getElementById(btnId);

    if (!emailInput || !emailInput.value) return;

    if (feedback) {
      feedback.classList.add("hidden");
      feedback.textContent = "";
    }

    if (btn) {
      btn.disabled = true;
      btn.textContent = "Procesando...";
    }

    try {
      const res = await fetch('/api/aviso-paso', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: emailInput.value.trim(),
          paso: String(pasoNum)
        })
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok && data.ok) {
        if (feedback) {
          feedback.textContent = "Listo. Te avisamos cuando esté lista esta etapa.";
          feedback.className = "text-center text-xs text-emerald-600 font-semibold pt-1";
          feedback.classList.remove("hidden");
        }
        if (window.posthog) {
          window.posthog.capture('aviso_paso_registrado', { paso: String(pasoNum) });
        }
        setTimeout(() => {
          document.getElementById(modalId).classList.add("hidden");
          form.reset();
          if (feedback) feedback.classList.add("hidden");
          if (btn) {
            btn.disabled = false;
            btn.textContent = "Confirmar notificación";
          }
        }, 2000);
      } else {
        const errorMsg = data.error || "No pudimos registrar tu correo. Intenta de nuevo.";
        if (feedback) {
          feedback.textContent = errorMsg;
          feedback.className = "text-center text-xs text-red-600 font-semibold pt-1";
          feedback.classList.remove("hidden");
        }
        if (btn) {
          btn.disabled = false;
          btn.textContent = "Confirmar notificación";
        }
      }
    } catch (err) {
      console.error('[aviso-paso]', err);
      if (feedback) {
        feedback.textContent = "No pudimos registrar tu correo. Intenta de nuevo.";
        feedback.className = "text-center text-xs text-red-600 font-semibold pt-1";
        feedback.classList.remove("hidden");
      }
      if (btn) {
        btn.disabled = false;
        btn.textContent = "Confirmar notificación";
      }
    }
  };
</script>
