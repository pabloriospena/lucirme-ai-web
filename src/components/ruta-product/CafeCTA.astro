---
interface Props {
  ubicacion?: "hub" | "paso-0" | "paso-0-1" | "paso-1" | "paso-2" | string;
}

const { ubicacion = "hub" } = Astro.props;
const whatsappCafeUrl = "https://wa.me/573053046180?text=" + encodeURIComponent("Hola Pablo, quiero agendar mi Café de Estrategia de 30 minutos sobre la Ruta de Product Management.");
---

<div class="bg-white rounded-3xl border border-slate-200/90 p-8 sm:p-12 shadow-sm text-center space-y-5 my-14 relative overflow-hidden">
  <div class="absolute bottom-0 right-0 w-48 h-48 bg-emerald-50 rounded-full blur-3xl -z-10 translate-x-10 translate-y-10"></div>
  
  <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-widest block bg-slate-50 py-1 px-3 rounded-full w-fit mx-auto border border-slate-200/60">
    Acompañamiento directo 1 a 1
  </span>
  <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
    ¿No sabes por dónde empezar?
  </h3>
  <p class="text-sm sm:text-base text-slate-600 max-w-xl mx-auto leading-relaxed">
    Cuéntame qué proceso te frena en tu ciclo de producto y te digo exactamente en qué paso de la ruta debes enfocarte.
  </p>
  <div class="pt-3">
    <a
      href={whatsappCafeUrl}
      target="_blank"
      rel="noopener noreferrer"
      onclick={`if (window.posthog) { window.posthog.capture('ruta_product_cafe_click', { ubicacion: '${ubicacion}' }); }`}
      class="inline-flex items-center justify-center gap-2.5 bg-[#059669] hover:bg-[#047857] text-white font-semibold py-3.5 px-7 rounded-xl transition text-sm shadow-md hover:shadow-lg active:scale-[0.99]"
    >
      <span class="material-symbols-outlined text-[18px]">chat</span>
      <span>Agendar Café de Estrategia (30 min, gratis)</span>
    </a>
  </div>
  <p class="text-xs text-slate-500 font-mono pt-2 flex items-center justify-center gap-1.5">
    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
    Conversación técnica 1 a 1 directa con Pablo Ríos vía Google Meet / WhatsApp.
  </p>
</div>
