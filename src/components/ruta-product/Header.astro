<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/ruta-product" class="flex items-center gap-2 group">
        <!-- logo aquí -->
        <span class="font-bold text-slate-900 tracking-tight text-base">LuciRMe AI</span>
      </a>
      <span class="hidden md:inline-block text-xs font-mono text-slate-400">/</span>
      <span class="hidden md:inline-block text-xs font-semibold px-2.5 py-1 rounded-full bg-teal-50 text-teal-800 border border-teal-200/60">
        Product Management
      </span>
    </div>

    <div>
      <a
        href="https://lucirme.com/whatsapp"
        target="_blank"
        rel="noopener noreferrer"
        onclick="try { window.posthog?.capture('header_whatsapp_click', { origen: 'ruta_header' }); } catch (_) {}"
        class="inline-flex items-center justify-center font-medium bg-[#00685F] hover:bg-[#005049] text-white rounded-xl py-2 px-4 transition text-xs sm:text-sm shadow-sm"
      >
        Hablar con Pablo
      </a>
    </div>
  </div>
</header>
