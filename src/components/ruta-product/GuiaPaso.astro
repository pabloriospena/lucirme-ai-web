---
import ComunidadCTA from "./ComunidadCTA.astro";
import CafeCTA from "./CafeCTA.astro";
import type { GuiaRuta } from "../../data/ruta-guias";

interface Props {
  guia: GuiaRuta;
  accesoValido: boolean;
}
const { guia, accesoValido } = Astro.props;
const id = guia.slug;
const pasoHref = `/ruta-product/paso-${guia.paso}`;
---

<div class="space-y-10" data-guia={id} data-paso={guia.paso}>
  <div class="space-y-2">
    <a href={pasoHref} class="inline-flex items-center gap-1.5 text-xs font-semibold text-teal-800 hover:text-teal-900 transition-colors">
      ← Volver al Paso {guia.paso}
    </a>
    <div class="font-mono text-xs text-slate-500">Ruta Product Management / Paso {guia.paso} / Guía</div>
  </div>

  <div class="space-y-3">
    <span class="inline-block text-xs font-mono font-bold text-teal-800 bg-teal-50 px-2.5 py-1 rounded-md border border-teal-200 uppercase">
      {guia.pasoLabel}
    </span>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">{guia.titulo}</h1>
    <p class="text-base text-slate-600 leading-relaxed max-w-2xl">{guia.intro}</p>
  </div>

  {!accesoValido && (
    <section id={`muro-${id}`} class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200 shadow-md max-w-2xl mx-auto my-6 space-y-6">
      <div class="space-y-2">
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight">Desbloquea la guía</h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Ingresa tu correo para ver el método, los tres prompts y la lista de verificación.
        </p>
      </div>
      <form id={`wall-form-${id}`} class="space-y-4 pt-2">
        <div>
          <label for={`wall-email-${id}`} class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-mono">
            Tu Correo Electrónico *
          </label>
          <input
            type="email"
            id={`wall-email-${id}`}
            name="email"
            placeholder="Ej. tu@empresa.com"
            required
            autocomplete="email"
            class="w-full text-sm p-3.5 border border-slate-300 rounded-xl bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent transition"
          />
        </div>
        <div id={`wall-error-${id}`} class="hidden p-3 bg-red-50 border border-red-200 text-red-600 text-xs rounded-lg font-medium"></div>
        <button
          type="submit"
          id={`wall-submit-${id}`}
          class="w-full bg-[#00685F] hover:bg-[#005049] text-white font-bold text-base py-3.5 px-6 rounded-xl transition shadow-md cursor-pointer flex items-center justify-center gap-2"
        >
          <span>Ver la guía</span> →
        </button>
      </form>
      <p class="text-xs text-slate-400 text-center">
        Acceso inmediato. Consulta nuestra <a href="/privacidad" target="_blank" class="underline hover:text-slate-600">Política de privacidad</a>.
      </p>
    </section>
  )}

  <div id={`contenido-${id}`} class={accesoValido ? "space-y-8 max-w-3xl" : "hidden space-y-8 max-w-3xl"}>
    <div class="bg-teal-50/60 rounded-2xl border border-teal-200 p-6 space-y-2">
      <h2 class="text-sm font-bold text-teal-900 uppercase tracking-wide font-mono">La regla de esta guía</h2>
      <p class="text-sm sm:text-base text-slate-800 leading-relaxed">{guia.regla}</p>
    </div>

    {guia.bloques.map((b) => (
      <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-3 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900 tracking-tight">{b.titulo}</h2>
        <p class="text-sm text-slate-600 leading-relaxed">{b.texto}</p>
        {b.puntos && (
          <ul class="space-y-2 text-sm text-slate-700">
            {b.puntos.map((p) => (
              <li class="flex items-start gap-2">
                <span class="text-teal-700 font-bold mt-0.5">•</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}

    <div class="space-y-4">
      <h2 class="text-lg font-bold text-slate-900 tracking-tight">Los tres prompts</h2>
      {guia.prompts.map((p) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-3 shadow-sm">
          <h3 class="text-sm font-bold text-slate-900">{p.titulo}</h3>
          <p class="text-xs text-slate-500">{p.cuandoUsarlo}</p>
          <pre id={`${p.id}-texto`} class="whitespace-pre-wrap text-xs sm:text-sm text-slate-800 bg-slate-50 border border-slate-200 rounded-xl p-4 leading-relaxed font-mono">{p.texto}</pre>
          <button
            type="button"
            data-copiar={p.id}
            class="inline-flex items-center justify-center font-medium bg-white border border-slate-200 hover:bg-slate-100 text-slate-800 rounded-xl py-2 px-4 transition text-xs shadow-sm cursor-pointer"
          >
            Copiar prompt
          </button>
        </div>
      ))}
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-3 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900 tracking-tight">{guia.checklistTitulo}</h2>
      <ul class="space-y-2 text-sm text-slate-700">
        {guia.checklist.map((c) => (
          <li class="flex items-start gap-2.5">
            <span class="mt-1 w-3.5 h-3.5 rounded border border-slate-300 shrink-0"></span>
            <span>{c}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="text-xs text-slate-500 leading-relaxed">{guia.avisoSinEjemplo}</p>

    <a href={guia.siguiente.href} class="inline-flex items-center gap-2 font-semibold text-sm text-teal-800 hover:text-teal-900 transition-colors">
      {guia.siguiente.texto} →
    </a>
  </div>

  <ComunidadCTA ubicacion={`paso-${guia.paso}-guia`} />
  <CafeCTA ubicacion={`paso-${guia.paso}-guia`} />
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-guia]');
    if (!root) return;
    var id = root.getAttribute('data-guia');
    var paso = root.getAttribute('data-paso');

    if (window.posthog) {
      window.posthog.capture('contenido_paso_' + paso + '_visto', { contenido: id });
    }

    var form = document.getElementById('wall-form-' + id);
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var btn = document.getElementById('wall-submit-' + id);
        var errorEl = document.getElementById('wall-error-' + id);
        var emailVal = (document.getElementById('wall-email-' + id).value || '').trim();
        if (errorEl) errorEl.classList.add('hidden');
        if (btn) { btn.disabled = true; btn.innerHTML = '<span>Procesando...</span>'; }
        try {
          var res = await fetch('/api/unlock-recurso', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailVal })
          });
          var data = await res.json().catch(function () { return {}; });
          if (!res.ok || !data.ok) {
            if (errorEl) { errorEl.textContent = data.error || 'No se pudo registrar el correo. Por favor intenta de nuevo.'; errorEl.classList.remove('hidden'); }
            if (btn) { btn.disabled = false; btn.innerHTML = '<span>Ver la guía</span> →'; }
            return;
          }
          if (window.posthog) {
            window.posthog.capture('resource_unlocked', { recurso: id, paso: paso });
          }
          var muro = document.getElementById('muro-' + id);
          var contenido = document.getElementById('contenido-' + id);
          if (muro) muro.classList.add('hidden');
          if (contenido) contenido.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (err) {
          if (errorEl) { errorEl.textContent = 'Error de conexión. Intenta de nuevo.'; errorEl.classList.remove('hidden'); }
          if (btn) { btn.disabled = false; btn.innerHTML = '<span>Ver la guía</span> →'; }
        }
      });
    }

    document.querySelectorAll('[data-copiar]').forEach(function (b) {
      b.addEventListener('click', function () {
        var pid = b.getAttribute('data-copiar');
        var el = document.getElementById(pid + '-texto');
        if (!el || !navigator.clipboard) return;
        navigator.clipboard.writeText(el.textContent || '').then(function () {
          b.textContent = 'Copiado';
          if (window.posthog) {
            window.posthog.capture('prompt_copiado', { recurso: id, prompt: pid, paso: paso });
          }
          setTimeout(function () { b.textContent = 'Copiar prompt'; }, 2000);
        });
      });
    });
  })();
</script>
