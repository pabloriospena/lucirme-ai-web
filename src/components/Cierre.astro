---
// src/components/Cierre.astro
import { LINKS } from '../lib/constants.js';

---

<section id="cta" class="py-24 px-4 bg-deep text-white">
  <div class="max-w-2xl mx-auto text-center">
    
    <h2 class="text-3xl md:text-4xl font-bold mb-6">Tu fricción tiene nombre. Tu solución también.</h2>
    <p class="text-lg text-gray-400 mb-12">
      No adivines. No postergues. En 30 minutos, mapeamos tu mayor fuga de tiempo y definimos tu siguiente paso concreto.
    </p>

    <!-- Lista de beneficios (Estilo checkmark) -->
    <div class="grid gap-4 text-left max-w-sm mx-auto mb-12">
      <div class="flex items-center gap-3 text-sm font-medium">
        <span class="text-teal text-xl font-bold">✓</span> Diagnóstico claro de tu operatividad actual
      </div>
      <div class="flex items-center gap-3 text-sm font-medium">
        <span class="text-teal text-xl font-bold">✓</span> 1 acción concreta para aplicar esta semana
      </div>
      <div class="flex items-center gap-3 text-sm font-medium">
        <span class="text-teal text-xl font-bold">✓</span> Claridad sobre si tiene sentido seguir trabajando juntos
      </div>
      <div class="flex items-center gap-3 text-sm font-medium">
        <span class="text-teal text-xl font-bold">✓</span> Si no encaja, te llevas la claridad igual. Sin presión.
      </div>
    </div>

    <!-- CTA Principal -->
    <a 
      href={LINKS.whatsapp} 
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 w-full sm:w-auto bg-emerald-600 hover:bg-emerald-500 text-white px-10 py-4 rounded-xl font-bold text-lg transition shadow-xl mb-8"
    >
      💬 Hablar por WhatsApp (+57 305 3046180) →
    </a>

    <!-- CTA Secundario -->
    <p class="text-sm text-gray-500 mb-4">
      ¿Prefieres explorar primero? 
      <button 
        onclick="document.getElementById('selector-overlay').classList.remove('hidden')" 
        class="text-teal font-bold hover:underline"
      >
        Enciende tu Foco en 60s
      </button>
    </p>

    <p class="text-xs text-gray-600 uppercase tracking-widest mt-8">Sin registro. Sin spam. Solo claridad.</p>
  </div>
</section>