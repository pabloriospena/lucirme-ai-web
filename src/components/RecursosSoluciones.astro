---
// src/components/RecursosSoluciones.astro
const recursos = [
  {
    titulo: "📘 Guía NotebookLM",
    desc: "Transforma notas sueltas, audios o PDFs en reportes ejecutivos listos en minutos. Ideal para asimilar información masiva.",
    cta: "Usar Guía Gratis →",
    url: "/recursos/guia-notebooklm",
    tipo: "guia"
  },
  {
    titulo: "🧹 Backlog Detox",
    desc: "Filtra el ruido operativo de tus tableros. Un framework práctico de priorización para mantener el foco en las métricas.",
    cta: "Descargar Plantilla →",
    url: "/recursos/backlog-detox",
    tipo: "plantilla"
  },
  {
    titulo: "🎯 Pitch Builder",
    desc: "Responde un set de preguntas y obtén el prompt maestro para construir documentaciones de producto completas en minutos.",
    cta: "Abrir Constructor →",
    url: "/recursos/shapeup-builder",
    tipo: "herramienta"
  }
];
---

<section id="recursos" class="py-24 px-4 bg-[#0F172A] text-white">
  <div class="max-w-6xl mx-auto">
    <div class="mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Librería de Recursos</h2>
      <p class="text-gray-400 text-lg">Herramientas probadas para eliminar el ruido y enfocar tu ejecución.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mb-16">
      {recursos.map((rec) => (
        <div class="bg-[#1E293B] p-8 rounded-2xl border border-white/5 hover:border-teal/50 transition-all flex flex-col group">
          <h3 class="text-xl font-bold mb-4">{rec.titulo}</h3>
          <p class="text-sm text-gray-400 mb-8 flex-grow leading-relaxed">{rec.desc}</p>
          <a href={rec.url} class="inline-flex items-center justify-center bg-white/5 hover:bg-teal text-white py-3 rounded-lg font-bold text-sm transition-all border border-white/10">
            {rec.cta}
          </a>
        </div>
      ))}
    </div>

    <!-- EBOOK DESTACADO -->
    <div class="bg-gradient-to-r from-[#0D9488] to-teal-700 p-8 md:p-12 rounded-3xl flex flex-col md:flex-row items-center gap-8 shadow-2xl">
      <div class="flex-grow">
        <h3 class="text-2xl font-bold mb-3">📖 Ebook: PM Sin Bullshit</h3>
        <p class="text-white/80 text-sm mb-6 max-w-xl">
          El manual definitivo para profesionales y líderes que quieren aplicar IA con criterio real, eliminar la infoxicación operativa y recuperar 10 horas semanales.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="https://pay.hotmart.com/D96093022S?off=OFF50" class="bg-white text-teal font-bold px-8 py-3 rounded-lg hover:bg-gray-100 transition shadow-lg">
            Comprar Libro Completo
          </a>
          <a href="/recursos/ebook-pm" class="text-white font-medium hover:underline flex items-center">
            Leer Capítulo 1 Gratis →
          </a>
        </div>
      </div>
      <div class="w-full md:w-48 h-64 bg-white rounded-r-xl rounded-l-sm shadow-xl relative transform md:rotate-3 flex-shrink-0">
        <div class="absolute inset-0 bg-gray-100/50"></div>
      </div>
    </div>
  </div>
</section>