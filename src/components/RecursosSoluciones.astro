---
// src/components/RecursosSoluciones.astro
const items = [
  {
    titulo: "📘 Guía NotebookLM",
    empieza: "De Notas Sueltas a Reportes Listos",
    afina: "Adaptada a tus documentos y flujos reales con la guía.",
    escala: "Tendrás automatizado un proceso en minutos."
  },
  {
    titulo: "🧹 Backlog Detox",
    empieza: "Plantilla de filtrado y criterio de priorización.",
    afina: "Calibrado a las métricas que importan.",
    escala: "Tu y tu equipo con el Foco donde debe de estar."
  },
  {
    titulo: "🎯 Pitch Builder",
    empieza: "Responde paso a paso lo que quieres definir",
    afina: "Obtienes el prompt con el que construirás tu documentación",
    escala: "Ya tardarás menos de 10 minutos creando una documentación completa"
  },
    {
    titulo: "📖 Ebook: PM Sin Bullshit",
    empieza: "Aprende de la experiencia del autor",
    afina: "Tus funcionalidades a lo que realmente importa",
    escala: "Aplica el conocimiento adquirido sin Bullshit"
  }
];
---

<section class="py-10 px-4 bg-[#F8FAFC]">
  <div class="container mx-auto max-w-5xl">
    
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-deep mb-4">Recursos y Soluciones. Un solo camino.</h2>
      <p class="text-lg text-gray-600">Herramientas para empezar. Tu Foco para personalizar. Estrategia para escalar.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {items.map((item) => (
        <div class="bg-white p-8 rounded-2xl border border-gray-200 flex flex-col hover:shadow-lg transition-shadow">
          <h3 class="text-xl font-bold text-deep mb-8 border-b border-gray-100 pb-4">{item.titulo}</h3>
          
          <div class="space-y-6 flex-grow">
            <div>
              <span class="text-[10px] font-bold text-teal uppercase tracking-widest block mb-1">Empieza</span>
              <p class="text-sm text-gray-600">{item.empieza}</p>
            </div>
            <div>
              <span class="text-[10px] font-bold text-orange uppercase tracking-widest block mb-1">Afina con tu Foco</span>
              <p class="text-sm text-gray-600">{item.afina}</p>
            </div>
            <div class="pt-4 border-t border-gray-50">
              <span class="text-[10px] font-bold text-deep uppercase tracking-widest block mb-1">Escala</span>
              <p class="text-sm font-semibold text-deep">{item.escala}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 text-center">
      <button 
        onclick="document.getElementById('selector-overlay').classList.remove('hidden')"
        class="bg-orange text-white px-10 py-4 rounded-lg font-bold hover:bg-orange/90 transition shadow-lg text-lg"
      >
        Enciende tu Foco y escala
      </button>
      <p class="text-xs text-gray-400 mt-4 uppercase tracking-widest font-medium">
        Perfil → Dolor → Acción.
      </p>
    </div>

  </div>
</section>