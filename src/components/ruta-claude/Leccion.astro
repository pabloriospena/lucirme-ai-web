---
import { RUTA_CLAUDE_DATA, etiquetaPaso } from "../../data/ruta-claude";

interface Props {
  /** Número del paso con dos dígitos, igual que en los datos. */
  paso: string;
  eyebrow: string;
  titulo: string;
}

const { paso, eyebrow, titulo } = Astro.props;
---

<div class="pb-16 space-y-8">
  <nav aria-label="Ruta de navegación" class="text-sm text-slate-600 px-2">
    <a href="/ruta-claude" class="text-teal-700 font-semibold underline underline-offset-2 hover:text-teal-800">← Volver a Ruta Claude desde cero</a>
  </nav>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_15rem] items-start">
    <article class="space-y-12 min-w-0">
      <header class="space-y-5 bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
        <span class="text-xs font-mono font-bold text-slate-600 uppercase tracking-widest">{eyebrow}</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">{titulo}</h1>
        <div class="space-y-4 text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">
          <slot name="intro" />
        </div>
      </header>

      <slot />
    </article>

    <aside aria-label="Pasos de la ruta" class="lg:sticky lg:top-24 bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm">
      <p class="text-xs font-mono font-bold text-slate-600 uppercase tracking-widest mb-3">Los pasos</p>
      <ol class="space-y-1">
        {RUTA_CLAUDE_DATA.map((p) => {
          const aqui = p.numero === paso;
          return (
            <li>
              <a
                href={p.href}
                aria-current={aqui ? "step" : undefined}
                onclick={`if (window.posthog) { window.posthog.capture('ruta_claude_step_click', { paso: '${Number(p.numero)}', origen: 'lista-lateral-paso-${Number(paso)}' }); }`}
                class={`flex items-start justify-between gap-2 rounded-xl px-3 py-2 text-sm leading-snug focus-visible:ring-2 focus-visible:ring-teal-600 ${aqui ? "bg-teal-50 text-teal-800 font-semibold border border-teal-200" : "text-slate-700 hover:bg-slate-50"}`}
              >
                <span>Paso {Number(p.numero)}</span>
                <span class={`text-xs font-semibold ${aqui ? "text-teal-800" : "text-slate-600"}`}>{aqui ? "Aquí" : etiquetaPaso(p)}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </aside>
  </div>
</div>
