---
import EmailCTA from "./EmailCTA.astro";
import Compartir from "./Compartir.astro";
import { LANDING_KIT_URL, KIT_ABIERTO } from "../../data/ruta-claude";

interface Props {
  numero: string;
  titulo: string;
  resumen: string;
  recibes: string[];
  limites: string[];
  anterior: { href: string; texto: string };
  siguiente?: { href: string; texto: string };
}

const { numero, titulo, resumen, recibes, limites, anterior, siguiente } = Astro.props;
---

<div class="space-y-12 pb-16">
  <nav class="text-sm font-mono text-slate-500 px-2">
    <a href="/ruta-claude" class="hover:text-teal-700 underline-offset-2 hover:underline">Ruta Claude desde cero</a>
    <span aria-hidden="true" class="mx-2 inline-block h-1 w-1 rounded-full bg-slate-300 align-middle"></span>
    <span class="text-slate-700">Paso {Number(numero)}</span>
  </nav>

  <section class="space-y-5 bg-white rounded-3xl border border-slate-200/80 p-8 shadow-sm">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-sm font-mono font-bold text-slate-600 uppercase tracking-widest">Paso {Number(numero)}</span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold border bg-slate-900 text-white border-slate-900">En el kit</span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold border bg-slate-100 text-slate-700 border-slate-300">{KIT_ABIERTO ? "Preventa" : "Próximamente"}</span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold border bg-white text-slate-700 border-slate-300">Vista previa</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">{titulo}</h1>
    <p class="text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">{resumen}</p>
    <p class="text-sm text-slate-500 leading-relaxed max-w-2xl">
      Esto es una vista previa de lo que hace este paso. El kit se está terminando de armar y de probar. Los datos del ejemplo son inventados.
    </p>
  </section>

  <section class="space-y-3 bg-teal-50 rounded-2xl border border-teal-200 p-6">
    <h2 class="text-base font-bold text-slate-900">Este paso es parte del Kit Claude desde cero</h2>
    <p class="text-sm text-slate-700 leading-relaxed">
      El kit son los Pasos 2, 3 y 4 de la ruta. Trae prompts listos para Claude, una plantilla de proyecto para tus documentos, una lista de comprobación y una guía para convertir tus tareas repetidas en rutina. Con él pasás de preguntarle cosas a Claude a trabajar con él sobre tus propios documentos, con respuestas que podés comprobar.
    </p>
    <p class="text-sm text-slate-700 leading-relaxed">
      {KIT_ABIERTO
        ? "La compra se hace desde la página del kit."
        : "Todavía no se puede comprar. Mientras tanto podés ver todo lo que incluye y dejar tu correo para que te avise cuando abra el Kit."}
    </p>
    {LANDING_KIT_URL && (
      <a href={LANDING_KIT_URL} class="inline-flex text-sm font-semibold text-teal-800 underline hover:text-teal-900">Ver qué incluye el kit y qué ganas</a>
    )}
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-bold text-slate-900 tracking-tight px-2">Qué recibís en este paso</h2>
    <ul class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm space-y-3 text-sm sm:text-base text-slate-700 leading-relaxed">
      {recibes.map((r) => (
        <li class="flex gap-3"><span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-700"></span><span>{r}</span></li>
      ))}
    </ul>
  </section>

  <slot />

  <section class="space-y-4">
    <h2 class="text-xl font-bold text-slate-900 tracking-tight px-2">Lo que este paso no hace</h2>
    <ul class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm space-y-3 text-sm sm:text-base text-slate-600 leading-relaxed">
      {limites.map((l) => (
        <li class="flex gap-3"><span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-300"></span><span>{l}</span></li>
      ))}
    </ul>
  </section>

  {LANDING_KIT_URL && (
    <div class="px-2">
      <a
        href={LANDING_KIT_URL}
        onclick={`if (window.posthog) { window.posthog.capture('ruta_claude_landing_click', { ubicacion: 'preview_paso_${Number(numero)}' }); }`}
        class="inline-flex items-center justify-center gap-2 font-semibold bg-white border border-slate-300 hover:border-teal-600 text-slate-800 rounded-xl py-3.5 px-6 transition text-sm"
      >
        <span>Ver el kit completo</span>
        <span class="text-base leading-none">→</span>
      </a>
    </div>
  )}

  <div class="flex flex-wrap items-center justify-between gap-3 px-2 text-sm">
    <a href={anterior.href} class="text-teal-700 underline hover:text-teal-800">← {anterior.texto}</a>
    {siguiente && <a href={siguiente.href} class="text-teal-700 underline hover:text-teal-800">{siguiente.texto} →</a>}
  </div>

  <EmailCTA
    ubicacion={`paso-${Number(numero)}`}
    titulo="Te aviso cuando abra el Kit"
    texto="Dejá tu correo y te aviso cuando abra el Kit, con qué incluye cada paso, qué se entrega y cuándo."
    boton="Avisarme cuando abra el Kit"
    avisame
  />

  <Compartir ubicacion={`paso-${Number(numero)}`} />
</div>
