---
// Pie compacto de la web nueva. Una fila en escritorio y apilado en móvil, con enlaces de 44 px de alto táctil.
// Solo enlaces a páginas que existen.
const year = new Date().getFullYear();
const enlaces = [
  { href: "/privacidad", texto: "Privacidad" },
  { href: "/terminos", texto: "Términos" },
];
---

<footer class="mt-8 w-full border-t-[0.8px] border-v2-borde bg-v2-fondo px-4 py-4 sm:px-6">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-2 text-sm text-v2-cuerpo md:flex-row md:items-center md:justify-between md:gap-4">
    <p>
      <b class="font-bold text-[#115E59]">LuciRMe AI</b>, {year}. Aplica la IA a tu trabajo real y recupera tu autonomía.
    </p>
    <nav aria-label="Pie de página" class="flex flex-wrap gap-1">
      {
        enlaces.map((e) => (
          <a href={e.href} class="inline-flex min-h-11 items-center px-2 hover:text-v2-texto">{e.texto}</a>
        ))
      }
    </nav>
  </div>
</footer>
