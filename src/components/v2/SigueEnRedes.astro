---
// Sígueme en redes, en fila. Escritorio: título y cuatro botones con ícono y nombre. Móvil: cuatro íconos de 52 px
// en partes iguales, con aria-label. Sin botón de color. Es una autodeclaración y no desbloquea nada.
// Los íconos son trazos de 24 px dibujados para el lienzo, no los logos oficiales.
import { LINKS } from "../../lib/constants.js";
interface Props {
  redes?: string[];
  // Con tarjeta (por defecto) se dibuja dentro de su caja. Sin tarjeta, para meterlo en otra sección.
  tarjeta?: boolean;
  // Dónde está en la página, para medir de dónde vienen los clics.
  posicion?: string;
}
const { redes = ["Instagram", "TikTok", "Facebook", "LinkedIn"], tarjeta = true, posicion = "pagina" } = Astro.props;
const urls: Record<string, string> = {
  Instagram: LINKS.instagram, TikTok: LINKS.tiktok, Facebook: LINKS.facebook, LinkedIn: LINKS.linkedin,
};
const iconos: Record<string, string> = {
  Instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>',
  TikTok: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"></path><path d="M14 3c.4 2.6 2.1 4.2 5 4.5"></path>',
  Facebook: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"></path>',
  LinkedIn: '<rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 10v7M8 7v.01M12 17v-7M12 13a3 3 0 0 1 6 0v4"></path>',
};
---

<section
  aria-labelledby="sigueme-redes"
  class:list={[
    "flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-4",
    tarjeta && "rounded-3xl border-[0.8px] border-v2-borde bg-v2-fondo p-4 sm:px-6",
  ]}
>
  <h2 id="sigueme-redes" class="text-lg font-bold text-v2-texto sm:text-xl">Sígueme en redes</h2>
  <ul class="grid list-none grid-cols-4 gap-2 p-0 sm:flex sm:flex-wrap">
    {
      redes.map((r) => (
        <li>
          <a
            href={urls[r]}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={r}
            class="flex min-h-[52px] items-center justify-center gap-2 rounded-full border-[0.8px] border-v2-control bg-v2-fondo text-sm font-semibold text-v2-accion transition-colors duration-150 hover:bg-v2-marca-tinte sm:inline-flex sm:min-h-12 sm:px-4"
            onclick={`if (window.posthog) { window.posthog.capture('red_social_click', { red: '${r.toLowerCase()}', posicion: '${posicion}' }); }`}
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconos[r]} />
            <span class="hidden sm:inline">{r}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
