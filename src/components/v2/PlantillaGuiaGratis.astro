---
// Plantilla de guía gratis con muro de correo (lienzo, tablero Guía gratis, muro de correo).
// Estados: reposo, error de campo, error del servidor, enviando, éxito y guía desbloqueada.
// El correo se guarda con /api/unlock-recurso (grupo de recursos gratis) y el acceso se recuerda con su cookie y con el navegador.
// Una sola acción en pantalla. La casilla de privacidad lleva el texto de ejemplo hasta tener la validación legal de Habeas Data.
import { verificar, COOKIE_NAME } from "../../lib/acceso-ruta";
import ContenidoRelacionado from "./ContenidoRelacionado.astro";

interface Props {
  slug: string;
  titulo: string;
  descripcion: string;
  tema?: string;
  aprendes: string[];
  pdf?: string;
  relacionados?: { titulo: string; tipo: string; url: string }[];
}
const { slug, titulo, descripcion, tema, aprendes, pdf, relacionados = [] } = Astro.props;
let desbloqueada = false;
try {
  desbloqueada = verificar(Astro.cookies.get(COOKIE_NAME)?.value);
} catch {
  desbloqueada = false;
}
const etiqueta = "inline-flex items-center rounded-full border-[0.8px] px-3 py-1 text-xs font-bold";
const campo = "min-h-[52px] rounded-[14px] border-[0.8px] border-v2-control bg-v2-fondo px-4 text-base text-v2-texto aria-[invalid=true]:border-[#c70036] disabled:opacity-60";
---

<div class="mx-auto flex w-full max-w-[1200px] flex-col gap-6 px-4 pb-8 pt-2 sm:px-6" data-guia-gratis={slug} data-desbloqueada={desbloqueada ? "1" : "0"}>
  <section class="flex flex-wrap items-start gap-6 pt-2">
    <div class="flex min-w-0 grow shrink basis-[520px] flex-col gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class={`${etiqueta} border-v2-marca-borde bg-v2-marca-tinte text-v2-accion`}>Guía</span>
        <span class={`${etiqueta} border-v2-marca-borde bg-v2-marca-tinte text-v2-accion`}>Gratis</span>
        {tema && <span class={`${etiqueta} border-[#cad5e2] bg-v2-fondo text-v2-cuerpo`}>{tema}</span>}
        <span data-marca-desbloqueo class="hidden items-center gap-1.5 rounded-full border-[0.8px] border-v2-marca-borde bg-v2-marca-tinte px-3 py-1 text-xs font-bold text-v2-accion">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 7.5-2" /></svg>
          Guía desbloqueada
        </span>
      </div>
      <h1 class="text-[32px] font-extrabold leading-[1.14] tracking-[-0.8px] text-v2-texto sm:text-[40px] sm:tracking-[-1px]">{titulo}</h1>
      <p class="text-base leading-6 text-v2-cuerpo sm:text-lg sm:leading-7">{descripcion}</p>

      <div data-bloque-bloqueado class="flex flex-col gap-4">
        <ul class="flex flex-col gap-2.5">
          {
            aprendes.map((a) => (
              <li class="flex items-start gap-2.5 text-base leading-6 text-v2-texto">
                <span class="flex-none text-v2-accion" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg>
                </span>
                {a}
              </li>
            ))
          }
        </ul>
        <div class="flex flex-col gap-2.5 overflow-hidden rounded-2xl border-[0.8px] border-dashed border-v2-control bg-v2-superficie p-5" aria-hidden="true">
          <div class="flex items-center gap-2.5 text-sm font-bold text-v2-cuerpo">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
            Contenido de la guía
          </div>
          <span class="block h-3 w-[92%] rounded-md bg-[#cad5e2]"></span>
          <span class="block h-3 w-[78%] rounded-md bg-[#cad5e2]"></span>
          <span class="block h-3 w-[86%] rounded-md bg-[#cad5e2]"></span>
          <span class="block h-3 w-[60%] rounded-md bg-[#cad5e2]"></span>
        </div>
      </div>

      <div data-bloque-desbloqueado class="hidden flex-wrap items-center gap-3 text-sm text-v2-cuerpo">
        <span>También la enviamos a tu correo.</span>
        {pdf && <a href={pdf} download class="inline-flex min-h-11 items-center rounded-full border-[0.8px] border-v2-control px-4 text-sm font-bold text-v2-accion">Descargar en PDF</a>}
      </div>
    </div>

    <div data-muro class="min-w-0 grow shrink basis-[340px] lg:max-w-[420px]">
      <form data-form novalidate aria-label="Recibe la guía gratis" class="flex flex-col gap-4 rounded-3xl border-[0.8px] border-v2-marca-borde bg-v2-fondo p-6">
        <div class="flex flex-col gap-1">
          <h2 class="text-xl font-bold text-v2-texto">Recibe la guía gratis</h2>
          <p class="text-sm leading-5 text-v2-cuerpo">Déjanos tu correo y la abres al instante.</p>
        </div>
        <p data-error-servidor role="alert" class="hidden text-sm font-semibold text-[#c70036]">No pudimos enviar tu correo. Intenta de nuevo en un momento.</p>
        <label class="flex flex-col gap-1.5 text-sm font-semibold text-v2-texto" for={`correo-${slug}`}>
          Correo
          <input data-correo id={`correo-${slug}`} name="email" type="email" required autocomplete="email" placeholder="tu@correo.com" aria-describedby={`error-correo-${slug}`} class={campo} />
          <span data-error-correo id={`error-correo-${slug}`} class="hidden text-sm font-normal text-[#c70036]">Escribe un correo válido.</span>
        </label>
        <div class="flex flex-col gap-1.5">
          <label class="flex min-h-11 cursor-pointer items-start gap-3 text-sm leading-5 text-v2-cuerpo">
            <input data-acepto type="checkbox" required aria-describedby={`error-acepto-${slug}`} class="mt-0.5 h-6 w-6 flex-none cursor-pointer rounded-lg accent-[#00786f] aria-[invalid=true]:outline aria-[invalid=true]:outline-2 aria-[invalid=true]:outline-[#c70036]" />
            <span>Acepto la <a href="/privacidad" class="underline">política de privacidad</a> y que me escriban con la guía y con novedades.</span>
          </label>
          <span data-error-acepto id={`error-acepto-${slug}`} class="hidden text-sm font-semibold text-[#c70036]">Para continuar, acepta la política de privacidad.</span>
        </div>
        <button data-enviar type="submit" class="inline-flex min-h-[52px] cursor-pointer items-center justify-center gap-2 rounded-full bg-v2-accion px-7 text-base font-bold text-v2-accion-texto hover:bg-v2-accion-hover disabled:cursor-not-allowed disabled:opacity-70">
          <svg data-spinner class="hidden h-5 w-5 motion-safe:animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9" /></svg>
          <span data-etiqueta-enviar>Recibir la guía gratis</span>
        </button>
      </form>
      <div data-exito role="status" class="hidden flex-col gap-4 rounded-3xl border-[0.8px] border-v2-marca-borde bg-v2-marca-tinte p-6">
        <div class="flex flex-col gap-1">
          <p class="text-xl font-bold text-v2-texto">¡Listo, ya puedes abrir la guía!</p>
          <p class="text-sm leading-5 text-v2-cuerpo">También te la enviamos al correo, por si la quieres después.</p>
        </div>
        <button data-abrir type="button" class="inline-flex min-h-[52px] cursor-pointer items-center justify-center rounded-full bg-v2-accion px-7 text-base font-bold text-v2-accion-texto hover:bg-v2-accion-hover">Abrir la guía</button>
      </div>
    </div>
  </section>

  <div data-cuerpo class="hidden flex-col gap-8">
    <article class="flex max-w-[720px] flex-col gap-4 text-base leading-7 text-v2-texto">
      <slot />
    </article>
    {relacionados.length > 0 && <div class="max-w-[720px]"><ContenidoRelacionado items={relacionados} /></div>}
  </div>
</div>

<script is:inline>
  (function () {
    var raiz = document.querySelector("[data-guia-gratis]");
    if (!raiz) return;
    var slug = raiz.getAttribute("data-guia-gratis");
    var clave = "guia-desbloqueada:" + slug;
    var $ = function (s) { return raiz.querySelector(s); };
    var muro = $("[data-muro]"), form = $("[data-form]"), exito = $("[data-exito]");
    var cuerpo = $("[data-cuerpo]"), bloqueado = $("[data-bloque-bloqueado]"), desbloq = $("[data-bloque-desbloqueado]"), marca = $("[data-marca-desbloqueo]");
    var correo = $("[data-correo]"), acepto = $("[data-acepto]"), enviar = $("[data-enviar]");
    var etiqueta = $("[data-etiqueta-enviar]"), spinner = $("[data-spinner]");
    var eCorreo = $("[data-error-correo]"), eAcepto = $("[data-error-acepto]"), eServidor = $("[data-error-servidor]");
    var TEXTO = "Recibir la guía gratis";

    function mostrar(el, si) { el.classList.toggle("hidden", !si); }
    function abrir(enfocar) {
      mostrar(muro, false); mostrar(bloqueado, false);
      cuerpo.classList.remove("hidden"); cuerpo.classList.add("flex");
      desbloq.classList.remove("hidden"); desbloq.classList.add("flex");
      marca.classList.remove("hidden"); marca.classList.add("inline-flex");
      if (enfocar) { var h = raiz.querySelector("h1"); h.setAttribute("tabindex", "-1"); h.focus(); }
    }
    function recordado() { try { return localStorage.getItem(clave) === "1"; } catch (e) { return false; } }
    function recordar() { try { localStorage.setItem(clave, "1"); } catch (e) {}
    }
    if (raiz.getAttribute("data-desbloqueada") === "1" || recordado()) abrir(false);

    function limpiar() {
      mostrar(eCorreo, false); mostrar(eAcepto, false); mostrar(eServidor, false);
      correo.removeAttribute("aria-invalid"); acepto.removeAttribute("aria-invalid");
    }
    function cargando(si) {
      form.setAttribute("aria-busy", si ? "true" : "false");
      correo.disabled = si; acepto.disabled = si; enviar.disabled = si;
      mostrar(spinner, si);
      etiqueta.textContent = si ? "Enviando" : TEXTO;
    }
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      limpiar();
      var v = (correo.value || "").trim();
      var okCorreo = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
      var okAcepto = acepto.checked;
      if (!okCorreo) { mostrar(eCorreo, true); correo.setAttribute("aria-invalid", "true"); }
      if (!okAcepto) { mostrar(eAcepto, true); acepto.setAttribute("aria-invalid", "true"); }
      if (!okCorreo || !okAcepto) { (okCorreo ? acepto : correo).focus(); return; }
      cargando(true);
      fetch("/api/unlock-recurso", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: v }) })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) {
          cargando(false);
          if (!res.ok) { mostrar(eServidor, true); etiqueta.textContent = "Intentar de nuevo"; eServidor.focus && eServidor.setAttribute("tabindex", "-1"); return; }
          recordar();
          if (window.posthog) window.posthog.capture("resource_unlocked", { recurso: slug, origen: "guia_gratis_v2" });
          mostrar(form, false); exito.classList.remove("hidden"); exito.classList.add("flex");
          $("[data-abrir]").focus();
        })
        .catch(function () { cargando(false); mostrar(eServidor, true); etiqueta.textContent = "Intentar de nuevo"; });
    });
    $("[data-abrir]").addEventListener("click", function () { abrir(true); });
  })();
</script>
