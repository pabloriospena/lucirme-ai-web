---
// Cabecera de la web nueva (Web LuciRMe v2), Dirección A. Tres enlaces y Empieza gratis, sin desplegables.
const items = [
  { href: "/recursos", texto: "Contenido", clave: "contenido" },
  { href: "/empresas", texto: "Empresas", clave: "empresas" },
  { href: "/sobre-pablo", texto: "Sobre Pablo", clave: "sobre-pablo" },
];
const empezarHref = "/empezar";
const path = Astro.url.pathname;
const activo = (href: string) => path === href || path.startsWith(href + "/");
const boton =
  "inline-flex min-h-11 items-center justify-center rounded-xl bg-v2-accion px-4 text-sm font-bold text-v2-accion-texto transition-colors duration-150 hover:bg-v2-accion-hover";
---

<header class="sticky top-0 z-40 border-b-[0.8px] border-v2-borde bg-white/95 px-4 backdrop-blur-xl sm:px-6">
  <div class="mx-auto flex min-h-[65px] max-w-7xl items-center justify-between gap-4">
    <a href="/" class="flex min-h-11 shrink-0 items-center" aria-label="LuciRMe AI, inicio">
      <img src="/logo-lucirme-ai.svg" alt="LuciRMe AI" class="h-9 w-auto" />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      {
        items.map((i) => (
          <a
            href={i.href}
            class:list={[
              "inline-flex min-h-11 items-center text-sm font-medium transition-colors duration-150",
              activo(i.href) ? "text-v2-texto" : "text-v2-cuerpo hover:text-v2-texto",
            ]}
            aria-current={activo(i.href) ? "page" : undefined}
            onclick={`if (window.posthog) { window.posthog.capture('nav_click', { destino: '${i.clave}', posicion: 'cabecera' }); }`}
          >
            {i.texto}
          </a>
        ))
      }
      <a
        href={empezarHref}
        class={boton}
        onclick="if (window.posthog) { window.posthog.capture('nav_click', { destino: 'empieza-gratis', posicion: 'cabecera' }); }"
      >
        Empieza gratis
      </a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <a
        href={empezarHref}
        class={boton}
        onclick="if (window.posthog) { window.posthog.capture('nav_click', { destino: 'empieza-gratis', posicion: 'cabecera-movil' }); }"
      >
        Empieza gratis
      </a>
      <details class="group">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-xl border-[0.8px] border-v2-control text-v2-texto [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menú"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="absolute inset-x-4 top-[70px] rounded-xl border-[0.8px] border-v2-control bg-v2-fondo px-4 pb-4 pt-2 shadow-none">
          {
            items.map((i) => (
              <a href={i.href} class="flex min-h-[52px] items-center border-b-[0.8px] border-v2-borde text-lg font-bold text-v2-texto">
                {i.texto}
              </a>
            ))
          }
          <a href={empezarHref} class="mt-3 flex min-h-[52px] items-center justify-center rounded-xl bg-v2-accion text-base font-bold text-v2-accion-texto hover:bg-v2-accion-hover">
            Empieza gratis
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
