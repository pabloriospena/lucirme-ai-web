---
// Cabecera de la web nueva (Web LuciRMe v2), look claro. Referencia: lienzo de diseño, pantallas Main y Componentes.
// Escritorio: menú en píldora con Contenido (despliega las cinco bandas), Empresas, Sobre Pablo y Empieza gratis.
// Móvil: botón de 44 px que abre la lista, con Empieza gratis al final.
const bandas = [
  { href: "/recursos#banda-paso-a-paso", texto: "Paso a paso", clave: "paso-a-paso" },
  { href: "/recursos#banda-guias-herramientas", texto: "Guías y herramientas", clave: "guias-herramientas" },
  { href: "/clases", texto: "Clases en vivo", clave: "clases" },
  { href: "/biblioteca", texto: "Biblioteca", clave: "biblioteca" },
  { href: "/recursos/prompts", texto: "Prompts", clave: "prompts" },
];
const otros = [
  { href: "/empresas", texto: "Empresas", clave: "empresas" },
  { href: "/sobre-pablo", texto: "Sobre Pablo", clave: "sobre-pablo" },
];
const empezarHref = "/empezar";
const path = Astro.url.pathname;
const enRuta = (href: string) => path === href || path.startsWith(href + "/");
const contenidoActivo = ["/recursos", "/clases", "/biblioteca", "/empezar"].some(enRuta);
const evento = (destino: string, posicion: string) =>
  `if (window.posthog) { window.posthog.capture('nav_click', { destino: '${destino}', posicion: '${posicion}' }); }`;
const enlace =
  "inline-flex min-h-11 items-center gap-1 rounded-full px-3 text-sm transition-colors duration-150";
---

<header class="bg-v2-superficie px-4 sm:px-6" data-cabecera-v2>
  <div class="mx-auto flex min-h-[72px] max-w-[1200px] items-center justify-between gap-4">
    <a href="/" class="flex min-h-11 shrink-0 items-center" aria-label="LuciRMe AI, inicio">
      <span class="v2-logo-pildora"><img src="/logo-lucirme-ai.svg" alt="LuciRMe AI" class="h-9 w-auto" /></span>
    </a>

    <div class="flex items-center gap-2">
    <!-- Escritorio -->
    <nav
      class="relative hidden items-center gap-1 rounded-full border-[0.8px] border-v2-borde bg-v2-fondo py-1 pl-3 pr-1 md:flex"
      aria-label="Principal"
    >
      <button
        type="button"
        class:list={[enlace, "cursor-pointer", contenidoActivo ? "font-semibold text-v2-accion" : "font-medium text-v2-cuerpo hover:text-v2-texto"]}
        aria-expanded="false"
        aria-controls="menu-contenido"
        data-menu-boton
      >
        Contenido
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </button>
      {
        otros.map((i) => (
          <a
            href={i.href}
            class:list={[enlace, enRuta(i.href) ? "font-semibold text-v2-accion" : "font-medium text-v2-cuerpo hover:text-v2-texto"]}
            aria-current={enRuta(i.href) ? "page" : undefined}
            onclick={evento(i.clave, "cabecera")}
          >
            {i.texto}
          </a>
        ))
      }
      <a
        href={empezarHref}
        class="inline-flex min-h-11 items-center rounded-full bg-v2-accion px-5 text-sm font-bold text-v2-accion-texto transition-colors duration-150 hover:bg-v2-accion-hover"
        onclick={evento("empieza-gratis", "cabecera")}
      >
        Empieza gratis
      </a>

      <div
        id="menu-contenido"
        hidden
        class="absolute left-0 top-[calc(100%+8px)] z-40 w-72 rounded-[20px] border-[0.8px] border-v2-borde bg-v2-fondo p-2"
        data-menu-panel
      >
        <ul>
          {
            bandas.map((b) => (
              <li>
                <a
                  href={b.href}
                  class="flex min-h-11 items-center rounded-[14px] px-4 text-sm font-semibold text-v2-cuerpo hover:bg-v2-chip hover:text-v2-texto"
                  onclick={evento(`contenido-${b.clave}`, "cabecera-menu")}
                >
                  {b.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
    <button
      type="button"
      class="hidden md:flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full border-[0.8px] border-v2-control bg-v2-fondo text-v2-texto"
      aria-label="Modo oscuro"
      aria-pressed="false"
      data-tema-boton
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>

    
    <button
      type="button"
      class="flex md:hidden h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full border-[0.8px] border-v2-control bg-v2-fondo text-v2-texto"
      aria-label="Modo oscuro"
      aria-pressed="false"
      data-tema-boton
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
    <!-- Móvil -->
    <button
      type="button"
      class="flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full border-[0.8px] border-v2-control bg-v2-fondo text-v2-texto md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-movil"
      data-menu-movil-boton
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icono-abrir>
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden" data-icono-cerrar>
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    </div>
  </div>

  <nav id="menu-movil" hidden class="mx-auto max-w-[1200px] pb-4 md:hidden" aria-label="Principal, móvil" data-menu-movil>
    <div class="rounded-2xl border-[0.8px] border-v2-borde bg-v2-fondo px-4 pb-4 pt-2">
      <p class="flex min-h-11 items-center text-base font-semibold text-v2-texto">Contenido</p>
      <ul>
        {
          bandas.map((b) => (
            <li>
              <a
                href={b.href}
                class="flex min-h-11 items-center pl-4 text-sm text-v2-cuerpo hover:text-v2-texto"
                onclick={evento(`contenido-${b.clave}`, "cabecera-movil")}
              >
                {b.texto}
              </a>
            </li>
          ))
        }
      </ul>
      {
        otros.map((i) => (
          <a
            href={i.href}
            class="flex min-h-11 items-center text-base font-semibold text-v2-texto"
            aria-current={enRuta(i.href) ? "page" : undefined}
            onclick={evento(i.clave, "cabecera-movil")}
          >
            {i.texto}
          </a>
        ))
      }
      <a
        href={empezarHref}
        class="mt-2 flex min-h-[52px] items-center justify-center rounded-full bg-v2-accion text-base font-bold text-v2-accion-texto hover:bg-v2-accion-hover"
        onclick={evento("empieza-gratis", "cabecera-movil")}
      >
        Empieza gratis
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var cab = document.querySelector("[data-cabecera-v2]");
    if (!cab) return;
    // Modo oscuro: solo con esta opción, guardado en el navegador. Sin prefers-color-scheme.
    var raiz = document.documentElement;
    var temaBotones = cab.querySelectorAll("[data-tema-boton]");
    function pintarTema(oscuro) {
      temaBotones.forEach(function (b) { b.setAttribute("aria-pressed", oscuro ? "true" : "false"); });
    }
    pintarTema(raiz.getAttribute("data-tema") === "oscuro");
    temaBotones.forEach(function (b) {
      b.addEventListener("click", function () {
        var oscuro = raiz.getAttribute("data-tema") !== "oscuro";
        var sinAnimar = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!sinAnimar) {
          raiz.classList.add("tema-anima");
          setTimeout(function () { raiz.classList.remove("tema-anima"); }, 250);
        }
        if (oscuro) raiz.setAttribute("data-tema", "oscuro"); else raiz.removeAttribute("data-tema");
        try { localStorage.setItem("lucirme-tema", oscuro ? "oscuro" : "claro"); } catch (e) {}
        pintarTema(oscuro);
        if (window.posthog) window.posthog.capture("tema_cambiado", { tema: oscuro ? "oscuro" : "claro" });
      });
    });
    var boton = cab.querySelector("[data-menu-boton]");
    var panel = cab.querySelector("[data-menu-panel]");
    var botonMovil = cab.querySelector("[data-menu-movil-boton]");
    var panelMovil = cab.querySelector("[data-menu-movil]");

    function alternar(b, p, abrir) {
      b.setAttribute("aria-expanded", abrir ? "true" : "false");
      p.hidden = !abrir;
    }
    function cerrarTodo() {
      alternar(boton, panel, false);
      alternar(botonMovil, panelMovil, false);
      botonMovil.setAttribute("aria-label", "Abrir menú");
      botonMovil.querySelector("[data-icono-abrir]").classList.remove("hidden");
      botonMovil.querySelector("[data-icono-cerrar]").classList.add("hidden");
    }

    boton.addEventListener("click", function () {
      alternar(boton, panel, panel.hidden);
    });
    botonMovil.addEventListener("click", function () {
      var abrir = panelMovil.hidden;
      alternar(botonMovil, panelMovil, abrir);
      botonMovil.setAttribute("aria-label", abrir ? "Cerrar menú" : "Abrir menú");
      botonMovil.querySelector("[data-icono-abrir]").classList.toggle("hidden", abrir);
      botonMovil.querySelector("[data-icono-cerrar]").classList.toggle("hidden", !abrir);
    });
    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      var estabaAbierto = !panel.hidden;
      var estabaAbiertoMovil = !panelMovil.hidden;
      cerrarTodo();
      if (estabaAbierto) boton.focus();
      if (estabaAbiertoMovil) botonMovil.focus();
    });
    document.addEventListener("click", function (e) {
      if (!panel.hidden && !panel.contains(e.target) && !boton.contains(e.target)) alternar(boton, panel, false);
    });
    panel.addEventListener("focusout", function (e) {
      if (e.relatedTarget && !panel.contains(e.relatedTarget) && e.relatedTarget !== boton) alternar(boton, panel, false);
    });
  })();
</script>
