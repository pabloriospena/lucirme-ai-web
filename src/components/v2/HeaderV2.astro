---
// Cabecera de la web nueva (Web LuciRMe v2). Usa solo componentes y tokens del Design System vigente.
// El menú, el botón y el desplegable se afinan cuando Pablo elija la dirección del look and feel.
const items = [
  { href: "/recursos", texto: "Contenido", clave: "contenido" },
  { href: "/empresas", texto: "Empresas", clave: "empresas" },
  { href: "/sobre-pablo", texto: "Sobre Pablo", clave: "sobre-pablo" },
];
// Pendiente: /empezar todavía no existe. Mientras tanto el botón lleva al índice de contenido.
const empezarHref = "/recursos";
const path = Astro.url.pathname;
const activo = (href: string) => path === href || path.startsWith(href + "/");
---

<header
  class="sticky top-0 z-40 bg-white/95 backdrop-blur-xl border-b border-slate-200/80 shadow-sm h-[65px] px-4 sm:px-6"
>
  <div class="max-w-7xl mx-auto h-full flex items-center justify-between gap-6">
    <a href="/" class="flex items-center shrink-0" aria-label="LuciRMe AI, inicio">
      <img src="/logo-lucirme-ai.svg" alt="LuciRMe AI" class="h-9 w-auto" />
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Principal">
      {
        items.map((i) => (
          <a
            href={i.href}
            class:list={[
              "text-sm font-medium transition-colors duration-150",
              activo(i.href) ? "text-slate-900" : "text-slate-600 hover:text-slate-900",
            ]}
            aria-current={activo(i.href) ? "page" : undefined}
            onclick={`if (window.posthog) { window.posthog.capture('nav_click', { destino: '${i.clave}', posicion: 'cabecera' }); }`}
          >
            {i.texto}
          </a>
        ))
      }
      <a
        href={empezarHref}
        class="inline-flex items-center rounded-xl bg-[#0F766E] hover:bg-[#115E59] text-white text-sm font-semibold px-4 py-2.5 transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0F766E]"
        onclick="if (window.posthog) { window.posthog.capture('nav_click', { destino: 'empieza-gratis', posicion: 'cabecera' }); }"
      >
        Empieza gratis
      </a>
    </nav>

    <details class="md:hidden relative">
      <summary
        class="list-none cursor-pointer flex items-center justify-center w-10 h-10 rounded-lg border border-slate-200 text-slate-700 [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menú"
      >
        <span class="material-symbols-outlined" aria-hidden="true">menu</span>
      </summary>
      <div
        class="absolute right-0 top-12 w-64 rounded-2xl border border-slate-200 bg-white p-4 shadow-lg flex flex-col gap-1"
      >
        {
          items.map((i) => (
            <a href={i.href} class="px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50">
              {i.texto}
            </a>
          ))
        }
        <a
          href={empezarHref}
          class="mt-2 inline-flex justify-center rounded-xl bg-[#0F766E] text-white text-sm font-semibold px-4 py-2.5"
        >
          Empieza gratis
        </a>
      </div>
    </details>
  </div>
</header>
