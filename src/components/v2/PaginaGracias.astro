---
// Página de gracias de la web nueva. Un solo trabajo: decir qué sigue. Un solo botón: WhatsApp.
interface Lista {
  titulo: string;
  items: string[];
}
interface Props {
  titulo: string;
  resumen: string;
  pasos: { t: string; d: string }[];
  listas?: Lista[];
  pregunta: string;
}
const { titulo, resumen, pasos, listas = [], pregunta } = Astro.props;
---

<main class="mx-auto flex w-full max-w-[720px] flex-col gap-8 px-4 pb-16 pt-10 sm:px-6">
  <header class="flex flex-col items-center gap-3 text-center">
    <span class="flex h-16 w-16 items-center justify-center rounded-full bg-v2-accion text-v2-accion-texto" aria-hidden="true">
      <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
    </span>
    <h1 class="text-[34px] font-extrabold leading-[1.14] tracking-[-0.9px] text-v2-texto sm:text-[40px]">{titulo}</h1>
    <p class="max-w-[560px] text-base leading-6 text-v2-cuerpo sm:text-lg sm:leading-7">{resumen}</p>
  </header>

  <section aria-labelledby="que-sigue" class="flex flex-col gap-5 rounded-3xl border-[0.8px] border-v2-borde bg-v2-fondo p-6 sm:p-8">
    <h2 id="que-sigue" class="text-xl font-bold tracking-[-0.3px] text-v2-texto">¿Qué sigue ahora?</h2>
    <ol class="flex flex-col gap-5">
      {pasos.map((p, i) => (
        <li class="flex items-start gap-4">
          <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full border-[0.8px] border-v2-marca-borde bg-v2-marca-tinte text-sm font-bold text-v2-marca-texto" aria-hidden="true">{i + 1}</span>
          <div class="flex flex-col gap-1">
            <p class="text-base font-bold text-v2-texto">{p.t}</p>
            <p class="text-sm leading-5 text-v2-cuerpo">{p.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  {listas.map((l) => (
    <section class="flex flex-col gap-4 rounded-3xl border-[0.8px] border-v2-marca-borde bg-v2-marca-tinte p-6 sm:p-8">
      <h2 class="text-lg font-bold text-v2-texto">{l.titulo}</h2>
      <ul class="flex flex-col gap-2.5">
        {l.items.map((i) => (
          <li class="flex items-start gap-2.5 text-sm leading-5 text-v2-cuerpo">
            <span class="mt-0.5 flex-none font-bold text-v2-marca-texto" aria-hidden="true">✓</span>
            <span>{i}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <div class="flex flex-col items-center gap-3 text-center">
    <p class="text-sm text-v2-cuerpo">{pregunta}</p>
    <a
      href="https://wa.me/573128199661"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-v2-accion px-7 text-base font-bold text-v2-accion-texto hover:bg-v2-accion-hover"
    >Escríbeme por WhatsApp</a>
  </div>
</main>
