---
// Tarjeta de ruta del índice (lienzo Recursos): número de ruta, título, tres pasos y enlace a la ruta.
// El primer paso va marcado porque es por donde se empieza.
interface Props {
  numero: number;
  slug: string;
  url: string;
  titulo: string;
  pasos: string[];
}
const { numero, slug, url, titulo, pasos } = Astro.props;
---

<div class="flex h-full flex-col gap-3 rounded-[20px] border-[0.8px] border-v2-borde bg-v2-fondo p-5">
  <div>
    <span class="font-mono text-xs font-semibold text-v2-suave">RUTA {String(numero).padStart(2, "0")}</span>
    <h3 class="mt-1 text-lg font-bold leading-6 text-v2-texto">{titulo}</h3>
  </div>
  <ol class="flex flex-col gap-1.5">
    {
      pasos.map((p, i) => (
        <li class:list={["flex items-center gap-2.5 text-sm", i === 0 ? "text-v2-texto" : "text-v2-cuerpo"]}>
          <span
            aria-hidden="true"
            class:list={[
              "flex h-6 w-6 flex-none items-center justify-center rounded-full text-xs font-bold",
              i === 0 ? "bg-v2-accion text-v2-accion-texto" : "border-[0.8px] border-v2-control",
            ]}>{i + 1}</span
          >
          {p}
        </li>
      ))
    }
  </ol>
  <a
    href={url}
    class="mt-auto inline-flex min-h-11 items-center text-sm font-bold text-v2-accion"
    onclick={`if (window.posthog) { window.posthog.capture('recursos_card_click', { recurso: '${slug}', banda: 'paso-a-paso' }); }`}
  >
    Ver la ruta<span class="sr-only">: {titulo}</span><span aria-hidden="true">&nbsp;›</span>
  </a>
</div>
