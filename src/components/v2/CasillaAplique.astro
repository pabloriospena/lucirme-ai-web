---
// Casilla Ya lo apliqué. Es la señal fuerte de aprendizaje. Casilla de 24 px dentro de una fila de 44 px o más.
interface Props { id?: string; marcada?: boolean }
const { id = "ya-lo-aplique", marcada = false } = Astro.props;
---

<label
  for={id}
  class="flex min-h-[56px] cursor-pointer items-start gap-3 rounded-2xl border-[0.8px] border-v2-control bg-v2-superficie p-3.5"
>
  <input id={id} type="checkbox" checked={marcada} class="mt-0.5 h-6 w-6 shrink-0 cursor-pointer accent-[#00786f]" data-aplique />
  <span>
    <span class="block text-base font-bold text-v2-texto">Ya lo apliqué</span>
    <span class="block text-sm leading-5 text-v2-cuerpo">Márcalo cuando lo hayas usado en tu trabajo.</span>
  </span>
</label>
