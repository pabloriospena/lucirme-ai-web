---
// src/components/ActionHub.astro
import { LINKS } from "../lib/constants.js";
---

<section class="py-24 px-4 bg-white text-deep border-t border-gray-100">
  <div class="max-w-4xl mx-auto space-y-12">
    <!-- CABECERA -->
    <div class="text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-deep mb-4">
        ¿Listo para recuperar tu foco?
      </h2>
    </div>
    <!-- PRODUCTO PRINCIPAL DESTACADO -->
    <div class="bg-gradient-to-br from-[#0F172A] via-[#1E293B] to-slate-900 rounded-3xl p-8 md:p-10 text-white shadow-2xl border border-white/10 relative overflow-hidden">
      <div class="absolute -right-12 -top-12 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-2 bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[11px] font-black uppercase tracking-widest px-3 py-1 rounded-full">
            <span>🎓 Producto Estrella · $35 USD</span>
          </div>
          <h3 class="text-2xl md:text-3xl font-black text-white leading-tight">
            De "No tengo idea" a Presentación Completa
          </h3>
          <p class="text-xs md:text-sm text-gray-300 leading-relaxed">
            Convierte documentos, correos, audios, datos y notas desordenadas en una presentación clara, verificable y lista para presentar con IA. Método práctico de 5 pasos 100% asíncrono.
          </p>
          <div class="flex flex-wrap gap-2 text-[11px] text-amber-200/90 font-medium pt-1">
            <span>✓ 5 Pasos estructurados</span>
            <span>•</span>
            <span>✓ Prompts &amp; Protocolos</span>
            <span>•</span>
            <span>✓ Asistente IA Integrado</span>
            <span>•</span>
            <span>✓ Bonus Prototipo Lovable</span>
          </div>
        </div>

        <div class="w-full md:w-auto shrink-0 space-y-2 text-center">
          <a
            href="/curso-presentaciones"
            class="block w-full md:w-auto bg-amber-500 hover:bg-amber-400 text-slate-950 font-black px-8 py-4 rounded-xl text-center transition shadow-lg text-sm sm:text-base cursor-pointer"
          >
            Ver Curso ($35 USD) →
          </a>
          <span class="block text-[11px] text-gray-400">Acceso inmediato · Pago único</span>
        </div>
      </div>
    </div>

    <!-- CTA CAFÉ DE ESTRATEGIA -->
    <div class="text-center py-4 bg-slate-50 border border-gray-200 rounded-2xl p-6">
      <p class="text-xs text-gray-500 uppercase font-bold tracking-widest mb-2">
        ¿Prefieres acompañamiento personalizado 1 a 1?
      </p>
      <a
        href={LINKS.calendly}
        target="_blank"
        class="inline-flex items-center justify-center gap-2 bg-teal text-white font-bold py-3.5 px-8 rounded-xl text-center hover:bg-tealHover transition shadow-md text-sm md:text-base cursor-pointer"
      >
        <span>Agenda tu café de estrategia (30 min) →</span>
      </a>
    </div>

    <!-- RECURSOS -->
    <div>
      <h2 class="text-lg font-bold text-deep mb-6">
        Recursos para avanzar solo
      </h2>
      <div class="grid md:grid-cols-2 gap-4">
        <a
          href="/recursos/backlog-detox"
          class="p-4 border border-gray-200 rounded-lg hover:border-teal transition text-sm font-medium text-gray-700"
        >
          🧹 Backlog Detox
        </a>
        <a
          href="/recursos/guia-notebooklm"
          class="p-4 border border-gray-200 rounded-lg hover:border-teal transition text-sm font-medium text-gray-700"
        >
          📘 Guía NotebookLM
        </a>
        <a
          href="/recursos/shapeup-builder"
          class="p-4 border border-gray-200 rounded-lg hover:border-teal transition text-sm font-medium text-gray-700"
        >
          🎯 ShapeUp Builder
        </a>
        <a
          href="/recursos/prompteador"
          class="p-4 border border-gray-200 rounded-lg hover:border-teal transition text-sm font-medium text-gray-700"
        >
          💡 Prompteador
        </a>
      </div>
    </div>

    <!-- EBOOK -->
    <div
      class="bg-[#0F172A] rounded-2xl p-8 flex flex-col md:flex-row items-center gap-8 shadow-xl text-white"
    >
      <div
        class="w-20 h-28 bg-white rounded-r-lg rounded-l-sm shadow-md flex-shrink-0 flex items-center justify-center border-l-4 border-gray-300"
      >
        <span
          class="text-[8px] font-bold text-deep text-center px-1 leading-tight"
          >PM Sin Bullshit</span
        >
      </div>

      <div class="flex-grow">
        <h3 class="text-lg font-bold mb-1">📘 Ebook "PM Sin Bullshit"</h3>
        <p class="text-xs text-gray-300 mb-4">
          Para PMs que quieren tomar mejores decisiones y tener más criterio.
          Sin bullsh*t.
        </p>
        <div class="flex flex-wrap gap-4 items-center">
          <a
            href="https://pay.hotmart.com/D96093022S?off=OFF50"
            target="_blank"
            class="bg-teal text-white px-6 py-2.5 rounded-lg font-bold text-xs hover:bg-tealHover transition"
          >
            Comprar ahora ($53.000 COP)
          </a>
          <span class="text-xs text-orange font-bold uppercase tracking-widest"
            >50% OFF para clientes</span
          >
        </div>
      </div>
    </div>

    <!-- LÍNEA DE LINKEDIN DE CIERRE (Minimalista y Directa) -->
    <div
      class="pt-8 mt-12 border-t border-gray-100 flex flex-col sm:flex-row justify-between items-center gap-4"
    >
      <p class="text-sm text-gray-500 font-medium">
        ✨ Contenido de PM y automatizaciones de IA en LinkedIn.
      </p>
      <a
        href={LINKS.linkedin}
        target="_blank"
        class="inline-flex items-center gap-2 bg-[#0077B5] text-white px-6 py-2.5 rounded-lg font-bold text-xs hover:bg-[#0077B5]/90 transition shadow-sm whitespace-nowrap"
      >
        <!-- Icono oficial simplificado de LinkedIn en SVG -->
        <svg
          class="w-4 h-4 fill-current"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
        Seguir a Pablo Ríos
      </a>
    </div>
  </div>
</section>
