---
// src/components/Hero.astro
import { LINKS } from '../lib/constants.js';
---
<section class="max-w-6xl mx-auto py-10 text-center flex flex-col items-center">
    <!-- Logo en el Hero (h-12 = 48px de alto, ideal para centrar atención) 
  <div class="mb-8">
    <img src="/logo-lucirme-ai.png" alt="LuciRMe Ai" class="h-6 w-auto object-contain opacity-90" />
  </div>-->
  <!-- H1: Directo, impacto alto -->
  <h1 class="text-5xl md:text-6xl font-bold text-deep leading-tight tracking-tight mb-8">
    Menos operatividad manual.<br />
    <span class="text-teal" >Aplica IA con criterio.</span>
  </h1>

  <!-- Subtítulo: La promesa sin bullshit -->
  <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-10 max-w-2xl mx-auto">
    IA en tus herramientas actuales. Sin curvas de aprendizaje.
  </p>
  
  <div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
    <!-- CTA Primario: Sólido -->
    <a href="#foco-section" class="bg-teal text-white px-8 py-4 rounded-lg font-bold hover:bg-tealHover transition-all shadow-lg">
      Enciende tu Foco
    </a>
    
    <!-- CTA Secundario: Outline WhatsApp -->
    <a  
      href={LINKS.whatsapp} 
      target="_blank"
      rel="noopener noreferrer"
      onclick="
        if (window.posthog) {
          window.posthog.capture('click_whatsapp_hero', { origen: 'dashboard' });
        }
      "class="border-2 border-emerald-600 text-emerald-700 hover:bg-emerald-600 hover:text-white px-8 py-4 rounded-lg font-bold transition-all flex items-center justify-center gap-2">
      💬 Hablar por WhatsApp
    </a>
  </div>

  <!-- Microcopy -->
  <p class="text-sm text-gray-400 font-medium">
    4 preguntas. 60 segundos. Sin registros.
  </p>
</section>