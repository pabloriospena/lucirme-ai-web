---
import type { PasoEvidencia } from "../../data/ruta-evidencia";

interface Props {
  paso: PasoEvidencia;
}

const { paso } = Astro.props;
const esPago = paso.acceso === "pago";
const enConstruccion = paso.estado === "en-construccion";
---

<div class="rounded-3xl border bg-white border-slate-200/90 p-6 sm:p-8 space-y-4 shadow-sm">
  <div class="flex items-center justify-between gap-2">
    <span class="font-mono text-xs font-bold text-slate-500 uppercase tracking-wider">
      Paso {paso.numero} / 04
    </span>
    <div class="flex items-center gap-2">
      <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border ${esPago ? "bg-slate-900 text-white border-slate-900" : "bg-emerald-50 text-emerald-700 border-emerald-200"}`}>
        {esPago ? "En el kit" : "Gratis"}
      </span>
      <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border ${enConstruccion ? "bg-amber-50 text-amber-800 border-amber-200" : "bg-slate-100 text-slate-600 border-slate-200/80"}`}>
        {enConstruccion ? "En construcción" : "Próximamente"}
      </span>
    </div>
  </div>

  <div class="space-y-1.5">
    <h3 class="text-2xl font-bold text-slate-900 tracking-tight">{paso.titulo}</h3>
    <p class="text-xs font-mono text-teal-800 uppercase tracking-wide font-semibold">
      {paso.subtituloCategoria}
    </p>
  </div>

  <p class="text-sm sm:text-base text-slate-600 leading-relaxed">{paso.descripcion}</p>

  {paso.href && (
    <div class="pt-3 flex items-center justify-end">
      <a
        href={paso.href}
        onclick={`if (window.posthog) { window.posthog.capture('ruta_evidencia_step_click', { paso: '${Number(paso.numero)}' }); }`}
        class="inline-flex items-center justify-center gap-2 font-semibold bg-[#00685F] hover:bg-[#005049] text-white rounded-xl py-3 px-6 transition text-xs sm:text-sm shadow-sm"
      >
        <span>Entrar</span>
        <span class="text-base leading-none">→</span>
      </a>
    </div>
  )}
</div>
