---
import EmailCTA from "./EmailCTA.astro";
import Compartir from "./Compartir.astro";
import { LANDING_KIT_URL } from "../../data/ruta-evidencia";

interface Props {
  numero: string;
  titulo: string;
  resumen: string;
  recibes: string[];
  limites: string[];
  anterior: { href: string; texto: string };
  siguiente?: { href: string; texto: string };
}

const { numero, titulo, resumen, recibes, limites, anterior, siguiente } = Astro.props;
---

<div class="space-y-12 pb-16">
  <nav class="text-xs font-mono text-slate-500 px-2">
    <a href="/ruta-evidencia" class="hover:text-teal-700 underline-offset-2 hover:underline">Ruta Evidencia</a>
    <span aria-hidden="true" class="mx-2 inline-block h-1 w-1 rounded-full bg-slate-300 align-middle"></span>
    <span class="text-slate-700">Paso {Number(numero)}</span>
  </nav>

  <section class="space-y-5 bg-white rounded-3xl border border-slate-200/80 p-8 shadow-sm">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-widest">Paso {Number(numero)}</span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border bg-slate-900 text-white border-slate-900">En el kit</span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border bg-slate-100 text-slate-600 border-slate-200/80">Vista previa</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">{titulo}</h1>
    <p class="text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">{resumen}</p>
    <p class="text-xs text-slate-500 leading-relaxed max-w-2xl">
      Esto es una vista previa de lo que hace este paso. El kit se está terminando de armar y de probar. Los datos del ejemplo son inventados.
    </p>
  </section>

  <section class="space-y-3 bg-teal-50 rounded-2xl border border-teal-200 p-6">
    <h2 class="text-base font-bold text-slate-900">Este paso es parte del Kit de Evidencia</h2>
    <p class="text-sm text-slate-700 leading-relaxed">
      El kit es un conjunto de seis prompts para Claude, una estructura para guardar tus fuentes y una base de Notion lista para duplicar. Con él llevas tus entrevistas a una decisión de producto, con cada afirmación atada a una cita.
    </p>
    <p class="text-sm text-slate-700 leading-relaxed">
      Todavía no se puede comprar. Abre en preventa con cupos limitados y la compra se hará en la página del kit. Mientras tanto puedes ver todo lo que incluye y dejar tu correo para que te avise primero.
    </p>
    {LANDING_KIT_URL && (
      <a href={LANDING_KIT_URL} class="inline-flex text-sm font-semibold text-teal-800 underline hover:text-teal-900">Ver qué incluye el kit y qué ganas</a>
    )}
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-bold text-slate-900 tracking-tight px-2">Qué recibes en este paso</h2>
    <ul class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm space-y-3 text-sm sm:text-base text-slate-700 leading-relaxed">
      {recibes.map((r) => (
        <li class="flex gap-3"><span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-700"></span><span>{r}</span></li>
      ))}
    </ul>
  </section>

  <slot />

  <section class="space-y-4">
    <h2 class="text-xl font-bold text-slate-900 tracking-tight px-2">Lo que este paso no hace</h2>
    <ul class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm space-y-3 text-sm sm:text-base text-slate-600 leading-relaxed">
      {limites.map((l) => (
        <li class="flex gap-3"><span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-300"></span><span>{l}</span></li>
      ))}
    </ul>
  </section>

  {LANDING_KIT_URL && (
    <div class="px-2">
      <a
        href={LANDING_KIT_URL}
        onclick={`if (window.posthog) { window.posthog.capture('ruta_evidencia_landing_click', { paso: '${Number(numero)}' }); }`}
        class="inline-flex items-center justify-center gap-2 font-semibold bg-[#00685F] hover:bg-[#005049] text-white rounded-xl py-3.5 px-6 transition text-sm shadow-md"
      >
        <span>Ver el kit completo</span>
        <span class="text-base leading-none">→</span>
      </a>
    </div>
  )}

  <div class="flex flex-wrap items-center justify-between gap-3 px-2 text-sm">
    <a href={anterior.href} class="text-teal-700 underline hover:text-teal-800">← {anterior.texto}</a>
    {siguiente && <a href={siguiente.href} class="text-teal-700 underline hover:text-teal-800">{siguiente.texto} →</a>}
  </div>

  <EmailCTA
    ubicacion={`paso-${Number(numero)}`}
    titulo="Avísame cuando abra el kit"
    texto="Deja tu correo y te aviso cuando abra la preventa, con el precio y la fecha de entrega."
    boton="Avísame"
  />

  <Compartir ubicacion={`paso-${Number(numero)}`} />
</div>
