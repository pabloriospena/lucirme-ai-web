---
interface Props {
  ubicacion?: string;
}

const { ubicacion = "hub" } = Astro.props;
const id = `compartir-${ubicacion}`;
---

<div
  id={id}
  data-ubicacion={ubicacion}
  class="bg-white rounded-3xl border border-slate-200/90 p-8 sm:p-10 shadow-sm space-y-5 my-10"
>
  <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-widest block bg-slate-50 py-1 px-3 rounded-full w-fit border border-slate-200/60">
    Compartir
  </span>
  <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
    Entre más compartas, más beneficios tendrás
  </h3>
  <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl">
    Si conoces a alguien de producto que trabaje con entrevistas, mándale la ruta. Cada persona nueva que deje su correo por tu enlace cuenta, y con eso ganas recursos extra, descuentos y acceso anticipado.
  </p>
  <p class="compartir-aviso text-xs text-slate-500 hidden">
    Para que te contemos a quiénes trajiste, deja tu correo en el formulario de abajo y vuelve a compartir: tu enlace será personal.
  </p>

  <div class="flex flex-wrap gap-3">
    <button type="button" data-canal="whatsapp" class="compartir-btn inline-flex items-center font-semibold bg-[#00685F] hover:bg-[#005049] text-white rounded-xl py-3 px-5 transition text-sm shadow-md cursor-pointer">
      WhatsApp
    </button>
    <button type="button" data-canal="linkedin" class="compartir-btn inline-flex items-center font-semibold bg-white border border-slate-300 hover:border-teal-600 text-slate-800 rounded-xl py-3 px-5 transition text-sm cursor-pointer">
      LinkedIn
    </button>
    <button type="button" data-canal="correo" class="compartir-btn inline-flex items-center font-semibold bg-white border border-slate-300 hover:border-teal-600 text-slate-800 rounded-xl py-3 px-5 transition text-sm cursor-pointer">
      Correo
    </button>
    <button type="button" data-canal="copiar" class="compartir-btn inline-flex items-center font-semibold bg-white border border-slate-300 hover:border-teal-600 text-slate-800 rounded-xl py-3 px-5 transition text-sm cursor-pointer">
      Copiar enlace
    </button>
  </div>
  <p class="compartir-feedback hidden text-xs font-semibold text-emerald-600"></p>
</div>

<script is:inline>
  (function () {
    var BASE = 'https://lucirme.com/ruta-evidencia';
    var TEXTO =
      'Una ruta gratis para llevar tus entrevistas de usuario a una decisión de producto, con cada afirmación atada a una cita:';

    function enlace(canal) {
      var p = new URLSearchParams({
        utm_source: 'compartido',
        utm_medium: canal,
        utm_campaign: 'ruta-evidencia',
      });
      // Cuando exista el código personal de cada inscrito, se guarda aquí y viaja como ref.
      try {
        var ref = window.localStorage.getItem('ruta_evidencia_ref');
        if (ref) p.set('ref', ref);
      } catch (e) {}
      return BASE + '?' + p.toString();
    }

    document.querySelectorAll('[data-ubicacion]').forEach(function (bloque) {
      if (bloque.dataset.listo) return;
      bloque.dataset.listo = '1';
      var feedback = bloque.querySelector('.compartir-feedback');
      var aviso = bloque.querySelector('.compartir-aviso');
      try {
        if (aviso && !window.localStorage.getItem('ruta_evidencia_ref')) aviso.classList.remove('hidden');
      } catch (e) {}

      bloque.querySelectorAll('.compartir-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var canal = btn.dataset.canal;
          var url = enlace(canal);

          if (window.posthog) {
            window.posthog.capture('ruta_evidencia_compartir', {
              canal: canal,
              ubicacion: bloque.dataset.ubicacion,
            });
          }

          if (canal === 'whatsapp') {
            window.open('https://wa.me/?text=' + encodeURIComponent(TEXTO + ' ' + url), '_blank', 'noopener');
          } else if (canal === 'linkedin') {
            window.open(
              'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(url),
              '_blank',
              'noopener'
            );
          } else if (canal === 'correo') {
            window.location.href =
              'mailto:?subject=' +
              encodeURIComponent('Ruta Evidencia, para entrevistas de producto') +
              '&body=' +
              encodeURIComponent(TEXTO + '\n\n' + url);
          } else {
            var listo = function () {
              if (!feedback) return;
              feedback.textContent = 'Enlace copiado.';
              feedback.classList.remove('hidden');
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(url).then(listo).catch(function () {
                window.prompt('Copia este enlace:', url);
              });
            } else {
              window.prompt('Copia este enlace:', url);
            }
          }
        });
      });
    });
  })();
</script>
