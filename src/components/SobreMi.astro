---
// src/components/SobreMi.astro
import { LINKS } from "../lib/constants.js";

interface Props {
  id?: string;
  class?: string;
}

const { id = "sobre-mi", class: className = "" } = Astro.props;
---

<section
  id={id}
  class={`py-16 px-4 sm:px-6 bg-slate-50 border-t border-b border-slate-200/80 relative scroll-mt-16 ${className}`}
>
  <!-- Ancla secundaria para compatibilidad con links a #pablo -->
  {
    id !== "pablo" && (
      <span id="pablo" class="absolute -top-16 opacity-0 pointer-events-none" />
    )
  }

  <div class="max-w-6xl mx-auto space-y-16">
    <!-- ========================================== -->
    <!-- 1. HERO PRINCIPAL (DISEÑO EXACTO DE LA IMAGEN) -->
    <!-- ========================================== -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      <!-- COLUMNA IZQUIERDA: FOTO, IDENTIDAD, PRINCIPIO, REDES Y MÉTODO -->
      <div
        class="lg:col-span-5 flex flex-col gap-3.5 max-w-md mx-auto lg:max-w-none w-full"
      >
        <!-- Tarjeta de Foto con Overlay Inferior -->
        <div
          class="relative rounded-3xl overflow-hidden shadow-sm border border-slate-200/80 bg-slate-100 aspect-[4/4.5] w-full"
        >
          <img
            src="/pablo-rios.jpeg"
            alt="Pablo Ríos"
            class="w-full h-full object-cover object-top"
          />

          <!-- Overlay inferior: Identidad & Badge Verificado -->
          <div
            class="absolute bottom-3 left-3 right-3 bg-white/95 backdrop-blur-sm rounded-2xl p-3.5 shadow-sm border border-slate-200/70 flex items-center justify-between"
          >
            <div>
              <div class="flex items-center gap-1.5">
                <h3 class="text-sm font-bold text-slate-900 leading-tight">
                  Pablo Ríos
                </h3>
                <span
                  class="w-2 h-2 rounded-full bg-emerald-500 inline-block"
                  title="Activo"></span>
              </div>
              <p class="text-xs text-slate-500 font-mono mt-0.5">
                Head of Product, Mentor y Consultor en IA
              </p>
            </div>
            <!-- Checkmark Verificado Verde -->
          </div>
        </div>

        <!-- Tarjeta: Principio Clave -->

        <!-- Tarjeta: Canales y Redes de Pablo -->
        <div
          class="bg-white border border-slate-200/80 rounded-2xl p-4 shadow-2xs space-y-2.5"
        >
          <span
            class="font-mono text-[10px] font-bold text-slate-500 uppercase tracking-widest block"
          >
            CANALES Y REDES DE PABLO:
          </span>
          <div class="grid grid-cols-2 gap-2">
            <!-- LinkedIn -->
            <a
              href={LINKS.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              onclick="trackAboutContact('linkedin')"
              class="flex items-center gap-2 px-3 py-2 rounded-xl bg-slate-50 hover:bg-teal-50/50 hover:border-teal-200 border border-slate-200/80 text-xs font-semibold text-slate-700 transition"
            >
              <svg
                class="w-3.5 h-3.5 text-teal-700 shrink-0 fill-current"
                viewBox="0 0 24 24"
              >
                <path
                  d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                ></path>
              </svg>
              <span>LinkedIn</span>
            </a>

            <!-- Instagram -->
            <a
              href={LINKS.instagram}
              target="_blank"
              rel="noopener noreferrer"
              onclick="trackAboutContact('instagram')"
              class="flex items-center gap-2 px-3 py-2 rounded-xl bg-slate-50 hover:bg-amber-50/50 hover:border-amber-200 border border-slate-200/80 text-xs font-semibold text-slate-700 transition"
            >
              <svg
                class="w-3.5 h-3.5 text-amber-700 shrink-0 fill-none stroke-current stroke-2"
                viewBox="0 0 24 24"
              >
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                ></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>Instagram</span>
            </a>

            <!-- TikTok -->
            <a
              href={LINKS.tiktok}
              target="_blank"
              rel="noopener noreferrer"
              onclick="trackAboutContact('tiktok')"
              class="flex items-center gap-2 px-3 py-2 rounded-xl bg-slate-50 hover:bg-slate-100 hover:border-slate-300 border border-slate-200/80 text-xs font-semibold text-slate-700 transition"
            >
              <svg
                class="w-3.5 h-3.5 text-slate-800 shrink-0 fill-current"
                viewBox="0 0 24 24"
              >
                <path
                  d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.89 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.11V9.36a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3 15.65 6.34 6.34 0 0 0 9.34 22a6.34 6.34 0 0 0 6.34-6.35V8.89a8.28 8.28 0 0 0 3.91 1.25V6.69z"
                ></path>
              </svg>
              <span>TikTok</span>
            </a>

            <!-- Facebook -->
            <a
              href={LINKS.facebook}
              target="_blank"
              rel="noopener noreferrer"
              onclick="trackAboutContact('facebook')"
              class="flex items-center gap-2 px-3 py-2 rounded-xl bg-slate-50 hover:bg-blue-50/50 hover:border-blue-200 border border-slate-200/80 text-xs font-semibold text-slate-700 transition"
            >
              <svg
                class="w-3.5 h-3.5 text-blue-700 shrink-0 fill-current"
                viewBox="0 0 24 24"
              >
                <path
                  d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                ></path>
              </svg>
              <span>Facebook</span>
            </a>
          </div>
        </div>

        <!-- Tarjeta: Método LuciRMe & Ubicación -->
      </div>

      <!-- COLUMNA DERECHA: TEXTO + GRID 2X2 + WHATSAPP CTA -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
        <div class="space-y-3.5">
          <!-- Eyebrow Breadcrumb: DETRÁS DE LUCIRME ESTOY YO / Sobre Pablo Ríos -->
          <div
            class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider"
          >
            <span class="font-bold text-teal-800"
              >DETRÁS DE LUCIRME ESTOY YO</span
            >
            <span class="text-slate-300">/</span>
            <span class="text-slate-500 font-medium">Sobre Pablo Ríos</span>
          </div>

          <h1
            class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight leading-tight"
          >
            Soy Ingeniero de Sistemas y llevo más de 13 años trabajando entre
            producto, tecnología e Inteligencia Artificial.
          </h1>

          <p class="text-sm sm:text-base text-slate-700 leading-relaxed pt-0.5">
            Trabajando en el mundo de las startups en producto y tecnología
            conviví con recursos limitados, problemas ambiguos y usuarios que no
            tienen tiempo para esperar meses por una solución. Aprendí a
            priorizar y decir que no con criterio
          </p>

          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            He acompañado a más de 50 personas en procesos 1-1 y he colaborado
            con más de 30 empresas, ayudándoles a entender, implementar y
            adoptar IA en su trabajo.
          </p>

          <!-- Callout destacado estilizado con fondo sutil -->
          <div
            class="bg-emerald-50/70 border border-emerald-200/70 rounded-xl p-3.5 sm:p-4"
          >
            <p
              class="text-xs sm:text-sm font-semibold text-slate-900 leading-relaxed"
            >
              Mi objetivo no es que dependas de mí. Es que después de trabajar
              juntos mejores tu día a día usando tecnología e IA.
            </p>
          </div>
        </div>

        <!-- Rejilla 2x2 de Estadísticas / Credenciales con iconos en la esquina superior derecha -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
          <!-- Item 1: +50 personas -->
          <div
            class="bg-white border border-slate-200/80 rounded-2xl p-4.5 flex flex-col justify-between hover:border-teal-300 transition shadow-2xs"
          >
            <div class="flex items-center justify-between">
              <h4 class="text-base sm:text-lg font-bold text-slate-900">
                +50 personas
              </h4>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed mt-1.5">
              Acompañadas 1-1 en procesos reales de trabajo y adopción directa.
            </p>
          </div>

          <!-- Item 2: +30 empresas -->
          <div
            class="bg-white border border-slate-200/80 rounded-2xl p-4.5 flex flex-col justify-between hover:border-teal-300 transition shadow-2xs"
          >
            <div class="flex items-center justify-between">
              <h4 class="text-base sm:text-lg font-bold text-slate-900">
                +30 empresas
              </h4>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed mt-1.5">
              Intervenidas en optimización de operaciones, flujos de LLMs y
              automatizaciones.
            </p>
          </div>

          <!-- Item 3: +13 años -->
          <div
            class="bg-white border border-slate-200/80 rounded-2xl p-4.5 flex flex-col justify-between hover:border-teal-300 transition shadow-2xs"
          >
            <div class="flex items-center justify-between">
              <h4 class="text-base sm:text-lg font-bold text-slate-900">
                +13 años
              </h4>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed mt-1.5">
              Liderando producto, tecnología y operaciones en startups y
              corporativos en Latam.
            </p>
          </div>

          <!-- Item 4: 0% humo -->
          <div
            class="bg-white border border-slate-200/80 rounded-2xl p-4.5 flex flex-col justify-between hover:border-teal-300 transition shadow-2xs"
          >
            <div class="flex items-center justify-between">
              <h4 class="text-base sm:text-lg font-bold text-slate-900">
                Propósito
              </h4>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed mt-1.5">
              Mejorar la vida de mis clientes usando tecnología y e IA.
            </p>
          </div>
        </div>

        <!-- Fila de Acción CTA: Botón WhatsApp + Indicador de disponibilidad -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-4 pt-1">
          <a
            href={LINKS.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            onclick="trackAboutContact('whatsapp')"
            class="inline-flex items-center justify-center gap-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm px-6 py-3.5 rounded-xl transition shadow-md w-full sm:w-auto cursor-pointer"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path
                d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"
              ></path>
            </svg>
            <span>Hablar directamente con Pablo por WhatsApp</span>
          </a>

          <div class="flex items-center gap-2 text-xs font-mono text-slate-500">
            <span
              class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"
            ></span>
            <span>Respuesta habitual en pocas horas</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- 2. AUTORIDAD & CONTEXTO PROFESIONAL -->
    <!-- ========================================== -->

    <!-- ========================================== -->
    <!-- 3. SECCIÓN: CÓMO LLEGUÉ AQUÍ (TRAYECTORIA) -->
    <!-- ========================================== -->

    <!-- ========================================== -->
    <!-- 4. SECCIÓN: PRINCIPIOS DE TRABAJO (FILOSOFÍA) -->
    <!-- ========================================== -->

    <!-- ========================================== -->
    <!-- 5. SECCIÓN: CÓMO TE PUEDO AYUDAR (SOLUCIONES) -->
    <!-- ========================================== -->

    <!-- ========================================== -->
    <!-- 6. TARJETA FIRMA Y CONTACTO FINAL -->
    <!-- ========================================== -->

    <!-- ========================================== -->
    <!-- 7. BLOQUE DE RECURSO DESTACADO (EBOOK) -->
    <!-- ========================================== -->
  </div>
</section>

<script is:inline>
  // Helper para enviar eventos a PostHog
  function safeTrack(eventName, properties = {}) {
    if (typeof window !== "undefined" && window.posthog) {
      window.posthog.capture(eventName, properties);
    }
  }

  // Medir interacción con los canales de contacto
  function trackAboutContact(platformName) {
    safeTrack("about_contact_clicked", {
      platform: platformName,
      section: "sobre_mi",
    });
  }

  // Medir intención de compra del ebook
  function trackEbookPurchase() {
    safeTrack("about_ebook_purchase_clicked", {
      price_cop: 53000,
      destination_url: "hotmart",
      section: "sobre_mi",
    });
  }
</script>
