<script is:inline>
  // Helper para enviar eventos a PostHog
  function safeTrack(eventName, properties = {}) {
    if (typeof window !== "undefined" && window.posthog) {
      window.posthog.capture(eventName, properties);
    }
  }

  // Medir interacción con los canales de contacto
  function trackAboutContact(platformName) {
    safeTrack("about_contact_clicked", {
      platform: platformName,
      section: "sobre_mi",
    });
  }

  // Medir intención de compra del ebook
  function trackEbookPurchase() {
    safeTrack("about_ebook_purchase_clicked", {
      price_cop: 53000,
      destination_url: "hotmart",
      section: "sobre_mi",
    });
  }
</script>
