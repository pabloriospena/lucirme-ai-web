---
// src/components/SobreMi.astro
import { LINKS } from "../lib/constants.js";
---

<section
  id="sobre-mi"
  class="py-20 px-4 bg-slate-50 border-t border-b border-gray-100 relative"
>
  <div class="container max-w-5xl mx-auto space-y-16">
    <!-- HEADER DE LA SECCIÓN -->
    <div class="text-center max-w-3xl mx-auto">
      <span class="inline-block bg-teal/10 text-teal font-bold uppercase tracking-widest text-xs px-3.5 py-1.5 rounded-full mb-3 border border-teal/20">
        Sobre el Fundador
      </span>
      <h1 class="text-3xl md:text-5xl font-black text-deep tracking-tight mb-3">
        Pablo Ríos Peña
      </h1>
      <p class="text-base md:text-lg text-teal font-bold max-w-2xl mx-auto">
        Ingeniero de Sistemas (UPB) · Head of Product & Consultor en IA Estratégica
      </p>
    </div>

    <!-- TARJETA PRINCIPAL DE INTRODUCCIÓN -->
    <div
      class="bg-white border border-gray-200 p-8 md:p-12 rounded-3xl shadow-sm flex flex-col md:flex-row gap-10 items-center relative overflow-hidden"
    >
      <div
        class="absolute top-0 right-0 w-48 h-48 bg-teal/5 rounded-full blur-3xl pointer-events-none"
      >
      </div>

      <!-- FOTO CON DETALLE ESTILIZADO -->
      <div class="w-full md:w-1/3 flex flex-col items-center shrink-0">
        <div
          class="w-48 h-48 rounded-full overflow-hidden border-4 border-white shadow-xl relative z-10"
        >
          <img
            src="/pablo-rios.jpeg"
            alt="Pablo Ríos Peña"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Badge de Autoridad -->
        <div
          class="mt-6 text-center bg-slate-50 px-5 py-2.5 rounded-xl border border-gray-200"
        >
          <p class="text-xs font-bold text-teal uppercase tracking-wider">
            Ingeniero de Sistemas
          </p>
          <p class="text-[11px] text-gray-500 mt-0.5">
            U. Pontificia Bolivariana
          </p>
        </div>
      </div>

      <!-- HISTORIA Y AUTORIDAD -->
      <div class="w-full md:w-2/3 text-left relative z-10 space-y-4 text-gray-700 leading-relaxed text-sm md:text-base">
        <p class="font-medium text-deep text-base md:text-lg">
          No soy un gurú de la Inteligencia Artificial. Soy un Ingeniero con más de 10 años liderando productos digitales en startups como <strong class="text-deep">Vozy</strong> y <strong class="text-deep">Datup</strong>, que se cansó de ver talento brillante quemándose en tareas absurdas.
        </p>

        <p class="font-bold text-teal text-base">
          Llegué a la IA por necesidad operativa.
        </p>

        <p>
          Durante años vi el mismo patrón: equipos de alto nivel perdiendo horas copiando y pegando datos entre Jira, Excel, Slack y correos. Al principio creí que la solución era programar más software. La experiencia en producto me enseñó lo contrario: <strong>la tecnología sin un proceso claro es solo un juguete caro.</strong>
        </p>

        <div
          class="border-l-4 border-orange pl-4 italic text-deep font-semibold bg-orange/5 py-3 pr-3 rounded-r-xl text-sm md:text-base border border-orange/10"
        >
          "Por eso creé LuciRMe AI: para conectar la tecnología con resultados de negocio reales y devolverle el tiempo a las personas."
        </div>

        <!-- REDES Y CONTACTO DIRECTO -->
        <div
          class="pt-4 border-t border-gray-100 flex flex-wrap gap-6 text-xs md:text-sm font-bold"
        >
          <a
            href="https://linkedin.com/in/pabloriospena"
            target="_blank"
            rel="noopener noreferrer"
            onclick="trackAboutContact('linkedin')"
            class="flex items-center gap-2 text-teal hover:text-deep transition-colors duration-200"
          >
            <svg
              class="w-5 h-5 shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
              ><path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path></svg
            >
            linkedin.com/in/pabloriospena
          </a>
          <a
            href="mailto:pabloriospena@gmail.com"
            onclick="trackAboutContact('email')"
            class="flex items-center gap-2 text-teal hover:text-deep transition-colors duration-200"
          >
            <svg
              class="w-5 h-5 shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path></svg
            >
            pabloriospena@gmail.com
          </a>
        </div>
      </div>
    </div>

    <!-- SECCIÓN: CÓMO LLEGUÉ AQUÍ -->
    <div class="space-y-6">
      <div class="text-left border-b border-gray-200 pb-3">
        <span class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full">
          Trayectoria
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          Cómo llegué aquí
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-2 hover:border-teal/50 transition">
          <div class="flex items-center gap-2 text-teal font-bold text-base">
            <span class="text-lg">💻</span>
            <span>La ilusión del código</span>
          </div>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            En mis inicios creía que todo se resolvía programando. Aprendí rápido que automatizar un mal proceso solo produce desastres a mayor velocidad.
          </p>
        </div>

        <div class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-2 hover:border-teal/50 transition">
          <div class="flex items-center gap-2 text-teal font-bold text-base">
            <span class="text-lg">🚀</span>
            <span>El caos de las startups (Vozy, Datup)</span>
          </div>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Liderar productos B2B me enseñó a priorizar, a decir "no" al exceso de funcionalidades y a enfocarme en lo que duele. Se pueden gastar meses construyendo algo que nadie usa mientras la operación se desangra. Lo único que importa es la retención y el tiempo ahorrado, no las métricas de ego.
          </p>
        </div>

        <div class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-2 hover:border-teal/50 transition">
          <div class="flex items-center gap-2 text-teal font-bold text-base">
            <span class="text-lg">🤖</span>
            <span>IA con criterio</span>
          </div>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Con la llegada de los LLMs vi repetirse el error de siempre: empresas comprando licencias caras sin saber integrarlas. Empecé a rediseñar flujos de trabajo para mis equipos y pasamos de tareas de 4 horas a borradores de 15 minutos. No cambiamos el software; rediseñamos la forma de trabajar.
          </p>
        </div>

        <div class="bg-white border border-gray-200 p-6 rounded-2xl shadow-xs space-y-2 hover:border-teal/50 transition">
          <div class="flex items-center gap-2 text-teal font-bold text-base">
            <span class="text-lg">✨</span>
            <span>LuciRMe AI</span>
          </div>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Empaqueté diez años de aciertos y errores en Product Management para aplicarlos a la IA. El objetivo es simple: que un profesional recupere sus fines de semana o que una empresa escale su operación sin duplicar su nómina ni arriesgar sus datos.
          </p>
        </div>
      </div>
    </div>

    <!-- SECCIÓN: PRINCIPIOS DE TRABAJO -->
    <div class="space-y-6">
      <div class="text-left border-b border-gray-200 pb-3">
        <span class="text-xs font-bold text-orange uppercase tracking-widest bg-orange/10 px-3 py-1 rounded-full">
          Filosofía
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          Principios de trabajo
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div class="bg-white border-l-4 border-teal border border-gray-200 p-5 rounded-r-2xl rounded-l-md shadow-xs space-y-2">
          <h3 class="font-bold text-deep text-sm md:text-base">
            1. El proceso manda, la tecnología obedece.
          </h3>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            No vendo "transformación digital". Mapeamos dónde pierdes tiempo y dinero, y armamos un flujo con IA que lo resuelva.
          </p>
        </div>

        <div class="bg-white border-l-4 border-orange border border-gray-200 p-5 rounded-r-2xl rounded-l-md shadow-xs space-y-2">
          <h3 class="font-bold text-deep text-sm md:text-base">
            2. Autonomía sobre dependencia.
          </h3>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Si necesitas de mí para siempre, fracasé. Configuro el sistema y capacito a tu equipo para que opere solo.
          </p>
        </div>

        <div class="bg-white border-l-4 border-teal border border-gray-200 p-5 rounded-r-2xl rounded-l-md shadow-xs space-y-2">
          <h3 class="font-bold text-deep text-sm md:text-base">
            3. Métricas reales.
          </h3>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            No me importa cuántos prompts guardes. Me importa si recuperaste 10 horas a la semana o si eliminaste el error humano en tu facturación.
          </p>
        </div>

        <div class="bg-white border-l-4 border-orange border border-gray-200 p-5 rounded-r-2xl rounded-l-md shadow-xs space-y-2">
          <h3 class="font-bold text-deep text-sm md:text-base">
            4. Criterio sobre parálisis.
          </h3>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Lanzamos, medimos impacto real y ajustamos sobre la marcha.
          </p>
        </div>
      </div>
    </div>

    <!-- SECCIÓN: CÓMO TE PUEDO AYUDAR -->
    <div class="space-y-6">
      <div class="text-left border-b border-gray-200 pb-3">
        <span class="text-xs font-bold text-teal uppercase tracking-widest bg-teal/10 px-3 py-1 rounded-full">
          Soluciones
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-deep mt-3">
          Cómo te puedo ayudar
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-gradient-to-br from-white to-slate-50 border border-gray-200 p-6 md:p-8 rounded-2xl shadow-xs space-y-3">
          <div class="w-10 h-10 bg-teal/10 text-teal font-bold rounded-xl flex items-center justify-center text-xl">
            👤
          </div>
          <h3 class="text-lg font-bold text-deep">
            Profesionales e independientes
          </h3>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Diseñamos tu sistema personal con IA para que dejes de ser el asistente de tu propio trabajo y vuelvas a ser el estratega.
          </p>
        </div>

        <div class="bg-gradient-to-br from-white to-slate-50 border border-gray-200 p-6 md:p-8 rounded-2xl shadow-xs space-y-3">
          <div class="w-10 h-10 bg-orange/10 text-orange font-bold rounded-xl flex items-center justify-center text-xl">
            🏢
          </div>
          <h3 class="text-lg font-bold text-deep">
            Empresas y CEOs
          </h3>
          <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
            Estandarizamos tu operación, protegemos la información del negocio y creamos arquitecturas de IA para escalar sin fricción.
          </p>
        </div>
      </div>

      <div class="bg-deep text-white p-6 rounded-2xl text-center space-y-2 border border-slate-800">
        <p class="text-base md:text-lg font-bold text-teal">
          Menos teoría, más ejecuciones que funcionen el lunes por la mañana.
        </p>
      </div>
    </div>

    <!-- TARJETA FIRMA Y CONTACTO FINAL -->
    <div class="bg-white border border-gray-200 p-8 rounded-2xl shadow-xs flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">
      <div class="space-y-1">
        <h3 class="text-xl font-extrabold text-deep">Pablo Ríos Peña</h3>
        <p class="text-xs md:text-sm text-teal font-bold">
          Head of Product · Consultor en IA & Estrategia de Producto
        </p>
        <p class="text-xs text-gray-500 font-medium">
          Fundador de LuciRMe AI
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 text-xs md:text-sm font-bold">
        <a
          href="mailto:pabloriospena@gmail.com"
          class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-deep px-4 py-2.5 rounded-xl transition"
        >
          📩 pabloriospena@gmail.com
        </a>
        <a
          href="https://linkedin.com/in/pabloriospena"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-teal text-white hover:bg-tealHover px-4 py-2.5 rounded-xl transition shadow-xs"
        >
          🔗 linkedin.com/in/pabloriospena
        </a>
      </div>
    </div>

    <!-- BLOQUE DE RECURSO DESTACADO (EBOOK) -->
    <div
      class="bg-deep p-8 md:p-10 rounded-3xl text-white flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl shadow-slate-900/10 relative overflow-hidden border border-slate-800"
    >
      <div
        class="absolute top-0 right-0 w-64 h-64 bg-orange/10 rounded-full blur-3xl"
      >
      </div>

      <div class="md:w-2/3 relative z-10">
        <span
          class="inline-block bg-orange/20 text-orange text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded mb-3"
          >Recurso Recomendado</span
        >
        <h4 class="text-xl font-bold mb-2 flex items-center gap-2">
          📚 Ebook "PM Sin Bullshit"
        </h4>
        <p class="text-gray-300 text-sm mb-5 leading-relaxed">
          Diseñado para Product Managers y profesionales que quieren dejar de
          apagar incendios diarios y empezar a tomar decisiones con criterio
          tecnológico real. Sin teoría abstracta, solo frameworks prácticos
          listos para aplicar.
        </p>
        <div class="flex items-center gap-4">
          <span class="text-2xl font-black text-orange">$53.000 COP</span>
          <span class="text-xs text-gray-400 line-through">$100.000 COP</span>
        </div>
      </div>

      <a
        href={LINKS.ebook}
        onclick="trackEbookPurchase()"
        class="relative z-10 w-full md:w-auto text-center bg-orange hover:bg-orange/95 text-white px-8 py-3.5 rounded-xl font-bold transition-all duration-200 shadow-lg shadow-orange/20"
      >
        Comprar Ebook →
      </a>
    </div>
  </div>
</section>

<script is:inline>
  // Helper para enviar eventos a PostHog
  function safeTrack(eventName, properties = {}) {
    if (typeof window !== "undefined" && window.posthog) {
      window.posthog.capture(eventName, properties);
    }
  }

  // Medir interacción con los canales de contacto
  function trackAboutContact(platformName) {
    safeTrack("about_contact_clicked", {
      platform: platformName,
      section: "sobre_mi",
    });
  }

  // Medir intención de compra del ebook
  function trackEbookPurchase() {
    safeTrack("about_ebook_purchase_clicked", {
      price_cop: 53000,
      destination_url: "hotmart",
      section: "sobre_mi",
    });
  }
</script>
