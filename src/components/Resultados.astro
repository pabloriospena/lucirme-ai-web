---
// src/components/Resultados.astro
interface Props {
  tipo?: "empresas" | "mentorías" | "mentorias" | "general" | string;
  id?: string;
  class?: string;
}

const {
  tipo = "general",
  id = "resultados",
  class: className = "",
} = Astro.props;

const testimonios = [
  {
    perfil: "👤 Administrador Anónimo",
    quote:
      "Recuperé 7h/semana automatizando reportes. Ahora enfoco ese tiempo en clientes que sí pagan.",
    result: "Sesión de enfoque + Guía personalizada",
    categoria: "mentorias",
  },
  {
    perfil: "👤 María Camila B. - Product Manager",
    quote:
      "Mi objetivo no es usar IA por moda, es dejar de apagar incendios y tener una visión más tranquila y estratégica de mi pipeline.",
    result: "Sesión de enfoque + Estructura de Automatización",
    categoria: "mentorias",
  },
  {
    perfil: "👤 José Madriz - Data Analytics",
    quote:
      "LucirMe me dio el 'chip' para dejar de quebrarme la cabeza por algo que no es mío y empezar a sistematizar soluciones.",
    result: "Sesión de enfoque + Guía personalizada",
    categoria: "mentorias",
  },
  {
    perfil: "👤 David M. Muñoz - Líder de desarrollo",
    quote:
      "Pude validar el camino para mi cliente y las iniciativas de IA que estamos implementando. Fue justo lo que necesitaba para aterrizar la estrategia.",
    result: "Sesión de enfoque + Plan de ejecución estratégico",
    categoria: "mentorias",
  },
  {
    perfil: "🏢 Almamotor",
    quote:
      "Nos encantó la metodología y la manera de enseñar. Nos diste claridad práctica para aplicar lo aprendido de inmediato en el equipo.",
    result: "Taller de inmersión",
    categoria: "empresas",
  },
  {
    perfil: "🏢 InterobrasER",
    quote:
      "Un taller productivo y muy necesario. El equipo entendió la situación y vio los beneficios reales de aplicar estos cambios.",
    result: "Taller de inmersión + Ciclo de autonomía",
    categoria: "empresas",
  },
  {
    perfil: "👤 Cecilia Morete - Alumno",
    quote:
      "Qué felicidad ser parte de este proceso. Ahora tengo las herramientas organizadas y la claridad para hacer las preguntas correctas y avanzar.",
    result: "Acompañamiento individual",
    categoria: "mentorias",
  },
  {
    perfil: "👤 Melody Abele - Alumno (Melfa CX)",
    quote:
      "Gracias a tus herramientas y devoluciones, mi proyecto hoy tiene mucho más sentido, un norte claro y gran potencial. Aprendizaje real.",
    result: "Sesión de enfoque + Estructura de Automatización",
    categoria: "mentorias",
  },
  {
    perfil: "🚀 Startup B2B (5 personas)",
    quote:
      "Redujimos de 12 a 4 días el ciclo de decisión de features. Sin contratar más PMs.",
    result: "Taller de inmersión + Ciclo de autonomía",
    categoria: "empresas",
  },
  {
    perfil: "🏢 Empresa de Servicios (50+) RRHH",
    quote:
      "Eliminamos 3 aprobaciones manuales en onboarding. Error humano: -80%.",
    result: "Taller de inmersión + Ciclo de autonomía",
    categoria: "empresas",
  },
  {
    perfil: "🏢 Administradora - Fundación Casa Universitaria La Chinca",
    quote:
      "Tu charla tuvo muy buenos comentarios. A las estudiantes les gustó mucho el enfoque práctico.",
    result: "Taller de inmersión",
    categoria: "empresas",
  },
  {
    perfil: "💼 Consultor Tech",
    quote:
      "Sistematicé mi propuesta de valor. El tiempo de onboarding de clientes bajó a la mitad.",
    result: "Sesión de enfoque",
    categoria: "mentorias",
  },
  {
    perfil: "🌱 Agencia de Diseño",
    quote:
      "Automatizamos la entrega de assets. 4 horas ahorradas por proyecto entregado.",
    result: "Ciclo de autonomía",
    categoria: "empresas",
  },
];

const normalizedTipo = tipo.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

// Filtrar según contexto
const testimoniosFiltrados = normalizedTipo === "empresas"
  ? testimonios.filter((t) => t.categoria === "empresas")
  : normalizedTipo === "mentorias"
  ? testimonios.filter((t) => t.categoria === "mentorias")
  : testimonios;

// Textos y encabezados específicos según la oferta
const config = normalizedTipo === "empresas"
  ? {
      eyebrow: "Casos de Equipos",
      titulo: "Resultados que ya conseguimos con equipos",
      subtitulo:
        "No hablamos de IA en abstracto. Trabajamos sobre procesos reales y buscamos cambios que el equipo pueda aplicar y sostener.",
    }
  : normalizedTipo === "mentorias"
  ? {
      eyebrow: "Acompañamiento 1-1",
      titulo: "Personas que ya están trabajando de otra manera",
      subtitulo:
        "Cada acompañamiento parte de un problema concreto. La idea no es darte más teoría, sino ayudarte a encontrar claridad y avanzar.",
    }
  : {
      eyebrow: "Evidencia de Impacto",
      titulo: "Algunos resultados",
      subtitulo:
        "Impacto real medido en los flujos de trabajo de nuestros usuarios. Sin teoría vacía.",
    };

// Función auxiliar para separar el emoji del nombre y rol
function parsePerfil(raw: string) {
  const match = raw.match(/^([\uD800-\uDBFF][\uDC00-\uDFFF]|\p{Emoji_Presentation}|\p{Extended_Pictographic}|\S+)\s*(.*)$/u);
  const icon = match ? match[1] : "👤";
  const rest = match ? match[2] : raw;
  const parts = rest.split(" - ");
  const nombre = parts[0] || rest;
  const rol = parts.length > 1 ? parts.slice(1).join(" - ") : null;
  return { icon, nombre, rol };
}
---

<section id={id} class={`py-16 px-4 sm:px-6 bg-white border-t border-slate-200/80 ${className}`}>
  <div class="max-w-6xl mx-auto">
    <!-- Header de Sección -->
    <div class="max-w-3xl mb-12 text-left">
      <span class="font-mono text-xs font-semibold text-teal-800 uppercase tracking-wider block mb-2">
        {config.eyebrow}
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight mb-3">
        {config.titulo}
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        {config.subtitulo}
      </p>
    </div>

    <!-- Rejilla Responsive de Testimonios -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 items-stretch">
      {
        testimoniosFiltrados.map((t) => {
          const { icon, nombre, rol } = parsePerfil(t.perfil);
          return (
            <div class="group bg-[#F8FAFC] p-6 rounded-2xl border border-slate-200/80 flex flex-col justify-between hover:bg-white hover:border-[#0D9488]/40 hover:shadow-md transition-all duration-200">
              <!-- Bloque Quién y Qué cambió -->
              <div>
                <!-- Quién -->
                <div class="flex items-start gap-3 mb-4 pb-3 border-b border-slate-200/60">
                  <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-lg shrink-0 shadow-2xs group-hover:border-[#0D9488]/30 transition-colors">
                    {icon}
                  </div>
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xs font-bold text-slate-900 truncate leading-snug group-hover:text-[#0D9488] transition-colors">
                      {nombre}
                    </h3>
                    {rol && (
                      <p class="text-[11px] font-mono text-slate-500 truncate">
                        {rol}
                      </p>
                    )}
                  </div>
                </div>

                <!-- Testimonio / Qué cambió -->
                <blockquote class="text-slate-700 text-xs sm:text-sm leading-relaxed mb-6 font-normal">
                  "{t.quote}"
                </blockquote>
              </div>

              <!-- Información secundaria: Solución / Intervención -->
              <div class="pt-3.5 border-t border-slate-200/60 mt-auto flex items-center justify-between gap-2">
                <span class="text-[10px] font-mono text-slate-600 uppercase tracking-wider shrink-0 font-semibold">
                  Solución:
                </span>
                <span
                  class="text-[11px] font-medium text-[#0D9488] truncate text-right bg-white px-2 py-0.5 rounded-md border border-slate-200/70"
                  title={t.result}
                >
                  {t.result}
                </span>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
