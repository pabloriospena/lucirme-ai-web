---
import Header from "../components/ruta-claude/Header.astro";
import Footer from "../components/ruta-claude/Footer.astro";
import PostHog from "../components/PostHog.astro";
import "../styles/global.css";

interface Props {
  /** completo deja que la página use todo el contenedor de 1280 px. */
  ancho?: "texto" | "completo";
  title: string;
  description: string;
  image?: string;
  canonical?: string;
}

const {
  ancho = "texto",
  title,
  description,
  image = "https://lucirme.com/logo-lucirme.png",
  canonical,
} = Astro.props;

const fullTitle = `${title} | LuciRMe AI`;
const ruta = Astro.url.pathname.replace(/\/+$/, "");
// La barra fija de registro solo va donde hay un formulario de correo de registro.
const mostrarBarra = ["/ruta-claude", "/ruta-claude/paso-0", "/ruta-claude/paso-1"].includes(ruta);
const canonicalUrl = canonical || new URL(Astro.url.pathname, "https://lucirme.com").href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pablo Ríos - LuciRMe AI" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LuciRMe AI" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="es_CO" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <PostHog />

    <style is:global>
      [data-oculto="1"] { display: none !important; }
      [data-ruta-claude-registrado="1"] [data-solo-sin-registro] { display: none; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col antialiased bg-slate-50 text-slate-900 font-sans selection:bg-teal-100 selection:text-teal-900">
    <Header />
    <main class={`flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 py-8 ${mostrarBarra ? "pb-28 sm:pb-8" : ""}`}>
      <div class={ancho === "texto" ? "max-w-4xl mx-auto" : ""}>
        <slot />
      </div>
    </main>
    <Footer />
    {mostrarBarra && (
      <div
        id="barra-registro"
        class="sm:hidden fixed bottom-0 inset-x-0 z-40 border-t border-slate-200 bg-white/95 backdrop-blur shadow-[0_-4px_16px_rgba(15,23,42,0.08)] px-4 py-3"
      >
        <a
          id="barra-registro-cta"
          href="/ruta-claude#registro-hero"
          class="flex w-full items-center justify-center gap-2 font-semibold bg-teal-700 hover:bg-teal-800 text-white rounded-xl py-3.5 px-5 transition text-base shadow-md focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-teal-600"
        >
          <span>Empezar Paso 0 gratis</span>
          <span class="text-base leading-none">→</span>
        </a>
      </div>
    )}
    <script is:inline>
      (function () {
        var ruta = 'ruta_claude';
        var partes = location.pathname.replace(/\/+$/, '').split('/');
        var pagina = partes.length > 2 ? partes.slice(2).join('-') : 'hub';
        var params = new URLSearchParams(location.search);
        function enviar(nombre, props) {
          if (window.posthog) window.posthog.capture(nombre, props);
        }
        window.addEventListener('load', function () {
          enviar(ruta + '_pagina_vista', { pagina: pagina, referido: params.has('ref') });
          if (params.has('ref')) enviar(ruta + '_visita_referida', { pagina: pagina });
        });
        var enviado = false;
        window.addEventListener('scroll', function () {
          if (enviado) return;
          var alto = document.documentElement.scrollHeight - window.innerHeight;
          if (alto > 0 && window.scrollY / alto >= 0.75) {
            enviado = true;
            enviar(ruta + '_scroll_75', { pagina: pagina });
          }
        }, { passive: true });
        // Barra fija y botón del encabezado: un solo botón de registro por pantalla.
        var barraCta = document.getElementById('barra-registro-cta');
        var barra = document.getElementById('barra-registro');
        var headerCta = document.getElementById('header-cta-registro');
        var formularios = document.querySelectorAll('[data-registro]');
        var registro = null;
        try { registro = window.localStorage.getItem('ruta_claude_registrado') === '1'; } catch (e) {}
        var primero = formularios.length ? formularios[0] : null;
        if (barraCta && primero) barraCta.setAttribute('href', '#' + primero.id);
        if (registro) {
          if (barra) barra.setAttribute('data-oculto', '1');
          if (headerCta) headerCta.setAttribute('data-oculto', '1');
        } else if (formularios.length && 'IntersectionObserver' in window) {
          var visibles = 0;
          var io = new IntersectionObserver(function (items) {
            items.forEach(function (it) { visibles += it.isIntersecting ? 1 : -1; });
            var ocultar = visibles > 0 ? '1' : '';
            [barra, headerCta].forEach(function (el) {
              if (!el) return;
              if (ocultar) el.setAttribute('data-oculto', '1'); else el.removeAttribute('data-oculto');
            });
          }, { threshold: 0.2 });
          formularios.forEach(function (f) { io.observe(f); });
        }
        if (barraCta) {
          barraCta.addEventListener('click', function () {
            enviar(ruta + '_sticky_click', { ubicacion: 'sticky', pagina: pagina });
          });
        }
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href="#avisame"]') : null;
          if (a) enviar(ruta + '_avisame_click', { pagina: pagina });
        });
      })();
    </script>
  </body>
</html>
