---
// Plantilla de la web nueva (Web LuciRMe v2).
// Envuelve la plantilla actual sin cambiarla: apaga su cabecera y su pie y pone los nuevos.
// Las páginas actuales siguen con Layout.astro hasta que les toque pasar a esta.
import Layout from "./Layout.astro";
import HeaderV2 from "../components/v2/HeaderV2.astro";
import FooterV2 from "../components/v2/FooterV2.astro";

const props = Astro.props;
---

<Layout {...props} hideHeader hideFooter>
  <script slot="head" is:inline>
    // Marca la página como V2 y aplica el modo guardado antes de pintar, para que no parpadee.
    (function () {
      var h = document.documentElement;
      h.setAttribute("data-v2", "");
      try {
        if (localStorage.getItem("lucirme-tema") === "oscuro") h.setAttribute("data-tema", "oscuro");
      } catch (e) {}
    })();
  </script>
  <HeaderV2 />
  <slot />
  <FooterV2 />
</Layout>
