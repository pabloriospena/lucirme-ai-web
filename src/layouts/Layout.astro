---
// src/layouts/Layout.astro
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Selector from '../components/Selector.astro';

// CAMBIA ESTA LÍNEA (Quita las llaves { }):
import Analytics from '@vercel/analytics/astro'; 

interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
  </head>
  <body class="bg-[#F8FAFC] text-deep flex">
    <Sidebar />
    <main class="flex-1 md:ml-64 p-8 md:p-12 min-h-screen">
      <slot />
    </main>
    <Selector />
    <!-- Usa el componente importado por defecto -->
    <Analytics /> 
  </body>
</html>