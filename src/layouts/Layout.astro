---
import "../styles/global.css";
import Selector from "../components/Selector.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import { LINKS } from "../lib/constants.js";
import { UserButton } from "@clerk/astro/components";

const {
  title = "LuciRMe AI | Consultoría, Mentoría e Inteligencia Artificial",
  description = "Consultoría, mentoría e implementación de Inteligencia Artificial en vivo para profesionales y equipos. Automatización de flujos con Pablo Ríos.",
  image = "https://lucirme.com/logo-lucirme.png",
  canonical,
  type = "website",
  keywords = "inteligencia artificial, consultoria ia, mentorias ia, ia para producto, pablo rios, automatizacion de flujos, lucirme ai, colombia",
  jsonLd,
} = Astro.props;

const canonicalUrl = canonical || Astro.url.href;

const locals = Astro.locals as any;
const auth = locals.auth;
const userId = typeof auth === "function" ? auth().userId : auth?.userId;

// Default Organization & Person Schema
const defaultOrganizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "LuciRMe AI",
  url: "https://lucirme.com",
  logo: "https://lucirme.com/logo-lucirme.png",
  founder: {
    "@type": "Person",
    name: "Pablo Ríos",
    jobTitle: "Consultor & Mentor en Inteligencia Artificial",
    sameAs: [
      "https://linkedin.com/in/pabloriospena",
      "https://www.instagram.com/lucirmeai/",
      "https://www.tiktok.com/@pabloriosp",
    ],
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "Customer Support",
    url: "https://wa.me/573053046180",
    email: "pablo@lucirme.com",
  },
  description:
    "Sistemas de Inteligencia Artificial de alto impacto, consultoría técnica y mentoría en vivo para profesionales y equipos.",
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Core Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Pablo Ríos - LuciRMe AI" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph Social Sharing (Facebook, LinkedIn, WhatsApp) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="LuciRMe AI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@pabloriosp" />
    <meta name="twitter:creator" content="@pabloriosp" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Material Symbols -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />

    <!-- Schema.org JSON-LD Structured Data for Search Engines & AI Models -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(defaultOrganizationSchema)}
    />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    <!-- PostHog Analytics -->
    <script is:inline>
      !(function (t, e) {
        var o, n, p, r;
        e.__SV ||
          (window.posthog && window.posthog.__loaded) ||
          ((window.posthog = e),
          (e._i = []),
          (e.init = function (i, s, a) {
            function g(t, e) {
              var o = e.split(".");
              (2 == o.length && ((t = t[o[0]]), (e = o[1])),
                (t[e] = function () {
                  t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
                }));
            }
