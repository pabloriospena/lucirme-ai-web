    posthog.init('phc_kSyqfd9vkMePJjoH95yV9oPupWgV3de8zftzZLPtzzM7', {
        api_host: 'https://us.i.posthog.com',
        defaults: '2026-01-30',
        person_profiles: 'identified_only', // or 'always' to create profiles for anonymous users as well
    })
</script>
  </head>

  <body class="bg-white text-gray-900 font-sans antialiased">
    
    <!-- HEADER -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-100">
      <div class="container mx-auto px-4 py-4 flex items-center justify-between">
        
        <!-- Logo y Navegación -->
        <div class="flex items-center gap-8">
          <a href="/" class="flex items-center gap-2">
            <img src="/logo-lucirme.png" alt="LuciRMe Ai" class="h-7 w-auto object-contain" />
          </a>
          
          <nav class="hidden md:flex items-center gap-6">
            <a href="/#caminos" class="text-sm font-medium text-gray-600 hover:text-teal transition">Caminos</a>
            <a href="/#metodo" class="text-sm font-medium text-gray-600 hover:text-teal transition">Cómo funciona</a>
            <a href="/#precios" class="text-sm font-medium text-gray-600 hover:text-teal transition">Precios</a>
          </nav>
        </div>

        <!-- Acciones Derecha -->
        <div class="flex items-center gap-4">
          <button 
            onclick="document.getElementById('selector-overlay').classList.remove('hidden')"
            class="text-sm font-bold text-orange hover:text-orange/80 transition"
          >
            Enciende tu Foco
          </button>
          
          {userId ? (
            <a href="/dashboard" class="text-sm font-semibold text-teal hover:underline transition">Dashboard</a>
          ) : (
            <a href="/sign-in" class="text-sm font-semibold text-teal hover:underline transition">Iniciar Sesión</a>
          )}
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <Footer />
    <Selector />
    <Analytics />
  </body>
</html>