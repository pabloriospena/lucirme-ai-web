---
import '../styles/global.css';
import Selector from '../components/Selector.astro';
import Footer from '../components/Footer.astro'; // Asegúrate de tenerlo
import Analytics from '@vercel/analytics/astro';
import { UserButton } from "@clerk/astro/components";

const auth = (Astro.locals as any).auth;
const userId = typeof auth === 'function' ? auth().userId : auth?.userId;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{Astro.props.title}</title>
  </head>

  <body class="bg-white text-gray-900 font-sans antialiased">
    
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-100">
      <div class="container mx-auto px-4 py-4 flex items-center justify-between">
        
        <!-- GRUPO IZQUIERDA: Logo + Navegación -->
        <div class="flex items-center gap-8">
          <a href="/" class="flex items-center gap-2">
            <img src="/logo-lucirme.png" alt="LuciRMe Ai" class="h-7 w-auto object-contain" />
          </a>
          
          <nav class="hidden md:flex items-center gap-6">
            <a href="#caminos" class="text-sm font-medium text-gray-600 hover:text-teal transition">Caminos</a>
            <a href="#metodo" class="text-sm font-medium text-gray-600 hover:text-teal transition">Cómo funciona</a>
            <a href="#precios" class="text-sm font-medium text-gray-600 hover:text-teal transition">Precios</a>
          </nav>
        </div>

        <!-- GRUPO DERECHA: CTAs -->
        <div class="flex items-center gap-3">
          <button 
            onclick="document.getElementById('selector-overlay').classList.remove('hidden')"
            class="text-sm font-bold text-orange hover:text-orange/80 transition px-3"
          >
            Enciende tu Foco
          </button>
          
          <a href="https://calendar.app.google/k4iYmA42X9NNBb5t8" class="text-sm font-bold bg-teal text-white px-5 py-2.5 rounded-lg hover:bg-tealHover transition">
            Agendar Café
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <Footer />
    <Selector />
    <Analytics />
  </body>
</html>